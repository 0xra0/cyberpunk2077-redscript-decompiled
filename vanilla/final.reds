      return true;
    }
    return false;
  }

  protected const func ExitCondition(const stateContext: StateContext, const scriptInterface: StateGameScriptInterface) -> Bool {
    let isBossFinisher = stateContext.GetPermanentBoolParameter(n"bossFinisherAttack");
    let finisherTargetID = scriptInterface
      .localBlackboard
      .GetEntityID(GetAllBlackboardDefs().PlayerStateMachine.FinisherTarget);
    if (!isBossFinisher.valid || !isBossFinisher.value) && EntityID.IsDefined(finisherTargetID) {
