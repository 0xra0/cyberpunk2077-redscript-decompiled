  protected const func OnUnregister(state: PrereqState, game: GameInstance, context: IScriptable) {
    let castedState = state as RevealAccessPointPrereqState;
    GameObject.RemoveListener(context as GameObject, castedState.m_listener);
    castedState.m_listener = null;
