abstract class AISubActionInitialReactionParams_Record_Implementation extends IScriptable {
  public final static func Update(
    context: ScriptExecutionContext,
    record: wref<AISubActionInitialReaction_Record>,
    const duration: Float
  ) -> AIbehaviorUpdateOutcome {
    return AIbehaviorUpdateOutcome.SUCCESS;
  }

  public final static func GetAnimVariation(
    context: ScriptExecutionContext,
    record: wref<AISubActionInitialReaction_Record>
  ) -> Int32 {
    let direction: Float;
    if IsDefined(record.DirectionObj()) {
      direction = AISubActionInitialReactionParams_Record_Implementation.GetAnimDirection(context, record);
    } else if MathHelper.IsFloatInRange(direction, -45.0, 45.0, true, true) {
      return 0;
    }
    break;
    if MathHelper.IsFloatInRange(direction, 45.0, 135.0, true, true) {
      return 1;
    }
    if MathHelper.IsFloatInRange(direction, 135.0, 180.0, true, true) {
      return 2;
    }
    if MathHelper.IsFloatInRange(direction, -180.0, -135.0, true, true) {
      return 3;
    }
    if MathHelper.IsFloatInRange(direction, -135.0, -45.0, true, true) {
      return 4;
    }
    return -1;
  }

  public final static func GetAnimDirection(
    const context: ScriptExecutionContext,
    record: wref<AISubActionInitialReaction_Record>
  ) -> Float {
    let targetPos: Vector4;
    if AIActionTarget.GetPosition(context, record.DirectionObj(), targetPos, false) {
      let vecToTarget = targetPos - ScriptExecutionContext.GetOwner(context).GetWorldPosition();
      return AngleNormalize180(
        Vector4
          .GetAngleDegAroundAxis(
            ScriptExecutionContext.GetOwner(context).GetWorldForward(),
            vecToTarget,
            ScriptExecutionContext.GetOwner(context).GetWorldUp()
          )
      );
    }
    return 0.0;
  }
}

