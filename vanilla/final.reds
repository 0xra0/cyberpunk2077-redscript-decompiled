class DeviceButtonLogicControllerBase extends inkButtonController {
  protected let m_targetWidgetRef: inkWidgetRef;
  protected let m_displayNameWidget: inkTextRef;
  protected let m_iconWidget: inkImageRef;
  protected let m_toggleSwitchWidget: inkImageRef;
  protected let m_sizeProviderWidget: inkWidgetRef;
  protected let m_selectionMarkerWidget: inkWidgetRef;
  protected let m_onReleaseAnimations: WidgetAnimationManager;
  protected let m_onPressAnimations: WidgetAnimationManager;
  protected let m_onHoverOverAnimations: WidgetAnimationManager;
  protected let m_onHoverOutAnimations: WidgetAnimationManager;
  protected let m_defaultStyle: ResRef;
  protected let m_selectionStyle: ResRef;
  protected let m_soundData: SSoundData;
  protected let m_isInitialized: Bool;
  protected let m_targetWidget: wref<inkWidget>;
  protected let m_isSelected: Bool;

  protected cb func OnInitialize() -> Bool {
    if inkWidgetRef.Get(this.m_targetWidgetRef) == null {
      this.m_targetWidget = this.GetRootWidget();
    } else {
      this.m_targetWidget = inkWidgetRef.Get(this.m_targetWidgetRef);
    }
    this.RegisterBaseInputCallbacks();
    this.ResolveSelection();
  }

  public final func IsInitialized() -> Bool {
    return this.m_isInitialized;
  }

  protected func ResolveWidgetState(state: EWidgetState);

  public final func SetButtonSize(x: Float, y: Float) {
    inkWidgetRef.SetSize(this.m_sizeProviderWidget, x, y);
  }

  public func ToggleSelection(isSelected: Bool) {
    this.SetSelected(isSelected);
    this.UpdateButtonState(true);
    this.ResolveSelection();
  }

  public func ResolveSelection() {
    if this.GetSelected() {
      inkWidgetRef.SetVisible(this.m_selectionMarkerWidget, true);
      if ResRef.IsValid(this.m_selectionStyle) {
        this.m_targetWidget.SetStyle(this.m_selectionStyle);
      }
    } else {
      inkWidgetRef.SetVisible(this.m_selectionMarkerWidget, false);
      if ResRef.IsValid(this.m_defaultStyle) {
        this.m_targetWidget.SetStyle(this.m_defaultStyle);
      }
    }
  }

  public func RegisterBaseInputCallbacks() {
    this.m_targetWidget.RegisterToCallback(n"OnHoverOver", this, n"OnHoverOver");
    this.m_targetWidget.RegisterToCallback(n"OnHoverOut", this, n"OnHoverOut");
    this.m_targetWidget.RegisterToCallback(n"OnPress", this, n"OnPress");
    this.m_targetWidget.RegisterToCallback(n"OnRelease", this, n"OnRelease");
  }

  protected cb func OnHoverOver(e: inkPointerEvent) -> Bool {
    this.TriggerOnHoverOverAnimations();
  }

  protected cb func OnHoverOut(e: inkPointerEvent) -> Bool {
    this.TriggerOnHoverOutAnimations();
  }

  protected cb func OnPress(e: inkPointerEvent) -> Bool {
    if e.IsAction(n"click") {
      this.TriggerOnPressAnimations();
    }
  }

  protected cb func OnRelease(e: inkPointerEvent) -> Bool {
    if e.IsAction(n"click") {
      this.TriggerOnReleaseAnimations();
    }
  }

  private final func TriggerOnHoverOutAnimations() {
    if this.m_onHoverOutAnimations != null {
      this.m_onHoverOutAnimations.TriggerAnimations(this);
    }
  }

  private final func TriggerOnHoverOverAnimations() {
    if this.m_onHoverOverAnimations != null {
      this.m_onHoverOverAnimations.TriggerAnimations(this);
    }
  }

  private final func TriggerOnPressAnimations() {
    if this.m_onPressAnimations != null {
      this.m_onPressAnimations.TriggerAnimations(this);
    }
  }

  private final func TriggerOnReleaseAnimations() {
    if this.m_onReleaseAnimations != null {
      this.m_onReleaseAnimations.TriggerAnimations(this);
    }
  }

  public final func RegisterAudioCallbacks(gameController: inkGameController) {
    this
      .m_targetWidget
      .RegisterToCallback(n"OnHoverOver", gameController, n"OnButtonHoverOver");
    this
      .m_targetWidget
      .RegisterToCallback(n"OnHoverOut", gameController, n"OnButtonHoverOut");
    this
      .m_targetWidget
      .RegisterToCallback(n"OnPress", gameController, n"OnButtonPress");
  }

  public final func GetWidgetAudioName() -> CName {
    return this.m_soundData.widgetAudioName;
  }

  public final func GetOnPressKeySfxName() -> CName {
    return this.m_soundData.onPressKey;
  }

  public final func GetOnReleaseKeySfxName() -> CName {
    return this.m_soundData.onReleaseKey;
  }

  public final func GetOnHoverOverKeySfxName() -> CName {
    return this.m_soundData.onHoverOverKey;
  }

  public final func GetOnHoverOutKeySfxName() -> CName {
    return this.m_soundData.onHoverOutKey;
  }

  public final func ATUI_GetButtonDisplayText() -> String {
    return inkTextRef.GetText(this.m_displayNameWidget);
  }
}

class WidgetAnimationManager extends IScriptable {
  private let m_animations: [SWidgetAnimationData];

  public final func Initialize(const animations: script_ref<[SWidgetAnimationData]>) {
    this.m_animations = animations;
  }

  public const final func GetAnimations() -> [SWidgetAnimationData] {
    return this.m_animations;
  }

  public final func UpdateAnimationsList(animName: CName, updateData: PlaybackOptionsUpdateData) {
    let animationData: SWidgetAnimationData;
    if !IsDefined(updateData) {
      return;
    } else if !this.HasAnimation(animName) {
      animationData.m_animationName = animName;
      animationData.m_playbackOptions = updateData.m_playbackOptions;
      ArrayPush(this.m_animations, animationData);
    }
  }

  public const final func HasAnimation(animName: CName) -> Bool {
    let i = 0;
    while i < ArraySize(this.m_animations) {
      if Equals(this.m_animations[i].m_animationName, animName) {
        return true;
      }
      i += 1;
    }
    return false;
  }

  public final func CleanAllAnimationsChachedData() {
    let i = 0;
    while i < ArraySize(this.m_animations) {
      if this.m_animations[i].m_animProxy != null {
        this.UnregisterAllCallbacks(this.m_animations[i]);
      }
      i += 1;
    }
  }

  public final func TriggerAnimations(owner: inkLogicController) {
    let i = 0;
    while i < ArraySize(this.m_animations) {
      if !IsNameValid(this.m_animations[i].m_animationName) {
      } else if this.m_animations[i].m_animProxy
        == null
        || !this.m_animations[i].m_lockWhenActive
        || this.m_animations[i].m_animProxy.IsFinished()
        || !this.m_animations[i].m_animProxy.IsPaused() && !this.m_animations[i].m_animProxy.IsPlaying() {
        if this.m_animations[i].m_animProxy != null {
          this.UnregisterAllCallbacks(this.m_animations[i]);
        } else {
          let currentProxy = owner
            .PlayLibraryAnimation(
              this.m_animations[i].m_animationName,
              this.m_animations[i].m_playbackOptions
            );
          this.m_animations[i].m_animProxy = currentProxy;
          this.RegisterAllCallbacks(owner, this.m_animations[i]);
        }
      }
      i += 1;
    }
  }

  public final func TriggerAnimations(owner: inkGameController) {
    let i = 0;
    while i < ArraySize(this.m_animations) {
      if !IsNameValid(this.m_animations[i].m_animationName) {
      } else if this.m_animations[i].m_animProxy
        == null
        || !this.m_animations[i].m_lockWhenActive
        || this.m_animations[i].m_animProxy.IsFinished()
        || !this.m_animations[i].m_animProxy.IsPaused() && !this.m_animations[i].m_animProxy.IsPlaying() {
        if this.m_animations[i].m_animProxy != null {
          this.UnregisterAllCallbacks(this.m_animations[i]);
        } else {
          let currentProxy = owner
            .PlayLibraryAnimation(
              this.m_animations[i].m_animationName,
              this.m_animations[i].m_playbackOptions
            );
          this.m_animations[i].m_animProxy = currentProxy;
          this.RegisterAllCallbacks(owner, this.m_animations[i]);
        }
      }
      i += 1;
    }
  }

  public final func TriggerAnimationByName(
    owner: inkLogicController,
    animName: CName,
    playbackOption: EInkAnimationPlaybackOption,
    opt targetWidget: inkWidget,
    opt playbackOptionsOverrideData: PlaybackOptionsUpdateData
  ) {
    let i = 0;
    if i < ArraySize(this.m_animations) {
      if !IsNameValid(this.m_animations[i].m_animationName) {
      } else if Equals(this.m_animations[i].m_animationName, animName) {
        if Equals(playbackOption, EInkAnimationPlaybackOption.PLAY) {
          if this.m_animations[i].m_animProxy
            == null
            || !this.m_animations[i].m_lockWhenActive
            || this.m_animations[i].m_animProxy.IsFinished()
            || !this.m_animations[i].m_animProxy.IsPaused() && !this.m_animations[i].m_animProxy.IsPlaying() {
            if IsDefined(playbackOptionsOverrideData) {
              let playbackOptionsData = playbackOptionsOverrideData.m_playbackOptions;
            } else {
              playbackOptionsData = this.m_animations[i].m_playbackOptions;
              if this.m_animations[i].m_animProxy != null {
                this
                  .ResolveActiveAnimDataPlaybackState(this.m_animations[i], EInkAnimationPlaybackOption.STOP);
              } else if IsDefined(targetWidget) {
                let currentProxy = owner
                  .PlayLibraryAnimationOnAutoSelectedTargets(
                    this.m_animations[i].m_animationName,
                    targetWidget,
                    playbackOptionsData
                  );
              } else {
                currentProxy = owner
                  .PlayLibraryAnimation(this.m_animations[i].m_animationName, playbackOptionsData);
                this.m_animations[i].m_animProxy = currentProxy;
                this.RegisterAllCallbacks(owner, this.m_animations[i]);
              }
              if this.m_animations[i].m_animProxy != null {
                let animData = this.m_animations[i];
                if IsDefined(playbackOptionsOverrideData) {
                  animData.m_playbackOptions = playbackOptionsOverrideData.m_playbackOptions;
                } else {
                  this.ResolveActiveAnimDataPlaybackState(animData, playbackOption);
                }
              }
            }
          }
        }
      }
      i += 1;
    }
  }

  public final func TriggerAnimationByName(
    owner: inkGameController,
    animName: CName,
    playbackOption: EInkAnimationPlaybackOption,
    opt targetWidget: inkWidget,
    opt playbackOptionsOverrideData: PlaybackOptionsUpdateData
  ) {
    let i = 0;
    if i < ArraySize(this.m_animations) {
      if !IsNameValid(this.m_animations[i].m_animationName) {
      } else if Equals(this.m_animations[i].m_animationName, animName) {
        if Equals(playbackOption, EInkAnimationPlaybackOption.PLAY) {
          if this.m_animations[i].m_animProxy
            == null
            || !this.m_animations[i].m_lockWhenActive
            || this.m_animations[i].m_animProxy.IsFinished()
            || !this.m_animations[i].m_animProxy.IsPaused() && !this.m_animations[i].m_animProxy.IsPlaying() {
            if IsDefined(playbackOptionsOverrideData) {
              let playbackOptionsData = playbackOptionsOverrideData.m_playbackOptions;
            } else {
              playbackOptionsData = this.m_animations[i].m_playbackOptions;
              if this.m_animations[i].m_animProxy != null {
                this
                  .ResolveActiveAnimDataPlaybackState(this.m_animations[i], EInkAnimationPlaybackOption.STOP);
              } else if IsDefined(targetWidget) {
                let currentProxy = owner
                  .PlayLibraryAnimationOnAutoSelectedTargets(
                    this.m_animations[i].m_animationName,
                    targetWidget,
                    playbackOptionsData
                  );
              } else {
                currentProxy = owner
                  .PlayLibraryAnimation(this.m_animations[i].m_animationName, playbackOptionsData);
                this.m_animations[i].m_animProxy = currentProxy;
                this.RegisterAllCallbacks(owner, this.m_animations[i]);
              }
              if this.m_animations[i].m_animProxy != null {
                let animData = this.m_animations[i];
                if IsDefined(playbackOptionsOverrideData) {
                  animData.m_playbackOptions = playbackOptionsOverrideData.m_playbackOptions;
                } else {
                  this.ResolveActiveAnimDataPlaybackState(animData, playbackOption);
                }
              }
            }
          }
        }
      }
      i += 1;
    }
  }

  private final func ResolveActiveAnimDataPlaybackState(
    const animData: script_ref<SWidgetAnimationData>,
    requestedState: EInkAnimationPlaybackOption
  ) {
    if animData.m_animProxy == null {
      return;
    } else if Equals(requestedState, EInkAnimationPlaybackOption.STOP) {
      animData.m_animProxy.Stop(false);
      this.UnregisterAllCallbacks(animData);
    } else if Equals(requestedState, EInkAnimationPlaybackOption.PAUSE) {
      animData.m_animProxy.Pause();
    } else if Equals(requestedState, EInkAnimationPlaybackOption.RESUME) {
      animData.m_animProxy.Resume();
    } else if Equals(requestedState, EInkAnimationPlaybackOption.CONTINUE) {
      animData.m_animProxy.Continue(animData.m_playbackOptions);
    } else if Equals(requestedState, EInkAnimationPlaybackOption.GO_TO_START) {
      animData.m_animProxy.GotoStartAndStop(false);
      this.UnregisterAllCallbacks(animData);
    } else if Equals(requestedState, EInkAnimationPlaybackOption.GO_TO_END) {
      animData.m_animProxy.GotoEndAndStop(false);
      this.UnregisterAllCallbacks(animData);
    }
  }

  public final func UnregisterAllCallbacks(const animData: script_ref<SWidgetAnimationData>) {
    if animData.m_animProxy != null {
      if IsNameValid(animData.m_onFinish) {
        animData.m_animProxy.UnregisterFromAllCallbacks(inkanimEventType.OnFinish);
      } else if IsNameValid(animData.m_onStart) {
        animData.m_animProxy.UnregisterFromAllCallbacks(inkanimEventType.OnStart);
      } else if IsNameValid(animData.m_onPasue) {
        animData.m_animProxy.UnregisterFromAllCallbacks(inkanimEventType.OnPause);
      } else if IsNameValid(animData.m_onResume) {
        animData.m_animProxy.UnregisterFromAllCallbacks(inkanimEventType.OnResume);
      } else if IsNameValid(animData.m_onStartLoop) {
        animData.m_animProxy.UnregisterFromAllCallbacks(inkanimEventType.OnStartLoop);
      } else if IsNameValid(animData.m_onEndLoop) {
        animData.m_animProxy.UnregisterFromAllCallbacks(inkanimEventType.OnEndLoop);
      }
    }
    this.CleanProxyData(animData);
  }

  public final func RegisterAllCallbacks(owner: IScriptable, const animData: script_ref<SWidgetAnimationData>) {
    if animData.m_animProxy != null {
      if IsNameValid(animData.m_onFinish) {
        animData
          .m_animProxy
          .RegisterToCallback(inkanimEventType.OnFinish, owner, animData.m_onFinish);
      } else if IsNameValid(animData.m_onStart) {
        animData
          .m_animProxy
          .RegisterToCallback(inkanimEventType.OnStart, owner, animData.m_onStart);
      } else if IsNameValid(animData.m_onPasue) {
        animData
          .m_animProxy
          .RegisterToCallback(inkanimEventType.OnPause, owner, animData.m_onPasue);
      } else if IsNameValid(animData.m_onResume) {
        animData
          .m_animProxy
          .RegisterToCallback(inkanimEventType.OnResume, owner, animData.m_onResume);
      } else if IsNameValid(animData.m_onStartLoop) {
        animData
          .m_animProxy
          .RegisterToCallback(inkanimEventType.OnStartLoop, owner, animData.m_onStartLoop);
      } else if IsNameValid(animData.m_onEndLoop) {
        animData
          .m_animProxy
          .RegisterToCallback(inkanimEventType.OnEndLoop, owner, animData.m_onEndLoop);
      }
    }
  }

  public final func ResolveCallback(owner: IScriptable, animProxy: inkAnimProxy, eventType: inkanimEventType) {
    if animProxy == null {
      return;
    }
    let i = 0;
    while i < ArraySize(this.m_animations) {
      if this.m_animations[i].m_animProxy == animProxy {
        if Equals(eventType, inkanimEventType.OnFinish) {
          this.UnregisterAllCallbacks(this.m_animations[i]);
          this.m_animations[i].m_animProxy = null;
        } else {
          animProxy
            .UnregisterFromCallback(
              eventType,
              owner,
              this.GetAnimationCallbackName(this.m_animations[i], eventType)
            );
        }
      }
      i += 1;
    }
  }

  private final func GetAnimationCallbackName(const animData: script_ref<SWidgetAnimationData>, eventType: inkanimEventType) -> CName {
    let returnValue: CName;
    if Equals(eventType, inkanimEventType.OnStart) {
      animData.m_onStart;
    } else if Equals(eventType, inkanimEventType.OnFinish) {
      animData.m_onFinish;
    } else if Equals(eventType, inkanimEventType.OnPause) {
      animData.m_onPasue;
    } else if Equals(eventType, inkanimEventType.OnResume) {
      animData.m_onResume;
    } else if Equals(eventType, inkanimEventType.OnStartLoop) {
      animData.m_onStartLoop;
    } else if Equals(eventType, inkanimEventType.OnEndLoop) {
      animData.m_onEndLoop;
    }
    return returnValue;
  }

  private final func CleanProxyData(const animData: script_ref<SWidgetAnimationData>) {
    let i = 0;
    if i < ArraySize(this.m_animations) {
      if this.m_animations[i].m_animProxy == animData.m_animProxy {
        this.m_animations[i].m_animProxy = null;
      } else {
        i += 1;
      }
    }
  }
}

struct SWidgetAnimationData {
  public let m_animationName: CName;
  public let m_playbackOptions: inkAnimOptions;
  public let m_lockWhenActive: Bool;
  public let m_animProxy: inkAnimProxy;
  public let m_onFinish: CName;
  public let m_onStart: CName;
  public let m_onPasue: CName;
  public let m_onResume: CName;
  public let m_onStartLoop: CName;
  public let m_onEndLoop: CName;
}

