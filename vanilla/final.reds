native class DismembermentComponent extends IComponent {
  private final native func ReportExplosion(hitPosition: Vector4, strength: Float);

  private final native func DoDismemberment(
    bodyPart: gameDismBodyPart,
    woundType: gameDismWoundType,
    opt strength: Float,
    isCritical: Bool,
    opt debrisPath: String,
    opt debrisStrength: Float
  );

  private final native func SpawnGutsFromLastHit(resourcePath: String, strength: Float);

  public final native func GetDismemberedLimbCount() -> DismemberedLimbCount;

  public final static func RequestGutsFromLastHit(obj: GameObject, const resourcePath: script_ref<String>, strength: Float) {
    let evt = new DismembermentDebrisEvent();
    evt.m_resourcePath = resourcePath;
    evt.m_strength = strength;
    obj.QueueEvent(evt);
  }

  public final static func RequestDismemberment(
    obj: GameObject,
    bodyPart: gameDismBodyPart,
    woundType: gameDismWoundType,
    opt hitPosition: Vector4,
    opt isCritical: Bool,
    opt debrisPath: String,
    opt debrisStrength: Float
  ) {
    let evt = new DismembermentEvent();
    evt.m_bodyPart = bodyPart;
    evt.m_woundType = woundType;
    evt.m_strength = 8.0;
    evt.m_isCritical = isCritical;
    evt.m_debrisPath = debrisPath;
    evt.m_debrisStrength = debrisStrength;
    obj.QueueEvent(evt);
    if Vector4.IsZero(hitPosition) {
      return;
    }
    let audioEvt = new DismembermentAudioEvent();
    switch evt.m_bodyPart {
      case gameDismBodyPart.HEAD:
        audioEvt.bodyPart = entAudioDismembermentPart.Head;
        break;
      case gameDismBodyPart.LEFT_ARM:
      case gameDismBodyPart.RIGHT_ARM:
        audioEvt.bodyPart = entAudioDismembermentPart.Arm;
        break;
      case gameDismBodyPart.LEFT_LEG:
      case gameDismBodyPart.RIGHT_LEG:
        audioEvt.bodyPart = entAudioDismembermentPart.Leg;
        break;
      default:
        audioEvt.position = hitPosition;
    }
    obj.QueueEvent(audioEvt);
    if !obj.IsPlayer() {
      let playerObject = GameInstance.GetPlayerSystem(obj.GetGame()).GetLocalPlayerMainGameObject();
      if PlayerDevelopmentSystem
        .GetData(playerObject)
        .IsNewPerkBought(gamedataNewPerkType.Reflexes_Master_Perk_5) > 0 {
        StatusEffectHelper
          .ApplyStatusEffect(playerObject, t"BaseStatusEffect.Reflexes_Master_Perk_5_Buff_Level_1");
      }
    }
  }

  protected cb func OnDismemberment(evt: DismembermentEvent) -> Bool {
    this
      .DoDismemberment(
        evt.m_bodyPart,
        evt.m_woundType,
        evt.m_strength,
        evt.m_isCritical,
        evt.m_debrisPath,
        evt.m_debrisStrength
      );
  }

  protected cb func OnDismembermentExplosion(evt: DismembermentExplosionEvent) -> Bool {
    this.ReportExplosion(evt.m_epicentrum, evt.m_strength);
  }

  protected cb func OnDismembermentDebris(evt: DismembermentDebrisEvent) -> Bool {
    this.SpawnGutsFromLastHit(evt.m_resourcePath, evt.m_strength);
  }
}

