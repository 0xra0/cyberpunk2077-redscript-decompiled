  public final static func ReturnRetrievableWeaponMods(itemData: wref<gameItemData>, owner: wref<GameObject>) {
    if !IsDefined(itemData) || !IsDefined(owner) {
      return;
    }
    let restoredAttachments = RPGManager.GetRetrievableAttachments(itemData);
    let transactionSystem = GameInstance.GetTransactionSystem(owner.GetGame());
    let i = 0;
    while i < ArraySize(restoredAttachments) {
      let removedID = transactionSystem
        .RemovePart(owner, itemData.GetID(), restoredAttachments[i].attachmentSlotID);
      if ItemID.IsValid(removedID) {
        transactionSystem.GiveItem(owner, restoredAttachments[i].itemID, 1);
      }
      i += 1;
    }
  }

  public final static func GetRetrievableAttachments(itemData: wref<gameItemData>) -> [ItemAttachments] {
    let restoredAttachments: [ItemAttachments];
    let innerPart: InnerItemData;
    if !IsDefined(itemData) {
      return restoredAttachments;
    } else if Equals(RPGManager.GetItemCategory(itemData.GetID()), gamedataItemCategory.Weapon) {
      let slotsToCheck = RPGManager.GetAttachmentSlotIDs();
      let tempArr = RPGManager.GetModsSlotIDs(itemData.GetItemType());
      let i = 0;
      if i < ArraySize(tempArr) {
        ArrayPush(slotsToCheck, tempArr[i]);
        i += 1;
      }
      i = 0;
      if i < ArraySize(slotsToCheck) {
        itemData.GetItemPart(innerPart, slotsToCheck[i]);
        let innerPartID = InnerItemData.GetItemID(innerPart);
        let partTags = InnerItemData.GetStaticData(innerPart).Tags();
        if ItemID.IsValid(innerPartID) && ArrayContains(partTags, n"Retrievable") {
          ArrayPush(
            restoredAttachments,
            ItemAttachments.Create(innerPartID, slotsToCheck[i])
          );
        }
        i += 1;
      }
    }
    return restoredAttachments;
  }

