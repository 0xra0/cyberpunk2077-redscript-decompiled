  protected cb func OnRequestComponents(ri: EntityRequestComponentsInterface) -> Bool {
    super.OnRequestComponents(ri);
    EntityRequestComponentsInterface.RequestComponent(ri, n"projectileComponent", n"ProjectileComponent", true);
    EntityRequestComponentsInterface
      .RequestComponent(ri, n"StimBroadcaster", n"StimBroadcasterComponent", true);
    EntityRequestComponentsInterface.RequestComponent(ri, n"ShootCollision", n"SimpleColliderComponent", false);
    EntityRequestComponentsInterface.RequestComponent(ri, n"GrenadeBody", n"IComponent", false);
    EntityRequestComponentsInterface.RequestComponent(ri, n"homing_mesh", n"IComponent", false);
    EntityRequestComponentsInterface.RequestComponent(ri, n"sticky_mesh", n"IComponent", false);
    EntityRequestComponentsInterface.RequestComponent(ri, n"sticky_decals", n"IComponent", false);
    EntityRequestComponentsInterface.RequestComponent(ri, n"targetingComponent", n"TargetingComponent", true);
    EntityRequestComponentsInterface
      .RequestComponent(ri, n"ResourceLibrary", n"ResourceLibraryComponent", true);
  }

  protected cb func OnTakeControl(ri: EntityResolveComponentsInterface) -> Bool {
    super.OnTakeControl(ri);
    this.m_projectileComponent = EntityResolveComponentsInterface.GetComponent(ri, n"projectileComponent") as ProjectileComponent;
    this.m_shootCollision = EntityResolveComponentsInterface.GetComponent(ri, n"ShootCollision") as SimpleColliderComponent;
    this.m_visualComponent = EntityResolveComponentsInterface.GetComponent(ri, n"GrenadeBody");
    this.m_stickyMeshComponent = EntityResolveComponentsInterface.GetComponent(ri, n"sticky_mesh");
    this.m_decalsStickyComponent = EntityResolveComponentsInterface.GetComponent(ri, n"sticky_decals");
    this.m_homingMeshComponent = EntityResolveComponentsInterface.GetComponent(ri, n"homing_mesh");
    this.m_targetingComponent = EntityResolveComponentsInterface.GetComponent(ri, n"targetingComponent") as TargetingComponent;
    this.m_resourceLibraryComponent = EntityResolveComponentsInterface.GetComponent(ri, n"ResourceLibrary") as ResourceLibraryComponent;
  }

  protected final func PreloadAttackResources() {
    let effectSystem = GameInstance.GetGameEffectSystem(this.GetGame());
    PreloadGameEffectAttackResources(this.m_tweakRecord.Attack() as Attack_GameEffect_Record, effectSystem);
    PreloadGameEffectAttackResources(
      this.m_tweakRecord.AdditionalAttack() as Attack_GameEffect_Record,
      effectSystem
    );
    PreloadGameEffectAttackResources(this.m_tweakRecord.EnemyAttack() as Attack_GameEffect_Record, effectSystem);
    PreloadGameEffectAttackResources(
      this.m_tweakRecord.NpcHitReactionAttack() as Attack_GameEffect_Record,
      effectSystem
    );
    PreloadGameEffectAttackResources(
      this.m_tweakRecord.ShallowWaterAttack() as Attack_GameEffect_Record,
      effectSystem
    );
    PreloadGameEffectAttackResources(this.m_tweakRecord.DeepWaterAttack() as Attack_GameEffect_Record, effectSystem);
    PreloadGameEffectAttackResources(
      this.m_tweakRecord.EnhancedPerkAttack() as Attack_GameEffect_Record,
      effectSystem
    );
    PreloadGameEffectAttackResources(
      TweakDBInterface.GetAttackRecord(t"Attacks.ReconGrenadeBeams") as Attack_GameEffect_Record,
      effectSystem
    );
  }

  protected final func ReleaseAttackResources() {
    let effectSystem = GameInstance.GetGameEffectSystem(this.GetGame());
    ReleaseGameEffectAttackResources(this.m_tweakRecord.Attack() as Attack_GameEffect_Record, effectSystem);
    ReleaseGameEffectAttackResources(
      this.m_tweakRecord.AdditionalAttack() as Attack_GameEffect_Record,
      effectSystem
    );
    ReleaseGameEffectAttackResources(this.m_tweakRecord.EnemyAttack() as Attack_GameEffect_Record, effectSystem);
    ReleaseGameEffectAttackResources(
      this.m_tweakRecord.NpcHitReactionAttack() as Attack_GameEffect_Record,
      effectSystem
    );
    ReleaseGameEffectAttackResources(
      this.m_tweakRecord.ShallowWaterAttack() as Attack_GameEffect_Record,
      effectSystem
    );
    ReleaseGameEffectAttackResources(this.m_tweakRecord.DeepWaterAttack() as Attack_GameEffect_Record, effectSystem);
    ReleaseGameEffectAttackResources(
      this.m_tweakRecord.EnhancedPerkAttack() as Attack_GameEffect_Record,
      effectSystem
    );
    ReleaseGameEffectAttackResources(
      TweakDBInterface.GetAttackRecord(t"Attacks.ReconGrenadeBeams") as Attack_GameEffect_Record,
      effectSystem
    );
  }

  protected cb func OnVisualSpawnAttached() -> Bool {
    super.OnVisualSpawnAttached();
    if this.IsConnectedWithDrop() {
      this.SetThrowableAnimFeatureOnGrenade(3, this);
    }
  }

  protected cb func OnProjectileInitialize(eventData: gameprojectileSetUpEvent) -> Bool {
    this.m_user = eventData.owner;
    this.m_tweakRecord = TweakDBInterface.GetGrenadeRecord(ItemID.GetTDBID(this.GetItemID()));
    this.deliveryMethod = this
      .m_tweakRecord
      .DeliveryMethod()
      .Type()
      .Type();
    this.Reset();
    this.SetupDeliveryMethodMesh();
    this
      .m_projectileComponent
      .SetEnergyLossFactor(this.m_tweakRecord.DeliveryMethod().Bounciness(), 0.11);
    this.m_projectileComponent.SetExplosionVisualRadius(this.GetAttackRadius());
    this.m_projectileComponent.SetCollisionEvaluator(new GrenadeCollisionEvaluator());
    this
      .m_projectileComponent
      .SetDeactivationDepth(this.m_tweakRecord.SinkingDepth());
    this.PreloadAttackResources();
  }

  protected func Reset() {
    let invalidHomingTarget: GrenadePotentialHomingTarget;
    let delaySystem = GameInstance.GetDelaySystem(this.GetGame());
    let invalidDelayID = GetInvalidDelayID();
    this.m_isAlive = true;
    this.m_isSinking = false;
    this.m_landedOnGround = false;
    this.m_isStuck = false;
    this.m_isTracking = false;
    this.m_timeSinceLaunch = 0.0;
    this.m_timeSinceExplosion = 0.0;
    this.m_timeOfFreezing = 9.99999e5;
    this.m_hasClearedIgnoredObject = false;
    this.m_isLockingOn = false;
    this.m_isLockedOn = false;
    this.m_readyToTrack = false;
    this.m_lockOnFailed = false;
    this.m_shotDownByThePlayer = false;
    this.m_forceExplosion = false;
    this.m_detonateOnImpact = false;
    this.m_targetAcquired = false;
    this.m_collidedWithNPC = false;
    this.m_isBroadcastingStim = false;
    this.m_playingFastBeep = false;
    this.m_hasExploded = false;
    this.m_homingGrenadeTarget = invalidHomingTarget;
    ArrayClear(this.m_potentialHomingTargets);
    ArrayClear(this.m_cuttingGrenadePotentialTargets);
    ArrayClear(this.m_attacksSpawned);
    this.m_drillTargetPosition = Vector4.EmptyVector();
    this.lastHitNormal = Vector4.EmptyVector();
    this.m_landedCooldownActive = false;
    this.m_landedCooldownTimer = 0.0;
    this.m_hasHitWater = false;
    this.m_waterHeight = 0.0;
    this.m_isContinuousEffect = TweakDBInterface.GetBool(ItemID.GetTDBID(this.GetItemID()) + t".isContinuousEffect", false);
    this.m_delayToDetonate = TweakDBInterface.GetFloat(ItemID.GetTDBID(this.GetItemID()) + t".delayToDetonate", 0.1);
    this.m_setStickyTracker = TweakDBInterface.GetBool(ItemID.GetTDBID(this.GetItemID()) + t".setStickyTracker", false);
    this.m_stickyTrackerTimeout = TweakDBInterface.GetFloat(ItemID.GetTDBID(this.GetItemID()) + t".stickyTrackerTimeout", 10.0);
    this.m_additionalAttackOnDetonate = TweakDBInterface
      .GetBool(ItemID.GetTDBID(this.GetItemID()) + t".additionalAttackOnDetonate", false);
    this.m_additionalAttackOnCollision = TweakDBInterface
      .GetBool(ItemID.GetTDBID(this.GetItemID()) + t".additionalAttackOnCollision", false);
    this.m_smokeEffectRadius = TweakDBInterface.GetFloat(ItemID.GetTDBID(this.GetItemID()) + t".smokeEffectRadius", 0.0);
    this.m_smokeEffectDuration = TweakDBInterface.GetFloat(ItemID.GetTDBID(this.GetItemID()) + t".smokeEffectDuration", 0.0);
    this.m_smokeVisionBlockerId = 0u;
    if this.m_spawnBlinkEffectDelayID != invalidDelayID {
      delaySystem.CancelDelay(this.m_spawnBlinkEffectDelayID);
      this.m_spawnBlinkEffectDelayID = invalidDelayID;
    } else if this.m_detonateRequestDelayID != invalidDelayID {
      delaySystem.CancelDelay(this.m_detonateRequestDelayID);
      this.m_detonateRequestDelayID = invalidDelayID;
    } else if this.m_releaseRequestDelayID != invalidDelayID {
      delaySystem.CancelDelay(this.m_releaseRequestDelayID);
      this.m_releaseRequestDelayID = invalidDelayID;
    }
    this.SetCanBeShot(false);
    if IsDefined(this.m_targetingComponent) && IsDefined(this.m_user as NPCPuppet) {
      this.m_targetingComponent.Toggle(true);
    } else if IsDefined(this.m_visualComponent) {
      this.m_visualComponent.Toggle(true);
    }
    this.m_detonationTimer = 0.0;
    this.m_detonationTimerActive = false;
    if Equals(this.deliveryMethod, gamedataGrenadeDeliveryMethodType.Regular) {
      this.m_detonationTimerActive = true;
    } else if Equals(this.deliveryMethod, gamedataGrenadeDeliveryMethodType.Sticky) {
      this.m_detonationTimerActive = true;
      this
        .m_projectileComponent
        .SetOnCollisionAction(gameprojectileOnCollisionAction.StopAndStick);
    } else if this.IsGrenadeOfType(EGrenadeType.Piercing) {
      this
        .m_projectileComponent
        .SetOnCollisionAction(gameprojectileOnCollisionAction.StopAndStickPerpendicular);
    } else if Equals(this.deliveryMethod, gamedataGrenadeDeliveryMethodType.Homing) {
      this.m_timeOfFreezing = (this.m_tweakRecord.DeliveryMethod() as HomingGDM_Record).FreezeDelay();
    }
    this.InitializeRotation();
  }

  protected final func SetupDeliveryMethodMesh() {
    if Equals(this.deliveryMethod, gamedataGrenadeDeliveryMethodType.Sticky) {
      this.m_stickyMeshComponent.Toggle(true);
      this.m_decalsStickyComponent.Toggle(true);
    } else if Equals(this.deliveryMethod, gamedataGrenadeDeliveryMethodType.Homing) {
      this.m_homingMeshComponent.Toggle(true);
    }
  }

  public final func GetAttackRadius() -> Float {
    if this.IsGrenadeTargetedWithFocusedShootingPerk() && this.m_tweakRecord.EnhancedAttackRadiusFromPerk() > 0.0 {
      return this.m_tweakRecord.EnhancedAttackRadiusFromPerk();
    }
    let data = this.GetItemData();
    let value = data.GetStatValueByType(gamedataStatType.Range);
    return value;
  }

  public final func GetAttackDuration() -> Float {
    if this.IsGrenadeTargetedWithFocusedShootingPerk() && this.m_tweakRecord.EnhancedAttackDurationFromPerk() > 0.0 {
      return this.m_tweakRecord.EnhancedAttackDurationFromPerk();
    }
    return this.m_tweakRecord.AttackDuration();
  }

  public final func GetDefaultAttack() -> wref<Attack_Record> {
    if this.IsGrenadeTargetedWithFocusedShootingPerk() && IsDefined(this.m_tweakRecord.EnhancedPerkAttack()) {
      return this.m_tweakRecord.EnhancedPerkAttack();
    }
    return this.m_tweakRecord.Attack();
  }

  public final func GetInitialVelocity(isQuickThrow: Bool) -> Float {
    let initialVelocity: Float;
    let tweakRecord = TweakDBInterface.GetGrenadeRecord(ItemID.GetTDBID(this.GetItemID()));
    if !isQuickThrow {
      initialVelocity = tweakRecord.DeliveryMethod().InitialVelocity();
    } else {
      initialVelocity = tweakRecord.DeliveryMethod().InitialQuickThrowVelocity();
    }
    return initialVelocity;
  }

  public final func GetAccelerationZ() -> Float {
    let tweakRecord = TweakDBInterface.GetGrenadeRecord(ItemID.GetTDBID(this.GetItemID()));
    return tweakRecord.DeliveryMethod().AccelerationZ();
  }

  public final func SetCanBeShot(canBeShot: Bool) {
    this.m_canBeShot = canBeShot;
    if this.m_shootCollision != null {
      if this.m_canBeShot {
        this.m_shootCollision.Resize(this.GetShootCollisionSize(), 0u);
      }
      this.m_shootCollision.Toggle(this.m_canBeShot);
    }
  }

  protected cb func OnShoot(eventData: gameprojectileShootEvent) -> Bool {
    let grenadeMappinData: MappinData;
    this.m_projectileSpawnPoint = eventData.startPoint;
    if !StatusEffectSystem
      .ObjectHasStatusEffect(eventData.owner, t"BaseStatusEffect.BlockNPCGrenadeBark") {
      GameObject
        .PlayVoiceOver(eventData.owner, n"grenade_throw", n"Scripts:Grenade_OnShoot");
    }
    GameInstance.GetQuestsSystem(this.GetGame()).SetFact(n"player_threw_a_grenade", 1);
    this.Reset();
    if this.m_user != null && this.m_mappinID.value == 0ul {
      let grenadeMappinScriptData = new GrenadeMappinData();
      grenadeMappinScriptData.m_grenadeType = this.GetGrenadeType();
      grenadeMappinScriptData.m_iconID = this.GetMappinIconIDForGrenadeType(grenadeMappinScriptData.m_grenadeType);
      grenadeMappinData.mappinType = t"Mappins.InteractionMappinDefinition";
      grenadeMappinData.variant = gamedataMappinVariant.GrenadeVariant;
      grenadeMappinData.active = true;
      grenadeMappinData.scriptData = grenadeMappinScriptData;
      this.m_mappinID = GameInstance
        .GetMappinSystem(this.m_user.GetGame())
        .RegisterGrenadeMappin(grenadeMappinData, this);
    } else if Equals(this.deliveryMethod, gamedataGrenadeDeliveryMethodType.Regular) && !this.m_isContinuousEffect {
      this.SetTracking(true);
      if this.m_tweakRecord.DeliveryMethod().TrackingRadius() > 0.0 {
        GameObject.StartReplicatedEffectEvent(this, n"fx_regular_scanning", true, false);
      } else if this.m_isContinuousEffect {
        let spawnBlinkEffectRequest = new CuttingGrenadeSpawnBlinkEffectEvent();
        this.m_spawnBlinkEffectDelayID = GameInstance
          .GetDelaySystem(this.GetGame())
          .DelayEvent(this, spawnBlinkEffectRequest, this.m_delayToDetonate, true);
        this.RequestGrenadeDetonation(this.m_delayToDetonate);
      } else if Equals(this.deliveryMethod, gamedataGrenadeDeliveryMethodType.Sticky) {
        this.PlayStickyGrenadeLongBeepSound();
      }
    }
    this.PlayNPCGrenadeBeepSound();
  }

  protected cb func OnShootTarget(eventData: gameprojectileShootTargetEvent) -> Bool {
    this.OnShoot(eventData);
  }

  protected cb func OnCollision(eventData: gameprojectileHitEvent) -> Bool {
    if !this.m_isAlive || this.m_isSinking {
      return false;
    }
    let i = 0;
    if i < ArraySize(eventData.hitInstances) {
      let hitInstance = eventData.hitInstances[i];
      if hitInstance.isWaterSurfaceImpact {
        if !hitInstance.hitThroughWaterSurface {
          this.m_hasHitWater = true;
          this.m_waterHeight = hitInstance.position.Z;
          if !GameObject.IsCooldownActive(this, n"grenade_water_impact_effects") {
            this.SpawnEffectFromLibrary(n"splash_effect");
            GameObject.PlaySound(this, n"w_bul_hit_water_heavy");
            RenderingSystem
              .AddWaterImpulse(
                hitInstance.position,
                this.m_tweakRecord.WaterSurfaceImpactImpulseRadius(),
                this.m_tweakRecord.WaterSurfaceImpactImpulseStrength()
              );
            GameObject.StartCooldown(this, n"grenade_water_impact_effects", 0.2);
          }
        }
      }
      if this.m_hasHitWater
        && hitInstance.position.Z - this.m_waterHeight <= this.m_tweakRecord.SinkingDepth() {
      } else {
        let puppetTarget = hitInstance.hitObject as ScriptedPuppet;
        this.lastHitNormal = Cast<Vector4>(hitInstance.traceResult.normal);
        if !this.m_landedOnGround
          && Vector4.GetAngleBetween(this.lastHitNormal, new Vector4(0.0, 0.0, 1.0, 0.0)) < 35.0 {
          this.m_landedOnGround = true;
        } else if !GameObject.IsCooldownActive(this, n"grenade_impact_sound") {
          let impactSpeed = Vector4.Length(hitInstance.velocity);
          GameObject.SetAudioParameter(this, n"ph_impact_velocity", impactSpeed);
          let tags = this.m_tweakRecord.Tags();
          if ArrayContains(tags, n"Ozob") {
            GameObject.PlaySound(this, n"gre_impact_solid_ozob");
          } else {
            GameObject.PlaySound(this, n"gre_impact_solid");
            GameObject.StartCooldown(this, n"grenade_impact_sound", 0.2);
            if this.IsGrenadeOfType(EGrenadeType.Piercing)
              && (NotEquals(this.deliveryMethod, gamedataGrenadeDeliveryMethodType.Homing) || this.m_targetAcquired) {
              if this.m_additionalAttackOnCollision && IsDefined(puppetTarget) {
                this
                  .SpawnOnPuppetCollisionAttack(this.m_tweakRecord.AdditionalAttack(), puppetTarget);
              } else {
                GameObject.StartReplicatedEffectEvent(this, n"fx_drill", true, true);
                this.DrillThrough(hitInstance);
              }
            } else if this.m_additionalAttackOnCollision && this.m_targetAcquired {
              if IsDefined(puppetTarget) {
                this
                  .SpawnOnPuppetCollisionAttack(this.m_tweakRecord.AdditionalAttack(), puppetTarget);
              } else {
                this.Detonate(this.lastHitNormal);
              }
            } else if this.m_detonateOnImpact {
              this.Detonate(this.lastHitNormal);
            } else if this.m_landedOnGround && !this.m_isBroadcastingStim {
              this.TriggerGrenadeLandedStimuli(true);
            } else if !this.m_collidedWithNPC
              && IsDefined(puppetTarget)
              && this.m_tweakRecord.DeliveryMethod().TrackingRadius() == 0.0 {
              this.m_collidedWithNPC = true;
              this.SpawnAttack(this.m_tweakRecord.NpcHitReactionAttack());
            } else if Equals(this.deliveryMethod, gamedataGrenadeDeliveryMethodType.Sticky) {
              GameObject.StartReplicatedEffectEvent(this, n"fx_sticky", true, true);
              GameObject.PlaySound(this, n"grenade_stick");
              this.m_isStuck = true;
            } else if Equals(this.deliveryMethod, gamedataGrenadeDeliveryMethodType.Homing) && !this.m_isTracking {
              this.m_timeOfFreezing = this.m_timeSinceLaunch
                + (this.m_tweakRecord.DeliveryMethod() as HomingGDM_Record).FreezeDelayAfterBounce();
            } else if this.IsGrenadeOfType(EGrenadeType.Cutting)
              && !this.m_isTracking
              && this.m_delayToDetonate + this.GetAttackDuration() - this.m_timeSinceLaunch > 0.5 {
              this.m_timeOfFreezing = this.m_timeSinceLaunch
                + TweakDBInterface
                  .GetFloat(
                    ItemID.GetTDBID(this.GetItemID()) + t".freezeDelayAfterBounce",
                    0.1
                  );
            }
            i += 1;
          }
        }
      }
    }
  }

  protected cb func OnForceActivation(evt: gameprojectileForceActivationEvent) -> Bool {
    this.m_forceExplosion = true;
  }

  protected cb func OnHit(evt: gameHitEvent) -> Bool {
    if this.m_isAlive {
      let instigatorIsPlayer = evt.attackData.GetInstigator() == GetPlayer(this.GetGame());
      if instigatorIsPlayer && this.m_canBeShot {
        this.m_shotDownByThePlayer = true;
        this.CheckForGunslingerAchievement(evt.attackData);
        this.Detonate();
        RPGManager
          .AwardExperienceInstantly(GetPlayer(this.GetGame()), 100, gamedataProficiencyType.CoolSkill);
      } else if this.m_isStuck && evt.attackData.HasFlag(hitFlag.DetonateGrenades) {
        this
          .RequestGrenadeDetonation(
            Vector4.Distance(this.GetWorldPosition(), evt.attackData.GetAttackPosition()) / 5.0
          );
      }
    }
  }

  protected final func CheckForGunslingerAchievement(attackData: AttackData) {
    let dataTrackingSystem = GameInstance.GetScriptableSystemsContainer(this.GetGame()).Get(n"DataTrackingSystem") as DataTrackingSystem;
    let achievement = gamedataAchievement.Gunslinger;
    if this.m_isSinking {
      return;
    } else if Equals(
      WeaponObject.GetWeaponType(attackData.GetWeapon().GetItemID()),
      gamedataItemType.Wea_Revolver
    ) {
      if Equals(
        GameObject.GetAttitudeTowards(this.m_user, GetPlayer(this.GetGame())),
        EAIAttitude.AIA_Hostile
      ) {
        if !this.m_landedOnGround {
          let achievementRequest = new AddAchievementRequest();
          achievementRequest.achievement = achievement;
          dataTrackingSystem.QueueRequest(achievementRequest);
        }
      }
    }
  }

  protected cb func OnTick(eventData: gameprojectileTickEvent) -> Bool {
    if this.m_detonationTimerActive {
      this.m_detonationTimer += eventData.deltaTime;
    } else if this.m_hasExploded {
      this.m_timeSinceExplosion += eventData.deltaTime;
    } else if this.m_landedCooldownActive {
      this.m_landedCooldownTimer += eventData.deltaTime;
      if this.m_landedCooldownTimer >= 1.0 {
        this.m_landedCooldownActive = false;
        this.m_landedCooldownTimer = 0.0;
      }
    }
    this.m_timeSinceLaunch += eventData.deltaTime;
    let isUnderwater = this.IsUnderwater();
    if isUnderwater && !this.m_isSinking {
      this.TryToSinkAndRequestDetonation();
    } else if this.m_isSinking {
      if this.IsGrenadeOfType(EGrenadeType.Cutting) && this.m_timeSinceLaunch > 2.5 {
        this.Release(true);
      }
      return false;
    } else if this.m_isAlive && !this.m_isContinuousEffect {
      if this.m_forceExplosion {
        this.Detonate();
      } else if this.m_detonationTimerActive
        && this.m_detonationTimer
          >= (this.m_landedOnGround ? this.m_tweakRecord.DeliveryMethod().DetonationTimer() * 0.5 : this.m_tweakRecord.DeliveryMethod().DetonationTimer()) {
        this.Detonate(this.lastHitNormal);
      } else if !this.m_hasClearedIgnoredObject && this.m_timeSinceLaunch >= 0.15 {
        this.m_hasClearedIgnoredObject = true;
        this.m_projectileComponent.ClearIgnoredEntities();
      } else if this.m_tweakRecord.ShootCollisionEnableDelay()
        >= 0.0
        && this.m_shootCollision != null
        && this.m_timeSinceLaunch >= this.m_tweakRecord.ShootCollisionEnableDelay()
        && Equals(this.m_canBeShot, false) {
        this.SetCanBeShot(true);
      } else if Equals(this.deliveryMethod, gamedataGrenadeDeliveryMethodType.Sticky) {
        if this.m_tweakRecord.DeliveryMethod().DetonationTimer() - this.m_detonationTimer <= 0.8 && !this.m_playingFastBeep {
          this.m_playingFastBeep = true;
          this.PlayStickyGrenadeShortBeepSound();
        }
      } else if Equals(this.deliveryMethod, gamedataGrenadeDeliveryMethodType.Homing) {
        if !isUnderwater
          && this.m_timeSinceLaunch >= this.m_timeOfFreezing
          && !this.m_isLockingOn
          && !this.m_lockOnFailed {
          this.DelayTargetTrackingStateChange(true, 1.0);
          this.Freeze();
          this.FloatToLockOnAltitude();
          if !this.m_isBroadcastingStim {
            this.TriggerGrenadeLandedStimuli(true);
          }
          GameObject.StartReplicatedEffectEvent(this, n"homing_thrust", true, false);
          this.m_isLockingOn = true;
          this.m_timeOfFreezing += 1.0;
        } else if this.m_isLockingOn
          && this.m_timeSinceLaunch
            - this.m_timeOfFreezing
            >= (this.m_tweakRecord.DeliveryMethod() as HomingGDM_Record).LockOnDelay()
          && !this.m_readyToTrack {
          this.m_readyToTrack = true;
          if this.m_targetAcquired {
            this
              .QueueSmartTrajectory((this.m_tweakRecord.DeliveryMethod() as HomingGDM_Record).LockOnDelay());
          }
        } else if this.m_isLockingOn
          && this.m_timeSinceLaunch
            - this.m_timeOfFreezing
            >= (this.m_tweakRecord.DeliveryMethod() as HomingGDM_Record).FreezeDuration()
          && !this.m_targetAcquired {
          this.DropToFloor();
          this.SetTracking(false);
          this
            .RequestGrenadeDetonation(
              (this.m_tweakRecord.DeliveryMethod() as HomingGDM_Record).LockOnFailDetonationDelay()
            );
          GameObject.BreakReplicatedEffectLoopEvent(this, n"fx_homing_freeze");
          GameObject.StopReplicatedEffectEvent(this, n"homing_thrust");
          this.m_isLockingOn = false;
          this.m_lockOnFailed = true;
        } else if !isUnderwater {
          if this.m_isAlive
            && this.IsGrenadeOfType(EGrenadeType.Cutting)
            && this.m_timeOfFreezing > 0.0
            && this.m_timeSinceLaunch > this.m_timeOfFreezing
            && !this.m_isLockingOn {
            this.FloatCuttingGrenadeUp();
            GameObject.StartReplicatedEffectEvent(this, n"homing_thrust", true, false);
            if !this.m_isBroadcastingStim {
              this.TriggerGrenadeLandedStimuli(true);
            }
            this.m_isLockingOn = true;
          } else if this.m_isContinuousEffect && this.m_timeSinceLaunch >= this.GetAttackDuration() {
            if this.IsGrenadeOfType(EGrenadeType.Cutting) && !this.m_lockOnFailed {
              this.StopCuttingGrenadeAttack();
            } else if !this.IsGrenadeOfType(EGrenadeType.Cutting) {
              this.Release(true);
            } else if this.m_isAlive && this.IsGrenadeOfType(EGrenadeType.Smoke) {
              if this.m_isSmokeEffectActive
                && this.m_timeSinceExplosion
                  >= this.m_smokeEffectDuration - this.m_smokeVFXDeescalationOffset {
                GameObject.BreakReplicatedEffectLoopEvent(this, n"fx_explosion");
                this.m_isSmokeEffectActive = false;
              } else if this.m_timeSinceExplosion >= this.m_smokeEffectDuration {
                this.UnregisterSmokeExplosion();
                this.Release(true);
              }
            }
          }
        }
      }
    }
    this.OnServerTick(eventData);
  }

  protected final func OnServerTick(eventData: gameprojectileTickEvent) {
    if GameInstance.GetRuntimeInfo(this.GetGame()).IsServer() {
      if !this.m_isAlive && this.m_timeSinceLaunch >= this.m_cpoTimeBeforeRelease {
        this.Release();
      }
    }
  }

  protected func Detonate(opt hitNormal: Vector4) {
    let effect: EffectInstance;
    let detonationLocation: Vector4;
    let detonationRumbleName: String;
    let detonationStimRadius: Float;
    let attackRadius: Float;
    let attack: wref<Attack_Record>;
    let isUnderwater = false;
    let isDeepUnderwater = false;
    if this.m_detonateRequestDelayID != GetInvalidDelayID() {
      GameInstance.GetDelaySystem(this.GetGame()).CancelDelay(this.m_detonateRequestDelayID);
      this.m_detonateRequestDelayID = GetInvalidDelayID();
    }
    let currentPosition = this.GetWorldPosition();
    isUnderwater = this.IsUnderwater();
    if isUnderwater {
      isDeepUnderwater = currentPosition.Z - this.m_waterHeight <= this.m_tweakRecord.DeepWaterDepth();
    } else if this.m_hasExploded {
      return;
    } else if this.m_isContinuousEffect && isUnderwater {
      let minDetonationDelay = this.m_delayToDetonate + this.m_tweakRecord.SinkingDetonationDelay();
      if this.m_timeSinceLaunch < minDetonationDelay {
        this.RequestGrenadeDetonation(minDetonationDelay - this.m_timeSinceLaunch);
        return;
      } else if Equals(this.deliveryMethod, gamedataGrenadeDeliveryMethodType.Homing) {
        GameObject.StopReplicatedEffectEvent(this, n"fx_homing_freeze");
        GameObject.StopReplicatedEffectEvent(this, n"homing_thrust");
        if IsDefined(this.m_homingGrenadeTarget.entity) {
          GameObject
            .SendForceRevealObjectEvent(this.m_homingGrenadeTarget.entity, false, n"HomingGrenade");
        }
      } else if Equals(this.deliveryMethod, gamedataGrenadeDeliveryMethodType.Sticky) {
        this.StopStickyGrenadeSounds();
        if this.m_tweakRecord.RemoveMeshOnDetonation() {
          GameObject.StopReplicatedEffectEvent(this, n"fx_sticky");
        }
      }
    }
    this.SetCanBeShot(false);
    this.StopNPCGrenadeBeepSound();
    this.RemoveGrenadeLandedStimuli();
    let attackDuration = this.GetAttackDuration();
    if isUnderwater {
      attack = isDeepUnderwater ? this.m_tweakRecord.DeepWaterAttack() : this.m_tweakRecord.ShallowWaterAttack();
      attackRadius = attack.Range();
      if this.m_tweakRecord.SpawnFxAtWaterSurface() {
        let vfxOffset = new Vector4(0.0, 0.0, this.m_waterHeight - currentPosition.Z, 0.0);
      }
      effect = this
        .SpawnAttack(
          attack,
          attackRadius,
          attackDuration,
          hitNormal,
          currentPosition,
          vfxOffset
        );
      effect.AttachToEntity(this, GetAllBlackboardDefs().EffectSharedData.position);
      this.AddWaterImpulsesOnDetonation(currentPosition, attackRadius, 4);
      detonationRumbleName = this.m_tweakRecord.UnderwaterDetonationRumbleName();
      detonationStimRadius = this.m_tweakRecord.UnderwaterDetonationStimRadius();
    } else {
      attack = this.GetDefaultAttack();
      attackRadius = this.GetAttackRadius();
      if this.IsGrenadeOfType(EGrenadeType.Cutting) {
        this.SpawnLaserAttack(attack, 48, attackRadius, attackDuration, false, 0.01);
      } else {
        effect = this.SpawnAttack(attack, attackRadius, attackDuration, hitNormal);
        effect.AttachToEntity(this, GetAllBlackboardDefs().EffectSharedData.position);
        if this.IsGrenadeOfType(EGrenadeType.Recon) {
          this
            .SpawnLaserAttack(
              TweakDBInterface.GetAttackRecord(t"Attacks.ReconGrenadeBeams"),
              36,
              attackRadius,
              attackDuration,
              true
            );
          let additionalEffect = this
            .SpawnAttack(
              this.m_tweakRecord.AdditionalAttack(),
              attackRadius,
              attackDuration,
              hitNormal
            );
          additionalEffect.AttachToEntity(this, GetAllBlackboardDefs().EffectSharedData.position);
        } else if this.m_additionalAttackOnDetonate && !this.IsGrenadeOfType(EGrenadeType.Recon) {
          attack = this.m_tweakRecord.AdditionalAttack();
          additionalEffect = this.SpawnAttack(attack, attack.Range(), 0.0, hitNormal);
          additionalEffect.AttachToEntity(this, GetAllBlackboardDefs().EffectSharedData.position);
        } else {
          this.SpawnVisualEffectsOnDetonation();
          let detonationSoundName = StringToName(this.m_tweakRecord.DetonationSound());
          GameObject.PlayMetadataEvent(this, detonationSoundName);
          GameInstance
            .GetAudioSystem(this.GetGame())
            .PlayShockwave(detonationSoundName, detonationLocation);
          detonationRumbleName = this.m_tweakRecord.DetonationRumbleName();
          detonationStimRadius = this.m_tweakRecord.DetonationStimRadius();
        }
      }
    }
    GameObject
      .PlaySound(this, TDB.GetCName(TDBID.Create("rumble.world." + detonationRumbleName)));
    this.TriggerStimuli(detonationStimRadius);
    if !this.IsGrenadeOfType(EGrenadeType.Recon)
      && !this.IsGrenadeOfType(EGrenadeType.Cutting)
      && !this.IsGrenadeOfType(EGrenadeType.Smoke) {
      this.SendCombatGadgetIsAliveFeature();
    } else if this.m_tweakRecord.RemoveMeshOnDetonation() || isUnderwater {
      if IsDefined(this.m_visualComponent) {
        this.m_visualComponent.Toggle(false);
      } else if IsDefined(this.m_stickyMeshComponent) {
        this.m_stickyMeshComponent.Toggle(false);
        this.m_decalsStickyComponent.Toggle(false);
      } else if IsDefined(this.m_homingMeshComponent) {
        this.m_homingMeshComponent.Toggle(false);
      }
    }
    this.OnExplosion();
    this.m_hasExploded = true;
    if this.m_tweakRecord.ReleaseOnDetonation() || isUnderwater {
      this.Release(isUnderwater);
    } else if this.IsGrenadeOfType(EGrenadeType.Smoke) {
      this.ReleaseMappin();
      this.RegisterSmokeExplosion(currentPosition);
    }
  }

  protected final func SendCombatGadgetIsAliveFeature() {
    let animFeature = new AnimFeature_CombatGadget();
    animFeature.isDetonated = true;
    AnimationControllerComponent.ApplyFeature(this, n"Grenade", animFeature);
  }

  protected final func SetThrowableAnimFeatureOnGrenade(newState: Int32, target: wref<GameObject>) {
    let feature = new AnimFeature_Throwable();
    feature.state = newState;
    AnimationControllerComponent.ApplyFeature(this, n"CombatGadget", feature);
  }

  protected func SpawnVisualEffectsOnDetonation() {
    if this.IsGrenadeOfType(EGrenadeType.Incendiary) {
    } else if this.IsGrenadeOfType(EGrenadeType.Piercing) {
      this.SpawnPiercingExplosion();
    } else if this.IsGrenadeOfType(EGrenadeType.Smoke) {
      GameObject.StartReplicatedEffectEvent(this, n"fx_explosion", true, true);
      this.m_isSmokeEffectActive = true;
    }
  }

  protected final func AddWaterImpulsesOnDetonation(position: Vector4, attackRadius: Float, numImpulses: Int32) {
    let impulseRadius = attackRadius * this.m_tweakRecord.WaterDetonationImpulseRadiusCoef() * RandRangeF(0.8, 1.2);
    let impulseStrength = this.m_tweakRecord.WaterDetonationImpulseStrength() * RandRangeF(0.1, 1.2);
    RenderingSystem.AddWaterImpulse(position, impulseRadius, impulseStrength);
    let i = 0;
    while i < numImpulses - 1 {
      RenderingSystem
        .AddWaterImpulse(
          position + Vector4.RandRing(impulseRadius * 0.25, impulseRadius * 0.9),
          impulseRadius * RandRangeF(0.4, 0.8),
          impulseStrength
        );
      i += 1;
    }
  }

  protected cb func OnCuttingGrenadeSpawnBlinkEffectEvent(evt: CuttingGrenadeSpawnBlinkEffectEvent) -> Bool {
    GameObject.StartReplicatedEffectEvent(this, n"fx_diode", true, false);
  }

  protected cb func OnCuttingGrenadeDespawnEffectsEvent(evt: CuttingGrenadeDespawnEffectsEvent) -> Bool {
    GameObjectEffectHelper.BreakEffectLoopEvent(this, n"fx_laser");
  }

  public final static func SendGrenadeAnimFeatureChangeEvent(owner: wref<GameObject>, itemID: ItemID) {
    if !IsDefined(owner) {
      return;
    }
    let item = GameInstance.GetTransactionSystem(owner.GetGame()).GetItemInSlotByItemID(owner, itemID);
    if !IsDefined(item) {
      return;
    }
    let evt = new GrenadeAnimFeatureChangeEvent();
    evt.newState = 1;
    item = GameInstance.GetTransactionSystem(owner.GetGame()).GetItemInSlotByItemID(owner, itemID);
    item.QueueEvent(evt);
  }

  protected cb func OnGrenadeAnimFeatureChange(evt: GrenadeAnimFeatureChangeEvent) -> Bool {
    this.SetThrowableAnimFeatureOnGrenade(evt.newState, this);
  }

  protected final func SpawnEffectFromLibrary(key: CName) {
    let transform: WorldTransform;
    let effect = this.m_resourceLibraryComponent.GetResource(key);
    if FxResource.IsValid(effect) {
      WorldTransform.SetPosition(transform, this.GetWorldPosition());
      WorldTransform
        .SetOrientationFromDir(transform, Quaternion.GetForward(this.GetWorldOrientation()));
      GameInstance.GetFxSystem(this.GetGame()).SpawnEffect(effect, transform);
    }
  }

  protected func SpawnEffectOnGround(groundEffect: FxResource) {
    let transform: WorldTransform;
    if FxResource.IsValid(groundEffect) && IsDefined(this.m_user) {
      WorldTransform.SetPosition(transform, this.GetWorldPosition());
      let ground = this.m_user.GetWorldForward();
      ground.Z = 0.0;
      WorldTransform.SetOrientationFromDir(transform, ground);
      GameInstance
        .GetFxSystem(this.GetGame())
        .SpawnEffectOnGround(groundEffect, transform, 2.5);
    }
  }

  protected func SpawnPiercingExplosion() {
    let transform: WorldTransform;
    if FxResource.IsValid(this.m_additionalEffect) && IsDefined(this.m_user) {
      if !Vector4.IsZero(this.m_drillTargetPosition) {
        WorldTransform.SetPosition(transform, this.m_drillTargetPosition);
      } else {
        WorldTransform.SetPosition(transform, this.GetWorldPosition());
      }
      GameInstance
        .GetFxSystem(this.GetGame())
        .SpawnEffect(this.m_additionalEffect, transform);
    }
  }

  private final func RegisterSmokeExplosion(position: Vector4) {
    let blockerShape = VisionBlockerShape_BasicHemisphere.Create(position, this.m_smokeEffectRadius);
    let visionBlockersRegistrar = GameInstance.GetSenseManager(this.GetGame()).GetVisionBlockersRegistrar();
    this.m_smokeVisionBlockerId = visionBlockersRegistrar.RegisterVisionBlocker(blockerShape, EVisionBlockerType.Smoke, 0.0, 5.0);
    visionBlockersRegistrar.AttachToParent(this.m_smokeVisionBlockerId, this);
  }

  private final func UnregisterSmokeExplosion() {
    GameInstance
      .GetSenseManager(this.GetGame())
      .GetVisionBlockersRegistrar()
      .UnregisterVisionBlocker(this.m_smokeVisionBlockerId);
  }

  protected func IsGrenadeOfType(compareType: EGrenadeType) -> Bool {
    let tags = this.m_tweakRecord.Tags();
    switch compareType {
      case EGrenadeType.Frag:
        return ArrayContains(tags, n"FragGrenade");
      case EGrenadeType.Flash:
        return ArrayContains(tags, n"FlashGrenade");
      case EGrenadeType.Smoke:
        return ArrayContains(tags, n"SmokeGrenade");
      case EGrenadeType.Piercing:
        return ArrayContains(tags, n"PiercingGrenade");
      case EGrenadeType.EMP:
        return ArrayContains(tags, n"EMPGrenade");
      case EGrenadeType.Biohazard:
        return ArrayContains(tags, n"BiohazardGrenade");
      case EGrenadeType.Incendiary:
        return ArrayContains(tags, n"IncendiaryGrenade");
      case EGrenadeType.Recon:
        return ArrayContains(tags, n"ReconGrenade");
      case EGrenadeType.Cutting:
        return ArrayContains(tags, n"CuttingGrenade");
      case EGrenadeType.Sonic:
        return ArrayContains(tags, n"SonicGrenade");
    }
    return false;
  }

  private final func GetGrenadeType() -> EGrenadeType {
    let tags = this.m_tweakRecord.Tags();
    if ArrayContains(tags, n"FragGrenade") {
      return EGrenadeType.Frag;
    } else if ArrayContains(tags, n"FlashGrenade") {
      return EGrenadeType.Flash;
    } else if ArrayContains(tags, n"SmokeGrenade") {
      return EGrenadeType.Smoke;
    } else if ArrayContains(tags, n"PiercingGrenade") {
      return EGrenadeType.Piercing;
    } else if ArrayContains(tags, n"EMPGrenade") {
      return EGrenadeType.EMP;
    } else if ArrayContains(tags, n"BiohazardGrenade") {
      return EGrenadeType.Biohazard;
    } else if ArrayContains(tags, n"IncendiaryGrenade") {
      return EGrenadeType.Incendiary;
    } else if ArrayContains(tags, n"ReconGrenade") {
      return EGrenadeType.Recon;
    } else if ArrayContains(tags, n"CuttingGrenade") {
      return EGrenadeType.Cutting;
    } else if ArrayContains(tags, n"SonicGrenade") {
      return EGrenadeType.Sonic;
    }
    return EGrenadeType.Frag;
  }

  private final func GetMappinIconIDForGrenadeType(grenadeType: EGrenadeType) -> TweakDBID {
    switch grenadeType {
      case EGrenadeType.Frag:
        return t"MappinIcons.GrenadeMappin";
      case EGrenadeType.Flash:
        return t"MappinIcons.FlashbangGrenadeMappin";
      case EGrenadeType.Smoke:
        return t"MappinIcons.SmokeGrenadeMappin";
      case EGrenadeType.Piercing:
        return t"MappinIcons.GrenadeMappin";
      case EGrenadeType.EMP:
        return t"MappinIcons.EMPGrenadeMappin";
      case EGrenadeType.Biohazard:
        return t"MappinIcons.BiohazardGrenadeMappin";
      case EGrenadeType.Incendiary:
        return t"MappinIcons.IncendiaryGrenadeMappin";
      case EGrenadeType.Recon:
        return t"MappinIcons.ReconGrenadeMappin";
      case EGrenadeType.Cutting:
        return t"MappinIcons.CuttingGrenadeMappin";
      case EGrenadeType.Sonic:
        return t"MappinIcons.GrenadeMappin";
    }
    return t"MappinIcons.GrenadeMappin";
  }

  protected final func ShouldUsePlayerAttack() -> Bool {
    let player = GameInstance.GetPlayerSystem(this.GetGame()).GetLocalPlayerControlledGameObject();
    if this.m_user
      == player
      || Equals(
        GameObject.GetAttitudeTowards(this.m_user, player),
        EAIAttitude.AIA_Friendly
      ) {
      return true;
    }
    return false;
  }

  protected cb func OnFollowSuccess(eventData: gameprojectileFollowEvent) -> Bool {
    if Equals(this.deliveryMethod, gamedataGrenadeDeliveryMethodType.Homing) {
      if this.m_isLockedOn {
        this.Detonate();
      } else {
        this.m_projectileComponent.ClearTrajectories();
      }
    }
  }

  protected final func TriggerStimuli(radius: Float) {
    let investigateData: stimInvestigateData;
    if radius > 0.0 {
      let broadcaster = this.GetStimBroadcasterComponent();
      if IsDefined(broadcaster) {
        investigateData.attackInstigator = this.GetUser();
        investigateData.attackInstigatorPosition = this.GetUser().GetWorldPosition();
        investigateData.revealsInstigatorPosition = true;
        broadcaster
          .TriggerSingleBroadcast(
            this,
            this.m_tweakRecord.DetonationStimType().Type(),
            radius,
            investigateData
          );
      }
    }
  }

  protected final func TriggerGrenadeLandedStimuli(hasLifeTime: Bool) {
    let investigateData: stimInvestigateData;
    this.RemoveGrenadeLandedStimuli();
    if hasLifeTime
      && this.m_tweakRecord.DeliveryMethod().DetonationTimer() - this.m_detonationTimer <= 0.5 {
      hasLifeTime = false;
    }
    let broadcaster = this.GetStimBroadcasterComponent();
    if IsDefined(broadcaster) {
      if Equals(this.deliveryMethod, gamedataGrenadeDeliveryMethodType.Sticky) || this.IsGrenadeOfType(EGrenadeType.Recon) {
        if !this.m_landedCooldownActive {
          investigateData.attackInstigator = this.GetUser();
          broadcaster
            .TriggerSingleBroadcast(this, gamedataStimType.Recon, this.GetAttackRadius(), investigateData);
          this.m_landedCooldownActive = true;
        }
      } else if hasLifeTime {
        broadcaster
          .AddActiveStimuli(
            this,
            gamedataStimType.GrenadeLanded,
            this.m_tweakRecord.DeliveryMethod().DetonationTimer() - this.m_detonationTimer - 0.15,
            this.GetAttackRadius() + 2.0
          );
        this.m_isBroadcastingStim = true;
      } else {
        broadcaster
          .TriggerSingleBroadcast(this, gamedataStimType.GrenadeLanded, this.GetAttackRadius() + 2.0);
      }
    }
  }

  protected final func RemoveGrenadeLandedStimuli() {
    let broadcaster = this.GetStimBroadcasterComponent();
    if IsDefined(broadcaster) {
      broadcaster.RemoveActiveStimuliByName(this, gamedataStimType.GrenadeLanded);
    }
  }

  protected final func DetermineLandedStimType() -> gamedataStimType {
    if Equals(this.deliveryMethod, gamedataGrenadeDeliveryMethodType.Sticky) || this.IsGrenadeOfType(EGrenadeType.Recon) {
      return gamedataStimType.ProjectileDistraction;
    }
    return gamedataStimType.GrenadeLanded;
  }

  protected final func SpawnAttack(
    attackRecord: Attack_Record,
    opt range: Float,
    opt duration: Float,
    opt hitNormal: Vector4,
    opt position: Vector4,
    opt vfxOffset: Vector4
  ) -> EffectInstance {
    let attackContext: AttackInitContext;
    let statMods: [gameStatModifierData];
    let flag: SHitFlag;
    let hitFlags: [SHitFlag];
    attackContext.record = attackRecord;
    attackContext.instigator = this.m_user;
    attackContext.source = this;
    let attack = IAttack.Create(attackContext) as Attack_GameEffect;
    attack.GetStatModList(statMods);
    let effect = attack.PrepareAttack(this.m_user);
    if !this.m_shotDownByThePlayer {
      flag.flag = hitFlag.CanDamageSelf;
      flag.source = n"GrenadeDetonation";
      ArrayPush(hitFlags, flag);
      EffectData
        .SetVariant(
          effect.GetSharedData(),
          GetAllBlackboardDefs().EffectSharedData.flags,
          ToVariant(hitFlags)
        );
    } else if range > 0.0 {
      EffectData
        .SetFloat(effect.GetSharedData(), GetAllBlackboardDefs().EffectSharedData.range, range);
      EffectData
        .SetFloat(
          effect.GetSharedData(),
          GetAllBlackboardDefs().EffectSharedData.radius,
          range
        );
    } else if !Vector4.IsZero(position) {
      EffectData
        .SetVector(
          effect.GetSharedData(),
          GetAllBlackboardDefs().EffectSharedData.position,
          position
        );
    }
    EffectData
      .SetVector(
        effect.GetSharedData(),
        GetAllBlackboardDefs().EffectSharedData.position,
        this.GetWorldPosition()
      );
    if duration > 0.0 {
      EffectData
        .SetFloat(
          effect.GetSharedData(),
          GetAllBlackboardDefs().EffectSharedData.duration,
          duration
        );
    }
    let hitCooldown = TweakDBInterface.GetFloat(ItemID.GetTDBID(this.GetItemID()) + t".effectCooldown", 0.0);
    if hitCooldown > 0.0 {
      EffectData
        .SetFloat(
          effect.GetSharedData(),
          GetAllBlackboardDefs().EffectSharedData.hitCooldown,
          hitCooldown
        );
    } else if !Vector4.IsZero(hitNormal) {
      EffectData
        .SetQuat(
          effect.GetSharedData(),
          GetAllBlackboardDefs().EffectSharedData.rotation,
          Quaternion.BuildFromDirectionVector(hitNormal, new Vector4(0.0, 0.0, 1.0, 0.0))
        );
    } else if !Vector4.IsZero(vfxOffset) {
      EffectData
        .SetVector(
          effect.GetSharedData(),
          GetAllBlackboardDefs().EffectSharedData.vfxOffset,
          vfxOffset
        );
    }
    EffectData
      .SetVariant(
        effect.GetSharedData(),
        GetAllBlackboardDefs().EffectSharedData.attack,
        ToVariant(attack)
      );
    attack.StartAttack();
    return effect;
  }

  protected final func SpawnLaserAttack(
    attackRecord: Attack_Record,
    numberOfLasers: Int32,
    opt range: Float,
    opt duration: Float,
    playSlotAnimation: Bool,
    opt delayPerLaser: Float
  ) {
    let i = 0;
    while i < numberOfLasers {
      if delayPerLaser <= 0.0 {
        this
          .SpawnLaserAttackSingle(attackRecord, range, duration, i, playSlotAnimation);
      } else {
        let spawnLaserEvent = new SpawnLaserAttackEvent();
        spawnLaserEvent.attackRecord = attackRecord;
        spawnLaserEvent.range = range;
        spawnLaserEvent.duration = duration;
        spawnLaserEvent.index = i;
        spawnLaserEvent.playSlotAnimation = playSlotAnimation;
        GameInstance
          .GetDelaySystem(this.GetGame())
          .DelayEvent(this, spawnLaserEvent, delayPerLaser * Cast<Float>(i), true);
      }
      i += 1;
    }
  }

  protected cb func OnSpawnLaserAttackEvent(evt: SpawnLaserAttackEvent) -> Bool {
    if !this.IsUnderwater() {
      this
        .SpawnLaserAttackSingle(
          evt.attackRecord,
          evt.range,
          evt.duration,
          evt.index,
          evt.playSlotAnimation
        );
    }
  }

  protected final func SpawnLaserAttackSingle(
    attackRecord: Attack_Record,
    range: Float,
    duration: Float,
    index: Int32,
    playSlotAnimation: Bool
  ) {
    let effect = this.SpawnAttack(attackRecord, range, duration);
    effect
      .AttachToSlot(
        this,
        StringToName("beam_" + index),
        GetAllBlackboardDefs().EffectSharedData.position,
        GetAllBlackboardDefs().EffectSharedData.forward
      );
    if playSlotAnimation {
      this.PlayLaserSlotAnimation(index);
    }
    ArrayPush(this.m_attacksSpawned, effect);
  }

  protected final func TerminateCuttingGrenadeAttack() {
    let i = ArraySize(this.m_attacksSpawned);
    while i >= 0 {
      this.m_attacksSpawned[i].Terminate();
      i -= 1;
    }
  }

  protected final func PlayLaserSlotAnimation(index: Int32) {
    let transformAnimationPlayEvent = new gameTransformAnimationPlayEvent();
    transformAnimationPlayEvent.animationName = StringToName("beam_" + index + "_animation");
    transformAnimationPlayEvent.looping = true;
    transformAnimationPlayEvent.timeScale = 1.0;
    this.GetOwner().QueueEvent(transformAnimationPlayEvent);
  }

  protected func GetShootCollisionSize() -> Vector4 {
    return new Vector4(0.3, 0.3, 0.3, 0.0);
  }

  protected final func ReleaseMappin() {
    if this.m_mappinID.value != 0ul {
      GameInstance.GetMappinSystem(this.m_user.GetGame()).UnregisterMappin(this.m_mappinID);
      this.m_mappinID.value = 0ul;
    }
  }

  protected final func RequestGrenadeRelease(delay: Float) {
    if this.m_releaseRequestDelayID == GetInvalidDelayID() {
      let releaseRequestEvent = new GrenadeReleaseRequestEvent();
      this.m_releaseRequestDelayID = GameInstance
        .GetDelaySystem(this.GetGame())
        .DelayEvent(this, releaseRequestEvent, delay, true);
    }
  }

  protected cb func OnReleaseRequestEvent(evt: GrenadeReleaseRequestEvent) -> Bool {
    this.Release(true);
  }

  protected final func Release(opt isInstant: Bool) {
    if !this.m_isAlive {
      return;
    }
    this.ReleaseMappin();
    this.SetTracking(false);
    this.m_projectileComponent.ClearTrajectories();
    if !GameInstance.GetRuntimeInfo(this.GetGame()).IsMultiplayer() || this.MultiplayerCanRelease() {
      let despawnRequest = new GrenadeDespawnRequestEvent();
      let delay = this.GetAttackDuration() > 0.0 ? this.GetAttackDuration() : 1.5;
      if isInstant {
        delay = 0.01;
      }
      GameInstance
        .GetDelaySystem(this.GetGame())
        .DelayEvent(this, despawnRequest, delay, false);
      this.m_isAlive = false;
    }
    this.ReleaseAttackResources();
    if this.m_releaseRequestDelayID != GetInvalidDelayID() {
      GameInstance.GetDelaySystem(this.GetGame()).CancelDelay(this.m_releaseRequestDelayID);
    } else if this.m_detonateRequestDelayID != GetInvalidDelayID() {
      GameInstance.GetDelaySystem(this.GetGame()).CancelDelay(this.m_detonateRequestDelayID);
    }
  }

  protected final func MultiplayerCanRelease() -> Bool {
    return GameInstance.GetRuntimeInfo(this.GetGame()).IsServer() && this.m_timeSinceLaunch >= this.m_cpoTimeBeforeRelease;
  }

  protected cb func OnDespawnRequest(evt: GrenadeDespawnRequestEvent) -> Bool {
    let animFeature = new AnimFeature_CombatGadget();
    if !this.m_tweakRecord.RemoveMeshOnDetonation() {
      GameObject.StopReplicatedEffectEvent(this, n"fx_sticky");
      if !this.IsUnderwater() {
        this.SpawnEffectFromLibrary(n"despawn_effect");
      }
    }
    let transactionSystem = GameInstance.GetTransactionSystem(this.GetGame());
    transactionSystem.ReleaseItem(this.GetOwner(), this);
    this.SetThrowableAnimFeatureOnGrenade(0, this);
    animFeature.isDetonated = false;
    AnimationControllerComponent.ApplyFeature(this, n"Grenade", animFeature);
  }

  private final func InitializeRotation() {
    let axis: Vector4;
    this.m_projectileComponent.ToggleAxisRotation(true);
    let timeSystem = GameInstance.GetTimeSystem(this.GetGame());
    let rotationAxesX = this.m_tweakRecord.RotationAxesX();
    let rotationAxesY = this.m_tweakRecord.RotationAxesY();
    let rotationAxesZ = this.m_tweakRecord.RotationAxesZ();
    let rotationAxesSpeeds = this.m_tweakRecord.RotationAxesSpeeds();
    let randomRotationAxes = this.m_tweakRecord.RandomRotationAxes();
    let rotationSpeedMin = this.m_tweakRecord.RotationSpeedMin();
    let rotationSpeedMax = this.m_tweakRecord.RotationSpeedMax();
    let useSeed = this.m_tweakRecord.UseSeed();
    let seed = this.m_tweakRecord.Seed();
    if !useSeed {
      seed = Cast<Int32>(timeSystem.GetGameTimeStamp());
    }
    let i = 0;
    while i < ArraySize(rotationAxesX) {
      axis = new Vector4(rotationAxesX[i], rotationAxesY[i], rotationAxesZ[i], 0.0);
      this.m_projectileComponent.AddAxisRotation(axis, rotationAxesSpeeds[i]);
      i += 1;
    }
    i = 0;
    while i < randomRotationAxes {
      let x = RandNoiseF(seed, 1.0, -1.0);
      let y = RandNoiseF(seed, 1.0, -1.0);
      let z = RandNoiseF(seed, 1.0, -1.0);
      axis = new Vector4(x, y, z, 0.0);
      this
        .m_projectileComponent
        .AddAxisRotation(axis, RandNoiseF(seed, rotationSpeedMax, rotationSpeedMin));
      i += 1;
    }
  }

  protected final func Freeze() {
    this.m_projectileComponent.ClearTrajectories();
    GameObject.StartReplicatedEffectEvent(this, n"fx_homing_freeze", true, false);
  }

  protected final func DrillThrough(const collisionEventData: script_ref<gameprojectileHitInstance>) {
    let stopDrillingRequest = new GrenadeStopDrillingRequestEvent();
    this.m_projectileComponent.ClearTrajectories();
    this.m_visualComponent.Toggle(false);
    this.m_shootCollision.Toggle(false);
    this.m_drillTargetPosition = this
      .GetDrillTargetPosition(
        collisionEventData.position,
        Cast<Vector4>(collisionEventData.traceResult.normal)
      );
    if IsDefined(collisionEventData.hitObject as ScriptedPuppet) {
      this.m_drillTargetPosition = this.GetWorldPosition() + (this.m_drillTargetPosition - this.GetWorldPosition()) / 2.0;
    }
    let drillDuration = Vector4.Length(this.GetWorldPosition() - this.m_drillTargetPosition);
    this.RequestGrenadeDetonation(drillDuration + 2.5);
    GameInstance
      .GetDelaySystem(this.GetGame())
      .DelayEvent(this, stopDrillingRequest, drillDuration, true);
    this.m_detonationTimerActive = false;
  }

  protected final func SpawnOnPuppetCollisionAttack(attackRecord: Attack_Record, opt targetEntity: ScriptedPuppet) -> EffectInstance {
    let attackContext: AttackInitContext;
    let statMods: [gameStatModifierData];
    attackContext.record = attackRecord;
    attackContext.instigator = this.m_user;
    attackContext.source = this;
    let attack = IAttack.Create(attackContext) as Attack_GameEffect;
    attack.GetStatModList(statMods);
    let effect = attack.PrepareAttack(this.m_user);
    if IsDefined(targetEntity) {
      EffectData
        .SetEntity(
          effect.GetSharedData(),
          GetAllBlackboardDefs().EffectSharedData.entity,
          targetEntity
        );
    }
    EffectData
      .SetVariant(
        effect.GetSharedData(),
        GetAllBlackboardDefs().EffectSharedData.attack,
        ToVariant(attack)
      );
    effect.AttachToEntity(this, GetAllBlackboardDefs().EffectSharedData.position);
    attack.StartAttack();
    return effect;
  }

  protected final func GetDrillTargetPosition(currentPosition: Vector4, hitNormal: Vector4) -> Vector4 {
    let staticQueryFilter: QueryFilter;
    let targetPosition: Vector4;
    QueryFilter.AddGroup(staticQueryFilter, n"Static");
    QueryFilter.AddGroup(staticQueryFilter, n"AI");
    let geometryDescription = new GeometryDescriptionQuery();
    geometryDescription.refPosition = currentPosition + Vector4.Normalize(hitNormal) * 0.1;
    geometryDescription.refDirection = -hitNormal;
    geometryDescription.filter = staticQueryFilter;
    geometryDescription.primitiveDimension = new Vector4(0.1, 0.1, 0.1, 0.0);
    geometryDescription.maxDistance = 5.0;
    geometryDescription.maxExtent = 5.0;
    geometryDescription.probingPrecision = 0.05;
    geometryDescription.probingMaxDistanceDiff = 5.0;
    geometryDescription.AddFlag(worldgeometryDescriptionQueryFlags.ObstacleDepth);
    let geometryDescriptionResult = GameInstance
      .GetSpatialQueriesSystem(this.GetGame())
      .GetGeometryDescriptionSystem()
      .QueryExtents(geometryDescription);
    if Equals(
      geometryDescriptionResult.queryStatus,
      worldgeometryDescriptionQueryStatus.OK
    )
      && Equals(
        geometryDescriptionResult.obstacleDepthStatus,
        worldgeometryProbingStatus.None
      ) {
      targetPosition = currentPosition
        - Vector4.Normalize(hitNormal) * (geometryDescriptionResult.obstacleDepth + 0.1);
    } else {
      targetPosition = currentPosition;
    }
    return targetPosition;
  }

  protected final func RequestGrenadeDetonation(delay: Float) {
    if this.m_detonateRequestDelayID == GetInvalidDelayID() {
      let detonateRequestEvent = new GrenadeDetonateRequestEvent();
      this.m_detonateRequestDelayID = GameInstance
        .GetDelaySystem(this.GetGame())
        .DelayEvent(this, detonateRequestEvent, delay, true);
    }
  }

  protected cb func OnDetonateRequest(evt: GrenadeDetonateRequestEvent) -> Bool {
    this.Detonate();
  }

  protected cb func OnStopDrillingRequest(evt: GrenadeStopDrillingRequestEvent) -> Bool {
    GameObject.BreakReplicatedEffectLoopEvent(this, n"fx_drill");
  }

  protected final func FloatCuttingGrenadeUp() {
    let targetPosition: Vector4;
    let currentVelocityNormalized: Vector4;
    let accelerateTowardsTrajectoryParams = new AccelerateTowardsTrajectoryParams();
    let addAxisRotationEvent = new CuttingGrenadeAddAxisRotationEvent();
    let freezingDuration = TweakDBInterface.GetFloat(ItemID.GetTDBID(this.GetItemID()) + t".freezingDuration", 1.0);
    let minimumDistanceFromFloor = TweakDBInterface
      .GetFloat(ItemID.GetTDBID(this.GetItemID()) + t".minimumDistanceFromFloor", 2.0);
    let currentDistanceFromFloor = this.GetDistanceFromFloor();
    let currentSpeed = Vector4.Length(this.m_projectileComponent.GetPrintVelocity());
    if currentDistanceFromFloor < 0.0 || currentDistanceFromFloor > minimumDistanceFromFloor {
      currentVelocityNormalized = Vector4.Normalize(this.m_projectileComponent.GetPrintVelocity());
      targetPosition = this.GetWorldPosition() + currentVelocityNormalized * (currentSpeed * freezingDuration);
      targetPosition = this.GetWorldPosition() + Vector4.Normalize(this.lastHitNormal) * (currentSpeed * freezingDuration);
    } else {
      currentVelocityNormalized = Vector4
        .Normalize(this.m_projectileComponent.GetPrintVelocity() * new Vector4(1.0, 1.0, 0.0, 1.0));
      let distanceToFloat = minimumDistanceFromFloor - currentDistanceFromFloor;
      targetPosition = this.GetWorldPosition()
        + currentVelocityNormalized * (currentSpeed * freezingDuration)
        + new Vector4(0.0, 0.0, distanceToFloat, 0.0);
    }
    this.m_projectileComponent.ClearTrajectories();
    let accelerateTowardsParameters = TweakDBInterface
      .GetAccelerateTowardsParametersRecord(t"AccelerateTowardsParameters.cuttingGrenadeFreezeParameters");
    accelerateTowardsTrajectoryParams.targetPosition = targetPosition;
    accelerateTowardsTrajectoryParams.accuracy = accelerateTowardsParameters.Accuracy();
    accelerateTowardsTrajectoryParams.maxSpeed = currentSpeed * accelerateTowardsParameters.MaxSpeed();
    accelerateTowardsTrajectoryParams.decelerateTowardsTargetPositionDistance = accelerateTowardsParameters.DecelerateTowardsTargetPositionDistance();
    accelerateTowardsTrajectoryParams.maxRotationSpeed = accelerateTowardsParameters.MaxRotationSpeed();
    accelerateTowardsTrajectoryParams.minRotationSpeed = accelerateTowardsParameters.MinRotationSpeed();
    this
      .m_projectileComponent
      .AddAccelerateTowards(accelerateTowardsTrajectoryParams);
    GameInstance
      .GetDelaySystem(this.GetGame())
      .DelayEvent(this, addAxisRotationEvent, 0.1, true);
  }

  protected cb func OnAddAxisRotationEvent(evt: CuttingGrenadeAddAxisRotationEvent) -> Bool {
    let addAxisRotationEvent = new CuttingGrenadeAddAxisRotationEvent();
    if this.m_projectileComponent.IsTrajectoryEmpty() {
      return IsDefined(null);
    }
    let axis = new Vector4(RandRangeF(0.0, 1.0), RandRangeF(0.0, 1.0), RandRangeF(0.0, 1.0), 0.0);
    this
      .m_projectileComponent
      .AddAxisRotation(
        axis,
        RandRangeF(
          TweakDBInterface
            .GetFloat(ItemID.GetTDBID(this.GetItemID()) + t".addAxisRotationSpeedMin", 20.0),
          TweakDBInterface
            .GetFloat(ItemID.GetTDBID(this.GetItemID()) + t".addAxisRotationSpeedMax", 45.0)
        )
      );
    GameInstance
      .GetDelaySystem(this.GetGame())
      .DelayEvent(
        this,
        addAxisRotationEvent,
        TweakDBInterface
          .GetFloat(ItemID.GetTDBID(this.GetItemID()) + t".addAxisRotationDelay", 0.7),
        true
      );
  }

  protected final func FloatToLockOnAltitude() {
    let accelerateTowardsTrajectoryParams = new AccelerateTowardsTrajectoryParams();
    let forwardOffsetValue = 0.3;
    let distanceToFloat = this.GetDistanceToFloat();
    if distanceToFloat <= 0.0 {
      return;
    }
    let homingParameters = (this.m_tweakRecord.DeliveryMethod() as HomingGDM_Record).FlyUpParameters();
    let currentVelocityNormalized = Vector4
      .Normalize(this.m_projectileComponent.GetPrintVelocity() * new Vector4(1.0, 1.0, 0.0, 1.0));
    let targetOffset = currentVelocityNormalized * forwardOffsetValue;
    this.m_projectileComponent.ClearTrajectories();
    let targetPosition = this.GetWorldPosition() + new Vector4(0.0, 0.0, distanceToFloat, 0.0) + targetOffset;
    accelerateTowardsTrajectoryParams.targetPosition = targetPosition;
    accelerateTowardsTrajectoryParams.accuracy = homingParameters.Accuracy();
    accelerateTowardsTrajectoryParams.decelerateTowardsTargetPositionDistance = homingParameters.DecelerateTowardsTargetPositionDistance();
    accelerateTowardsTrajectoryParams.maxRotationSpeed = homingParameters.MaxRotationSpeed();
    accelerateTowardsTrajectoryParams.minRotationSpeed = homingParameters.MinRotationSpeed();
    this
      .m_projectileComponent
      .AddAccelerateTowards(accelerateTowardsTrajectoryParams);
  }

  protected final func GetDistanceFromFloor() -> Float {
    let staticQueryFilter: QueryFilter;
    QueryFilter.AddGroup(staticQueryFilter, n"Static");
    let currentPosition = this.GetWorldPosition();
    let geometryDescription = new GeometryDescriptionQuery();
    geometryDescription.refPosition = currentPosition;
    geometryDescription.refDirection = new Vector4(0.0, 0.0, -1.0, 0.0);
    geometryDescription.filter = staticQueryFilter;
    geometryDescription.primitiveDimension = new Vector4(0.1, 0.1, 0.2, 0.0);
    let geometryDescriptionResult = GameInstance
      .GetSpatialQueriesSystem(this.GetGame())
      .GetGeometryDescriptionSystem()
      .QueryExtents(geometryDescription);
    if NotEquals(
      geometryDescriptionResult.queryStatus,
      worldgeometryDescriptionQueryStatus.OK
    ) {
      return -1.0;
    }
    let distanceFromFloor = AbsF(geometryDescriptionResult.distanceVector.Z);
    return distanceFromFloor;
  }

  protected final func GetDistanceToFloat() -> Float {
    let lockOnAltitude = (this.m_tweakRecord.DeliveryMethod() as HomingGDM_Record).LockOnAltitude();
    let distanceFromFloor = this.GetDistanceFromFloor();
    if distanceFromFloor < 0.0 {
      return 0.0;
    }
    return lockOnAltitude - distanceFromFloor;
  }

  protected final func QueueSmartTrajectory(delay: Float) {
    this.m_homingGrenadeTarget = this.ChooseSmartTrajectoryTarget();
    GameObject
      .SendForceRevealObjectEvent(this.m_homingGrenadeTarget.entity, true, n"HomingGrenade");
    this.m_projectileComponent.SetWasTrajectoryStopped(true);
    let triggerSmartTrajectoryEvent = new GrenadeTriggerSmartTrajectoryEvent();
    GameInstance
      .GetDelaySystem(this.GetGame())
      .DelayEvent(this, triggerSmartTrajectoryEvent, delay, true);
  }

  protected final func ChooseSmartTrajectoryTarget() -> GrenadePotentialHomingTarget {
    let topPickIndex: Int32;
    let topPickScore: Float;
    let i = 0;
    while i < ArraySize(this.m_potentialHomingTargets) {
      let puppet = this.m_potentialHomingTargets[i].entity as NPCPuppet;
      if !IsDefined(puppet) {
      } else {
        let score = 0.0;
        score += 1.0 / Vector4.Distance(this.GetWorldPosition(), puppet.GetWorldPosition());
        let affiliation = TweakDBInterface
          .GetCharacterRecord(puppet.GetRecordID())
          .Affiliation()
          .Type();
        score *= (Equals(affiliation, gamedataAffiliation.NCPD) ? 0.25 : 1.0);
        if score > topPickScore {
          topPickIndex = i;
          topPickScore = score;
        }
      }
      i += 1;
    }
    return this.m_potentialHomingTargets[topPickIndex];
  }

  protected cb func OnTriggerSmartTrajectory(evt: GrenadeTriggerSmartTrajectoryEvent) -> Bool {
    this.SetTracking(false);
    this.ActivateSmartTrajectory();
  }

  protected final func StopCuttingGrenadeAttack() {
    this.TerminateCuttingGrenadeAttack();
    GameObject.BreakReplicatedEffectLoopEvent(this, n"homing_thrust");
    this.m_lockOnFailed = true;
    let stopAttackEvent = new CuttingGrenadeStopAttackEvent();
    GameInstance
      .GetDelaySystem(this.GetGame())
      .DelayEvent(
        this,
        stopAttackEvent,
        TweakDBInterface.GetFloat(ItemID.GetTDBID(this.GetItemID()) + t".stopAttackDelay", 1.0),
        true
      );
  }

  protected cb func OnCuttingGrenadeStopAttackEvent(evt: CuttingGrenadeStopAttackEvent) -> Bool {
    this.DropToFloor();
    GameObject.PlaySound(this, n"grenade_laser_stop");
    this.RequestGrenadeRelease(2.5);
  }

  protected final func DropToFloor() {
    let parabolicTrajectoryParams = ParabolicTrajectoryParams.GetAccelVelParabolicParams(new Vector4(0.0, 0.0, -9.81, 0.0), 0.0001, 20.0);
    this.m_projectileComponent.ClearTrajectories();
    this.m_projectileComponent.SetEnergyLossFactor(0.3, 0.11);
    this.m_projectileComponent.AddParabolic(parabolicTrajectoryParams);
  }

  public final func IsEMP() -> Bool {
    let tags = this.m_tweakRecord.Tags();
    return ArrayContains(tags, n"EMPGrenade");
  }

  public final func GetGrenadeAttackStatusEffectDuration() -> Float {
    let attackStatusEffects: [wref<StatusEffectAttackData_Record>];
    let durationStatusEffects: [wref<StatModifier_Record>];
    this.m_tweakRecord.Attack().StatusEffects(attackStatusEffects);
    attackStatusEffects[0]
      .StatusEffect()
      .Duration()
      .StatModifiers(durationStatusEffects);
    let gameInstance = this.GetGame();
    let duration = RPGManager
      .CalculateStatModifiers(
        durationStatusEffects,
        gameInstance,
        GetPlayer(gameInstance),
        Cast<StatsObjectID>(GetPlayer(gameInstance).GetEntityID())
      );
    return duration;
  }

  protected final func IsUnderwater() -> Bool {
    let isUnderwater = false;
    if this.m_hasHitWater {
      let currentPosition = this.GetWorldPosition();
      isUnderwater = currentPosition.Z - this.m_waterHeight <= this.m_tweakRecord.ShallowWaterDepth();
    }
    return isUnderwater;
  }

  protected final func TryToSinkAndRequestDetonation() {
    if !this.m_isAlive || this.m_isSinking || !this.m_hasHitWater {
      return;
    }
    let currentPosition = this.GetWorldPosition();
    if this.IsGrenadeOfType(EGrenadeType.Smoke) {
      GameObject.BreakReplicatedEffectLoopEvent(this, n"fx_explosion");
    } else if currentPosition.Z - this.m_waterHeight > this.m_tweakRecord.SinkingDepth() {
      return;
    }
    this.m_isSinking = true;
    this.RequestGrenadeDetonation(this.m_tweakRecord.SinkingDetonationDelay());
    if Equals(this.deliveryMethod, gamedataGrenadeDeliveryMethodType.Homing) {
      GameObject.StopReplicatedEffectEvent(this, n"fx_homing_freeze");
      GameObject.StopReplicatedEffectEvent(this, n"homing_thrust");
    } else if Equals(this.deliveryMethod, gamedataGrenadeDeliveryMethodType.Sticky) {
      this.StopStickyGrenadeSounds();
    }
    if this.m_isContinuousEffect {
      if this.IsGrenadeOfType(EGrenadeType.Cutting) && !this.m_lockOnFailed {
        this.TerminateCuttingGrenadeAttack();
        GameObject.StopReplicatedEffectEvent(this, n"homing_thrust");
        GameObject.PlaySound(this, n"grenade_laser_stop");
      }
      let delaySystem = GameInstance.GetDelaySystem(this.GetGame());
      let invalidDelayID = GetInvalidDelayID();
      if this.m_spawnBlinkEffectDelayID != invalidDelayID {
        delaySystem.CancelDelay(this.m_spawnBlinkEffectDelayID);
        this.m_spawnBlinkEffectDelayID = invalidDelayID;
      } else if this.m_releaseRequestDelayID != invalidDelayID {
        delaySystem.CancelDelay(this.m_releaseRequestDelayID);
        this.m_releaseRequestDelayID = invalidDelayID;
      } else if this.IsGrenadeOfType(EGrenadeType.Smoke) {
        this.UnregisterSmokeExplosion();
      }
    }
    this.StopNPCGrenadeBeepSound();
    this.RemoveGrenadeLandedStimuli();
    let parabolicTrajectoryParams = ParabolicTrajectoryParams.GetAccelVelParabolicParams(new Vector4(0.0, 0.0, -0.3, 0.0), 0.4, 0.4);
    this.m_projectileComponent.ClearTrajectories();
    this.m_projectileComponent.SetEnergyLossFactor(0.05, 0.05);
    this.m_projectileComponent.AddParabolic(parabolicTrajectoryParams);
  }

  protected final func ActivateSmartTrajectory() {
    let slotTransform: WorldTransform;
    let offset: Vector4;
    let accelerateTowardsTrajectoryParams = new AccelerateTowardsTrajectoryParams();
    GameObject.BreakReplicatedEffectLoopEvent(this, n"fx_homing_freeze");
    if ArraySize(this.m_potentialHomingTargets) < 1 {
      return;
    }
    let homingParameters = (this.m_tweakRecord.DeliveryMethod() as HomingGDM_Record).FlyToTargetParameters();
    this.m_isLockedOn = true;
    this.m_detonateOnImpact = true;
    this.m_projectileComponent.ClearTrajectories();
    let slotComponent = this.m_homingGrenadeTarget.entity.GetHitRepresantationSlotComponent();
    if NotEquals(this.m_homingGrenadeTarget.targetSlot, n"None")
      && slotComponent.GetSlotTransform(this.m_homingGrenadeTarget.targetSlot, slotTransform) {
      offset = WorldPosition.ToVector4(WorldTransform.GetWorldPosition(slotTransform)) - Matrix.GetTranslation(slotComponent.GetLocalToWorld());
    } else if slotComponent.GetSlotTransform(n"Chest", slotTransform) || slotComponent.GetSlotTransform(n"Center", slotTransform) {
      offset = WorldPosition.ToVector4(WorldTransform.GetWorldPosition(slotTransform)) - Matrix.GetTranslation(slotComponent.GetLocalToWorld());
    }
    accelerateTowardsTrajectoryParams.targetComponent = slotComponent;
    accelerateTowardsTrajectoryParams.targetOffset = offset;
    accelerateTowardsTrajectoryParams.accelerationSpeed = homingParameters.AccelerationSpeed();
    accelerateTowardsTrajectoryParams.maxSpeed = homingParameters.MaxSpeed();
    accelerateTowardsTrajectoryParams.maxRotationSpeed = homingParameters.MaxRotationSpeed();
    accelerateTowardsTrajectoryParams.minRotationSpeed = homingParameters.MinRotationSpeed();
    accelerateTowardsTrajectoryParams.accuracy = homingParameters.Accuracy();
    this
      .m_projectileComponent
      .AddAccelerateTowards(accelerateTowardsTrajectoryParams);
    this
      .m_projectileComponent
      .SetOnCollisionAction(gameprojectileOnCollisionAction.Stop);
  }

  protected final func SetTracking(state: Bool) {
    if Equals(this.m_isTracking, state) {
      return;
    } else if !this.m_isTracking {
      if IsDefined(this.m_shootCollision) && this.m_canBeShot {
        this.m_shootCollision.Resize(new Vector4(0.05, 0.06, 0.05, 0.0), 0u);
      }
      let attackRecordPath = t"Attacks.GrenadeTargetTracker";
      let attackRecord = TweakDBInterface.GetAttack_GameEffectRecord(attackRecordPath);
      this.m_targetTracker = this
        .SpawnAttack(attackRecord, this.m_tweakRecord.DeliveryMethod().TrackingRadius());
      this
        .m_targetTracker
        .AttachToEntity(this, GetAllBlackboardDefs().EffectSharedData.position);
      this.m_isTracking = true;
    }
    this.m_targetTracker.Terminate();
    this
      .m_targetTracker
      .AttachToEntity(
        GameInstance.GetPlayerSystem(this.GetGame()).GetLocalPlayerMainGameObject(),
        GetAllBlackboardDefs().EffectSharedData.position
      );
    this.m_targetTracker = null;
    this.m_isTracking = false;
    GameObject.BreakReplicatedEffectLoopEvent(this, n"fx_regular_scanning");
    if IsDefined(this.m_shootCollision) && this.m_canBeShot {
      this.m_shootCollision.Resize(this.GetShootCollisionSize(), 0u);
    }
  }

  protected final func ProcessProximityTargets() -> Bool {
    if ArraySize(this.m_potentialHomingTargets) == 0 || this.m_timeSinceLaunch < 0.1 {
      return false;
    }
    let i = 0;
    while i < ArraySize(this.m_potentialHomingTargets) {
      if this.m_potentialHomingTargets[i].entity == GetPlayer(this.GetGame()) {
        return false;
      }
      i += 1;
    }
    return true;
  }

  protected final func CheckRegularDeliveryMethodConditions() -> Bool {
    return Equals(this.deliveryMethod, gamedataGrenadeDeliveryMethodType.Regular) && this.ProcessProximityTargets();
  }

  protected final func CheckStickyDeliveryMethodConditions() -> Bool {
    return Equals(this.deliveryMethod, gamedataGrenadeDeliveryMethodType.Sticky) && this.m_isStuck && this.ProcessProximityTargets();
  }

  protected final func PlayNPCGrenadeBeepSound() {
    if IsDefined(this.m_user as NPCPuppet) {
      GameObject.PlaySound(this, StringToName("gre_npc_beep_lp"));
    }
  }

  protected final func StopNPCGrenadeBeepSound() {
    if IsDefined(this.m_user as NPCPuppet) {
      GameObject.StopSound(this, StringToName("grenade_charge_start"));
      GameObject.PlaySound(this, StringToName("gre_npc_beep_lp_stop"));
    }
  }

  protected final func PlayStickyGrenadeLongBeepSound() {
    GameObject.PlaySound(this, n"grenade_charge_start");
  }

  protected final func PlayStickyGrenadeShortBeepSound() {
    GameObject.PlaySound(this, n"grenade_charge_1s");
  }

  protected final func StopStickyGrenadeSounds() {
    GameObject.StopSound(this, n"grenade_charge_start");
    GameObject.StopSound(this, n"grenade_charge_1s");
  }

  protected cb func OnTargetAcquired(evt: GrenadeTrackerTargetAcquiredEvent) -> Bool {
    let newPotentialTarget: GrenadePotentialHomingTarget;
    if this.IsGrenadeOfType(EGrenadeType.Cutting) && ScriptedPuppet.IsAlive(evt.target) {
      if ScriptedPuppet.IsBoss(evt.target) || ScriptedPuppet.IsMaxTac(evt.target) {
        let attack = TweakDBInterface.GetAttackRecord(t"Attacks.BossCuttingGrenadeAttack");
        this.SpawnAttack(attack, 2.0, evt.target.GetWorldPosition());
      } else {
        this
          .SpawnAttack(this.m_tweakRecord.AdditionalAttack(), 2.0, evt.target.GetWorldPosition());
      }
    } else {
      let i = 0;
      if i < ArraySize(this.m_potentialHomingTargets) {
        if this.m_potentialHomingTargets[i].entity == evt.target {
          return IsDefined(null);
        } else {
          i += 1;
        }
      } else {
        newPotentialTarget.entity = evt.target;
        newPotentialTarget.targetSlot = evt.targetSlot;
        ArrayPush(this.m_potentialHomingTargets, newPotentialTarget);
        if this.CheckRegularDeliveryMethodConditions() || this.CheckStickyDeliveryMethodConditions() {
          this.SetTracking(false);
          this.Detonate();
        } else if Equals(this.deliveryMethod, gamedataGrenadeDeliveryMethodType.Homing) && !this.m_targetAcquired && this.m_readyToTrack {
          this
            .QueueSmartTrajectory((this.m_tweakRecord.DeliveryMethod() as HomingGDM_Record).LockOnDelay());
        } else {
          this.m_targetAcquired = true;
        }
      }
    }
  }

  protected cb func OnTargetLost(evt: GrenadeTrackerTargetLostEvent) -> Bool {
    let i = ArraySize(this.m_potentialHomingTargets) - 1;
    if i >= 0 {
      if this.m_potentialHomingTargets[i].entity == evt.target {
        ArrayErase(this.m_potentialHomingTargets, i);
        if ArraySize(this.m_potentialHomingTargets) == 0 {
          this.m_targetAcquired = false;
        }
      } else {
        i -= 1;
      }
    }
  }

  protected final func DelayTargetTrackingStateChange(newState: Bool, delay: Float) {
    let changeStateEvent = new GrenadeSetTargetTrackerStateEvent();
    changeStateEvent.state = newState;
    GameInstance
      .GetDelaySystem(this.GetGame())
      .DelayEvent(this, changeStateEvent, delay, true);
  }

  protected cb func OnTargetTrackerStateSet(evt: GrenadeSetTargetTrackerStateEvent) -> Bool {
    this.SetTracking(evt.state);
  }

  public final func GetUser() -> wref<GameObject> {
    return this.m_user;
  }

  public final func GetLastHitNormal() -> Vector4 {
    return this.lastHitNormal;
  }

  public final func GetDeliveryMethod() -> gamedataGrenadeDeliveryMethodType {
    return this.deliveryMethod;
  }
}

