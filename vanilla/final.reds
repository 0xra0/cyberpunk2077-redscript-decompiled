  protected final func SetZoomBlackboardValues(newState: Bool, opt lockPlayerFor: Float) {
    let invalidID: EntityID;
    if this.m_advanceInteractionStateResolveDelayID != GetInvalidDelayID() {
      GameInstance
        .GetDelaySystem(this.GetGame())
        .CancelCallback(this.m_advanceInteractionStateResolveDelayID);
      GameInstance
        .GetDelaySystem(this.GetGame())
        .CancelDelay(this.m_advanceInteractionStateResolveDelayID);
      this.m_advanceInteractionStateResolveDelayID = GetInvalidDelayID();
    } else if lockPlayerFor <= 0.0 {
      let playerObject = GameInstance.GetPlayerSystem(this.GetGame()).GetLocalPlayerControlledGameObject();
      let playerStateMachineBlackboard = GameInstance
        .GetBlackboardSystem(this.GetGame())
        .GetLocalInstanced(playerObject.GetEntityID(), GetAllBlackboardDefs().PlayerStateMachine);
      playerStateMachineBlackboard
        .SetBool(
          GetAllBlackboardDefs().PlayerStateMachine.IsInteractingWithDevice,
          newState
        );
      playerStateMachineBlackboard
        .SetBool(GetAllBlackboardDefs().PlayerStateMachine.IsUIZoomDevice, newState);
      playerStateMachineBlackboard
        .SetEntityID(
          GetAllBlackboardDefs().PlayerStateMachine.UIZoomDeviceID,
          newState ? this.GetEntityID() : invalidID
        );
      playerStateMachineBlackboard.FireCallbacks();
    }
    let evt = new AdvanceInteractionStateResolveEvent();
    evt.m_toggle = newState;
    this.m_advanceInteractionStateResolveDelayID = GameInstance.GetDelaySystem(this.GetGame()).DelayEvent(this, evt, lockPlayerFor);
  }

  protected cb func OnAdvanceInteractionStateResolveEvent(evt: AdvanceInteractionStateResolveEvent) -> Bool {
    this.m_advanceInteractionStateResolveDelayID = GetInvalidDelayID();
    this.SetZoomBlackboardValues(evt.m_toggle, 0.0);
  }

  protected func EnterWorkspot(
    activator: GameObject,
    opt freeCamera: Bool,
    opt componentName: CName,
    opt deviceData: CName
  ) {
    let workspotSystem = GameInstance.GetWorkspotSystem(activator.GetGame());
    if activator.IsPlayer() {
      this.m_workspotActivator = activator;
      workspotSystem
        .PlayInDeviceSimple(
          this,
          activator,
          freeCamera,
          componentName,
          deviceData,
          n"None",
          0.5,
          WorkspotSlidingBehaviour.DontPlayAtResourcePosition,
          this
        );
    }
  }

  protected cb func OnPlayInDeviceCallbackEvent(evt: PlayInDeviceCallbackEvent) -> Bool {
    if evt.wasPlayInDeviceSuccessful {
      let playerStateMachineBlackboard = GameInstance
        .GetBlackboardSystem(this.GetGame())
        .GetLocalInstanced(
          this.m_workspotActivator.GetEntityID(),
          GetAllBlackboardDefs().PlayerStateMachine
        );
      playerStateMachineBlackboard
        .SetBool(GetAllBlackboardDefs().PlayerStateMachine.IsInteractingWithDevice, true);
    }
  }

  protected func EnterWorkspotWithIK(
    activator: GameObject,
    shouldCrouch: Bool,
    opt cameraFlavour: CName,
    opt componentName: CName,
    opt cameraPosition: Vector4,
    opt cameraRotation: Quaternion,
    opt rightHandPosition: Vector4,
    opt rightHandRotation: Quaternion,
    opt leftHandPosition: Vector4,
    opt leftHandRotation: Quaternion
  ) {
    let playerStateMachineBlackboard = GameInstance
      .GetBlackboardSystem(this.GetGame())
      .GetLocalInstanced(activator.GetEntityID(), GetAllBlackboardDefs().PlayerStateMachine);
    playerStateMachineBlackboard
      .SetBool(GetAllBlackboardDefs().PlayerStateMachine.IsInteractingWithDevice, true);
    let animFeature = new AnimFeature_WorkspotIK();
    animFeature.rightHandPosition = rightHandPosition;
    animFeature.leftHandPosition = leftHandPosition;
    animFeature.cameraPosition = cameraPosition;
    animFeature.rightHandRotation = rightHandRotation;
    animFeature.leftHandRotation = leftHandRotation;
    animFeature.cameraRotation = cameraRotation;
    animFeature.shouldCrouch = shouldCrouch;
    this.ApplyAnimFeatureToReplicate(activator, n"WorkspotIK", animFeature);
    let workspotSystem = GameInstance.GetWorkspotSystem(activator.GetGame());
    workspotSystem.PlayInDevice(this, activator, cameraFlavour, componentName);
  }

  protected func LeaveWorkspot(activator: GameObject) {
    let orientation: Quaternion;
    let animFeature = new AnimFeature_WorkspotIK();
    animFeature.isInteractingWithDevice = false;
    this.ApplyAnimFeatureToReplicate(activator, n"WorkspotIK", animFeature);
    Quaternion.SetIdentity(orientation);
    let direction = new Vector4(0.0, 0.0, 0.0, 1.0);
    let workspotSystem = GameInstance.GetWorkspotSystem(this.GetGame());
    if activator.IsPlayer() {
      let failsafe = new MissingWorkspotComponentFailsafeEvent();
      failsafe.playerEntityID = activator.GetEntityID();
      this.m_personalLinkFailsafeID = GameInstance.GetDelaySystem(this.GetGame()).DelayEvent(this, failsafe, 1.8);
      workspotSystem
        .SendJumpToTagCommandEnt(activator, this.GetSlotTag() + n".end", true, this.GetEntityID());
    } else {
      workspotSystem.StopInDevice(activator, direction, orientation);
    }
  }

  protected cb func OnWorkspotFinished(componentName: CName) -> Bool {
    let playerPuppet = GameInstance.GetPlayerSystem(this.GetGame()).GetLocalPlayerControlledGameObject() as PlayerPuppet;
    if playerPuppet == null {
      return false;
    } else if Equals(componentName, n"personalLinkPlayerWorkspot") {
      let delaySystem = GameInstance.GetDelaySystem(this.GetGame());
      if IsDefined(delaySystem) {
        if this.m_personalLinkFailsafeID != GetInvalidDelayID() {
          delaySystem.CancelDelay(this.m_personalLinkFailsafeID);
          delaySystem.CancelCallback(this.m_personalLinkFailsafeID);
          this.m_personalLinkFailsafeID = GetInvalidDelayID();
        }
        let personalLinkEvent = new ManagePersonalLinkChangeEvent();
        personalLinkEvent.shouldEquip = false;
        delaySystem.DelayEvent(playerPuppet, personalLinkEvent, 0.03);
      }
      RPGManager.ForceUnequipPersonalLink(playerPuppet);
      this.m_personalLinkHackSend = false;
      this.GetDevicePS().DisconnectPersonalLink(playerPuppet, n"direct");
    }
    let playerStateMachineBlackboard = GameInstance
      .GetBlackboardSystem(this.GetGame())
      .GetLocalInstanced(playerPuppet.GetEntityID(), GetAllBlackboardDefs().PlayerStateMachine);
    playerStateMachineBlackboard
      .SetBool(GetAllBlackboardDefs().PlayerStateMachine.IsInteractingWithDevice, false);
  }

  protected cb func OnMissingWorkspotComponentFailsafeEvent(evt: MissingWorkspotComponentFailsafeEvent) -> Bool {
    if this.m_personalLinkFailsafeID == GetInvalidDelayID() {
      return false;
    }
    let playerStateMachineBlackboard = GameInstance
      .GetBlackboardSystem(this.GetGame())
      .GetLocalInstanced(evt.playerEntityID, GetAllBlackboardDefs().PlayerStateMachine);
    playerStateMachineBlackboard
      .SetBool(GetAllBlackboardDefs().PlayerStateMachine.IsInteractingWithDevice, false);
    this.m_personalLinkFailsafeID = GetInvalidDelayID();
  }

