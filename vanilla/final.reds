  private final func HasDiffrentParentsThanTargets(sourceID: EntityID, const targets: script_ref<[EntityID]>) -> Bool {
    let sourceParents: [LazyDevice];
    let targetParents: [LazyDevice];
    GameInstance
      .GetDeviceSystem(this.GetGameInstance())
      .GetLazyParents(sourceID, sourceParents);
    if ArraySize(sourceParents) == 0 {
      return false;
    }
    let i = 0;
    while i < ArraySize(targets) {
      GameInstance
        .GetDeviceSystem(this.GetGameInstance())
        .GetLazyParents(targets[i], targetParents);
      let k = 0;
      while k < ArraySize(targetParents) {
        let l = 0;
        while l < ArraySize(sourceParents) {
          if Equals(sourceParents[l].GetPersistentID(), targetParents[k].GetPersistentID()) {
            return false;
          }
          l += 1;
        }
        k += 1;
      }
      i += 1;
    }
    return true;
  }

  private final func HasDiffrentChildrenThanTargets(sourceID: EntityID, const targets: script_ref<[EntityID]>) -> Bool {
    let sourceChildren: [LazyDevice];
    let targetChildren: [LazyDevice];
    GameInstance
      .GetDeviceSystem(this.GetGameInstance())
      .GetLazyChildren(sourceID, sourceChildren);
    if ArraySize(sourceChildren) == 0 {
      return false;
    }
    let i = 0;
    while i < ArraySize(targets) {
      GameInstance
        .GetDeviceSystem(this.GetGameInstance())
        .GetLazyChildren(targets[i], targetChildren);
      let k = 0;
      while k < ArraySize(targetChildren) {
        let l = 0;
        while l < ArraySize(sourceChildren) {
          if Equals(sourceChildren[l].GetPersistentID(), targetChildren[k].GetPersistentID()) {
            return false;
          }
          l += 1;
        }
        k += 1;
      }
      i += 1;
    }
    return true;
  }

  private final func ResolveNetworkRevealTarget(const linkData: script_ref<SNetworkLinkData>) {
    let ignoreNetworkReveal: Bool;
    let currentTargets = this.m_networkRevealTargets;
    let hasTargets = ArraySize(currentTargets) > 0;
    if this.HasActivePingWithRevealNetwork(linkData.slaveID) {
      if hasTargets {
        ignoreNetworkReveal = ArrayContains(this.m_networkRevealTargetsLastSession, linkData.masterID)
          || !this.HasDiffrentChildrenThanTargets(linkData.masterID, currentTargets)
            && !this.HasDiffrentParentsThanTargets(linkData.masterID, currentTargets);
      } else if !ignoreNetworkReveal {
        this.AddNetworkRevealTarget(linkData.masterID);
        ignoreNetworkReveal = false;
      } else if this.HasActivePingWithRevealNetwork(linkData.masterID) {
        if hasTargets {
          ignoreNetworkReveal = ArrayContains(this.m_networkRevealTargetsLastSession, linkData.slaveID)
            || !this.HasDiffrentChildrenThanTargets(linkData.slaveID, currentTargets)
              && !this.HasDiffrentParentsThanTargets(linkData.slaveID, currentTargets);
        } else if !ignoreNetworkReveal {
          this.AddNetworkRevealTarget(linkData.slaveID);
          ignoreNetworkReveal = false;
        }
      }
    }
  }

  private final func AddNetworkRevealTarget(target: EntityID) {
    if !ArrayContains(this.m_networkRevealTargets, target) {
      ArrayPush(this.m_networkRevealTargets, target);
    }
  }

  private final func RemoveNetworkRevealTarget(index: Int32) {
    if index >= 0 && index < ArraySize(this.m_networkRevealTargets) {
      ArrayErase(this.m_networkRevealTargets, index);
    }
  }

  private final func RevealNetworkOnCachedTarget(const targets: script_ref<[EntityID]>) {
    if ArraySize(targets) == 0 {
      return;
    }
    let i = ArraySize(this.m_networkRevealTargets) - 1;
    while i >= 0 {
      let k = 0;
      while k < ArraySize(targets) {
        if this.m_networkRevealTargets[i] == targets[k] {
          if EntityID.IsDefined(this.m_networkRevealTargets[i]) && !this.HasActivePing(targets[k]) {
            this.SendRevealNetworkEvent(this.m_networkRevealTargets[i]);
          }
          ArrayPush(this.m_networkRevealTargetsLastSession, this.m_networkRevealTargets[i]);
          ArrayErase(this.m_networkRevealTargets, i);
        }
        k += 1;
      }
      i -= 1;
    }
  }

  private final func RevealEntireNetworkOnTarget(target: EntityID) {
    this.SendRevealNetworkEvent(target);
    let i = 0;
    if i < ArraySize(this.m_networkLinks) {
      if this.m_networkLinks[i].slaveID == target {
        if EntityID.IsDefined(this.m_networkLinks[i].masterID) {
          this.SendRevealNetworkEvent(this.m_networkLinks[i].masterID);
        }
      } else if this.m_networkLinks[i].masterID == target {
        if EntityID.IsDefined(this.m_networkLinks[i].slaveID) {
          this.SendRevealNetworkEvent(this.m_networkLinks[i].slaveID);
        } else {
          i += 1;
        }
      }
    }
  }

  private final func OnRevealNetworkRequestRequest(request: RevealNetworkRequestRequest) {
    this.SendRevealNetworkEvent(request.target, request.delay);
  }

  private final func SendRevealNetworkEvent(target: EntityID, opt delay: Float) {
    let evt = new RevealNetworkGridOnPulse();
    evt.duration = this.GetPingRevealDuration();
    evt.revealSlave = this.ShouldRevealSlaveOnPulse();
    evt.revealMaster = this.ShouldRevealMasterOnPulse();
    if delay > 0.0 {
      let request = new RevealNetworkRequestRequest();
      request.target = target;
      request.delay = 0.0;
      GameInstance
        .GetDelaySystem(this.GetGameInstance())
        .DelayScriptableSystemRequest(this.GetClassName(), request, delay, false);
    } else {
      GameInstance
        .GetPersistencySystem(this.GetGameInstance())
        .QueueEntityEvent(target, evt);
    }
  }

  private final func SendRevealNetworkGridRequest(target: EntityID) {
    let evt = new RevealNetworkGridNetworkRequest();
    GameInstance.GetPersistencySystem(this.GetGameInstance()).QueueEntityEvent(target, evt);
  }

