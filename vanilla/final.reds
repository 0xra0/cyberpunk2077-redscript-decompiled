  public final func ForceDefaultLocomotion(stateContext: StateContext, scriptInterface: StateGameScriptInterface) {
    let swapEvent = new PSMAddOnDemandStateMachine();
    let player = DefaultTransition.GetPlayerPuppet(scriptInterface);
    swapEvent.stateMachineName = n"Locomotion";
