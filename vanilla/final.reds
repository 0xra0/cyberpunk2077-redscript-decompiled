class SetMessageDeviceOperation extends DeviceOperationBase {
  private let targetRef: NodeRef;
  private let messageRecordID: TweakDBID;
  private let replaceTextWithCustomNumber: Bool;
  private let customNumber: Int32;

  public func Execute(owner: wref<GameObject>) {
    super.Execute(owner);
    if IsDefined(owner) {
      this.SendEvent(owner);
    }
  }

  private final func SendEvent(owner: wref<GameObject>) {
    let targetID = Cast<EntityID>(ResolveNodeRefWithEntityID(this.targetRef, owner.GetEntityID()));
    if EntityID.IsDefined(targetID) {
      let targetPSID = CreatePersistentID(targetID, n"LcdScreenController");
      if PersistentID.IsDefined(targetPSID) {
        let evt = new SetMessageRecordEvent();
        evt.m_messageRecordID = this.messageRecordID;
        evt.m_replaceTextWithCustomNumber = this.replaceTextWithCustomNumber;
        evt.m_customNumber = this.customNumber;
        GameInstance
          .GetPersistencySystem(owner.GetGame())
          .QueuePSEvent(targetPSID, n"LcdScreenControllerPS", evt);
      }
    }
  }
}

