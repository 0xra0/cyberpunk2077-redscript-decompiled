class QuestMuteSounds extends ActionBool {
  public final func SetProperties(mute: Bool) {
    if mute {
      this.actionName = n"QuestMuteSounds";
    } else {
      this.actionName = n"QuestUnMuteSounds";
    }
    this.prop = DeviceActionPropertyFunctions
      .SetUpProperty_Bool(this.actionName, mute, n"QuestMuteSounds", n"QuestMuteSounds");
  }
}

class QuestToggleInteractivity extends ActionBool {
  public final func SetProperties(enable: Bool) {
    if enable {
      this.actionName = n"QuestEnableInteractivity";
    } else {
      this.actionName = n"QuestDisableInteractivity";
    }
    this.prop = DeviceActionPropertyFunctions
      .SetUpProperty_Bool(
        this.actionName,
        enable,
        n"QuestToggleInteractivity",
        n"QuestToggleInteractivity"
      );
  }
}

class TVViabilityInterpreter extends IScriptable {
  public final static func Evaluate(device: MediaDeviceControllerPS, hasActiveActions: Bool) -> Bool {
    let basicCheckResult = BasicViabilityInterpreter.Evaluate(device, hasActiveActions);
    if Equals(basicCheckResult, EViabilityDecision.VIABLE) {
      return true;
    } else if Equals(basicCheckResult, EViabilityDecision.NONVIABLE) {
      return false;
    } else if device.IsDisabled() || device.IsUnpowered() {
      return false;
    }
    return true;
  }
}

