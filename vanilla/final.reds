class EffectExecutor_SetDeviceON extends EffectExecutor_Device {
  public final func Process(ctx: EffectScriptContext, applierCtx: EffectExecutionScriptContext) -> Bool {
    let owner = EffectScriptContext.GetInstigator(ctx);
    let device = EffectExecutionScriptContext.GetTarget(applierCtx) as InteractiveDevice;
    if IsDefined(device) {
      if IsDefined(device as RoadBlockTrap) {
      } else if IsDefined(owner) && Vector4.Distance(owner.GetWorldPosition(), device.GetWorldPosition()) <= 3.0 {
        return true;
      }
      let evt = new ActivateDevice();
      evt.SetProperties();
      this.QueueEventOnDevice(device, evt);
    }
    return true;
  }
}

