class LocomotionTakedownDecisions extends LocomotionTransition {
  protected const final func IsTakedownAction(actionName: CName) -> Bool {
    return Equals(actionName, n"Takedown")
      || Equals(actionName, n"TakedownNonLethal")
      || Equals(actionName, n"TakedownNetrunner");
  }

  protected const final func IsTakedownAndDispose(const scriptInterface: StateGameScriptInterface) -> Bool {
    return 5
      == scriptInterface.localBlackboard.GetInt(GetAllBlackboardDefs().PlayerStateMachine.Takedown);
  }

  protected const final func IsPowerLevelDifferentialTooHigh(target: wref<GameObject>) -> Bool {
    let powDifference = RPGManager.CalculatePowerDifferential(target);
    if Equals(powDifference, gameEPowerDifferential.IMPOSSIBLE) {
      return true;
    }
    return false;
  }

  protected const final func ShouldInstantlyBreakFree(target: wref<ScriptedPuppet>) -> Bool {
    if !IsDefined(target) {
      return false;
    } else if target.IsMassive() {
      return this.IsPowerLevelDifferentialTooHigh(target);
    }
    return false;
  }
}

