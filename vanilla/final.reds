public func IsFriendlyTowardsPlayer(object: wref<GameObject>) -> Bool {
  if !IsDefined(object) {
    return false;
  }
  let player = GetPlayer(object.GetGame());
  if IsDefined(player)
    && Equals(GameObject.GetAttitudeTowards(object, player), EAIAttitude.AIA_Friendly) {
    return true;
  }
  return false;
}

