class SetDeviceControllerInvestigationData extends AIbehaviortaskScript {
  public let ownerPuppet: wref<ScriptedPuppet>;

  protected func Activate(context: ScriptExecutionContext) {
    let closestDistance: Float;
    let position: Vector4;
    this.ownerPuppet = ScriptExecutionContext.GetOwner(context) as ScriptedPuppet;
    let activeReactionData = this.ownerPuppet.GetStimReactionComponent().GetActiveReactionData();
    let investigateData = activeReactionData.stimInvestigateData;
    let controller = investigateData.controllerEntity as Device;
    let investigationPositions = controller.GetNodePosition();
    let i = 0;
    while i < ArraySize(investigationPositions) {
      let distance = Vector4.Distance(investigationPositions[i], this.ownerPuppet.GetWorldPosition());
      let path = GameInstance
        .GetAINavigationSystem(this.ownerPuppet.GetGame())
        .CalculatePathForCharacter(
          this.ownerPuppet.GetWorldPosition(),
          investigationPositions[i],
          0.0,
          this.ownerPuppet
        );
      if !IsDefined(path) {
      } else if distance < closestDistance || closestDistance == 0.0 {
        closestDistance = distance;
        position = investigationPositions[i];
      }
      i += 1;
    }
    if !Vector4.IsZero(position) {
      ScriptExecutionContext.SetArgumentVector(context, n"StimSource", position);
    } else {
      ScriptExecutionContext.SetArgumentVector(context, n"StimSource", controller.GetWorldPosition());
    }
    ScriptExecutionContext.SetArgumentObject(context, n"StimTarget", controller);
    ScriptExecutionContext
      .SetArgumentVector(
        context,
        n"CustomWorldPosition",
        controller.GetDistractionPointPosition(controller)
      );
  }
}

