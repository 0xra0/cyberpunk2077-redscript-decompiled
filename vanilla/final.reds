class SecurityArea extends InteractiveMasterDevice {
  private let m_area: TriggerComponent;

  protected cb func OnRequestComponents(ri: EntityRequestComponentsInterface) -> Bool {
    EntityRequestComponentsInterface.RequestComponent(ri, n"area", n"TriggerComponent", false);
    super.OnRequestComponents(ri);
  }

  protected cb func OnTakeControl(ri: EntityResolveComponentsInterface) -> Bool {
    super.OnTakeControl(ri);
    this.m_area = EntityResolveComponentsInterface.GetComponent(ri, n"area") as TriggerComponent;
    this.m_controller = EntityResolveComponentsInterface.GetComponent(ri, n"controller") as SecurityAreaController;
  }

  protected cb func OnGameAttached() -> Bool {
    super.OnGameAttached();
    this.m_area.Toggle(this.GetDevicePS().IsActive());
  }

  protected cb func OnDetach() -> Bool {
    this.SendFakeExitEventToObjectsInsideMe();
    this.UnregisterTimeSystemListeners();
  }

  protected cb func OnSlaveStateChanged(evt: PSDeviceChangedEvent) -> Bool {
    return false;
  }

  protected cb func OnRegisterTimeListeners(evt: RegisterTimeListeners) -> Bool {
    this.RegisterTimeSystemListeners();
  }

  private final func RegisterTimeSystemListeners() {
    this.GetDevicePS().RegisterTimeSystemListeners(this);
  }

  private final func UnregisterTimeSystemListeners() {
    this.GetDevicePS().UnregisterTimeSystemListeners();
  }

  protected cb func OnTransition(evt: Transition) -> Bool {
    this.GetDevicePS().ApplyTransition(evt.listenerID);
  }

  protected cb func OnManageAreaComponent(evt: ManageAreaComponent) -> Bool {
    this.m_area.Toggle(evt.enable);
  }

  private const func GetController() -> SecurityAreaController {
    return this.m_controller as SecurityAreaController;
  }

  public const func GetDevicePS() -> SecurityAreaControllerPS {
    return this.GetController().GetPS();
  }

  protected cb func OnAreaEnter(evt: AreaEnteredEvent) -> Bool {
    let shouldProcess: Bool;
    let isPlayer: Bool;
    let obj = EntityGameInterface.GetEntity(evt.activator) as GameObject;
    if obj.IsPlayer() {
      shouldProcess = true;
      isPlayer = true;
    } else if IsDefined(obj as ScriptedPuppet) && !(obj as ScriptedPuppet).IsCrowd() {
      shouldProcess = true;
    } else {
      shouldProcess = false;
    }
    if shouldProcess {
      this.GetDevicePS().AreaEntered(evt);
      if isPlayer {
        let mappinSystem = GameInstance.GetMappinSystem(this.GetGame());
        if IsDefined(mappinSystem) {
          mappinSystem.OnAreaEntered(evt);
        }
      }
    }
  }

  protected cb func OnAreaExit(evt: AreaExitedEvent) -> Bool {
    this
      .OnAreaExitInternal(EntityGameInterface.GetEntity(evt.activator) as GameObject, evt.triggerID);
  }

  private final func OnAreaExitInternal(obj: wref<GameObject>, triggerID: EntityID) {
    let shouldProcess: Bool;
    let isPlayer: Bool;
    if obj.IsPlayer() {
      shouldProcess = true;
      isPlayer = true;
    } else if IsDefined(obj as ScriptedPuppet) && !(obj as ScriptedPuppet).IsCrowd() {
      shouldProcess = true;
    } else {
      shouldProcess = false;
    }
    if shouldProcess {
      this.GetDevicePS().AreaExited(obj);
      if isPlayer {
        let mappinSystem = GameInstance.GetMappinSystem(this.GetGame());
        if IsDefined(mappinSystem) {
          mappinSystem.OnAreaExited(obj, triggerID);
        }
      }
    }
  }

  protected func AdjustInteractionComponent() {
    this.m_interaction.Toggle(false);
  }

  public const func GetDefaultHighlight() -> FocusForcedHighlightData {
    return null;
  }

  protected cb func OnQuestIllegalActionAreaNotification(evt: QuestIllegalActionAreaNotification) -> Bool {
    this.GetDevicePS().OnQuestIllegalActionAreaNotification(evt);
  }

  protected cb func OnQuestCombatActionAreaNotification(evt: QuestCombatActionAreaNotification) -> Bool {
    this.GetDevicePS().OnQuestCombatActionAreaNotification(evt);
  }

  protected cb func OnQuestAddTransition(evt: QuestAddTransition) -> Bool {
    this.GetDevicePS().OnQuestAddTransition(evt);
  }

  protected cb func OnQuestRemoveTransition(evt: QuestRemoveTransition) -> Bool {
    this.GetDevicePS().OnQuestRemoveTransition(evt);
  }

  protected cb func OnQuestExecuteTranstion(evt: QuestExecuteTransition) -> Bool {
    this.GetDevicePS().OnQuestExecuteTransition(evt);
  }

  private final func SendFakeExitEventToObjectsInsideMe() {
    let ps = this.GetDevicePS();
    let objectsInsideMe = ps.GetUsersInPerimeter();
    let index = 0;
    while index < ArraySize(objectsInsideMe) {
      let objectInsideMe = objectsInsideMe[index];
      let object = GameInstance.FindEntityByID(GetGameInstance(), objectInsideMe.user) as GameObject;
      this.OnAreaExitInternal(object, this.GetEntityID());
      index += 1;
    }
  }
}

