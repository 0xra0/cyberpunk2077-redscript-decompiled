class StatsSystemHelper extends IScriptable {
  public final static func GetDetailedStatInfo(
    obj: GameObject,
    statType: gamedataStatType,
    statData: script_ref<gameStatDetailedData>
  ) -> Bool {
    let detailsArray = GameInstance
      .GetStatsSystem(obj.GetGame())
      .GetStatDetails(Cast<StatsObjectID>(obj.GetEntityID()));
    let i = 0;
    while i < ArraySize(detailsArray) {
      if Equals(detailsArray[i].statType, statType) {
        statData = detailsArray[i];
        return true;
      }
      i += 1;
    }
    return false;
  }

  public final static func GetStatPrereqModifiersValue(game: GameInstance, ownerID: StatsObjectID, statPrereqID: TweakDBID) -> Float {
    let statModifiers: [wref<StatModifier_Record>];
    let record = TweakDBInterface.GetStatPrereqRecord(statPrereqID);
    record.StatModifiers(statModifiers);
    let modifiersValue = GameInstance.GetStatsSystem(game).CalculateModifierListValue(ownerID, statModifiers);
    return modifiersValue;
  }

  public final static func GetStatValue(obj: GameObject, objID: StatsObjectID, statType: gamedataStatType) -> Float {
    return GameInstance.GetStatsSystem(obj.GetGame()).GetStatValue(objID, statType);
  }

  public final static func GetStatValue(obj: GameObject, statType: gamedataStatType) -> Float {
    return GameInstance
      .GetStatsSystem(obj.GetGame())
      .GetStatValue(Cast<StatsObjectID>(obj.GetEntityID()), statType);
  }
}

