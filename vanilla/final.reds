public func GetMountedVehicle(object: GameObject) -> wref<VehicleObject> {
  let game = object.GetGame();
  let mountingFacility = GameInstance.GetMountingFacility(game);
  let mountingInfo = mountingFacility.GetMountingInfoSingleWithObjects(object);
  let vehicle = GameInstance.FindEntityByID(game, mountingInfo.parentId) as VehicleObject;
  return vehicle;
}

