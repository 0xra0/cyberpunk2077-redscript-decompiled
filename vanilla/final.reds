      >= 1
      && !this.m_playerCraftBook.KnowsRecipe(t"Items.Common_Pulsar_Buzzsaw")
      && !this.m_playerCraftBook.KnowsRecipe(t"Items.Uncommon_Pulsar_Buzzsaw")
      && !this.m_playerCraftBook.KnowsRecipe(t"Items.Rare_Pulsar_Buzzsaw")
