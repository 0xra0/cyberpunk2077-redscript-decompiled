  public final func GetTooltipDataForInventoryItem(
    const tooltipItemData: script_ref<InventoryItemData>,
    equipped: Bool,
    opt vendorItem: Bool,
    opt overrideRarity: Bool
  ) -> InventoryTooltipData {
