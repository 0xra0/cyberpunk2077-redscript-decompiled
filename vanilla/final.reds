  public final static func GetWeaponChargeNormalized(weapon: wref<WeaponObject>) -> Float {
    let statPoolSystem = GameInstance.GetStatPoolsSystem(weapon.GetGame());
    let result = 0.0;
    let chargeVal = statPoolSystem
      .GetStatPoolValue(
        Cast<StatsObjectID>(weapon.GetEntityID()),
        gamedataStatPoolType.WeaponCharge,
        false
      );
    result = ClampF(chargeVal / weapon.GetMaxChargeTreshold(), 0.0, 1.0);
    return result;
  }

