  public final static func IsSlotOccupiedByOtherEntity(
    gi: GameInstance,
    vehicleID: EntityID,
    vehicleSlotID: MountingSlotId,
    expectedEntity: EntityID
  ) -> Bool {
    if !GameInstance.IsValid(gi) || !EntityID.IsDefined(vehicleID) || !EntityID.IsDefined(expectedEntity) {
      return false;
    }
    let mountInfo = GameInstance
      .GetMountingFacility(gi)
      .GetMountingInfoSingleWithIds(vehicleID, vehicleSlotID);
    if !EntityID.IsDefined(mountInfo.childId) {
      return false;
    }
    return expectedEntity != mountInfo.childId;
  }

