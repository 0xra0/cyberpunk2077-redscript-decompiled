class LootContainerObjectAnimatedByTransform extends gameContainerObjectBase {
  protected let wasOpened: Bool;

  protected cb func OnResetContainerEvent(evt: ResetContainerEvent) -> Bool {
    let evtRegenerateLoot = new RegenerateLootEvent();
    let evtTransformAnimationReset = new gameTransformAnimationResetEvent();
    let setContainerStateEvent = new SetContainerStateEvent();
    let ps = this.GetPS();
    this.QueueEvent(evtRegenerateLoot);
    setContainerStateEvent.isDisabled = false;
    GameInstance
      .GetPersistencySystem(this.GetGame())
      .QueuePSEvent(ps.GetID(), ps.GetClassName(), setContainerStateEvent);
    this.RegisterToHUDManagerByTask(true);
    if this.IsQuest() {
      this.ToggleLootHighlight(true);
      this.MarkAsQuest(true);
      this.ResolveQualityRangeInteractionLayer();
    }
    evtTransformAnimationReset.animationName = n"Open";
    this.QueueEventForEntityID(this.GetEntityID(), evtTransformAnimationReset);
    this.wasOpened = false;
  }

  protected cb func OnToggleContainerLockEvent(evt: ToggleContainerLockEvent) -> Bool {
    super.OnToggleContainerLockEvent(evt);
    if !evt.isLocked {
      GameObjectEffectHelper.StartEffectEvent(this, n"fx_checked");
      this.RequestHUDRefresh();
      this.OpenContainerWithTransformAnimation();
      this.wasOpened = true;
    }
  }

  protected cb func OnInteraction(choiceEvent: InteractionChoiceEvent) -> Bool {
    super.OnInteraction(choiceEvent);
    if !this.wasOpened {
      this.OpenContainerWithTransformAnimation();
      this.wasOpened = true;
    }
  }

  private const final func HasTransactionFromTweakID(itemId: TweakDBID) -> Bool {
    let transactionSystem = GameInstance.GetTransactionSystem(this.GetGame());
    let currentItemID = ItemID.FromTDBID(itemId);
    let currentGameData = transactionSystem.GetItemData(this, currentItemID);
    let tweakID = ItemID.GetTDBID(currentGameData.GetID());
    return tweakID != TDBID.None();
  }

  public const func IsRifleAmmoLoot() -> Bool {
    return this.HasTransactionFromTweakID(t"Ammo.RifleAmmo");
  }

  public const func IsShotgunAmmoLoot() -> Bool {
    return this.HasTransactionFromTweakID(t"Ammo.ShotgunAmmo");
  }

  public const func IsHandgunAmmoLoot() -> Bool {
    return this.HasTransactionFromTweakID(t"Ammo.HandgunAmmo");
  }

  public const func IsSniperAmmoLoot() -> Bool {
    return this.HasTransactionFromTweakID(t"Ammo.SniperRifleAmmo");
  }
}

