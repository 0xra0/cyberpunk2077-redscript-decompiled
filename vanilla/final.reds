class piercingGrenade extends BaseProjectile {
  private let m_piercingEffect: EffectRef;
  private let m_pierceTime: Float;
  private let m_energyLossFactor: Float;
  private let m_startVelocity: Float;
  private let m_grenadeLifetime: Float;
  private let m_gravitySimulation: Float;
  private let m_trailEffectName: CName;
  private let m_alive: Bool;

  protected cb func OnProjectileInitialize(eventData: gameprojectileSetUpEvent) -> Bool {
    this.StartTrailEffect();
    this.m_projectileComponent.SetEnergyLossFactor(this.m_energyLossFactor, 0.05);
  }

  private final func StartTrailEffect() {
    let spawnEffectEvent = new entSpawnEffectEvent();
    spawnEffectEvent.effectName = this.m_trailEffectName;
    this.QueueEvent(spawnEffectEvent);
  }

  protected cb func OnShoot(eventData: gameprojectileShootEvent) -> Bool {
    this.StartTrailEffect();
  }

  protected cb func OnShootTarget(eventData: gameprojectileShootTargetEvent) -> Bool {
    if this.m_alive {
      this.Explode(eventData.startPoint);
      this.Release();
      this.m_alive = false;
    }
  }

  protected cb func OnTick(eventData: gameprojectileTickEvent) -> Bool;

  protected cb func OnCollision(eventData: gameprojectileHitEvent) -> Bool {
    let hitInstance = eventData.hitInstances[0];
    let target = hitInstance.hitObject as GameObject;
    if IsDefined(target as gamePuppet) {
      this.Pierce(hitInstance.position);
    } else {
      let evt = new gameprojectileShootTargetEvent();
      evt.startPoint = hitInstance.position;
      GameInstance.GetDelaySystem(this.GetGame()).DelayEvent(this, evt, this.m_pierceTime);
      this.StopMovement();
    }
  }

  private final func Explode(position: Vector4) {
    let explosionEffect = this.m_projectileComponent.GetGameEffectInstance();
    EffectData
      .SetVector(
        explosionEffect.GetSharedData(),
        GetAllBlackboardDefs().EffectSharedData.position,
        position
      );
    explosionEffect.Run();
  }

  private final func Pierce(position: Vector4) {
    let piercingEffect = GameInstance
      .GetGameEffectSystem(this.GetGame())
      .CreateEffect(
        this.m_piercingEffect,
        GameInstance.GetPlayerSystem(this.GetGame()).GetLocalPlayerMainGameObject(),
        this
      );
    EffectData
      .SetVector(
        piercingEffect.GetSharedData(),
        GetAllBlackboardDefs().EffectSharedData.position,
        position
      );
    piercingEffect.Run();
  }

  private final func StopMovement() {
    this.m_projectileComponent.ClearTrajectories();
  }
}

class nanowireGrenade extends BaseProjectile {
  private let m_countTime: Float;
  private let m_timeToActivation: Float;
  private let m_energyLossFactor: Float;
  private let m_startVelocity: Float;
