class MuteArm extends WeaponObject {
  private let m_gameEffectRef: EffectRef;
  private let gameEffectInstance: EffectInstance;

  protected cb func OnChargeStartedEvent(evt: ChargeStartedEvent) -> Bool {
    this.SetUpMuteArmBlackboard(true);
    let player = GetPlayer(this.GetGame());
    this.gameEffectInstance = GameInstance
      .GetGameEffectSystem(this.GetGame())
      .CreateEffect(this.m_gameEffectRef, player, this);
    EffectData
      .SetFloat(
        this.gameEffectInstance.GetSharedData(),
        GetAllBlackboardDefs().EffectSharedData.radius,
        4.0
      );
    this
      .gameEffectInstance
      .AttachToEntity(player, GetAllBlackboardDefs().EffectSharedData.position);
    this.gameEffectInstance.Run();
    this.ChangeAppearance(n"green");
  }

  protected cb func OnChargeEndedEvent(evt: ChargeEndedEvent) -> Bool {
    if IsDefined(this.gameEffectInstance) {
      this.gameEffectInstance.Terminate();
      this.ChangeAppearance(n"default");
    }
  }

  protected final func ChangeAppearance(newAppearance: CName) {
    let evt = new entAppearanceEvent();
    evt.appearanceName = newAppearance;
    this.QueueEvent(evt);
  }

  protected final func SetUpMuteArmBlackboard(enabled: Bool) {
    let blackboardSystem = GameInstance.GetBlackboardSystem(this.GetGame());
    let blackboard = blackboardSystem.Get(GetAllBlackboardDefs().CW_MuteArm);
    if enabled {
      blackboard.SetBool(GetAllBlackboardDefs().CW_MuteArm.MuteArmActive, true, true);
      blackboard.SetFloat(GetAllBlackboardDefs().CW_MuteArm.MuteArmRadius, 4.0, true);
    } else {
      blackboard.SetBool(GetAllBlackboardDefs().CW_MuteArm.MuteArmActive, false, true);
      blackboard.SetFloat(GetAllBlackboardDefs().CW_MuteArm.MuteArmRadius, 0.0, true);
    }
  }
}

