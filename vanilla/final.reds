  public let m_breachCooldownMin: Float;
  public let m_breachCooldownMax: Float;
  public let m_breachCooldownDecreasePerStreak: Float;
  public let m_onBreachDestroyedAttackRecord: Attack_GameEffect_Record;
  public let m_onBreachDestroyedHealthToDamage: Float;
  public let m_onBreachDestroyedHealthToDamageBoss: Float;
  public let m_desiredBreachDuration: Float;
  public let m_cooldownAfterBreach: Float;

  public final native func IsTrackedBreachHit(hitEvent: gameHitEvent, isMeleeAttack: Bool, isBulletExplosion: Bool) -> Bool;

  public final native func OnTrackedBreachDamaged(damage: Float);

  public final native func CanTrackedBreachBeKilledByDamage(damage: Float) -> Bool;

  public final native func GetTrackedBreachComponent() -> wref<BreachComponent>;

  public final native func GetTrackedBreachPuppet() -> wref<gamePuppet>;

  public final func Init(owner: wref<GameObject>) {
    this.m_owner = owner;
    this.m_audioSystem = GameInstance.GetAudioSystem(this.m_owner.GetGame());
    this.m_statsSystem = GameInstance.GetStatsSystem(this.m_owner.GetGame());
    this.m_breachDurationMin = TweakDBInterface.GetFloat(t"NewPerks.CyberwareBreachParams.breachDurationMin", 5.0);
    this.m_breachDurationMax = TweakDBInterface.GetFloat(t"NewPerks.CyberwareBreachParams.breachDurationMax", 6.0);
    this.m_breachDurationIncreasePerStreak = TweakDBInterface
      .GetFloat(t"NewPerks.CyberwareBreachParams.breachDurationIncreasePerStreak", 10.0);
    this.m_breachDurationIncreaseForAnyStreak = TweakDBInterface
      .GetFloat(t"NewPerks.CyberwareBreachParams.breachDurationIncreaseForAnyStreak", 2.0);
    this.m_breachDurationIncreaseOnFirstLookat = TweakDBInterface
      .GetFloat(t"NewPerks.CyberwareBreachParams.breachDurationIncreaseOnFirstLookat", 4.0);
    this.m_breachDurationIncreaseOnFirstHit = TweakDBInterface
      .GetFloat(t"NewPerks.CyberwareBreachParams.breachDurationIncreaseOnFirstHit", 4.0);
    this.m_breachCooldownMin = TweakDBInterface.GetFloat(t"NewPerks.CyberwareBreachParams.breachCooldownMin", 7.0);
    this.m_breachCooldownMax = TweakDBInterface.GetFloat(t"NewPerks.CyberwareBreachParams.breachCooldownMax", 15.0);
    this.m_breachCooldownDecreasePerStreak = TweakDBInterface
      .GetFloat(t"NewPerks.CyberwareBreachParams.breachCooldownDecreasePerStreak", 10.0);
    this.m_onBreachDestroyedAttackRecord = TweakDBInterface.GetAttack_GameEffectRecord(t"Attacks.BreachEMPExplosion");
    this.m_onBreachDestroyedHealthToDamage = TweakDBInterface
      .GetFloat(t"NewPerks.CyberwareBreachParams.explosionDamageHealthPercentage", 100.0);
    this.m_onBreachDestroyedHealthToDamageBoss = TweakDBInterface
      .GetFloat(t"NewPerks.CyberwareBreachParams.explosionDamageHealthPercentageBoss", 100.0);
  }

  public final func GetBreachStreak() -> Float {
    let streak = this
      .m_statsSystem
      .GetStatValue(
        Cast<StatsObjectID>(this.m_owner.GetEntityID()),
        gamedataStatType.BreachStreakBuffBonus
      );
    if streak < 5.0 {
      return streak;
    }
    return 2.0 * streak;
  }

  public final static func TryProcessBreachHit(hitEvent: gameHitEvent, isHeadshot: Bool, opt checkOnly: Bool) -> Bool {
    let isRanged = AttackData.IsRangedOrDirectOrThrown(hitEvent.attackData.GetAttackType());
    let isMelee = AttackData.IsMelee(hitEvent.attackData.GetAttackType()) || AttackData.IsWhip(hitEvent.attackData.GetAttackType());
    if !isMelee && !isRanged {
      return false;
    } else if isHeadshot {
      return false;
    } else if !IsDefined(hitEvent.attackData.GetWeapon()) && !hitEvent.attackData.HasFlag(hitFlag.WasBulletDeflected) {
      return false;
    }
    let player = hitEvent.attackData.GetInstigator() as PlayerPuppet;
    if !IsDefined(player) {
      return false;
    }
    let breachFinder = player.GetBreachFinderComponent();
    if !IsDefined(breachFinder) {
      return false;
    } else if !breachFinder
      .IsTrackedBreachHit(hitEvent, isMelee, hitEvent.attackData.HasFlag(hitFlag.BulletExplosion)) {
      return false;
    } else if !checkOnly {
      breachFinder.ProcessBreachHit(hitEvent);
    }
    return true;
  }

  private final func ProcessBreachHit(hitEvent: gameHitEvent) {
    hitEvent.attackData.AddFlag(hitFlag.CriticalHit, n"ProcessBreachHit");
    hitEvent.attackData.AddFlag(hitFlag.WeakspotHit, n"ProcessBreachHit");
    hitEvent.attackData.AddFlag(hitFlag.BreachHit, n"ProcessBreachHit");
    if !hitEvent.projectionPipeline {
      this.m_hitCount += 1;
      if this.m_hitCount == 1 {
        this.OnFirstBreachHit();
      }
    }
  }

  public final func OnFirstBreachLookat() {
    if !this.m_almostTimeout {
      this.m_desiredBreachDuration += this.m_breachDurationIncreaseOnFirstLookat;
    }
  }

  private final func OnFirstBreachHit() {
    if !this.m_almostTimeout {
      this.m_desiredBreachDuration += this.m_breachDurationIncreaseOnFirstHit;
    }
  }

  protected cb final func OnDamageDealt(evt: gameTargetDamageEvent) -> Bool {
    if !evt.attackData.HasFlag(hitFlag.BreachHit) || !IsDefined(evt.target) || evt.damage <= 0.0 {
      return false;
    }
    this.OnTrackedBreachDamaged(evt.damage);
  }

  public final func OnBreachDestroyed() {
    let breachComponent = this.GetTrackedBreachComponent();
    let breachPuppet = this.GetTrackedBreachPuppet() as NPCPuppet;
    if IsDefined(breachComponent) && IsDefined(breachPuppet) && IsDefined(this.m_owner) {
      this
        .SpawnFinalAttack(
          this.m_owner,
          this.m_onBreachDestroyedAttackRecord,
          breachComponent,
          breachPuppet
        );
    } else if PlayerDevelopmentSystem
      .GetData(this.m_owner)
      .IsNewPerkBought(gamedataNewPerkType.Espionage_Right_Perk_1_1) > 0 {
      StatusEffectHelper
        .ApplyStatusEffect(
          this.m_owner,
          t"BaseStatusEffect.CyberwareBreachStreak",
          this.m_owner.GetEntityID()
        );
    }
    this.m_hitCount = 0;
  }

  private final func SpawnFinalAttack(
    instigator: wref<GameObject>,
    attackRecord: Attack_GameEffect_Record,
    breach: BreachComponent,
    puppet: NPCPuppet
  ) {
    let attackContext: AttackInitContext;
    let statMods: [gameStatModifierData];
    let position = breach.GetPosition();
    let breachMaxHealth = breach.GetMaxHealth();
    if breachMaxHealth <= 0.0 {
      return;
    }
    let breachMaxHealthToDamage = Equals(puppet.GetNPCRarity(), gamedataNPCRarity.Boss) || Equals(puppet.GetNPCRarity(), gamedataNPCRarity.MaxTac) ? this.m_onBreachDestroyedHealthToDamageBoss : this.m_onBreachDestroyedHealthToDamage;
    attackContext.record = attackRecord;
    attackContext.instigator = instigator;
    attackContext.source = instigator;
    let attack = IAttack.Create(attackContext) as Attack_GameEffect;
    attack
      .AddStatModifier(
        RPGManager
          .CreateStatModifier(
            gamedataStatType.ElectricDamage,
            gameStatModifierType.Additive,
            breachMaxHealth * breachMaxHealthToDamage / 100.0
          )
      );
    attack.GetStatModList(statMods);
    let effect = attack.PrepareAttack(instigator);
    EffectData
      .SetFloat(
        effect.GetSharedData(),
        GetAllBlackboardDefs().EffectSharedData.range,
        attackRecord.Range()
      );
    EffectData
      .SetFloat(
        effect.GetSharedData(),
        GetAllBlackboardDefs().EffectSharedData.radius,
        attackRecord.Range()
      );
    EffectData
      .SetVector(
        effect.GetSharedData(),
        GetAllBlackboardDefs().EffectSharedData.position,
        position
      );
    EffectData
      .SetVariant(
        effect.GetSharedData(),
        GetAllBlackboardDefs().EffectSharedData.attack,
        ToVariant(attack)
      );
    EffectData
      .SetVariant(
        effect.GetSharedData(),
        GetAllBlackboardDefs().EffectSharedData.attackStatModList,
        ToVariant(statMods)
      );
    attack.StartAttack();
    this
      .m_audioSystem
      .PlayShockwave(TDB.GetCName(t"rumble.world.heavy_slow"), position);
  }

  public final func OnStartedTrackingBreach() {
    let streak = this.GetBreachStreak();
    this.m_desiredBreachDuration = (1.0 + streak * this.m_breachDurationIncreasePerStreak / 100.0) * RandRangeF(this.m_breachDurationMin, this.m_breachDurationMax);
    if streak > 0.0 {
      this.m_desiredBreachDuration += this.m_breachDurationIncreaseForAnyStreak;
    }
    this.m_hitCount = 0;
    this.m_almostTimeout = false;
    GameObject.PlaySoundEvent(this.m_owner, n"ui_gmpl_perk_cw_breach");
  }

  public final func OnStoppedTrackingBreach() {
    this.m_cooldownAfterBreach = (1.0 - this.GetBreachStreak() * this.m_breachCooldownDecreasePerStreak / 100.0) * RandRangeF(this.m_breachCooldownMin, this.m_breachCooldownMax);
    this.m_cooldownAfterBreach = MaxF(this.m_cooldownAfterBreach, 0.5);
  }

  public final func ShouldStartTrackingBreach(timeSinceLastBreach: Float) -> Bool {
    return timeSinceLastBreach >= this.m_cooldownAfterBreach;
  }

  public final func GetCooldownAfterBreach() -> Float {
    return this.m_cooldownAfterBreach;
  }

  public final func ShouldStopTrackingBreach(currentBreachDuration: Float) -> Bool {
    return currentBreachDuration >= this.m_desiredBreachDuration;
  }

  public final func IsAlmostBreachTimeout(currentBreachDuration: Float) -> Bool {
    this.m_almostTimeout = currentBreachDuration + 0.95 >= this.m_desiredBreachDuration;
    return this.m_almostTimeout;
  }

  public final func GetDesiredBreachDuration() -> Float {
    return this.m_desiredBreachDuration;
  }
}

