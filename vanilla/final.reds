    if EnumInt(newState) >= 2 && this.CanBeInDeviceChain() {
      let removeFromChain = new RemoveFromChainRequest();
      removeFromChain.requestSource = this.GetMyEntityID();
      this.GetTakeOverControlSystem().QueueRequest(removeFromChain);
    }
