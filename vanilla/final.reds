class LeftHandCyberwareLoopDecisions extends LeftHandCyberwareTransition {
  protected const final func EnterCondition(const stateContext: StateContext, const scriptInterface: StateGameScriptInterface) -> Bool {
    if scriptInterface.GetActionValue(n"UseCombatGadget") == 0.0 && this.LeftHandCyberwareHasTag(scriptInterface, n"LoopAction") {
      return true;
    }
    return false;
  }

  protected const final func ToLeftHandCyberwareWaitForUnequip(const stateContext: StateContext, const scriptInterface: StateGameScriptInterface) -> Bool {
    if scriptInterface.IsActionJustPressed(n"UseCombatGadget") {
      return true;
    } else if stateContext.GetBoolParameter(n"InterruptLeftHandAction") {
      return true;
    } else if this.GetMaxActiveTime(scriptInterface) > 0.0 && this.GetInStateTime() > this.GetMaxActiveTime(scriptInterface) {
      return true;
    }
    return false;
  }

  protected const final func ToLeftHandCyberwareUnequip(const stateContext: StateContext, const scriptInterface: StateGameScriptInterface) -> Bool {
    return this.ShouldInstantlyUnequipCyberware(scriptInterface, stateContext);
  }
}

