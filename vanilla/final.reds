class ModifyTelemetryVariable extends PlayerScriptableSystemRequest {
  public let dataTrackingFact: ETelemetryData;
  public let value: Int32;
}

public func SetFactValue(game: GameInstance, factName: CName, factCount: Int32) -> Bool {
  if !GameInstance.IsValid(game) {
    return false;
  } else if !IsNameValid(factName) {
    return false;
  }
  GameInstance.GetQuestsSystem(game).SetFact(factName, factCount);
  return true;
}

class ResetMeleeAttackDelayedRequest extends ScriptableSystemRequest {
}

class ResetRangedAttackDelayedRequest extends ScriptableSystemRequest {
}

final native class AchievementSystem extends IAchievementSystem {
  public final native func UnlockAchievement(achievement: Achievement_Record);

  public final native func SetAchievementProgress(achievement: Achievement_Record, precentComplete: Float);

