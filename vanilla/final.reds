class ActionNotifier extends IScriptable {
  public let external: Bool;
  public let internal: Bool;
  public let failed: Bool;

  public final func SetInternalOnly() {
    this.external = false;
    this.internal = true;
  }

  public final func SetExternalOnly() {
    this.external = true;
    this.internal = false;
  }

  public final func SetAll() {
    this.external = true;
    this.internal = true;
  }

  public final func SetNone() {
    this.external = false;
    this.internal = false;
  }

  public final func SetFailed() {
    this.external = false;
    this.internal = false;
    this.failed = true;
  }

  public final func IsInternalOnly() -> Bool {
    return Equals(this.external, false) && Equals(this.internal, true);
  }

  public final func IsExternalOnly() -> Bool {
    return Equals(this.external, true) && Equals(this.internal, false);
  }

  public final func IsAll() -> Bool {
    return Equals(this.external, true) && Equals(this.internal, true);
  }

  public final func IsNone() -> Bool {
    return Equals(this.external, false) && Equals(this.internal, false);
  }

  public final func IsFailed() -> Bool {
    return Equals(this.failed, true);
  }
}

class SecuritySystemControllerPS extends DeviceSystemBaseControllerPS {
  private let m_level_0: [SecurityAccessLevelEntry];
  private let m_level_1: [SecurityAccessLevelEntry];
  private let m_level_2: [SecurityAccessLevelEntry];
  private let m_level_3: [SecurityAccessLevelEntry];
  private let m_level_4: [SecurityAccessLevelEntry];
  private let m_allowSecuritySystemToDisableItself: Bool;
  private persistent let m_attitudeGroup: TweakDBID;
  private let m_suppressAbilityToModifyAttitude: Bool;
  private persistent let m_attitudeChangeMode: EShouldChangeAttitude;
  private let m_performAutomaticResetAfter: Time;
  private persistent let m_hideAreasOnMinimap: Bool;
  private persistent let m_isUnderStrictQuestControl: Bool;
  private persistent let m_securitySystemState: ESecuritySystemState;
  private persistent let m_agentsRegistry: AgentRegistry;
  private let m_securitySystem: SecuritySystemControllerPS;
  private persistent let m_latestOutputEngineTime: Float;
  private let m_updateInterval: Float;
  private const let m_restartDuration: Int32;
  private persistent let m_protectedEntityIDs: [EntityID];
  private persistent let m_entitiesRemainingAtGate: [EntityID];
  private persistent let m_blacklist: [BlacklistEntry];
  private persistent let m_currentReprimandID: Int32;
  private persistent let m_blacklistDelayValid: Bool;
  private persistent let m_blacklistDelayID: DelayID;
  private const let m_maxGlobalWarningsCount: Int32;
  private persistent let m_delayIDValid: Bool;
  private persistent let m_deescalationEventID: DelayID;
  private persistent let m_outputsSend: Int32;
  private persistent let m_inputsReceived: Int32;

  protected final func HandleSecuritySystemInputByTask(inputEvent: SecuritySystemInput) {
    let data = new SecuritySystemInputTaskData();
    data.cachedEvt = inputEvent;
    GameInstance
      .GetDelaySystem(this.GetGameInstance())
      .QueueTask(
        this,
        data,
        n"HandleSecuritySystemInputTask",
        gameScriptTaskExecutionStage.Any
      );
  }

  protected final func HandleSecuritySystemInputTask(data: ScriptTaskData) {
    let inputData = data as SecuritySystemInputTaskData;
    if IsDefined(inputData) {
      this.HandleSecuritySystemInput(inputData.cachedEvt);
    }
  }

  protected func Initialize() {
    super.Initialize();
    let evt = new PSInitializeEvent();
    this.QueuePSEvent(this, evt);
  }

  public final func OnPSInitializeEvent(evt: PSInitializeEvent) -> EntityNotificationType {
    if !this.IsRegistryReady() {
      this.InitiateAgentRegistry();
    } else if !IsNameValid(this.GetSecuritySystemAttitudeGroupName()) {
      this.SetSecuritySystemAttitudeGroup(t"Attitudes.Group_Neutral");
    }
    this.NotifyAboutAttitudeChange();
    return EntityNotificationType.DoNotNotifyEntity;
  }

  protected cb func OnInstantiated() -> Bool {
    super.OnInstantiated();
    let evt = new PSInstantiateEvent();
    this.QueuePSEvent(this, evt);
  }

  public final func OnPSInstantiateEvent(evt: PSInstantiateEvent) -> EntityNotificationType {
    this.m_attitudeChangeMode = EShouldChangeAttitude.TEMPORARLY;
    if !this.IsRegistryReady() {
      this.InitiateAgentRegistry();
    } else if this.IsPoliceSecuritySystem() {
      PreventionSystem.PreventionPoliceSecuritySystemRequest(this.GetGameInstance(), this.GetID());
    }
    return EntityNotificationType.DoNotNotifyEntity;
  }

  private const final func IsRegistryReady() -> Bool {
    return this.m_agentsRegistry.IsReady();
  }

  private final func InitiateAgentRegistry() {
    if this.IsDisabled() {
      return;
    }
    let areas = this.GetSecurityAreas();
    if ArraySize(areas) == 0 {
      return;
    }
    this.CompileSecurityAgentRegistry();
  }

  private final func CreateRegistry() {
    this.m_agentsRegistry = AgentRegistry.Construct();
  }

  private final func CompileSecurityAgentRegistry() {
    let slaves: [DeviceComponentPS];
    if this.IsDisabled() {
      return;
    } else if !this.m_agentsRegistry.IsReady() {
      this.CreateRegistry();
    }
    this.GetAllDescendants(slaves);
    let i = 0;
    while i < ArraySize(slaves) {
      if IsDefined(slaves[i] as SecurityAreaControllerPS) || IsDefined(slaves[i] as CommunityProxyPS) {
      } else {
        this
          .AddAgentRecord(
            DeviceLink.Construct(slaves[i] as SharedGameplayPS),
            slaves[i].GetSecurityAreas(true),
            false
          );
      }
      i += 1;
    }
  }

  private final func AddAgentRecord(
    agent: DeviceLink,
    const connectedAreas: script_ref<[SecurityAreaControllerPS]>,
    requestLatestOutput: Bool
  ) {
    this.m_agentsRegistry.RegisterAgent(agent, connectedAreas);
    if requestLatestOutput {
      this.RequestLatestOutput(DeviceLink.GetLinkID(agent));
    }
  }

  public const final func GetSensors() -> [SensorDeviceControllerPS] {
    let sensControllers: [SensorDeviceControllerPS];
    let sensAgents = this.GetAgentRegistry().GetSensors();
    let i = 0;
    while i < ArraySize(sensAgents) {
      let sensor = this.GetPS(sensAgents[i].link) as SensorDeviceControllerPS;
      if IsDefined(sensor) {
        ArrayPush(sensControllers, sensor);
      }
      i += 1;
    }
    return sensControllers;
  }

  public const final func IsSystemSafe() -> Bool {
    return Equals(this.m_securitySystemState, ESecuritySystemState.SAFE);
  }

  public const final func IsSystemAlerted() -> Bool {
    return Equals(this.m_securitySystemState, ESecuritySystemState.ALERTED);
  }

  public const final func IsSystemInCombat() -> Bool {
    return Equals(this.m_securitySystemState, ESecuritySystemState.COMBAT);
  }

  private const final func IsSystemSafeOrUninitialized() -> Bool {
    return Equals(this.m_securitySystemState, ESecuritySystemState.SAFE) || Equals(this.m_securitySystemState, ESecuritySystemState.UNINITIALIZED);
  }

  public const final func IsHidden() -> Bool {
    return this.m_hideAreasOnMinimap;
  }

  public const final func GetAgentRegistry() -> AgentRegistry {
    return this.m_agentsRegistry;
  }

  public const final func GetSecurityState() -> ESecuritySystemState {
    return this.m_securitySystemState;
  }

  public const func GetDeviceStatusAction() -> SecuritySystemStatus {
    return this.ActionSecuritySystemStatus();
  }

  public const final func GetSecuritySystemAttitudeGroupName() -> CName {
    let attitudeName: CName;
    let record = TweakDBInterface.GetAttitudeGroupRecord(this.m_attitudeGroup);
    if IsDefined(record) {
      attitudeName = record.Name();
    }
    return attitudeName;
  }

  public const final func IsPoliceSecuritySystem() -> Bool {
    return Equals(this.GetSecuritySystemAttitudeGroupName(), n"police");
  }

  public const final func GetReprimandReceiver(agentID: PersistentID) -> EntityID {
    return this.m_agentsRegistry.GetReprimandReceiver(agentID);
  }

  public const final func DetermineSecurityAreaTypeForEntityID(entityID: EntityID) -> ESecurityAreaType {
    let areaType = this.GetMostDangerousSecurityAreaForEntityID(entityID).GetSecurityAreaType();
    if Equals(areaType, ESecurityAreaType.DANGEROUS) {
      let i = 0;
      while i < ArraySize(this.m_entitiesRemainingAtGate) {
        if entityID == this.m_entitiesRemainingAtGate[i] {
          areaType = ESecurityAreaType.RESTRICTED;
        }
        i += 1;
      }
    }
    return areaType;
  }

  public const final func GetMostDangerousSecurityAreaForEntityID(entityID: EntityID) -> SecurityAreaControllerPS {
    let foundSecurityArea: SecurityAreaControllerPS;
    let currentSecAreaType = ESecurityAreaType.DISABLED;
    let secAreas = this.GetSecurityAreasWithUserInside(entityID);
    if ArraySize(secAreas) == 0 {
      return null;
    }
    let i = 0;
    while i < ArraySize(secAreas) {
      if EnumInt(secAreas[i].GetSecurityAreaType()) > EnumInt(currentSecAreaType) {
        foundSecurityArea = secAreas[i];
        currentSecAreaType = secAreas[i].GetSecurityAreaType();
      }
      i += 1;
    }
    return foundSecurityArea;
  }

  public const final func GetMostDangerousSecurityAreaForEntityID(go: GameObject) -> SecurityAreaControllerPS {
    if IsDefined(go) {
      return this.GetMostDangerousSecurityAreaForEntityID(go.GetEntityID());
    }
    return null;
  }

  public const final func ShouldReactToTarget(suspect: EntityID, reporter: EntityID) -> Bool {
    if this.IsDisabled() || this.IsUnpowered() {
      return false;
    } else if this.m_agentsRegistry.IsAgent(Cast<PersistentID>(suspect)) && NotEquals(this.GetAttitudeTowards(suspect), EAIAttitude.AIA_Hostile) {
      return false;
    } else if Equals(this.GetAttitudeTowards(suspect), EAIAttitude.AIA_Friendly) {
      return false;
    } else if Equals(this.GetAttitudeTowards(suspect), EAIAttitude.AIA_Hostile) {
      return true;
    } else if this.IsEntityBlacklistedForAtLeast(suspect, BlacklistReason.COMBAT) {
      return true;
    } else if this.m_securitySystemState
      > ESecuritySystemState.ALERTED
      && this
        .IsEntityBlacklistedForSpecificReason(suspect, BlacklistReason.TRESPASSING) {
      return true;
    } else if this.m_securitySystemState > ESecuritySystemState.ALERTED {
      return this.IsUserInsideSystem(suspect);
    }
    return this.IsTargetTresspassingMyZone(suspect, reporter);
  }

  public final func TryReleaseFromReprimand(entityID: EntityID) {
    if this.IsReprimandOngoing() {
      let target = this.GetReprimandReceiver(Cast<PersistentID>(entityID));
      if EntityID.IsDefined(target) {
        this
          .ReleaseCurrentPerformerFromReprimand(EReprimandInstructions.CONCLUDE_SUCCESSFUL, target);
      }
    }
  }

  protected const final func GetAgentAreas(agentID: PersistentID) -> [SecurityAreaControllerPS] {
    let areas: [SecurityAreaControllerPS];
    if IsDefined(this.m_agentsRegistry) {
      let areaLinks = this.m_agentsRegistry.GetAgentAreas(agentID);
      let i = 0;
      while i < ArraySize(areaLinks) {
        let area = this.GetPS(areaLinks[i]) as SecurityAreaControllerPS;
        if IsDefined(area) {
          ArrayPush(areas, area);
        }
        i += 1;
      }
    }
    return areas;
  }

  public const final func GetSecurityBlacklist() -> [BlacklistEntry] {
    return this.m_blacklist;
  }

  public const final func IsTargetTresspassingMyZone(suspect: EntityID, reporter: EntityID) -> Bool {
    let validAreas: [SecurityAreaControllerPS];
    if this.IsEntityBlacklistedForAtLeast(suspect, BlacklistReason.COMBAT) {
      return true;
    }
    let commonAreas = this
      .GetOverlappingAreas(
        this.GetAgentAreas(Cast<PersistentID>(reporter)),
        this.GetSecurityAreasWithUserInside(suspect)
      );
    let i = 0;
    while i < ArraySize(commonAreas) {
      if commonAreas[i].GetSecurityAreaType() > ESecurityAreaType.SAFE {
        ArrayPush(validAreas, commonAreas[i]);
      }
      i += 1;
    }
    if ArraySize(validAreas) == 0 {
      return false;
    }
    let breachLevel = this.FindHighestSecurityAccessLevel(validAreas);
    return !this.IsUserAuthorized(suspect, breachLevel);
  }

  public const final func IsUserInsideSystem(userToBeChecked: EntityID) -> Bool {
    let trash: ESecurityAccessLevel;
    return this.IsUserInsideSystem(userToBeChecked, trash);
  }

  public const final func IsUserInsideSystem(userToBeChecked: EntityID, out highestSecurityAccessLevel: ESecurityAccessLevel) -> Bool {
    let threat: ESecurityAreaType;
    return this.IsUserInsideSystem(userToBeChecked, highestSecurityAccessLevel, threat);
  }

  public const final func IsUserInsideSystem(
    userToBeChecked: EntityID,
    out highestSecurityAccessLevel: ESecurityAccessLevel,
    out highestThreat: ESecurityAreaType
  ) -> Bool {
    let isInside: Bool;
    let secAreas = this.GetSecurityAreas();
    let i = 0;
    while i < ArraySize(secAreas) {
      if secAreas[i].IsUserInside(userToBeChecked) {
        if highestSecurityAccessLevel < secAreas[i].GetSecurityAccessLevel() {
          highestSecurityAccessLevel = secAreas[i].GetSecurityAccessLevel();
        } else if highestThreat < secAreas[i].GetSecurityAreaType() {
          highestThreat = secAreas[i].GetSecurityAreaType();
        }
        isInside = true;
      }
      i += 1;
    }
    return isInside;
  }

  public const final func IsEntityBlacklisted(entityID: EntityID) -> Bool {
    let index = this.GetEntityBlacklistIndex(entityID);
    if index >= 0 {
      return true;
    }
    return false;
  }

  public const final func IsEntityBlacklisted(gameObject: GameObject) -> Bool {
    if IsDefined(gameObject) {
      return this.IsEntityBlacklisted(gameObject.GetEntityID());
    }
    return false;
  }

  public const final func IsEntityBlacklistedForAtLeast(entityID: EntityID, reason: BlacklistReason) -> Bool {
    let entryIndex = this.GetEntityBlacklistIndex(entityID);
    if entryIndex >= 0 {
      if EnumInt(reason) > EnumInt(this.m_blacklist[entryIndex].GetReason()) {
        return false;
      } else if Equals(reason, BlacklistReason.REPRIMAND) {
        return this.m_blacklist[entryIndex].GetWarningsCount() > this.m_maxGlobalWarningsCount;
      }
    } else if EnumInt(this.m_blacklist[entryIndex].GetReason()) >= EnumInt(reason) {
      return true;
    }
    return false;
  }

  protected const final func IsEntityBlacklistedForSpecificReason(entityID: EntityID, reason: BlacklistReason) -> Bool {
    let entryIndex = this.GetEntityBlacklistIndex(entityID);
    if entryIndex >= 0 {
      if EnumInt(this.m_blacklist[entryIndex].GetReason()) == EnumInt(reason) {
        return true;
      }
    }
    return false;
  }

  public const final func IsEntityBlacklistedForAtLeast(go: GameObject, reason: BlacklistReason) -> Bool {
    if IsDefined(go) {
      return this.IsEntityBlacklistedForAtLeast(go.GetEntityID(), reason);
    }
    return false;
  }

  public const final func HasEntityBeenSpottedTooManyTimes(reporter: PersistentID, target: EntityID) -> Bool {
    if this.HasSurpassedGlobalWarningsCount(target) {
      return true;
    } else if IsDefined(this.m_agentsRegistry) {
      return this.m_agentsRegistry.HasEntityBeenSpottedTooManyTimes(reporter, target);
    }
    return false;
  }

  public const final func HasEntityBeenSpottedTooManyTimes(
    reporter: PersistentID,
    target: GameObject,
    notificationType: ESecurityNotificationType
  ) -> Bool {
    if Equals(notificationType, ESecurityNotificationType.REPRIMAND_SUCCESSFUL) {
      return false;
    } else if IsDefined(target) {
      return this.HasEntityBeenSpottedTooManyTimes(reporter, target.GetEntityID());
    }
    return false;
  }

  public const final func HasSurpassedGlobalWarningsCount(target: EntityID) -> Bool {
    let i = 0;
    while i < ArraySize(this.m_blacklist) {
      if this.m_blacklist[i].GetEntityID()
        == target
        && this.m_blacklist[i].GetWarningsCount() > this.m_maxGlobalWarningsCount {
        return true;
      }
      i += 1;
    }
    return false;
  }

  public const final func IsReprimandOngoing() -> Bool {
    return this.m_agentsRegistry.IsReprimandOngoing();
  }

  public const final func IsReprimandOngoingAgainst(suspect: EntityID) -> Bool {
    return this.m_agentsRegistry.IsReprimandOngoingAgainst(suspect);
  }

  public const final func GetReprimandPerformer(opt target: EntityID) -> GameObject {
    let agent: Agent;
    if !EntityID.IsDefined(target) {
      target = GetPlayer(this.GetGameInstance()).GetEntityID();
    } else if this.m_agentsRegistry.GetReprimandPerformer(target, agent) {
      let ps = this.GetPS(agent.link);
      return ps.GetOwnerEntityWeak() as GameObject;
    }
    return null;
  }

  public const func GetSecurityAreas(opt includeInactive: Bool, opt acquireOnlyDirectlyConnected: Bool) -> [SecurityAreaControllerPS] {
    let areas: [SecurityAreaControllerPS];
    let children = this.GetImmediateSlaves();
    let i = 0;
    while i < ArraySize(children) {
      if IsDefined(children[i] as SecurityAreaControllerPS) {
        if (children[i] as SecurityAreaControllerPS).IsActive() {
          ArrayPush(areas, children[i] as SecurityAreaControllerPS);
        } else if includeInactive {
          ArrayPush(areas, children[i] as SecurityAreaControllerPS);
        }
      }
      i += 1;
    }
    return areas;
  }

  protected final func SetSecuritySystemAttitudeGroup(newAttitude: TweakDBID) {
    if newAttitude == this.m_attitudeGroup {
      return;
    }
    this.m_attitudeGroup = newAttitude;
    this
      .m_agentsRegistry
      .CleanUpOnNewAttitudeGroup(this.GetGameInstance(), this.GetSecuritySystemAttitudeGroupName());
    let i = ArraySize(this.m_blacklist) - 1;
    while i >= 0 {
      if Equals(
        this
          .GetAttitudeSystem()
          .GetAttitudeRelation(
            this
              .GetAttitudeSystem()
              .GetAttitudeGroup(this.m_blacklist[i].GetEntityID()),
            this.GetSecuritySystemAttitudeGroupName()
          ),
        EAIAttitude.AIA_Friendly
      ) {
        this.RemoveIndexFromBlacklist(i);
      }
      i -= 1;
    }
    this.NotifyAboutAttitudeChange();
  }

  private final func RemoveIndexFromBlacklist(index: Int32) {
    if index >= 0 && index < ArraySize(this.m_blacklist) {
      let entityId = this.m_blacklist[index].GetEntityID();
      ArrayErase(this.m_blacklist, index);
      this.TryUpdateBlackboardAreaDataFor(entityId);
    }
  }

  private final func TryUpdateBlackboardAreaDataFor(entityId: EntityID) {
    if this.IsPlayersEntityID(entityId) {
      this.UpdateBlackboardAreaDataForPlayer();
    }
  }

  private final func UpdateBlackboardAreaDataForPlayer() {
    let playerId = this.GetPlayerEntityID();
    if this.IsEntityInsideAnyArea(playerId) {
      let securityAreaController = this.GetMostDangerousSecurityAreaForEntityID(playerId);
      let securityAreaData = this.GetSecurityDataForArea(securityAreaController);
      this.UpdateSecurityZoneDataBlackboard(securityAreaData);
    }
  }

  private final func IsEntityInsideAnyArea(entityId: EntityID) -> Bool {
    let areasWithEntityInside = this.GetSecurityAreasWithUserInside(entityId);
    return ArraySize(areasWithEntityInside) > 0;
  }

  private final func UpdateSecurityZoneDataBlackboard(securityAreaData: SecurityAreaData) {
    let bbSystem = GameInstance.GetBlackboardSystem(this.GetGameInstance());
    let playerId = this.GetPlayerEntityID();
    let playerStateMachineBB = bbSystem.GetLocalInstanced(playerId, GetAllBlackboardDefs().PlayerStateMachine);
    if IsDefined(playerStateMachineBB) {
      securityAreaData.shouldHideOnMinimap = this.IsHidden();
      playerStateMachineBB
        .SetVariant(
          GetAllBlackboardDefs().PlayerStateMachine.SecurityZoneData,
          ToVariant(securityAreaData),
          true
        );
    }
  }

  private final func GetSecurityDataForArea(area: SecurityAreaControllerPS) -> SecurityAreaData {
    let securityAreaData: SecurityAreaData;
    if IsDefined(area) {
      securityAreaData = area.GetSecurityAreaData();
      let playerId = this.GetPlayerEntityID();
      if this.IsEntityBlacklistedForAtLeast(playerId, BlacklistReason.COMBAT) || this.HasSurpassedGlobalWarningsCount(playerId) {
        securityAreaData.securityAreaType = ESecurityAreaType.DANGEROUS;
      }
    } else {
      securityAreaData = new SecurityAreaData();
    }
    return securityAreaData;
  }

  protected final func NotifyAboutAttitudeChange() {
    let forceAttitudeChange = new SecuritySystemForceAttitudeChange();
    forceAttitudeChange.newAttitude = this.GetSecuritySystemAttitudeGroupName();
    this.SendActionToAllSlaves(forceAttitudeChange);
    this.RequestTargetsAssessment(null);
  }

  private final func SetSecuritySystemAttitude(
    desiredAttitude: EAIAttitude,
    input: SecuritySystemInput,
    opt isComingFromQuest: Bool
  ) {
    if this.m_attitudeGroup == t"Attitudes.Group_Friendly" {
      return;
    } else if this.m_attitudeGroup == t"Attitudes.Group_Neutral" {
      return;
    } else if this.m_attitudeGroup == t"Attitudes.Group_Hostile" {
      return;
    } else if this.IsPoliceSecuritySystem() {
      return;
    } else if !isComingFromQuest {
      if this.m_suppressAbilityToModifyAttitude {
        return;
      }
    }
    let targetAttitudeGroup = GameInstance
      .GetAttitudeSystem(this.GetGameInstance())
      .GetAttitudeGroup(input.GetWhoBreached().GetEntityID());
    if !CanChangeAttitudeRelationFor(targetAttitudeGroup) {
      return;
    }
    let currentRelation = this
      .GetAttitudeSystem()
      .GetAttitudeRelation(this.GetSecuritySystemAttitudeGroupName(), targetAttitudeGroup);
    if Equals(currentRelation, desiredAttitude) {
      return;
    } else if !isComingFromQuest
      && Equals(currentRelation, EAIAttitude.AIA_Friendly)
      && Equals(desiredAttitude, EAIAttitude.AIA_Hostile) {
      return;
    } else if !this.m_suppressAbilityToModifyAttitude {
      if Equals(this.m_attitudeChangeMode, EShouldChangeAttitude.TEMPORARLY) {
        this
          .GetAttitudeSystem()
          .SetAttitudeRelation(
            this.GetSecuritySystemAttitudeGroupName(),
            targetAttitudeGroup,
            desiredAttitude
          );
      } else if Equals(this.m_attitudeChangeMode, EShouldChangeAttitude.PERSISTENTLY) {
        this
          .GetAttitudeSystem()
          .SetAttitudeGroupRelationPersistent(
            this.GetSecuritySystemAttitudeGroupName(),
            targetAttitudeGroup,
            desiredAttitude
          );
      } else if Equals(desiredAttitude, EAIAttitude.AIA_Friendly) {
        this.RemoveFromBlacklist(input.GetWhoBreached());
      }
    }
    this.NotifyAboutAttitudeChange();
  }

  private final func SetSecurityState(
    newState: ESecuritySystemState,
    opt input: SecuritySystemInput,
    opt isComingFromQuest: Bool
  ) {
    if Equals(this.m_securitySystemState, newState) {
      return;
    } else if Equals(newState, ESecuritySystemState.COMBAT) {
      this.m_securitySystem = this;
      this
        .SetSecuritySystemAttitude(EAIAttitude.AIA_Hostile, input, isComingFromQuest);
      this.SendSupportEvents(false);
    } else if Equals(this.m_securitySystemState, ESecuritySystemState.COMBAT) {
      this.m_securitySystem = null;
      this.SendSupportEvents(true);
    } else if !IsFinal() {
    }
    this.m_securitySystemState = newState;
    if IsDefined(input) {
      this.NotifyParents();
    }
  }

  protected final func OnMadnessDebuff(evt: MadnessDebuff) -> EntityNotificationType {
    if !this.IsRegistryReady() {
      this.InitiateAgentRegistry();
    }
    this.ReleaseAllReprimands();
    this.m_agentsRegistry.UnregisterAgent(evt.object.GetDeviceLink().GetID());
    this.CleanSecuritySystemMemory();
    this.BlacklistEntityID(evt.object.GetEntityID(), BlacklistReason.COMBAT);
    this.RequestTargetsAssessment(null);
    return EntityNotificationType.DoNotNotifyEntity;
  }

  protected final func OnSuppressSecuritySystemReaction(evt: SuppressSecuritySystemReaction) -> EntityNotificationType {
    let dummyInputEvent: SecuritySystemInput;
    if evt.entered {
      if !ArrayContains(this.m_entitiesRemainingAtGate, evt.protectedEntityID) {
        ArrayPush(this.m_entitiesRemainingAtGate, evt.protectedEntityID);
      }
    } else if ArraySize(this.m_entitiesRemainingAtGate) > 0 {
      if evt.hasEntityWithdrawn {
        if this.IsReprimandOngoingAgainst(evt.protectedEntityID) {
          let securityAreaType = this
            .GetMostDangerousSecurityAreaForEntityID(evt.protectedEntityID)
            .GetSecurityAreaType();
          if securityAreaType < ESecurityAreaType.RESTRICTED {
            this.Deescalate(dummyInputEvent);
            this
              .ReleaseCurrentPerformerFromReprimand(EReprimandInstructions.CONCLUDE_SUCCESSFUL, evt.protectedEntityID);
          } else {
            ArrayRemove(this.m_entitiesRemainingAtGate, evt.protectedEntityID);
          }
        }
      }
    }
    if evt.enableProtection {
      if !this
        .IsEntityBlacklistedForAtLeast(evt.protectedEntityID, BlacklistReason.REPRIMAND) && !ArrayContains(this.m_protectedEntityIDs, evt.protectedEntityID) {
        ArrayPush(this.m_protectedEntityIDs, evt.protectedEntityID);
      }
    } else {
      this.RevokeProtection(evt.protectedEntityID);
    }
    return EntityNotificationType.DoNotNotifyEntity;
  }

  private final func RevokeProtection(entityID: EntityID) {
    if ArrayContains(this.m_protectedEntityIDs, entityID) {
      ArrayRemove(this.m_protectedEntityIDs, entityID);
      this.RequestTargetsAssessment(null);
    }
  }

  public func OnSecurityAreaCrossingPerimeter(evt: SecurityAreaCrossingPerimeter) -> EntityNotificationType {
    let dummyInputEvent: SecuritySystemInput;
    let securityAreaType: ESecurityAreaType;
    let areas: [SecurityAreaControllerPS];
    let mostDangerousArea = this.GetMostDangerousSecurityAreaForEntityID(evt.GetWhoBreached());
    if IsDefined(mostDangerousArea) {
      securityAreaType = mostDangerousArea.GetSecurityAreaType();
    } else if !this.IsSystemInCombat() {
      this.m_securitySystem = null;
    }
    if !evt.GetEnteredState() && this.IsReprimandOngoingAgainst(evt.GetWhoBreached().GetEntityID()) {
      if securityAreaType < ESecurityAreaType.RESTRICTED {
        this.Deescalate(dummyInputEvent);
        this
          .ReleaseCurrentPerformerFromReprimand(
            EReprimandInstructions.CONCLUDE_SUCCESSFUL,
            evt.GetWhoBreached().GetEntityID()
          );
      } else if this.IsDisabled() {
        if !evt.GetEnteredState() {
          PreventionSystem
            .PreventionSecurityAreaEnterRequest(this.GetGameInstance(), false, evt.GetSecurityAreaID());
        }
        return EntityNotificationType.DoNotNotifyEntity;
      } else if evt.GetWhoBreached().IsPlayer() {
        let secData = evt.GetSecurityAreaData();
        ArrayPush(areas, secData.securityArea);
        this
          .RequestTargetsAssessment(this.m_agentsRegistry.GetAgents(areas), evt.GetWhoBreached());
        this.PropagateEventToAgents(evt);
        if evt.GetEnteredState() {
          if securityAreaType > ESecurityAreaType.SAFE && !this.IsPoliceSecuritySystem() {
            PreventionSystem
              .PreventionSecurityAreaEnterRequest(this.GetGameInstance(), true, evt.GetSecurityAreaID());
          }
        }
        PreventionSystem
          .PreventionSecurityAreaEnterRequest(this.GetGameInstance(), false, evt.GetSecurityAreaID());
      }
    }
    dummyInputEvent = new SecuritySystemInput();
    let playerControlledObj = evt.GetWhoBreached() as PlayerPuppet;
    if playerControlledObj != null {
      let modifyOverlapEvent = new ModifyOverlappedSecurityAreas();
      modifyOverlapEvent.isEntering = evt.GetEnteredState();
      modifyOverlapEvent.zoneID = evt.GetSecurityAreaID();
      playerControlledObj.SetSecurityAreaTypeE3HACK(securityAreaType);
      playerControlledObj.QueueEvent(modifyOverlapEvent);
      let securityAreaData = this.GetSecurityDataForArea(mostDangerousArea);
      securityAreaData.entered = evt.GetEnteredState();
      this.UpdateSecurityZoneDataBlackboard(securityAreaData);
      if !evt.GetEnteredState() || securityAreaData.securityAreaType > ESecurityAreaType.SAFE {
        if evt.GetEnteredState() {
          GameInstance
            .GetAudioSystem(this.GetGameInstance())
            .HandleDynamicMixAreaEnter(playerControlledObj);
        } else {
          GameInstance
            .GetAudioSystem(this.GetGameInstance())
            .HandleDynamicMixAreaExit(playerControlledObj);
        }
      }
    }
    return EntityNotificationType.DoNotNotifyEntity;
  }

  private final func OnAgentSpawned(evt: SecurityAgentSpawnedEvent) -> EntityNotificationType {
    if Equals(evt.eventType, gameEntitySpawnerEventType.Spawn) {
      this.AddAgentRecord(evt.spawnedAgent, evt.securityAreas, true);
    } else {
      this.m_agentsRegistry.UnregisterAgent(DeviceLink.GetLinkID(evt.spawnedAgent));
    }
    return EntityNotificationType.DoNotNotifyEntity;
  }

  public const final func HasSupport(agentID: PersistentID) -> Bool {
    let agent: Agent;
    this.m_agentsRegistry.GetAgent(agentID, agent);
    return Agent.HasSupport(agent);
  }

  protected final func OnPlayerSpotted(evt: PlayerSpotted) -> EntityNotificationType {
    let modifiedAgents: [Agent];
    let hasAnySupport: Bool;
    if this
      .m_agentsRegistry
      .ProcessOnPlayerSpotted(evt, modifiedAgents, hasAnySupport) {
      if this.IsSystemInCombat() {
        this.SendSupportEvents(modifiedAgents, false);
      } else if hasAnySupport {
        this.m_securitySystem = this;
      } else if !this.IsSystemInCombat() {
        this.m_securitySystem = null;
      }
    }
    return EntityNotificationType.DoNotNotifyEntity;
  }

  protected final func SendSupportEvents(opt modifiedAgents: [Agent], forceRevokeSupport: Bool) {
    let agents: [Agent];
    if forceRevokeSupport {
      this.m_agentsRegistry.ClearSupport();
    } else if ArraySize(modifiedAgents) > 0 {
      agents = modifiedAgents;
    }
    agents = this.m_agentsRegistry.GetAgents();
    let i = 0;
    while i < ArraySize(agents) {
      let supportEvent = new SecuritySystemSupport();
      supportEvent.supportGranted = Agent.HasSupport(agents[i]);
      this.QueuePSEvent(this.GetPS(agents[i].link), supportEvent);
      i += 1;
    }
  }

  public const final func RequestLatestOutput(id: PersistentID) {
    let agent: Agent;
    let outputs: [SecuritySystemOutput];
    let output: SecuritySystemOutput;
    if !IsDefined(this.m_agentsRegistry) || !this.m_agentsRegistry.GetAgent(id, agent) {
      return;
    }
    let agentAreas = this.GetAgentAreas(id);
    let i = 0;
    while i < ArraySize(agentAreas) {
      output = agentAreas[i].GetLastOutput();
      if IsDefined(output) {
        ArrayPush(outputs, output);
      }
      i += 1;
    }
    i = 0;
    while i < ArraySize(outputs) {
      if outputs[i].GetOriginalInputEvent().GetID() > output.GetOriginalInputEvent().GetID() {
        output = outputs[i];
      }
      i += 1;
    }
    if IsDefined(output) {
      this.QueuePSEvent(this.GetPS(agent.link), output);
    }
  }

  public const final func GetTurrets(
    area: SecurityAreaControllerPS,
    turrets: script_ref<[SecurityTurretControllerPS]>
  ) -> Bool {
    let filter: [SecurityAreaControllerPS];
    let found: Bool;
    ArrayPush(filter, area);
    let agents = this.m_agentsRegistry.GetAgents(filter);
    let i = 0;
    while i < ArraySize(agents) {
      let turret = this.GetPS(agents[i].link) as SecurityTurretControllerPS;
      if IsDefined(turret) {
        ArrayPush(turrets, turret);
        found = true;
      }
      i += 1;
    }
    return found;
  }

  private final func OnSecurityAreaTypeChangedNotification(evt: SecurityAreaTypeChangedNotification) -> EntityNotificationType {
    if Equals(evt.currentType, ESecurityAreaType.SAFE) || Equals(evt.currentType, ESecurityAreaType.DISABLED) {
      if this.ShouldSecuritySystemDisableItself() {
        this.DisableSecuritySystem(evt.wasScheduled);
        return EntityNotificationType.DoNotNotifyEntity;
      } else if Equals(evt.currentType, ESecurityAreaType.DISABLED) {
        this.HandleAreaBeingDisabled(evt.area);
      } else if Equals(evt.previousType, ESecurityAreaType.DISABLED) {
        if this.IsDisabled() {
          this.OnQuestForceON(this.ActionQuestForceON());
        }
        this.HandleAreaBeingEnabled(evt.area);
      }
    }
    this.RequestTargetsAssessment(null);
    return EntityNotificationType.DoNotNotifyEntity;
  }

  private final func HandleAreaBeingEnabled(area: SecurityAreaControllerPS) {
    let slaves: [DeviceComponentPS];
    if IsDefined(this.m_agentsRegistry) {
      area.GetChildren(slaves);
      this.m_agentsRegistry.AddArea(area, slaves);
    } else {
      this.InitiateAgentRegistry();
    }
  }

  private final func HandleAreaBeingDisabled(area: SecurityAreaControllerPS) {
    let updateData: OnDisableAreaData;
    let dataArray: [OnDisableAreaData];
    let filter: [SecurityAreaControllerPS];
    if !IsDefined(this.m_agentsRegistry) {
      return;
    }
    ArrayPush(filter, area);
    let affectedAgents = this.m_agentsRegistry.GetAgents(filter);
    let i = 0;
    while i < ArraySize(affectedAgents) {
      updateData.agent = DeviceLink.GetLinkID(affectedAgents[i].link);
      updateData.remainingAreas = this.GetPS(affectedAgents[i]).GetSecurityAreas();
      ArrayPush(dataArray, updateData);
      i += 1;
    }
    this.m_agentsRegistry.RemoveArea(dataArray);
  }

  private final func DisableSecuritySystem(wasScheduled: Bool) {
    let securityAreaData: SecurityAreaData;
    let transition: AreaTypeTransition;
    this.SetSecurityState(ESecuritySystemState.UNINITIALIZED);
    this.DisableDevice();
    transition.transitionTo = ESecurityAreaType.DISABLED;
    transition.transitionMode = ETransitionMode.FORCED;
    let areas = this.GetSecurityAreas();
    let i = 0;
    while i < ArraySize(areas) {
      let disableArea = new QuestExecuteTransition();
      disableArea.transition = transition;
      PreventionSystem
        .PreventionSecurityAreaEnterRequest(this.GetGameInstance(), false, areas[i].GetID());
      this.QueuePSEvent(areas[i], disableArea);
      if !wasScheduled {
        this.QueuePSEvent(areas[i], new PurgeAllTransitions());
      }
      i += 1;
    }
    let agents = this.m_agentsRegistry.GetAgents();
    this.SendSupportEvents(true);
    i = 0;
    while i < ArraySize(agents) {
      let ps = this.GetPS(agents[i].link);
      if IsDefined(ps) {
        this.QueuePSEvent(ps, new SecuritySystemDisabled());
      }
      i += 1;
    }
    securityAreaData.securityAreaType = ESecurityAreaType.DISABLED;
    securityAreaData.accessLevel = ESecurityAccessLevel.ESL_NONE;
    this.UpdateSecurityZoneDataBlackboard(securityAreaData);
    this.CleanSecuritySystemMemory();
    this.GetPersistencySystem().ForgetObject(this.GetID(), false);
  }

  private final func ShouldSecuritySystemDisableItself() -> Bool {
    let areas = this.GetSecurityAreas();
    if !this.m_allowSecuritySystemToDisableItself || this.IsDisabled() && ArraySize(areas) == 0 {
      return false;
    }
    let i = 0;
    while i < ArraySize(areas) {
      if NotEquals(areas[i].GetSecurityAreaType(), ESecurityAreaType.SAFE) {
        return false;
      }
      i += 1;
    }
    return true;
  }

  protected const final func ProcessBreachNotificationWithRecipientsList(
    const addresseeList: script_ref<[EntityID]>,
    securitySystemInput: SecuritySystemInput
  ) {
    securitySystemInput.AttachCustomRecipientsList(addresseeList);
    this.QueuePSEvent(this.GetID(), this.GetClassName(), securitySystemInput);
  }

  public const final func ReportPotentialSituation(input: SecuritySystemInput) -> Bool {
    this.m_inputsReceived += 1;
    let puppetTarget = input.GetWhoBreached() as ScriptedPuppet;
    if IsDefined(puppetTarget) && (puppetTarget.IsCharacterCivilian() || !puppetTarget.IsActive()) {
      return false;
    } else if this.IsRestarting() || this.IsUnpowered() || this.IsDisabled() {
      return false;
    }
    return this.ProcessInput(input);
  }

  private const final func ProcessInput(input: SecuritySystemInput) -> Bool {
    let forward: Bool;
    if Equals(input.GetNotificationType(), ESecurityNotificationType.ALARM)
      || Equals(input.GetNotificationType(), ESecurityNotificationType.DEVICE_DESTROYED) {
      forward = true;
    } else {
      let relation = this.GetAttitudeTowards(input.GetWhoBreached());
      if Equals(relation, EAIAttitude.AIA_Friendly) {
        forward = this.ProcessFriendly(input);
      } else if Equals(relation, EAIAttitude.AIA_Hostile)
        || Equals(input.GetNotificationType(), ESecurityNotificationType.COMBAT)
        || this
          .IsEntityBlacklistedForAtLeast(input.GetWhoBreached().GetEntityID(), BlacklistReason.COMBAT) {
        forward = this.ProcessHostile();
      } else {
        forward = this.ProcessNeutral(input);
      }
    }
    if forward {
      GameInstance
        .GetPersistencySystem(this.GetGameInstance())
        .QueuePSEvent(this.GetID(), this.GetClassName(), input);
      return true;
    }
    return false;
  }

  private const final func ProcessHostile() -> Bool {
    if this.IsRefreshRequired() || NotEquals(this.m_securitySystemState, ESecuritySystemState.COMBAT) {
      return true;
    }
    return false;
  }

  private const final func ProcessNeutral(input: SecuritySystemInput) -> Bool {
    if this.IsNotificationValid(input) {
      let isReprimandOngoing = this.IsReprimandOngoing();
      if this.IsRefreshRequired()
        || Equals(input.GetNotificationType(), ESecurityNotificationType.COMBAT)
        || isReprimandOngoing
          && Equals(
            input.GetNotificationType(),
            ESecurityNotificationType.REPRIMAND_SUCCESSFUL
          )
        || isReprimandOngoing
          && Equals(
            input.GetNotificationType(),
            ESecurityNotificationType.REPRIMAND_ESCALATE
          )
        || !isReprimandOngoing && input.CanPerformReprimand()
        || NotEquals(
          this.m_securitySystemState,
          this.DetermineSecuritySystemState(input, true)
        ) {
        return true;
      }
      return false;
    }
    return false;
  }

  private const final func ProcessFriendly(input: SecuritySystemInput) -> Bool {
    return this.IsReprimandOngoingAgainst(input.GetWhoBreached().GetEntityID());
  }

  private const final func IsRefreshRequired() -> Bool {
    let currentTime = EngineTime.ToFloat(GameInstance.GetSimTime(this.GetGameInstance()));
    if currentTime - this.m_latestOutputEngineTime > this.m_updateInterval {
      return true;
    }
    return false;
  }

  public final func OnSecuritySystemInput(evt: SecuritySystemInput) -> EntityNotificationType {
    this.HandleSecuritySystemInputByTask(evt);
    return EntityNotificationType.DoNotNotifyEntity;
  }

  private final func HandleSecuritySystemInput(evt: SecuritySystemInput) {
    if evt.GetNotificationType() > ESecurityNotificationType.REPRIMAND_ESCALATE {
      let i = 0;
      if i < ArraySize(this.m_protectedEntityIDs) {
        if this.m_protectedEntityIDs[i] == evt.GetWhoBreached().GetEntityID() {
          this.RevokeProtection(evt.GetWhoBreached().GetEntityID());
        } else {
          i += 1;
        }
      }
    }
    this.ResolveNotificationImmediately(evt);
  }

  public const final func GetValidRecipients(input: SecuritySystemInput) -> [SecuritySystemOutputData] {
    let breachedAreas: [SecurityAreaControllerPS];
    let notifier = input.GetNotifierHandle();
    let secSysNotifier = notifier as SecuritySystemControllerPS;
    if Equals(input.GetNotificationType(), ESecurityNotificationType.QUEST) && IsDefined(secSysNotifier) && secSysNotifier == this {
      breachedAreas = this.GetSecurityAreas();
    } else if IsDefined(notifier as SecurityGateControllerPS)
      || Equals(input.GetNotificationType(), ESecurityNotificationType.ALARM)
      || Equals(input.GetNotificationType(), ESecurityNotificationType.DEVICE_DESTROYED) {
      breachedAreas = this.GetAgentAreas(notifier.GetID());
    } else {
      breachedAreas = this.GetOverlappingAreas(input);
    }
    if Equals(input.GetNotificationType(), ESecurityNotificationType.COMBAT)
      || Equals(this.GetAttitudeTowards(input.GetWhoBreached()), EAIAttitude.AIA_Hostile) {
      let areasOfAgentInCombat = this.GetAgentAreas(notifier.GetID());
      let i = 0;
      while i < ArraySize(areasOfAgentInCombat) {
        if ArrayContains(breachedAreas, areasOfAgentInCombat[i]) {
        }
        ArrayPush(breachedAreas, areasOfAgentInCombat[i]);
        i += 1;
      }
    }
    let recipients = this.m_agentsRegistry.GetValidAgents(this.GetSecurityState(), breachedAreas);
    return recipients;
  }

  private final func ProduceOutput(input: SecuritySystemInput, securityStateChanged: Bool) {
    let i: Int32;
    let closestDistance: Float;
    let agentData: AgentDistanceToTarget;
    let agentsData: [AgentDistanceToTarget];
    this.m_outputsSend += 1;
    let output = new SecuritySystemOutput();
    output = this.ActionSecuritySystemBreachResponse(input);
    output.SetSecurityStateChanged(securityStateChanged);
    if input.HasCustomRecipients() {
      output.SetBreachOrigin(EBreachOrigin.LOCAL);
      this.SendResponseToCustomRecipients(output);
      return;
    }
    let recipients = this.GetValidRecipients(input);
    if Equals(input.GetNotificationType(), ESecurityNotificationType.DEVICE_DESTROYED) {
      i = 0;
      while i < ArraySize(recipients) {
        if recipients[i].delayDuration > 0.0 {
          let ent = GameInstance
            .FindEntityByID(
              this.GetGameInstance(),
              PersistentID.ExtractEntityID(DeviceLink.GetLinkID(recipients[i].link))
            );
          if IsDefined(ent) {
            agentData.distance = Vector4.DistanceSquared(ent.GetWorldPosition(), input.GetLastKnownPosition());
            agentData.index = i;
            ArrayPush(agentsData, agentData);
          }
        }
        i += 1;
      }
      i = 0;
      while i < ArraySize(agentsData) {
        if closestDistance > agentsData[i].distance {
          closestDistance = agentsData[i].distance;
          let closestIndex = agentsData[i].index;
        }
        i += 1;
      }
      this.QueuePSEvent(this.GetPS(recipients[closestIndex].link), output);
      ArrayErase(recipients, closestIndex);
    }
    i = 0;
    while i < ArraySize(recipients) {
      output = new SecuritySystemOutput();
      output = this.ActionSecuritySystemBreachResponse(input);
      output.SetSecurityStateChanged(securityStateChanged);
      output.SetBreachOrigin(recipients[i].breachOrigin);
      if recipients[i].delayDuration > 0.0 {
        GameInstance
          .GetDelaySystem(this.GetGameInstance())
          .DelayPSEvent(
            DeviceLink.GetLinkID(recipients[i].link),
            DeviceLink.GetLinkClassName(recipients[i].link),
            output,
            recipients[i].delayDuration
          );
      } else {
        this.QueuePSEvent(this.GetPS(recipients[i].link), output);
      }
      i += 1;
    }
    this.m_latestOutputEngineTime = EngineTime.ToFloat(GameInstance.GetSimTime(this.GetGameInstance()));
    let secAreas = this.GetSecurityAreas(true);
    i = 0;
    while i < ArraySize(secAreas) {
      output = new SecuritySystemOutput();
      output = this.ActionSecuritySystemBreachResponse(input);
      output.SetSecurityStateChanged(securityStateChanged);
      output.SetBreachOrigin(EBreachOrigin.EXTERNAL);
      this.QueuePSEvent(secAreas[i], output);
      i += 1;
    }
    this.NotifyParents();
  }

  private final func ResolveNotificationImmediately(evt: SecuritySystemInput) {
    let desiredSecurityState = this.DetermineSecuritySystemState(evt);
    if this.IsSystemSafe() && Equals(desiredSecurityState, ESecuritySystemState.SAFE) {
      if Equals(evt.GetNotificationType(), ESecurityNotificationType.DEVICE_DESTROYED) {
        this.SetSecurityStateAndTriggerResponse(desiredSecurityState, evt);
      }
      return;
    } else if Equals(desiredSecurityState, ESecuritySystemState.COMBAT) {
      let notifiedSecSysAboutCombat = new NotifiedSecSysAboutCombat();
      this.QueuePSEvent(evt.GetNotifierHandle(), notifiedSecSysAboutCombat);
    } else if Equals(desiredSecurityState, ESecuritySystemState.ALERTED) || Equals(desiredSecurityState, ESecuritySystemState.COMBAT) {
      this.InitiateAutomaticDeescalationEvent(evt);
    }
    this.ResolveReprimand(evt, desiredSecurityState);
    if this.IsReprimandOngoing() {
      return;
    }
    this.SetSecurityStateAndTriggerResponse(desiredSecurityState, evt);
  }

  public const final func DetermineSecuritySystemState(evt: SecuritySystemInput, opt isSimulation: Bool) -> ESecuritySystemState {
    if Equals(this.GetAttitudeTowards(evt.GetWhoBreached()), EAIAttitude.AIA_Hostile) {
      if !isSimulation {
        if !IsFinal() {
        }
      }
      return ESecuritySystemState.COMBAT;
    } else if this
      .HasEntityBeenSpottedTooManyTimes(evt.GetNotifierHandle().GetID(), evt.GetWhoBreached(), evt.GetNotificationType()) {
      if !isSimulation {
        if !IsFinal() {
        }
      }
      return ESecuritySystemState.COMBAT;
    } else if this.IsEntityBlacklistedForAtLeast(evt.GetWhoBreached(), BlacklistReason.COMBAT) {
      if !isSimulation {
        if !IsFinal() {
        }
      }
      return ESecuritySystemState.COMBAT;
    }
    switch this.m_securitySystemState {
      case ESecuritySystemState.SAFE:
        return this.ResolveTransitionFromSafe(evt, isSimulation);
      case ESecuritySystemState.ALERTED:
        return this.ResolveTransitionFromAlerted(evt, isSimulation);
      case ESecuritySystemState.COMBAT:
        return this.ResolveTransitionFromCombat(evt, isSimulation);
    }
    return ESecuritySystemState.UNINITIALIZED;
  }

  private const final func ResolveTransitionFromSafe(evt: SecuritySystemInput, opt isSimulation: Bool) -> ESecuritySystemState {
    let logMessage = "Resolving transition from safe: ";
    if this
      .HasEntityBeenSpottedTooManyTimes(evt.GetNotifierHandle().GetID(), evt.GetWhoBreached(), evt.GetNotificationType()) {
      logMessage += "and entity was already blacklisted for reprimand. Result: COMBAT";
      if !IsFinal() {
      }
      return ESecuritySystemState.COMBAT;
    } else if Equals(evt.GetNotificationType(), ESecurityNotificationType.SECURITY_GATE) {
      logMessage += "Security Gate breached. Security Gate set to: REPRIMAND";
      if !IsFinal() {
      }
      return ESecuritySystemState.ALERTED;
    } else if Equals(evt.GetNotificationType(), ESecurityNotificationType.ALARM) {
      logMessage += "Someone is requesting ALARM";
      if !IsFinal() {
      }
      return ESecuritySystemState.ALERTED;
    }
    let breachedAreaType = this.DetermineSecurityAreaTypeForEntityID(evt.GetWhoBreached().GetEntityID());
    if Equals(breachedAreaType, ESecurityAreaType.DANGEROUS) || Equals(evt.GetNotificationType(), ESecurityNotificationType.COMBAT) {
      logMessage
        += "breached area = dangerous or notification type = combat. Result: COMBAT";
      if !IsFinal() {
      }
      return ESecuritySystemState.COMBAT;
    } else if Equals(breachedAreaType, ESecurityAreaType.RESTRICTED) {
      logMessage += "breached area = restricted ";
      logMessage += "Result: ALERTED";
      if !IsFinal() {
      }
      return ESecuritySystemState.ALERTED;
    } else if Equals(breachedAreaType, ESecurityAreaType.SAFE) {
      logMessage += "breached area = safe ";
      if Equals(evt.GetNotificationType(), ESecurityNotificationType.ILLEGAL_ACTION)
        || Equals(evt.GetNotificationType(), ESecurityNotificationType.SECURITY_GATE) {
        logMessage += "and illegal action spotted. Result: ALERTED";
        if !IsFinal() {
        }
        return ESecuritySystemState.ALERTED;
      }
    }
    logMessage += "Result: SAFE";
    if !IsFinal() {
    }
    return ESecuritySystemState.SAFE;
  }

  private const final func ResolveTransitionFromAlerted(evt: SecuritySystemInput, opt isSimulation: Bool) -> ESecuritySystemState {
    let logMessage = "Resolving transition from alerted: ";
    let breachedAreaType = this.DetermineSecurityAreaTypeForEntityID(evt.GetWhoBreached().GetEntityID());
    if Equals(breachedAreaType, ESecurityAreaType.DANGEROUS) || Equals(evt.GetNotificationType(), ESecurityNotificationType.COMBAT) {
      if !isSimulation {
        logMessage
          += "breached area = dangerous or notification type = combat. Result: COMBAT";
        if !IsFinal() {
        }
      }
      return ESecuritySystemState.COMBAT;
    } else if this.IsReprimandOngoing() {
      if Equals(evt.GetNotificationType(), ESecurityNotificationType.REPRIMAND_SUCCESSFUL) {
        if !isSimulation {
          logMessage += "reprimand successful. Result: SAFE";
          if !IsFinal() {
          }
        }
        return ESecuritySystemState.SAFE;
      } else if Equals(evt.GetNotificationType(), ESecurityNotificationType.ILLEGAL_ACTION) {
        if !isSimulation {
          logMessage += "and illegal action spotted. Result: COMBAT";
          if !IsFinal() {
          }
        }
        return ESecuritySystemState.COMBAT;
      } else if !isSimulation {
        logMessage += "Result: ALERTED";
        if !IsFinal() {
        }
      }
      return ESecuritySystemState.ALERTED;
    }
    break;
    if this.IsEntityBlacklistedForAtLeast(evt.GetWhoBreached(), BlacklistReason.COMBAT) || Equals(evt.GetNotificationType(), ESecurityNotificationType.ILLEGAL_ACTION) {
      if !isSimulation {
        logMessage
          += "entity was already blacklisted for combat or illegal action noticed. Result: COMBAT";
        if !IsFinal() {
        }
      }
      return ESecuritySystemState.COMBAT;
    }
    if !isSimulation {
      logMessage += "Result: ALERTED";
      if !IsFinal() {
      }
    }
    return ESecuritySystemState.ALERTED;
  }

  private const final func ResolveTransitionFromCombat(evt: SecuritySystemInput, opt isSimulation: Bool) -> ESecuritySystemState {
    let logMessage = "Resolving transition from combat: ";
    if evt.GetNotificationType() > ESecurityNotificationType.DEESCALATE {
      if !isSimulation {
        logMessage += "notification is not about deescalating. Result: COMBAT";
        if !IsFinal() {
        }
      }
      return ESecuritySystemState.COMBAT;
    }
    logMessage += "checking if deescalation is possible...";
    let i = 0;
    while i < ArraySize(this.m_blacklist) {
      if this.IsUserInsideSystem(this.m_blacklist[i].GetEntityID()) && Equals(this.m_blacklist[i].GetReason(), BlacklistReason.COMBAT) {
        if !isSimulation {
          logMessage
            += " entity still within system and blacklisted for combat. Result: COMBAT";
          if !IsFinal() {
          }
        }
        return ESecuritySystemState.COMBAT;
      }
      i += 1;
    }
    if !isSimulation {
      logMessage += "entity left system vicinity. Result: ALERTED";
      if !IsFinal() {
      }
    }
    return ESecuritySystemState.ALERTED;
  }

  private final func ResolveReprimand(evt: SecuritySystemInput, determinedState: ESecuritySystemState) -> Bool {
    if !IsDefined(evt.GetWhoBreached()) {
      return false;
    } else if !evt.GetWhoBreached().IsActive() {
      return false;
    }
    let target = evt.GetWhoBreached().GetEntityID();
    if Equals(determinedState, ESecuritySystemState.COMBAT) {
      this
        .ReleaseCurrentPerformerFromReprimand(EReprimandInstructions.CONCLUDE_FAILED, target);
      return true;
    } else if Equals(determinedState, ESecuritySystemState.SAFE) {
      this
        .ReleaseCurrentPerformerFromReprimand(EReprimandInstructions.CONCLUDE_SUCCESSFUL, target);
      return true;
    } else if Equals(evt.GetNotificationType(), ESecurityNotificationType.REPRIMAND_SUCCESSFUL) {
      this
        .ReleaseCurrentPerformerFromReprimand(EReprimandInstructions.CONCLUDE_SUCCESSFUL, target);
      return true;
    } else if !evt.CanPerformReprimand() {
      return false;
    } else if this
      .HasEntityBeenSpottedTooManyTimes(evt.GetNotifierHandle().GetID(), evt.GetWhoBreached(), evt.GetNotificationType()) {
      return false;
    } else if !this.IsReprimandOngoing() {
      this.m_currentReprimandID += 1;
      this.SetReprimandPerformer(evt, EReprimandInstructions.INITIATE_FIRST);
      return true;
    }
    break;
    if IsDefined(this.GetReprimandPerformer(evt.GetWhoBreached().GetEntityID()) as Device) && evt.GetNotifierHandle().IsPuppet() {
      this.SetReprimandPerformer(evt, EReprimandInstructions.TAKEOVER);
      return true;
    }
    if Equals(evt.GetNotificationType(), ESecurityNotificationType.REPRIMAND_ESCALATE) {
      this.m_currentReprimandID += 1;
      this.SetReprimandPerformer(evt, EReprimandInstructions.INITIATE_FIRST);
      return true;
    }
    return false;
  }

  private final func SetSecurityStateAndTriggerResponse(
    newState: ESecuritySystemState,
    evt: SecuritySystemInput,
    opt isComingFromQuest: Bool
  ) -> Bool {
    let changed: Bool;
    if NotEquals(this.m_securitySystemState, newState) {
      changed = true;
      this.RequestTargetsAssessment(evt.GetWhoBreached());
      if this.m_isUnderStrictQuestControl && NotEquals(evt.GetNotificationType(), ESecurityNotificationType.QUEST) {
        if !IsFinal() {
        }
        this.ProduceOutput(evt, changed);
        return false;
      } else if Equals(newState, ESecuritySystemState.SAFE) && this.m_securitySystemState > ESecuritySystemState.SAFE {
        this.RemoveFromBlacklist(evt.GetWhoBreached());
      } else if Equals(newState, ESecuritySystemState.ALERTED) && this.m_securitySystemState < ESecuritySystemState.ALERTED {
        this.BlacklistEntityID(evt.GetWhoBreached(), BlacklistReason.TRESPASSING);
      } else if Equals(newState, ESecuritySystemState.COMBAT) {
        this.BlacklistEntityID(evt.GetWhoBreached(), BlacklistReason.COMBAT);
      } else if !IsFinal() {
        if IsDefined(evt.GetNotifierHandle()) {
        }
      }
      this.SetSecurityState(newState, evt, isComingFromQuest);
    }
    this.ProduceOutput(evt, changed);
    return changed;
  }

  private const final func SendResponseToCustomRecipients(response: SecuritySystemOutput) {
    let recipientsIDs = response.GetOriginalInputEvent().GetCustomRecipientsList();
    let i = 0;
    while i < ArraySize(recipientsIDs) {
      GameInstance
        .GetPersistencySystem(this.GetGameInstance())
        .QueuePSEvent(Cast<PersistentID>(recipientsIDs[i]), n"ScriptedPuppetPS", response);
      i += 1;
    }
  }

  private final func RequestTargetsAssessment(opt providedAgents: [Agent], target: GameObject) {
    let agents: [Agent];
    let request = new TargetAssessmentRequest();
    if ArraySize(providedAgents) > 0 {
      agents = providedAgents;
    } else {
      agents = this.m_agentsRegistry.GetAgents();
    }
    if IsDefined(target) {
      request.targetToAssess = target;
    }
    let i = 0;
    while i < ArraySize(agents) {
      this.QueuePSEvent(this.GetPS(agents[i].link), request);
      i += 1;
    }
  }

  public const final func PropagateEventToAgents(evt: Event) {
    let agents = this.m_agentsRegistry.GetAgents();
    let i = 0;
    while i < ArraySize(agents) {
      this.QueuePSEvent(this.GetPS(agents[i].link), evt);
      i += 1;
    }
  }

  private const final func IsNotificationValid(evt: SecuritySystemInput) -> Bool {
    if IsDefined(this.m_agentsRegistry)
      && this
        .m_agentsRegistry
        .IsAgent(Cast<PersistentID>(evt.GetWhoBreached().GetEntityID())) {
      return false;
    } else if evt.GetNotificationType() >= ESecurityNotificationType.REPRIMAND_ESCALATE {
      return true;
    } else if this
      .IsEntityBlacklistedForAtLeast(evt.GetWhoBreached().GetEntityID(), BlacklistReason.COMBAT) {
      return true;
    } else if Equals(evt.GetNotificationType(), ESecurityNotificationType.REPRIMAND_SUCCESSFUL) {
      return true;
    } else if Equals(this.m_securitySystemState, ESecuritySystemState.SAFE)
      && Equals(evt.GetNotificationType(), ESecurityNotificationType.ALARM)
      || Equals(evt.GetNotificationType(), ESecurityNotificationType.DEVICE_DESTROYED) {
      return true;
    } else if this.IsReprimandOngoingAgainst(evt.GetWhoBreached().GetEntityID()) {
      return true;
    } else if evt.GetNotificationType() <= ESecurityNotificationType.REPRIMAND_ESCALATE {
      let i = 0;
      if i < ArraySize(this.m_protectedEntityIDs) {
        if this.m_protectedEntityIDs[i] == evt.GetWhoBreached().GetEntityID() {
          return false;
        }
        i += 1;
      }
    }
    let commonAreas = this
      .GetOverlappingAreas(
        this.GetAgentAreas(evt.GetNotifierHandle().GetID()),
        this.GetSecurityAreasWithUserInside(evt.GetWhoBreached().GetEntityID())
      );
    let breachLevel = this.FindHighestSecurityAccessLevel(commonAreas);
    return !this.IsUserAuthorized(evt.GetWhoBreached().GetEntityID(), breachLevel);
  }

  private const final func GetOverlappingAreas(input: SecuritySystemInput) -> [SecurityAreaControllerPS] {
    let empty: [SecurityAreaControllerPS];
    if !IsDefined(input.GetNotifierHandle()) {
      return empty;
    } else if !IsDefined(input.GetWhoBreached()) {
      return empty;
    }
    return this
      .GetOverlappingAreas(
        this.GetAgentAreas(input.GetNotifierHandle().GetID()),
        this.GetSecurityAreasWithUserInside(input.GetWhoBreached().GetEntityID())
      );
  }

  private const final func GetOverlappingAreas(
    const bunch1: script_ref<[SecurityAreaControllerPS]>,
    const bunch2: script_ref<[SecurityAreaControllerPS]>
  ) -> [SecurityAreaControllerPS] {
    let bunch3: [SecurityAreaControllerPS];
    if ArraySize(bunch1) == 0 || ArraySize(bunch2) == 0 {
      return bunch3;
    }
    let i = 0;
    while i < ArraySize(bunch1) {
      if !IsDefined(bunch1[i]) {
      } else {
        let k = 0;
        if k < ArraySize(bunch2) {
          if !IsDefined(bunch2[k]) {
          } else if Equals(bunch1[i].GetID(), bunch2[k].GetID()) {
            ArrayPush(bunch3, bunch1[i]);
          } else {
            k += 1;
          }
        }
      }
      i += 1;
    }
    return bunch3;
  }

  private const final func IsSystemClean() -> Bool {
    let areas = this.GetSecurityAreas();
    let i = 0;
    while i < ArraySize(this.m_blacklist) {
      let k = 0;
      while k < ArraySize(areas) {
        if areas[k].IsUserInside(this.m_blacklist[i].GetEntityID()) {
          return false;
        }
        k += 1;
      }
      i += 1;
    }
    return true;
  }

  private final func SetReprimandPerformer(evt: SecuritySystemInput, instructions: EReprimandInstructions) {
    if !IsDefined(evt.GetNotifierHandle()) {
      return;
    }
    let target = evt.GetWhoBreached().GetEntityID();
    if Equals(instructions, EReprimandInstructions.TAKEOVER) {
      this
        .ReleaseCurrentPerformerFromReprimand(EReprimandInstructions.RELEASE_TO_ANOTHER_ENTITY, target);
    }
    this.BlacklistEntityID(target, BlacklistReason.REPRIMAND);
    if Equals(instructions, EReprimandInstructions.INITIATE_FIRST) {
      let i = 0;
      if i < ArraySize(this.m_blacklist) {
        if this.m_blacklist[i].GetEntityID() == target {
          let globalWarningsCount = this.m_blacklist[i].GetWarningsCount();
        } else {
          i += 1;
        }
      } else if this
        .m_agentsRegistry
        .HowManyTimesEntityReprimandedByThisAgentAlready(target, evt.GetNotifierHandle().GetID()) > 0 || globalWarningsCount == this.m_maxGlobalWarningsCount - 1 {
        instructions = EReprimandInstructions.INITIATE_SUCCESSIVE;
      }
    }
    this
      .m_agentsRegistry
      .StoreReprimand(
        evt.GetNotifierHandle().GetID(),
        target,
        this.m_currentReprimandID,
        this.GetAttitudeSystem().GetAttitudeGroup(target)
      );
    let reprimandUpdate = ReprimandUpdate
      .Construct(
        evt.GetNotifierHandle().GetOwnerEntityWeak() as GameObject,
        target,
        instructions,
        evt.GetLastKnownPosition()
      );
    this.SendReprimandEvent(reprimandUpdate);
  }

  private final func ReleaseAllReprimands() {
    let agents: [Agent];
    this.m_agentsRegistry.ReleaseAllReprimands(agents);
    let i = 0;
    while i < ArraySize(agents) {
      let reprimandUpdate = ReprimandUpdate
        .Construct(
          this.GetPS(agents[i].link).GetOwnerEntityWeak() as GameObject,
          Agent.GetReprimandReceiver(agents[i]),
          EReprimandInstructions.CONCLUDE_SUCCESSFUL
        );
      this.SendReprimandEvent(reprimandUpdate);
      i += 1;
    }
  }

  private final func ReleaseCurrentPerformerFromReprimand(instructions: EReprimandInstructions, target: EntityID) {
    let agent: Agent;
    if !this.IsReprimandOngoing() {
      return;
    } else if Equals(instructions, EReprimandInstructions.INITIATE_FIRST)
      || Equals(instructions, EReprimandInstructions.INITIATE_SUCCESSIVE)
      || Equals(instructions, EReprimandInstructions.TAKEOVER) {
      if !IsFinal() {
      }
      return;
    } else if Equals(instructions, EReprimandInstructions.CONCLUDE_SUCCESSFUL) {
    } else if this.m_agentsRegistry.GetReprimandPerformer(target, agent) {
      let agentGO = this.GetPS(agent.link).GetOwnerEntityWeak() as GameObject;
      let reprimandUpdate = ReprimandUpdate.Construct(agentGO, target, instructions);
      this.SendReprimandEvent(reprimandUpdate);
      this
        .m_agentsRegistry
        .ReleaseFromReprimandAgainst(target, DeviceLink.GetLinkID(agent.link));
    }
  }

  private final func SendReprimandEvent(evt: ReprimandUpdate) {
    let performer = evt.currentPerformer.GetEntityID();
    if EntityID.IsDefined(performer) {
      this.QueueEntityEvent(performer, evt);
    }
  }

  private const final func ResolvePotentialDeescalation() -> Bool {
    let dummyInputEvent = new SecuritySystemInput();
    if this.IsReprimandOngoing() {
      return false;
    } else if this.IsSystemSafeOrUninitialized() {
      return false;
    } else if this.IsSystemClean() {
      this.Deescalate(dummyInputEvent);
      return true;
    }
    return false;
  }

  private final func InitiateAutomaticDeescalationEvent(evt: SecuritySystemInput) {
    this.CancelAutomaticDeescalationEvent();
    let autoDeescalate = new AutomaticDeescalationEvent();
    autoDeescalate.originalNotification = evt;
    this.m_deescalationEventID = GameInstance
      .GetDelaySystem(this.GetGameInstance())
      .DelayPSEvent(this.GetID(), this.GetClassName(), autoDeescalate, 25.0);
    this.m_delayIDValid = true;
  }

  private final func CancelAutomaticDeescalationEvent() {
    if !this.m_delayIDValid {
      return;
    }
    GameInstance
      .GetDelaySystem(this.GetGameInstance())
      .CancelDelay(this.m_deescalationEventID);
    GameInstance
      .GetDelaySystem(this.GetGameInstance())
      .CancelCallback(this.m_deescalationEventID);
    this.m_delayIDValid = false;
  }

  public final func OnAutomaticDeescalationEvent(evt: AutomaticDeescalationEvent) -> EntityNotificationType {
    if this.IsSystemSafeOrUninitialized() {
      return EntityNotificationType.DoNotNotifyEntity;
    } else if this.IsReprimandOngoing() {
      this.InitiateAutomaticDeescalationEvent(evt.originalNotification);
      return EntityNotificationType.DoNotNotifyEntity;
    } else if !this.IsSystemClean() {
      this.InitiateAutomaticDeescalationEvent(evt.originalNotification);
      return EntityNotificationType.DoNotNotifyEntity;
    }
    this.Deescalate(evt.originalNotification);
    return EntityNotificationType.DoNotNotifyEntity;
  }

  private const final func Deescalate(evt: SecuritySystemInput) {
    let deescalationEvent = new DeescalationEvent();
    deescalationEvent.originalNotification = evt;
    this.QueuePSEvent(this.GetID(), this.GetClassName(), deescalationEvent);
  }

  private final func OnDeescalation(evt: DeescalationEvent) -> EntityNotificationType {
    if this.IsSystemSafeOrUninitialized() {
      this.ProduceOutput(evt.originalNotification, false);
      return EntityNotificationType.DoNotNotifyEntity;
    } else if Equals(this.m_securitySystemState, ESecuritySystemState.COMBAT) {
      let i = 0;
      if i < ArraySize(this.m_blacklist) {
        if this.IsUserInsideSystem(this.m_blacklist[i].GetEntityID()) {
          this.InitiateAutomaticDeescalationEvent(evt.originalNotification);
          return EntityNotificationType.DoNotNotifyEntity;
        }
        i += 1;
      } else if !IsFinal() {
      }
    }
    let newState = IntEnum<ESecuritySystemState>(EnumInt(this.m_securitySystemState) - 1);
    this.SetSecurityStateAndTriggerResponse(newState, evt.originalNotification);
    if NotEquals(this.m_securitySystemState, ESecuritySystemState.SAFE) {
      this.InitiateAutomaticDeescalationEvent(evt.originalNotification);
    }
    return EntityNotificationType.DoNotNotifyEntity;
  }

  private final func BlacklistEntityID(entityID: EntityID, reason: BlacklistReason) {
    if !EntityID.IsDefined(entityID) {
      return;
    }
    let newEntry = new BlacklistEntry();
    newEntry.Initialize(entityID, reason, this.m_currentReprimandID);
    let blacklistedEntityIndex = this.GetEntityBlacklistIndex(entityID);
    if this.IsPlayersEntityID(entityID) {
      let addToBlacklistEvent = new AddToBlacklistEvent();
      addToBlacklistEvent.entityIDToAdd = entityID;
      addToBlacklistEvent.isPlayerEntity = true;
      addToBlacklistEvent.reason = reason;
      this.PropagateEventToAgents(addToBlacklistEvent);
    } else if blacklistedEntityIndex >= 0 {
      if this
        .m_blacklist[blacklistedEntityIndex]
        .UpdateBlacklistEntry(reason, this.m_currentReprimandID) {
        this.TriggerBlacklistWipeCountdown(entityID);
      }
    }
    this.TriggerBlacklistWipeCountdown(entityID);
    ArrayPush(this.m_blacklist, newEntry);
    this.TryUpdateBlackboardAreaDataFor(entityID);
  }

  private final func TriggerBlacklistWipeCountdown(entityID: EntityID) {
    if !this.IsPlayersEntityID(entityID) {
      return;
    }
    this.ResetBlacklistWipeCountdown(entityID);
    let blacklistWipe = new BlacklistPeriodEnded();
    blacklistWipe.entityID = entityID;
    this.m_blacklistDelayID = GameInstance
      .GetDelaySystem(this.GetGameInstance())
      .DelayPSEvent(this.GetID(), this.GetClassName(), blacklistWipe, 300.0, true);
    this.m_blacklistDelayValid = true;
  }

  private final func ResetBlacklistWipeCountdown(entityID: EntityID) {
    if !this.m_blacklistDelayValid || !this.IsPlayersEntityID(entityID) {
      return;
    }
    GameInstance
      .GetDelaySystem(this.GetGameInstance())
      .CancelCallback(this.m_blacklistDelayID);
    GameInstance.GetDelaySystem(this.GetGameInstance()).CancelDelay(this.m_blacklistDelayID);
    this.m_blacklistDelayValid = false;
    this.m_blacklistDelayID = new DelayID();
  }

  private final func OnBlacklistPeriodEnded(evt: BlacklistPeriodEnded) -> EntityNotificationType {
    if !this.m_blacklistDelayValid {
      return EntityNotificationType.DoNotNotifyEntity;
    }
    this.m_blacklistDelayValid = false;
    this.m_blacklistDelayID = new DelayID();
    this.RemoveFromBlacklist(evt.entityID);
    return EntityNotificationType.DoNotNotifyEntity;
  }

  private final func BlacklistEntityID(go: GameObject, reason: BlacklistReason) {
    if IsDefined(go) {
      this.BlacklistEntityID(go.GetEntityID(), reason);
    }
  }

  private const final func GetEntityBlacklistIndex(entityID: EntityID) -> Int32 {
    let i = 0;
    while i < ArraySize(this.m_blacklist) {
      if this.m_blacklist[i].GetEntityID() == entityID {
        return i;
      }
      i += 1;
    }
    return -1;
  }

  private const final func RemoveFromBlacklist(entityID: EntityID) {
    if this.IsEntityBlacklisted(entityID) {
      let removeFromBlacklist = new RemoveFromBlacklistEvent();
      removeFromBlacklist.entityIDToRemove = entityID;
      removeFromBlacklist.isPlayerEntity = this.IsPlayersEntityID(entityID);
      this.PropagateEventToAgents(removeFromBlacklist);
      this
        .GetPersistencySystem()
        .QueuePSEvent(this.GetID(), this.GetClassName(), removeFromBlacklist);
    }
  }

  public const final func RemoveFromBlacklist(go: GameObject) {
    if IsDefined(go) {
      this.RemoveFromBlacklist(go.GetEntityID());
    }
  }

  private final func OnRemoveFromBlacklist(evt: RemoveFromBlacklistEvent) -> EntityNotificationType {
    if this.IsEntityBlacklisted(evt.entityIDToRemove) {
      this
        .RemoveIndexFromBlacklist(this.GetEntityBlacklistIndex(evt.entityIDToRemove));
      this.m_agentsRegistry.WipeReprimandData(evt.entityIDToRemove);
      this.ResetBlacklistWipeCountdown(evt.entityIDToRemove);
      this.ResolvePotentialDeescalation();
    }
    return EntityNotificationType.DoNotNotifyEntity;
  }

  private const final func IsPlayersEntityID(entityID: EntityID) -> Bool {
    let localPlayer = GameInstance.GetPlayerSystem(this.GetGameInstance()).GetLocalPlayerControlledGameObject();
    let mainPlayer = GameInstance.GetPlayerSystem(this.GetGameInstance()).GetLocalPlayerMainGameObject();
    if entityID == localPlayer.GetEntityID() || entityID == mainPlayer.GetEntityID() {
      return true;
    }
    return false;
  }

  public const final func GetSecurityAccessData(level: ESecurityAccessLevel) -> [SecurityAccessLevelEntry] {
    let emptyData: [SecurityAccessLevelEntry];
    switch level {
      case ESecurityAccessLevel.ESL_NONE:
        return emptyData;
      case ESecurityAccessLevel.ESL_0:
        return this.ProvideAccessDataLevel_0();
      case ESecurityAccessLevel.ESL_1:
        return this.ProvideAccessDataLevel_1();
      case ESecurityAccessLevel.ESL_2:
        return this.ProvideAccessDataLevel_2();
      case ESecurityAccessLevel.ESL_3:
        return this.ProvideAccessDataLevel_3();
      case ESecurityAccessLevel.ESL_4:
        return this.ProvideAccessDataLevel_4();
    }
    return emptyData;
  }

  public const final func IsUserAuthorized(user: EntityID, level: ESecurityAccessLevel) -> Bool {
    if Equals(level, ESecurityAccessLevel.ESL_NONE) {
      return true;
    } else if Equals(this.GetAttitudeTowards(user), EAIAttitude.AIA_Friendly) {
      return true;
    }
    let i = 0;
    while i < ArraySize(this.m_currentlyAuthorizedUsers) {
      if this.m_currentlyAuthorizedUsers[i].user == user {
        if EnumInt(this.m_currentlyAuthorizedUsers[i].level) >= EnumInt(level) {
          return true;
        }
      }
      i += 1;
    }
    return false;
  }

  public const final func IsUserAuthorized(user: GameObject, level: ESecurityAccessLevel) -> Bool {
    if IsDefined(user) {
      return this.IsUserAuthorized(user.GetEntityID(), level);
    }
    return false;
  }

  public const func GetUserAuthorizationLevel(user: EntityID) -> ESecurityAccessLevel {
    let i = 0;
    while i < ArraySize(this.m_currentlyAuthorizedUsers) {
      if this.m_currentlyAuthorizedUsers[i].user == user {
        return this.m_currentlyAuthorizedUsers[i].level;
      }
      i += 1;
    }
    return ESecurityAccessLevel.ESL_NONE;
  }

  public final func AddAccessLevelData(entryLevel: ESecurityAccessLevel, opt password: CName, opt keycard: TweakDBID) {
    switch entryLevel {
      case ESecurityAccessLevel.ESL_0:
        this.AddAccessLevelEntry(this.m_level_0, password, keycard);
        break;
      case ESecurityAccessLevel.ESL_1:
        this.AddAccessLevelEntry(this.m_level_1, password, keycard);
        break;
      case ESecurityAccessLevel.ESL_2:
        this.AddAccessLevelEntry(this.m_level_2, password, keycard);
        break;
      case ESecurityAccessLevel.ESL_3:
        this.AddAccessLevelEntry(this.m_level_3, password, keycard);
        break;
      case ESecurityAccessLevel.ESL_4:
        this.AddAccessLevelEntry(this.m_level_4, password, keycard);
    }
  }

  public const final func AuthorizeUser(user: EntityID, opt password: CName) -> Bool {
    let passLevel: ESecurityAccessLevel;
    let currentUserLevel = this.FindCurrentAuthorizationLevelForUser(user);
    if IsNameValid(password) {
      passLevel = this.PerformAuthorizationAttemptUsingPassword(user, password);
    }
    let keycardLevel = this.PerformAuthorizationAttemptUsingKeycard(user);
    if EnumInt(currentUserLevel) >= EnumInt(passLevel) && EnumInt(currentUserLevel) >= EnumInt(keycardLevel) {
      return false;
    } else if EnumInt(keycardLevel) > EnumInt(passLevel) {
      this.AddUser(user, keycardLevel);
    }
    this.AddUser(user, passLevel);
    return true;
  }

  public const final func AuthorizeUser(user: EntityID, level: ESecurityAccessLevel) {
    this.AddUser(user, level);
    this.ResolvePotentialDeescalation();
  }

  public func OnAddUserEvent(evt: AddUserEvent) -> EntityNotificationType {
    super.OnAddUserEvent(evt);
    this.RemoveFromBlacklist(evt.userEntry.user);
    this.RequestTargetsAssessment(null);
    return EntityNotificationType.DoNotNotifyEntity;
  }

  protected final func OnRevokeAuthorization(evt: RevokeAuthorization) -> EntityNotificationType {
    let i = 0;
    while i < ArraySize(this.m_currentlyAuthorizedUsers) {
      if this.m_currentlyAuthorizedUsers[i].user == evt.user {
        if this.m_currentlyAuthorizedUsers[i].level > evt.level {
          return EntityNotificationType.DoNotNotifyEntity;
        }
        this.m_currentlyAuthorizedUsers[i].level = ESecurityAccessLevel.ESL_NONE;
      }
      i += 1;
    }
    return EntityNotificationType.DoNotNotifyEntity;
  }

  protected func RemoveUser(user: EntityID) -> Bool {
    let removeUserSuccessful = super.RemoveUser(user);
    this.RequestTargetsAssessment(null);
    return removeUserSuccessful;
  }

  private final func AddAccessLevelEntry(
    level: script_ref<[SecurityAccessLevelEntry]>,
    opt password: CName,
    opt keycard: TweakDBID
  ) {
    let newEntry: SecurityAccessLevelEntry;
    if TDBID.IsValid(keycard) {
      newEntry.m_keycard = keycard;
      if !IsFinal() {
      } else if IsNameValid(password) {
        newEntry.m_password = password;
        if !IsFinal() {
        }
      }
    }
    ArrayPush(level, newEntry);
  }

  private const final func ProvideAccessDataLevel_0() -> [SecurityAccessLevelEntry] {
    let accessData = this.m_level_0;
    let higherLevelAccessData = this.ProvideAccessDataLevel_1();
    let i = 0;
    while i < ArraySize(higherLevelAccessData) {
      ArrayPush(accessData, higherLevelAccessData[i]);
      i += 1;
    }
    return accessData;
  }

  private const final func ProvideAccessDataLevel_1() -> [SecurityAccessLevelEntry] {
    let accessData = this.m_level_1;
    let higherLevelAccessData = this.ProvideAccessDataLevel_2();
    let i = 0;
    while i < ArraySize(higherLevelAccessData) {
      ArrayPush(accessData, higherLevelAccessData[i]);
      i += 1;
    }
    return accessData;
  }

  private const final func ProvideAccessDataLevel_2() -> [SecurityAccessLevelEntry] {
    let accessData = this.m_level_2;
    let higherLevelAccessData = this.ProvideAccessDataLevel_3();
    let i = 0;
    while i < ArraySize(higherLevelAccessData) {
      ArrayPush(accessData, higherLevelAccessData[i]);
      i += 1;
    }
    return accessData;
  }

  private const final func ProvideAccessDataLevel_3() -> [SecurityAccessLevelEntry] {
    let accessData = this.m_level_3;
    let higherLevelAccessData = this.ProvideAccessDataLevel_4();
    let i = 0;
    while i < ArraySize(higherLevelAccessData) {
      ArrayPush(accessData, higherLevelAccessData[i]);
      i += 1;
    }
    return accessData;
  }

  private const final func ProvideAccessDataLevel_4() -> [SecurityAccessLevelEntry] {
    return this.m_level_4;
  }

  private const final func PerformAuthorizationAttemptUsingKeycard(user: EntityID) -> ESecurityAccessLevel {
    let minimumLevel = this.FindCurrentAuthorizationLevelForUser(user);
    let currentLevel = ESecurityAccessLevel.ESL_4;
    let keycardMatchNotFound = true;
    while keycardMatchNotFound {
      keycardMatchNotFound = !this.IsUserAuthorizedViaCard(user, currentLevel);
      if keycardMatchNotFound && Equals(currentLevel, minimumLevel) {
        return ESecurityAccessLevel.ESL_NONE;
      } else if Equals(keycardMatchNotFound, false) {
        return currentLevel;
      }
      currentLevel = this.ReduceLevelByOne(currentLevel);
    }
    return ESecurityAccessLevel.ESL_NONE;
  }

  private const final func PerformAuthorizationAttemptUsingPassword(user: EntityID, password: CName) -> ESecurityAccessLevel {
    let minimumLevel = this.FindCurrentAuthorizationLevelForUser(user);
    let currentLevel = ESecurityAccessLevel.ESL_4;
    let passwordNotFound = true;
    while passwordNotFound {
      passwordNotFound = !this.IsUserAuthorizedViaPassword(password, currentLevel);
      if passwordNotFound && Equals(currentLevel, minimumLevel) {
        return ESecurityAccessLevel.ESL_NONE;
      } else if Equals(passwordNotFound, false) {
        return currentLevel;
      }
      currentLevel = this.ReduceLevelByOne(currentLevel);
    }
    return ESecurityAccessLevel.ESL_NONE;
  }

  private const final func IsUserAuthorizedViaCard(user: EntityID, level: ESecurityAccessLevel) -> Bool {
    let validSecurityData = this.GetSecurityAccessData(level);
    let viableKeycards = this.ExtractKeycardsFromAuthorizationData(validSecurityData);
    let transactionSystem = GameInstance.GetTransactionSystem(this.GetGameInstance());
    let i = 0;
    while i < ArraySize(viableKeycards) {
      if transactionSystem
        .HasItem(
          GameInstance.FindEntityByID(this.GetGameInstance(), user) as GameObject,
          ItemID.CreateQuery(viableKeycards[i])
        ) {
        return true;
      }
      i += 1;
    }
    return false;
  }

  private const final func IsUserAuthorizedViaPassword(password: CName, level: ESecurityAccessLevel) -> Bool {
    let validSecurityData = this.GetSecurityAccessData(level);
    let viablePasswords = this.ExtractPasswordsFromAuthorizationData(validSecurityData);
    let i = 0;
    while i < ArraySize(viablePasswords) {
      if Equals(viablePasswords[i], password) {
        return true;
      }
      i += 1;
    }
    return false;
  }

  public func GetActions(out actions: [DeviceAction], context: GetActionsContext) -> Bool {
    if !super.GetActions(actions, context) {
      return false;
    } else if FullSystemRestart.IsDefaultConditionMet(this, context) {
      ArrayPush(actions, this.ActionFullSystemRestart());
    }
    this.SetActionIllegality(actions, this.m_illegalActions.regularActions);
    return true;
  }

  protected const final func ActionSecuritySystemStatus() -> SecuritySystemStatus {
    let action = new SecuritySystemStatus();
    action.clearanceLevel = 1;
    action.SetUp(this);
    action.SetProperties(this);
    action.AddDeviceName(this.GetDeviceName());
    action.CreateActionWidgetPackage();
    return action;
  }

  public const final func ActionSecuritySystemBreachResponse(notificationEvent: SecuritySystemInput) -> SecuritySystemOutput {
    let action = new SecuritySystemOutput();
    action.SetUp(this);
    action.SetProperties(this.m_securitySystemState, notificationEvent);
    action.AddDeviceName(this.GetDeviceName());
    return action;
  }

  private const final func ActionFullSystemRestart() -> FullSystemRestart {
    let action = new FullSystemRestart();
    action.clearanceLevel = 10;
    action.SetUp(this);
    action.SetProperties(this.m_isRestarting, this.m_restartDuration);
    action.AddDeviceName(this.GetDeviceName());
    action.CreateActionWidgetPackage();
    return action;
  }

  public func OnFullSystemRestart(evt: FullSystemRestart) -> EntityNotificationType {
    let notifier = new ActionNotifier();
    notifier.SetExternalOnly();
    if this.m_isRestarting {
      return EntityNotificationType.DoNotNotifyEntity;
    } else if !IsFinal() {
    }
    super.OnFullSystemRestart(evt);
    this.SendActionToAllSlaves(evt);
    this.Notify(notifier, evt);
    this.NotifyParents();
    return EntityNotificationType.DoNotNotifyEntity;
  }

  protected func OnQuestForceON(evt: QuestForceON) -> EntityNotificationType {
    if !this.IsDisabled() || !this.IsOFF() {
    }
    super.OnQuestForceON(evt);
    this.InitiateAgentRegistry();
    let agents = this.m_agentsRegistry.GetAgents();
    let i = 0;
    while i < ArraySize(agents) {
      this.QueuePSEvent(this.GetPS(agents[i].link), new SecuritySystemEnabled());
      i += 1;
    }
    this.NotifyParents();
    return EntityNotificationType.DoNotNotifyEntity;
  }

  protected final func OnActionTakeOverSecuritySystem(evt: TakeOverSecuritySystem) -> EntityNotificationType {
    if evt.GetExecutor().IsPlayer() {
      this.SetSecuritySystemAttitudeGroup(t"Attitudes.Group_Player");
    }
    return EntityNotificationType.DoNotNotifyEntity;
  }

  public func OnActionForceResetDevice(evt: ActionForceResetDevice) -> EntityNotificationType {
    let restart = this.ActionFullSystemRestart();
    restart.SetProperties(true, evt.m_restartDuration);
    this.CleanSecuritySystemMemory();
    this.OnFullSystemRestart(restart);
    return EntityNotificationType.DoNotNotifyEntity;
  }

  private final func CleanSecuritySystemMemory() {
    this.ReleaseAllReprimands();
    this.m_agentsRegistry = null;
    this.InitiateAgentRegistry();
    this.m_blacklistDelayValid = false;
    this.m_currentReprimandID = 0;
    ArrayClear(this.m_blacklist);
    this.m_securitySystemState = ESecuritySystemState.SAFE;
    this.UpdateBlackboardAreaDataForPlayer();
  }

  private const final func GetPS(const agent: script_ref<Agent>) -> DeviceComponentPS {
    return this.GetPS(agent.link);
  }

  private const final func ReduceLevelByOne(level: ESecurityAccessLevel) -> ESecurityAccessLevel {
    if Equals(level, ESecurityAccessLevel.ESL_NONE) {
      return level;
    }
    let reducedLevel = IntEnum<ESecurityAccessLevel>(EnumInt(level) - 1);
    return reducedLevel;
  }

  private const final func GetAttitudeSystem() -> AttitudeSystem {
    return GameInstance.GetAttitudeSystem(this.GetGameInstance());
  }

  private const final func GetAttitudeTowards(target: EntityID) -> EAIAttitude {
    if EntityID.IsDefined(target) {
      return this.GetAttitudeTowards(this.GetAttitudeSystem().GetAttitudeGroup(target));
    }
    return EAIAttitude.AIA_Neutral;
  }

  private const final func GetAttitudeTowards(target: GameObject) -> EAIAttitude {
    if IsDefined(target) {
      return this.GetAttitudeTowards(target.GetEntityID());
    }
    return EAIAttitude.AIA_Friendly;
  }

  private const final func GetAttitudeTowards(otherGroup: CName) -> EAIAttitude {
    let secSysGroup = this.GetSecuritySystemAttitudeGroupName();
    let relation = this.GetAttitudeSystem().GetAttitudeRelation(secSysGroup, otherGroup);
    return relation;
  }

