public func RoundMath(f: Float) -> Int32 {
  if f == 0.0 {
    return Cast<Int32>(f);
  }
  if f > 0.0 {
    if f - Cast<Float>(FloorF(f)) >= 0.5 {
      return CeilF(f);
    }
    return FloorF(f);
  }
  if f + Cast<Float>(FloorF(f)) >= -0.5 {
    return FloorF(f);
  }
  return CeilF(f);
}

