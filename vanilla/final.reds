  public let position: Float;
  public let height: Float;
}

class NewPerksRequirementsLinksManager extends IScriptable {
  public let m_cache: [NewPerksRequirementsLinks];

  public final func Get(perk: gamedataNewPerkType) -> NewPerksRequirementsLinks {
    let i = 0;
    let limit = ArraySize(this.m_cache);
    while i < limit {
      if Equals(this.m_cache[i].perk, perk) {
        return this.m_cache[i];
      }
      i += 1;
    }
    return null;
  }

  public final func Push(perk: gamedataNewPerkType, link: gamedataNewPerkType) {
    let targetLink: NewPerksRequirementsLinks;
    let i = 0;
    let limit = ArraySize(this.m_cache);
    if i < limit {
      if Equals(this.m_cache[i].perk, perk) {
        targetLink = this.m_cache[i];
      } else {
        i += 1;
      }
    } else if targetLink == null {
      targetLink = new NewPerksRequirementsLinks();
      targetLink.perk = perk;
      ArrayPush(this.m_cache, targetLink);
    }
    ArrayPush(targetLink.linkedPerks, link);
  }

  public final func Clear() {
    ArrayClear(this.m_cache);
  }
}

class NewPerksRequirementsLinks extends IScriptable {
  public let perk: gamedataNewPerkType;
  public let linkedPerks: [gamedataNewPerkType];
}

