  public final func GetPlayerHealth() -> Float {
    let statData: [StatViewData];
    this.GetPlayerHealthStats(statData);
    let i = 0;
    while i < ArraySize(statData) {
      if Equals(statData[i].type, gamedataStatType.Health) {
        return statData[i].valueF;
      }
      i += 1;
    }
    return 0.0;
  }

  private final func GetPlayerStatsFromMap(statsList: script_ref<[StatViewData]>, const uiMap: script_ref<String>) {
    let statRecords: [wref<Stat_Record>];
    let curData: StatViewData;
    let playerID = Cast<StatsObjectID>(this.m_Player.GetEntityID());
    let statMap = TweakDBInterface.GetUIStatsMapRecord(TDBID.Create(uiMap));
    statMap.PrimaryStats(statRecords);
    let count = ArraySize(statRecords);
    let i = 0;
    while i < count {
      let curRecords = statRecords[i];
      if IsDefined(curRecords) {
        curData.type = curRecords.StatType();
        curData.valueF = this.m_StatsSystem.GetStatValue(playerID, curData.type);
        if TweakDBInterface.GetBool(statRecords[i].GetID() + t".multiplyBy100InText", false) {
          let val = Cast<Int32>(this.m_StatsSystem.GetStatValue(playerID, curData.type) * 100.0);
        } else if Equals(curData.type, gamedataStatType.Health) {
          val = CeilF(this.m_StatsSystem.GetStatValue(playerID, curData.type));
        } else {
          val = RoundMath(this.m_StatsSystem.GetStatValue(playerID, curData.type));
        }
        curData.value = val;
        curData.statName = this.GetLocalizedStatName(curRecords);
        ArrayPush(statsList, curData);
      }
      i += 1;
    }
  }

  private const final func GetLocalizedStatName(statRecord: wref<Stat_Record>) -> String {
    let localizedName = statRecord.LocalizedName();
    if !IsStringValid(localizedName) {
      localizedName = this
        .m_LocMgr
        .Localize(EnumValueToName(n"gamedataStatType", EnumInt(statRecord.StatType())));
    }
    return localizedName;
  }

