class RefreshPingEffector extends Effector {
  public let m_squadMembers: [EntityID];
  public let m_owner: wref<GameObject>;

  protected func ActionOn(owner: GameObject) {
    this.m_owner = owner;
    let statValue = GameInstance
      .GetStatsSystem(owner.GetGame())
      .GetStatValue(
        Cast<StatsObjectID>(
          GameInstance
            .GetPlayerSystem(owner.GetGame())
            .GetLocalPlayerMainGameObject()
            .GetEntityID()
        ),
        gamedataStatType.RefreshesPingOnQuickhack
      );
    AISquadHelper.GetSquadmatesID(owner as ScriptedPuppet, this.m_squadMembers);
    ArrayPush(this.m_squadMembers, owner.GetEntityID());
    if !IsDefined(owner) {
      return;
    } else if statValue == 1.0 {
      this.RefreshSquad(owner);
    }
  }

  public final func RefreshSquad(root: GameObject) {
    let appliedEffects: [StatusEffect];
    let i = 0;
    while i < ArraySize(this.m_squadMembers) {
      let target = GameInstance.FindEntityByID(root.GetGame(), this.m_squadMembers[i]) as GameObject;
      GameInstance
        .GetStatusEffectSystem(target.GetGame())
        .GetAppliedEffects(target.GetEntityID(), appliedEffects);
      if !IsDefined(target) || ArraySize(appliedEffects) == 0 {
      } else {
        let j = 0;
        if j < ArraySize(appliedEffects) {
          let pingRecord = appliedEffects[j].GetRecord();
          let tags = pingRecord.GameplayTags();
          if ArrayContains(tags, n"Ping") {
            StatusEffectHelper
              .ApplyStatusEffect(
                target,
                pingRecord.GetID(),
                GameInstance
                  .GetPlayerSystem(target.GetGame())
                  .GetLocalPlayerMainGameObject()
                  .GetEntityID()
              );
          } else {
            j += 1;
          }
        }
      }
      i += 1;
    }
  }
}

class IsNPCInCourier extends AIbehaviorconditionScript {
  protected func Check(context: ScriptExecutionContext) -> AIbehaviorConditionOutcomes {
    let dynamicSpawnSystem = GameInstance.GetDynamicSpawnSystem(ScriptExecutionContext.GetOwner(context).GetGame());
    return Cast<AIbehaviorConditionOutcomes>(
      dynamicSpawnSystem.IsEntityRegistered(ScriptExecutionContext.GetOwner(context).GetEntityID())
    );
  }
}

public func Cast(value: Bool) -> AIbehaviorConditionOutcomes {
  if value {
    return AIbehaviorConditionOutcomes.True;
  }
  return AIbehaviorConditionOutcomes.False;
}

class RefreshQhWithTagInAreaEffector extends Effector {
  public let m_tags: [CName];
  public let m_range: Float;

  protected func Initialize(record: TweakDBID, game: GameInstance, parentRecord: TweakDBID) {
    this.m_tags = TDB.GetCNameArray(record + t".tags");
    this.m_range = TDB.GetFloat(record + t".range");
  }

  protected func ActionOn(owner: GameObject) {
    if !IsDefined(owner) || ArraySize(this.m_tags) == 0 {
      return;
    }
    let targets = owner.GetNPCsAroundObject(this.m_range);
    this.RefreshQhStatusEffects(owner, targets);
  }

  private final func RefreshQhStatusEffects(owner: GameObject, targets: [NPCPuppet]) {
    let appliedEffects: [StatusEffect];
    let statusEffectSystem = GameInstance.GetStatusEffectSystem(owner.GetGame());
    let i = 0;
    while i < ArraySize(targets) {
      let target = targets[i];
      ArrayClear(appliedEffects);
      statusEffectSystem.GetAppliedEffects(target.GetEntityID(), appliedEffects);
      if ArraySize(appliedEffects) == 0 {
      } else {
        let j = 0;
        if j < ArraySize(appliedEffects) {
          let record = appliedEffects[j].GetRecord();
          let tags = record.GameplayTags();
          let foundAllTags = true;
          let k = 0;
          if k < ArraySize(this.m_tags) {
            if !ArrayContains(tags, this.m_tags[k]) {
              foundAllTags = false;
            } else {
              k += 1;
            }
          } else if foundAllTags {
            statusEffectSystem.RemoveStatusEffect(target.GetEntityID(), record.GetID());
            statusEffectSystem
              .ApplyStatusEffect(
                target.GetEntityID(),
                record.GetID(),
                GameObject.GetTDBID(owner),
                owner.GetEntityID(),
                appliedEffects[j].GetStackCount()
              );
          } else {
            j += 1;
          }
        }
      }
      i += 1;
    }
  }
}

