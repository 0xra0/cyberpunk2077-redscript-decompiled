public func OperatorSubtract(level1: ESecurityAccessLevel, value: Int32) -> ESecurityAccessLevel {
  let outcomeInt = EnumInt(level1) - value;
  if outcomeInt < 0 {
    outcomeInt = 0;
  } else if outcomeInt > Cast<Int32>(EnumGetMax(n"ESecurityAccessLevel")) {
    outcomeInt = Cast<Int32>(EnumGetMax(n"ESecurityAccessLevel"));
  }
  let outcome = IntEnum<ESecurityAccessLevel>(outcomeInt);
  return outcome;
}

public func OperatorLess(enum1: ESecurityNotificationType, enum2: ESecurityNotificationType) -> Bool {
  if EnumInt(enum1) < EnumInt(enum2) {
    return true;
  }
  return false;
}

