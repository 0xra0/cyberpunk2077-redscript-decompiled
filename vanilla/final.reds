  protected const final func FindCurrentAuthorizationLevelForUser(user: EntityID) -> ESecurityAccessLevel {
    let i = 0;
    while i < ArraySize(this.m_currentlyAuthorizedUsers) {
      if this.m_currentlyAuthorizedUsers[i].user == user {
        return this.m_currentlyAuthorizedUsers[i].level;
      }
      i += 1;
    }
    return ESecurityAccessLevel.ESL_NONE;
  }

  protected const final func AddUser(user: EntityID, level: ESecurityAccessLevel) -> Bool {
    let newUserEntry: SecuritySystemClearanceEntry;
    if Equals(level, ESecurityAccessLevel.ESL_NONE) {
      level = ESecurityAccessLevel.ESL_0;
    }
    let index = this.IsUserAlreadyOnTheList(user);
    if index
      >= 0
      && EnumInt(this.m_currentlyAuthorizedUsers[index].level) >= EnumInt(level) {
      return false;
    }
    newUserEntry.user = user;
    newUserEntry.level = level;
    let addUserEvent = new AddUserEvent();
    addUserEvent.userEntry = newUserEntry;
    this
      .GetPersistencySystem()
      .QueuePSEvent(this.GetID(), this.GetClassName(), addUserEvent);
    return true;
  }

  public func OnAddUserEvent(evt: AddUserEvent) -> EntityNotificationType {
    DeviceHelper.DebugLog(this.GetGameInstance(), "SecSys: User authorized");
    DeviceHelper
      .DebugLog(this.GetGameInstance(), "SecSys: User Authorized on: " + this.GetDeviceName());
    DeviceHelper
      .DebugLog(
        this.GetGameInstance(),
        "SecSys: User authorized on level: "
          + EnumValueToString("ESecurityAccessLevel", EnumInt(evt.userEntry.level))
      );
    if !IsFinal() {
    }
    let index = this.IsUserAlreadyOnTheList(evt.userEntry.user);
    if index >= 0 {
      ArrayErase(this.m_currentlyAuthorizedUsers, index);
    }
    ArrayPush(this.m_currentlyAuthorizedUsers, evt.userEntry);
    return EntityNotificationType.DoNotNotifyEntity;
  }

  protected const final func IsUserAlreadyOnTheList(entityID: EntityID) -> Int32 {
    let i = 0;
    while i < ArraySize(this.m_currentlyAuthorizedUsers) {
      if this.m_currentlyAuthorizedUsers[i].user == entityID {
        return i;
      }
      i += 1;
    }
    return -1;
  }

  protected func RemoveUser(user: EntityID) -> Bool {
    let index = this.IsUserAlreadyOnTheList(user);
    if index >= 0 {
      if !IsFinal() {
      }
      ArrayErase(this.m_currentlyAuthorizedUsers, index);
      return true;
    }
    return false;
  }

