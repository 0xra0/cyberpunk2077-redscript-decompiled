class BossStealthComponent extends ScriptableComponent {
  private let m_owner: wref<NPCPuppet>;
  private let m_owner_id: EntityID;
  private let m_player: wref<PlayerPuppet>;
  private let m_statPoolSystem: StatPoolsSystem;
  private let m_statPoolType: gamedataStatPoolType;
  private let m_targetTrackerComponent: TargetTrackerComponent;

  private final func OnGameAttach() {
    this.m_owner = this.GetOwner() as NPCPuppet;
    this.m_owner_id = this.m_owner.GetEntityID();
    this.m_owner.SetDisableRagdoll(true);
    this.m_player = this.GetPlayerSystem().GetLocalPlayerControlledGameObject() as PlayerPuppet;
    this.m_statPoolSystem = GameInstance.GetStatPoolsSystem(this.m_owner.GetGame());
    this.m_targetTrackerComponent = this.m_owner.GetTargetTrackerComponent();
  }

  protected cb func OnStatusEffectApplied(evt: ApplyStatusEffectEvent) -> Bool {
    let tags = evt.staticData.GameplayTags();
    if ArrayContains(tags, n"Quickhack") {
      NPCPuppet.ChangeHighLevelState(this.m_owner, gamedataNPCHighLevelState.Combat);
      AIActionHelper.TryStartCombatWithTarget(this.m_owner, this.m_player);
    } else if ArrayContains(tags, n"MemoryWipe") {
      StatusEffectHelper
        .ApplyStatusEffect(
          this.m_owner,
          t"BaseStatusEffect.BossNoTakeDown",
          this.m_owner.GetEntityID()
        );
      if IsDefined(this.m_targetTrackerComponent) {
        this.m_targetTrackerComponent.ClearThreats();
      }
      ScriptedPuppet.SendActionSignal(this.m_owner, n"alerted", 0.5);
      NPCPuppet.ChangeHighLevelState(this.m_owner, gamedataNPCHighLevelState.Alerted);
    }
  }

  protected cb func OnNonStealthQuickHackVictimEvent(evt: NonStealthQuickHackVictimEvent) -> Bool {
    NPCStatesComponent.AlertPuppet(this.m_owner);
  }
}

class DetectorModuleComponent extends ScriptableComponent {
  protected cb func OnSenseVisibilityEvent(evt: SenseVisibilityEvent) -> Bool {
    let revealEvent = new RevealObjectEvent();
    revealEvent.reason.reason = n"FlatheadThreatSharing";
    if GameInstance
      .GetStatsSystem(this.GetOwner().GetGame())
      .GetStatBoolValue(
        Cast<StatsObjectID>(this.GetOwner().GetEntityID()),
        gamedataStatType.CanShareThreatsWithPlayer
      ) {
      if evt.isVisible
        && IsDefined(evt.target as ScriptedPuppet)
        && ScriptedPuppet.IsAlive(evt.target) {
        revealEvent.reveal = true;
        evt.target.QueueEvent(revealEvent);
      } else if !evt.isVisible && IsDefined(evt.target as ScriptedPuppet) {
        revealEvent.reveal = false;
        evt.target.QueueEvent(revealEvent);
      }
    }
  }
}

native class gamevehicleVehicleMountableComponent extends MountableComponent {
  protected cb func OnInteractionChoice(choiceEvent: InteractionChoiceEvent) -> Bool {
    let activator = choiceEvent.activator;
    if MountableComponent.IsInteractionAcceptable(choiceEvent) && this.DoStatusEffectsAllowMounting(activator) {
      let record = InteractionChoiceMetaData.GetTweakData(choiceEvent.choice.choiceMetaData) as InteractionMountBase_Record;
      let slotName = record.VehicleMountSlot();
      this
        .MountEntityToSlot(
          choiceEvent.hotspot.GetEntityID(),
          activator.GetEntityID(),
          slotName,
          MountType.Regular
        );
    }
  }

  protected cb func OnActionDemolition(evt: ActionDemolition) -> Bool {
    let executor = evt.GetExecutor();
    if this.DoStatusEffectsAllowMounting(executor) {
      this
        .MountEntityToSlot(
          evt.GetRequesterID(),
          executor.GetEntityID(),
          evt.prop.name,
          MountType.Hijack
        );
    }
  }

  protected cb func OnActionEngineering(evt: ActionEngineering) -> Bool {
    let executor = evt.GetExecutor();
    if this.DoStatusEffectsAllowMounting(executor) {
      this
        .MountEntityToSlot(
          evt.GetRequesterID(),
          executor.GetEntityID(),
          evt.prop.name,
          MountType.Hijack
        );
    }
  }

  private final func DoStatusEffectsAllowMounting(executor: wref<GameObject>) -> Bool {
    if StatusEffectSystem.ObjectHasStatusEffect(executor, t"BaseStatusEffect.VehicleKnockdown")
      || StatusEffectSystem.ObjectHasStatusEffect(executor, t"BaseStatusEffect.BikeKnockdown") {
      return false;
    }
    return true;
  }

  protected final func MountEntityToSlot(parentID: EntityID, childId: EntityID, slot: CName, mountType: MountType) {
    let lowLevelMountingInfo: MountingInfo;
    let attitude: EAIAttitude;
    let isNPCAlive: Bool;
    let isNPCInactive: Bool;
    let isOccupiedByNonFriendly: Bool;
    let mountingRequest = new MountingRequest();
    let mountData = new MountEventData();
    let mountOptions = new MountEventOptions();
    lowLevelMountingInfo.parentId = parentID;
    lowLevelMountingInfo.childId = childId;
    lowLevelMountingInfo.slotId.id = slot;
    let npcMountInfo = GameInstance
      .GetMountingFacility((this.GetEntity() as GameObject).GetGame())
      .GetMountingInfoSingleWithIds(lowLevelMountingInfo.parentId, lowLevelMountingInfo.slotId);
    let npcMountInfos = GameInstance
      .GetMountingFacility((this.GetEntity() as GameObject).GetGame())
      .GetMountingInfoMultipleWithIds(lowLevelMountingInfo.parentId);
    if EntityID.IsDefined(npcMountInfo.childId) {
      let scriptedPuppet = GameInstance
        .FindEntityByID((this.GetEntity() as GameObject).GetGame(), npcMountInfo.childId) as GameObject;
      isNPCAlive = ScriptedPuppet.IsActive(scriptedPuppet);
      isNPCInactive = !isNPCAlive;
    } else if Equals(mountType, MountType.Hijack) || isNPCInactive {
      let vehObject = this.GetEntity() as VehicleObject;
      vehObject.PreHijackPrepareDriverSlot();
    }
    let i = 0;
    while i < ArraySize(npcMountInfos) {
      if EntityID.IsDefined(npcMountInfos[i].childId) {
        VehicleComponent
          .GetAttitudeOfPassenger(
            (this.GetEntity() as GameObject).GetGame(),
            npcMountInfos[i].parentId,
            npcMountInfos[i].slotId,
            attitude
          );
        if NotEquals(attitude, EAIAttitude.AIA_Friendly) {
          isOccupiedByNonFriendly = true;
        }
      }
      i += 1;
    }
    mountingRequest.lowLevelMountingInfo = lowLevelMountingInfo;
    mountingRequest.preservePositionAfterMounting = true;
    mountingRequest.mountData = mountData;
    mountOptions.entityID = npcMountInfo.childId;
    mountOptions.alive = isNPCAlive;
    mountOptions.occupiedByNonFriendly = isOccupiedByNonFriendly;
    mountingRequest.mountData.mountEventOptions = mountOptions;
    GameInstance
      .GetMountingFacility((this.GetEntity() as GameObject).GetGame())
      .Mount(mountingRequest);
  }
}

