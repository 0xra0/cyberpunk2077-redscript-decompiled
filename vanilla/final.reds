  private final func RegisterSubCharacter() {
    if IsDefined(TweakDBInterface.GetSubCharacterRecord(this.GetRecordID())) {
      let scs = GameInstance.GetScriptableSystemsContainer(this.GetGame()).Get(n"SubCharacterSystem") as SubCharacterSystem;
      if IsDefined(scs) {
        let addSubCharacterRequest = new AddSubCharacterRequest();
        addSubCharacterRequest.subCharObject = this;
        scs.QueueRequest(addSubCharacterRequest);
      }
    }
  }

  private final func UnregisterSubCharacter() {
    if IsDefined(TweakDBInterface.GetSubCharacterRecord(this.GetRecordID())) {
      let scs = GameInstance.GetScriptableSystemsContainer(this.GetGame()).Get(n"SubCharacterSystem") as SubCharacterSystem;
      if IsDefined(scs) {
        let removeSubCharacterRequest = new RemoveSubCharacterRequest();
        removeSubCharacterRequest.subCharType = TweakDBInterface.GetSubCharacterRecord(this.GetRecordID()).Type();
        scs.QueueRequest(removeSubCharacterRequest);
      }
    }
  }

  public final static func CanRagdoll(obj: wref<GameObject>) -> Bool {
    if !IsDefined(obj) || !obj.IsPuppet() {
      return false;
    }
    let puppet = obj as ScriptedPuppet;
    if !puppet.CanRagdoll() {
      return false;
    } else if (puppet.IsBoss() || Equals(puppet.GetNPCRarity(), gamedataNPCRarity.MaxTac)) && !puppet.GetPS().GetWasIncapacitated() {
      return false;
    } else if StatusEffectSystem.ObjectHasStatusEffect(puppet, t"WorkspotStatus.Death") {
      return false;
    } else if puppet.HasWorkspotTag(n"FinisherWorkspot") {
      return false;
    } else if NotEquals(puppet.GetNPCType(), gamedataNPCType.Drone) && VehicleComponent.IsMountedToVehicle(puppet.GetGame(), puppet) {
      return false;
    }
    return true;
  }

  public final static func CanTripOverRagdolls(obj: wref<GameObject>) -> Bool {
    if !IsDefined(obj) || !obj.IsPuppet() {
      return false;
    }
    let puppet = obj as ScriptedPuppet;
    if !puppet.CanRagdoll() {
      return false;
    } else if NotEquals(puppet.GetNPCRarity(), gamedataNPCRarity.Trash) {
      return false;
    } else if NotEquals(puppet.GetNPCType(), gamedataNPCType.Human) {
      return false;
    } else if puppet.IsPlayerCompanion() {
      return false;
    } else if VehicleComponent.IsMountedToVehicle(puppet.GetGame(), puppet) {
      return false;
    } else if puppet.IsBoss() || puppet.IsMassive() || Equals(puppet.GetNPCRarity(), gamedataNPCRarity.MaxTac) {
      return false;
    } else if NPCPuppet.IsSusceptibleOnlyToStaggerAndHigher(puppet) {
      return false;
    }
    return true;
  }

