}

class HitShapeUserDataBase extends HitShapeUserData {
  public let m_hitShapeTag: CName;
  public let m_hitShapeType: EHitShapeType;
  public let m_hitReactionZone: EHitReactionZone;
  public let m_dismembermentPart: EAIDismembermentBodyPart;
  public let m_isProtectionLayer: Bool;
  public let m_quickHacksPierceProtection: Bool;
  public let m_isInternalWeakspot: Bool;
  public let m_hitShapeDamageMod: Float;

  public final static func GetHitShapeDamageMod(userData: HitShapeUserDataBase) -> Float {
    return userData.m_hitShapeDamageMod;
  }

  public final static func IsProtectionLayer(userData: HitShapeUserDataBase) -> Bool {
    return userData.m_isProtectionLayer;
  }

  public final static func DoQuickHacksPierceProtection(userData: HitShapeUserDataBase) -> Bool {
    return userData.m_quickHacksPierceProtection;
  }

  public final static func IsInternalWeakspot(userData: HitShapeUserDataBase) -> Bool {
    return userData.m_isInternalWeakspot;
  }

  public const final func IsHead() -> Bool {
    return Equals(this.m_hitShapeTag, n"Head");
  }

  public const final func GetShapeType() -> EHitShapeType {
    return this.m_hitShapeType;
  }

  public final static func DisableHitShape(gameObj: wref<GameObject>, shapeName: CName, hierarchical: Bool) {
    let hitShapeEvent = new ToggleHitShapeEvent();
    hitShapeEvent.enable = false;
    hitShapeEvent.hitShapeName = shapeName;
    hitShapeEvent.hierarchical = hierarchical;
    gameObj.QueueEvent(hitShapeEvent);
  }

  public final static func EnableHitShape(gameObj: wref<GameObject>, shapeName: CName, hierarchical: Bool) {
    let hitShapeEvent = new ToggleHitShapeEvent();
    hitShapeEvent.enable = true;
    hitShapeEvent.hitShapeName = shapeName;
    hitShapeEvent.hierarchical = hierarchical;
    gameObj.QueueEvent(hitShapeEvent);
  }

  public final static func GetHitReactionZone(userData: HitShapeUserDataBase) -> EHitReactionZone {
    return userData.m_hitReactionZone;
  }

  public final static func GetDismembermentBodyPart(userData: HitShapeUserDataBase) -> gameDismBodyPart {
    let str = EnumValueToString(
      "EAIDismembermentBodyPart",
      Cast<Int64>(EnumInt(userData.m_dismembermentPart))
    );
    let dismBodyPart = IntEnum<gameDismBodyPart>(Cast<Int32>(EnumValueFromString("gameDismBodyPart", str)));
    return dismBodyPart;
  }

  public final static func IsHitReactionZoneHead(userData: HitShapeUserDataBase) -> Bool {
    return Equals(userData.m_hitReactionZone, EHitReactionZone.Head);
  }

  public final static func IsHitReactionZoneTorso(userData: HitShapeUserDataBase) -> Bool {
    return Equals(userData.m_hitReactionZone, EHitReactionZone.Abdomen)
      || Equals(userData.m_hitReactionZone, EHitReactionZone.ChestLeft)
      || Equals(userData.m_hitReactionZone, EHitReactionZone.ChestRight);
  }

  public final static func IsHitReactionZoneLeftArm(userData: HitShapeUserDataBase) -> Bool {
    return Equals(userData.m_hitReactionZone, EHitReactionZone.ArmLeft) || Equals(userData.m_hitReactionZone, EHitReactionZone.HandLeft);
  }

  public final static func IsHitReactionZoneRightArm(userData: HitShapeUserDataBase) -> Bool {
    return Equals(userData.m_hitReactionZone, EHitReactionZone.ArmRight) || Equals(userData.m_hitReactionZone, EHitReactionZone.HandRight);
  }

  public final static func IsHitReactionZoneArm(userData: HitShapeUserDataBase) -> Bool {
    return Equals(userData.m_hitReactionZone, EHitReactionZone.ArmRight)
      || Equals(userData.m_hitReactionZone, EHitReactionZone.HandRight)
      || Equals(userData.m_hitReactionZone, EHitReactionZone.ArmLeft)
      || Equals(userData.m_hitReactionZone, EHitReactionZone.HandLeft);
  }

  public final static func IsHitReactionZoneRightLeg(userData: HitShapeUserDataBase) -> Bool {
    return Equals(userData.m_hitReactionZone, EHitReactionZone.LegRight);
  }

  public final static func IsHitReactionZoneLeftLeg(userData: HitShapeUserDataBase) -> Bool {
    return Equals(userData.m_hitReactionZone, EHitReactionZone.LegLeft);
  }

  public final static func IsHitReactionZoneLeg(userData: HitShapeUserDataBase) -> Bool {
    return Equals(userData.m_hitReactionZone, EHitReactionZone.LegLeft) || Equals(userData.m_hitReactionZone, EHitReactionZone.LegRight);
  }

  public final static func IsHitReactionZoneLimb(userData: HitShapeUserDataBase) -> Bool {
    return HitShapeUserDataBase.IsHitReactionZoneLeftArm(userData)
      || HitShapeUserDataBase.IsHitReactionZoneRightArm(userData)
      || HitShapeUserDataBase.IsHitReactionZoneRightLeg(userData)
      || HitShapeUserDataBase.IsHitReactionZoneLeftLeg(userData);
  }
}

