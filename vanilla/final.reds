class RipperdocMetersBase extends inkLogicController {
  protected let m_barAnchor: inkWidgetRef;
  protected let m_hoverArea: inkWidgetRef;
  protected let m_barWidgetLibraryName: CName;
  protected let m_barGapSize: Float;
  protected let m_slopeLengthModifier: Float;
  protected let barIntroAnimDuration: Float;
  protected let m_barsHeigh: Float;
  protected let m_barsMargin: Float;
  protected const let BAR_COUNT: Int32;
  protected const let BAR_SLOPE_COUNT: Int32;
  protected const let BAR_ANIM_DURATION: Float;
  protected const let BAR_DELAY_OFFSET: Float;
  protected let m_pulseAnimtopOpacity: Float;
  protected let m_pulseAnimbottomOpacity: Float;
  protected let m_pulseAnimpulseRate: Float;
  protected let m_pulseAnimdelay: Float;
  protected let m_pulseAnimationParams: PulseAnimationParams;
  protected let m_bars: [wref<RipperdocNewMeterBar>];
  protected let m_barGaps: [Int32];
  protected let m_tooltipData: RipperdocBarTooltipTooltipData;
  protected let m_barIntroAnimDef: inkAnimDef;
  protected let m_barIntroAnimProxy: inkAnimProxy;
  protected let m_isIntroPlayed: Bool;

  protected final func MoveLabelToBar(
    labelContainer: inkWidgetRef,
    bar: RipperdocNewMeterBar,
    animProxy: inkAnimProxy,
    alignToTop: Bool,
    instant: Bool
  ) {
    let distance = WidgetUtils.WidgetToWidget(inkWidgetRef.Get(labelContainer), bar.GetRootWidget());
    if animProxy != null {
      animProxy.GotoEndAndStop();
    }
    let oldMargin = inkWidgetRef.GetMargin(labelContainer);
    let newTopMargin = distance.Y;
    if alignToTop {
      newTopMargin -= bar.GetHeight();
    }
    newTopMargin = MaxF(newTopMargin, 0.0);
    let newMargin = new inkMargin(oldMargin.left, newTopMargin, oldMargin.right, oldMargin.bottom);
    let verticalDelta = AbsF(oldMargin.top - distance.Y);
    if verticalDelta != 0.0 {
      verticalDelta -= bar.GetHeight();
      let marginInterpolator = new inkAnimMargin();
      marginInterpolator.SetDuration(instant ? 0.0 : MinF(verticalDelta * 0.1, 0.3));
      marginInterpolator.SetStartMargin(oldMargin);
      marginInterpolator.SetEndMargin(newMargin);
      marginInterpolator.SetType(inkanimInterpolationType.Sinusoidal);
      marginInterpolator.SetMode(inkanimInterpolationMode.EasyOut);
      let animation = new inkAnimDef();
      animation.AddInterpolator(marginInterpolator);
      animProxy = inkWidgetRef.PlayAnimation(labelContainer, animation);
      inkWidgetRef.PlayAnimation(labelContainer, animation);
      if !this.m_isIntroPlayed {
        this.m_isIntroPlayed = true;
        animProxy
          .RegisterToCallback(inkanimEventType.OnStart, this, n"OnIntroAnimationFinished_METER");
      }
    }
  }

  protected final func GetSlopeAnimOffset(index: Int32, originBar: Int32) -> Float {
    return SqrF(Cast<Float>(index - originBar)) * this.m_slopeLengthModifier;
  }

  protected final func SetupBarIntroAnimation() {
    this.m_barIntroAnimDef = new inkAnimDef();
    let scaleInterpolator = new inkAnimScale();
    scaleInterpolator.SetMode(inkanimInterpolationMode.EasyOut);
    scaleInterpolator.SetType(inkanimInterpolationType.Linear);
    scaleInterpolator.SetStartScale(new Vector2(0.0, 1.0));
    scaleInterpolator.SetEndScale(new Vector2(1.0, 1.0));
    scaleInterpolator.SetDuration(this.barIntroAnimDuration);
    this.m_barIntroAnimDef.AddInterpolator(scaleInterpolator);
  }

  protected final func StartPulse(pulse: PulseAnimation, params: PulseAnimationParams, target: wref<inkWidget>) {
    pulse.Configure(target, 1.0, 0.2, 0.4, 0.1);
    pulse.Start(false);
  }

  protected final func StopPulse(pulse: PulseAnimation) {
    if IsDefined(pulse) {
      pulse.Stop();
    }
  }

  protected final func SetupPulseAnimParams(topOpacity: Float, bottomOpacity: Float, pulseRate: Float, delay: Float) {
    this.m_pulseAnimationParams.topOpacity = topOpacity;
    this.m_pulseAnimationParams.bottomOpacity = bottomOpacity;
    this.m_pulseAnimationParams.pulseRate = pulseRate;
    this.m_pulseAnimationParams.delay = delay;
  }

  protected cb func OnBarHoverOver(evt: inkPointerEvent) -> Bool {
    let barHoverOverEvent = new BarHoverOverEvent();
    barHoverOverEvent.data = this.m_tooltipData;
    this.QueueEvent(barHoverOverEvent);
  }

  protected cb func OnBarHoverOut(evt: inkPointerEvent) -> Bool {
    let barHoverOutEvent = new BarHoverOutEvent();
    this.QueueEvent(barHoverOutEvent);
  }
}

class RipperdocNewMeterBar extends inkLogicController {
  private let m_bar: inkWidgetRef;
  private let m_overchargeHighlight: inkWidgetRef;
  private let m_root: wref<inkWidget>;
  private let m_sizeAnimation: inkAnimProxy;
  private let m_meterWidth: Float;
  private let m_pulse: PulseAnimation;

  protected cb func OnInitialize() -> Bool {
    inkWidgetRef.SetVisible(this.m_overchargeHighlight, false);
    this.m_root = this.GetRootWidget();
  }

  public final func SetState(state: CName) {
    inkWidgetRef.SetState(this.m_bar, state);
    if inkWidgetRef.IsValid(this.m_overchargeHighlight) {
      if Equals(state, n"Unsafe_Default")
        || Equals(state, n"Unsafe_Add")
        || Equals(state, n"Unsafe_Remove")
        || Equals(state, n"Unsafe_Locked")
        || Equals(state, n"Unsafe_Unlocekd") {
        inkWidgetRef.SetState(this.m_overchargeHighlight, state);
        inkWidgetRef.SetVisible(this.m_overchargeHighlight, true);
      } else {
        inkWidgetRef.SetState(this.m_overchargeHighlight, n"Default");
        inkWidgetRef.SetVisible(this.m_overchargeHighlight, false);
      }
    }
  }

  public final func SetSizeAnimation(size: Float, sizeOffset: Float, delay: Float, duration: Float) {
    let options: inkAnimOptions;
    let endScale: Vector2;
    if this.m_sizeAnimation != null {
      this.m_sizeAnimation.Stop();
    }
    let startScale = inkWidgetRef.GetScale(this.m_bar);
    endScale.X = size + sizeOffset;
    endScale.Y = 1.0;
    let animation = new inkAnimDef();
    let marginInterpolator = new inkAnimScale();
    marginInterpolator.SetType(inkanimInterpolationType.Quintic);
    marginInterpolator.SetMode(inkanimInterpolationMode.EasyOut);
    marginInterpolator.SetDuration(duration);
    marginInterpolator.SetUseRelativeDuration(true);
    marginInterpolator.SetStartScale(startScale);
    marginInterpolator.SetEndScale(endScale);
    animation.AddInterpolator(marginInterpolator);
    options.executionDelay = MaxF(delay, 0.0);
    this.m_sizeAnimation = inkWidgetRef.PlayAnimationWithOptions(this.m_bar, animation, options);
  }

  public final func SetSize(size: Float) {
    let endScale: Vector2;
    endScale.X = size;
    endScale.Y = 1.0;
    inkWidgetRef.SetScale(this.m_bar, endScale);
  }

  public final func StartPulse(params: PulseAnimationParams) {
    if IsDefined(this.m_pulse) {
      this.m_pulse.ForceStop();
    }
    this.m_pulse = new PulseAnimation();
    this.m_pulse.Configure(inkWidgetRef.Get(this.m_bar), params);
    this.m_pulse.Start(false);
  }

  public final func StopPulse() {
    inkWidgetRef.StopAllAnimations(this.m_bar);
  }

  public final func GetHeight() -> Float {
    let size = inkWidgetRef.GetSize(this.m_bar);
    return size.Y;
  }

  public final func GetMargin(margin: String) -> Float {
    let margins = this.m_root.GetMargin();
    switch margin {
      case "left":
        return margins.left;
      case "top":
        return margins.top;
      case "right":
        return margins.right;
      case "bottom":
        return margins.bottom;
    }
    return 0.0;
  }
}

native class inkAnimScale extends inkAnimInterpolator {
  public final native func GetStartScale() -> Vector2;

  public final native func GetEndScale() -> Vector2;

  public final native func SetStartScale(startScale: Vector2);

  public final native func SetEndScale(endScale: Vector2);
}

