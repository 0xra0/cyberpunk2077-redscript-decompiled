class SharedGameplayPS extends DeviceComponentPS {
  protected persistent let m_deviceState: EDeviceStatus;
  protected persistent let m_authorizationProperties: AuthorizationData;
  protected persistent let m_wasStateCached: Bool;
  protected persistent let m_wasStateSet: Bool;
  protected persistent let m_cachedDeviceState: EDeviceStatus;
  protected let m_revealDevicesGrid: Bool;
  protected let m_revealDevicesGridWhenUnpowered: Bool;
  protected persistent let m_wasRevealedInNetworkPing: Bool;
  protected let m_hasNetworkBackdoor: Bool;

  public const final func GetDeviceState() -> EDeviceStatus {
    return this.m_deviceState;
  }

  protected final func CacheDeviceState(state: EDeviceStatus) {
    this.m_cachedDeviceState = state;
    this.m_wasStateCached = true;
  }

  protected func SetDeviceState(state: EDeviceStatus) {
    this.m_deviceState = state;
    this.m_wasStateSet = true;
  }

  public func EvaluateDeviceState() {
    if Equals(this.m_deviceState, EDeviceStatus.DISABLED) {
      return;
    }
    let parents = this.GetImmediateParents();
    let i = 0;
    while i < ArraySize(parents) {
      let parent = parents[i] as MasterControllerPS;
      if IsDefined(parent) {
        let expectedState = parent.GetExpectedSlaveState();
        if NotEquals(expectedState, EDeviceStatus.INVALID) {
          this.SetDeviceState(expectedState);
          return;
        }
      }
      i += 1;
    }
  }

  protected const final func QueuePSEvent(targetPS: wref<PersistentState>, evt: Event) {
    if !IsDefined(targetPS) {
      return;
    }
    GameInstance
      .GetPersistencySystem(this.GetGameInstance())
      .QueuePSEvent(targetPS.GetID(), targetPS.GetClassName(), evt);
  }

  protected const final func QueuePSEvent(targetID: PersistentID, psClassName: CName, evt: Event) {
    if IsDefined(evt as BaseScriptableAction) {
      if !EntityID.IsDefined((evt as BaseScriptableAction).GetRequesterID()) {
        (evt as BaseScriptableAction).RegisterAsRequester(this.GetMyEntityID());
      }
    }
    GameInstance
      .GetPersistencySystem(this.GetGameInstance())
      .QueuePSEvent(targetID, psClassName, evt);
  }

  protected const final func QueuePSEventWithDelay(targetPS: wref<PersistentState>, evt: Event, delay: Float) {
    if !IsDefined(targetPS) {
      return;
    }
    GameInstance
      .GetDelaySystem(this.GetGameInstance())
      .DelayPSEvent(targetPS.GetID(), targetPS.GetClassName(), evt, delay);
  }

  protected const final func QueuePSEventWithDelay(targetID: PersistentID, psClassName: CName, evt: Event, delay: Float) {
    GameInstance
      .GetDelaySystem(this.GetGameInstance())
      .DelayPSEvent(targetID, psClassName, evt, delay);
  }

  protected const final func QueueEntityEvent(entityID: EntityID, evt: Event) {
    GameInstance
      .GetPersistencySystem(this.GetGameInstance())
      .QueueEntityEvent(entityID, evt);
  }

  public const func IsPartOfSystem(systemType: ESystems) -> Bool {
    switch systemType {
      case ESystems.SecuritySystem:
        return this.IsConnectedToSecuritySystem();
      case ESystems.AccessPoints:
        return this.IsConnectedToBackdoorDevice();
    }
    return false;
  }

  public const final func IsConnectedToSecuritySystem() -> Bool {
    let securitySystem = this.GetSecuritySystem();
    return IsDefined(securitySystem);
  }

  public const func IsConnectedToSecuritySystem(out level: ESecurityAccessLevel) -> Bool {
    level = this.GetSecurityAccessLevel();
    return this.IsConnectedToSecuritySystem();
  }

  public const func GetSecurityAccessLevel() -> ESecurityAccessLevel {
    return this.FindHighestSecurityAccessLevel(this.GetSecurityAreas());
  }

  protected const final func FindHighestSecurityAccessLevel(const securityAreas: script_ref<[SecurityAreaControllerPS]>) -> ESecurityAccessLevel {
    let highestLevel = ESecurityAccessLevel.ESL_NONE;
    let i = 0;
    while i < ArraySize(securityAreas) {
      if EnumInt(securityAreas[i].GetSecurityAccessLevel()) > EnumInt(highestLevel) {
        highestLevel = securityAreas[i].GetSecurityAccessLevel();
      }
      i += 1;
    }
    if Equals(highestLevel, ESecurityAccessLevel.ESL_NONE) {
      highestLevel = this.m_authorizationProperties.m_authorizationDataEntry.m_level;
    }
    return highestLevel;
  }

  public const func IsBreached() -> Bool {
    let aps = this.GetAccessPoints();
    let i = 0;
    while i < ArraySize(aps) {
      if aps[i].IsNetworkBreached() {
        return true;
      }
      i += 1;
    }
    if !IsFinal() {
    }
    return false;
  }

  public const func HasNetworkBackdoor() -> Bool {
    if this.m_hasNetworkBackdoor && EnumInt(this.GetDeviceState()) > -1 {
      let ap = this.GetBackdoorAccessPoint();
      if IsDefined(ap) {
        return true;
      }
    }
    return false;
  }

  public const func IsConnectedToBackdoorDevice() -> Bool {
    let parents: [DeviceComponentPS];
    this.GetParents(parents);
    let i = 0;
    while i < ArraySize(parents) {
      if (parents[i] as ScriptableDeviceComponentPS).HasNetworkBackdoor() {
        return true;
      }
      i += 1;
    }
    return false;
  }

  public const func GetBackdoorAccessPoint() -> AccessPointControllerPS {
    if !this.m_hasNetworkBackdoor {
      if !IsFinal() {
      }
      return null;
    }
    let aps = this.GetAccessPoints();
    if ArraySize(aps) > 0 {
      let backdoorAP = aps[0];
      return backdoorAP;
    } else if !IsFinal() {
    }
    return null;
  }

  public const final func GetAccessPoints() -> [AccessPointControllerPS] {
    let aps: [AccessPointControllerPS];
    let parents: [DeviceComponentPS];
    this.GetParents(parents);
    let i = 0;
    while i < ArraySize(parents) {
      if IsDefined(parents[i] as AccessPointControllerPS) {
        let ap = parents[i] as AccessPointControllerPS;
        ArrayPush(aps, ap);
      }
      i += 1;
    }
    return aps;
  }

  public const func GetNetworkName() -> String {
    let aps = this.GetAccessPoints();
    if ArraySize(aps) > 0 {
      let networkName = aps[0].GetNetworkName();
      if IsStringValid(networkName) {
        return networkName;
      }
      return "LOCAL NETWORK";
    } else if !IsFinal() {
    }
    return "";
  }

  public const final func CheckMasterConnectedClassTypes() -> ConnectedClassTypes {
    let data: ConnectedClassTypes;
    let emptyData: ConnectedClassTypes;
    let aps = this.GetAccessPoints();
    let i = 0;
    while i < ArraySize(aps) {
      let processedData = emptyData;
      processedData = aps[i].CheckConnectedClassTypes();
      if Equals(processedData.surveillanceCamera, true) {
        data.surveillanceCamera = true;
      } else if Equals(processedData.securityTurret, true) {
        data.securityTurret = true;
      } else if Equals(processedData.puppet, true) {
        data.puppet = true;
      }
      i += 1;
    }
    return data;
  }

  public const func WasRevealedInNetworkPing() -> Bool {
    return this.m_wasRevealedInNetworkPing;
  }

  public const func SetRevealedInNetworkPing(wasRevealed: Bool) {
    if Equals(this.m_wasRevealedInNetworkPing, wasRevealed) {
      return;
    }
    let evt = new SetRevealedInNetwork();
    evt.wasRevealed = wasRevealed;
    this.QueuePSEvent(this.GetID(), this.GetClassName(), evt);
  }

  private final func OnSetRevealedInNetwork(evt: SetRevealedInNetwork) -> EntityNotificationType {
    if Equals(this.m_wasRevealedInNetworkPing, evt.wasRevealed) {
      return EntityNotificationType.DoNotNotifyEntity;
    }
    this.m_wasRevealedInNetworkPing = evt.wasRevealed;
    if this.HasNetworkBackdoor() {
      let notifyNetworkSystem = new MarkBackdoorAsRevealedRequest();
      notifyNetworkSystem.device = this;
      this.GetNetworkSystem().QueueRequest(notifyNetworkSystem);
    }
    return EntityNotificationType.SendThisEventToEntity;
  }

  public const func IsPuppet() -> Bool {
    return false;
  }
}

