class PerfectDischargePrereqListener extends ScriptStatPoolsListener {
  protected let m_state: wref<PerfectDischargePrereqState>;

  public final func RegisterState(state: PrereqState) {
    this.m_state = state as PerfectDischargePrereqState;
  }

  public func OnStatPoolValueChanged(oldValue: Float, newValue: Float, percToPoints: Float) {
    if IsDefined(this.m_state) {
      this.m_state.StatPoolUpdate(oldValue, newValue);
    }
  }
}

class PerfectDischargePrereqState extends StatPoolPrereqState {
  public let m_owner: wref<GameObject>;
  public let m_perfectDischargeListener: PerfectDischargePrereqListener;
  public let m_wasPerfectlyCharged: Bool;

  public func StatPoolUpdate(oldValue: Float, newValue: Float) {
    if !IsDefined(this.m_owner) {
      return;
    }
    let prereq = this.GetPrereq() as PerfectDischargePrereq;
    let weaponObject = ScriptedPuppet.GetActiveWeapon(this.m_owner);
    if !IsDefined(weaponObject) {
      return;
    }
    let game = weaponObject.GetGame();
    let player = GameInstance.GetPlayerSystem(game).GetLocalPlayerControlledGameObject();
    let perfectChargeWindow = GameInstance
      .GetStatsSystem(game)
      .GetStatValue(
        Cast<StatsObjectID>(player.GetEntityID()),
        gamedataStatType.PerfectChargeWindow
      );
    let perfectDischargeWindowEnd = weaponObject.GetMaxChargeTreshold();
    let perfectDischargeWindowStart = (100.0 - perfectChargeWindow) * perfectDischargeWindowEnd / 100.0;
    if oldValue == 0.0 || newValue == 0.0 {
      this.m_wasPerfectlyCharged = false;
    }
    let checkPassed = newValue >= perfectDischargeWindowStart && newValue < perfectDischargeWindowEnd - 1.0;
    checkPassed = prereq.AddTimeWindow(game, player, checkPassed, this);
    this.OnChanged(checkPassed ^ prereq.m_invert);
  }

  public func RegisterStatPoolListener(game: GameInstance, statPoolType: gamedataStatPoolType, valueToCheck: Float) {
    if StatsObjectID.IsDefined(this.m_statsObjID) {
      this.m_perfectDischargeListener = new PerfectDischargePrereqListener();
      this.m_perfectDischargeListener.RegisterState(this);
      GameInstance
        .GetStatPoolsSystem(game)
        .RequestRegisteringListener(this.m_statsObjID, statPoolType, this.m_perfectDischargeListener);
    }
  }

  public func UnregisterStatPoolListener(game: GameInstance, statPoolType: gamedataStatPoolType) {
    if IsDefined(this.m_perfectDischargeListener) {
      GameInstance
        .GetStatPoolsSystem(game)
        .RequestUnregisteringListener(this.m_statsObjID, statPoolType, this.m_perfectDischargeListener);
    }
    this.m_perfectDischargeListener = null;
  }
}

class PerfectDischargePrereq extends StatPoolPrereq {
  public let m_invert: Bool;

  protected const func OnRegister(state: PrereqState, game: GameInstance, context: IScriptable) -> Bool {
    let weaponObject = ScriptedPuppet.GetActiveWeapon(context as GameObject);
    if !IsDefined(weaponObject) {
      return false;
    }
    let castedState = state as PerfectDischargePrereqState;
    castedState.m_owner = context as GameObject;
    castedState.m_statsObjID = this.GetStatsObjectID(context as GameObject);
    castedState
      .RegisterStatPoolListener(game, this.m_statPoolType, this.GetValueToCheck(castedState));
    castedState.m_wasPerfectlyCharged = false;
    return false;
  }

  protected func Initialize(recordID: TweakDBID) {
    let record = TweakDBInterface.GetStatPoolPrereqRecord(recordID);
    this.m_invert = TweakDBInterface.GetBool(recordID + t".invert", false);
    this.m_statPoolType = gamedataStatPoolType.WeaponCharge;
    record.ValueToCheck(this.m_valueToCheck);
    this.m_comparisonType = IntEnum<EComparisonType>(Cast<Int32>(EnumValueFromName(n"EComparisonType", record.ComparisonType())));
    this.m_skipOnApply = TweakDBInterface.GetBool(recordID + t".skipOnApply", false);
    this.m_comparePercentage = TweakDBInterface.GetBool(recordID + t".comparePercentage", true);
    let objectToCheck = record.ObjectToCheck();
    if Equals(objectToCheck, n"Weapon") {
      this.m_objToCheck = ObjectToCheck.Weapon;
    } else {
      this.m_objToCheck = ObjectToCheck.Player;
    }
  }

  public const func IsFulfilled(game: GameInstance, context: IScriptable) -> Bool {
    return this
      .IsDischargePerfect(game, ScriptedPuppet.GetActiveWeapon(context as GameObject));
  }

  protected const func OnApplied(state: PrereqState, game: GameInstance, context: IScriptable) {
    if this.m_skipOnApply {
      return;
    }
    let castedState = state as PerfectDischargePrereqState;
    if GameInstance
      .GetStatPoolsSystem(game)
      .IsStatPoolAdded(castedState.m_statsObjID, gamedataStatPoolType.WeaponCharge) {
      let result = this
        .IsDischargePerfect(game, ScriptedPuppet.GetActiveWeapon(context as GameObject), castedState);
      castedState.OnChanged(result);
    }
  }

  protected const final func IsDischargePerfect(
    game: GameInstance,
    weaponObject: WeaponObject,
    opt state: PerfectDischargePrereqState
  ) -> Bool {
    let statPoolSystem = GameInstance.GetStatPoolsSystem(game);
    if !IsDefined(weaponObject) {
      return false;
    }
    let player = GameInstance.GetPlayerSystem(game).GetLocalPlayerControlledGameObject();
    let perfectChargeWindow = GameInstance
      .GetStatsSystem(weaponObject.GetGame())
      .GetStatValue(
        Cast<StatsObjectID>(player.GetEntityID()),
        gamedataStatType.PerfectChargeWindow
      );
    let chargeVal = statPoolSystem
      .GetStatPoolValue(
        Cast<StatsObjectID>(weaponObject.GetEntityID()),
        gamedataStatPoolType.WeaponCharge,
        false
      );
    let perfectDischargeWindowEnd = weaponObject.GetMaxChargeTreshold();
    let perfectDischargeWindowStart = (100.0 - perfectChargeWindow) * perfectDischargeWindowEnd / 100.0;
    let isDischargePerfect = chargeVal >= perfectDischargeWindowStart && chargeVal < perfectDischargeWindowEnd - 1.0;
    isDischargePerfect = this.AddTimeWindow(game, player, isDischargePerfect, state);
    return isDischargePerfect ^ this.m_invert;
  }

  public const final func AddTimeWindow(
    game: GameInstance,
    player: GameObject,
    isDischargePerfect: Bool,
    state: PerfectDischargePrereqState
  ) -> Bool {
    let statsSystem = GameInstance.GetStatsSystem(game);
    let canControlFullyChargedWeapon = statsSystem
      .GetStatBoolValue(
        Cast<StatsObjectID>(player.GetEntityID()),
        gamedataStatType.CanControlFullyChargedWeapon
      );
    if !IsDefined(state) || !canControlFullyChargedWeapon {
      return isDischargePerfect;
    } else if isDischargePerfect && !state.m_wasPerfectlyCharged {
      state.m_wasPerfectlyCharged = true;
    }
    return state.m_wasPerfectlyCharged;
  }
}

