  public const final func RecordHasTag(tag: CName) -> Bool {
    let vehicleRecord: Vehicle_Record;
    if !VehicleComponent.GetVehicleRecord(this, vehicleRecord) {
      return false;
    }
    return this.RecordHasTag(vehicleRecord, tag);
  }

  public const final func RecordHasTag(vehicleRecord: Vehicle_Record, tag: CName) -> Bool {
    let vehicleTags = vehicleRecord.Tags();
    if ArrayContains(vehicleTags, tag) {
      return true;
    }
    return false;
  }

