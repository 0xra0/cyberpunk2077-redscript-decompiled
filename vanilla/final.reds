  public func OnQuickHackAuthorization(evt: QuickHackAuthorization) -> EntityNotificationType {
    if this.IsConnectedToSecuritySystem() {
      this
        .GetSecuritySystem()
        .AuthorizeUser(evt.GetExecutor().GetEntityID(), ESecurityAccessLevel.ESL_4);
    } else {
      this.AddUser(evt.GetExecutor().GetEntityID(), ESecurityAccessLevel.ESL_4);
    }
    this.UseNotifier(evt);
    return EntityNotificationType.SendThisEventToEntity;
  }

