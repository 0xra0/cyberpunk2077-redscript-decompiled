  private final func CheckIfPreventionShouldReact(const damageDealers: script_ref<[wref<GameObject>]>) {
    let i = 0;
    while i < ArraySize(damageDealers) {
      if damageDealers[i].IsPlayer() {
        PreventionSystem
          .CreateNewPreventionDamageRequest(this.GetGame(), this, -1.0, gamedataAttackType.Direct, 1.0, true);
        return;
      }
      i += 1;
    }
  }

