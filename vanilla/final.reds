    return scriptInterface.GetActionValue(n"Forward")
      > 0.0
      && scriptInterface.GetActionStateTime(n"Forward") > threshold
      || scriptInterface.GetActionValue(n"Right") > 0.0 && scriptInterface.GetActionStateTime(n"Right") > threshold
      || scriptInterface.GetActionValue(n"Back") > 0.0 && scriptInterface.GetActionStateTime(n"Back") > threshold
      || scriptInterface.GetActionValue(n"Left") > 0.0 && scriptInterface.GetActionStateTime(n"Left") > threshold;
  }

