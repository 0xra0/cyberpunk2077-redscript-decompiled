  private const final func IsActionQueueEnabled() -> Bool {
    let playerPuppet = GetPlayer(this.GetGame());
    let disallowDeviceQhQueue = TDB.GetBool(t"NewPerks.Intelligence_Left_Milestone_2.disallowDeviceQhQueue");
    return !disallowDeviceQhQueue
      && QuickHackableQueueHelper.IsActionQueueEnabled(this.m_currentlyUploadingAction, playerPuppet);
  }

