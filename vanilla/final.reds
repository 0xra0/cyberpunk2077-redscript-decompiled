  }

  private const final func CheckVForVendettaAchievement(evt: TargetNeutraliziedEvent) {
    let dataTrackingSystem = GameInstance.GetScriptableSystemsContainer(this.GetGame()).Get(n"DataTrackingSystem") as DataTrackingSystem;
    let achievement = gamedataAchievement.VForVendetta;
    if !IsDefined(this.m_NPCDeathInstigator) || this.m_NPCDeathInstigator.GetEntityID() != evt.targetID {
      return;
    }
    let achievementRequest = new AddAchievementRequest();
    achievementRequest.achievement = achievement;
    dataTrackingSystem.QueueRequest(achievementRequest);
  }

  protected cb func OnProcessVendettaAchievementEvent(evt: ProcessVendettaAchievementEvent) -> Bool {
    this.StartProcessingVForVendettaAchievement(evt.deathInstigator);
  }

