  private final func CreateClearOutlinesRequest() {
    let request = new ClearOutlinesRequestEvent();
    GameInstance.GetDelaySystem(this.GetGame()).DelayEvent(this, request, 4.2);
  }

  private final func OnClearOutlinesRequest(evt: ClearOutlinesRequestEvent) {
    this.m_shouldBeRevealedStorage.ClearAllRequests();
    let i = 0;
    while i < ArraySize(this.m_listeners) {
      this.m_listeners[i].OnRevealedStateChanged(false);
      i += 1;
    }
  }

  protected cb func OnOutlineRequestEvent(evt: OutlineRequestEvent) -> Bool {
    if !ScriptedPuppet.IsAlive(this)
      && !ScriptedPuppet.IsDefeated(this)
      && NotEquals(evt.outlineRequest.GetRequestType(), EOutlineType.NONE) {
      return false;
    }
    super.OnOutlineRequestEvent(evt);
    this.PropagateOutlineToCurrentlyUsedItems(evt);
  }

  private final func PropagateOutlineToCurrentlyUsedItems(evt: OutlineRequestEvent) {
    let heldObjects: [ItemObject];
    if this.GetCurrentlyEquippedItems(heldObjects) {
      let i = 0;
      while i < ArraySize(heldObjects) {
        this.QueueEventForEntityID(heldObjects[i].GetEntityID(), evt);
        i += 1;
      }
    }
  }

  private final func PropagateFadeOutlinesRequestToItems() {
    let heldObjects: [ItemObject];
    if this.GetCurrentlyEquippedItems(heldObjects) {
      let fadeOutlineEvent = new ForceFadeOutlineEventForWeapon();
      let i = 0;
      while i < ArraySize(heldObjects) {
        this.QueueEventForEntityID(heldObjects[i].GetEntityID(), fadeOutlineEvent);
        i += 1;
      }
    }
  }

  private final func GetCurrentlyEquippedItems(heldObjects: script_ref<[ItemObject]>) -> Bool {
    let rightHandID = t"AttachmentSlots.WeaponRight";
    let leftHandID = t"AttachmentSlots.WeaponLeft";
    let rightHandItem = GameInstance.GetTransactionSystem(this.GetGame()).GetItemInSlot(this, rightHandID);
    let leftHandItem = GameInstance.GetTransactionSystem(this.GetGame()).GetItemInSlot(this, leftHandID);
    if IsDefined(rightHandItem) {
      ArrayPush(heldObjects, rightHandItem);
    } else if IsDefined(leftHandItem) {
      ArrayPush(heldObjects, leftHandItem);
    } else if ArraySize(heldObjects) > 0 {
      return true;
    }
    return false;
  }

  protected cb func OnToggleTargetingComponentsEvent(evt: ToggleTargetingComponentsEvent) -> Bool {
    let i = 0;
    while i < ArraySize(this.m_targetingComponentsArray) {
      let component = this.m_targetingComponentsArray[i];
      component.Toggle(evt.toggle);
      i += 1;
    }
  }

