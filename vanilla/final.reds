    return scriptInterface.IsMoveInputConsiderable();
  }

  protected const final func IsPlayerMoving(const stateContext: StateContext, const scriptInterface: StateGameScriptInterface) -> Bool {
    return this.IsPlayerMovingHorizontally(stateContext, scriptInterface) || this.IsPlayerMovingVertically(stateContext, scriptInterface);
  }

  protected const final func IsPlayerMovingHorizontally(const stateContext: StateContext, const scriptInterface: StateGameScriptInterface) -> Bool {
    let playerVelocity = DefaultTransition.GetLinearVelocity(scriptInterface);
    let horizontalSpeed = Vector4.Length2D(playerVelocity);
    return horizontalSpeed > 0.0;
  }

  protected const final func IsPlayerMovingVertically(const stateContext: StateContext, const scriptInterface: StateGameScriptInterface) -> Bool {
    let verticalSpeed = this.GetVerticalSpeed(scriptInterface);
    return verticalSpeed > 0.0 || verticalSpeed < 0.0;
  }

  protected const final func IsPlayerMovingBackwards(const stateContext: StateContext, const scriptInterface: StateGameScriptInterface) -> Bool {
    let movementDirection = this.GetHorizontalMovementDirection(stateContext, scriptInterface);
    if movementDirection
      >= 135.0
      && movementDirection <= 180.0
      || movementDirection <= -135.0 && movementDirection >= -180.0 {
      return true;
    }
    return false;
  }

  protected const final func GetHorizontalMovementDirection(const stateContext: StateContext, const scriptInterface: StateGameScriptInterface) -> Float {
    let linearVel = DefaultTransition.GetLinearVelocity(scriptInterface);
    let playerForward = scriptInterface.executionOwner.GetWorldForward();
    return Vector4
      .GetAngleDegAroundAxis(linearVel, playerForward, DefaultTransition.GetUpVector());
  }

