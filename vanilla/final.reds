class ArmorEquipInventoryItemController extends inkButtonDpadSupportedController {
  protected let m_itemID: ItemID;
  protected let m_itemData: gameItemData;
  protected let m_empty: Bool;

  protected cb func OnInitialize() -> Bool {
    super.OnInitialize();
  }

  public final func ClearButton() {
    this.m_rootWidget = this.GetRootWidget() as inkCanvas;
    let displayName = this.m_rootWidget.GetWidget(n"textLabel") as inkText;
    let quality = this.m_rootWidget.GetWidget(n"rarityLabel") as inkText;
    let statValue = this.m_rootWidget.GetWidget(n"summaryLabel") as inkText;
    let statName = this.m_rootWidget.GetWidget(n"summarySubText") as inkText;
    let quantity = this.m_rootWidget.GetWidget(n"txtQuantity") as inkText;
    let currListIcon = this.m_rootWidget.GetWidget(n"icon") as inkImage;
    let qualityBg = this.m_rootWidget.GetWidget(n"quality") as inkRectangle;
    qualityBg.SetVisible(false);
    displayName.SetText("");
    quality.SetText("");
    statValue.SetText("");
    statName.SetText("");
    quantity.SetText("");
    currListIcon.SetTexturePart(n"none");
    currListIcon.SetVisible(false);
    this.m_empty = true;
  }

  public final func SetButtonDetails(itemData: gameItemData, itemQuantity: Int32, disassemblable: Bool) {
    let diss: String;
    this.m_rootWidget = this.GetRootWidget() as inkCanvas;
    let displayName = this.m_rootWidget.GetWidget(n"textLabel") as inkText;
    let quality = this.m_rootWidget.GetWidget(n"rarityLabel") as inkText;
    let statValue = this.m_rootWidget.GetWidget(n"summaryLabel") as inkText;
    let statName = this.m_rootWidget.GetWidget(n"summarySubText") as inkText;
    let currListIcon = this.m_rootWidget.GetWidget(n"icon") as inkImage;
    let quantity = this.m_rootWidget.GetWidget(n"txtQuantity") as inkText;
    let qualityBg = this.m_rootWidget.GetWidget(n"quality") as inkRectangle;
    this.m_itemData = itemData;
    this.m_itemID = itemData.GetID();
    let itemRecord = TweakDBInterface.GetItemRecord(ItemID.GetTDBID(this.m_itemID));
    let itemName = itemRecord.DisplayName();
    let itemNameString = NameToString(itemName);
    if disassemblable {
      diss = " [D]";
    } else {
      diss = "";
    }
    displayName.SetText(itemNameString + diss);
    quality.SetText(itemRecord.Quality().Name());
    statValue.SetText("");
    statName.SetText("");
    if itemQuantity > 1 {
      quantity.SetText(IntToString(itemQuantity));
    } else {
      quantity.SetText("");
    }
    itemName = itemRecord.DisplayName();
    currListIcon.SetVisible(false);
    this.m_empty = false;
    let color = StringToName(itemRecord.Quality().Name());
    displayName.SetState(color);
    quality.SetState(color);
    quantity.SetState(color);
    if NotEquals(color, n"Poor") && NotEquals(color, n"Common") {
      qualityBg.SetState(color);
      qualityBg.SetVisible(true);
    } else if currListIcon.IsTexturePartExist(itemName) {
      currListIcon.SetTexturePart(itemName);
      currListIcon.SetVisible(true);
    }
    currListIcon.SetTexturePart(n"none");
    currListIcon.SetVisible(true);
    if Equals(itemName, n"None") {
      currListIcon.SetTexturePart(n"undefined");
      quality.SetText("!Undefined item");
      displayName.SetText("!No name defined");
      currListIcon.SetVisible(true);
    }
  }

  public final func GetItemData() -> gameItemData {
    return this.m_itemData;
  }

  public final func GetItemID() -> ItemID {
    return this.m_itemID;
  }

  public final func GetIsEmpty() -> Bool {
    return this.m_empty;
  }
}

