    if isFocusOn == 0 {
      return false;
    }
    return false;
  }
}

class GrappleForceShovePreyDecisions extends GrappleStandDecisions {
  protected const final func EnterCondition(const stateContext: StateContext, const scriptInterface: StateGameScriptInterface) -> Bool {
    let scriptedPuppet = this.stateMachineInitData.target as ScriptedPuppet;
    if scriptedPuppet.IsUnderwater()
      && !GameInstance
        .GetAINavigationSystem(scriptedPuppet.GetGame())
        .IsPointOnNavmesh(scriptedPuppet, scriptedPuppet.GetWorldPosition(), 2.5) {
      return true;
    } else if Equals(this.stateMachineInitData.actionName, n"ForceShove") {
      return true;
    } else if scriptInterface.localBlackboard.GetInt(GetAllBlackboardDefs().PlayerStateMachine.Fall) == 3 {
      return true;
    }
    return false;
  }
}

