  private final func ProcessScriptCondition(
    description: BluelineDescription,
    scriptCondition: IScriptable,
    playerObject: GameObject
  ) {
    let bluelineCondition = scriptCondition as BluelineConditionTypeBase;
    if IsDefined(bluelineCondition) {
      ArrayPush(description.parts, bluelineCondition.GetBluelinePart(playerObject));
    }
  }

  private final func AsConjunction(description: BluelineDescription) {
    description.m_logicOperator = ELogicOperator.AND;
  }

  private final func AsDisjunction(description: BluelineDescription) {
    description.m_logicOperator = ELogicOperator.OR;
  }
}

