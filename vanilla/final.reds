class HitIsTheSameTargetPrereqState extends GenericHitPrereqState {
  public let m_previousTarget: wref<GameObject>;
  public let m_previousSource: wref<GameObject>;
  public let m_previousWeapon: wref<WeaponObject>;

  public func Evaluate(hitEvent: gameHitEvent) -> Bool {
    let prereq = this.GetPrereq() as HitIsTheSameTargetPrereq;
    if !hitEvent.target.IsActive() {
      return true;
    } else if !IsDefined(this.m_previousTarget) || !IsDefined(this.m_previousSource) || !IsDefined(this.m_previousWeapon) {
      this.m_previousTarget = hitEvent.target;
      this.m_previousSource = hitEvent.attackData.GetSource();
      this.m_previousWeapon = hitEvent.attackData.GetWeapon();
      return false;
    }
    let checkPassed = this.m_previousTarget
      == hitEvent.target
      && this.m_previousSource == hitEvent.attackData.GetSource()
      && this.m_previousWeapon == hitEvent.attackData.GetWeapon();
    if !checkPassed {
      this.m_previousTarget = hitEvent.target;
      this.m_previousSource = hitEvent.attackData.GetSource();
      this.m_previousWeapon = hitEvent.attackData.GetWeapon();
    } else if prereq.m_invert {
      checkPassed = !checkPassed;
    }
    return checkPassed;
  }
}

