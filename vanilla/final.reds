}

class RadialSlot extends IScriptable {
  public let slotAnchorRef: inkWidgetRef;
  public let libraryRef: inkWidgetLibraryReference;
  public let slotType: SlotType;
  protected let animData: RadialAnimData;
  private let widget: wref<inkWidget>;
  private let targetAngle: Float;
  private let active: String;
  private let inactive: String;
  private let blocked: String;

  public final func Construct(w: wref<inkWidget>) {
    this.widget = w;
  }

  public const final func GetWidget() -> wref<inkWidget> {
    return this.widget;
  }

  public const func IsCyclable() -> Bool {
    return false;
  }

  public const func CanCycle() -> Bool {
    return false;
  }

  public const final func GetAngle() -> Float {
    return this.targetAngle;
  }

  public const func GetDebugInfo(out info: [String]) {
    ArrayPush(info, EnumValueToString("SlotType", Cast<Int64>(EnumInt(this.slotType))));
    ArrayPush(info, FloatToString(this.targetAngle));
    ArrayPush(info, "--------------------------------");
  }

  public final func Activate() {
    inkWidgetRef.Get(this.slotAnchorRef).SetState(StringToName(this.active));
    this.Activate(true);
  }

  public final func Deactivate() {
    inkWidgetRef.Get(this.slotAnchorRef).SetState(StringToName(this.inactive));
    this.Activate(false);
  }

  public final func SetTargetAngle(precalculatedAngle: Float) {
    this.targetAngle = precalculatedAngle;
  }

  protected func Activate(shouldActivate: Bool) {
    let controller = this.GetWidget().GetController();
    if !IsDefined(controller) {
      return;
    } else if shouldActivate {
      controller.PlayLibraryAnimation(this.animData.hover_in);
      controller.PlaySound(n"Button", n"OnHover");
    }
    controller.PlayLibraryAnimation(this.animData.hover_out);
  }
}

struct RadialAnimData {
  public let hover_in: CName;
  public let hover_out: CName;
  public let cycle_in: CName;
  public let cycle_out: CName;
}

