class StatPoolChangeOverTimePrereq extends IScriptablePrereq {
  public let m_statPoolType: gamedataStatPoolType;
  public let m_timeFrame: Float;
  public let m_valueToCheck: Float;
  public let m_comparePercentage: Bool;
  public let m_checkGain: Bool;

  protected const func OnRegister(state: PrereqState, game: GameInstance, context: IScriptable) -> Bool {
    let castedState = state as StatPoolChangeOverTimePrereqState;
    castedState.m_comparePercentage = this.m_comparePercentage;
    castedState.m_checkGain = this.m_checkGain;
    castedState.m_timeFrame = this.m_timeFrame;
    castedState.m_valueToCheck = this.m_valueToCheck;
    let owner = context as GameObject;
    castedState.RegisterStatPoolListener(game, this.m_statPoolType, owner.GetEntityID());
    return false;
  }

  protected const func OnUnregister(state: PrereqState, game: GameInstance, context: IScriptable) {
    let castedState = state as StatPoolChangeOverTimePrereqState;
    castedState.UnregisterStatPoolListener(game, this.m_statPoolType);
  }

  protected func Initialize(record: TweakDBID) {
    this.m_statPoolType = IntEnum<gamedataStatPoolType>(
      Cast<Int32>(
        EnumValueFromName(
          n"gamedataStatPoolType",
          TweakDBInterface.GetCName(record + t".statPoolType", n"Health")
        )
      )
    );
    this.m_comparePercentage = TweakDBInterface.GetBool(record + t".comparePercentage", true);
    this.m_valueToCheck = TweakDBInterface.GetFloat(record + t".valueToCheck", 50.0);
    this.m_timeFrame = TweakDBInterface.GetFloat(record + t".timeFrame", 3.0);
    this.m_checkGain = TweakDBInterface.GetBool(record + t".checkGain", false);
  }
}

