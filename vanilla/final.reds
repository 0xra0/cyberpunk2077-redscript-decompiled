class BaseHitPrereqCondition extends IScriptable {
  public let m_invert: Bool;
  public let m_onlyOncePerShot: Bool;
  public let m_lastAttackTime: Float;

  public func SetData(recordID: TweakDBID) {
    this.m_invert = TweakDBInterface.GetBool(recordID + t".invert", false);
    this.m_onlyOncePerShot = TweakDBInterface.GetBool(recordID + t".onlyOncePerShot", false);
  }

  public func Evaluate(hitEvent: gameHitEvent) -> Bool {
    return false;
  }

  public func OnMissTriggered(missEvent: gameMissEvent);

  protected final func GetObjectToCheck(obj: CName, hitEvent: gameHitEvent) -> wref<GameObject> {
    switch obj {
      case n"Instigator":
        return hitEvent.attackData.GetInstigator();
      case n"Source":
        return hitEvent.attackData.GetSource();
      case n"Target":
        return hitEvent.target;
      case n"Weapon":
        return hitEvent.attackData.GetWeapon();
    }
    return null;
  }

  protected final func CheckOnlyOncePerShot(hitEvent: gameHitEvent) -> Bool {
    if !this.m_onlyOncePerShot {
      return true;
    }
    let attackTime = hitEvent.attackData.GetAttackTime();
    if attackTime > this.m_lastAttackTime {
      this.m_lastAttackTime = attackTime;
      return true;
    }
    return false;
  }
}

class AttackSubtypeHitPrereqCondition extends BaseHitPrereqCondition {
  public let m_attackSubtype: gamedataAttackSubtype;

  public func SetData(recordID: TweakDBID) {
    let str = TweakDBInterface.GetString(recordID + t".attackSubtype", "");
    let result = IntEnum<gamedataAttackSubtype>(Cast<Int32>(EnumValueFromString("gamedataAttackSubtype", str)));
    if EnumInt(result) < 0 {
      this.m_attackSubtype = gamedataAttackSubtype.Invalid;
    } else {
      this.m_attackSubtype = result;
    }
    super.SetData(recordID);
  }

  public func Evaluate(hitEvent: gameHitEvent) -> Bool {
    let result = Equals(hitEvent.attackData.GetAttackSubtype(), this.m_attackSubtype);
    if result {
      result = this.CheckOnlyOncePerShot(hitEvent);
    }
    return this.m_invert ? !result : result;
  }
}

class AttackTypeHitPrereqCondition extends BaseHitPrereqCondition {
  public let m_attackType: gamedataAttackType;

  public func SetData(recordID: TweakDBID) {
    let str = TweakDBInterface.GetString(recordID + t".attackType", "");
    let result = IntEnum<gamedataAttackType>(Cast<Int32>(EnumValueFromString("gamedataAttackType", str)));
    if EnumInt(result) < 0 {
      this.m_attackType = gamedataAttackType.Invalid;
    } else {
      this.m_attackType = result;
    }
    super.SetData(recordID);
  }

  public func Evaluate(hitEvent: gameHitEvent) -> Bool {
    let result = Equals(hitEvent.attackData.GetAttackType(), this.m_attackType);
    if result {
      result = this.CheckOnlyOncePerShot(hitEvent);
    }
    return this.m_invert ? !result : result;
  }
}

class AttackTagHitPrereqCondition extends BaseHitPrereqCondition {
  public let m_attackTag: CName;

  public func SetData(recordID: TweakDBID) {
    this.m_attackTag = TweakDBInterface.GetCName(recordID + t".attackTag", n"None");
    super.SetData(recordID);
  }

  public func Evaluate(hitEvent: gameHitEvent) -> Bool {
    let attackRecord = hitEvent.attackData.GetAttackDefinition().GetRecord() as Attack_GameEffect_Record;
    let result = Equals(attackRecord.AttackTag(), this.m_attackTag);
    return this.m_invert ? !result : result;
  }
}

class BodyPartHitPrereqCondition extends BaseHitPrereqCondition {
  public let m_bodyPart: CName;
  public let m_attackSubtype: gamedataAttackSubtype;

  public func SetData(recordID: TweakDBID) {
    this.m_bodyPart = TweakDBInterface.GetCName(recordID + t".bodyPart", n"None");
    super.SetData(recordID);
  }

  public func Evaluate(hitEvent: gameHitEvent) -> Bool {
    let empty: HitShapeData;
    let shape = hitEvent.hitRepresentationResult.hitShapes[0];
    if NotEquals(shape, empty) {
      switch this.m_bodyPart {
        case n"Head":
          let result = HitShapeUserDataBase.IsHitReactionZoneHead(shape.userData as HitShapeUserDataBase);
          break;
        case n"Torso":
          result = HitShapeUserDataBase.IsHitReactionZoneTorso(shape.userData as HitShapeUserDataBase);
          break;
        case n"Limb":
          result = HitShapeUserDataBase.IsHitReactionZoneLimb(shape.userData as HitShapeUserDataBase);
          break;
        case n"LeftArm":
          result = HitShapeUserDataBase.IsHitReactionZoneLeftArm(shape.userData as HitShapeUserDataBase);
          break;
        case n"RightArm":
          result = HitShapeUserDataBase.IsHitReactionZoneRightArm(shape.userData as HitShapeUserDataBase);
          break;
        case n"Arm":
          result = HitShapeUserDataBase.IsHitReactionZoneArm(shape.userData as HitShapeUserDataBase);
          break;
        case n"LeftLeg":
          result = HitShapeUserDataBase.IsHitReactionZoneLeftLeg(shape.userData as HitShapeUserDataBase);
          break;
        case n"RightLeg":
          result = HitShapeUserDataBase.IsHitReactionZoneRightLeg(shape.userData as HitShapeUserDataBase);
          break;
        case n"Leg":
          result = HitShapeUserDataBase.IsHitReactionZoneLeg(shape.userData as HitShapeUserDataBase);
          break;
        default:
          return false;
      }
      if result {
        result = this.CheckOnlyOncePerShot(hitEvent);
      }
      return this.m_invert ? !result : result;
    }
    return false;
  }
}

class DamageOverTimeTypeHitPrereqCondition extends BaseHitPrereqCondition {
  public let m_dotType: gamedataStatusEffectType;

  public func SetData(recordID: TweakDBID) {
    let str = TweakDBInterface.GetString(recordID + t".dotType", "");
    this.m_dotType = IntEnum<gamedataStatusEffectType>(Cast<Int32>(EnumValueFromString("gamedataStatusEffectType", str)));
    super.SetData(recordID);
  }

  public func Evaluate(hitEvent: gameHitEvent) -> Bool {
    if Equals(hitEvent.attackData.GetAttackType(), gamedataAttackType.Effect) {
      let attackRecord = hitEvent.attackData.GetAttackDefinition().GetRecord() as Attack_GameEffect_Record;
      if IsDefined(attackRecord) {
        let attackTag = attackRecord.AttackTag();
      }
      let result = Equals(
        IntEnum<gamedataStatusEffectType>(Cast<Int32>(EnumValueFromName(n"gamedataStatusEffectType", attackTag))),
        this.m_dotType
      );
      if result {
        result = this.CheckOnlyOncePerShot(hitEvent);
      }
      return this.m_invert ? !result : result;
    }
    return false;
  }
}

class DamageTypeHitPrereqCondition extends BaseHitPrereqCondition {
  public let m_damageType: gamedataDamageType;

  public func SetData(recordID: TweakDBID) {
    let str = TweakDBInterface.GetString(recordID + t".damageType", "");
    this.m_damageType = IntEnum<gamedataDamageType>(Cast<Int32>(EnumValueFromString("gamedataDamageType", str)));
    super.SetData(recordID);
  }

  public func Evaluate(hitEvent: gameHitEvent) -> Bool {
    let result = hitEvent.attackComputed.GetAttackValue(this.m_damageType) > 0.0;
    if result {
      result = this.CheckOnlyOncePerShot(hitEvent);
    }
    return this.m_invert ? !result : result;
  }
}

class DistanceCoveredHitPrereqCondition extends BaseHitPrereqCondition {
  public let m_distanceRequired: Float;
  public let m_comparisonType: EComparisonType;

  public func SetData(recordID: TweakDBID) {
    this.m_distanceRequired = TweakDBInterface.GetFloat(recordID + t".distanceRequired", 0.0);
    let str = TweakDBInterface.GetString(recordID + t".comparisonType", "");
    this.m_comparisonType = IntEnum<EComparisonType>(Cast<Int32>(EnumValueFromString("EComparisonType", str)));
    super.SetData(recordID);
  }

  public func Evaluate(hitEvent: gameHitEvent) -> Bool {
    if IsDefined(hitEvent) {
      let distanceCovered = Vector4
        .Distance(hitEvent.attackData.GetAttackPosition(), hitEvent.target.GetWorldPosition());
      let result = ProcessCompare(this.m_comparisonType, distanceCovered, this.m_distanceRequired);
      if result {
        result = this.CheckOnlyOncePerShot(hitEvent);
      }
      return this.m_invert ? !result : result;
    }
    return false;
  }
}

public func ProcessCompare(comparator: EComparisonType, valA: Float, valB: Float) -> Bool {
  switch comparator {
    case EComparisonType.Greater:
      return valA > valB;
    case EComparisonType.GreaterOrEqual:
      return valA >= valB;
    case EComparisonType.Equal:
      return valA == valB;
    case EComparisonType.NotEqual:
      return valA != valB;
    case EComparisonType.Less:
      return valA < valB;
  }
  return valA <= valB;
}

class HitFlagHitPrereqCondition extends BaseHitPrereqCondition {
  public let m_hitFlag: hitFlag;
  public let m_invertHitFlag: Bool;

  public func SetData(recordID: TweakDBID) {
    let str = TweakDBInterface.GetString(recordID + t".hitFlag", "");
    this.m_hitFlag = IntEnum<hitFlag>(Cast<Int32>(EnumValueFromString("hitFlag", str)));
    this.m_invertHitFlag = TweakDBInterface.GetBool(recordID + t".invertHitFlag", false);
    super.SetData(recordID);
  }

  public func Evaluate(hitEvent: gameHitEvent) -> Bool {
    let result = hitEvent.attackData.HasFlag(this.m_hitFlag);
    if this.m_invertHitFlag {
      result = !result;
    } else if result {
      result = this.CheckOnlyOncePerShot(hitEvent);
    }
    return this.m_invert ? !result : result;
  }
}

class InstigatorTypeHitPrereqCondition extends BaseHitPrereqCondition {
  public let m_instigatorType: CName;

  public func SetData(recordID: TweakDBID) {
    this.m_instigatorType = TweakDBInterface.GetCName(recordID + t".instigatorType", n"None");
    super.SetData(recordID);
  }

  public func Evaluate(hitEvent: gameHitEvent) -> Bool {
    let result: Bool;
    switch this.m_instigatorType {
      case n"Player":
        result = IsDefined(hitEvent.attackData.GetInstigator() as PlayerPuppet);
        break;
      case n"Puppet":
        result = IsDefined(hitEvent.attackData.GetInstigator() as ScriptedPuppet);
        break;
      default:
        return false;
    }
    if result {
      result = this.CheckOnlyOncePerShot(hitEvent);
    }
    return this.m_invert ? !result : result;
  }
}

class SameTargetHitPrereqCondition extends BaseHitPrereqCondition {
  public let m_previousTarget: wref<GameObject>;
  public let m_previousSource: wref<GameObject>;
  public let m_previousWeapon: wref<WeaponObject>;

  public func Evaluate(hitEvent: gameHitEvent) -> Bool {
    let attackType = hitEvent.attackData.GetAttackType();
    if !hitEvent.target.IsActive() && NotEquals(attackType, gamedataAttackType.Effect) {
      return true;
    } else if (!IsDefined(this.m_previousTarget) || !IsDefined(this.m_previousSource) || !IsDefined(this.m_previousWeapon)) && NotEquals(attackType, gamedataAttackType.Effect) {
      this.m_previousTarget = hitEvent.target;
      this.m_previousSource = hitEvent.attackData.GetSource();
      this.m_previousWeapon = hitEvent.attackData.GetWeapon();
      return false;
    }
    let checkPassed = this.m_previousTarget
      == hitEvent.target
      && this.m_previousSource == hitEvent.attackData.GetSource()
      && this.m_previousWeapon == hitEvent.attackData.GetWeapon();
    if !checkPassed && NotEquals(attackType, gamedataAttackType.Effect) {
      this.m_previousTarget = hitEvent.target;
      this.m_previousSource = hitEvent.attackData.GetSource();
      this.m_previousWeapon = hitEvent.attackData.GetWeapon();
    } else if checkPassed && NotEquals(attackType, gamedataAttackType.Effect) {
      checkPassed = this.CheckOnlyOncePerShot(hitEvent);
    }
    return this.m_invert ? !checkPassed : checkPassed;
  }
}

class SourceTypeHitPrereqCondition extends BaseHitPrereqCondition {
  public let m_source: CName;

  public func SetData(recordID: TweakDBID) {
    this.m_source = TweakDBInterface.GetCName(recordID + t".source", n"None");
    super.SetData(recordID);
  }

  public func Evaluate(hitEvent: gameHitEvent) -> Bool {
    let result: Bool;
    let target = hitEvent.target as ScriptedPuppet;
    if !IsDefined(target) {
      return false;
    }
    switch this.m_source {
      case n"Grenade":
        result = IsDefined(hitEvent.attackData.GetSource() as WeaponGrenade);
        break;
      default:
        return false;
    }
    if result {
      result = this.CheckOnlyOncePerShot(hitEvent);
    }
    return this.m_invert ? !result : result;
  }
}

class StatPoolHitPrereqCondition extends BaseHitPrereqCondition {
  public let m_valueToCheck: Float;
  public let m_objectToCheck: CName;
  public let m_comparisonType: EComparisonType;
  public let m_statPoolToCompare: gamedataStatPoolType;

  protected func SetData(recordID: TweakDBID) {
    this.m_objectToCheck = TweakDBInterface.GetCName(recordID + t".objectToCheck", n"None");
    this.m_valueToCheck = TweakDBInterface.GetFloat(recordID + t".valueToCheck", 0.0);
    let str = TweakDBInterface.GetString(recordID + t".statPoolToCompare", "");
    this.m_statPoolToCompare = IntEnum<gamedataStatPoolType>(Cast<Int32>(EnumValueFromString("gamedataStatPoolType", str)));
    str = TweakDBInterface.GetString(recordID + t".comparisonType", "");
    this.m_comparisonType = IntEnum<EComparisonType>(Cast<Int32>(EnumValueFromString("EComparisonType", str)));
    super.SetData(recordID);
  }

  public func Evaluate(hitEvent: gameHitEvent) -> Bool {
    let result = this.ComparePoolValues(hitEvent);
    if result {
      result = this.CheckOnlyOncePerShot(hitEvent);
    }
    return this.m_invert ? !result : result;
  }

  private final func ComparePoolValues(hitEvent: gameHitEvent) -> Bool {
    let obj = this.GetObjectToCheck(this.m_objectToCheck, hitEvent);
    if !IsDefined(obj) {
      return false;
    }
    let sps = GameInstance.GetStatPoolsSystem(obj.GetGame());
    let poolValue = sps
      .GetStatPoolValue(Cast<StatsObjectID>(obj.GetEntityID()), this.m_statPoolToCompare);
    return ProcessCompare(this.m_comparisonType, poolValue, this.m_valueToCheck);
  }
}

class StatPoolComparisonHitPrereqCondition extends BaseHitPrereqCondition {
  public let m_comparisonSource: CName;
  public let m_comparisonTarget: CName;
  public let m_comparisonType: EComparisonType;
  public let m_statPoolToCompare: gamedataStatPoolType;

  protected func SetData(recordID: TweakDBID) {
    this.m_comparisonSource = TweakDBInterface.GetCName(recordID + t".comparisonSource", n"None");
    this.m_comparisonTarget = TweakDBInterface.GetCName(recordID + t".comparisonTarget", n"None");
    let str = TweakDBInterface.GetString(recordID + t".statPoolToCompare", "");
    this.m_statPoolToCompare = IntEnum<gamedataStatPoolType>(Cast<Int32>(EnumValueFromString("gamedataStatPoolType", str)));
    str = TweakDBInterface.GetString(recordID + t".comparisonType", "");
    this.m_comparisonType = IntEnum<EComparisonType>(Cast<Int32>(EnumValueFromString("EComparisonType", str)));
    super.SetData(recordID);
  }

  public func Evaluate(hitEvent: gameHitEvent) -> Bool {
    let result = this.ComparePoolValues(hitEvent);
    if result {
      result = this.CheckOnlyOncePerShot(hitEvent);
    }
    return this.m_invert ? !result : result;
  }

  private final func ComparePoolValues(hitEvent: gameHitEvent) -> Bool {
    let source = this.GetObjectToCheck(this.m_comparisonSource, hitEvent);
    let target = this.GetObjectToCheck(this.m_comparisonTarget, hitEvent);
    if !IsDefined(source) || !IsDefined(target) {
      return false;
    }
    let sps = GameInstance.GetStatPoolsSystem(source.GetGame());
    let sourcePoolValue = sps
      .GetStatPoolValue(Cast<StatsObjectID>(source.GetEntityID()), this.m_statPoolToCompare);
    let targetPoolValue = sps
      .GetStatPoolValue(Cast<StatsObjectID>(target.GetEntityID()), this.m_statPoolToCompare);
    return ProcessCompare(this.m_comparisonType, sourcePoolValue, targetPoolValue);
  }
}

class StatHitPrereqCondition extends BaseHitPrereqCondition {
  public let m_valueToCheck: Float;
  public let m_objectToCheck: CName;
  public let m_comparisonType: EComparisonType;
  public let m_statToCompare: gamedataStatType;

  protected func SetData(recordID: TweakDBID) {
    this.m_objectToCheck = TweakDBInterface.GetCName(recordID + t".objectToCheck", n"None");
    this.m_valueToCheck = TweakDBInterface.GetFloat(recordID + t".valueToCheck", 0.0);
    let str = TweakDBInterface.GetString(recordID + t".statToCompare", "");
    this.m_statToCompare = IntEnum<gamedataStatType>(Cast<Int32>(EnumValueFromString("gamedataStatType", str)));
    str = TweakDBInterface.GetString(recordID + t".comparisonType", "");
    this.m_comparisonType = IntEnum<EComparisonType>(Cast<Int32>(EnumValueFromString("EComparisonType", str)));
    super.SetData(recordID);
  }

  public func Evaluate(hitEvent: gameHitEvent) -> Bool {
    let result = this.CompareValues(hitEvent);
    if result {
      result = this.CheckOnlyOncePerShot(hitEvent);
    }
    return this.m_invert ? !result : result;
  }

  private final func CompareValues(hitEvent: gameHitEvent) -> Bool {
    let obj = this.GetObjectToCheck(this.m_objectToCheck, hitEvent);
    if !IsDefined(obj) {
      return false;
    }
    let ss = GameInstance.GetStatsSystem(obj.GetGame());
    let statValue = ss.GetStatValue(Cast<StatsObjectID>(obj.GetEntityID()), this.m_statToCompare);
    return ProcessCompare(this.m_comparisonType, statValue, this.m_valueToCheck);
  }
}

class StatusEffectPresentHitPrereqCondition extends BaseHitPrereqCondition {
  public let m_checkType: gamedataCheckType;
  public let m_statusEffectParam: CName;
  public let m_tag: CName;
  public let m_objectToCheck: CName;

  public func SetData(recordID: TweakDBID) {
    this.m_statusEffectParam = TweakDBInterface.GetCName(recordID + t".statusEffect", n"None");
    this.m_checkType = TweakDBInterface
      .GetCheckTypeRecord(TweakDBInterface.GetForeignKeyDefault(recordID + t".checkType"))
      .Type();
    this.m_tag = TweakDBInterface.GetCName(recordID + t".tagToCheck", n"None");
    this.m_objectToCheck = TweakDBInterface.GetCName(recordID + t".objectToCheck", n"None");
    super.SetData(recordID);
  }

  public func Evaluate(hitEvent: gameHitEvent) -> Bool {
    let result: Bool;
    let objectToCheck = this.GetObjectToCheck(this.m_objectToCheck, hitEvent) as gamePuppet;
    if IsDefined(objectToCheck) {
      switch this.m_checkType {
        case gamedataCheckType.Tag:
          result = StatusEffectSystem.ObjectHasStatusEffectWithTag(objectToCheck, this.m_tag);
          break;
        case gamedataCheckType.Type:
          let statusEffectType = IntEnum<gamedataStatusEffectType>(
            Cast<Int32>(
              EnumValueFromName(n"gamedataStatusEffectType", this.m_statusEffectParam)
            )
          );
          result = StatusEffectSystem.ObjectHasStatusEffectOfType(objectToCheck, statusEffectType);
          break;
        case gamedataCheckType.Record:
          result = StatusEffectSystem
            .ObjectHasStatusEffect(
              objectToCheck,
              TDBID
                .Create("BaseStatusEffect." + NameToString(this.m_statusEffectParam))
            );
          break;
        default:
          return false;
      }
    } else if result {
      result = this.CheckOnlyOncePerShot(hitEvent);
    }
    return this.m_invert ? !result : result;
  }
}

importonly native class CheckType_Record extends TweakDBRecord {
  public final native func EnumName() -> String;

  public final native func EnumComment() -> String;

  public final native func Type() -> gamedataCheckType;
}

class TargetNPCIsCrowdHitPrereqCondition extends BaseHitPrereqCondition {
  public func Evaluate(hitEvent: gameHitEvent) -> Bool {
    let target = hitEvent.target as ScriptedPuppet;
    if IsDefined(target) && target.IsCrowd() {
      return !this.m_invert;
    }
    return this.m_invert;
  }
}

class TargetKilledHitPrereqCondition extends BaseHitPrereqCondition {
  private let m_lastTarget: wref<GameObject>;

  public func Evaluate(hitEvent: gameHitEvent) -> Bool {
    let target = hitEvent.target as NPCPuppet;
    if !IsDefined(target) || this.m_lastTarget == target {
      return false;
    }
    let result = target.WasJustKilledOrDefeated() || target.IsAboutToDieOrDefeated();
    if result {
      this.m_lastTarget = target;
      result = this.CheckOnlyOncePerShot(hitEvent);
    }
    return this.m_invert ? !result : result;
  }
}

class TargetCanGetKilledByDamagePrereqCondition extends BaseHitPrereqCondition {
  private let m_lastTarget: wref<GameObject>;

  public func Evaluate(hitEvent: gameHitEvent) -> Bool {
    let target = hitEvent.target as NPCPuppet;
    if !IsDefined(target) || this.m_lastTarget == target {
      return false;
    }
    let targetHealthPercent = GameInstance
      .GetStatPoolsSystem(target.GetGame())
      .GetStatPoolValue(
        Cast<StatsObjectID>(hitEvent.target.GetEntityID()),
        gamedataStatPoolType.Health
      );
    let targetMaxHealth = GameInstance
      .GetStatsSystem(target.GetGame())
      .GetStatValue(Cast<StatsObjectID>(hitEvent.target.GetEntityID()), gamedataStatType.Health);
    let targetHealth = targetMaxHealth * targetHealthPercent / 100.0;
    let damage = hitEvent.attackComputed.GetTotalAttackValue(gamedataStatPoolType.Health);
    let result = damage > 0.0 && damage >= targetHealth;
    if result {
      this.m_lastTarget = target;
      result = this.CheckOnlyOncePerShot(hitEvent);
    }
    return this.m_invert ? !result : result;
  }
}

class TargetBreachCanGetKilledByDamagePrereqCondition extends BaseHitPrereqCondition {
  private let m_lastTarget: wref<GameObject>;

  public func Evaluate(hitEvent: gameHitEvent) -> Bool {
    let target = hitEvent.target;
    if !IsDefined(target) || this.m_lastTarget == target {
      return false;
    }
    let player = hitEvent.attackData.GetInstigator() as PlayerPuppet;
    if !IsDefined(player) {
      return false;
    }
    let breachFinder = player.GetBreachFinderComponent();
    if !IsDefined(breachFinder) {
      return false;
    }
    let damage = hitEvent.attackComputed.GetTotalAttackValue(gamedataStatPoolType.Health);
    let result = breachFinder.CanTrackedBreachBeKilledByDamage(damage);
    if result {
      this.m_lastTarget = target;
      result = this.CheckOnlyOncePerShot(hitEvent);
    }
    return this.m_invert ? !result : result;
  }
}

