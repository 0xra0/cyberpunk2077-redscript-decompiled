  public final native func ShouldKillNPC() -> Bool;

  public final native func SkipDeathAnim() -> Bool;

  public final native func IsCritical() -> Bool;
}

class ModifyDamageWithLeapedDistance extends ModifyDamageEffector {
  public let m_maxPercentMult: Float;
  public let m_minDistance: Float;
  public let m_maxDistance: Float;

  protected func Initialize(record: TweakDBID, game: GameInstance, parentRecord: TweakDBID) {
    super.Initialize(record, game, parentRecord);
    this.m_maxPercentMult = TweakDBInterface.GetFloat(record + t".maxPercentMult", 0.0);
    this.m_minDistance = TweakDBInterface.GetFloat(record + t".minDistance", 0.0);
    this.m_maxDistance = TweakDBInterface.GetFloat(record + t".maxDistance", 0.0);
  }

  protected func Uninitialize(game: GameInstance);

  protected func RepeatedAction(owner: GameObject) {
    let hitEvent = this.GetHitEvent();
    if !IsDefined(hitEvent) {
      return;
    }
    let playerPerkDataBB = GameInstance
      .GetBlackboardSystem(owner.GetGame())
      .Get(GetAllBlackboardDefs().PlayerPerkData);
    if IsDefined(playerPerkDataBB) {
      let leapedDistance = playerPerkDataBB.GetFloat(GetAllBlackboardDefs().PlayerPerkData.LeapedDistance);
      if leapedDistance
        > this.m_maxDistance
        || this.m_minDistance == this.m_maxDistance
        || this.m_maxDistance == 0.0 {
        this.ModifyDamage(hitEvent, this.m_operationType, this.m_maxPercentMult);
      } else if leapedDistance > this.m_minDistance {
        this
          .ModifyDamage(
            hitEvent,
            this.m_operationType,
            1.0 + (this.m_maxPercentMult - 1.0) * leapedDistance / this.m_maxDistance
          );
      }
    }
  }
}

