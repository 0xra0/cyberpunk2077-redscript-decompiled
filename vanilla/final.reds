class PerkDisplayContainerController extends inkLogicController {
  protected let m_index: Int32;
  protected let m_isTrait: Bool;
  protected let m_widget: inkWidgetRef;
  protected let m_data: BasePerkDisplayData;
  protected let m_dataManager: PlayerDevelopmentDataManager;
  protected let m_controller: wref<PerkDisplayController>;

  protected cb func OnInitialize() -> Bool {
    let evt = new PerkDisplayContainerCreatedEvent();
    evt.index = this.m_index;
    evt.isTrait = this.m_isTrait;
    evt.container = this;
    this.QueueEvent(evt);
  }

  private final func SpawnController() {
    (this.GetRootWidget() as inkCompoundWidget).RemoveAllChildren();
    let widget = this
      .SpawnFromLocal(
        this.GetRootWidget() as inkCompoundWidget,
        this.m_isTrait ? n"SkillUnlimitedPerkDisplay" : n"SkillPerkDisplay"
      );
    widget.SetVAlign(inkEVerticalAlign.Top);
    widget.SetHAlign(inkEHorizontalAlign.Left);
    this.m_controller = widget.GetController() as PerkDisplayController;
  }

  public final func SetData(perkData: BasePerkDisplayData, dataManager: PlayerDevelopmentDataManager) {
    this.m_data = perkData;
    this.m_dataManager = dataManager;
    if this.m_controller == null {
      this.SpawnController();
    }
    this.m_controller.Setup(this.m_data, this.m_dataManager, this.m_index);
  }

  public final func GetPerkDisplayData() -> BasePerkDisplayData {
    return this.m_data;
  }

  public final func GetPerkIndex() -> Int32 {
    return this.m_index;
  }
}

