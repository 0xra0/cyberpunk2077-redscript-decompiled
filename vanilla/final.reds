native class EnvironmentDamageReceiverComponent extends IPlacedComponent {
  private native let cooldown: Float;

  private final func DealDamageFromParticle(
    particleDamageRecords: [ParticleDamage_Record],
    instigator: GameObject,
    source: GameObject
  ) {
    let hitFlags: [SHitFlag];
    let flag: SHitFlag;
    let object = this.GetEntity() as GameObject;
    let gi = object.GetGame();
    flag.flag = hitFlag.None;
    flag.source = n"Environment";
    ArrayPush(hitFlags, flag);
    if instigator == null {
      instigator = object;
    } else if source == null {
      source = object;
    }
    let i = 0;
    while i < ArraySize(particleDamageRecords) {
      let gameEffectAttackRecord = particleDamageRecords[i].Attack() as Attack_GameEffect_Record;
      if IsDefined(gameEffectAttackRecord) {
        let attack = RPGManager
          .PrepareGameEffectAttack(gi, instigator, source, gameEffectAttackRecord.GetID(), hitFlags, object);
        if IsDefined(attack) {
          attack.StartAttack();
        }
      }
      this.cooldown += particleDamageRecords[i].Cooldown();
      i = i + 1;
    }
  }
}

importonly native class ParticleDamage_Record extends TweakDBRecord {
  public final native func Attack() -> wref<Attack_Record>;

  public final native func AttackHandle() -> Attack_Record;

  public final native func ParticlePath() -> ResRef;

  public final native func Cooldown() -> Float;
}

class DEBUG_VisualizerComponent extends ScriptableComponent {
  private let records: [DEBUG_VisualRecord];
  private let offsetCounter: Int32;
  private let timeToNextUpdate: Float;
  private let processedRecordIndex: Int32;
  private let showWeaponsStreaming: Bool;
  private const let TICK_TIME_DELTA: Float;
  private const let TEXT_SCALE_NAME: Float;
  private const let TEXT_SCALE_ATTITUDE: Float;
  private const let TEXT_SCALE_IMMORTALITY_MODE: Float;
  private const let TEXT_TOP: Float;
  private const let TEXT_OFFSET: Float;

  public final func VisualizePuppets(const pups: script_ref<[ScriptedPuppet]>, infDuration: Bool, duration: Float) {
    let rec: DEBUG_VisualRecord;
    if ArraySize(pups) == 0 || !infDuration && duration <= 0.0 {
      return;
    }
    let i = 0;
    while i < ArraySize(pups) {
      let alreadyExists = false;
      let j = 0;
      if j < ArraySize(this.records) {
        if this.records[j].puppet == pups[i] {
          this.records[j].infiniteDuration = infDuration;
          this.records[j].showDuration = duration;
          alreadyExists = true;
        } else {
          j += 1;
        }
      } else if !alreadyExists {
        rec.puppet = pups[i];
        rec.infiniteDuration = infDuration;
        rec.showDuration = duration;
        ArrayPush(this.records, rec);
      }
      i += 1;
    }
    if !this.IsEnabled() {
      this.Toggle(true);
    }
  }

  private final func VisualizePuppetInternal(index: Int32) {
    this.offsetCounter = 0;
    this.processedRecordIndex = index;
    this.VisualizeDisplayName(this.TEXT_SCALE_NAME);
    this.VisualizeAttitude(this.TEXT_SCALE_ATTITUDE);
    this.VisualizeImmortality(this.TEXT_SCALE_IMMORTALITY_MODE);
  }

  public final func ClearPuppetVisualization() {
    let i = ArraySize(this.records) - 1;
    while i >= 0 {
      this.ClearPuppet(i);
      i -= 1;
    }
  }

  private final func ClearPuppet(index: Int32) {
    if ArraySize(this.records) == 1 {
      this.Toggle(false);
    }
    let dvs = GameInstance.GetDebugVisualizerSystem(this.GetOwner().GetGame());
    let i = 0;
    while i < ArraySize(this.records[index].layerIDs) {
      dvs.ClearLayer(this.records[index].layerIDs[i]);
      i += 1;
    }
    ArrayErase(this.records, index);
  }

  private final func GetNextOffset() -> Vector4 {
    let offset = new Vector4(0.0, 0.0, this.TEXT_TOP - this.TEXT_OFFSET * Cast<Float>(this.offsetCounter), 0.0);
    this.offsetCounter += 1;
    return offset;
  }

  private final func VisualizeDisplayName(scale: Float) {
    this
      .ShowText(
        this.GetNextOffset(),
        this.records[this.processedRecordIndex].puppet.GetDisplayName(),
        new Color(255u, 255u, 0u, 255u),
        scale
      );
  }

  private final func VisualizeImmortality(scale: Float) {
    let type: gameGodModeType;
    let color: Color;
    let str: String;
    let hasImmortality = GetImmortality(this.records[this.processedRecordIndex].puppet, type);
    if !hasImmortality {
      str = StrUpper("No Immortality");
      color = new Color(255u, 0u, 0u, 255u);
    } else {
      str = "" + type;
      switch type {
        case gameGodModeType.Immortal:
          color = new Color(0u, 128u, 0u, 255u);
        case gameGodModeType.Invulnerable:
          color = new Color(0u, 255u, 0u, 255u);
        default:
          this.ShowText(this.GetNextOffset(), str, color, scale);
      }
    }
  }

  private final func VisualizeAttitude(scale: Float) {
    let attitudeColor: Color;
    let player = GetPlayer(this.records[this.processedRecordIndex].puppet.GetGame());
    let attitude = GameObject.GetAttitudeBetween(player, this.records[this.processedRecordIndex].puppet);
    let attitudeStr = EnumValueToString("EAIAttitude", EnumInt(attitude));
    attitudeStr = StrUpper(StrReplace(attitudeStr, "AIA_", ""));
    switch attitude {
      case EAIAttitude.AIA_Hostile:
        attitudeColor = new Color(255u, 0u, 0u, 255u);
        break;
      case EAIAttitude.AIA_Neutral:
        attitudeColor = new Color(190u, 190u, 190u, 255u);
        break;
      case EAIAttitude.AIA_Friendly:
        attitudeColor = new Color(0u, 255u, 0u, 255u);
        break;
      default:
        this.ShowText(this.GetNextOffset(), attitudeStr, attitudeColor, scale);
    }
  }

  private final func ShowText(offset: Vector4, const str: script_ref<String>, color: Color, scale: Float) {
    let dvs = GameInstance
      .GetDebugVisualizerSystem(this.records[this.processedRecordIndex].puppet.GetGame());
    let layerID = dvs
      .DrawText3D(
        this.records[this.processedRecordIndex].puppet.GetWorldPosition() + offset,
        str,
        color,
        MaxF(this.TICK_TIME_DELTA, 0.05)
      );
    dvs.SetScale(layerID, new Vector4(scale, scale, scale, 0.0));
    ArrayPush(this.records[this.processedRecordIndex].layerIDs, layerID);
  }

  public final func OnGameAttach() {
    this.Toggle(false);
  }

  public final func OnUpdate(dt: Float) {
    if this.timeToNextUpdate <= 0.0 {
      this.timeToNextUpdate = this.TICK_TIME_DELTA;
      let i = ArraySize(this.records) - 1;
      while i >= 0 {
        if !this.records[i].infiniteDuration && this.records[i].showDuration <= 0.0 {
          this.ClearPuppet(i);
        } else if !this.records[i].infiniteDuration {
          this.records[i].showDuration -= dt;
        } else {
          this.VisualizePuppetInternal(i);
        }
        i -= 1;
      }
    } else {
      this.timeToNextUpdate -= dt;
    }
  }

  public final func ToggleShowWeaponsStreaming() {
    this.showWeaponsStreaming = !this.showWeaponsStreaming;
  }
}

struct DEBUG_VisualRecord {
  public let layerIDs: [Uint32];
  public let puppet: wref<ScriptedPuppet>;
  public let infiniteDuration: Bool;
  public let showDuration: Float;
}

public native func StrUpper(const str: script_ref<String>) -> String;

public func OperatorAdd(s: String, mode: gameGodModeType) -> String {
  return s + EnumValueToString("gameGodModeType", EnumInt(mode));
}

