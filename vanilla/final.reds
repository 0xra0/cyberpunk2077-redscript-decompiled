  public final native func EnumName() -> CName;
}

class DeviceControlContextEvents extends InputContextTransitionEvents {
  protected func OnEnter(stateContext: StateContext, scriptInterface: StateGameScriptInterface) {
    this.RemoveAllInputHints(stateContext, scriptInterface);
  }
}

class BraindanceContextDecisions extends InputContextTransitionDecisions {
  protected const func EnterCondition(const stateContext: StateContext, const scriptInterface: StateGameScriptInterface) -> Bool {
    if this.IsPlayerInBraindance(scriptInterface) {
      return true;
    }
    return false;
  }
}

class AimingStateDecisions extends UpperBodyTransition {
  private let m_callbackIDs: [CallbackHandle];
  private let m_executionOwner: wref<GameObject>;
  private let m_controlsListener: AimToggleListener;
  private let m_statListener: DefaultTransitionStatListener;
  private let m_statusEffectListener: DefaultTransitionStatusEffectListener;
  private let m_attachmentSlotListener: AttachmentSlotsScriptListener;
  private let m_sceneTier: Int32;
  private let m_vehicleState: Int32;
  private let m_highLevelState: Int32;
  private let m_combatGadgetState: Int32;
  private let m_takedownState: Int32;
  private let m_weaponState: Int32;
  private let m_sceneAimForced: Bool;
  private let m_shouldAim: Bool;
  private let m_hasRightHandItemEquipped: Bool;
  private let m_isDead: Bool;
  private let m_isWeaponBlockingAiming: Bool;
  private let m_visionModeActive: Bool;
  private let m_isDodging: Bool;
  private let m_hasThrowableMeleeWeapon: Bool;
  private let m_canAimWhileDodging: Bool;
  private let m_canThrowWeapon: Bool;
  private let m_aimForced: Bool;
  private let m_beingCreated: Bool;
  private let m_mouseZoomLevel: Float;

  protected final func OnAttach(const stateContext: StateContext, const scriptInterface: StateGameScriptInterface) {
    this.m_beingCreated = true;
    this.m_executionOwner = scriptInterface.executionOwner;
    this.m_controlsListener = new AimToggleListener();
    this.m_controlsListener.Initialize(scriptInterface);
    scriptInterface.executionOwner.RegisterInputListener(this, n"CameraAim");
    this.m_statusEffectListener = new DefaultTransitionStatusEffectListener();
    this.m_statusEffectListener.m_transitionOwner = this;
    scriptInterface
      .GetStatusEffectSystem()
      .RegisterListener(scriptInterface.owner.GetEntityID(), this.m_statusEffectListener);
    this.m_aimForced = StatusEffectSystem.ObjectHasStatusEffectWithTag(scriptInterface.executionOwner, n"ForceAim");
    let allBlackboardDef = GetAllBlackboardDefs();
    ArrayPush(
      this.m_callbackIDs,
      scriptInterface
        .localBlackboard
        .RegisterListenerInt(
          allBlackboardDef.PlayerStateMachine.SceneTier,
          this,
          n"OnSceneTierChanged",
          true
        )
    );
    ArrayPush(
      this.m_callbackIDs,
      scriptInterface
        .localBlackboard
        .RegisterListenerInt(
          allBlackboardDef.PlayerStateMachine.Vehicle,
          this,
          n"OnVehicleChanged",
          true
        )
    );
    ArrayPush(
      this.m_callbackIDs,
      scriptInterface
        .localBlackboard
        .RegisterListenerInt(
          allBlackboardDef.PlayerStateMachine.HighLevel,
          this,
          n"OnHighLevelChanged",
          true
        )
    );
    ArrayPush(
      this.m_callbackIDs,
      scriptInterface
        .localBlackboard
        .RegisterListenerBool(
          allBlackboardDef.PlayerStateMachine.SceneAimForced,
          this,
          n"OnSceneAimForcedChanged",
          true
        )
    );
    ArrayPush(
      this.m_callbackIDs,
      scriptInterface
        .localBlackboard
        .RegisterListenerInt(
          allBlackboardDef.PlayerStateMachine.Vitals,
          this,
          n"OnVitalsChanged",
          true
        )
    );
    ArrayPush(
      this.m_callbackIDs,
      scriptInterface
        .localBlackboard
        .RegisterListenerInt(
          allBlackboardDef.PlayerStateMachine.Takedown,
          this,
          n"OnTakedownChanged",
          true
        )
    );
    ArrayPush(
      this.m_callbackIDs,
      scriptInterface
        .localBlackboard
        .RegisterListenerInt(
          allBlackboardDef.PlayerStateMachine.CombatGadget,
          this,
          n"OnCombatGadgetChanged",
          true
        )
    );
    ArrayPush(
      this.m_callbackIDs,
      scriptInterface
        .localBlackboard
        .RegisterListenerInt(
          allBlackboardDef.PlayerStateMachine.Vision,
          this,
          n"OnVisionChanged",
          true
        )
    );
    ArrayPush(
      this.m_callbackIDs,
      scriptInterface
        .localBlackboard
        .RegisterListenerInt(
          allBlackboardDef.PlayerStateMachine.Weapon,
          this,
          n"OnWeaponStateChanged",
          true
        )
    );
    ArrayPush(
      this.m_callbackIDs,
      scriptInterface
        .localBlackboard
        .RegisterListenerInt(
          allBlackboardDef.PlayerStateMachine.Locomotion,
          this,
          n"OnLocomoatoinStateChanged",
          true
        )
    );
    let attachmentSlotCallback = new DefaultTransitionAttachmentSlotsCallback();
    attachmentSlotCallback.m_transitionOwner = this;
    attachmentSlotCallback.slotID = t"AttachmentSlots.WeaponRight";
    this.m_attachmentSlotListener = scriptInterface
      .GetTransactionSystem()
      .RegisterAttachmentSlotListener(this.m_executionOwner, attachmentSlotCallback);
    this.m_statListener = new DefaultTransitionStatListener();
    this.m_statListener.m_transitionOwner = this;
    scriptInterface
      .GetStatsSystem()
      .RegisterListener(
        Cast<StatsObjectID>(this.m_executionOwner.GetEntityID()),
        this.m_statListener
      );
    this.m_canThrowWeapon = scriptInterface.HasStatFlag(gamedataStatType.CanThrowWeapon);
    this.m_canAimWhileDodging = scriptInterface.HasStatFlag(gamedataStatType.CanAimWhileDodging);
    this.m_beingCreated = false;
    this.UpdateEnterConditionEnabled();
  }

  protected final func OnDetach(const stateContext: StateContext, const scriptInterface: StateGameScriptInterface) {
    scriptInterface.executionOwner.UnregisterInputListener(this);
    this.m_statusEffectListener = null;
    ArrayClear(this.m_callbackIDs);
    scriptInterface
      .GetTransactionSystem()
      .UnregisterAttachmentSlotListener(this.m_executionOwner, this.m_attachmentSlotListener);
    scriptInterface
      .GetStatsSystem()
      .UnregisterListener(
        Cast<StatsObjectID>(this.m_executionOwner.GetEntityID()),
        this.m_statListener
      );
  }

  private final func GetShouldAimValue() -> Bool {
    if this.m_aimForced {
      return true;
    } else if this.m_sceneTier > 3 {
      return false;
    } else if this.m_sceneTier
      < 3
      && this.m_vehicleState != 0
      && this.m_vehicleState != 2
      && this.m_vehicleState != 6 {
      return false;
    } else if this.m_controlsListener.GetADS() {
      return true;
    } else if this.m_highLevelState > 1 && this.m_highLevelState <= 5 && this.m_sceneAimForced {
      return true;
    }
    return false;
  }

  private final func ShouldCheckEnterCondition() -> Bool {
    if this.m_isDead {
      return false;
    } else if this.m_highLevelState != 1 && this.m_highLevelState != 2 && this.m_highLevelState != 3 {
      return false;
    } else if this.m_takedownState == 2 || this.m_takedownState == 3 || this.m_takedownState == 4 {
      return false;
    } else if this.m_combatGadgetState > 0 && this.m_combatGadgetState < 5 && !this.m_visionModeActive {
      return false;
    } else if this.m_isWeaponBlockingAiming {
      return false;
    } else if this.m_hasThrowableMeleeWeapon && !this.m_canThrowWeapon {
      return false;
    } else if !this.m_canAimWhileDodging && this.m_isDodging {
      return false;
    }
    return true;
  }

  private final func UpdateEnterConditionEnabled() {
    if this.m_beingCreated {
      return;
    }
    this.m_shouldAim = this.GetShouldAimValue();
    if !this.m_shouldAim {
      this.m_controlsListener.ADSForcedOff();
    }
    this.EnableOnEnterCondition(this.m_shouldAim && this.ShouldCheckEnterCondition());
  }

  protected cb func OnAction(action: ListenerAction, consumer: ListenerActionConsumer) -> Bool {
    this.m_controlsListener.OnAction(action, consumer);
    this.UpdateEnterConditionEnabled();
  }

  protected cb func OnSceneTierChanged(value: Int32) -> Bool {
    this.m_sceneTier = value;
    this.UpdateEnterConditionEnabled();
  }

  protected cb func OnVehicleChanged(value: Int32) -> Bool {
    this.m_vehicleState = value;
    this.UpdateEnterConditionEnabled();
  }

  protected cb func OnHighLevelChanged(value: Int32) -> Bool {
    this.m_highLevelState = value;
    this.UpdateEnterConditionEnabled();
  }

  protected cb func OnSceneAimForcedChanged(value: Bool) -> Bool {
    this.m_sceneAimForced = value;
    this.UpdateEnterConditionEnabled();
  }

  protected cb func OnVitalsChanged(value: Int32) -> Bool {
    this.m_isDead = value == 1;
    this.UpdateEnterConditionEnabled();
  }

  protected cb func OnTakedownChanged(value: Int32) -> Bool {
    this.m_takedownState = value;
    this.UpdateEnterConditionEnabled();
  }

  protected cb func OnCombatGadgetChanged(value: Int32) -> Bool {
    this.m_combatGadgetState = value;
    this.UpdateEnterConditionEnabled();
  }

  protected cb func OnVisionChanged(value: Int32) -> Bool {
    this.m_visionModeActive = value == 1;
    this.UpdateEnterConditionEnabled();
  }

  protected cb func OnWeaponStateChanged(value: Int32) -> Bool {
    this.m_weaponState = value;
    this.m_isWeaponBlockingAiming = value == 3 || value == 7 || value == 2;
    this.UpdateEnterConditionEnabled();
  }

  protected cb func OnLocomoatoinStateChanged(value: Int32) -> Bool {
    this.m_isDodging = value == 7 || value == 8 || value == 13;
    this.UpdateEnterConditionEnabled();
  }

  public func OnStatusEffectApplied(statusEffect: wref<StatusEffect_Record>) {
    if !this.m_aimForced {
      if statusEffect.GameplayTagsContains(n"ForceAim") {
        this.m_aimForced = true;
        this.UpdateEnterConditionEnabled();
      }
    }
  }

  public func OnStatusEffectRemoved(statusEffect: wref<StatusEffect_Record>) {
    if this.m_aimForced {
      if statusEffect.GameplayTagsContains(n"ForceAim") {
        this.m_aimForced = StatusEffectSystem.ObjectHasStatusEffectWithTag(this.m_executionOwner, n"ForceAim");
        if !this.m_aimForced {
          this.UpdateEnterConditionEnabled();
        }
      }
    }
  }

  public func OnStatChanged(ownerID: StatsObjectID, statType: gamedataStatType, diff: Float, value: Float) {
    if Equals(statType, gamedataStatType.CanThrowWeapon) {
      this.m_canThrowWeapon = value > 0.0;
      this.UpdateEnterConditionEnabled();
    } else if Equals(statType, gamedataStatType.CanAimWhileDodging) {
      this.m_canAimWhileDodging = value > 0.0;
      this.UpdateEnterConditionEnabled();
    }
  }

  public func OnItemEquipped(slot: TweakDBID, item: ItemID) {
    let tarnsactioSystem = GameInstance.GetTransactionSystem(this.m_executionOwner.GetGame());
    this.m_hasRightHandItemEquipped = true;
    this.m_hasThrowableMeleeWeapon = tarnsactioSystem.HasTag(this.m_executionOwner, n"MeleeWeapon", item) && tarnsactioSystem.HasTag(this.m_executionOwner, n"Throwable", item);
    this.UpdateEnterConditionEnabled();
  }

  public func OnItemUnequipped(slot: TweakDBID, item: ItemID) {
    this.m_hasRightHandItemEquipped = false;
    this.m_hasThrowableMeleeWeapon = false;
    this.UpdateEnterConditionEnabled();
  }

  protected const final func EnterCondition(const stateContext: StateContext, const scriptInterface: StateGameScriptInterface) -> Bool {
    if this.IsRightHandInUnequippingState(stateContext) || this.IsLeftHandInUnequippingState(stateContext) {
      return false;
    } else if this.IsPlayerInBraindance(scriptInterface) {
      return false;
    } else if stateContext.GetConditionBool(n"AimingInterrupted") || this.IsAimingSoftBlocked(stateContext, scriptInterface) {
      return false;
    } else if this.IsAimingBlockedForTime(stateContext, scriptInterface) {
      return false;
    } else if stateContext.IsStateMachineActive(n"Consumable") {
      return false;
    } else if this.IsInItemWheelState(stateContext) {
      return false;
    }
    let pendingAdjust = IsDefined(stateContext.GetTemporaryScriptableParameter(n"adjustTransform"));
    return !pendingAdjust;
  }

  protected const final func ToSingleWield(const stateContext: StateContext, const scriptInterface: StateGameScriptInterface) -> Bool {
    if this.m_weaponState == 3 {
      return true;
    } else if !this.m_shouldAim {
      return true;
    } else if this.IsAimingBlockedForTime(stateContext, scriptInterface) {
      return true;
    } else if this.IsAimingHeldForTime(stateContext, scriptInterface) {
      return false;
    } else if this.m_isWeaponBlockingAiming {
      return true;
    } else if !this.m_hasRightHandItemEquipped || !this.IsRightHandInEquippedState(stateContext) {
      return false;
    } else if stateContext.GetBoolParameter(n"InterruptAiming", false) {
      stateContext.SetConditionBoolParameter(n"AimingInterrupted", true, true);
      return true;
    } else if stateContext.IsStateMachineActive(n"Consumable") {
      return true;
    }
    return false;
  }

  protected const final func ToEmptyHands(const stateContext: StateContext, const scriptInterface: StateGameScriptInterface) -> Bool {
    return !this.m_shouldAim && !this.m_hasRightHandItemEquipped;
  }

  protected const final func ToForceEmptyHands(const stateContext: StateContext, const scriptInterface: StateGameScriptInterface) -> Bool {
    let emptyHandsForced = this.IsEmptyHandsForced(stateContext, scriptInterface);
    if this.m_hasRightHandItemEquipped && emptyHandsForced {
      return true;
    }
    return !this.m_shouldAim && emptyHandsForced;
  }

  protected const final func ToForceSafe(const stateContext: StateContext, const scriptInterface: StateGameScriptInterface) -> Bool {
    return !this.m_shouldAim && this.IsSafeStateForced(stateContext, scriptInterface);
  }
}

class DefaultTransitionAttachmentSlotsCallback extends AttachmentSlotsScriptCallback {
  public let m_transitionOwner: wref<DefaultTransition>;

  public func OnItemEquipped(slot: TweakDBID, item: ItemID) {
    this.m_transitionOwner.OnItemEquipped(slot, item);
  }

  public func OnItemUnequipped(slot: TweakDBID, item: ItemID) {
    this.m_transitionOwner.OnItemUnequipped(slot, item);
  }
}

class DeadContextDecisions extends InputContextTransitionDecisions {
  private let m_callbackID: CallbackHandle;

  protected final func OnAttach(const stateContext: StateContext, const scriptInterface: StateGameScriptInterface) {
    if IsDefined(scriptInterface.localBlackboard) {
      let allBlackboardDef = GetAllBlackboardDefs();
      this.m_callbackID = scriptInterface
        .localBlackboard
        .RegisterListenerInt(allBlackboardDef.PlayerStateMachine.Vitals, this, n"OnVitalsChanged");
      this
        .OnVitalsChanged(
          scriptInterface.localBlackboard.GetInt(allBlackboardDef.PlayerStateMachine.Vitals)
        );
    }
  }

  protected final func OnDetach(const stateContext: StateContext, const scriptInterface: StateGameScriptInterface) {
    this.m_callbackID = null;
  }

  protected cb func OnVitalsChanged(value: Int32) -> Bool {
    this.EnableOnEnterCondition(value == 1);
  }

  protected const func EnterCondition(const stateContext: StateContext, const scriptInterface: StateGameScriptInterface) -> Bool {
    return true;
  }
}

class BaseContextDecisions extends InputContextTransitionDecisions {
  protected const final func ToVehicleRemoteControlDriverContext(const stateContext: StateContext, const scriptInterface: StateGameScriptInterface) -> Bool {
    let isVehicleRemoteControlled = this.IsVehicleRemoteControlled(scriptInterface);
    if isVehicleRemoteControlled {
      return true;
    }
    return false;
  }
}

