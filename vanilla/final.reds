class weaponIndicatorController extends inkHUDGameController {
  public const let m_triggerModeControllers: [CName];
  public const let m_ammoLogicControllers: [CName];
  public const let m_chargeLogicControllers: [CName];
  private let m_triggerModeInstances: [wref<TriggerModeLogicController>];
  private let m_ammoLogicInstances: [wref<AmmoLogicController>];
  private let m_chargeLogicInstances: [wref<ChargeLogicController>];
  private let bb: wref<IBlackboard>;
  private let m_blackboard: wref<IBlackboard>;
  private let m_onCharge: CallbackHandle;
  private let m_onTriggerMode: CallbackHandle;
  private let m_onMagazineAmmoCount: CallbackHandle;
  private let m_onMagazineAmmoCapacity: CallbackHandle;
  private let m_BufferedRosterData: SlotDataHolder;
  private let m_ActiveWeapon: SlotWeaponData;
  private let m_InventoryManager: InventoryDataManagerV2;

  protected cb func OnPlayerAttach(playerPuppet: GameObject) -> Bool {
    let player = playerPuppet as PlayerPuppet;
    this.m_InventoryManager = new InventoryDataManagerV2();
    this.m_InventoryManager.Initialize(playerPuppet as PlayerPuppet);
    let item = this.GetOwnerEntity() as ItemObject;
    let game = item.GetGame();
    player = GetPlayer(game);
    let id = t"AttachmentSlots.WeaponRight";
    let weapon = GameInstance.GetTransactionSystem(game).GetItemInSlot(player, id) as WeaponObject;
    this.m_blackboard = weapon.GetSharedData();
    this.bb = this.GetBlackboardSystem().Get(GetAllBlackboardDefs().UI_EquipmentData);
    let count = ArraySize(this.m_triggerModeControllers);
    let i = 0;
    while i < count {
      let triggerModeInstance = this.GetController(this.m_triggerModeControllers[i]) as TriggerModeLogicController;
      if IsDefined(triggerModeInstance) {
        ArrayPush(this.m_triggerModeInstances, triggerModeInstance);
      }
      i += 1;
    }
    count = ArraySize(this.m_ammoLogicControllers);
    i = 0;
    while i < count {
      let ammoLogicInstance = this.GetController(this.m_ammoLogicControllers[i]) as AmmoLogicController;
      if IsDefined(ammoLogicInstance) {
        ArrayPush(this.m_ammoLogicInstances, ammoLogicInstance);
      }
      i += 1;
    }
    count = ArraySize(this.m_chargeLogicControllers);
    i = 0;
    while i < count {
      let chargeLogicInstance = this.GetController(this.m_chargeLogicControllers[i]) as ChargeLogicController;
      if IsDefined(chargeLogicInstance) {
        ArrayPush(this.m_chargeLogicInstances, chargeLogicInstance);
      }
      i += 1;
    }
    if Cast<Bool>(ArraySize(this.m_triggerModeInstances)) {
      this.m_onTriggerMode = this
        .m_blackboard
        .RegisterListenerVariant(GetAllBlackboardDefs().Weapon.TriggerMode, this, n"OnTriggerMode");
      this.OnTriggerMode(ToVariant(weapon.GetCurrentTriggerMode()));
    } else if Cast<Bool>(ArraySize(this.m_ammoLogicInstances)) {
      this.m_onMagazineAmmoCount = this
        .bb
        .RegisterListenerVariant(
          GetAllBlackboardDefs().UI_EquipmentData.EquipmentData,
          this,
          n"OnMagazineAmmoCapacity"
        );
      this.bb.SignalVariant(GetAllBlackboardDefs().UI_EquipmentData.EquipmentData);
    } else if Cast<Bool>(ArraySize(this.m_chargeLogicInstances)) {
      this.m_onCharge = this
        .m_blackboard
        .RegisterListenerFloat(GetAllBlackboardDefs().Weapon.Charge, this, n"OnCharge");
      this.m_blackboard.SignalFloat(GetAllBlackboardDefs().Weapon.Charge);
    }
  }

  protected cb func OnPlayerDetach(playerPuppet: GameObject) -> Bool {
    if Cast<Bool>(ArraySize(this.m_triggerModeInstances)) && IsDefined(this.m_onTriggerMode) {
      this
        .m_blackboard
        .UnregisterListenerVariant(GetAllBlackboardDefs().Weapon.TriggerMode, this.m_onTriggerMode);
    } else if Cast<Bool>(ArraySize(this.m_ammoLogicInstances)) && IsDefined(this.m_onMagazineAmmoCount) {
      this
        .bb
        .UnregisterListenerVariant(
          GetAllBlackboardDefs().UI_EquipmentData.EquipmentData,
          this.m_onMagazineAmmoCount
        );
    } else if Cast<Bool>(ArraySize(this.m_chargeLogicInstances)) && IsDefined(this.m_onCharge) {
      this
        .m_blackboard
        .UnregisterListenerFloat(GetAllBlackboardDefs().Weapon.Charge, this.m_onCharge);
    }
  }

  protected cb func OnInitialize() -> Bool;

  protected cb func OnUninitialize() -> Bool;

  protected cb func OnCharge(value: Float) -> Bool {
    let count = ArraySize(this.m_chargeLogicInstances);
    let i = 0;
    while i < count {
      this.m_chargeLogicInstances[i].OnChargeChanged(value);
      i += 1;
    }
  }

  protected cb func OnTriggerMode(value: Variant) -> Bool {
    let count = ArraySize(this.m_triggerModeInstances);
    let i = 0;
    while i < count {
      this
        .m_triggerModeInstances[i]
        .OnTriggerModeChanged(FromVariant<TriggerMode_Record>(value));
      i += 1;
    }
  }

  protected cb func OnMagazineAmmoCount(value: Uint32) -> Bool {
    let count = ArraySize(this.m_ammoLogicInstances);
    let i = 0;
    while i < count {
      this.m_ammoLogicInstances[i].OnMagazineAmmoCountChanged(value);
      i += 1;
    }
  }

  protected cb func OnMagazineAmmoCapacity(value: Variant) -> Bool {
    this.m_BufferedRosterData = FromVariant<SlotDataHolder>(value);
    let currentData = this.m_BufferedRosterData.weapon;
    if ItemID.IsValid(currentData.weaponID) {
      this.m_ActiveWeapon = currentData;
      let count = ArraySize(this.m_ammoLogicInstances);
      let i = 0;
      while i < count {
        this
          .m_ammoLogicInstances[i]
          .OnMagazineAmmoCapacityChanged(Cast<Uint32>(this.m_ActiveWeapon.ammoCurrent));
        i += 1;
      }
    }
  }
}

class RadialMenuGameController extends inkHUDGameController {
  private let m_containerRef: inkCompoundRef;
  private let m_highlightRef: inkWidgetRef;
  private const let m_itemListRef: [inkWidgetRef];
  private let m_quickSlotsBoard: wref<IBlackboard>;
  private let m_quickSlotsDef: UI_QuickSlotsDataDef;
  private let m_inputAxisCallbackId: CallbackHandle;

  protected cb func OnInitialize() -> Bool {
    this.m_quickSlotsDef = GetAllBlackboardDefs().UI_QuickSlotsData;
    this.m_quickSlotsBoard = this.GetBlackboardSystem().Get(this.m_quickSlotsDef);
    this.m_inputAxisCallbackId = this
      .m_quickSlotsBoard
      .RegisterDelayedListenerFloat(
        this.m_quickSlotsDef.UIRadialContextRightStickAngle,
        this,
        n"OnRadialAngleChanged"
      );
    this.GetRootWidget().SetVisible(false);
  }

  protected cb func OnUninitialize() -> Bool {
    this
      .m_quickSlotsBoard
      .UnregisterDelayedListener(
        this.m_quickSlotsDef.UIRadialContextRightStickAngle,
        this.m_inputAxisCallbackId
      );
  }

  protected cb func OnRadialAngleChanged(value: Float) -> Bool {
    let highlightAngle = value + 180.0;
    inkWidgetRef.SetRotation(this.m_highlightRef, highlightAngle);
    let count = ArraySize(this.m_itemListRef);
    let minAngle = -1.0;
    let rootWidget = this.GetRootWidget() as inkCompoundWidget;
    let containerSize = rootWidget.GetChildSize(inkWidgetRef.Get(this.m_containerRef));
    let containerPosition = rootWidget.GetChildPosition(inkWidgetRef.Get(this.m_containerRef));
    let centerPos = new Vector2(
      containerPosition.X + containerSize.X / 2.0,
      containerPosition.Y + containerSize.Y / 2.0
    );
    let i = 0;
    while i < count {
      let curItem = this.m_itemListRef[i];
      let curPosition = inkCompoundRef.GetChildPosition(this.m_containerRef, inkWidgetRef.Get(curItem));
      let curSize = inkCompoundRef.GetChildSize(this.m_containerRef, inkWidgetRef.Get(curItem));
      let itemPos = new Vector2(curPosition.X + curSize.X / 2.0, curPosition.Y + curSize.Y / 2.0);
      let curAngle = Rad2Deg(AtanF(itemPos.X - centerPos.X, itemPos.Y - centerPos.Y));
      if minAngle > curAngle {
        minAngle = curAngle;
      }
      let tmpWdg = inkWidgetRef.Get(curItem) as inkCompoundWidget;
      let tmpText = tmpWdg.GetWidget(n"debug") as inkText;
      tmpText.SetText(curAngle + " : " + value);
      i += 1;
    }
  }

  protected cb func OnOpenWheelRequest(evt: QuickSlotButtonHoldStartEvent) -> Bool {
    if Equals(evt.dPadItemDirection, EDPadSlot.WeaponsWheel) {
      this.PopulateData();
      this.SetVisible(true);
    }
  }

  protected cb func OnCloseWheelRequest(evt: QuickSlotButtonHoldEndEvent) -> Bool {
    if Equals(evt.dPadItemDirection, EDPadSlot.WeaponsWheel) {
      this.ApplySelection();
      this.SetVisible(false);
    }
  }

  protected final func PopulateData();

  protected final func ApplySelection();

  protected final func SetVisible(value: Bool) {
    this.GetRootWidget().SetVisible(value);
  }
}

public native func OperatorAdd(a: Float, const b: script_ref<String>) -> String;

class QuickSlotButtonHoldEndEvent extends Event {
  public let dPadItemDirection: EDPadSlot;
  public let rightStickAngle: Float;
  public let tryExecuteCommand: Bool;
}

