class DetailedLocomotionPSMPrereq extends PlayerStateMachinePrereq {
  protected const func OnRegister(state: PrereqState, game: GameInstance, context: IScriptable) -> Bool {
    let bb = GameInstance
      .GetBlackboardSystem(game)
      .GetLocalInstanced(
        (context as ScriptedPuppet).GetEntityID(),
        GetAllBlackboardDefs().PlayerStateMachine
      );
    let castedState = state as DetailedLocomotionPSMPrereqState;
    let locomotionID = GetAllBlackboardDefs().PlayerStateMachine.LocomotionDetailed;
    if !IsDefined(bb) {
      let player = GameInstance.GetPlayerSystem(game).GetLocalPlayerControlledGameObject();
      if IsDefined(player) && player.IsReplacer() {
        castedState.RegisterPlayerAttachedCallback(locomotionID, game);
      }
      return false;
    }
    castedState.m_owner = context as GameObject;
    castedState.m_listenerInt = bb.RegisterListenerInt(locomotionID, castedState, n"OnStateUpdate");
    castedState.m_prevValue = bb.GetInt(locomotionID);
    return false;
  }

