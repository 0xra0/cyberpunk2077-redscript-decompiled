class WorkspotMapperComponent extends ScriptableComponent {
  public const let m_workspotsMap: [WorkspotMapData];

  protected final func OnGameAttach();

  protected final func OnGameDetach();

  public const final func GetFreeWorkspotsCountForAIAction(aiAction: gamedataWorkspotActionType) -> Int32 {
    let count: Int32;
    let mapEntryIndex = this.GetWorkspotMapEntryIdexForAIaction(aiAction);
    if mapEntryIndex >= 0 {
      count = this.GetFreeWorkspotsCount(mapEntryIndex);
    }
    return count;
  }

  public const final func GetFreeWorkspotRefForAIAction(aiAction: gamedataWorkspotActionType) -> NodeRef {
    let workspotRef: NodeRef;
    let mapEntryIndex = this.GetWorkspotMapEntryIdexForAIaction(aiAction);
    if mapEntryIndex >= 0 {
      workspotRef = this.FindFreeWorkspotRef(mapEntryIndex);
    }
    return workspotRef;
  }

  public const final func GetFreeWorkspotDataForAIAction(aiAction: gamedataWorkspotActionType) -> WorkspotEntryData {
    let workspotData: WorkspotEntryData;
    let mapEntryIndex = this.GetWorkspotMapEntryIdexForAIaction(aiAction);
    if mapEntryIndex >= 0 {
      workspotData = this.FindFreeWorkspotData(mapEntryIndex);
    }
    return workspotData;
  }

  public const final func GetNumberOfWorkpotsForAIAction(aiAction: gamedataWorkspotActionType) -> Int32 {
    let mapEntryIndex = this.GetWorkspotMapEntryIdexForAIaction(aiAction);
    if mapEntryIndex < 0 {
      return 0;
    }
    return ArraySize(this.m_workspotsMap[mapEntryIndex].workspots);
  }

  private const final func GetWorkspotMapEntryIdexForAIaction(aiAction: gamedataWorkspotActionType) -> Int32 {
    let i = 0;
    while i < ArraySize(this.m_workspotsMap) {
      if this.m_workspotsMap[i] == null {
      } else if Equals(this.m_workspotsMap[i].action, aiAction) {
        return i;
      }
      i += 1;
    }
    return -1;
  }

  private const final func GetFreeWorkspotsCount(mapEntryIndex: Int32) -> Int32 {
    let count: Int32;
    if this.m_workspotsMap[mapEntryIndex] == null {
      count = 0;
    } else if mapEntryIndex >= 0 {
      count = this.m_workspotsMap[mapEntryIndex].GetFreeWorkspotsCount();
    }
    return count;
  }

  private const final func FindFreeWorkspotRef(mapEntryIndex: Int32) -> NodeRef {
    let workspotRef: NodeRef;
    if this.m_workspotsMap[mapEntryIndex] == null {
      return workspotRef;
    } else if mapEntryIndex >= 0 {
      workspotRef = this.m_workspotsMap[mapEntryIndex].FindFreeWorkspotRef();
    }
    return workspotRef;
  }

  private const final func FindFreeWorkspotData(mapEntryIndex: Int32) -> WorkspotEntryData {
    let workspotData: WorkspotEntryData;
    if this.m_workspotsMap[mapEntryIndex] == null {
      return workspotData;
    } else if mapEntryIndex >= 0 {
      workspotData = this.m_workspotsMap[mapEntryIndex].FindFreeWorkspotData();
    }
    return workspotData;
  }

  private final func ReleaseWorkspot(workspotRef: NodeRef) {
    let i = 0;
    while i < ArraySize(this.m_workspotsMap) {
      if this.m_workspotsMap[i] == null {
      } else {
        this.m_workspotsMap[i].ReleaseWorkspot(workspotRef);
      }
      i += 1;
    }
  }

  private final func ReserveWorkspot(workspotRef: NodeRef) {
    let i = 0;
    while i < ArraySize(this.m_workspotsMap) {
      if this.m_workspotsMap[i] == null {
      } else {
        this.m_workspotsMap[i].ReserveWorkspot(workspotRef);
      }
      i += 1;
    }
  }

  protected cb func OnReserveWorkspot(evt: OnReserveWorkspotEvent) -> Bool {
    this.ReserveWorkspot(evt.workspotRef);
  }

  protected cb func OnReleaseWorkspot(evt: OnReleaseWorkspotEvent) -> Bool {
    this.ReleaseWorkspot(evt.workspotRef);
  }
}

class WorkspotMapData extends IScriptable {
  public let action: gamedataWorkspotActionType;
  public const let workspots: [WorkspotEntryData];

  public const final func FindFreeWorkspotRef() -> NodeRef {
    let workspotRef: NodeRef;
    let i = 0;
    if i < ArraySize(this.workspots) {
      if this.workspots[i] == null {
      } else if this.workspots[i].isEnabled && this.workspots[i].isAvailable {
        workspotRef = this.workspots[i].workspotRef;
      }
      i += 1;
    }
    return workspotRef;
  }

  public const final func FindFreeWorkspotData() -> WorkspotEntryData {
    let workspotData: WorkspotEntryData;
    let i = 0;
    if i < ArraySize(this.workspots) {
      if this.workspots[i] == null {
      } else if this.workspots[i].isEnabled && this.workspots[i].isAvailable {
        workspotData = this.workspots[i];
      }
      i += 1;
    }
    return workspotData;
  }

  public const final func GetFreeWorkspotsCount() -> Int32 {
    let count: Int32;
    let i = 0;
    if i < ArraySize(this.workspots) {
      if this.workspots[i] == null {
      } else if this.workspots[i].isEnabled && this.workspots[i].isAvailable {
        count += 1;
      }
      i += 1;
    }
    return count;
  }

  public final func ReleaseWorkspot(workspotRef: NodeRef) {
    let i = 0;
    while i < ArraySize(this.workspots) {
      if this.workspots[i] == null {
      } else if Equals(this.workspots[i].workspotRef, workspotRef) {
        this.workspots[i].isAvailable = true;
      }
      i += 1;
    }
  }

  public final func ReserveWorkspot(workspotRef: NodeRef) {
    let i = 0;
    while i < ArraySize(this.workspots) {
      if this.workspots[i] == null {
      } else if Equals(this.workspots[i].workspotRef, workspotRef) {
        this.workspots[i].isAvailable = false;
      }
      i += 1;
    }
  }
}

class OnWorkspotAvailabilityEvent extends Event {
  public let workspotRef: NodeRef;
}

