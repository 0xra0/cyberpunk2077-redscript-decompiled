  protected let dampingCurve: CName;
  protected let damping: Float;

  protected final native func SetDampFactor(dampFactor: Float);

  protected final native func SetCurrValue(currValue: EulerAngles);

  protected final native func UpdateDamp(dest: EulerAngles, dt: Float);

