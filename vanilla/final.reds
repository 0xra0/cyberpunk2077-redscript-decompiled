struct SBaseDeviceOperationData {
  public let delay: Float;
  public let resetDelay: Bool;
  public let executeOnce: Bool;
  public let isEnabled: Bool;
  public const let transformAnimations: [STransformAnimationData];
  public const let VFXs: [SVFXOperationData];
  public const let SFXs: [SSFXOperationData];
  public const let facts: [SFactOperationData];
  public const let components: [SComponentOperationData];
  public const let stims: [SStimOperationData];
  public const let statusEffects: [SStatusEffectOperationData];
  public const let damages: [SDamageOperationData];
  public const let items: [SInventoryOperationData];
  public let teleport: STeleportOperationData;
  public let meshesAppearence: CName;
  public let playerWorkspot: SWorkspotData;
  public let disableDevice: Bool;
  public const let toggleOperations: [SToggleOperationData];
  public let id: Int32;
  public let delayID: DelayID;
  public let isDelayActive: Bool;
}

class DelayedOperationEvent extends Event {
  public let operationHandler: DeviceOperations;
  public let operation: SBaseDeviceOperationData;
}

abstract class DeviceOperations extends IScriptable {
  protected let m_components: [wref<IPlacedComponent>];
  protected let m_fxInstances: [SVfxInstanceData];

  public func RequestComponents(ri: EntityRequestComponentsInterface);

  public func TakeControl(ri: EntityResolveComponentsInterface);

  public func ToggleOperation(enable: Bool, index: Int32);

  public const func IsOperationEnabled(index: Int32) -> Bool {
    return true;
  }

  public func SetDelayIdOnOperation(delayId: DelayID, operationID: Int32);

  public func ClearDelayIdOnOperation(operationID: Int32);

  protected final func SendToggleOperataionEvent(enable: Bool, index: Int32, type: EOperationClassType, owner: wref<GameObject>) {
    let evt = new ToggleOperationEvent();
    evt.enable = enable;
    evt.index = index;
    evt.type = type;
    owner.QueueEvent(evt);
  }

  protected final func DelayOperation(const operation: script_ref<SBaseDeviceOperationData>, owner: wref<GameObject>) {
    let evt = new DelayedOperationEvent();
    evt.operationHandler = this;
    evt.operation = operation;
    let delayID = GameInstance.GetDelaySystem(owner.GetGame()).DelayEvent(owner, evt, operation.delay);
    this.SetDelayIdOnOperation(delayID, operation.id);
  }

  public final func Execute(const operation: script_ref<SBaseDeviceOperationData>, owner: wref<GameObject>) {
    if !this.IsOperationEnabled(operation.id) {
      return;
    } else if operation.delay <= 0.0 {
      this.ClearDelayIdOnOperation(operation.id);
      this.ResolveVFXs(operation.VFXs, owner);
      this.ResolveSFXs(operation.SFXs, owner);
      this.ResolveFacts(operation.facts, owner);
      this.ResolveComponents(operation.components);
      this.ResolveMeshesAppearence(operation.meshesAppearence, owner);
      this.ResolveTransformAnimations(operation.transformAnimations, owner);
      this.ResolveWorkspots(operation.playerWorkspot, owner);
      this.ResolveStims(operation.stims, owner);
      this.ResolveStatusEffects(operation.statusEffects, owner);
      this.ResolveDamages(operation.damages, owner);
      this.ResolveItems(operation.items, owner);
      this.ResolveTeleport(operation.teleport, owner);
      this.ResolveOperations(operation.toggleOperations, owner);
      this.ResolveDisable(operation.disableDevice, owner);
      if operation.executeOnce {
        this.ToggleOperation(false, operation.id);
      }
    } else if !operation.isDelayActive {
      this.DelayOperation(operation, owner);
    } else if operation.resetDelay {
      GameInstance.GetDelaySystem(owner.GetGame()).CancelDelay(operation.delayID);
      this.DelayOperation(operation, owner);
    }
  }

  public final func Restore(const operation: script_ref<SBaseDeviceOperationData>, owner: wref<GameObject>) {
    this.ResolveVFXs(operation.VFXs, owner);
    this.ResolveSFXs(operation.SFXs, owner);
    this.ResolveComponents(operation.components);
    this.ResolveMeshesAppearence(operation.meshesAppearence, owner);
    this.ResolveTransformAnimations(operation.transformAnimations, owner);
    this.ResolveWorkspots(operation.playerWorkspot, owner);
    this.ResolveStims(operation.stims, owner);
    this.ResolveStatusEffects(operation.statusEffects, owner);
  }

  private final func ResolveDisable(disable: Bool, owner: wref<GameObject>) {
    if disable {
      let device = owner as Device;
      if device == null {
        return;
      }
      device.GetDevicePS().ForceDisableDevice();
    }
  }

  private final func ResolveOperations(const operations: script_ref<[SToggleOperationData]>, owner: wref<GameObject>) {
    let i = 0;
    while i < ArraySize(operations) {
      if Equals(operations[i].classType, EOperationClassType.Local) {
        this.ToggleOperation(operations[i].enable, operations[i].index);
      } else {
        this
          .SendToggleOperataionEvent(
            operations[i].enable,
            operations[i].index,
            operations[i].classType,
            owner
          );
      }
      i += 1;
    }
  }

  private final func ResolveTeleport(teleport: STeleportOperationData, owner: wref<GameObject>) {
    if owner == null {
      return;
    }
    let puppet = GameInstance.GetPlayerSystem(owner.GetGame()).GetLocalPlayerMainGameObject();
    if puppet == null {
      return;
    }
    GameInstance
      .GetTeleportationFacility(owner.GetGame())
      .TeleportToNode(puppet, teleport.nodeRef);
  }

  private final func ResolveItems(const items: script_ref<[SInventoryOperationData]>, owner: wref<GameObject>) {
    if owner == null {
      return;
    }
    let puppet = GameInstance.GetPlayerSystem(owner.GetGame()).GetLocalPlayerMainGameObject();
    if puppet == null {
      return;
    }
    let transactionSystem = GameInstance.GetTransactionSystem(owner.GetGame());
    let i = 0;
    while i < ArraySize(items) {
      if Equals(items[i].operationType, EItemOperationType.ADD) {
        transactionSystem
          .GiveItem(puppet, ItemID.FromTDBID(items[i].itemName), items[i].quantity);
      } else if Equals(items[i].operationType, EItemOperationType.REMOVE) {
        transactionSystem
          .RemoveItem(puppet, ItemID.FromTDBID(items[i].itemName), items[i].quantity);
      }
      i += 1;
    }
  }

  private final func ResolveVFXs(const VFXs: script_ref<[SVFXOperationData]>, owner: wref<GameObject>) {
    let transform: WorldTransform;
    let position: WorldPosition;
    if owner == null {
      return;
    }
    let i = 0;
    while i < ArraySize(VFXs) {
      let targetID = Cast<EntityID>(ResolveNodeRefWithEntityID(VFXs[i].nodeRef, owner.GetEntityID()));
      let target = GameInstance.FindEntityByID(owner.GetGame(), targetID) as GameEntity;
      if target == null {
        target = owner;
      } else if target == null {
      } else if Equals(VFXs[i].operationType, EEffectOperationType.START) {
        if FxResource.IsValid(VFXs[i].vfxResource) {
          let fxInstance = this.GetFxInstance(VFXs[i].vfxName);
          if fxInstance != null {
            this.RemoveFxInstance(VFXs[i].vfxName);
            fxInstance.Kill();
          }
          WorldPosition.SetVector4(position, target.GetWorldPosition());
          WorldTransform.SetWorldPosition(transform, position);
          fxInstance = this
            .CreateFxInstance(owner, VFXs[i].vfxName, VFXs[i].vfxResource, transform);
          fxInstance.SetBlackboardValue(n"change_size", VFXs[i].size);
          this.StoreFxInstance(VFXs[i].vfxName, fxInstance);
        }
        let effectBlackboard = new worldEffectBlackboard();
        effectBlackboard.SetValue(n"change_size", VFXs[i].size);
        GameObjectEffectHelper
          .StartEffectEvent(
            target as GameObject,
            VFXs[i].vfxName,
            VFXs[i].shouldPersist,
            effectBlackboard
          );
      } else if Equals(VFXs[i].operationType, EEffectOperationType.STOP) {
        fxInstance = this.GetFxInstance(VFXs[i].vfxName);
        if fxInstance == null {
          GameObjectEffectHelper.StopEffectEvent(target as GameObject, VFXs[i].vfxName);
        }
        this.RemoveFxInstance(VFXs[i].vfxName);
        fxInstance.Kill();
      } else if Equals(VFXs[i].operationType, EEffectOperationType.BRAKE_LOOP) {
        fxInstance = this.GetFxInstance(VFXs[i].vfxName);
        if fxInstance == null {
          GameObjectEffectHelper.BreakEffectLoopEvent(target as GameObject, VFXs[i].vfxName);
        }
        fxInstance.BreakLoop();
      }
      i += 1;
    }
  }

  private final func ResolveSFXs(const SFXs: script_ref<[SSFXOperationData]>, owner: wref<GameObject>) {
    if owner == null {
      return;
    }
    let i = 0;
    while i < ArraySize(SFXs) {
      GameObject.PlaySoundEvent(owner, SFXs[i].sfxName);
      i += 1;
    }
  }

  private final func ResolveFacts(const facts: script_ref<[SFactOperationData]>, owner: wref<GameObject>) {
    if owner == null {
      return;
    }
    let i = 0;
    while i < ArraySize(facts) {
      if IsNameValid(facts[i].factName) {
        if Equals(facts[i].operationType, EMathOperationType.Add) {
          AddFact(owner.GetGame(), facts[i].factName, facts[i].factValue);
        } else {
          SetFactValue(owner.GetGame(), facts[i].factName, facts[i].factValue);
        }
      }
      i += 1;
    }
  }

  private final func ResolveComponents(const componentsData: script_ref<[SComponentOperationData]>) {
    let i = 0;
    while i < ArraySize(componentsData) {
      let k = 0;
      while k < ArraySize(this.m_components) {
        if this.m_components[k] == null {
        } else if Equals(componentsData[i].componentName, this.m_components[k].GetName()) {
          if Equals(componentsData[i].operationType, EComponentOperation.Enable) {
            this.m_components[k].Toggle(true);
          } else {
            this.m_components[k].Toggle(false);
          }
        }
        k += 1;
      }
      i += 1;
    }
  }

  private final func ResolveMeshesAppearence(appearanceName: CName, owner: wref<GameObject>) {
    if owner == null {
      return;
    } else if IsNameValid(appearanceName) {
      GameObject.SetMeshAppearanceEvent(owner, appearanceName);
    }
  }

  private final func ResolveTransformAnimations(const animations: script_ref<[STransformAnimationData]>, owner: wref<GameObject>) {
    if owner == null {
      return;
    }
    let i = 0;
    while i < ArraySize(animations) {
      if Equals(animations[i].operationType, ETransformAnimationOperationType.PLAY) {
        let playEvent = new gameTransformAnimationPlayEvent();
        playEvent.animationName = animations[i].animationName;
        playEvent.timeScale = animations[i].playData.timeScale;
        playEvent.looping = animations[i].playData.looping;
        playEvent.timesPlayed = animations[i].playData.timesPlayed;
        owner.QueueEvent(playEvent);
        return;
      }
      if Equals(animations[i].operationType, ETransformAnimationOperationType.PAUSE) {
        let pauseEvent = new gameTransformAnimationPauseEvent();
        pauseEvent.animationName = animations[i].animationName;
        owner.QueueEvent(pauseEvent);
        return;
      }
      if Equals(animations[i].operationType, ETransformAnimationOperationType.RESET) {
        let resetEvent = new gameTransformAnimationResetEvent();
        resetEvent.animationName = animations[i].animationName;
        owner.QueueEvent(resetEvent);
        return;
      }
      if Equals(animations[i].operationType, ETransformAnimationOperationType.SKIP) {
        let skipEvent = new gameTransformAnimationSkipEvent();
        skipEvent.animationName = animations[i].animationName;
        skipEvent.time = animations[i].skipData.time;
        skipEvent.skipToEnd = animations[i].skipData.skipToEnd;
        owner.QueueEvent(skipEvent);
        return;
      }
      i += 1;
    }
  }

  private final func ResolveWorkspots(workspot: SWorkspotData, owner: wref<GameObject>) {
    let device = owner as Device;
    if device == null {
      return;
    }
    let player = GameInstance.GetPlayerSystem(device.GetGame()).GetLocalPlayerMainGameObject();
    if player == null {
      return;
    } else if Equals(workspot.operationType, EWorkspotOperationType.ENTER) {
      if IsNameValid(workspot.componentName) {
        this
          .EnterWorkspot(device, player, workspot.freeCamera, workspot.componentName);
      }
    } else if Equals(workspot.operationType, EWorkspotOperationType.LEAVE) {
      this.LeaveWorkspot(player);
    }
  }

  private final func ResolveStims(const stims: script_ref<[SStimOperationData]>, owner: wref<GameObject>) {
    let i = 0;
    while i < ArraySize(stims) {
      let stimType = Device.MapStimType(stims[i].stimType);
      let targetID = Cast<EntityID>(ResolveNodeRefWithEntityID(stims[i].nodeRef, owner.GetEntityID()));
      let target = GameInstance.FindEntityByID(owner.GetGame(), targetID) as GameObject;
      if target == null {
        target = owner;
      } else if target == null {
      } else if Equals(stimType, gamedataStimType.Invalid) {
      }
      let broadcaster = target.GetStimBroadcasterComponent();
      if IsDefined(broadcaster) {
        if Equals(stims[i].operationType, EEffectOperationType.START) {
          broadcaster
            .SetSingleActiveStimuli(owner, stimType, stims[i].lifeTime, stims[i].radius);
        } else {
          broadcaster.RemoveActiveStimuliByName(owner, stimType);
        }
      }
      i += 1;
    }
  }

  private final func ResolveStatusEffects(statusEffects: [SStatusEffectOperationData], owner: wref<GameObject>) {
    if owner == null {
      return;
    }
    let position = owner.GetWorldPosition();
    let i = 0;
    while i < ArraySize(statusEffects) {
      if statusEffects[i].range > 0.0 {
        let effect = GameInstance
          .GetGameEffectSystem(owner.GetGame())
          .CreateEffectStatic(n"applyStatusEffect", n"inRange", owner);
        EffectData
          .SetVector(
            effect.GetSharedData(),
            GetAllBlackboardDefs().EffectSharedData.position,
            position + statusEffects[i].offset
          );
        EffectData
          .SetFloat(
            effect.GetSharedData(),
            GetAllBlackboardDefs().EffectSharedData.radius,
            statusEffects[i].range
          );
        EffectData
          .SetFloat(
            effect.GetSharedData(),
            GetAllBlackboardDefs().EffectSharedData.duration,
            statusEffects[i].duration
          );
        EffectData
          .SetVariant(
            effect.GetSharedData(),
            GetAllBlackboardDefs().EffectSharedData.statusEffect,
            ToVariant(statusEffects[i].effect.statusEffect)
          );
        effect.Run();
      }
      i += 1;
    }
  }

  private final func ResolveDamages(const damages: script_ref<[SDamageOperationData]>, owner: wref<GameObject>) {
    let attackContext: AttackInitContext;
    let statMods: [gameStatModifierData];
    if owner == null {
      return;
    }
    let player = GameInstance.GetPlayerSystem(owner.GetGame()).GetLocalPlayerMainGameObject();
    let position = owner.GetWorldPosition();
    attackContext.instigator = player;
    attackContext.source = owner;
    let i = 0;
    while i < ArraySize(damages) {
      if damages[i].range > 0.0 {
        attackContext.record = TweakDBInterface.GetAttackRecord(damages[i].damageType);
        let explosionAttack = IAttack.Create(attackContext) as Attack_GameEffect;
        let damageEffect = explosionAttack.PrepareAttack(owner);
        explosionAttack.GetStatModList(statMods);
        EffectData
          .SetFloat(
            damageEffect.GetSharedData(),
            GetAllBlackboardDefs().EffectSharedData.radius,
            damages[i].range
          );
        EffectData
          .SetVector(
            damageEffect.GetSharedData(),
            GetAllBlackboardDefs().EffectSharedData.position,
            position + damages[i].offset
          );
        EffectData
          .SetVariant(
            damageEffect.GetSharedData(),
            GetAllBlackboardDefs().EffectSharedData.attack,
            ToVariant(explosionAttack)
          );
        EffectData
          .SetVariant(
            damageEffect.GetSharedData(),
            GetAllBlackboardDefs().EffectSharedData.attackStatModList,
            ToVariant(statMods)
          );
        explosionAttack.StartAttack();
      }
      i += 1;
    }
  }

  protected func EnterWorkspot(target: Device, activator: GameObject, opt freeCamera: Bool, opt componentName: CName) {
    let workspotSystem = GameInstance.GetWorkspotSystem(activator.GetGame());
    workspotSystem.PlayInDeviceSimple(target, activator, freeCamera, componentName);
  }

  protected func LeaveWorkspot(activator: GameObject) {
    let orientation: Quaternion;
    Quaternion.SetIdentity(orientation);
    let direction = new Vector4(0.0, 0.0, 0.0, 1.0);
    let workspotSystem = GameInstance.GetWorkspotSystem(activator.GetGame());
    workspotSystem.StopInDevice(activator, direction, orientation);
  }

  private final func GetFxInstance(id: CName) -> FxInstance {
    let fx: FxInstance;
    let i = 0;
    if i < ArraySize(this.m_fxInstances) {
      if Equals(this.m_fxInstances[i].id, id) {
        fx = this.m_fxInstances[i].fx;
        if fx == null {
          ArrayErase(this.m_fxInstances, i);
        }
      } else {
        i += 1;
      }
    }
    return fx;
  }

  private final func RemoveFxInstance(id: CName) {
    let i = 0;
    if i < ArraySize(this.m_fxInstances) {
      if Equals(this.m_fxInstances[i].id, id) {
        ArrayErase(this.m_fxInstances, i);
      } else {
        i += 1;
      }
    }
  }

  private final func CreateFxInstance(
    owner: wref<GameObject>,
    id: CName,
    resource: FxResource,
    transform: WorldTransform
  ) -> FxInstance {
    let fxSystem = GameInstance.GetFxSystem(owner.GetGame());
    let fx = fxSystem.SpawnEffect(resource, transform);
    return fx;
  }

  private final func StoreFxInstance(id: CName, fx: FxInstance) {
    let fxInstanceData: SVfxInstanceData;
    fxInstanceData.id = id;
    fxInstanceData.fx = fx;
    ArrayPush(this.m_fxInstances, fxInstanceData);
  }
}

