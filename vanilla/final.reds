native struct Color {
  public native let Red: Uint8;
  public native let Green: Uint8;
  public native let Blue: Uint8;
  public native let Alpha: Uint8;

  public final static func ToHDRColorDirect(color: Color) -> HDRColor {
    return new HDRColor(
      Cast<Float>(color.Red) / 255.0,
      Cast<Float>(color.Green) / 255.0,
      Cast<Float>(color.Blue) / 255.0,
      Cast<Float>(color.Alpha) / 255.0
    );
  }

  public final static func HSBToColor(hue: Float, onlyHue: Bool, opt saturation: Float, opt brightness: Float) -> Color {
    let color: Color;
    if onlyHue {
      saturation = 1.0;
      brightness = 1.0;
    }
    hue /= 360.0;
    let sector = FloorF(hue * 6.0) % 6;
    let sectorFraction = hue * 6.0 - Cast<Float>(FloorF(hue * 6.0));
    let p = brightness * (1.0 - saturation);
    let q = brightness * (1.0 - sectorFraction * saturation);
    let t = brightness * (1.0 - (1.0 - sectorFraction) * saturation);
    let pScaled = Cast<Int32>(p * 255.0);
    let qScaled = Cast<Int32>(q * 255.0);
    let tScaled = Cast<Int32>(t * 255.0);
    let vScaled = Cast<Int32>(brightness * 255.0);
    switch sector {
      case 0:
        color = new Color(Cast<Uint8>(vScaled), Cast<Uint8>(tScaled), Cast<Uint8>(pScaled), 255u);
        break;
      case 1:
        color = new Color(Cast<Uint8>(qScaled), Cast<Uint8>(vScaled), Cast<Uint8>(pScaled), 255u);
        break;
      case 2:
        color = new Color(Cast<Uint8>(pScaled), Cast<Uint8>(vScaled), Cast<Uint8>(tScaled), 255u);
        break;
      case 3:
        color = new Color(Cast<Uint8>(pScaled), Cast<Uint8>(qScaled), Cast<Uint8>(vScaled), 255u);
        break;
      case 4:
        color = new Color(Cast<Uint8>(tScaled), Cast<Uint8>(pScaled), Cast<Uint8>(vScaled), 255u);
        break;
      default:
        color = new Color(Cast<Uint8>(vScaled), Cast<Uint8>(pScaled), Cast<Uint8>(qScaled), 255u);
        return color;
    }
  }

  public final static func ColorToHSB(color: Color) -> HSBColor {
    let hsbColor: HSBColor;
    let min = color.Red < color.Green ? Cast<Float>(color.Red) / 255.0 : Cast<Float>(color.Green) / 255.0;
    min = min < Cast<Float>(color.Blue) / 255.0 ? min : Cast<Float>(color.Blue) / 255.0;
    let max = color.Red > color.Green ? Cast<Float>(color.Red) / 255.0 : Cast<Float>(color.Green) / 255.0;
    max = max > Cast<Float>(color.Blue) / 255.0 ? max : Cast<Float>(color.Blue) / 255.0;
    hsbColor.Brightness = max;
    let delta = max - min;
    if delta < 1.0e-5 {
      hsbColor.Saturation = 0.0;
      hsbColor.Hue = 0.0;
      return hsbColor;
    } else if max > 0.0 {
      hsbColor.Saturation = delta / max;
    }
    hsbColor.Saturation = 0.0;
    hsbColor.Hue = 0.0;
    return hsbColor;
  }

  public final static func Equals(colorA: Color, colorB: Color, opt tolerance: Int32) -> Bool {
    return Abs(Cast<Int32>(colorA.Red) - Cast<Int32>(colorB.Red))
      <= tolerance
      && Abs(Cast<Int32>(colorA.Green) - Cast<Int32>(colorB.Green)) <= tolerance
      && Abs(Cast<Int32>(colorA.Blue) - Cast<Int32>(colorB.Blue)) <= tolerance
      && Abs(Cast<Int32>(colorA.Alpha) - Cast<Int32>(colorB.Alpha)) <= tolerance;
  }

  public final static func ToLinear(sRGBColor: Color) -> Color {
    return new Color(
      Cast<Uint8>(PowF(Cast<Float>(sRGBColor.Red) / 255.0, 2.2) * 255.0),
      Cast<Uint8>(PowF(Cast<Float>(sRGBColor.Green) / 255.0, 2.2) * 255.0),
      Cast<Uint8>(PowF(Cast<Float>(sRGBColor.Blue) / 255.0, 2.2) * 255.0),
      sRGBColor.Alpha
    );
  }

  public final static func ToSRGB(linearColor: Color) -> Color {
    return new Color(
      Cast<Uint8>(PowF(Cast<Float>(linearColor.Red) / 255.0, 0.45454544) * 255.0),
      Cast<Uint8>(PowF(Cast<Float>(linearColor.Green) / 255.0, 0.45454544) * 255.0),
      Cast<Uint8>(PowF(Cast<Float>(linearColor.Blue) / 255.0, 0.45454544) * 255.0),
      linearColor.Alpha
    );
  }
}

