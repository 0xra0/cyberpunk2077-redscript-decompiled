class LogicalCondition extends WorkspotCondition {
  protected let operation: WorkspotConditionOperators;
  protected const let conditions: [WorkspotCondition];

  public const func CheckCondition(ent: Entity) -> Bool {
    let i: Int32;
    if Equals(this.operation, WorkspotConditionOperators.OR) {
      i = 0;
      while i < ArraySize(this.conditions) {
        if this.conditions[i].CheckCondition(ent) {
          return true;
        }
        i += 1;
      }
      return false;
    }
    if Equals(this.operation, WorkspotConditionOperators.AND) {
      i = 0;
      while i < ArraySize(this.conditions) {
        if !this.conditions[i].CheckCondition(ent) {
          return false;
        }
        i += 1;
      }
      return true;
    }
    return false;
  }
}

class TransparencyAnimationButtonView extends BaseButtonView {
  private let m_AnimationTime: Float;
  private let m_HoverTransparency: Float;
  private let m_PressTransparency: Float;
  private let m_DefaultTransparency: Float;
  private let m_DisabledTransparency: Float;
  private let m_AnimationProxies: [inkAnimProxy];
  private const let m_Targets: [inkWidgetRef];

  protected func ButtonStateChanged(oldState: inkEButtonState, newState: inkEButtonState) {
    let targetTransparency: Float;
    switch newState {
      case inkEButtonState.Hover:
        targetTransparency = this.m_HoverTransparency;
        break;
      case inkEButtonState.Press:
        targetTransparency = this.m_PressTransparency;
        break;
      case inkEButtonState.Disabled:
        targetTransparency = this.m_DisabledTransparency;
        break;
      default:
        targetTransparency = this.m_DefaultTransparency;
        let i = 0;
    }
    let limit = ArraySize(this.m_AnimationProxies);
    while i < limit {
      if IsDefined(this.m_AnimationProxies[i]) && this.m_AnimationProxies[i].IsPlaying() {
        this.m_AnimationProxies[i].Stop();
      }
      i += 1;
    }
    ArrayClear(this.m_AnimationProxies);
    let animDef = new inkAnimDef();
    let transparencyInterpolator = new inkAnimTransparency();
    transparencyInterpolator.SetType(inkanimInterpolationType.Linear);
    transparencyInterpolator.SetMode(inkanimInterpolationMode.EasyIn);
    transparencyInterpolator.SetEndTransparency(targetTransparency);
    transparencyInterpolator.SetDuration(this.m_AnimationTime);
    transparencyInterpolator.SetDirection(inkanimInterpolationDirection.To);
    animDef.AddInterpolator(transparencyInterpolator);
    i = 0;
    limit = ArraySize(this.m_Targets);
    while i < limit {
      ArrayPush(
        this.m_AnimationProxies,
        inkWidgetRef.PlayAnimation(this.m_Targets[i], animDef)
      );
      i += 1;
    }
  }
}

class TransparencyAnimationToggleView extends BaseToggleView {
  private let m_AnimationTime: Float;
  private let m_HoverTransparency: Float;
  private let m_PressTransparency: Float;
