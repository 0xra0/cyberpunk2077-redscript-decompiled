    let ps = GameInstance.GetScriptableSystemsContainer(context).Get(n"PreventionSystem") as PreventionSystem;
    return ps.m_lastKnownVehicle;
  }

  public final static func SetPlayerMounted(context: GameInstance, value: Bool) {
    let ps = GameInstance.GetScriptableSystemsContainer(context).Get(n"PreventionSystem") as PreventionSystem;
    if NotEquals(ps.m_isPlayerMounted, value) {
      ps.SetIsPlayerMounted(value);
    }
