class FastForwardAvailableEvents extends ScenesFastForwardTransition {
  public let forceCloseFX: Bool;
  public let delay: Float;

  public func OnEnter(stateContext: StateContext, scriptInterface: StateGameScriptInterface) {
    if this
      .IsFastForwardModeActive(scriptInterface, scnFastForwardMode.GameplayReview) || this.IsFastForwardModeActive(scriptInterface, scnFastForwardMode.Default) {
      this.DeActivateFastForward(scriptInterface);
    }
    ScenesFastForwardTransition.HideFFButtonPrompt(scriptInterface.executionOwner);
    stateContext.RemovePermanentBoolParameter(n"FFhintActive");
    this.forceCloseFX = false;
    this.delay = 0.0;
  }

  public func OnUpdate(
    timeDelta: Float,
    stateContext: StateContext,
    const scriptInterface: StateGameScriptInterface
  ) {
    let psmBlackboard = scriptInterface
      .GetBlackboardSystem()
      .GetLocalInstanced(
        scriptInterface
          .GetPlayerSystem()
          .GetLocalPlayerControlledGameObject()
          .GetEntityID(),
        GetAllBlackboardDefs().PlayerStateMachine
      );
    let uiBlackboard = scriptInterface.GetBlackboardSystem().Get(GetAllBlackboardDefs().UIInteractions);
    let isControllingCamera = psmBlackboard.GetBool(GetAllBlackboardDefs().PlayerStateMachine.IsControllingCamera);
    let isQuestNotificationPoppedUp = uiBlackboard.GetBool(GetAllBlackboardDefs().UIInteractions.IsQuestNotificationUp);
    if !this.forceCloseFX
      && this.GetInStateTime() > 0.3
      && !this
        .IsTimeDilationActive(stateContext, scriptInterface, n"SceneSystemFastForward") {
      this.StopGlitchFx(scriptInterface);
      this.forceCloseFX = true;
    } else if stateContext.GetBoolParameter(n"FFRestriction", true)
      && !this
        .IsTimeDilationActive(stateContext, scriptInterface, n"SceneSystemFastForward") {
      this.delay += 0.1;
      if this.delay > 0.1 {
        stateContext.SetPermanentBoolParameter(n"FFCrouchLock", true, true);
        stateContext.RemovePermanentBoolParameter(n"FFRestriction");
        StatusEffectHelper
          .RemoveStatusEffect(scriptInterface.executionOwner, t"GameplayRestriction.FastForward");
        if DefaultTransition.IsFastForwardByLine(scriptInterface.executionOwner) {
          StatusEffectHelper
            .ApplyStatusEffect(
              scriptInterface.executionOwner,
              t"GameplayRestriction.FastForwardCrouchLock"
            );
        }
        this.delay = 0.0;
      }
    } else if stateContext.GetBoolParameter(n"FFRestriction", true)
      && this
        .IsTimeDilationActive(stateContext, scriptInterface, n"SceneSystemFastForward") {
      timeDelta = 0.0;
    } else if stateContext.GetBoolParameter(n"FFCrouchLock", true)
      && !StatusEffectSystem
        .ObjectHasStatusEffect(
          scriptInterface.executionOwner,
          t"GameplayRestriction.FastForwardCrouchLock"
        ) {
      stateContext.RemovePermanentBoolParameter(n"FFCrouchLock");
    } else if !DefaultTransition.IsFastForwardByLine(scriptInterface.executionOwner) {
      if scriptInterface.IsActionJustHeld(n"SceneFastForward")
        && !stateContext.GetBoolParameter(n"TriggerFF", true)
        && !isControllingCamera
        && !isQuestNotificationPoppedUp {
        stateContext.SetPermanentBoolParameter(n"TriggerFF", true, true);
        stateContext.SetPermanentBoolParameter(n"FFHoldLock", true, true);
      } else if stateContext.GetBoolParameter(n"TriggerFF", true) && scriptInterface.GetActionValue(n"SceneFastForward") == 0.0 {
        stateContext.RemovePermanentBoolParameter(n"TriggerFF");
        stateContext.RemovePermanentBoolParameter(n"FFHoldLock");
      } else if this.GetSceneTier(scriptInterface) < 3 {
        if this.IsFastForwardAvailable(scriptInterface, scnFastForwardMode.Default)
          && !this
            .IsFastForwardModeActive(scriptInterface, scnFastForwardMode.GameplayReview)
          && !stateContext.GetBoolParameter(n"FFhintActive", true)
          && !isControllingCamera
          && !isQuestNotificationPoppedUp {
          stateContext.SetPermanentBoolParameter(n"FFhintActive", true, true);
          ScenesFastForwardTransition.DisplayFFButtonPrompt(scriptInterface.executionOwner);
        } else if (!this.IsFastForwardAvailable(scriptInterface, scnFastForwardMode.Default)
          || this
            .IsFastForwardModeActive(scriptInterface, scnFastForwardMode.GameplayReview)) && stateContext.GetBoolParameter(n"FFhintActive", true) {
          ScenesFastForwardTransition.HideFFButtonPrompt(scriptInterface.executionOwner);
          stateContext.RemovePermanentBoolParameter(n"FFhintActive");
        }
      } else if this.GetSceneTier(scriptInterface) == 4 || this.GetSceneTier(scriptInterface) == 3 {
        if this.IsFastForwardAvailable(scriptInterface, scnFastForwardMode.Default)
          && !this
            .IsFastForwardModeActive(scriptInterface, scnFastForwardMode.GameplayReview)
          && !stateContext.GetBoolParameter(n"FFhintActive", true)
          && !isControllingCamera
          && !isQuestNotificationPoppedUp {
          stateContext.SetPermanentBoolParameter(n"FFhintActive", true, true);
          ScenesFastForwardTransition.DisplayFFButtonPrompt(scriptInterface.executionOwner);
        } else if (!this.IsFastForwardAvailable(scriptInterface, scnFastForwardMode.Default)
          || this
            .IsFastForwardModeActive(scriptInterface, scnFastForwardMode.GameplayReview)) && stateContext.GetBoolParameter(n"FFhintActive", true) {
          ScenesFastForwardTransition.HideFFButtonPrompt(scriptInterface.executionOwner);
          stateContext.RemovePermanentBoolParameter(n"FFhintActive");
        }
      } else if (this.GetSceneTier(scriptInterface)
        == 1
        || !this.IsFastForwardAvailable(scriptInterface, scnFastForwardMode.Default)) && stateContext.GetBoolParameter(n"FFhintActive", true) {
        ScenesFastForwardTransition.HideFFButtonPrompt(scriptInterface.executionOwner);
        stateContext.RemovePermanentBoolParameter(n"FFhintActive");
      } else if DefaultTransition.IsFastForwardByLine(scriptInterface.executionOwner) && !isControllingCamera && !isQuestNotificationPoppedUp {
        this.ProcessHoldInputFastForwardLock(stateContext, scriptInterface);
      }
    }
  }
}

