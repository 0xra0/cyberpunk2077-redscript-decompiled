  public const final func IsAimAssistEnabled() -> Bool {
    let i = 0;
    while i < ArraySize(this.m_targetingComponentsArray) {
      let component = this.m_targetingComponentsArray[i];
      if component.IsEnabled() && component.IsAimAssistEnabled() {
        return true;
      }
      i += 1;
    }
    return false;
  }

