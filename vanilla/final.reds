  public const final func GetSecurityAreasWithUsersInside(uniqueUsers: script_ref<[AreaEntry]>) -> [SecurityAreaControllerPS] {
    let nonEmptyAreas: [SecurityAreaControllerPS];
    let secAreas = this.GetSecurityAreas();
    let i = 0;
    while i < ArraySize(secAreas) {
      let areaUsers = secAreas[i].GetUsersInPerimeter();
      if ArraySize(areaUsers) > 0 {
        ArrayPush(nonEmptyAreas, secAreas[i]);
      }
      let j = 0;
      while j < ArraySize(areaUsers) {
        if !ArrayContains(uniqueUsers, areaUsers[j]) {
          ArrayPush(uniqueUsers, areaUsers[j]);
        }
        j += 1;
      }
      i += 1;
    }
    return nonEmptyAreas;
  }

  public const final func GetSecurityAreasWithUsersInside() -> [SecurityAreaControllerPS] {
    let trash: [AreaEntry];
    return this.GetSecurityAreasWithUsersInside(trash);
  }

  public const final func GetSecurityAreasWithUserInside(whoToCheck: EntityID) -> [SecurityAreaControllerPS] {
    let secAreasWithUser: [SecurityAreaControllerPS];
    let secAreas = this.GetSecurityAreas();
    if ArraySize(secAreas) > 0 {
      let i = 0;
      while i < ArraySize(secAreas) {
        if secAreas[i].IsUserInside(whoToCheck) {
          ArrayPush(secAreasWithUser, secAreas[i]);
        }
        i += 1;
      }
      return secAreasWithUser;
    }
    let secSys = this.GetSecuritySystem();
    if IsDefined(secSys) {
      return secSys.GetSecurityAreasWithUserInside(whoToCheck);
    }
    return secAreas;
  }

  public const final func GetSecurityAreasWithUserInside(whoToCheck: GameObject) -> [SecurityAreaControllerPS] {
    let emptyArr: [SecurityAreaControllerPS];
    if IsDefined(whoToCheck) {
      return this.GetSecurityAreasWithUserInside(whoToCheck.GetEntityID());
    }
    return emptyArr;
  }

