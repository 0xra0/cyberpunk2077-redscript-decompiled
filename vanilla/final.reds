class SlideLowGravityDecisions extends CrouchLowGravityDecisions {
  protected const func EnterCondition(const stateContext: StateContext, const scriptInterface: StateGameScriptInterface) -> Bool {
    let superResult: Bool;
    return false;
  }

  protected const func ToCrouchLowGravity(const stateContext: StateContext, const scriptInterface: StateGameScriptInterface) -> Bool {
    if stateContext.GetConditionBool(n"CrouchToggled") || scriptInterface.GetActionValue(n"Crouch") > 0.0 {
      return this.ShouldExit(stateContext, scriptInterface);
    }
    return false;
  }

  protected const func ShouldExit(const stateContext: StateContext, const scriptInterface: StateGameScriptInterface) -> Bool {
    return scriptInterface.GetOwnerStateVectorParameterFloat(physicsStateValue.LinearSpeed) <= this.GetStaticFloatParameterDefault("minSpeedToExit", 2.0);
  }
}

