  public final native static func PlayAnimation(self: inkWidgetRef, animationDefinition: inkAnimDef) -> inkAnimProxy;

  public final native static func PlayAnimationWithOptions(
    self: inkWidgetRef,
    animationDefinition: inkAnimDef,
    playbackOptions: inkAnimOptions
  ) -> inkAnimProxy;

  public final native static func StopAllAnimations(self: inkWidgetRef);

  public final native static func CallCustomCallback(self: inkWidgetRef, eventName: CName);

