class DelayedAchivementCallback extends DelayCallback {
  protected let id: Int32;
  protected let progress: Float;
  protected let dataTrackingSystem: DataTrackingSystem;

  public final static func Create(id: Int32, progress: Float, dataTrackingSystem: DataTrackingSystem) -> DelayedAchivementCallback {
    let callback = new DelayedAchivementCallback();
    callback.id = id;
    callback.progress = progress;
    callback.dataTrackingSystem = dataTrackingSystem;
    return callback;
  }

  public func Call() {
    let gdAchievement: gamedataAchievement;
    let evt = new SetAchievementProgressRequest();
    if this.id == -1 {
      gdAchievement = IntEnum<gamedataAchievement>(RandRange(0, 58));
    } else {
      gdAchievement = IntEnum<gamedataAchievement>(this.id);
    }
    evt.achievement = gdAchievement;
    evt.currentValue = Cast<Int32>(this.progress * 1000.0);
    this.dataTrackingSystem.QueueRequest(evt);
  }
}

