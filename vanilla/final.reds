native class NavigationSystem extends IScriptable {
  public const final native func CalculatePathOnlyHumanNavmesh(
    startPoint: Vector4,
    endPoint: Vector4,
    agentSize: NavGenAgentSize,
    findPointTolerance: Float,
    opt costModCircle: NavigationCostModCircle
  ) -> NavigationPath;

  public final native func FindWallInLineOnlyHumanNavmesh(
    startPoint: Vector4,
    endPoint: Vector4,
    agentSize: NavGenAgentSize,
    findPointTolerance: Float
  ) -> NavigationFindWallResult;

  public const final native func FindPointInSphereOnlyHumanNavmesh(center: Vector4, radius: Float, agentSize: NavGenAgentSize, heightDetail: Bool) -> NavigationFindPointResult;

  public const final native func FindPursuitPoint(
    playerPos: Vector4,
    pos: Vector4,
    dir: Vector4,
    radius: Float,
    navVisCheck: Bool,
    agentSize: NavGenAgentSize,
    out destination: Vector4,
    out isDestinationFallback: Bool
  ) -> Bool;

  public const final native func FindPursuitPointRange(
    playerPos: Vector4,
    pos: Vector4,
    dir: Vector4,
    radiusMin: Float,
    radiusMax: Float,
    navVisCheck: Bool,
    agentSize: NavGenAgentSize,
    out destination: Vector4,
    out isDestinationFallback: Bool
  ) -> Bool;

  public const final native func FindPursuitPointsRange(
    playerPos: Vector4,
    pos: Vector4,
    dir: Vector4,
    radiusMin: Float,
    radiusMax: Float,
    count: Int32,
    navVisCheck: Bool,
    agentSize: NavGenAgentSize,
    out results: [Vector4],
    out fallbackResults: [Vector4]
  ) -> Bool;

  public const final native func FindNavmeshPointAwayFromReferencePoint(
    pos: Vector4,
    refPos: Vector4,
    distance: Float,
    agentSize: NavGenAgentSize,
    out destination: Vector4,
    opt distanceTolerance: Float,
    opt angleTolerance: Float
  ) -> Bool;

  public const final native func IsNavmeshStreamedInLocation(
    origin: Vector4,
    findPointTolerance: Float,
    opt allowedMask: Uint16,
    opt blockedMask: Uint16
  ) -> Bool;

  public final native func AddObstacle(position: Vector4, radius: Float, height: Float, agentSize: NavGenAgentSize) -> NavigationObstacle;

  public final native func RemoveObstacle(obstacle: NavigationObstacle);

  public const final func GetNearestNavmeshPointBelowOnlyHumanNavmesh(origin: Vector4, querySphereRadius: Float, numberOfSpheres: Int32) -> Vector4 {
    let point: Vector4;
    let i = 0;
    while i < numberOfSpheres {
      let pointResults = this
        .FindPointInSphereOnlyHumanNavmesh(origin, querySphereRadius, NavGenAgentSize.Human, false);
      if NotEquals(pointResults.status, worldNavigationRequestStatus.OK) {
        origin.Z -= querySphereRadius;
      }
      point = pointResults.point;
      break;
      i += 1;
    }
    return point;
  }

  public const final func IsOnGround(const target: GameObject, opt queryLength: Float) -> Bool {
    let staticQueryFilter: QueryFilter;
    if queryLength == 0.0 {
      queryLength = 0.2;
    }
    let startingPoint = target.GetWorldPosition() + target.GetWorldUp() * 0.1;
    QueryFilter.AddGroup(staticQueryFilter, n"Static");
    let geometryDescription = new GeometryDescriptionQuery();
    geometryDescription.refPosition = startingPoint;
    geometryDescription.refDirection = new Vector4(0.0, 0.0, -1.0, 0.0);
    geometryDescription.filter = staticQueryFilter;
    geometryDescription.primitiveDimension = new Vector4(0.1, 0.1, queryLength, 0.0);
    let geometryDescriptionResult = GameInstance
      .GetSpatialQueriesSystem(target.GetGame())
      .GetGeometryDescriptionSystem()
      .QueryExtents(geometryDescription);
    return Equals(
      geometryDescriptionResult.queryStatus,
      worldgeometryDescriptionQueryStatus.OK
    );
  }
}

class ActionsSequencerControllerPS extends MasterControllerPS {
  private let m_sequenceDuration: Float;
  private let m_sequencerMode: EActionsSequencerMode;
  private let m_actionTypeToForward: SActionTypeForward;
  private let m_ongoingSequence: ActionsSequence;

  protected func Initialize() {
    if this.m_sequenceDuration == 0.0 {
      this.m_sequencerMode = EActionsSequencerMode.AT_THE_SAME_TIME_TODO;
    }
    this.m_sequencerMode = EActionsSequencerMode.REGULAR_INTERVALS;
    super.Initialize();
  }

  private final func OnForwardAction(evt: ForwardAction) -> EntityNotificationType {
    if !this.IsActionTypeMachingPreferences(evt) {
      return EntityNotificationType.DoNotNotifyEntity;
    }
    let eligibleSlaves = this.GetEligibleSlaves(evt.requester);
    if ArraySize(eligibleSlaves) <= 1 {
      return EntityNotificationType.DoNotNotifyEntity;
    } else if this.IsSequenceOngoing() {
      if !IsFinal() {
      }
      return EntityNotificationType.DoNotNotifyEntity;
    } else if IsDefined(evt.actionToForward) {
      this
        .CommenceSequence(
          evt.actionToForward,
          eligibleSlaves,
          this.GetDelayTimeStamps(ArraySize(eligibleSlaves))
        );
    }
    return EntityNotificationType.DoNotNotifyEntity;
  }

  private final func IsActionTypeMachingPreferences(forwardEvent: ForwardAction) -> Bool {
    if forwardEvent.actionToForward.IsQuickHack() && this.m_actionTypeToForward.qHack {
      return true;
    } else if forwardEvent.actionToForward.IsSpiderbotAction() && this.m_actionTypeToForward.techie {
      return true;
    } else if this.WasExecutedByMaster(forwardEvent) && this.m_actionTypeToForward.master {
      return true;
    }
    return false;
  }

  private final func WasExecutedByMaster(forwardEvent: ForwardAction) -> Bool {
    return PersistentID.ExtractEntityID(forwardEvent.requester) != forwardEvent.actionToForward.GetRequesterID();
  }

  private final func CommenceSequence(
    actionToForward: ScriptableDeviceAction,
    const eligibleSlaves: script_ref<[DeviceComponentPS]>,
    const delays: script_ref<[Float]>
  ) {
    let delaySystem = GameInstance.GetDelaySystem(this.GetGameInstance());
    if !IsDefined(delaySystem) {
      if !IsFinal() {
      }
      return;
    }
    this.m_ongoingSequence.sequenceInitiator = actionToForward.GetRequesterID();
    this.m_ongoingSequence.maxActionsInSequence = ArraySize(eligibleSlaves);
    this.m_ongoingSequence.actionsTriggeredCount = 0;
    this.ForceLockOnAllSlaves();
    if Equals(this.m_sequencerMode, EActionsSequencerMode.AT_THE_SAME_TIME_TODO) {
    } else if ArraySize(eligibleSlaves) != ArraySize(delays) {
      if !IsFinal() {
      } else {
        return;
      }
    } else {
      let i = 0;
      if i < ArraySize(delays) {
        let sequenceCallback = new SequenceCallback();
        sequenceCallback.persistentID = eligibleSlaves[i].GetID();
        sequenceCallback.className = eligibleSlaves[i].GetClassName();
        sequenceCallback.actionToForward = actionToForward;
        ArrayPush(
          this.m_ongoingSequence.delayIDs,
          delaySystem
            .DelayPSEvent(this.GetID(), this.GetClassName(), sequenceCallback, delays[i])
        );
        i += 1;
      }
    }
  }

  public final func OnSequenceCallback(evt: SequenceCallback) -> EntityNotificationType {
    this.m_ongoingSequence.actionsTriggeredCount += 1;
    this
      .GetPersistencySystem()
      .QueuePSEvent(evt.persistentID, evt.className, evt.actionToForward);
    this.ForceUnlockSlave(evt.persistentID, evt.className);
    if this.m_ongoingSequence.actionsTriggeredCount == this.m_ongoingSequence.maxActionsInSequence - 1 {
      this.CleanupSequence();
    }
    return EntityNotificationType.DoNotNotifyEntity;
  }

  private const final func ForceUnlockSlave(persistentID: PersistentID, className: CName) {
    let unlockDevice = new SequencerLock();
    unlockDevice.shouldLock = false;
    GameInstance
      .GetDelaySystem(this.GetGameInstance())
      .DelayPSEvent(persistentID, className, unlockDevice, 0.1);
  }

  private const final func ForceLockOnAllSlaves() {
    let lock = new SequencerLock();
    lock.shouldLock = true;
    let eligibleSlaves = this
      .GetEligibleSlaves(Cast<PersistentID>(this.m_ongoingSequence.sequenceInitiator));
    let i = 0;
    while i < ArraySize(eligibleSlaves) {
      this
        .GetPersistencySystem()
        .QueuePSEvent(eligibleSlaves[i].GetID(), eligibleSlaves[i].GetClassName(), lock);
      i += 1;
    }
  }

  private final func CleanupSequence() {
    let emptyID: EntityID;
    this.m_ongoingSequence.sequenceInitiator = emptyID;
    this.m_ongoingSequence.maxActionsInSequence = 0;
    this.m_ongoingSequence.actionsTriggeredCount = 0;
    ArrayClear(this.m_ongoingSequence.delayIDs);
  }

  private const final func GetEligibleSlaves(sequenceInitiator: PersistentID) -> [DeviceComponentPS] {
    let fallbackArray: [DeviceComponentPS];
    let slaves = this.GetImmediateSlaves();
    if Equals(sequenceInitiator, this.GetID()) {
      return slaves;
    }
    let i = 0;
    while i < ArraySize(slaves) {
      if Equals(slaves[i].GetID(), sequenceInitiator) {
        ArrayErase(slaves, i);
        return slaves;
      }
      i += 1;
    }
    if !IsFinal() {
    }
    return fallbackArray;
  }

  private const final func GetDelayTimeStamps(intervals: Int32) -> [Float] {
    let delays: [Float];
    switch this.m_sequencerMode {
      case EActionsSequencerMode.REGULAR_INTERVALS:
        this.GetRegularDelays(intervals, delays);
        break;
      case EActionsSequencerMode.ACCELERATING_INTERVALS_TODO:
        this.GetAcceleratingDelays(intervals, delays);
        break;
      case EActionsSequencerMode.DECELERATING_INTEVALS_TODO:
        this.GetDecceleratingDelays(intervals, delays);
        break;
      case EActionsSequencerMode.RANDOM_INTERVALS_TODO:
        this.GetRandomDelays(intervals, delays);
        break;
      case EActionsSequencerMode.AT_THE_SAME_TIME_TODO:
        ArrayPush(delays, this.m_sequenceDuration);
        break;
      default:
        if !IsFinal() {
        }
        this.GetRegularDelays(intervals, delays);
        return delays;
    }
  }

  private const final func GetRegularDelays(amountOfIntervals: Int32, delays: script_ref<[Float]>) {
    let interval = this.m_sequenceDuration / Cast<Float>(amountOfIntervals);
    let i = 1;
    while i < amountOfIntervals + 1 {
      ArrayPush(delays, interval * Cast<Float>(i));
      i += 1;
    }
  }

  private const final func GetAcceleratingDelays(amountOfIntervals: Int32, delays: script_ref<[Float]>);

  private const final func GetDecceleratingDelays(amountOfIntervals: Int32, delays: script_ref<[Float]>);

  private const final func GetRandomDelays(amountOfIntervals: Int32, delays: script_ref<[Float]>);

  private const final func IsSequenceOngoing() -> Bool {
    if this.m_ongoingSequence.maxActionsInSequence > 0 {
      return true;
    }
    return false;
  }

  public func GetQuestActions(out outActions: [DeviceAction], const context: script_ref<GetActionsContext>) {
    if Clearance.IsInRange(context.clearance, 99) {
      ArrayPush(outActions, this.ActionQuestForcePower());
      ArrayPush(outActions, this.ActionQuestForceUnpower());
      ArrayPush(outActions, this.ActionQuestForceON());
      ArrayPush(outActions, this.ActionQuestForceOFF());
      ArrayPush(outActions, this.ActionActivateDevice());
      ArrayPush(outActions, this.ActionDeactivateDevice());
    }
    return;
  }

  protected func OnQuestForceOFF(evt: QuestForceOFF) -> EntityNotificationType {
    let forwarder = new ForwardAction();
    forwarder.requester = this.GetID();
    forwarder.actionToForward = evt;
    this.OnForwardAction(forwarder);
    return EntityNotificationType.DoNotNotifyEntity;
  }

  protected func OnQuestForceON(evt: QuestForceON) -> EntityNotificationType {
    let forwarder = new ForwardAction();
    forwarder.requester = this.GetID();
    forwarder.actionToForward = evt;
    this.OnForwardAction(forwarder);
    return EntityNotificationType.DoNotNotifyEntity;
  }

  protected func OnQuestForceUnpower(evt: QuestForceUnpower) -> EntityNotificationType {
    let forwarder = new ForwardAction();
    forwarder.requester = this.GetID();
    forwarder.actionToForward = evt;
    this.OnForwardAction(forwarder);
    return EntityNotificationType.DoNotNotifyEntity;
  }

  protected func OnQuestForcePower(evt: QuestForcePower) -> EntityNotificationType {
    let forwarder = new ForwardAction();
    forwarder.requester = this.GetID();
    forwarder.actionToForward = evt;
    this.OnForwardAction(forwarder);
    return EntityNotificationType.DoNotNotifyEntity;
  }

  protected func OnSetDeviceON(evt: SetDeviceON) -> EntityNotificationType {
    let forwarder = new ForwardAction();
    forwarder.requester = this.GetID();
    forwarder.actionToForward = evt;
    this.OnForwardAction(forwarder);
    return EntityNotificationType.DoNotNotifyEntity;
  }

  protected func OnSetDeviceOFF(evt: SetDeviceOFF) -> EntityNotificationType {
    let forwarder = new ForwardAction();
    forwarder.requester = this.GetID();
    forwarder.actionToForward = evt;
    this.OnForwardAction(forwarder);
    return EntityNotificationType.DoNotNotifyEntity;
  }

  protected func OnSetDevicePowered(evt: SetDevicePowered) -> EntityNotificationType {
    let forwarder = new ForwardAction();
    forwarder.requester = this.GetID();
    forwarder.actionToForward = evt;
    this.OnForwardAction(forwarder);
    return EntityNotificationType.DoNotNotifyEntity;
  }

  protected func OnSetDeviceUnpowered(evt: SetDeviceUnpowered) -> EntityNotificationType {
    let forwarder = new ForwardAction();
    forwarder.requester = this.GetID();
    forwarder.actionToForward = evt;
    this.OnForwardAction(forwarder);
    return EntityNotificationType.DoNotNotifyEntity;
  }

  protected func OnActivateDevice(evt: ActivateDevice) -> EntityNotificationType {
    let forwarder = new ForwardAction();
    forwarder.requester = this.GetID();
    forwarder.actionToForward = evt;
    this.OnForwardAction(forwarder);
    return EntityNotificationType.DoNotNotifyEntity;
  }

  protected func OnDeactivateDevice(evt: DeactivateDevice) -> EntityNotificationType {
    let forwarder = new ForwardAction();
    forwarder.requester = this.GetID();
    forwarder.actionToForward = evt;
    this.OnForwardAction(forwarder);
