class SniperNestControllerPS extends SensorDeviceControllerPS {
  private let m_vfxNameOnShoot: CName;
  private persistent let m_isRippedOff: Bool;

  protected cb func OnInstantiated() -> Bool {
    super.OnInstantiated();
    if !IsStringValid(this.m_deviceName) {
      this.m_deviceName = "Gameplay-Devices-DisplayNames-SniperNest";
    }
  }

  protected func Initialize() {
    super.Initialize();
  }

  protected func GameAttached();

  public final func GetRippedOff() -> Bool {
    return this.m_isRippedOff;
  }

  public final func SetRippedOff(value: Bool) {
    this.m_isRippedOff = value;
  }

  protected func LogicReady() {
    super.LogicReady();
  }

  protected final func SetDeviceState(state: EDeviceStatus) {
    super.SetDeviceState(state);
  }

  public const final func GetIsUnderControl() -> Bool {
    return this.m_isControlledByThePlayer;
  }

  public const final func GetVfxNameOnShoot() -> String {
    return ToString(this.m_vfxNameOnShoot);
  }

  protected final func ActionQuestEjectPlayer() -> QuestEjectPlayer {
    let action = new QuestEjectPlayer();
    action.clearanceLevel = 99;
    action.SetUp(this);
    action.SetProperties();
    action.AddDeviceName(this.m_deviceName);
    return action;
  }

  protected final func ActionQuestEnterPlayer() -> QuestEnterPlayer {
    let action = new QuestEnterPlayer();
    action.clearanceLevel = 99;
    action.SetUp(this);
    action.SetProperties();
    action.AddDeviceName(this.m_deviceName);
    return action;
  }

  protected final func ActionQuestEnterNoAnimation() -> QuestEnterNoAnimation {
    let action = new QuestEnterNoAnimation();
    action.clearanceLevel = 99;
    action.SetUp(this);
    action.SetProperties();
    action.AddDeviceName(this.m_deviceName);
    return action;
  }

  protected final func ActionQuestExitNoAnimation() -> QuestExitNoAnimation {
    let action = new QuestExitNoAnimation();
    action.clearanceLevel = 99;
    action.SetUp(this);
    action.SetProperties();
    action.AddDeviceName(this.m_deviceName);
    return action;
  }

  public final func OnQuestEjectPlayer(evt: QuestEjectPlayer) -> EntityNotificationType {
    let notifier = new ActionNotifier();
    notifier.SetNone();
    this.Notify(notifier, evt);
    return EntityNotificationType.SendThisEventToEntity;
  }

  public final func OnQuestEnterPlayer(evt: QuestEnterPlayer) -> EntityNotificationType {
    let notifier = new ActionNotifier();
    notifier.SetNone();
    this.Notify(notifier, evt);
    return EntityNotificationType.SendThisEventToEntity;
  }

  public final func OnQuestEnterNoAnimation(evt: QuestEnterNoAnimation) -> EntityNotificationType {
    let notifier = new ActionNotifier();
    notifier.SetNone();
    this.Notify(notifier, evt);
    return EntityNotificationType.SendThisEventToEntity;
  }

  public final func OnQuestExitNoAnimation(evt: QuestExitNoAnimation) -> EntityNotificationType {
    let notifier = new ActionNotifier();
    notifier.SetNone();
    this.Notify(notifier, evt);
    return EntityNotificationType.SendThisEventToEntity;
  }

  public func GetActions(out actions: [DeviceAction], context: GetActionsContext) -> Bool {
    if !super.GetActions(actions, context) {
      return false;
    }
    let currentAction = this.ActionToggleTakeOverControl();
    currentAction.SetInactiveWithReason(this.m_canPlayerTakeOverControl, "LocKey#7006");
    ArrayPush(actions, currentAction);
    this.SetActionIllegality(actions, this.m_illegalActions.regularActions);
    return true;
  }

  public func GetQuestActions(out actions: [DeviceAction], const context: script_ref<GetActionsContext>) {
    super.GetQuestActions(actions, context);
    ArrayPush(actions, this.ActionQuestEjectPlayer());
    ArrayPush(actions, this.ActionQuestEnterPlayer());
    ArrayPush(actions, this.ActionQuestEnterNoAnimation());
  }
}

