    let vehicleRecord: Vehicle_Record;
    if !VehicleComponent.GetVehicleRecord(gi, owner, vehicleRecord) {
      return false;
    } else if vehicleRecord.TagsContains(desiredTag) {
      return true;
    }
    return false;
