class TrafficLightControllerPS extends ScriptableDeviceComponentPS {
  protected cb func OnInstantiated() -> Bool {
    super.OnInstantiated();
    if !IsStringValid(this.m_deviceName) {
      this.m_deviceName = "LocKey#127";
    }
  }

  protected func Initialize() {
    super.Initialize();
  }

  protected func GameAttached() {
    super.GameAttached();
    if this.IsDisabled() {
      this.ForceEnableDevice();
    }
  }

  public final func IsMasterDestroyed() -> Bool {
    let masters: [DeviceComponentPS];
    this.GetParents(masters);
    let i = 0;
    while i < ArraySize(masters) {
      let master = masters[i] as DestructibleMasterDeviceControllerPS;
      if IsDefined(master) {
        return master.IsDestroyed();
      }
      i += 1;
    }
    return false;
  }

  public final func OnMasterDeviceDestroyed(evt: MasterDeviceDestroyed) -> EntityNotificationType {
    if !this.IsDisabled() {
      this.ForceDisableDevice();
    }
    this.UseNotifier(evt);
    return EntityNotificationType.SendThisEventToEntity;
  }
}

