class ApplyEffectorEffector extends Effector {
  public let m_target: EntityID;
  public let m_applicationTarget: CName;
  public let m_effectorToApply: TweakDBID;

  protected func Initialize(record: TweakDBID, game: GameInstance, parentRecord: TweakDBID) {
    this.m_effectorToApply = TweakDBInterface
      .GetApplyEffectorEffectorRecord(record)
      .EffectorToApply()
      .GetID();
    this.m_applicationTarget = TweakDBInterface.GetCName(record + t".applicationTarget", n"None");
  }

  protected func ActionOn(owner: GameObject) {
    if !this.GetApplicationTarget(owner, this.m_applicationTarget, this.m_target) {
      return;
    }
    let es = GameInstance.GetEffectorSystem(owner.GetGame());
    es.ApplyEffector(this.m_target, owner, this.m_effectorToApply);
  }

  protected func ActionOff(owner: GameObject) {
    this.Uninitialize(owner.GetGame());
  }

  protected func Uninitialize(game: GameInstance) {
    if !EntityID.IsDefined(this.m_target) {
      return;
    }
    let es = GameInstance.GetEffectorSystem(game);
    es.RemoveEffector(this.m_target, this.m_effectorToApply);
  }
}

