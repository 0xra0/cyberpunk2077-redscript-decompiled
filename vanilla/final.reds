  public const final func IsPlayerPerformingTakedown() -> Bool {
    let blackboard = GameInstance
      .GetBlackboardSystem(this.GetGameInstance())
      .GetLocalInstanced(
        GetPlayer(this.GetGameInstance()).GetEntityID(),
        GetAllBlackboardDefs().PlayerStateMachine
      );
    let playerStateDefault = blackboard.GetInt(GetAllBlackboardDefs().PlayerStateMachine.Takedown) == 0;
    return !playerStateDefault;
  }

  public const final func IsDisruptivePlayerStatusEffectPresent() -> Bool {
    let player = GetPlayer(this.GetGameInstance());
    return this.m_isUnderEMPEffect
      || StatusEffectSystem.ObjectHasStatusEffectOfType(player, gamedataStatusEffectType.Stunned)
      || StatusEffectSystem.ObjectHasStatusEffectOfType(player, gamedataStatusEffectType.Knockdown)
      || StatusEffectSystem
        .ObjectHasStatusEffectOfType(player, gamedataStatusEffectType.Electrocuted);
  }

  public func GetActions(out outActions: [DeviceAction], context: GetActionsContext) -> Bool {
    let isPerformingTakedown = this.IsPlayerPerformingTakedown();
    let game = this.GetGameInstance();
    if ToggleActivation.IsDefaultConditionMet(this, context) {
      ArrayPush(outActions, this.ActionToggleActivation());
    } else if this.IsDisabled() {
      return false;
    } else if SetDeviceUnpowered.IsDefaultConditionMet(this, context) {
      ArrayPush(outActions, this.ActionTogglePower());
      ArrayPush(outActions, this.ActionSetDeviceUnpowered());
      ArrayPush(outActions, this.ActionSetDevicePowered());
    } else if this.IsPersonalLinkConnecting() {
      if TDBID.IsValid(this.m_personalLinkCustomInteraction) && this.m_personalLinkCustomInteraction != t"Interactions.None" {
        return false;
      }
      return false;
    } else if DisassembleDevice.IsDefaultConditionMet(this, context) {
      ArrayPush(outActions, this.ActionDisassembleDevice());
    } else if this.CanBeFixed() {
      ArrayPush(outActions, this.ActionFixDevice());
    } else if ToggleJuryrigTrap.IsDefaultConditionMet(this, context)
      && GameInstance
        .GetTransactionSystem(game)
        .HasItem(
          GameInstance.GetPlayerSystem(game).GetLocalPlayerMainGameObject(),
          ItemID.CreateQuery(t"Items.grenadeFrag")
        ) {
      ArrayPush(outActions, this.ActionToggleJuryrigTrap());
    } else if ActionScavenge.IsDefaultConditionMet(this) {
      ArrayPush(outActions, this.ActionScavenge(context));
    } else if SetAuthorizationModuleON.IsDefaultConditionMet(this, context) {
      ArrayPush(outActions, this.ActionSetAuthorizationModuleON());
    } else if SetAuthorizationModuleOFF.IsDefaultConditionMet(this, context) {
      ArrayPush(outActions, this.ActionSetAuthorizationModuleOFF());
    } else if this.ShouldShowExamineIntaraction() {
      if !isPerformingTakedown {
        ArrayPush(outActions, this.ActionToggleZoomInteraction());
      } else if this.HasFullScreenUI() && !this.m_isAdvancedInteractionModeOn && this.IsPersonalLinkDisconnected() {
        if !isPerformingTakedown {
          ArrayPush(outActions, this.ActionOpenFullscreenUI());
        } else if this.HasPersonalLinkSlot() {
          if !isPerformingTakedown {
            if Equals(context.requestType, gamedeviceRequestType.Direct) && this.IsPowered() && this.ShouldExposePersonalLinkAction() {
              if this.m_disablePersonalLinkAutoDisconnect
                && NotEquals(
                  this.m_personalLinkStatus,
                  EPersonalLinkConnectionStatus.NOT_CONNECTED
                ) {
              } else if this.m_skillCheckContainer.GetHackingSlot().IsActive() {
              }
              ArrayPush(
                outActions,
                this.ActionTogglePersonalLink(context.processInitiatorObject)
              );
            } else if SetDeviceON.IsDefaultConditionMet(this, context) {
              ArrayPush(outActions, this.ActionSetDeviceON());
              ArrayPush(outActions, this.ActionSetDeviceOFF());
            } else if isPerformingTakedown {
              return false;
            } else if this.PushReturnActions(outActions, context) {
              return false;
            }
          }
        }
      }
    }
    this.SetActionIllegality(outActions, this.m_illegalActions.regularActions);
    return true;
  }

  public const final func IsPotentiallyQuickHackable() -> Bool {
    return !this.m_disableQuickHacks && this.CanCreateAnyQuickHackActions();
  }

  protected const func CanCreateAnyQuickHackActions() -> Bool {
    return false;
  }

  protected func GetQuickHackActions(out outActions: [DeviceAction], const context: script_ref<GetActionsContext>) {
    this.FinalizeGetQuickHackActions(outActions, context);
  }

  protected func GetMinigameActions(outActions: script_ref<[DeviceAction]>, const context: script_ref<GetActionsContext>);

  protected final func FinalizeGetQuickHackActions(outActions: script_ref<[DeviceAction]>, const context: script_ref<GetActionsContext>) {
    let currentAction: ScriptableDeviceAction;
    if NotEquals(this.GetDurabilityState(), EDeviceDurabilityState.NOMINAL) {
      return;
    } else if this.m_disableQuickHacks {
      if ArraySize(outActions) > 0 {
        ArrayClear(outActions);
      }
      return;
    } else if this.IsConnectedToBackdoorDevice() {
      currentAction = this.ActionRemoteBreach();
      currentAction.SetInactiveWithReason(!this.IsBreached(), "LocKey#27728");
      ArrayPush(outActions, currentAction);
      currentAction = this.ActionPing();
      currentAction
        .SetInactiveWithReason(!this.GetNetworkSystem().HasActivePing(this.GetMyEntityID()), "LocKey#49279");
      ArrayPush(outActions, currentAction);
    } else if this.HasNetworkBackdoor() {
      currentAction = this.ActionPing();
      currentAction
        .SetInactiveWithReason(!this.GetNetworkSystem().HasActivePing(this.GetMyEntityID()), "LocKey#49279");
      ArrayPush(outActions, currentAction);
    } else if this.IsUnpowered() {
      ScriptableDeviceComponentPS.SetActionsInactiveAll(outActions, "LocKey#7013");
    } else if !context.ignoresRPG {
      this.EvaluateActionsRPGAvailabilty(outActions, context);
      this.SetActionIllegality(outActions, this.m_illegalActions.quickHacks);
      this.MarkActionsAsQuickHacks(outActions);
      this.SetActionsQuickHacksExecutioner(outActions);
    }
  }

  protected final func FinalizeGetActions(out outActions: [DeviceAction]) {
    this.SetInactiveActionsWithExceptions(outActions);
  }

  public func GetQuickHackActionsExternal(out outActions: [DeviceAction], const context: script_ref<GetActionsContext>);

  protected func CanCreateAnySpiderbotActions() -> Bool {
    return false;
  }

  protected func GetSpiderbotActions(outActions: script_ref<[DeviceAction]>, const context: script_ref<GetActionsContext>);

  protected func SetInactiveActionsWithExceptions(out outActions: [DeviceAction]) {
    let inactiveReason: String;
    let actionAllowedClassNames: [String];
    let actionDisallowedClassNames: [String];
    if this
      .GetActionsRestrictionData(actionAllowedClassNames, actionDisallowedClassNames, inactiveReason) {
      let i = 0;
      while i < ArraySize(outActions) {
        let sAction = outActions[i] as ScriptableDeviceAction;
        if this.FindActionInTweakList(sAction.GetActionID(), actionAllowedClassNames) {
        }
        if ArraySize(actionAllowedClassNames) > 0 {
          (outActions[i] as ScriptableDeviceAction).SetInactiveWithReason(false, inactiveReason);
        } else if this.FindActionInTweakList(sAction.GetActionID(), actionDisallowedClassNames) {
          (outActions[i] as ScriptableDeviceAction).SetInactiveWithReason(false, inactiveReason);
        }
        i += 1;
      }
    }
  }

  protected final func GetActionsRestrictionData(
    allowedNames: script_ref<[String]>,
    disallowedNames: script_ref<[String]>,
    inactiveReason: script_ref<String>
  ) -> Bool {
    let actionRestrictions: [TweakDBID];
    let player = GetPlayer(this.GetGameInstance());
    if !IsDefined(player) {
      return false;
    }
    let psmBB = player.GetPlayerStateMachineBlackboard();
    if !IsDefined(psmBB) {
      return false;
    }
    let tmpVariant = psmBB.GetVariant(GetAllBlackboardDefs().PlayerStateMachine.ActionRestriction);
    if IsDefined(tmpVariant) {
      actionRestrictions = FromVariant<[TweakDBID]>(tmpVariant);
    }
    let i = 0;
    while i < ArraySize(actionRestrictions) {
      if TDBID.IsValid(actionRestrictions[i]) {
        let record = TweakDBInterface.GetActionRestrictionGroupRecord(actionRestrictions[i]);
        if !IsDefined(record) {
          return false;
        }
        let arrSize = record.GetAllowedActionNamesCount();
        if arrSize > 0 {
          let i1 = 0;
          while i1 < arrSize {
            if !ArrayContains(allowedNames, record.GetAllowedActionNamesItem(i1)) {
              ArrayPush(allowedNames, record.GetAllowedActionNamesItem(i1));
            }
            i1 += 1;
          }
          if ArraySize(allowedNames) > 0 {
            inactiveReason = record.InactiveReason();
            return true;
          }
        }
        arrSize = record.GetDisallowedActionNamesCount();
        if arrSize > 0 {
          i1 = 0;
          while i1 < arrSize {
            if this.IgnoreDisallowedAction(record.GetDisallowedActionNamesItem(i1)) {
            } else if !ArrayContains(disallowedNames, record.GetDisallowedActionNamesItem(i1)) {
              ArrayPush(disallowedNames, record.GetDisallowedActionNamesItem(i1));
            }
            i1 += 1;
          }
          if ArraySize(disallowedNames) > 0 {
            inactiveReason = record.InactiveReason();
            return true;
          }
        }
      }
      i += 1;
    }
    return false;
  }

  protected func IgnoreDisallowedAction(actionName: String) -> Bool {
    return false;
  }

  protected final func FindActionInTweakList(actionName: CName, const allowedNames: script_ref<[String]>) -> Bool {
    if ArraySize(allowedNames) <= 0 {
      return false;
    }
    let i = 0;
    while i < ArraySize(allowedNames) {
      if Equals(NameToString(actionName), allowedNames[i]) {
        return true;
      }
      i += 1;
    }
    return false;
  }

