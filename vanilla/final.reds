class UiRadialContextEvents extends InputContextTransitionEvents {
  public let m_mouse: Vector4;

  protected final func OnUpdate(
    timeDelta: Float,
    stateContext: StateContext,
    scriptInterface: StateGameScriptInterface
  ) {
    let leftStick: Vector4;
    leftStick.X = scriptInterface.GetActionValue(n"UI_LookX_Axis");
    leftStick.Y = scriptInterface.GetActionValue(n"UI_LookY_Axis");
    if Vector4.Length(leftStick) <= 0.4 {
      leftStick = Vector4.EmptyVector();
      this.m_mouse.X += scriptInterface.GetActionValue(n"mouse_x") * MaxF(timeDelta, 0.005);
      this.m_mouse.Y += scriptInterface.GetActionValue(n"mouse_y") * MaxF(timeDelta, 0.005);
      this.m_mouse.X = ClampF(this.m_mouse.X, -1.0, 1.0);
      this.m_mouse.Y = ClampF(this.m_mouse.Y, -1.0, 1.0);
      if Vector4.Length(this.m_mouse) <= 0.4 {
        leftStick = Vector4.EmptyVector();
      } else {
        leftStick = Vector4.Normalize(this.m_mouse);
      }
    }
    this
      .SetUIBlackboardVector4Variable(
        scriptInterface,
        GetAllBlackboardDefs().UI_QuickSlotsData.leftStick,
        leftStick
      );
  }

  protected final func SetUIBlackboardVector4Variable(
    scriptInterface: StateGameScriptInterface,
    id: BlackboardID_Vector4,
    value: Vector4
  ) {
    let blackboardSystem = scriptInterface.GetBlackboardSystem();
    let blackboard = blackboardSystem.Get(GetAllBlackboardDefs().UI_QuickSlotsData);
    blackboard.SetVector4(id, value);
  }
}

