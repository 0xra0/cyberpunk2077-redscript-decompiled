class StatsManager extends IScriptable {
  public let m_playerGodModeModifierData: gameStatModifierData;

  public final static func GetObjectDPS(obj: GameObject) -> DPSPackage {
    let newPackage: DPSPackage;
    let objectID = Cast<StatsObjectID>(obj.GetEntityID());
    let statsSystem = GameInstance.GetStatsSystem(obj.GetGame());
    let i = 0;
    while i < 4 {
      let dmgVal = statsSystem
        .GetStatValue(objectID, statsSystem.GetStatType(IntEnum<gamedataDamageType>(i)));
      if dmgVal > 0.0 {
        newPackage.value = dmgVal;
        newPackage.type = IntEnum<gamedataDamageType>(i);
        return newPackage;
      }
      i += 1;
    }
    return newPackage;
  }
}

struct DPSPackage {
  public let value: Float;
  public let type: gamedataDamageType;
}

class ClaymoreMine extends WeaponObject {
  private let m_visualComponent: MeshComponent;
  private let m_triggerAreaIndicator: MeshComponent;
  private let m_shootCollision: SimpleColliderComponent;
  private let m_triggerComponent: TriggerComponent;
  private let m_alive: Bool;
  private let m_armed: Bool;

  protected cb func OnRequestComponents(ri: EntityRequestComponentsInterface) -> Bool {
    super.OnRequestComponents(ri);
    EntityRequestComponentsInterface.RequestComponent(ri, n"ClaymoreMesh", n"MeshComponent", false);
    EntityRequestComponentsInterface.RequestComponent(ri, n"TriggerAreaIndicator", n"MeshComponent", true);
    EntityRequestComponentsInterface.RequestComponent(ri, n"ShootCollision", n"SimpleColliderComponent", true);
  }

  protected cb func OnTakeControl(ri: EntityResolveComponentsInterface) -> Bool {
    super.OnTakeControl(ri);
    this.m_visualComponent = EntityResolveComponentsInterface.GetComponent(ri, n"ClaymoreMesh") as MeshComponent;
    this.m_triggerAreaIndicator = EntityResolveComponentsInterface.GetComponent(ri, n"TriggerAreaIndicator") as MeshComponent;
    this.m_shootCollision = EntityResolveComponentsInterface.GetComponent(ri, n"ShootCollision") as SimpleColliderComponent;
    this.m_triggerComponent = EntityResolveComponentsInterface.GetComponent(ri, n"Trigger") as TriggerComponent;
  }

  protected cb func OnGameAttached() -> Bool {
    let mineArmEvent = new MineArmEvent();
    GameInstance.GetDelaySystem(this.GetGame()).DelayEvent(this, mineArmEvent, 2.0);
    this.AdjustRotation();
  }

  protected cb func OnProjectileInitialize(eventData: gameprojectileSetUpEvent) -> Bool;

  protected cb func OnHit(evt: gameHitEvent) -> Bool {
    let sourceIsPlayer = evt.attackData.GetInstigator() == GetPlayer(this.GetGame());
    if this.m_alive && sourceIsPlayer {
      this.Explode();
    }
  }

  private final func AdjustRotation() {
    let normal = GameInstance
      .GetBlackboardSystem(this.GetGame())
      .Get(GetAllBlackboardDefs().Mines)
      .GetVector4(GetAllBlackboardDefs().Mines.CurrentNormal);
    let rotation = Vector4.ToRotation(normal);
    this.m_visualComponent.SetLocalOrientation(EulerAngles.ToQuat(rotation));
    this.m_triggerComponent.SetLocalOrientation(EulerAngles.ToQuat(rotation));
    this.m_shootCollision.SetLocalOrientation(EulerAngles.ToQuat(rotation));
  }

  protected cb func OnAreaEnter(evt: AreaEnteredEvent) -> Bool {
    let activatorID = EntityGameInterface.GetEntity(evt.activator).GetEntityID();
    let sourceIsPlayer = activatorID == GetPlayer(this.GetGame()).GetEntityID();
    if this.m_armed && this.m_alive && !sourceIsPlayer {
      this.Explode();
    }
  }

  protected cb func OnAreaExit(evt: AreaExitedEvent) -> Bool;

  private final func Explode() {
    let explosionRadius = TDB.GetFloat(t"weapons.E3_grenade.damageRadius");
    let impulseRadius = TDB.GetFloat(t"weapons.E3_grenade.physicalImpulseRadius");
    let attackRecord = TweakDBInterface.GetAttackRecord(t"Attacks.FragGrenade");
    CombatGadgetHelper.SpawnAttack(this, explosionRadius, attackRecord, GetPlayer(this.GetGame()));
    CombatGadgetHelper.SpawnPhysicalImpulse(this, impulseRadius);
    GameObject.PlayMetadataEvent(this, n"exploded");
    GameInstance
      .GetAudioSystem(this.GetGame())
      .PlayShockwave(n"explosion", this.GetWorldPosition());
    this.m_alive = false;
    this.m_visualComponent.Toggle(false);
    let despawnEvent = new MineDespawnEvent();
    GameInstance.GetDelaySystem(this.GetGame()).DelayEvent(this, despawnEvent, 0.5);
  }

  protected cb func OnRelease(evt: MineDespawnEvent) -> Bool {
    let objectPool = GameInstance.GetObjectPoolSystem(this.GetGame());
    objectPool.Release(this);
  }

  protected cb func OnArmed(evt: MineArmEvent) -> Bool {
    this.m_armed = true;
  }

  protected cb func OnScanningEvent(evt: ScanningEvent) -> Bool {
    if Equals(evt.state, gameScanningState.Complete) {
      this.ToggleTriggerAreaIndicator(true);
    }
  }

  protected cb func OnScanningLookedAt(evt: ScanningLookAtEvent) -> Bool {
    super.OnScanningLookedAt(evt);
    if this.m_scanningComponent.IsScanned() {
      if evt.state {
        this.ToggleTriggerAreaIndicator(evt.state);
      }
    }
  }

  protected final func ToggleTriggerAreaIndicator(visible: Bool) {
    this.m_triggerAreaIndicator.Toggle(visible);
  }

  protected cb func OnMinePlace(evt: PlaceMineEvent) -> Bool {
    let item = ItemID.FromTDBID(t"Items.claymore_mine");
    let m_position = evt.m_position;
    GameInstance
      .GetBlackboardSystem(this.GetGame())
      .Get(GetAllBlackboardDefs().Mines)
      .SetVector4(GetAllBlackboardDefs().Mines.CurrentNormal, evt.m_normal);
    GameInstance
      .GetLootManager(this.GetGame())
      .SpawnItemDrop(
        GameInstance.GetPlayerSystem(this.GetGame()).GetLocalPlayerMainGameObject(),
        item,
        m_position
      );
  }
}

