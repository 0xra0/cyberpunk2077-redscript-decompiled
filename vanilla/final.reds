    this.GetDevicePS().UpdateTrespassersList(evt, true);
  }

  protected cb func OnAreaExit(evt: AreaExitedEvent) -> Bool {
    this.GetDevicePS().UpdateTrespassersList(evt, false);
  }

  protected cb func OnSecurityGateResponse(evt: SecurityGateResponse) -> Bool {
    GameObjectEffectHelper.BreakEffectLoopEvent(this, n"scan");
  }

  protected cb func OnInitiateScanner(evt: InitiateScanner) -> Bool {
    GameObjectEffectHelper.StartEffectEvent(this, n"scan");
