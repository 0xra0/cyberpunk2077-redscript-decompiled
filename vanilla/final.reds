  protected func GetMods(onlyGeneric: Bool) -> [InventoryItemAttachments] {
    let result: [InventoryItemAttachments];
    let itemData = this.GetItemData();
    let attachmentsSize = InventoryItemData.GetAttachmentsSize(itemData);
    let i = 0;
    if i < attachmentsSize {
      let attachments = InventoryItemData.GetAttachment(itemData, i);
      if onlyGeneric {
        if NotEquals(attachments.SlotType, InventoryItemAttachmentType.Generic) {
        } else {
          ArrayPush(result, attachments);
        }
      }
      i += 1;
    }
    return result;
  }

  protected func UpdateMods() {
    if !IsDefined(inkWidgetRef.Get(this.m_commonModsRoot)) {
      return;
    }
    let attachments = this.GetMods(true);
    let targetSize = ArraySize(attachments);
    while ArraySize(this.m_attachmentsDisplay) > targetSize {
      inkCompoundRef
        .RemoveChild(this.m_commonModsRoot, ArrayPop(this.m_attachmentsDisplay).GetRootWidget());
    }
    let i = 0;
    while i < targetSize {
      if ArraySize(this.m_attachmentsDisplay) <= i {
        let item = this
          .SpawnFromLocal(inkWidgetRef.Get(this.m_commonModsRoot), n"itemModSlot")
          .GetController() as InventoryItemModSlotDisplay;
        ArrayPush(this.m_attachmentsDisplay, item);
      }
      this.m_attachmentsDisplay[i].Setup(attachments[i].ItemData);
      i += 1;
    }
  }

