  public final static func AddListener(obj: GameObject, listener: PuppetListener) {
    let evt = new AddOrRemoveListenerEvent();
    evt.listener = listener;
    evt.add = true;
    obj.QueueEvent(evt);
  }

  public final static func RemoveListener(obj: GameObject, listener: PuppetListener) {
    let evt = new AddOrRemoveListenerEvent();
    evt.listener = listener;
    obj.QueueEvent(evt);
  }

  protected cb func OnAddOrRemoveListener(evt: AddOrRemoveListenerEvent) -> Bool {
    if evt.add {
      ArrayPush(this.m_listeners, evt.listener);
    } else {
      ArrayRemove(this.m_listeners, evt.listener);
    }
  }

