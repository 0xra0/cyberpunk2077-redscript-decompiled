  private persistent let m_isInteractive: Bool;

  protected cb func OnInstantiated() -> Bool {
    if !IsFinal() {
      this.m_debugPath = StringToName(
        StrAfterLast(EntityID.ToDebugString(PersistentID.ExtractEntityID(this.GetID())), "/")
      );
      this.m_debugID = EntityID.GetHash(PersistentID.ExtractEntityID(this.GetID()));
    } else if !this.IsInitialized() {
      this.Initialize();
    }
  }

  public const func GetParents(out outDevices: [DeviceComponentPS]) {
    if this.m_mastersCached {
      let i = 0;
      while i < ArraySize(this.m_masters) {
        ArrayPush(outDevices, this.m_masters[i]);
        i += 1;
      }
      return;
    }
    GameInstance
      .GetDeviceSystem(this.GetGameInstance())
      .GetParents(this.GetMyEntityID(), outDevices);
  }

  public const func GetImmediateParents() -> [DeviceComponentPS] {
    let masters: [DeviceComponentPS];
    if this.m_mastersCached {
      return this.m_masters;
    }
    GameInstance
      .GetDeviceSystem(this.GetGameInstance())
      .GetParents(this.GetMyEntityID(), masters);
    return masters;
  }

  protected func Initialize() {
    this.m_isInitialized = true;
    if !IsFinal() {
      this.m_debugPath = StringToName(
        StrAfterLast(EntityID.ToDebugString(PersistentID.ExtractEntityID(this.GetID())), "/")
      );
      this.m_debugID = EntityID.GetHash(PersistentID.ExtractEntityID(this.GetID()));
    }
  }

  public final func OnGameAttached(evt: GameAttachedEvent) -> EntityNotificationType {
    this.CacheDevices();
    if !this.IsInitialized() {
      this.Initialize();
    } else if TDBID.IsValid(this.m_personalLinkCustomInteraction) {
      let defaultTDBID = t"Interactions.None";
      if this.m_personalLinkCustomInteraction != defaultTDBID {
        this.m_personalLinkForced = true;
        this.m_disablePersonalLinkAutoDisconnect = true;
      }
    }
    this.m_isAttachedToGame = true;
    if IsStringValid(evt.displayName) {
      this.m_deviceName = evt.displayName;
    } else if evt.isGameplayRelevant {
      if TDBID.IsValid(evt.contentScale) {
        this.m_contentScale = evt.contentScale;
      }
      this.InitializeRPGParams();
      this.DetermineInitialPlaystyle();
    }
    this.GameAttached();
    return EntityNotificationType.SendThisEventToEntity;
  }

  public final func OnLogicReady(evt: SetLogicReadyEvent) -> EntityNotificationType {
    this.m_isLogicReady = evt.isReady;
    this.LogicReady();
    return EntityNotificationType.SendThisEventToEntity;
  }

  protected func GameAttached();

  protected func LogicReady() {
    this.TryInitializeSkillChecks();
  }

  protected func SetDeviceState(state: EDeviceStatus) {
    if this.CanBeInDeviceChain() && EnumInt(state) <= -1 {
      let removeFromChain = new RemoveFromChainRequest();
      removeFromChain.requestSource = this.GetMyEntityID();
      this.GetTakeOverControlSystem().QueueRequest(removeFromChain);
    }
    super.SetDeviceState(state);
  }

  protected func OnDeviceDynamicConnectionChange(evt: DeviceDynamicConnectionChange) -> EntityNotificationType {
    this.m_mastersCached = false;
    this.CacheDevices();
    return EntityNotificationType.DoNotNotifyEntity;
  }

  protected func CacheDevices() {
    if !this.m_mastersCached {
      GameInstance
        .GetDeviceSystem(this.GetGameInstance())
        .GetParents(this.GetMyEntityID(), this.m_masters);
      this.m_mastersCached = true;
    }
  }

  protected final func InitializeRPGParams() {
    this.InitializeContentScale();
    this.InitializeStats();
    this.InitializeStatPools();
  }

  protected final func InitializeContentScale() {
    let statSystem = GameInstance.GetStatsSystem(this.GetGameInstance());
    let powerLevelMod = new gameConstantStatModifierData();
    powerLevelMod.modifierType = gameStatModifierType.Additive;
    powerLevelMod.statType = gamedataStatType.PowerLevel;
    powerLevelMod.value = Cast<Float>(
      GameInstance
        .GetLevelAssignmentSystem(this.GetGameInstance())
        .GetLevelAssignment(this.m_contentScale)
    );
    statSystem.AddModifier(Cast<StatsObjectID>(this.GetMyEntityID()), powerLevelMod);
  }

  protected final func InitializeStats() {
    let statList: [wref<StatModifier_Record>];
    let statModifiers: [gameStatModifierData];
    let statSystem = GameInstance.GetStatsSystem(this.GetGameInstance());
    let record = TweakDBInterface.GetDeviceRecord(this.GetTweakDBRecord());
    if IsDefined(record) {
      record.StatModifiers(statList);
      ArrayResize(statModifiers, ArraySize(statList));
      let i = 0;
      while i < ArraySize(statList) {
        statModifiers[i] = RPGManager.StatRecordToModifier(statList[i]);
        i += 1;
      }
      statSystem.AddModifiers(Cast<StatsObjectID>(this.GetMyEntityID()), statModifiers);
    }
  }

  protected final func InitializeStatPools() {
    let statPools: [wref<StatPool_Record>];
    let statPoolsSystem = GameInstance.GetStatPoolsSystem(this.GetGameInstance());
    let record = TweakDBInterface.GetDeviceRecord(this.GetTweakDBRecord());
    if IsDefined(record) {
      record.StatPools(statPools);
      let i = 0;
      while i < ArraySize(statPools) {
        statPoolsSystem
          .RequestAddingStatPool(Cast<StatsObjectID>(this.GetMyEntityID()), statPools[i].GetID());
        i += 1;
      }
    }
  }

  protected func GetSkillCheckContainerForSetup() -> BaseSkillCheckContainer {
    return null;
  }

  protected final func TryInitializeSkillChecks() {
    let container = this.GetSkillCheckContainerForSetup();
    if IsDefined(container) {
      this.InitializeSkillChecks(container);
    }
  }

  protected final func InitializeSkillChecks(container: BaseSkillCheckContainer, opt isOverride: Bool) {
    if !IsDefined(this.m_skillCheckContainer) {
      this.m_skillCheckContainer = container;
    } else if isOverride || !this.m_skillCheckContainer.IsInitialized() {
      this.InitializeWrapper(container);
    }
  }

  protected final func InitializeWrapper(container: BaseSkillCheckContainer) {
    this.m_skillCheckContainer.Initialize(container);
    if IsDefined(this.m_skillCheckContainer.GetHackingSlot()) {
      this.m_skillCheckContainer.GetHackingSlot().SetDuration(1.0);
    }
    this.InitializeBackdoorSkillcheck();
  }

  public const final func IsInitialized() -> Bool {
    return this.m_isInitialized;
  }

  public const final func ForceResolveGameplayStateOnAttach() -> Bool {
    return this.m_forceResolveStateOnAttach;
  }

  public const final func ForceVisibilityInAnimSystemOnLogicReady() -> Bool {
    return this.m_forceVisibilityInAnimSystemOnLogicReady;
  }

  public const func GetDeviceName() -> String {
    return this.m_deviceName;
  }

  public const final func GetTweakDBRecord() -> TweakDBID {
    return this.m_tweakDBRecord;
  }

  public const final func GetTweakDBDescriptionRecord() -> TweakDBID {
    return this.m_tweakDBDescriptionRecord;
  }

  public const final func GetContentAssignmentID() -> TweakDBID {
    return this.m_contentScale;
  }

  public const func IsConnectedToSystem() -> Bool {
    let ancestors: [DeviceComponentPS];
    this.GetAncestors(ancestors);
    let i = 0;
    while i < ArraySize(ancestors) {
      if IsDefined(ancestors[i] as DeviceSystemBaseControllerPS) {
        return true;
      }
      i += 1;
    }
    return false;
  }

  public const func IsPartOfSystem(systemType: ESystems) -> Bool {
    switch systemType {
      case ESystems.SecuritySystem:
        return this.IsConnectedToSecuritySystem();
      case ESystems.MaintenanceSystem:
        return false;
      case ESystems.AccessPoints:
        return this.IsConnectedToBackdoorDevice();
    }
    return false;
  }

  public const final func GetDurabilityState() -> EDeviceDurabilityState {
    return this.m_durabilityState;
  }

  public const final func GetActivationState() -> EActivationState {
    return this.m_activationState;
  }

  public const final func HasAdvancedInteractions() -> Bool {
    return this.m_canHandleAdvancedInteraction;
  }

  public const final func CanBeTrapped() -> Bool {
    return this.m_canBeTrapped;
  }

  public const final func CanBeDisassembled() -> Bool {
    return this.m_disassembleProperties.m_canBeDisassembled;
  }

  public const final func CanBeFixed() -> Bool {
    return this.m_destructionProperties.m_canBeFixed;
  }

  public const final func GetDurabilityType() -> EDeviceDurabilityType {
    return this.m_destructionProperties.m_durabilityType;
  }

  public const final func HasPersonalLinkSlot() -> Bool {
    return this.m_hasPersonalLinkSlot;
  }

  public const final func CanBeScavengedBySpiderbot() -> Bool {
    return this.m_flatheadScavengeProperties.m_scavengableBySpiderbot;
  }

  public const final func HasQuickHacksDisabled() -> Bool {
    return this.m_disableQuickHacks;
  }

  public const func GetMinigameDefinition() -> TweakDBID {
    if TDBID.IsValid(this.m_minigameDefinition) {
      return this.m_minigameDefinition;
    }
    let ap = this.GetBackdoorAccessPoint();
    if IsDefined(ap) {
      return ap.GetMinigameDefinition();
    }
    return this.m_minigameDefinition;
  }

  public const final func OnQuestMinigameRequest() {
    let minigameID = this.GetMinigameDefinition();
    if !TDBID.IsValid(minigameID) {
      minigameID = t"minigame_v2.DefaultItemMinigame";
    }
    this
      .GetNetworkBlackboard()
      .SetVariant(this.GetNetworkBlackboardDef().MinigameDef, ToVariant(minigameID));
  }

  protected const func ShouldExposePersonalLinkAction() -> Bool {
    if this.IsPersonalLinkConnecting() {
      return false;
    } else if TDBID.IsValid(this.m_personalLinkCustomInteraction) && this.IsPersonalLinkConnected() {
      return false;
    } else if Equals(this.m_personalLinkStatus, EPersonalLinkConnectionStatus.CONNECTED) || this.m_personalLinkForced {
      return true;
    } else if this.IsHackingSkillCheckActive() {
      return false;
    } else if this.IsGlitching() || this.IsDistracting() {
      return false;
    } else if this.HasNetworkBackdoor() {
      return !this.WasHackingMinigameSucceeded();
    }
    return false;
  }

  public final func SetHasPersonalLinkSlot(isPersonalLinkSlotPresent: Bool) {
    this.m_hasPersonalLinkSlot = isPersonalLinkSlotPresent;
  }

  public final func SetHasUICameraZoom(hasUICameraZoom: Bool) {
    this.m_hasUICameraZoom = hasUICameraZoom;
  }

  public final func SetInteractionState(isActive: Bool) {
    if NotEquals(this.m_isInteractive, isActive) {
      this.m_isInteractive = isActive;
    }
  }

  public const func IsInteractive() -> Bool {
    return this.m_isInteractive;
  }

  public const final func IsAdvancedInteractionModeOn() -> Bool {
    return this.m_isAdvancedInteractionModeOn;
  }

  public const final func IsAdvancedInteractionModeOff() -> Bool {
    return !this.IsAdvancedInteractionModeOn();
  }

  public const final func GetPersonalLinkStatus() -> EPersonalLinkConnectionStatus {
    return this.m_personalLinkStatus;
  }

  public const final func IsPersonalLinkConnected() -> Bool {
    return Equals(this.m_personalLinkStatus, EPersonalLinkConnectionStatus.CONNECTED);
  }

  public const final func IsPersonalLinkConnecting() -> Bool {
    return Equals(this.m_personalLinkStatus, EPersonalLinkConnectionStatus.CONNECTING);
  }

  public const final func IsPersonalLinkDisconnecting() -> Bool {
    return Equals(this.m_personalLinkStatus, EPersonalLinkConnectionStatus.DISCONNECTING);
  }

  public const final func IsPersonalLinkDisconnected() -> Bool {
    return Equals(this.m_personalLinkStatus, EPersonalLinkConnectionStatus.NOT_CONNECTED)
      || Equals(this.m_personalLinkStatus, EPersonalLinkConnectionStatus.CONNECTING)
      || Equals(this.m_personalLinkStatus, EPersonalLinkConnectionStatus.DISCONNECTING);
  }

  public const final func IsSecurityWakeUpBlocked() -> Bool {
    return this.m_blockSecurityWakeUp;
  }

  public const final func HasUICameraZoom() -> Bool {
    return this.m_hasUICameraZoom;
  }

  public const final func AllowsUICameraZoomDynamicSwitch() -> Bool {
    return this.m_allowUICameraZoomDynamicSwitch;
  }

  public const final func HasFullScreenUI() -> Bool {
    return this.m_hasFullScreenUI;
  }

  public const final func IsHighlightedInFocusMode() -> Bool {
    return this.m_isHighlightedInFocusMode;
  }

  public const final func IsControlledByPlayer() -> Bool {
    return this.m_isControlledByThePlayer;
  }

  public const final func CanPlayerTakeOverControl() -> Bool {
    return this.m_canPlayerTakeOverControl;
  }

  public const final func IsRestarting() -> Bool {
    return this.m_isRestarting;
  }

  public const final func IsGlitching() -> Bool {
    return this.m_isGlitching;
  }

  public const final func IsTimedTurnOff() -> Bool {
    return this.m_isTimedTurnOff;
  }

  public const final func IsDistracting() -> Bool {
    return this.m_distractExecuted;
  }

  public const final func IsActivated() -> Bool {
    if Equals(this.m_activationState, EActivationState.ACTIVATED) {
      return true;
    }
    return false;
  }

  public const final func GetActiveContexts() -> [gamedeviceRequestType] {
    return this.m_activeContexts;
  }

  public const final func GetMinigameAttempt() -> Int32 {
    return this.m_minigameAttempt;
  }

  public const final func ShouldScannerShowStatus() -> Bool {
    return this.m_shouldScannerShowStatus;
  }

  public const final func ShouldScannerShowNetwork() -> Bool {
    return this.m_shouldScannerShowNetwork;
  }

  public const final func ShouldScannerShowAttitude() -> Bool {
    return this.m_shouldScannerShowAttitude;
  }

  public const final func ShouldScannerShowRole() -> Bool {
    return this.m_shouldScannerShowRole;
  }

  public const final func ShouldScannerShowHealth() -> Bool {
    return this.m_shouldScannerShowHealth;
  }

  public const final func CanBeInDeviceChain() -> Bool {
    return this.m_canBeInDeviceChain
      && this.IsPowered()
      && Equals(this.GetDurabilityState(), EDeviceDurabilityState.NOMINAL);
  }

  public const func ShouldShowExamineIntaraction() -> Bool {
    return this.HasUICameraZoom()
      && !this.m_isAdvancedInteractionModeOn
      && this.IsON()
      && !this.IsPersonalLinkConnected()
      && !this.IsPersonalLinkConnecting();
  }

  public const final func IsSpiderbotInteractionOrdered() -> Bool {
    return this.m_isSpiderbotInteractionOrdered;
  }

  protected final func OnSetIsSpiderbotInteractionOrderedEvent(evt: SetIsSpiderbotInteractionOrderedEvent) -> EntityNotificationType {
    this.m_isSpiderbotInteractionOrdered = evt.value;
    return EntityNotificationType.DoNotNotifyEntity;
  }

  public const final func IsInDirectInteractionRange() -> Bool {
    return this.HasActiveContext(gamedeviceRequestType.Direct);
  }

  public const final func HasActiveContext(context: gamedeviceRequestType) -> Bool {
    let i = 0;
    while i < ArraySize(this.m_activeContexts) {
      if Equals(this.m_activeContexts[i], context) {
        return true;
      }
      i += 1;
    }
    return false;
  }

  public const final func HasPlaystyle(playstyle: EPlaystyle) -> Bool {
    let i = 0;
    while i < ArraySize(this.m_playstyles) {
      if Equals(this.m_playstyles[i], playstyle) {
        return true;
      }
      i += 1;
    }
    return false;
  }

  public const final func GetPlaystyles() -> [EPlaystyle] {
    return this.m_playstyles;
  }

  public const final func HasAnyPlaystyle() -> Bool {
    return ArraySize(this.m_playstyles) > 0;
  }

  public final func PassDeviceName(const deviceName: script_ref<String>, opt dbgDeviceName: CName) {
    if !IsStringValid(this.m_deviceName) {
      this.m_deviceName = deviceName;
    }
  }

  public final func DisbaleRPGChecksForAction(actionID: TweakDBID) {
    if !this.IsActionRPGRequirementDisabled(actionID) {
      ArrayPush(this.m_actionsWithDisabledRPGChecks, actionID);
    }
  }

  public final func EnableRPGChecksForAction(actionID: TweakDBID) {
    let i = ArraySize(this.m_actionsWithDisabledRPGChecks) - 1;
    while i >= 0 {
      if actionID == this.m_actionsWithDisabledRPGChecks[i] {
        ArrayErase(this.m_actionsWithDisabledRPGChecks, i);
      }
      i -= 1;
    }
  }

  public const final func HasAnyActionsWithDisabledRPGChecks() -> Bool {
    return ArraySize(this.m_actionsWithDisabledRPGChecks) > 0;
  }

  private const final func IsActionRPGRequirementDisabled(actionID: TweakDBID) -> Bool {
    let i = 0;
    while i < ArraySize(this.m_actionsWithDisabledRPGChecks) {
      if actionID == this.m_actionsWithDisabledRPGChecks[i] {
        return true;
      }
      i += 1;
    }
    return false;
  }

  public final func SetGlitchingState(isGlitching: Bool) {
    this.m_isGlitching = isGlitching;
  }

  public final func AddActiveContext(context: gamedeviceRequestType) {
    if !this.HasActiveContext(context) {
      ArrayPush(this.m_activeContexts, context);
      this.RefreshPS();
    }
  }

  public final func OnAddActiveContext(evt: AddActiveContextEvent) -> EntityNotificationType {
    this.AddActiveContext(evt.context);
    return EntityNotificationType.DoNotNotifyEntity;
  }

  public final func RemoveActiveContext(context: gamedeviceRequestType) {
    let i = ArraySize(this.m_activeContexts) - 1;
    if i >= 0 {
      if Equals(this.m_activeContexts[i], context) {
        ArrayErase(this.m_activeContexts, i);
        this.RefreshPS();
      } else {
        i -= 1;
      }
    }
  }

