class BaseCodexLinkController extends inkLogicController {
  protected let m_linkImage: inkImageRef;
  protected let m_linkLabel: inkTextRef;
  protected let m_inputContainer: inkWidgetRef;
  protected let m_animProxy: inkAnimProxy;
  protected let m_isInteractive: Bool;

  protected cb func OnInitialize() -> Bool {
    this.RegisterToCallback(n"OnHoverOver", this, n"OnHoverOver");
    this.RegisterToCallback(n"OnHoverOut", this, n"OnHoverOut");
    this.RegisterToCallback(n"OnRelease", this, n"OnRelease");
    this.m_isInteractive = true;
  }

  protected cb func OnHoverOver(evt: inkPointerEvent) -> Bool {
    if this.m_isInteractive {
      this.ForcePlayAnimation(n"hyperlink_hover");
      this.GetRootWidget().SetState(n"Hover");
    }
  }

  protected cb func OnHoverOut(evt: inkPointerEvent) -> Bool {
    if this.m_isInteractive {
      this.ForcePlayAnimation(n"clear_hyperlink_hover");
      this.GetRootWidget().SetState(n"Default");
    }
  }

  protected cb func OnRelease(e: inkPointerEvent) -> Bool {
    if this.m_isInteractive {
      if e.IsAction(n"click") {
        this.Activate();
      } else if e.IsAction(n"activate") {
        this.ActivateSecondary();
      }
    }
  }

  public final func EnableInputHint(value: Bool) {
    inkWidgetRef.SetVisible(this.m_inputContainer, value);
  }

  private func Activate();

  private func ActivateSecondary();

  private final func ForcePlayAnimation(animationName: CName) {
    if this.m_animProxy.IsPlaying() {
      this.m_animProxy.Stop();
    }
    this.m_animProxy = this
      .PlayLibraryAnimationOnAutoSelectedTargets(animationName, this.GetRootWidget());
  }
}

