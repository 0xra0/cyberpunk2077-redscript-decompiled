  }

  protected final func RequestGracefulInterruption(const context: ScriptExecutionContext) -> Bool {
    switch this.m_actionPhase {
      case EAIActionPhase.Startup:
        if this.m_phaseRecord.Duration() < 0.0 {
          if this.ChangePhaseTo(context, EAIActionPhase.Recovery) {
            if this.m_phaseRecord.Duration() < 0.0 {
              this.ChangePhaseTo(context, EAIActionPhase.Inactive);
            }
          } else {
            return false;
          }
        }
      case EAIActionPhase.Loop:
    }
  }

  private final func ReactOnAllPhaseSubActionsCompleted(const context: ScriptExecutionContext) {
    if this.m_phaseRecord.Duration() <= 0.0 {
      if !this.RepeatPhase(context) && !this.m_phaseRecord.DontStopInfiniteOnSubActionsCompletion() {
        this.ChangeToNextPhase(context);
      }
    }
  }

  private final func GetPhaseDuration(const context: ScriptExecutionContext) -> Float {
    return EngineTime.ToFloat(ScriptExecutionContext.GetAITime(context)) - this.m_phaseActivationTimeStamp;
  }

  private final func GetPhaseDurationWithoutFrameDelta(context: ScriptExecutionContext) -> Float {
    return EngineTime.ToFloat(ScriptExecutionContext.GetAITimeLastFrame(context)) - this.m_phaseActivationTimeStamp;
  }

  private final func CalculatePhaseDuration(const context: ScriptExecutionContext, opt phaseDurationFromAnimSlot: Float) {
    let scaledDuration: Float;
    if phaseDurationFromAnimSlot > 0.0 {
      this.m_phaseDuration = phaseDurationFromAnimSlot;
      this.m_phaseAnimationDuration = phaseDurationFromAnimSlot;
    } else if IsDefined(this.m_phaseRecord) {
      if this.m_phaseRecord.MaxDuration() > this.m_phaseRecord.Duration() {
        this.m_phaseDuration = MaxF(
          0.0,
          RandRangeF(this.m_phaseRecord.Duration(), this.m_phaseRecord.MaxDuration())
        );
      } else {
        this.m_phaseDuration = this.m_phaseRecord.Duration();
        if this.m_phaseRecord.AnimationDuration() >= 0.0 {
          this.m_phaseAnimationDuration = this.m_phaseRecord.AnimationDuration();
        } else {
          this.m_phaseAnimationDuration = this.m_phaseDuration;
        }
      }
    }
    if this.m_phaseDuration <= 0.1 {
      return;
    }
    let animData = this.m_actionRecord.AnimData();
    if !IsDefined(animData) || !IsNameValid(animData.AnimFeature()) {
      return;
    } else if IsDefined(this.m_phaseRecord)
      && IsDefined(this.m_phaseRecord.DynamicDuration())
      && TweakAISubAction
        .GetPhaseDuration(
          context,
          this.m_phaseRecord.DynamicDuration(),
          this.m_actionPhase,
          this.m_phaseDuration,
          scaledDuration
        ) {
      let ratio = scaledDuration / this.m_phaseDuration;
      this.m_phaseDuration = scaledDuration;
      if ratio > 0.0 {
        this.m_phaseAnimationDuration *= ratio;
      }
    }
    let allowBlend = 0.0;
    if IsDefined(this.m_actionRecord) {
      allowBlend = this.GetAllowBlendDuration();
      if this.m_actionRecord.AllowBlendPercCap() >= 0.0 {
        allowBlend = MinF(allowBlend, this.m_actionRecord.AllowBlendPercCap() * this.m_phaseDuration);
      }
    }
    this.m_phaseDuration = MaxF(this.m_phaseDuration - allowBlend, 0.001);
  }

  private final func GetAllowBlendDuration() -> Float {
    if this.m_actionRecord.AllowBlendDuration() <= 0.0 {
      return 0.0;
    } else if IsDefined(this.m_actionRecord.Recovery()) && this.m_actionRecord.Recovery().Duration() != 0.0 {
      if NotEquals(this.m_actionPhase, EAIActionPhase.Recovery) {
        return 0.0;
      }
    } else if IsDefined(this.m_actionRecord.Loop()) && this.m_actionRecord.Loop().Duration() != 0.0 {
      if NotEquals(this.m_actionPhase, EAIActionPhase.Loop) {
        return 0.0;
      }
    } else if IsDefined(this.m_actionRecord.Startup()) && this.m_actionRecord.Startup().Duration() != 0.0 {
      if NotEquals(this.m_actionPhase, EAIActionPhase.Startup) {
        return 0.0;
      }
    }
    return 0.0;
  }

  private final func RepeatPhase(const context: ScriptExecutionContext) -> Bool {
    this.m_phaseIteration += 1u;
    if this.m_phaseRecord.Repeat() < 0 || this.m_phaseIteration == Cast<Uint32>(this.m_phaseRecord.Repeat()) {
      return false;
    } else if this.m_repeatPhaseConditionCount
      > 0
      && AICondition
        .RepeatPhaseCheck(context, EnumInt(this.m_actionPhase), this.m_actionRecord) {
      if this.m_phaseRecord.CompleteActionWithFailureOnCondition() {
        this.m_failureStatus = true;
      }
      return false;
    }
    switch this.m_actionPhase {
      case EAIActionPhase.Startup:
        this.DeactivateStartupSubActions(context, this.GetPhaseDuration(context));
        this.ActivateStartupSubActions(context);
        break;
      case EAIActionPhase.Loop:
        this.DeactivateLoopSubActions(context, this.GetPhaseDuration(context));
        this.ActivateLoopSubActions(context);
        break;
      case EAIActionPhase.Recovery:
        this.DeactivateRecoverySubActions(context, this.GetPhaseDuration(context));
        this.ActivateRecoverySubActions(context);
        break;
      case EAIActionPhase.Inactive:
        this.CalculatePhaseDuration(context);
    }
  }

  private final func ChangeToNextPhase(const context: ScriptExecutionContext) -> Bool {
    if Equals(this.m_actionPhase, EAIActionPhase.Inactive) {
      if this.ChangePhaseTo(context, EAIActionPhase.Startup) {
        return true;
      } else if Equals(this.m_actionPhase, EAIActionPhase.Startup) {
        if this.ChangePhaseTo(context, EAIActionPhase.Loop) {
          return true;
        } else if Equals(this.m_actionPhase, EAIActionPhase.Loop) {
          if this.ChangePhaseTo(context, EAIActionPhase.Recovery) {
            return true;
          } else if this.ChangePhaseTo(context, EAIActionPhase.Inactive) {
            return true;
          }
        }
      }
    }
    return false;
  }

  private final func ChangePhaseTo(const context: ScriptExecutionContext, const newPhase: EAIActionPhase) -> Bool {
    if Equals(newPhase, this.m_actionPhase) {
      return false;
    } else if !IsFinal() {
      if Equals(newPhase, EAIActionPhase.Startup) {
        ScriptExecutionContext
          .GetTweakActionSystem(context)
          .Debug_OnActionStarted(
            context,
            this.m_actionRecord.GetID(),
            this.Debug_GetBaseActionId(),
            this.Debug_GetCompositeId()
          );
      } else if IsDefined(this.m_phaseRecord) {
        this.OnPhaseEnded(context, this.GetPhaseDuration(context));
      }
    }
    this.m_actionPhase = newPhase;
    this.m_phaseActivationTimeStamp = EngineTime.ToFloat(ScriptExecutionContext.GetAITimeLastFrame(context));
    this.m_phaseConditionSuccessfulCheckTimeStamp = -1.0;
    this.m_phaseIteration = 0u;
    this.m_phaseSubActionsCount = 0;
    this.m_nextPhaseConditionCount = 0;
    this.m_repeatPhaseConditionCount = 0;
    this.m_phaseForceZeroUpdateInterval = false;
    switch this.m_actionPhase {
      case EAIActionPhase.Startup:
        this.m_phaseRecord = this.m_actionRecord.Startup();
        this.m_phaseSubActionsCount = this.m_actionRecord.GetStartupSubActionsCount();
        if IsDefined(this.m_phaseRecord) {
          this.m_nextPhaseConditionCount = this.m_phaseRecord.GetToNextPhaseConditionCount();
          this.m_repeatPhaseConditionCount = this.m_phaseRecord.GetNotRepeatPhaseConditionCount();
          this.m_phaseForceZeroUpdateInterval = this.m_phaseRecord.ForceZeroUpdateInterval();
        }
        break;
      case EAIActionPhase.Loop:
        this.m_phaseRecord = this.m_actionRecord.Loop();
        this.m_phaseSubActionsCount = this.m_actionRecord.GetLoopSubActionsCount();
        if IsDefined(this.m_phaseRecord) {
          this.m_nextPhaseConditionCount = this.m_phaseRecord.GetToNextPhaseConditionCount();
          this.m_repeatPhaseConditionCount = this.m_phaseRecord.GetNotRepeatPhaseConditionCount();
          this.m_phaseForceZeroUpdateInterval = this.m_phaseRecord.ForceZeroUpdateInterval();
        }
        break;
      case EAIActionPhase.Recovery:
        this.m_phaseRecord = this.m_actionRecord.Recovery();
        this.m_phaseSubActionsCount = this.m_actionRecord.GetRecoverySubActionsCount();
        if IsDefined(this.m_phaseRecord) {
          this.m_nextPhaseConditionCount = this.m_phaseRecord.GetToNextPhaseConditionCount();
          this.m_repeatPhaseConditionCount = this.m_phaseRecord.GetNotRepeatPhaseConditionCount();
          this.m_phaseForceZeroUpdateInterval = this.m_phaseRecord.ForceZeroUpdateInterval();
        }
        break;
      default:
        this.m_phaseRecord = null;
        this.m_phaseConditionCheckRandomizedInterval = 0.0;
    }
    if this.m_nextPhaseConditionCount > 0 && this.m_phaseRecord.ToNextPhaseConditionCheckInterval() > 0.0 {
      this.m_phaseConditionCheckRandomizedInterval = AIBehaviorScriptBase
        .RandomizeOffsetForUpdateInterval(this.m_phaseRecord.ToNextPhaseConditionCheckInterval());
    }
    this.OnPhaseStarted(context);
    return this.m_phaseRecord != null;
  }

  private final func OnPhaseStarted(const context: ScriptExecutionContext) {
    if IsDefined(this.m_phaseRecord) {
      if !IsFinal() {
        ScriptExecutionContext
          .GetTweakActionSystem(context)
          .Debug_OnActionPhaseStarted(context, this.m_actionRecord.GetID(), EnumInt(this.m_actionPhase));
      }
      switch this.m_actionPhase {
        case EAIActionPhase.Startup:
          this.ActivateStartupSubActions(context);
          break;
        case EAIActionPhase.Loop:
          this.ActivateLoopSubActions(context);
          break;
        case EAIActionPhase.Recovery:
          this.ActivateRecoverySubActions(context);
          break;
        default:
          this.CalculatePhaseDuration(context);
      }
    }
    AIbehaviortaskScript.SetUpdateInterval(context, 0.0);
  }

  private final func OnPhaseEnded(const context: ScriptExecutionContext, const duration: Float) {
    switch this.m_actionPhase {
      case EAIActionPhase.Startup:
        this.DeactivateStartupSubActions(context, duration);
        if this.m_repeatPhaseConditionCount > 0 {
          this.m_repeatPhaseConditionsCount -= 1;
        }
        break;
      case EAIActionPhase.Loop:
        this.DeactivateLoopSubActions(context, duration);
        if this.m_repeatPhaseConditionCount > 0 {
          this.m_repeatPhaseConditionsCount -= 1;
        }
        break;
      case EAIActionPhase.Recovery:
        this.DeactivateRecoverySubActions(context, duration);
        if this.m_repeatPhaseConditionCount > 0 {
          this.m_repeatPhaseConditionsCount -= 1;
        }
        break;
      default:
        if IsDefined(this.m_phaseRecord.ChangeNPCState()) {
          this.ResetNPCState(context);
        } else if IsDefined(this.m_movePolicy) {
          AIActionMovePolicy.Pop(context, this.m_movePolicy);
        }
    }
  }

  private final func ActivateGeneralSubActions(const context: ScriptExecutionContext) {
    let count = this.m_actionRecord.GetSubActionsCount();
    if count > ArraySize(this.m_generalSubActionsResults) {
      return;
    }
    let i = 0;
    while i < count {
      let subAction = this.m_actionRecord.GetSubActionsItem(i);
      if TweakAISubAction.Activate(context, subAction) {
        this.m_generalSubActionsResults[i] = AIbehaviorUpdateOutcome.IN_PROGRESS;
      } else {
        this.m_generalSubActionsResults[i] = AIbehaviorUpdateOutcome.FAILURE;
      }
      i += 1;
    }
  }

  private final func ActivateStartupSubActions(const context: ScriptExecutionContext) {
    let count = this.m_actionRecord.GetStartupSubActionsCount();
    if count > ArraySize(this.m_phaseSubActionsResults) {
      return;
    }
    let i = 0;
    while i < count {
      let subAction = this.m_actionRecord.GetStartupSubActionsItem(i);
      if TweakAISubAction.Activate(context, subAction) {
        this.m_phaseSubActionsResults[i] = AIbehaviorUpdateOutcome.IN_PROGRESS;
      } else {
        this.m_phaseSubActionsResults[i] = AIbehaviorUpdateOutcome.FAILURE;
      }
      i += 1;
    }
  }

  private final func ActivateLoopSubActions(const context: ScriptExecutionContext) {
    let count = this.m_actionRecord.GetLoopSubActionsCount();
    if count > ArraySize(this.m_phaseSubActionsResults) {
      return;
    }
    let i = 0;
    while i < count {
      let subAction = this.m_actionRecord.GetLoopSubActionsItem(i);
      if TweakAISubAction.Activate(context, subAction) {
        this.m_phaseSubActionsResults[i] = AIbehaviorUpdateOutcome.IN_PROGRESS;
      } else {
        this.m_phaseSubActionsResults[i] = AIbehaviorUpdateOutcome.FAILURE;
      }
      i += 1;
    }
  }

  private final func ActivateRecoverySubActions(const context: ScriptExecutionContext) {
    let count = IsDefined(this.m_actionRecord) ? this.m_actionRecord.GetRecoverySubActionsCount() : 0;
    if count > ArraySize(this.m_phaseSubActionsResults) {
      return;
    }
    let i = 0;
    while i < count {
      let subAction = this.m_actionRecord.GetRecoverySubActionsItem(i);
      if TweakAISubAction.Activate(context, subAction) {
        this.m_phaseSubActionsResults[i] = AIbehaviorUpdateOutcome.IN_PROGRESS;
      } else {
        this.m_phaseSubActionsResults[i] = AIbehaviorUpdateOutcome.FAILURE;
      }
      i += 1;
    }
  }

  private final func DeactivateGeneralSubActions(const context: ScriptExecutionContext, const duration: Float) {
    let count = IsDefined(this.m_actionRecord) ? this.m_actionRecord.GetSubActionsCount() : 0;
    let i = 0;
    while i < count {
      let subAction = this.m_actionRecord.GetSubActionsItem(i);
      TweakAISubAction.Deactivate(context, subAction, duration, this.m_gracefullyInterrupted);
      i += 1;
    }
  }

  private final func DeactivateStartupSubActions(const context: ScriptExecutionContext, const duration: Float) {
    let count = IsDefined(this.m_actionRecord) ? this.m_actionRecord.GetStartupSubActionsCount() : 0;
    let i = 0;
    while i < count {
      let subAction = this.m_actionRecord.GetStartupSubActionsItem(i);
      TweakAISubAction.Deactivate(context, subAction, duration, this.m_gracefullyInterrupted);
      i += 1;
    }
  }

  private final func DeactivateLoopSubActions(const context: ScriptExecutionContext, const duration: Float) {
    let count = IsDefined(this.m_actionRecord) ? this.m_actionRecord.GetLoopSubActionsCount() : 0;
    let i = 0;
    while i < count {
      let subAction = this.m_actionRecord.GetLoopSubActionsItem(i);
      TweakAISubAction.Deactivate(context, subAction, duration, this.m_gracefullyInterrupted);
      i += 1;
    }
  }

  private final func DeactivateRecoverySubActions(const context: ScriptExecutionContext, const duration: Float) {
    let count = IsDefined(this.m_actionRecord) ? this.m_actionRecord.GetRecoverySubActionsCount() : 0;
    let i = 0;
    while i < count {
      let subAction = this.m_actionRecord.GetRecoverySubActionsItem(i);
      TweakAISubAction.Deactivate(context, subAction, duration, this.m_gracefullyInterrupted);
      i += 1;
    }
  }

  private final func ActivateAnimationWrapperOverrides(const context: ScriptExecutionContext) {
    if this.m_actionRecord.GetAnimationWrapperOverridesCount() <= 0 {
      return;
    }
    this.SetAnimationWrapperOverrides(context, 1.0);
  }

  private final func DeactivateAnimationWrapperOverrides(const context: ScriptExecutionContext) {
    if this.m_actionRecord.GetAnimationWrapperOverridesCount() <= 0 {
      return;
    }
    this.SetAnimationWrapperOverrides(context, 0.0);
  }

  private final func SetAnimationWrapperOverrides(const context: ScriptExecutionContext, value: Float) {
    let items: [wref<ItemObject>];
    let wrappers = this.m_actionRecord.AnimationWrapperOverrides();
    if ArraySize(wrappers) > 0 {
      AIActionHelper.GetItemsFromWeaponSlots(ScriptExecutionContext.GetOwner(context), items);
      let i = 0;
      while i < ArraySize(wrappers) {
        AnimationControllerComponent
          .SetAnimWrapperWeight(ScriptExecutionContext.GetOwner(context), wrappers[i], value);
        let j = 0;
        while j < ArraySize(items) {
          AnimationControllerComponent.SetAnimWrapperWeight(items[j], wrappers[j], value);
          j += 1;
        }
        i += 1;
      }
    }
  }

  private final func ActivateAnimData(const context: ScriptExecutionContext) {
    if this.m_actionRecord.AnimData().RagdollOnDeath() {
      if (ScriptExecutionContext.GetOwner(context) as NPCPuppet).IsCrowd()
        && (ScriptExecutionContext.GetOwner(context) as NPCPuppet).m_shouldBeImmuneToVehicleHit {
        NPCPuppet
          .ChangeForceRagdollOnDeath(ScriptExecutionContext.GetOwner(context), false);
      } else {
        NPCPuppet
          .ChangeForceRagdollOnDeath(ScriptExecutionContext.GetOwner(context), true);
      }
    } else if this.m_actionRecord.AnimData().WeaponOverride() > 0 {
      this.WeaponOverride(context, this.m_actionRecord.AnimData().WeaponOverride());
    }
  }

  private final func DeactivateAnimData(const context: ScriptExecutionContext) {
    if this.m_actionRecord.AnimData().RagdollOnDeath() {
      NPCPuppet
        .ChangeForceRagdollOnDeath(ScriptExecutionContext.GetOwner(context), false);
    } else if this.m_actionRecord.AnimData().WeaponOverride() > 0 {
      this.WeaponOverride(context, 0);
    } else if IsDefined(this.m_actionRecord.AnimData().AnimSlot()) {
      AIBehaviorScriptBase
        .GetPuppet(context)
        .GetPuppetStateBlackboard()
        .SetBool(GetAllBlackboardDefs().PuppetState.SlotAnimationInProgress, false);
    }
  }

  private final func SendAnimData(const context: ScriptExecutionContext) {
    let items: [wref<ItemObject>];
    let animData = this.m_actionRecord.AnimData();
    let animFeatureName = animData.AnimFeature();
    if !IsNameValid(animFeatureName) {
      return;
    }
    let animFeature = this.GetAnimFeature(context);
    if IsDefined(animData.AnimSlot()) {
      this.PlayAnimationOnSlot(context, animFeature);
    } else {
      AnimationControllerComponent
        .ApplyFeatureToReplicate(ScriptExecutionContext.GetOwner(context), animFeatureName, animFeature);
    }
    if AIActionHelper.GetItemsFromWeaponSlots(ScriptExecutionContext.GetOwner(context), items) {
      let i = 0;
      while i < ArraySize(items) {
        AnimationControllerComponent.ApplyFeatureToReplicate(items[i], animFeatureName, animFeature);
        i += 1;
      }
    }
  }

  private final func GetAnimFeature(const context: ScriptExecutionContext) -> AnimFeature_AIAction {
    let animVariation: Int32;
    let animFeature = new AnimFeature_AIAction();
    animFeature.state = EnumInt(this.m_actionPhase);
    animFeature.stateDuration = this.m_phaseAnimationDuration;
    if IsDefined(this.m_actionRecord.AnimData().Direction()) {
      animFeature.direction = this.GetAnimDirection(context, this.m_actionRecord.AnimData().Direction());
    } else if IsDefined(this.m_actionRecord.AnimData().AnimVariationSubAction()) {
      if IsDefined(
        this.m_actionRecord.AnimData().AnimVariationSubAction() as AISubActionRandomize_Record
      ) {
        let blackBoard = (ScriptExecutionContext.GetOwner(context) as ScriptedPuppet).GetAIControllerComponent().GetActionBlackboard();
        if FromVariant<TweakDBID>(
          blackBoard
            .GetVariant(GetAllBlackboardDefs().AIAction.ownerLastAnimVariationAction)
        ) != this.m_actionRecord.GetID() {
          blackBoard
            .SetBool(GetAllBlackboardDefs().AIAction.ownerCurrentAnimVariationSet, false);
        }
        blackBoard
          .SetVariant(
            GetAllBlackboardDefs().AIAction.ownerLastAnimVariationAction,
            ToVariant(this.m_actionRecord.GetID())
          );
        if TweakAISubAction
          .GetAnimVariation(
            context,
            this.m_actionRecord.AnimData().AnimVariationSubAction() as AISubActionRandomize_Record,
            animVariation
          ) {
          animFeature.animVariation = animVariation;
        }
        animFeature.animVariation = this.m_actionRecord.AnimData().AnimVariation();
      } else if TweakAISubAction
        .GetAnimVariation(
          context,
          this.m_actionRecord.AnimData().AnimVariationSubAction(),
          animVariation
        ) {
        animFeature.animVariation = animVariation;
      }
      animFeature.animVariation = this.m_actionRecord.AnimData().AnimVariation();
    }
    animFeature.animVariation = this.m_actionRecord.AnimData().AnimVariation();
    return animFeature;
  }

  private final func GetAnimDirection(
    const context: ScriptExecutionContext,
    animDirection: wref<AIActionAnimDirection_Record>
  ) -> Float {
    let targetPos: Vector4;
    if AIActionTarget.GetPosition(context, animDirection.Target(), targetPos, false) {
      let vecToTarget = targetPos - ScriptExecutionContext.GetOwner(context).GetWorldPosition();
      return AngleNormalize180(
        Vector4
          .GetAngleDegAroundAxis(
            ScriptExecutionContext.GetOwner(context).GetWorldForward(),
            vecToTarget,
            ScriptExecutionContext.GetOwner(context).GetWorldUp()
          ) + animDirection.DirectionAngle()
      );
    }
    return AngleNormalize180(animDirection.DirectionAngle());
  }

  private final func PlayAnimationOnSlot(const context: ScriptExecutionContext, animFeature: wref<AnimFeature_AIAction>) {
    let slideParams: ActionAnimationSlideParams;
    let slideTarget: wref<GameObject>;
    let slideTargetTrackingMode: gamedataTrackingMode;
    let actionAnimationScriptProxy = AIBehaviorScriptBase
      .GetPuppet(context)
      .GetAIControllerComponent()
      .GetActionAnimationScriptProxy();
    if IsDefined(actionAnimationScriptProxy) {
      AIBehaviorScriptBase
        .GetPuppet(context)
        .GetPuppetStateBlackboard()
        .SetBool(GetAllBlackboardDefs().PuppetState.SlotAnimationInProgress, true);
      if Equals(this.m_actionPhase, EAIActionPhase.Inactive) {
        actionAnimationScriptProxy.Stop();
        actionAnimationScriptProxy
          .Setup(
            this.m_actionRecord.AnimData().AnimFeature(),
            new AnimFeature_AIAction(),
            false,
            false,
            false,
            false,
            this.m_actionRecord.AnimData().UpdateMovePolicy(),
            slideParams,
            slideTarget,
            this.m_actionRecord.AnimData().MarginToPlayer()
          );
        actionAnimationScriptProxy.Launch();
      } else if this.GetSlideTarget(context, slideTarget, slideTargetTrackingMode) {
        slideParams = this.GetSlideParams(context, slideTarget);
      } else if NotEquals(slideTargetTrackingMode, gamedataTrackingMode.RealPosition) {
        let slideTargetPositionProvider = AIActionMovePolicy
          .GetTargetPositionProvider(
            ScriptExecutionContext.GetOwner(context) as ScriptedPuppet,
            slideTarget,
            slideTargetTrackingMode
          );
      } else {
        actionAnimationScriptProxy.Stop();
        if IsDefined(this.m_phaseRecord)
          && this.m_phaseRecord.UseDurationFromAnimSlot()
          && this.m_phaseRecord.Duration() > 0.0 {
          let phaseDurationFromAnimSlot = actionAnimationScriptProxy
            .GetPhaseDuration(this.m_actionRecord.AnimData().AnimFeature(), animFeature);
          this.CalculatePhaseDuration(context, phaseDurationFromAnimSlot);
          if AbsF(this.m_phaseAnimationDuration - phaseDurationFromAnimSlot) >= 0.01 {
            animFeature.stateDuration = this.m_phaseAnimationDuration;
          } else if animFeature.stateDuration > 0.0 {
            animFeature.stateDuration = 0.0;
          } else {
            actionAnimationScriptProxy
              .Setup(
                this.m_actionRecord.AnimData().AnimFeature(),
                animFeature,
                this
                  .m_actionRecord
                  .AnimData()
                  .AnimSlot()
                  .UseRootMotion(),
                this
                  .m_actionRecord
                  .AnimData()
                  .AnimSlot()
                  .UsePoseMatching(),
                this
                  .m_actionRecord
                  .AnimData()
                  .AnimSlot()
                  .ResetRagdollOnStart(),
                this
                  .m_actionRecord
                  .AnimData()
                  .AnimSlot()
                  .UseDynamicObjectsCheck(),
                this.m_actionRecord.AnimData().UpdateMovePolicy(),
                slideParams,
                slideTarget,
                this.m_actionRecord.AnimData().MarginToPlayer(),
                slideTargetPositionProvider
              );
            actionAnimationScriptProxy.Launch();
          }
        }
      }
    }
  }

  private final func GetSlideParams(context: ScriptExecutionContext, slideTarget: wref<GameObject>) -> ActionAnimationSlideParams {
    let slideParams: ActionAnimationSlideParams;
    let slideActionParams: AIActionSlideData_Record;
    let weaponData: gameItemData;
    switch this.m_actionPhase {
      case EAIActionPhase.Startup:
        if !IsDefined(this
          .m_actionRecord
          .AnimData()
          .AnimSlot()
          .StartupSlide()) {
        } else {
          slideParams = GetActionAnimationSlideParams(this
            .m_actionRecord
            .AnimData()
            .AnimSlot()
            .StartupSlide());
          slideActionParams = this
            .m_actionRecord
            .AnimData()
            .AnimSlot()
            .StartupSlide();
        }
      case EAIActionPhase.Loop:
    }
  }

  private final func GetSlideTarget(
    const context: ScriptExecutionContext,
    out slideTarget: wref<GameObject>,
    out slideTargetTrackingMode: gamedataTrackingMode
  ) -> Bool {
    slideTargetTrackingMode = gamedataTrackingMode.RealPosition;
    switch this.m_actionPhase {
      case EAIActionPhase.Startup:
        if !IsDefined(this
          .m_actionRecord
          .AnimData()
          .AnimSlot()
          .StartupSlide()) || !IsDefined(this
            .m_actionRecord
            .AnimData()
            .AnimSlot()
            .StartupSlide()
            .Target()) {
        } else {
          slideTargetTrackingMode = this
            .m_actionRecord
            .AnimData()
            .AnimSlot()
            .StartupSlide()
            .Target()
            .TrackingMode()
            .Type();
          return AIActionTarget
            .GetObject(
              context,
              this
                .m_actionRecord
                .AnimData()
                .AnimSlot()
                .StartupSlide()
                .Target(),
              slideTarget
            );
        }
      case EAIActionPhase.Loop:
    }
  }

  private final func ActivateLookat(const context: ScriptExecutionContext) {
    let lookAtEvent: LookAtAddEvent;
    let count = this.m_actionRecord.GetLookatsCount();
    let i = 0;
    while i < count {
      let record = this.m_actionRecord.GetLookatsItem(i);
      if !IsFinal() {
        let debugActionName = TDBID.ToStringDEBUG(record.Preset().GetID());
        if AIActionHelper
          .ActionDebugHelper("", ScriptExecutionContext.GetOwner(context), debugActionName) {
        } else if IsDefined(record.ActivationCondition())
          && !AICondition.CheckActionCondition(context, record.ActivationCondition()) {
        }
      }
      AIActionLookat.Activate(context, record, lookAtEvent);
      if IsDefined(lookAtEvent) {
        if Equals(lookAtEvent.bodyPart, n"RightHand") {
          AIBehaviorScriptBase
            .GetPuppet(context)
            .GetAIControllerComponent()
            .GetShootingBlackboard()
            .SetInt(GetAllBlackboardDefs().AIShooting.rightArmLookAtLimitReached, 1);
        }
        ArrayPush(this.m_lookatEvents, lookAtEvent);
      }
      i += 1;
    }
  }

  private final func DeactivateLookat(const context: ScriptExecutionContext) {
    if ArraySize(this.m_lookatEvents) == 0 {
      return;
    }
    AIActionLookat.Deactivate(ScriptExecutionContext.GetOwner(context), this.m_lookatEvents);
  }

  private final func TrackCommands(const context: ScriptExecutionContext, stop: Bool) {
    let commandNames: [CName];
    if IsDefined(this.m_actionRecord) {
      commandNames = this.m_actionRecord.Commands();
    } else if ArraySize(commandNames) == 0 {
      return;
    }
    let signalTable = AIBehaviorScriptBase
      .GetPuppet(context)
      .GetAIControllerComponent()
      .GetSignals();
    if !IsDefined(signalTable) {
      return;
    }
    let signal = new CommandSignal();
    signal.track = !stop;
    signal.commandClassNames = commandNames;
    let signalId = signalTable.GetOrCreateSignal(n"CommandSignal");
    signalTable.Set(signalId, false);
    signalTable.SetWithData(signalId, signal);
  }

  private final func WeaponOverride(const context: ScriptExecutionContext, const value: Int32) {
    let weaponOverride = new AnimFeature_WeaponOverride();
    weaponOverride.state = value;
    AnimationControllerComponent
      .ApplyFeatureToReplicate(
        ScriptExecutionContext.GetOwner(context),
        n"weaponOverride",
        weaponOverride
      );
  }

  private final func ChangeNPCState(context: ScriptExecutionContext) {
    let signalTable = AIBehaviorScriptBase
      .GetPuppet(context)
      .GetAIControllerComponent()
      .GetSignals();
    if !IsDefined(signalTable) {
      return;
    }
    let signal = new NPCStateChangeSignal();
    let signalId = signalTable.GetOrCreateSignal(n"NPCStateChangeSignal");
    if NotEquals(this.m_phaseRecord.ChangeNPCState().HighLevelState(), n"None") {
      signal.m_highLevelState = IntEnum<gamedataNPCHighLevelState>(
        Cast<Int32>(
          EnumValueFromName(
            n"gamedataNPCHighLevelState",
            this.m_phaseRecord.ChangeNPCState().HighLevelState()
          )
        )
      );
      signal.m_highLevelStateValid = true;
    } else if this.m_phaseDuration > 0.0 && this.m_phaseDuration <= 0.1 && !IsDefined(this.m_actionRecord.AnimData()) {
      return;
    }
    if NotEquals(this.m_phaseRecord.ChangeNPCState().UpperBodyState(), n"None") {
      signal.m_upperBodyState = IntEnum<gamedataNPCUpperBodyState>(
        Cast<Int32>(
          EnumValueFromName(
            n"gamedataNPCUpperBodyState",
            this.m_phaseRecord.ChangeNPCState().UpperBodyState()
          )
        )
      );
      signal.m_upperBodyStateValid = true;
    } else if NotEquals(this.m_phaseRecord.ChangeNPCState().StanceState(), n"None") {
      signal.m_stanceState = IntEnum<gamedataNPCStanceState>(
        Cast<Int32>(
          EnumValueFromName(
            n"gamedataNPCStanceState",
            this.m_phaseRecord.ChangeNPCState().StanceState()
          )
        )
      );
      signal.m_stanceStateValid = true;
    } else if NotEquals(this.m_phaseRecord.ChangeNPCState().HitReactionMode(), n"None") {
      signal.m_hitReactionModeState = IntEnum<EHitReactionMode>(
        Cast<Int32>(
          EnumValueFromName(n"EHitReactionMode", this.m_phaseRecord.ChangeNPCState().HitReactionMode())
        )
      );
      signal.m_hitReactionModeStateValid = true;
    } else if NotEquals(this.m_phaseRecord.ChangeNPCState().DefenseMode(), n"None") {
      signal.m_defenseMode = IntEnum<gamedataDefenseMode>(
        Cast<Int32>(
          EnumValueFromName(n"gamedataDefenseMode", this.m_phaseRecord.ChangeNPCState().DefenseMode())
        )
      );
      signal.m_defenseModeValid = true;
    } else if NotEquals(this.m_phaseRecord.ChangeNPCState().LocomotionMode(), n"None") {
      signal.m_locomotionMode = IntEnum<gamedataLocomotionMode>(
        Cast<Int32>(
          EnumValueFromName(
            n"gamedataLocomotionMode",
            this.m_phaseRecord.ChangeNPCState().LocomotionMode()
          )
        )
      );
      signal.m_locomotionModeValid = true;
    }
    signalTable.Set(signalId, false);
    signalTable.SetWithData(signalId, signal);
  }

  private final func ResetNPCState(context: ScriptExecutionContext) {
    if this.m_phaseDuration > 0.0 && this.m_phaseDuration <= 0.1 && !IsDefined(this.m_actionRecord.AnimData()) {
      return;
    }
    let signalTable = AIBehaviorScriptBase
      .GetPuppet(context)
      .GetAIControllerComponent()
      .GetSignals();
    if !IsDefined(signalTable) {
      return;
    }
    let signal = new NPCStateChangeSignal();
    let signalId = signalTable.GetOrCreateSignal(n"NPCStateChangeSignal");
    if NotEquals(this.m_phaseRecord.ChangeNPCState().UpperBodyState(), n"None") {
      signal.m_upperBodyState = gamedataNPCUpperBodyState.Normal;
      signal.m_upperBodyStateValid = true;
    } else if NotEquals(this.m_phaseRecord.ChangeNPCState().StanceState(), n"None") {
      signal.m_stanceState = gamedataNPCStanceState.Stand;
      signal.m_stanceStateValid = true;
    } else if NotEquals(this.m_phaseRecord.ChangeNPCState().HitReactionMode(), n"None") {
      signal.m_hitReactionModeState = EHitReactionMode.Regular;
      signal.m_hitReactionModeStateValid = true;
    } else if NotEquals(this.m_phaseRecord.ChangeNPCState().DefenseMode(), n"None") {
      signal.m_defenseMode = gamedataDefenseMode.NoDefend;
      signal.m_defenseModeValid = true;
    } else if NotEquals(this.m_phaseRecord.ChangeNPCState().LocomotionMode(), n"None") {
      signal.m_locomotionMode = gamedataLocomotionMode.Moving;
      signal.m_locomotionModeValid = true;
    }
    signalTable.Set(signalId, false);
    signalTable.SetWithData(signalId, signal);
  }

  private final func StartCooldowns(const context: ScriptExecutionContext) {
    let count = this.m_actionRecord.GetCooldownsCount();
    let i = 0;
    while i < count {
      let record = this.m_actionRecord.GetCooldownsItem(i);
      AIActionHelper.StartCooldown(ScriptExecutionContext.GetOwner(context), record);
      i += 1;
    }
  }

  public func GetDescription(context: ScriptExecutionContext) -> String {
    return this.m_actionDebugName;
  }

  private func GetActionRecord(
    const context: ScriptExecutionContext,
    actionDebugName: script_ref<String>,
    out actionRecord: wref<AIAction_Record>,
    out shouldCallAgain: Bool
  ) -> Bool {
    return false;
  }

  private func Debug_GetBaseActionId() -> TweakDBID {
    return t"NewPerks.Intelligence_Left_Milestone_2.preventInQueueAgain";
  }

  private func Debug_GetCompositeId() -> TweakDBID {
    return t"NewPerks.Intelligence_Left_Milestone_2.preventInQueueAgain";
  }
}

