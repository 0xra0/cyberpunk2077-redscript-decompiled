}

class EmptyHandsEvents extends UpperBodyEventsTransition {
  protected func OnEnter(stateContext: StateContext, scriptInterface: StateGameScriptInterface) {
    super.OnEnter(stateContext, scriptInterface);
    scriptInterface.ActivateCameraSetting(n"weapon");
    this
      .SetBlackboardIntVariable(scriptInterface, GetAllBlackboardDefs().PlayerStateMachine.UpperBody, 0);
    if !stateContext.IsStateActive(n"Vehicle", n"driverCombatMountedWeapons") {
      this
        .SetBlackboardIntVariable(scriptInterface, GetAllBlackboardDefs().PlayerStateMachine.Weapon, 0);
    }
    this.SetWeaponHolster(scriptInterface, true);
  }

  protected final func OnUpdate(
    timeDelta: Float,
    stateContext: StateContext,
    scriptInterface: StateGameScriptInterface
  ) {
    let switchWeapon = false;
    let displayWeapon = false;
    let displayDelay = 0.25;
    if this.IsInTakedownState(stateContext)
      || this.GetSceneTier(scriptInterface) > 2
      || this.CheckBodyCarryingConditions(stateContext, scriptInterface) {
      return;
    } else if !this.CheckGenericEquipItemConditions(stateContext, scriptInterface)
      || StatusEffectSystem
        .ObjectHasStatusEffectWithTag(scriptInterface.executionOwner, n"FirearmsNoUnequipNoSwitch")
      || StatusEffectSystem
        .ObjectHasStatusEffectWithTag(scriptInterface.executionOwner, n"ShootingRangeCompetition") {
      return;
    }
    this.ProcessCombatGadgetActionInputCaching(scriptInterface, stateContext);
    if scriptInterface.IsActionJustTapped(n"SwitchItem") {
      this.m_switchButtonPushed = true;
      this.m_counter += 1;
    } else if this.m_switchButtonPushed && !this.m_switchPending {
      this.m_delay += timeDelta;
      if this.m_delay >= displayDelay {
        switchWeapon = true;
        displayWeapon = this.m_counter > 1;
        this.ResetEquipVars(stateContext);
      }
      return;
    }
    displayWeapon = displayWeapon || scriptInterface.IsActionJustHeld(n"HolsterWeapon");
    if (switchWeapon
      || displayWeapon
      || this.CheckRangedAttackInput(scriptInterface)
      || scriptInterface.IsActionJustTapped(n"HolsterWeapon")
      || this.CheckSwitchInput(stateContext, scriptInterface))
      && !stateContext.IsStateMachineActive(n"CombatGadget")
      && !stateContext.IsStateMachineActive(n"Consumable")
      && !stateContext.IsStateMachineActive(n"LeftHandCyberware")
      && (!this.IsCarryingBody(scriptInterface)
        || this.IsCarryingBody(scriptInterface)
          && !StatusEffectSystem
            .ObjectHasStatusEffectWithTag(scriptInterface.executionOwner, n"NoCombat")) {
      if StatusEffectSystem
        .ObjectHasStatusEffectWithTag(scriptInterface.executionOwner, n"NoWeapons") {
        this.QueueActionBlocked(scriptInterface);
        return;
      }
      if StatusEffectSystem
        .ObjectHasStatusEffectWithTag(scriptInterface.executionOwner, n"OneHandedFirearms") {
        let requestType = EquipmentManipulationAction.RequestLastUsedOrFirstAvailableOneHandedRangedWeapon;
      } else if StatusEffectSystem
        .ObjectHasStatusEffectWithTag(scriptInterface.executionOwner, n"DriverCombatFirearms") {
        requestType = EquipmentManipulationAction.RequestLastUsedOrFirstAvailableDriverCombatRangedWeapon;
      } else if StatusEffectSystem
        .ObjectHasStatusEffectWithTag(scriptInterface.executionOwner, n"DriverCombatBikeWeapons") {
        requestType = EquipmentManipulationAction.RequestLastUsedOrFirstAvailableDriverCombatBikeWeapon;
      } else if StatusEffectSystem.ObjectHasStatusEffectWithTag(scriptInterface.executionOwner, n"Melee") {
        requestType = EquipmentManipulationAction.RequestLastUsedOrFirstAvailableMeleeWeapon;
      } else if StatusEffectSystem.ObjectHasStatusEffectWithTag(scriptInterface.executionOwner, n"Fists") {
        requestType = EquipmentManipulationAction.RequestFists;
      } else if StatusEffectSystem
        .ObjectHasStatusEffectWithTag(scriptInterface.executionOwner, n"Firearms") {
        requestType = EquipmentManipulationAction.RequestLastUsedOrFirstAvailableRangedWeapon;
      } else {
        requestType = EquipmentManipulationAction.RequestLastUsedOrFirstAvailableWeapon;
      }
      if displayWeapon {
        this
          .SendEquipmentSystemWeaponManipulationRequest(scriptInterface, requestType, gameEquipAnimationType.FirstEquip);
      } else {
        this
          .SendEquipmentSystemWeaponManipulationRequest(scriptInterface, requestType);
      }
    } else if !stateContext.IsStateMachineActive(n"CombatGadget")
      && !this.IsCarryingBody(scriptInterface)
      && this.ProcessWeaponSlotInput(scriptInterface) {
      return;
    }
    if scriptInterface.IsActionJustReleased(n"UseConsumable") {
      let dpadAction = new DPADActionPerformed();
      dpadAction.action = EHotkey.DPAD_UP;
      dpadAction.state = EUIActionState.COMPLETED;
      if !stateContext.IsStateMachineActive(n"Consumable")
        && !stateContext.IsStateMachineActive(n"CombatGadget")
        && !stateContext.IsStateMachineActive(n"LeftHandCyberware")
        && this.CheckActiveConsumable(scriptInterface)
        && !this.IsInUpperBodyState(stateContext, n"temporaryUnequip")
        && !this.IsInUpperBodyState(stateContext, n"forceEmptyHands")
        && !this.AreChoiceHubsActive(scriptInterface)
        && this.CheckConsumableLootDataCondition(scriptInterface)
        && !this.IsInFocusMode(scriptInterface)
        && !this.IsCarryingBody(scriptInterface)
        && !this.IsUsingConsumableRestricted(scriptInterface) {
        dpadAction.successful = true;
        scriptInterface.GetUISystem().QueueEvent(dpadAction);
        this
          .SendEquipmentSystemWeaponManipulationRequest(scriptInterface, EquipmentManipulationAction.RequestConsumable);
      } else {
        scriptInterface.GetUISystem().QueueEvent(dpadAction);
      }
    } else if scriptInterface.IsActionJustPressed(n"UseCombatGadget") || stateContext.GetBoolParameter(n"cgCached", true) {
      dpadAction = new DPADActionPerformed();
      dpadAction.action = EHotkey.RB;
      dpadAction.state = EUIActionState.COMPLETED;
      if this.IsUsingLeftHandAllowed(scriptInterface)
        && !stateContext.IsStateMachineActive(n"Consumable")
        && !stateContext.IsStateMachineActive(n"CombatGadget")
        && !this.IsInUpperBodyState(stateContext, n"forceEmptyHands")
        && !this.AreChoiceHubsActive(scriptInterface)
        && !this.IsInSafeZone(scriptInterface)
        && this.GetInStateTime() > 0.3
        && !this.IsCarryingBody(scriptInterface)
        && !DefaultTransition.IsInWorkspot(scriptInterface) {
        dpadAction.successful = true;
        scriptInterface.GetUISystem().QueueEvent(dpadAction);
        if this
          .CheckItemCategoryInQuickWheel(scriptInterface, gamedataItemCategory.Gadget) {
          if this.PlayerHasGrenadeCharges(scriptInterface) {
            this
              .SendEquipmentSystemWeaponManipulationRequest(scriptInterface, EquipmentManipulationAction.RequestGadget);
            return;
          }
          if !scriptInterface.IsActionHeld(n"UseCombatGadget") {
            let audioEvent = new SoundPlayEvent();
            audioEvent.soundName = n"ui_grenade_empty";
            scriptInterface.owner.QueueEvent(audioEvent);
          }
        } else if this
          .CheckItemCategoryInQuickWheel(scriptInterface, gamedataItemCategory.Cyberware) {
          audioEvent = new SoundPlayEvent();
          audioEvent.soundName = n"ui_grenade_empty";
          if this
            .IsQuickWheelItemACyberware(scriptInterface, gamedataItemType.Cyb_Ability) {
            let cwName = this.GetQuickWheelItemName(scriptInterface);
            if Equals(cwName, "OpticalCamo")
              && !GameInstance
                .GetStatPoolsSystem(scriptInterface.owner.GetGame())
                .HasStatPoolValueReachedMax(
                  Cast<StatsObjectID>(scriptInterface.executionOwner.GetEntityID()),
                  gamedataStatPoolType.OpticalCamoCharges
                ) {
              if !scriptInterface.IsActionHeld(n"UseCombatGadget") {
                scriptInterface.owner.QueueEvent(audioEvent);
              } else {
                return;
              }
            } else if this
              .IsQuickWheelItemACyberware(scriptInterface, gamedataItemType.Cyb_Launcher) {
              if !LeftHandCyberwareHelper.ProjectileLauncherHasCharge(scriptInterface) {
                if !scriptInterface.IsActionHeld(n"UseCombatGadget") {
                  scriptInterface.owner.QueueEvent(audioEvent);
                } else {
                  return;
                }
              } else {
                this
                  .SendEquipmentSystemWeaponManipulationRequest(scriptInterface, EquipmentManipulationAction.RequestGadget);
                stateContext.RemovePermanentBoolParameter(n"cgCached");
              }
            } else {
              scriptInterface.GetUISystem().QueueEvent(dpadAction);
            }
          } else {
            this.UpdateSwitchItem(timeDelta, stateContext, scriptInterface);
          }
        }
      }
    }
  }

  protected func OnExit(stateContext: StateContext, scriptInterface: StateGameScriptInterface) {
    super.OnExit(stateContext, scriptInterface);
  }

  protected const final func CheckBodyCarryingConditions(stateContext: StateContext, scriptInterface: StateGameScriptInterface) -> Bool {
    if scriptInterface.HasStatFlag(gamedataStatType.CanShootWhileCarryingBody) {
      return this
        .CompareLocalBlackboardInt(scriptInterface, GetAllBlackboardDefs().PlayerStateMachine.BodyCarrying, 1)
        || this
          .CompareLocalBlackboardInt(
            scriptInterface,
            GetAllBlackboardDefs().PlayerStateMachine.BodyCarrying,
            3
          )
        || this
          .CompareLocalBlackboardInt(
            scriptInterface,
            GetAllBlackboardDefs().PlayerStateMachine.BodyCarrying,
            4
          );
    }
    return this.IsCarryingBody(scriptInterface);
  }
}

