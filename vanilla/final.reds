}

class SecuritySystemInputTaskData extends ScriptTaskData {
  public let cachedEvt: SecuritySystemInput;
}

public func OperatorGreater(enum1: ESecurityNotificationType, enum2: ESecurityNotificationType) -> Bool {
  if EnumInt(enum1) > EnumInt(enum2) {
    return true;
  }
  return false;
}

class SecuritySystemInput extends SecurityAreaEvent {
  private let m_lastKnownPosition: Vector4;
  private let m_notifier: SharedGameplayPS;
  private let m_type: ESecurityNotificationType;
  private let m_objectOfInterest: wref<GameObject>;
  private let m_canPerformReprimand: Bool;
  private let m_shouldLeadReprimend: Bool;
  private let m_id: Int32;
  private let m_customRecipientsList: [EntityID];
  private let m_isSharingRestricted: Bool;
  private let m_debugReporterCharRecord: Character_Record;
  private let m_stimTypeTriggeredAlarm: gamedataStimType;

  public final func Initialize(initialEvent: SecuritySystemInput) {
    this
      .SetProperties(
        initialEvent.GetLastKnownPosition(),
        initialEvent.GetWhoBreached(),
        initialEvent.GetNotifierHandle(),
        initialEvent.GetNotificationType(),
        initialEvent.CanPerformReprimand(),
        initialEvent.ShouldLeadReprimend(),
        initialEvent.GetID(),
        initialEvent.GetCustomRecipientsList(),
        initialEvent.IsSharingRestricted()
      );
  }

  public final func SetProperties(
    lkp: Vector4,
    whoBreached: GameObject,
    reporter: wref<SharedGameplayPS>,
    type: ESecurityNotificationType,
    canDoReprimand: Bool,
    shouldLeadReprimand: Bool,
    opt stimType: gamedataStimType
  ) {
    this.m_lastKnownPosition = lkp;
    if Equals(type, ESecurityNotificationType.ALARM) || Equals(type, ESecurityNotificationType.DEVICE_DESTROYED) {
      this.m_objectOfInterest = whoBreached;
    } else {
      this.SetWhoBreached(whoBreached);
    }
    this.m_notifier = reporter;
    this.m_type = type;
    this.m_canPerformReprimand = canDoReprimand;
    this.m_shouldLeadReprimend = shouldLeadReprimand;
    this.m_stimTypeTriggeredAlarm = stimType;
  }

  public final func SetProperties(
    lkp: Vector4,
    whoBreached: GameObject,
    reporter: wref<SharedGameplayPS>,
    type: ESecurityNotificationType,
    canDoReprimand: Bool,
    shouldLeadReprimand: Bool,
    id: Int32,
    const customRecipients: script_ref<[EntityID]>,
    isSharingRestricted: Bool
  ) {
    this
      .SetProperties(lkp, whoBreached, reporter, type, canDoReprimand, shouldLeadReprimand);
    this.m_id = id;
    this.m_customRecipientsList = customRecipients;
    this.m_isSharingRestricted = isSharingRestricted;
  }

  public const final func GetNotifierHandle() -> wref<SharedGameplayPS> {
    return this.m_notifier;
  }

  public const final func GetNotificationType() -> ESecurityNotificationType {
    return this.m_type;
  }

  public const final func GetObjectOfInterest() -> GameObject {
    return this.m_objectOfInterest;
  }

  public const final func CanPerformReprimand() -> Bool {
    return this.m_canPerformReprimand;
  }

  public const final func ShouldLeadReprimend() -> Bool {
    return this.m_shouldLeadReprimend;
  }

  public const final func GetLastKnownPosition() -> Vector4 {
    return this.m_lastKnownPosition;
  }

  public const final func GetID() -> Int32 {
    return this.m_id;
  }

  public const final func HasCustomRecipients() -> Bool {
    return ArraySize(this.m_customRecipientsList) > 0;
  }

  public const final func GetCustomRecipientsList() -> [EntityID] {
    return this.m_customRecipientsList;
  }

  public const final func IsSharingRestricted() -> Bool {
    return this.m_isSharingRestricted;
  }

  public const final func GetStimTypeTriggeredAlarm() -> gamedataStimType {
    return this.m_stimTypeTriggeredAlarm;
  }

  public const final func GetPuppetCharRecord() -> Character_Record {
    return this.m_debugReporterCharRecord;
  }

  public const final func GetPuppetDisplayName() -> String {
    return LocKeyToString(this.m_debugReporterCharRecord.DisplayName());
  }

  public final func SetAsReprimendLeader(isLeader: Bool) {
    this.m_shouldLeadReprimend = isLeader;
  }

  public final func SetID(id: Int32) {
    this.m_id = id;
  }

  public final func AttachCustomRecipientsList(const list: script_ref<[EntityID]>) {
    this.m_customRecipientsList = list;
  }

  public final func ModifyNotificationType(newEventType: ESecurityNotificationType) {
    this.m_type = newEventType;
  }

  public final func RestrictSharing() {
    this.m_isSharingRestricted = true;
  }

  public final func SetLastKnownPosition(lkp: Vector4) {
    this.m_lastKnownPosition = lkp;
  }

  public final func SetObjectOfInterest(object: wref<GameObject>) {
    this.m_objectOfInterest = object;
  }

  public final func SetPuppetCharacterRecord(record: TweakDBID) {
    this.m_debugReporterCharRecord = TweakDBInterface.GetCharacterRecord(record);
  }
}

class TargetAssessmentRequest extends ScriptableDeviceAction {
  public let targetToAssess: wref<GameObject>;
}

class AgentRegistry extends IScriptable {
  protected persistent let m_isInitialized: Bool;
  protected persistent let m_agents: [Agent];
  public let m_agentsLock: RWLock;
  public let m_maxReprimandsPerNPC: Int32;
  public let m_maxReprimandsPerDEVICE: Int32;

  public final static func Construct() -> AgentRegistry {
    let registry = new AgentRegistry();
    registry.m_isInitialized = true;
    return registry;
  }

  private const final func IsInitialized() -> Bool {
    return this.m_isInitialized;
  }

  public const final func IsReady() -> Bool {
    if !this.IsInitialized() {
      return false;
    }
    RWLock.AcquireShared(this.m_agentsLock);
    let i = 0;
    while i < ArraySize(this.m_agents) {
      if !Agent.IsValid(this.m_agents[i]) {
        RWLock.ReleaseShared(this.m_agentsLock);
        return false;
      }
      i += 1;
    }
    RWLock.ReleaseShared(this.m_agentsLock);
    return true;
  }

  public final func RegisterAgent(agentPS: DeviceLink, const areas: script_ref<[SecurityAreaControllerPS]>) {
    let index: Int32;
    RWLock.Acquire(this.m_agentsLock);
    if !this.GetAgentIndex_NoLock(DeviceLink.GetLinkID(agentPS), index) {
      let agent = Agent.Construct(agentPS, areas);
      this.SaveAgent_NoLock(agent);
    }
    RWLock.Release(this.m_agentsLock);
  }

  public final func UnregisterAgent(agentID: PersistentID) {
    let index: Int32;
    RWLock.Acquire(this.m_agentsLock);
    if this.GetAgentIndex_NoLock(agentID, index) {
      ArrayErase(this.m_agents, index);
    }
    RWLock.Release(this.m_agentsLock);
  }

  public const final func IsAgent(id: PersistentID) -> Bool {
    let ix: Int32;
    return this.GetAgentIndex(id, ix);
  }

  public const final func GetAgent(id: PersistentID, recordCopy: script_ref<Agent>) -> Bool {
    let index: Int32;
    let found = false;
    RWLock.AcquireShared(this.m_agentsLock);
    if this.GetAgentIndex_NoLock(id, index) {
      recordCopy = this.m_agents[index];
      found = true;
    }
    RWLock.ReleaseShared(this.m_agentsLock);
    return found;
  }

  public const final func GetAgentsIDs() -> [PersistentID] {
    let ids: [PersistentID];
    RWLock.AcquireShared(this.m_agentsLock);
    let i = 0;
    while i < ArraySize(this.m_agents) {
      ArrayPush(ids, DeviceLink.GetLinkID(this.m_agents[i].link));
      i += 1;
    }
    RWLock.ReleaseShared(this.m_agentsLock);
    return ids;
  }

  public const final func GetAgents() -> [Agent] {
    let data: [Agent];
    RWLock.AcquireShared(this.m_agentsLock);
    let i = 0;
    while i < ArraySize(this.m_agents) {
      ArrayPush(data, this.m_agents[i]);
      i += 1;
    }
    RWLock.ReleaseShared(this.m_agentsLock);
    return data;
  }

  public const final func GetAgents(const filter: script_ref<[SecurityAreaControllerPS]>) -> [Agent] {
    let agents: [Agent];
    RWLock.AcquireShared(this.m_agentsLock);
    let i = 0;
    while i < ArraySize(this.m_agents) {
      let k = 0;
      while k < ArraySize(this.m_agents[i].areas) {
        let y = 0;
        while y < ArraySize(filter) {
          if Equals(DeviceLink.GetLinkID(this.m_agents[i].areas[k]), filter[y].GetID()) {
            ArrayPush(agents, this.m_agents[i]);
          }
          y += 1;
        }
        k += 1;
      }
      i += 1;
    }
    RWLock.ReleaseShared(this.m_agentsLock);
    return agents;
  }

  public const final func GetAgentsIDs(const filter: script_ref<[SecurityAreaControllerPS]>) -> [PersistentID] {
    let agentIDs: [PersistentID];
    RWLock.AcquireShared(this.m_agentsLock);
    let i = 0;
    while i < ArraySize(this.m_agents) {
      let k = 0;
      while k < ArraySize(this.m_agents[i].areas) {
        let y = 0;
        while y < ArraySize(filter) {
          if Equals(DeviceLink.GetLinkID(this.m_agents[i].areas[k]), filter[y].GetID()) {
            ArrayPush(agentIDs, DeviceLink.GetLinkID(this.m_agents[i].link));
          }
          y += 1;
        }
        k += 1;
      }
      i += 1;
    }
    RWLock.ReleaseShared(this.m_agentsLock);
    return agentIDs;
  }

  public final func AddArea(area: SecurityAreaControllerPS, const agents: script_ref<[DeviceComponentPS]>) {
    let index: Int32;
    RWLock.Acquire(this.m_agentsLock);
    let i = 0;
    while i < ArraySize(agents) {
      if this.GetAgentIndex_NoLock(agents[i].GetID(), index) {
        Agent.AddArea(this.m_agents[index], area);
      }
      i += 1;
    }
    RWLock.Release(this.m_agentsLock);
  }

  public final func RemoveArea(const data: script_ref<[OnDisableAreaData]>) {
    let index: Int32;
    RWLock.Acquire(this.m_agentsLock);
    let i = 0;
    while i < ArraySize(data) {
      if this.GetAgentIndex_NoLock(data[i].agent, index) {
        Agent.RemoveArea(this.m_agents[index], data[i].remainingAreas);
      }
      i += 1;
    }
    RWLock.Release(this.m_agentsLock);
  }

  public const final func GetTurrets() -> [Agent] {
    let matchingAgents: [Agent];
    RWLock.AcquireShared(this.m_agentsLock);
    let i = 0;
    while i < ArraySize(this.m_agents) {
      let agentClassName = DeviceLink.GetLinkClassName(this.m_agents[i].link);
      if Equals(agentClassName, n"SecurityTurretControllerPS") {
        ArrayPush(matchingAgents, this.m_agents[i]);
      }
      i += 1;
    }
    RWLock.ReleaseShared(this.m_agentsLock);
    return matchingAgents;
  }

  public const final func GetSensors() -> [Agent] {
    let matchingAgents: [Agent];
    RWLock.AcquireShared(this.m_agentsLock);
    let i = 0;
    while i < ArraySize(this.m_agents) {
      let agentClassName = DeviceLink.GetLinkClassName(this.m_agents[i].link);
      if Equals(agentClassName, n"SurveillanceCameraControllerPS") || Equals(agentClassName, n"SecurityTurretControllerPS") {
        ArrayPush(matchingAgents, this.m_agents[i]);
      }
      i += 1;
    }
    RWLock.ReleaseShared(this.m_agentsLock);
    return matchingAgents;
  }

  public const final func HowManyTimesEntityReprimandedByThisAgentAlready(target: EntityID, agentID: PersistentID) -> Int32 {
    let index: Int32;
    let result = 0;
    RWLock.AcquireShared(this.m_agentsLock);
    if this.GetAgentIndex_NoLock(agentID, index) {
      result = Agent.GetReprimandsCount(this.m_agents[index], target);
    }
    RWLock.ReleaseShared(this.m_agentsLock);
    return result;
  }

  public const final func HowManyTimesEntityReprimandedByThisAgentAlready(tresspasser: GameObject, agent: PersistentID) -> Int32 {
    if IsDefined(tresspasser) {
      return this
        .HowManyTimesEntityReprimandedByThisAgentAlready(tresspasser.GetEntityID(), agent);
    }
    return 0;
  }

  public const final func HasEntityBeenSpottedTooManyTimes(agent: PersistentID, target: EntityID) -> Bool {
    let index: Int32;
    let isTooManyTimes = false;
    RWLock.AcquireShared(this.m_agentsLock);
    if this.GetAgentIndex_NoLock(agent, index) {
      if Equals(
        DeviceLink.GetLinkClassName(this.m_agents[index].link),
        n"PuppetDeviceLinkPS"
      ) {
        let maxCount = this.m_maxReprimandsPerNPC;
      } else {
        maxCount = this.m_maxReprimandsPerDEVICE;
      }
      let count = Agent.GetReprimandsCount(this.m_agents[index], target);
      isTooManyTimes = count > maxCount;
    }
    RWLock.ReleaseShared(this.m_agentsLock);
    return isTooManyTimes;
  }

  public final func StoreReprimand(
    agentID: PersistentID,
    target: EntityID,
    reprimandID: Int32,
    targetAttitude: CName
  ) {
    let reprimandData: ReprimandData;
    let index: Int32;
    reprimandData.isActive = true;
    reprimandData.receiver = target;
    reprimandData.reprimandID = reprimandID;
    reprimandData.receiverAttitudeGroup = targetAttitude;
    RWLock.Acquire(this.m_agentsLock);
    if this.GetAgentIndex_NoLock(agentID, index) {
      Agent.StoreReprimand(this.m_agents[index], reprimandData);
    }
    RWLock.Release(this.m_agentsLock);
  }

  public final func WipeReprimandData(target: EntityID) {
    RWLock.Acquire(this.m_agentsLock);
    let i = 0;
    while i < ArraySize(this.m_agents) {
      Agent.WipeReprimand(this.m_agents[i], target);
      i += 1;
    }
    RWLock.Release(this.m_agentsLock);
  }

  public const final func IsReprimandOngoing() -> Bool {
    RWLock.AcquireShared(this.m_agentsLock);
    let i = 0;
    while i < ArraySize(this.m_agents) {
      if Agent.IsPerformingReprimand(this.m_agents[i]) {
        RWLock.ReleaseShared(this.m_agentsLock);
        return true;
      }
      i += 1;
    }
    RWLock.ReleaseShared(this.m_agentsLock);
    return false;
  }

  public const final func GetReprimandReceiver(agentID: PersistentID) -> EntityID {
    let index: Int32;
    let receiver: EntityID;
    RWLock.AcquireShared(this.m_agentsLock);
    if this.GetAgentIndex_NoLock(agentID, index) {
      receiver = Agent.GetReprimandReceiver(this.m_agents[index]);
    }
    RWLock.ReleaseShared(this.m_agentsLock);
    return receiver;
  }

  public const final func IsReprimandOngoingAgainst(suspect: EntityID) -> Bool {
    RWLock.AcquireShared(this.m_agentsLock);
    let i = 0;
    while i < ArraySize(this.m_agents) {
      if Agent.IsPerformingReprimandAgainst(this.m_agents[i], suspect) {
        RWLock.ReleaseShared(this.m_agentsLock);
        return true;
      }
      i += 1;
    }
    RWLock.ReleaseShared(this.m_agentsLock);
    return false;
  }

  public const final func GetReprimandPerformer(target: EntityID, agent: script_ref<Agent>) -> Bool {
    RWLock.AcquireShared(this.m_agentsLock);
    let i = 0;
    while i < ArraySize(this.m_agents) {
      if Agent.IsPerformingReprimandAgainst(this.m_agents[i], target) {
        agent = this.m_agents[i];
        RWLock.ReleaseShared(this.m_agentsLock);
        return true;
      }
      i += 1;
    }
    RWLock.ReleaseShared(this.m_agentsLock);
    return false;
  }

  public final func ReleaseFromReprimandAgainst(target: EntityID, opt agent: PersistentID) {
    let index: Int32;
    if PersistentID.IsDefined(agent) {
      RWLock.Acquire(this.m_agentsLock);
      if this.GetAgentIndex_NoLock(agent, index) {
        Agent.ReleaseFromReprimand(this.m_agents[index], target);
      }
      RWLock.Release(this.m_agentsLock);
      return;
    }
    RWLock.Acquire(this.m_agentsLock);
    let i = 0;
    while i < ArraySize(this.m_agents) {
      Agent.ReleaseFromReprimand(this.m_agents[i], target);
      i += 1;
    }
    RWLock.Release(this.m_agentsLock);
  }

  public final func ReleaseAllReprimands(agents: script_ref<[Agent]>) {
    RWLock.Acquire(this.m_agentsLock);
    let i = 0;
    while i < ArraySize(this.m_agents) {
      if Agent.IsPerformingReprimand(this.m_agents[i]) {
        ArrayPush(agents, this.m_agents[i]);
        Agent.ForceRelaseReprimands(this.m_agents[i]);
      }
      i += 1;
    }
    RWLock.Release(this.m_agentsLock);
  }

  public final func CleanUpOnNewAttitudeGroup(gameInstance: GameInstance, newGroup: CName) {
    let attSystem = GameInstance.GetAttitudeSystem(gameInstance);
    if !IsDefined(attSystem) {
      return;
    }
    RWLock.Acquire(this.m_agentsLock);
    let i = 0;
    while i < ArraySize(this.m_agents) {
      Agent.WipeReprimand(this.m_agents[i], newGroup, attSystem);
      i += 1;
    }
    RWLock.Release(this.m_agentsLock);
  }

  protected final func SaveAgent_NoLock(const agent: script_ref<Agent>) {
    if !Agent.IsValid(agent) {
      return;
    }
    ArrayPush(this.m_agents, agent);
  }

  protected const final func GetAgentIndex(id: PersistentID, out index: Int32) -> Bool {
    let found = false;
    RWLock.AcquireShared(this.m_agentsLock);
    found = this.GetAgentIndex_NoLock(id, index);
    RWLock.ReleaseShared(this.m_agentsLock);
    return found;
  }

  protected const final func GetAgentIndex_NoLock(id: PersistentID, out index: Int32) -> Bool {
    index = -1;
    let i = 0;
    while i < ArraySize(this.m_agents) {
      if PersistentID.ExtractEntityID(DeviceLink.GetLinkID(this.m_agents[i].link))
        == PersistentID.ExtractEntityID(id)
        || Equals(DeviceLink.GetLinkID(this.m_agents[i].link), id) {
        index = i;
        return true;
      }
      i += 1;
    }
    return false;
  }

  public const final func GetValidAgents(
    state: ESecuritySystemState,
    const breachedAreas: script_ref<[SecurityAreaControllerPS]>
  ) -> [SecuritySystemOutputData] {
    let outgoingFilterType: EFilterType;
    let validAgent: SecuritySystemOutputData;
    let validAgents: [SecuritySystemOutputData];
    let breachOrigin: EBreachOrigin;
    let i = 0;
    while i < ArraySize(breachedAreas) {
      if EnumInt(breachedAreas[i].GetOutgoingFilter()) > EnumInt(outgoingFilterType) {
        outgoingFilterType = breachedAreas[i].GetOutgoingFilter();
      }
      i += 1;
    }
    RWLock.AcquireShared(this.m_agentsLock);
    i = 0;
    while i < ArraySize(this.m_agents) {
      if Agent
        .IsEligible(this.m_agents[i], state, breachedAreas, outgoingFilterType, breachOrigin) {
        validAgent.link = this.m_agents[i].link;
        validAgent.delayDuration = this.m_agents[i].cachedDelayDuration;
        validAgent.breachOrigin = breachOrigin;
        ArrayPush(validAgents, validAgent);
      }
      i += 1;
    }
    RWLock.ReleaseShared(this.m_agentsLock);
    return validAgents;
  }

  public const final func GetAgentAreas(id: PersistentID) -> [DeviceLink] {
    let areas: [DeviceLink];
    let index: Int32;
    RWLock.AcquireShared(this.m_agentsLock);
    if this.GetAgentIndex_NoLock(id, index) {
      Agent.GetAreas(this.m_agents[index], areas);
    }
    RWLock.ReleaseShared(this.m_agentsLock);
    return areas;
  }

  public const final func GetSupportedAgents() -> [Agent] {
    let supportedAgents: [Agent];
    RWLock.AcquireShared(this.m_agentsLock);
    let i = 0;
    while i < ArraySize(this.m_agents) {
      if Agent.HasSupport(this.m_agents[i]) {
        ArrayPush(supportedAgents, this.m_agents[i]);
      }
      i += 1;
    }
    RWLock.ReleaseShared(this.m_agentsLock);
    return supportedAgents;
  }

  public final func ClearSupport() {
    RWLock.AcquireShared(this.m_agentsLock);
    let i = 0;
    while i < ArraySize(this.m_agents) {
      Agent.ClearSupport(this.m_agents[i]);
      i += 1;
    }
    RWLock.ReleaseShared(this.m_agentsLock);
  }

  public final func ProcessOnPlayerSpotted(evt: PlayerSpotted, modifiedAgents: script_ref<[Agent]>, out hasAnySupport: Bool) -> Bool {
    let i: Int32;
    let outgoingFilterType: EFilterType;
    let spottee = evt.GetOwnerID();
    let isNPC = evt.GetComesFromNPC();
    let isSpotted = evt.DoesSee();
    let agentAreas = evt.GetAgentAreas();
    hasAnySupport = false;
    if isSpotted {
      i = 0;
      if i < ArraySize(agentAreas) {
        if EnumInt(agentAreas[i].GetOutgoingFilter()) > EnumInt(outgoingFilterType) {
          outgoingFilterType = agentAreas[i].GetOutgoingFilter();
          if Equals(outgoingFilterType, EFilterType.ALLOW_ALL) {
          } else {
            i += 1;
          }
        } else {
          RWLock.Acquire(this.m_agentsLock);
          i = 0;
          while i < ArraySize(this.m_agents) {
            if isNPC
              && Equals(
                DeviceLink.GetLinkClassName(this.m_agents[i].link),
                n"PuppetDeviceLinkPS"
              )
              || Equals(spottee, DeviceLink.GetLinkID(this.m_agents[i].link)) {
            } else if Agent
              .IsEligibleToShareData(
                this.m_agents[i],
                ESecuritySystemState.COMBAT,
                agentAreas,
                outgoingFilterType
              ) {
              if Agent.AddSupport(this.m_agents[i], spottee, true) {
                ArrayPush(modifiedAgents, this.m_agents[i]);
              } else if !hasAnySupport && Agent.HasSupport(this.m_agents[i]) {
                hasAnySupport = true;
              }
            }
            i += 1;
          }
          RWLock.Release(this.m_agentsLock);
        }
      }
    }
    RWLock.Acquire(this.m_agentsLock);
    i = 0;
  }

  private const final func IsIndexOutOfBound(index: Int32) -> Bool {
    RWLock.AcquireShared(this.m_agentsLock);
    if index < 0 || index > ArraySize(this.m_agents) - 1 {
      RWLock.ReleaseShared(this.m_agentsLock);
      return true;
    }
    RWLock.ReleaseShared(this.m_agentsLock);
    return false;
  }
}

importonly native struct RWLock {
  public final native static func Acquire(self: script_ref<RWLock>);

  public final native static func Release(self: script_ref<RWLock>);

  public final native static func AcquireShared(self: script_ref<RWLock>);

  public final native static func ReleaseShared(self: script_ref<RWLock>);
}

struct Agent {
  public persistent let link: DeviceLink;
  public persistent let reprimands: [ReprimandData];
  public persistent let supportingAgents: [PersistentID];
  public persistent let areas: [DeviceLink];
  public persistent let incomingFilter: EFilterType;
  public persistent let cachedDelayDuration: Float;

  public final static func Construct(link: DeviceLink, const areas: script_ref<[SecurityAreaControllerPS]>) -> Agent {
    let agent: Agent;
    if !DeviceLink.IsValid(link) || ArraySize(areas) == 0 {
      return agent;
    }
    agent.link = link;
    Agent.SetIncomingFilter(agent, areas);
    if Equals(DeviceLink.GetLinkClassName(link), n"PuppetDeviceLinkPS") {
      agent.cachedDelayDuration = RandRangeF(0.1, 1.0);
    }
    let i = 0;
    while i < ArraySize(areas) {
      ArrayPush(agent.areas, DeviceLink.Construct(areas[i]));
      i += 1;
    }
    return agent;
  }

  public final static func AddArea(self: script_ref<Agent>, area: SecurityAreaControllerPS) {
    Agent.SetIncomingFilter(self, area);
    ArrayPush(self.areas, DeviceLink.Construct(area));
  }

  public final static func RemoveArea(
    self: script_ref<Agent>,
    const remainingAreas: script_ref<[SecurityAreaControllerPS]>
  ) {
    Agent.SetIncomingFilter(self, remainingAreas);
    ArrayClear(self.areas);
    let i = 0;
    while i < ArraySize(remainingAreas) {
      ArrayPush(self.areas, DeviceLink.Construct(remainingAreas[i]));
      i += 1;
    }
  }

  public final static func SetIncomingFilter(self: script_ref<Agent>, const areas: script_ref<[SecurityAreaControllerPS]>) {
    self.incomingFilter = EFilterType.ALLOW_ALL;
    let i = 0;
    while i < ArraySize(areas) {
      Agent.SetIncomingFilter(self, areas[i]);
      i += 1;
    }
  }

  public final static func SetIncomingFilter(self: script_ref<Agent>, area: SecurityAreaControllerPS) {
    if EnumInt(self.incomingFilter) < EnumInt(area.GetIncomingFilter()) {
      self.incomingFilter = area.GetIncomingFilter();
    }
  }

  public final static func IsValid(self: Agent) -> Bool {
    if DeviceLink.IsValid(self.link) && ArraySize(self.areas) != 0 {
      return true;
    }
    return false;
  }

  public final static func GetAreas(const self: script_ref<Agent>, areas: script_ref<[DeviceLink]>) {
    let i = 0;
    while i < ArraySize(self.areas) {
      ArrayPush(areas, self.areas[i]);
      i += 1;
    }
  }

  public final static func IsEligible(
    const self: script_ref<Agent>,
    state: ESecuritySystemState,
    const breachedAreas: script_ref<[SecurityAreaControllerPS]>,
    inputsOutgoingFilter: EFilterType,
    out breachOrigin: EBreachOrigin
  ) -> Bool {
    breachOrigin = EBreachOrigin.EXTERNAL;
    let i = 0;
    while i < ArraySize(breachedAreas) {
      let k = 0;
      while k < ArraySize(self.areas) {
        if breachedAreas[i] == self.areas[k] {
          breachOrigin = EBreachOrigin.LOCAL;
          return true;
        }
        k += 1;
      }
      i += 1;
    }
    if Equals(inputsOutgoingFilter, EFilterType.ALLOW_ALL) {
      if Equals(self.incomingFilter, EFilterType.ALLOW_ALL) {
        return true;
      } else if Equals(self.incomingFilter, EFilterType.ALLOW_COMBAT_ONLY) && Equals(state, ESecuritySystemState.COMBAT) {
        return true;
      }
      return false;
    } else if Equals(inputsOutgoingFilter, EFilterType.ALLOW_COMBAT_ONLY) {
      if Equals(self.incomingFilter, EFilterType.ALLOW_ALL) {
        return true;
      } else if Equals(self.incomingFilter, EFilterType.ALLOW_COMBAT_ONLY) && Equals(state, ESecuritySystemState.COMBAT) {
        return true;
      }
      return false;
    }
    return false;
  }

  public final static func IsEligibleToShareData(
    const self: script_ref<Agent>,
    state: ESecuritySystemState,
    const breachedAreas: script_ref<[SecurityAreaControllerPS]>,
    inputsOutgoingFilter: EFilterType
  ) -> Bool {
    if Equals(inputsOutgoingFilter, EFilterType.ALLOW_ALL) {
      if Equals(self.incomingFilter, EFilterType.ALLOW_ALL) {
        return true;
      } else if Equals(self.incomingFilter, EFilterType.ALLOW_COMBAT_ONLY) && Equals(state, ESecuritySystemState.COMBAT) {
        return true;
      } else if Equals(inputsOutgoingFilter, EFilterType.ALLOW_COMBAT_ONLY) {
        if Equals(self.incomingFilter, EFilterType.ALLOW_ALL) {
          return true;
        } else if Equals(self.incomingFilter, EFilterType.ALLOW_COMBAT_ONLY) && Equals(state, ESecuritySystemState.COMBAT) {
          return true;
        }
      }
    }
    let i = 0;
    while i < ArraySize(breachedAreas) {
      let k = 0;
      while k < ArraySize(self.areas) {
        if breachedAreas[i] == self.areas[k] {
          return true;
        }
        k += 1;
      }
      i += 1;
    }
    return false;
  }

  public final static func AddSupport(self: script_ref<Agent>, id: PersistentID, shouldAdd: Bool) -> Bool {
    let i: Int32;
    if shouldAdd {
      i = 0;
      while i < ArraySize(self.supportingAgents) {
        if Equals(self.supportingAgents[i], id) {
          return false;
        }
        i += 1;
      }
      ArrayPush(self.supportingAgents, id);
      if ArraySize(self.supportingAgents) == 1 {
        return true;
      }
      return false;
    }
    i = 0;
    while i < ArraySize(self.supportingAgents) {
      if Equals(self.supportingAgents[i], id) {
        ArrayErase(self.supportingAgents, i);
        if ArraySize(self.supportingAgents) == 0 {
          return true;
        }
        return false;
      }
      i += 1;
    }
    return false;
  }

  public final static func HasSupport(const self: script_ref<Agent>) -> Bool {
    return ArraySize(self.supportingAgents) > 0;
  }

  public final static func ClearSupport(self: script_ref<Agent>) {
    ArrayClear(self.supportingAgents);
  }

  public final static func IsPerformingReprimand(const self: script_ref<Agent>) -> Bool {
    let i = 0;
    while i < ArraySize(self.reprimands) {
      if self.reprimands[i].isActive {
        return true;
      }
      i += 1;
    }
    return false;
  }

  public final static func IsPerformingReprimandAgainst(const self: script_ref<Agent>, target: EntityID) -> Bool {
    let i = 0;
    while i < ArraySize(self.reprimands) {
      if self.reprimands[i].receiver == target && self.reprimands[i].isActive {
        return true;
      }
      i += 1;
    }
    return false;
  }

  public final static func GetReprimandReceiver(const self: script_ref<Agent>) -> EntityID {
    let i = 0;
    while i < ArraySize(self.reprimands) {
      if self.reprimands[i].isActive {
        return self.reprimands[i].receiver;
      }
      i += 1;
    }
    return EMPTY_ENTITY_ID();
  }

  public final static func GetReprimandsCount(const self: script_ref<Agent>, target: EntityID) -> Int32 {
    let i = 0;
    while i < ArraySize(self.reprimands) {
      if self.reprimands[i].receiver == target {
        return self.reprimands[i].count;
      }
      i += 1;
    }
    return 0;
  }

  public final static func ReleaseFromReprimand(self: script_ref<Agent>, target: EntityID) {
    let i = 0;
    while i < ArraySize(self.reprimands) {
      if self.reprimands[i].receiver == target {
        self.reprimands[i].isActive = false;
      }
      i += 1;
    }
  }

  public final static func ForceRelaseReprimands(self: script_ref<Agent>) {
    let i = 0;
    while i < ArraySize(self.reprimands) {
      self.reprimands[i].isActive = false;
      i += 1;
    }
  }

  public final static func StoreReprimand(self: script_ref<Agent>, reprimandData: ReprimandData) {
    let i = 0;
    while i < ArraySize(self.reprimands) {
      if self.reprimands[i].receiver
        == reprimandData.receiver
        && self.reprimands[i].reprimandID != reprimandData.reprimandID {
        self.reprimands[i].count += 1;
        self.reprimands[i].reprimandID = reprimandData.reprimandID;
        self.reprimands[i].isActive = true;
        return;
      }
      i += 1;
    }
    reprimandData.count = 1;
    ArrayPush(self.reprimands, reprimandData);
    return;
  }

  public final static func WipeReprimand(self: script_ref<Agent>, target: EntityID) {
    let i = 0;
    while i < ArraySize(self.reprimands) {
      if self.reprimands[i].receiver == target {
        ArrayErase(self.reprimands, i);
        return;
      }
      i += 1;
    }
  }

  public final static func WipeReprimand(self: script_ref<Agent>, attGroup: CName, attSystem: AttitudeSystem) {
    let i = ArraySize(self.reprimands) - 1;
    while i >= 0 {
      if Equals(
        attSystem
          .GetAttitudeRelation(attGroup, self.reprimands[i].receiverAttitudeGroup),
        EAIAttitude.AIA_Friendly
      ) {
        ArrayErase(self.reprimands, i);
      }
      i -= 1;
    }
  }
}

class SecurityAreaControllerPS extends MasterControllerPS {
  private let m_system: SecuritySystemControllerPS;
  private persistent let m_usersInPerimeter: [AreaEntry];
  private persistent let m_isPlayerInside: Bool;
  private let m_securityAccessLevel: ESecurityAccessLevel;
  private persistent let m_securityAreaType: ESecurityAreaType;
  private let m_eventsFilters: EventsFilters;
  private const persistent let m_areaTransitions: [AreaTypeTransition];
  private persistent let m_runtimeTransitions: [AreaTypeTransition];
  private persistent let m_pendingDisableRequest: Bool;
  private persistent let m_lastOutput: OutputPersistentData;
  private let m_questPlayerHasTriggeredCombat: Bool;
  private let m_hasThisAreaReceivedCombatNotification: Bool;
  private let m_pendingNotifyPlayerAboutTransition: Bool;

  protected func Initialize() {
    super.Initialize();
  }

  protected cb func OnInstantiated() -> Bool {
    super.OnInstantiated();
  }

  protected func GameAttached() {
    this.CopyAreaTransitions();
    this.RegisterTimeSystemListeners(this.GetOwnerEntityWeak());
    if this.AreThereAnyValidTransitions() {
      this.ResolveSecurityAreaType();
    }
    this.UpdateMiniMapRepresentation();
  }

  private final func CopyAreaTransitions() {
    let transitionsToCopy: [AreaTypeTransition];
    if ArraySize(this.m_areaTransitions) > 0 {
      let i = 0;
      while i < ArraySize(this.m_areaTransitions) {
        let alreadyCopied = false;
        let k = 0;
        if k < ArraySize(this.m_runtimeTransitions) {
          if this.m_areaTransitions[i].transitionHour == this.m_runtimeTransitions[k].transitionHour {
            alreadyCopied = true;
          } else {
            k += 1;
          }
        } else if alreadyCopied {
        }
        ArrayPush(transitionsToCopy, this.m_areaTransitions[i]);
        i += 1;
      }
      i = 0;
      while i < ArraySize(transitionsToCopy) {
        ArrayPush(this.m_runtimeTransitions, transitionsToCopy[i]);
        i += 1;
      }
    }
  }

  public const final func HasPlayerBeenSpottedAndTriggeredCombat() -> Bool {
    return this.m_questPlayerHasTriggeredCombat;
  }

  public const final func HasThisAreaReceivedCombatNotification() -> Bool {
    return this.m_hasThisAreaReceivedCombatNotification;
  }

  public const final func GetIncomingFilter() -> EFilterType {
    return this.m_eventsFilters.incomingEventsFilter;
  }

  public const final func GetOutgoingFilter() -> EFilterType {
    return this.m_eventsFilters.outgoingEventsFilter;
  }

  public final func RegisterTimeSystemListeners(entity: Entity) {
    this.UnregisterTimeSystemListeners();
    let i = 0;
    while i < ArraySize(this.m_runtimeTransitions) {
      let transitionEvent = new Transition();
      let hour = GameTime.MakeGameTime(0, this.m_runtimeTransitions[i].transitionHour, 0, 0);
      this.m_runtimeTransitions[i].listenerID = GameInstance
        .GetTimeSystem(this.GetGameInstance())
        .RegisterListener(entity, transitionEvent, hour, -1, true);
      transitionEvent.listenerID = this.m_runtimeTransitions[i].listenerID;
      i += 1;
    }
  }

  public final func UnregisterTimeSystemListeners() {
    let i = 0;
    while i < ArraySize(this.m_runtimeTransitions) {
      GameInstance
        .GetTimeSystem(this.GetGameInstance())
        .UnregisterListener(this.m_runtimeTransitions[i].listenerID);
      this.m_runtimeTransitions[i].listenerID = 0u;
      i += 1;
    }
  }

  private final func ResolveSecurityAreaType() {
    let cachedTransitionHour = 25;
    let hourOfTheDay = GameTime.Hours(GameInstance.GetGameTime(this.GetGameInstance()));
    let mostRelevantTransition = 0u;
    let i = 0;
    while i < ArraySize(this.m_runtimeTransitions) {
      if this.m_runtimeTransitions[i].transitionHour < hourOfTheDay {
        if cachedTransitionHour > this.m_runtimeTransitions[i].transitionHour {
          cachedTransitionHour = this.m_runtimeTransitions[i].transitionHour;
          mostRelevantTransition = this.m_runtimeTransitions[i].listenerID;
        }
      }
      i += 1;
    }
    if mostRelevantTransition == 0u {
      return;
    }
    this.ApplyTransition(mostRelevantTransition);
  }

  public final func ApplyTransition(listenerIndex: Uint32) -> Bool {
    let i = 0;
    while i < ArraySize(this.m_runtimeTransitions) {
      if this.m_runtimeTransitions[i].listenerID == listenerIndex {
        return this.ApplyTransition(this.m_runtimeTransitions[i], true);
      }
      i += 1;
    }
    return false;
  }

  private final func ApplyTransition(transition: AreaTypeTransition, isScheduled: Bool) -> Bool {
    let turrets: [SecurityTurretControllerPS];
    if Equals(this.m_securityAreaType, transition.transitionTo) || transition.locked {
      return false;
    } else if Equals(transition.transitionTo, ESecurityAreaType.DISABLED) {
      if !this.IsDisableAllowed(turrets) {
        this.PostponeAreaDisabling(turrets);
        return false;
      }
    } else if this.m_pendingDisableRequest {
      this.GetTurrets(turrets);
      let i = 0;
      if i < ArraySize(turrets) {
        let evt = new PendingSecuritySystemDisable();
        evt.isPending = false;
        this.QueuePSEvent(turrets[i], evt);
        i += 1;
      }
      this.m_pendingDisableRequest = false;
    } else if Equals(transition.transitionMode, ETransitionMode.FORCED) {
      this.SetSecurityAreaType(transition.transitionTo);
      if this.IsPlayerInside() {
        let secSys = this.GetSecuritySystem();
        if !secSys.IsSystemInCombat() && !secSys.IsHidden() {
          this
            .NotifySystemAboutCrossingPerimeter(this.GetLocalPlayerControlledGameObject(), true);
        }
        this.m_pendingNotifyPlayerAboutTransition = true;
      }
      return true;
    }
    break;
    if this.GetSecuritySystem().IsSystemSafe() {
      this.SetSecurityAreaType(transition.transitionTo);
      if this.IsPlayerInside() {
        this
          .NotifySystemAboutCrossingPerimeter(this.GetLocalPlayerControlledGameObject(), true);
      }
      return true;
    }
    return false;
  }

  private final func PostponeAreaDisabling(const turrets: script_ref<[SecurityTurretControllerPS]>) {
    let i = 0;
    while i < ArraySize(turrets) {
      let evt = new PendingSecuritySystemDisable();
      evt.isPending = true;
      this.QueuePSEvent(turrets[i], evt);
      i += 1;
    }
    this.m_pendingDisableRequest = true;
  }

  private final func OnSecurityTurretOffline(evt: SecurityTurretOffline) -> EntityNotificationType {
    let turrets: [SecurityTurretControllerPS];
    let transition: AreaTypeTransition;
    if this.m_pendingDisableRequest {
      if this.IsDisableAllowed(turrets) {
        this.m_pendingDisableRequest = false;
        transition.transitionTo = ESecurityAreaType.DISABLED;
        transition.transitionMode = ETransitionMode.FORCED;
        this.ApplyTransition(transition, false);
      } else {
        this.PostponeAreaDisabling(turrets);
      }
    }
    return EntityNotificationType.DoNotNotifyEntity;
  }

  private const final func GetTurrets(turrets: script_ref<[SecurityTurretControllerPS]>) {
    let slaves = this.GetImmediateSlaves();
    let i = 0;
    while i < ArraySize(slaves) {
      let turret = slaves[i] as SecurityTurretControllerPS;
      if IsDefined(turret) {
        ArrayPush(turrets, turret);
      }
      i += 1;
    }
    if ArraySize(turrets) == 0 {
      this.GetSecuritySystem().GetTurrets(this, turrets);
    }
  }

  private const final func IsDisableAllowed(turrets: script_ref<[SecurityTurretControllerPS]>) -> Bool {
    let isAllowed = true;
    this.GetTurrets(turrets);
    let i = 0;
    while i < ArraySize(turrets) {
      if turrets[i].IsTurretOperationalUnderSecuritySystem() {
        isAllowed = false;
      }
      i += 1;
    }
    return isAllowed;
  }

  private final func UpdateMiniMapRepresentation() {
    let secSys = this.GetSecuritySystem();
    if IsDefined(secSys) && secSys.IsHidden() {
      GameInstance
        .GetMappinSystem(this.GetGameInstance())
        .OnAreaTypeChanged(
          PersistentID.ExtractEntityID(this.GetID()),
          SecurityAreaControllerPS.SecurityAreaTypeEnumToName(ESecurityAreaType.DISABLED)
        );
      return;
    } else if !this.AreThereAnyValidTransitions() {
      GameInstance
        .GetMappinSystem(this.GetGameInstance())
        .OnAreaTypeChanged(
          PersistentID.ExtractEntityID(this.GetID()),
          SecurityAreaControllerPS.SecurityAreaTypeEnumToName(this.m_securityAreaType)
        );
    }
  }

  public const final func AreThereAnyValidTransitions() -> Bool {
    let i = 0;
    while i < ArraySize(this.m_runtimeTransitions) {
      if !this.m_runtimeTransitions[i].locked {
        return true;
      }
      i += 1;
    }
    return false;
  }

  public const func GetDeviceName() -> String {
    if IsStringValid(this.m_deviceName) {
      return this.m_deviceName;
    }
    return "";
  }

  public final func AreaEntered(evt: AreaEnteredEvent) {
    let obj = EntityGameInterface.GetEntity(evt.activator) as GameObject;
    if !this.IsActive() || !EntityID.IsDefined(obj.GetEntityID()) {
      return;
    }
    this.ProcessOnEnterRequest(obj);
  }

  public final func AreaExited(obj: GameObject) {
    if !EntityID.IsDefined(obj.GetEntityID()) {
      return;
    }
    let userIndex = this.FindEntryIndex(obj.GetEntityID());
    if userIndex == -1 && !this.IsActive() {
      return;
    }
    ArrayErase(this.m_usersInPerimeter, userIndex);
    if obj.IsPlayerControlled() {
      this.m_isPlayerInside = false;
      this.m_system = null;
    }
    this.NotifySystemAboutCrossingPerimeter(obj, false);
  }

  private final func ProcessOnEnterRequest(objectToProcess: GameObject) {
    let newEntry: AreaEntry;
    if !IsDefined(objectToProcess) {
      return;
    }
    newEntry.user = objectToProcess.GetEntityID();
    if this.IsUserInside(newEntry.user) {
    } else {
      this.PushUniqueEntry(newEntry);
    }
    if objectToProcess.IsPlayerControlled() {
      this.m_isPlayerInside = true;
      if NotEquals(this.m_securityAreaType, ESecurityAreaType.DISABLED) {
        this.m_system = this.GetSecuritySystem();
      } else if NotEquals(this.m_securityAreaType, ESecurityAreaType.DISABLED) {
        this.NotifySystemAboutCrossingPerimeter(objectToProcess, true);
      }
    }
  }

  private final func ActionSecurityAreaCrossingPerimeter(whoEntered: GameObject, entered: Bool) -> SecurityAreaCrossingPerimeter {
    let action = new SecurityAreaCrossingPerimeter();
    action.SetUp(this);
    action.SetProperties(whoEntered, entered);
    action.AddDeviceName(this.GetDeviceName());
    action.SetAreaData(this.GetSecurityAreaData());
    return action;
  }

  private final func NotifySystemAboutCrossingPerimeter(tresspasser: GameObject, entering: Bool) {
    if entering {
      if !IsFinal() {
      }
    } else if !IsFinal() {
    }
    if !entering && tresspasser.IsPlayerControlled() {
      this.m_pendingNotifyPlayerAboutTransition = false;
    } else if this
      .GetSecuritySystem()
      .IsUserAuthorized(tresspasser.GetEntityID(), this.GetSecurityAccessLevel()) {
      return;
    }
    let tresspassingEvent = this.ActionSecurityAreaCrossingPerimeter(tresspasser, entering);
    this.SendActionToAllSlaves(tresspassingEvent);
    this.NotifySecuritySystem(tresspassingEvent);
  }

  public final func OnQuestAddTransition(evt: QuestAddTransition) -> EntityNotificationType {
    let alreadyExisted: Bool;
    let i = 0;
    while i < ArraySize(this.m_runtimeTransitions) {
      if this.m_runtimeTransitions[i].transitionHour == evt.transition.transitionHour {
        if !this.m_runtimeTransitions[i].locked {
          return EntityNotificationType.DoNotNotifyEntity;
        }
        this.m_runtimeTransitions[i].locked = false;
        alreadyExisted = true;
      }
      i += 1;
    }
    if !alreadyExisted {
      ArrayPush(this.m_runtimeTransitions, evt.transition);
    }
    let registerEvent = new RegisterTimeListeners();
    this.QueueEntityEvent(this.GetMyEntityID(), registerEvent);
    if !IsFinal() {
    }
    return EntityNotificationType.DoNotNotifyEntity;
  }

  public final func OnQuestRemoveTransition(evt: QuestRemoveTransition) -> EntityNotificationType {
    let i = 0;
    while i < ArraySize(this.m_runtimeTransitions) {
      if this.m_runtimeTransitions[i].transitionHour == evt.removeTransitionFrom {
        GameInstance
          .GetTimeSystem(this.GetGameInstance())
          .UnregisterListener(this.m_runtimeTransitions[i].listenerID);
        this.m_runtimeTransitions[i].locked = true;
        if !IsFinal() {
        }
      }
      i += 1;
    }
    return EntityNotificationType.DoNotNotifyEntity;
  }

  public final func OnQuestExecuteTransition(evt: QuestExecuteTransition) -> EntityNotificationType {
    this.ApplyTransition(evt.transition, false);
    return EntityNotificationType.DoNotNotifyEntity;
  }

  public final func OnPurgeTransitions(evt: PurgeAllTransitions) -> EntityNotificationType {
    this.UnregisterTimeSystemListeners();
    let i = 0;
    while i < ArraySize(this.m_runtimeTransitions) {
      this.m_runtimeTransitions[i].locked = true;
      i += 1;
    }
    return EntityNotificationType.DoNotNotifyEntity;
  }

  public final func OnQuestIllegalActionAreaNotification(evt: QuestIllegalActionAreaNotification) -> EntityNotificationType {
    let LKP: Vector4;
    let playerPup: GameObject;
    if Equals(evt.revealPlayerSettings.revealPlayer, ERevealPlayerType.REVEAL_ONCE) {
      playerPup = this.GetPlayerMainObject();
      if IsDefined(playerPup) {
        LKP = playerPup.GetWorldPosition();
      }
    }
    let actionSecuritySystemInput = this
      .ActionSecurityBreachNotification(LKP, playerPup, ESecurityNotificationType.ILLEGAL_ACTION);
    this.ExecutePSAction(actionSecuritySystemInput, this);
    return EntityNotificationType.DoNotNotifyEntity;
  }

  public const final func OnQuestCombatActionAreaNotification(evt: QuestCombatActionAreaNotification) -> EntityNotificationType {
    let LKP: Vector4;
    let playerPup: GameObject;
    if Equals(evt.revealPlayerSettings.revealPlayer, ERevealPlayerType.REVEAL_ONCE) {
      playerPup = this.GetLocalPlayerControlledGameObject();
      if IsDefined(playerPup) {
        LKP = playerPup.GetWorldPosition();
      }
    }
    let actionSecuritySystemInput = this
      .ActionSecurityBreachNotification(LKP, playerPup, ESecurityNotificationType.COMBAT);
    this.ExecutePSAction(actionSecuritySystemInput, this);
    return EntityNotificationType.DoNotNotifyEntity;
  }

  public final func OnQuestModifyFilter(evt: QuestModifyFilters) -> EntityNotificationType {
    if NotEquals(evt.incomingFilters, EQuestFilterType.DONT_CHANGE) {
      this.m_eventsFilters.incomingEventsFilter = IntEnum<EFilterType>(EnumInt(evt.incomingFilters) - 1);
    } else if NotEquals(evt.outgoingFilters, EQuestFilterType.DONT_CHANGE) {
      this.m_eventsFilters.outgoingEventsFilter = IntEnum<EFilterType>(EnumInt(evt.outgoingFilters) - 1);
    }
    return EntityNotificationType.DoNotNotifyEntity;
  }

  private final func NotifySecuritySystem(tresspassingEvent: SecurityAreaCrossingPerimeter) {
    this.QueuePSEvent(this.GetSecuritySystem(), tresspassingEvent);
  }

  public const func GetSecurityAccessLevel() -> ESecurityAccessLevel {
    return this.m_securityAccessLevel;
  }

  public const final func GetSecurityAreaType() -> ESecurityAreaType {
    return this.m_securityAreaType;
  }

  public const func IsConnectedToSystem() -> Bool {
    return this.IsPartOfSystem(ESystems.SecuritySystem);
  }

  public const final func GetUsersInPerimeter() -> [AreaEntry] {
    return this.m_usersInPerimeter;
  }

  protected const final func IsPlayerInside() -> Bool {
    let i = 0;
    while i < ArraySize(this.m_usersInPerimeter) {
      if this.m_usersInPerimeter[i].user == this.GetLocalPlayerControlledGameObject().GetEntityID() {
        return true;
      }
      i += 1;
    }
    return false;
  }

  public const final func GetSecurityAreaTypeAsUint32() -> Uint32 {
    if IsDefined(this.GetSecuritySystem()) {
      return this.GetSecuritySystem().IsHidden() ? 0u : EnumInt(this.GetSecurityAreaType());
    }
    return 0u;
  }

  public const func IsConnectedToSecuritySystem(out level: ESecurityAccessLevel) -> Bool {
    let parents: [DeviceComponentPS];
    this.GetParents(parents);
    level = this.GetSecurityAccessLevel();
    let i = 0;
    while i < ArraySize(parents) {
      if IsDefined(parents[i] as SecuritySystemControllerPS) {
        return true;
      }
      i += 1;
    }
    return false;
  }

  private final func SetSecurityAreaType(newType: ESecurityAreaType, opt wasScheduled: Bool) {
    let manageAreaComponent: ManageAreaComponent;
    if Equals(this.m_securityAreaType, newType) {
      return;
    } else if Equals(newType, ESecurityAreaType.DISABLED) {
      this.m_system = null;
      manageAreaComponent = new ManageAreaComponent();
      manageAreaComponent.enable = false;
      this.QueueEntityEvent(this.GetMyEntityID(), manageAreaComponent);
      PreventionSystem
        .PreventionSecurityAreaEnterRequest(this.GetGameInstance(), false, this.GetID());
    } else if Equals(this.m_securityAreaType, ESecurityAreaType.DISABLED) {
      this.m_system = this.GetSecuritySystem();
      manageAreaComponent = new ManageAreaComponent();
      manageAreaComponent.enable = true;
      this.QueueEntityEvent(this.GetMyEntityID(), manageAreaComponent);
    }
    let notification = new SecurityAreaTypeChangedNotification();
    notification.area = this;
    notification.previousType = this.m_securityAreaType;
    notification.wasScheduled = wasScheduled;
    this.m_securityAreaType = newType;
    notification.currentType = this.m_securityAreaType;
    this.QueuePSEvent(this.GetSecuritySystem(), notification);
    if this.GetSecuritySystem().IsHidden() {
      GameInstance
        .GetMappinSystem(this.GetGameInstance())
        .OnAreaTypeChanged(
          PersistentID.ExtractEntityID(this.GetID()),
          SecurityAreaControllerPS.SecurityAreaTypeEnumToName(ESecurityAreaType.DISABLED)
        );
    } else {
      GameInstance
        .GetMappinSystem(this.GetGameInstance())
        .OnAreaTypeChanged(
          PersistentID.ExtractEntityID(this.GetID()),
          SecurityAreaControllerPS.SecurityAreaTypeEnumToName(this.m_securityAreaType)
        );
    }
  }

  private final func ProcessOnExitRequest(entryToProcess: AreaEntry);

  public const final func IsActive() -> Bool {
    return NotEquals(this.m_securityAreaType, ESecurityAreaType.DISABLED);
  }

  public const final func IsUserInside(userToBeChecked: EntityID) -> Bool {
    let index = this.FindEntryIndex(userToBeChecked);
    if index < 0 {
      return false;
    }
    return true;
  }

  public const final func IsAreaCompromised() -> Bool {
    let secSys = this.GetSecuritySystem();
    if !IsDefined(secSys) {
      if !IsFinal() {
      }
      return false;
    }
    let i = 0;
    while i < ArraySize(this.m_usersInPerimeter) {
      if secSys.IsEntityBlacklisted(this.m_usersInPerimeter[i].user)
        || !secSys
          .IsUserAuthorized(this.m_usersInPerimeter[i].user, this.GetSecurityAccessLevel()) {
        return true;
      }
      i += 1;
    }
    return false;
  }

  private final func PushUniqueEntry(entryToPush: AreaEntry) {
    ArrayPush(this.m_usersInPerimeter, entryToPush);
  }

  private const final func FindEntryIndex(userToFind: EntityID) -> Int32 {
    let i = 0;
    while i < ArraySize(this.m_usersInPerimeter) {
      if this.m_usersInPerimeter[i].user == userToFind {
        return i;
      }
      i += 1;
    }
    return -1;
  }

  private const final func ExtractSquadProxies() -> [CommunityProxyPS] {
    let devices: [DeviceComponentPS];
    let proxies: [CommunityProxyPS];
    let myEntityID = PersistentID.ExtractEntityID(this.GetID());
    GameInstance.GetDeviceSystem(this.GetGameInstance()).GetChildren(myEntityID, devices);
    let i = 0;
    while i < ArraySize(devices) {
      if IsDefined(devices[i] as CommunityProxyPS) {
        ArrayPush(proxies, devices[i] as CommunityProxyPS);
      }
      i += 1;
    }
    return proxies;
  }

  public const final func GetSecurityAreaData() -> SecurityAreaData {
    let data: SecurityAreaData;
    data.securityArea = this;
    data.securityAreaType = this.GetSecurityAreaType();
    data.accessLevel = this.GetSecurityAccessLevel();
    data.zoneName = this.GetDeviceName();
    data.id = this.GetID();
    data.incomingFilters = this.m_eventsFilters.incomingEventsFilter;
    data.outgoingFilters = this.m_eventsFilters.outgoingEventsFilter;
    return data;
  }

  public const final func GetSecurityAreaAgents() -> [EntityID] {
    let agents: [EntityID];
    let npcs = this.GetNPCs();
    let devices = this.GetDevices();
    let i = 0;
    while i < ArraySize(npcs) {
      ArrayPush(agents, npcs[i]);
      i += 1;
    }
    i = 0;
    while i < ArraySize(devices) {
      ArrayPush(agents, devices[i]);
      i += 1;
    }
    return agents;
  }

  public const final func GetNPCs() -> [EntityID] {
    let npcs: [EntityID];
    let proxies = this.ExtractSquadProxies();
    let i = 0;
    while i < ArraySize(proxies) {
      i += 1;
    }
    return npcs;
  }

  public const func GetSecuritySystem() -> SecuritySystemControllerPS {
    if IsDefined(this.m_system) {
      return this.m_system;
    }
    return super.GetSecuritySystem();
  }

  public const final func GetDevices() -> [EntityID] {
    let devicesIDs: [EntityID];
    let slaves = this.GetImmediateSlaves();
    let i = 0;
    while i < ArraySize(slaves) {
      if IsDefined(slaves[i] as CommunityProxyPS) {
      } else {
        ArrayPush(devicesIDs, PersistentID.ExtractEntityID(slaves[i].GetID()));
      }
      i += 1;
    }
    return devicesIDs;
  }

  public const final func GetLastOutput() -> SecuritySystemOutput {
    return this.RestoreLastOutput();
  }

  private const final func RestoreLastOutput() -> SecuritySystemOutput {
    let recreatedOutput: SecuritySystemOutput;
    if OutputPersistentData.IsValid(this.m_lastOutput) {
      if EntityID.IsDefined(this.m_lastOutput.m_whoBreached) {
        let whoBreached = GameInstance.FindEntityByID(this.GetGameInstance(), this.m_lastOutput.m_whoBreached) as GameObject;
      } else if EntityID.IsDefined(this.m_lastOutput.m_objectOfInterest) {
        whoBreached = GameInstance
          .FindEntityByID(this.GetGameInstance(), this.m_lastOutput.m_objectOfInterest) as GameObject;
      }
      let reporter = GameInstance
        .FindEntityByID(
          this.GetGameInstance(),
          PersistentID.ExtractEntityID(this.m_lastOutput.m_reporter)
        ) as GameObject;
      recreatedOutput = new SecuritySystemOutput();
      recreatedOutput = this
        .GetSecuritySystem()
        .ActionSecuritySystemBreachResponse(
          ScriptedPuppetPS
            .ActionSecurityBreachNotificationStatic(
              this.m_lastOutput.m_lastKnownPosition,
              whoBreached,
              reporter,
              this.m_lastOutput.m_type
            )
        );
      recreatedOutput.SetCachedSecuritySystemState(this.m_lastOutput.m_currentSecurityState);
      recreatedOutput.SetBreachOrigin(this.m_lastOutput.m_breachOrigin);
      recreatedOutput.SetSecurityStateChanged(this.m_lastOutput.m_securityStateChanged);
      recreatedOutput.GetOriginalInputEvent().ModifyNotificationType(this.m_lastOutput.m_type);
      recreatedOutput.GetOriginalInputEvent().ModifyAreaTypeHack(this.m_lastOutput.m_areaType);
      recreatedOutput.GetOriginalInputEvent().SetID(this.m_lastOutput.m_id);
    }
    return recreatedOutput;
  }

  public final func OnGameEntitySpawnerEvent(evt: gameEntitySpawnerEvent) -> EntityNotificationType {
    let recreatedOutput = this.RestoreLastOutput();
    if IsDefined(recreatedOutput) {
      this.QueueEntityEvent(evt.spawnedEntityId, recreatedOutput);
    }
    return EntityNotificationType.DoNotNotifyEntity;
  }

  public func OnSecuritySystemOutput(breachEvent: SecuritySystemOutput) -> EntityNotificationType {
    let systemState = this.GetSecuritySystem().GetSecurityState();
    if this.m_pendingNotifyPlayerAboutTransition && NotEquals(systemState, ESecuritySystemState.COMBAT) {
      this
        .NotifySystemAboutCrossingPerimeter(this.GetLocalPlayerControlledGameObject(), true);
      this.m_pendingNotifyPlayerAboutTransition = false;
    } else if !this.IsActive() {
      return EntityNotificationType.DoNotNotifyEntity;
    }
    let debugMessage = "Input received";
    if IsDefined(breachEvent.GetOriginalInputEvent())
      && IsDefined(breachEvent.GetOriginalInputEvent().GetWhoBreached())
      && this
        .IsUserInside(breachEvent
          .GetOriginalInputEvent()
          .GetWhoBreached()
          .GetEntityID()) {
      debugMessage += " User Inside - Breach = LOCAL";
      breachEvent.SetBreachOrigin(EBreachOrigin.LOCAL);
      if Equals(systemState, ESecuritySystemState.COMBAT)
        && breachEvent.GetOriginalInputEvent().GetWhoBreached() == this.GetLocalPlayerControlledGameObject() {
        this.m_questPlayerHasTriggeredCombat = true;
        this.m_hasThisAreaReceivedCombatNotification = true;
      }
    } else if Equals(
      breachEvent.GetOriginalInputEvent().GetNotificationType(),
      ESecurityNotificationType.ALARM
    )
      && this
        .IsUserInside(breachEvent
          .GetOriginalInputEvent()
          .GetObjectOfInterest()
          .GetEntityID()) {
      debugMessage += " ALARM ORIGINATED IN THIS AREA - BREACH - LOCAL";
      breachEvent.SetBreachOrigin(EBreachOrigin.LOCAL);
    } else if Equals(this.m_eventsFilters.incomingEventsFilter, EFilterType.ALLOW_NONE) {
      debugMessage += " Area does not accept external events. Ignoring Event";
      if !IsFinal() {
      } else {
        return EntityNotificationType.DoNotNotifyEntity;
      }
    } else if Equals(this.m_eventsFilters.incomingEventsFilter, EFilterType.ALLOW_COMBAT_ONLY) {
      if NotEquals(breachEvent.GetCachedSecurityState(), ESecuritySystemState.COMBAT) {
        debugMessage += " Area accepts only COMBAT events. Ignoring event.";
        if !IsFinal() {
        } else {
          return EntityNotificationType.DoNotNotifyEntity;
        }
      } else {
        this.m_hasThisAreaReceivedCombatNotification = true;
        debugMessage += " User NOT Inside - Breach = EXTERNAL";
        breachEvent.SetBreachOrigin(EBreachOrigin.EXTERNAL);
      }
    }
    debugMessage += " Forwarding event to slaves";
    if !IsFinal() {
    }
    this.StoreLastOutputPersistentData(breachEvent);
    return EntityNotificationType.DoNotNotifyEntity;
  }

  private final func StoreLastOutputPersistentData(breachEvent: SecuritySystemOutput) {
    this.m_lastOutput.m_currentSecurityState = breachEvent.GetCachedSecurityState();
    this.m_lastOutput.m_breachOrigin = breachEvent.GetBreachOrigin();
    this.m_lastOutput.m_securityStateChanged = breachEvent.GetSecurityStateChanged();
    this.m_lastOutput.m_lastKnownPosition = breachEvent.GetOriginalInputEvent().GetLastKnownPosition();
    this.m_lastOutput.m_type = breachEvent.GetOriginalInputEvent().GetNotificationType();
    this.m_lastOutput.m_areaType = this.GetSecurityAreaType();
    if IsDefined(breachEvent.GetOriginalInputEvent().GetObjectOfInterest()) {
      this.m_lastOutput.m_objectOfInterest = breachEvent
        .GetOriginalInputEvent()
        .GetObjectOfInterest()
        .GetEntityID();
    } else if IsDefined(breachEvent.GetOriginalInputEvent().GetWhoBreached()) {
      this.m_lastOutput.m_whoBreached = breachEvent
        .GetOriginalInputEvent()
        .GetWhoBreached()
        .GetEntityID();
    } else if IsDefined(breachEvent.GetOriginalInputEvent().GetNotifierHandle()) {
      this.m_lastOutput.m_reporter = breachEvent
        .GetOriginalInputEvent()
        .GetNotifierHandle()
        .GetID();
    }
    this.m_lastOutput.m_id = breachEvent.GetOriginalInputEvent().GetID();
  }

  public func OnSecuritySystemForceAttitudeChange(evt: SecuritySystemForceAttitudeChange) -> EntityNotificationType {
    this.SendActionToAllSlaves(evt);
    return EntityNotificationType.DoNotNotifyEntity;
  }

  public func OnTargetAssessmentRequest(evt: TargetAssessmentRequest) -> EntityNotificationType {
    this.SendActionToAllSlaves(evt);
    return EntityNotificationType.DoNotNotifyEntity;
  }

  public func OnFullSystemRestart(evt: FullSystemRestart) -> EntityNotificationType {
    this.SendActionToAllSlaves(evt);
    return EntityNotificationType.DoNotNotifyEntity;
  }

  public final static func SecurityAreaTypeEnumToName(type: ESecurityAreaType) -> CName {
    switch type {
      case ESecurityAreaType.DISABLED:
        return n"DISABLED";
      case ESecurityAreaType.SAFE:
        return n"SAFE";
      case ESecurityAreaType.RESTRICTED:
        return n"RESTRICTED";
      case ESecurityAreaType.DANGEROUS:
        return n"DANGEROUS";
    }
    return n"None";
  }

  public const func GetDebugTags() -> String {
    let tags = super.GetDebugTags();
    return tags;
  }

  public func OnMaraudersMapDeviceDebug(sink: MaraudersMapDevicesSink) {
    sink.BeginCategory("securityAreaControllerPS Specific");
    sink.PushString("AREA TYPE", ToString(this.m_securityAreaType));
    sink.PushString("PLAYER INSIDE: ", BoolToString(this.m_isPlayerInside));
    sink.PushString("ACCESS LEVEL", ToString(this.m_securityAccessLevel));
    sink
      .PushString(
        "RECEIVED COMBAT OUTPUT: ",
        BoolToString(this.m_hasThisAreaReceivedCombatNotification)
      );
    sink.EndCategory();
  }

  protected func GetDeviceIconTweakDBID() -> TweakDBID {
    return t"DeviceIcons.SecuritySystemDeviceIcon";
  }

  protected func GetBackgroundTextureTweakDBID() -> TweakDBID {
    return t"DeviceIcons.SecuritySystemDeviceBackground";
  }
}

