  private final func RestoreTrackedAchievemenets() {
    ArrayClear(this.m_trackedAchievements);
    if this.m_bluelinesUseCount
      >= this
        .GetAchievementRecordFromGameDataAchievement(gamedataAchievement.Roleplayer)
        .ThresholdValue() {
      ArrayPush(this.m_trackedAchievements, gamedataAchievement.Roleplayer);
    } else if this.m_quickhacksMade
      >= this
        .GetAchievementRecordFromGameDataAchievement(gamedataAchievement.MustBeTheRats)
        .ThresholdValue() {
      ArrayPush(this.m_trackedAchievements, gamedataAchievement.MustBeTheRats);
    } else if this.m_legendaryItemsCrafted
      >= this
        .GetAchievementRecordFromGameDataAchievement(gamedataAchievement.HandyMan)
        .ThresholdValue() {
      ArrayPush(this.m_trackedAchievements, gamedataAchievement.HandyMan);
    } else if this.m_downedInTimeDilatation
      >= this
        .GetAchievementRecordFromGameDataAchievement(gamedataAchievement.MaxPain)
        .ThresholdValue() {
      ArrayPush(this.m_trackedAchievements, gamedataAchievement.MaxPain);
    } else if this.m_downedWithMelee
      >= this
        .GetAchievementRecordFromGameDataAchievement(gamedataAchievement.TrueWarrior)
        .ThresholdValue() {
      ArrayPush(this.m_trackedAchievements, gamedataAchievement.TrueWarrior);
    } else if this.m_downedWithRanged
      >= this
        .GetAchievementRecordFromGameDataAchievement(gamedataAchievement.TrueSoldier)
        .ThresholdValue() {
      ArrayPush(this.m_trackedAchievements, gamedataAchievement.TrueSoldier);
    }
  }

  private final func UnlockAchievement(achievement: gamedataAchievement) {
    let record = this.GetAchievementRecordFromGameDataAchievement(achievement);
    if record.PlaythroughSpecific() {
      let i = 0;
      if i < ArraySize(this.m_trackedAchievements) {
        if Equals(this.m_trackedAchievements[i], achievement) {
        } else {
          i += 1;
        }
      } else if i != ArraySize(this.m_trackedAchievements) {
        return;
      }
      ArrayPush(this.m_trackedAchievements, achievement);
    }
    GameInstance.GetAchievementSystem(this.GetGameInstance()).UnlockAchievement(record);
  }

  private final func SetAchievementProgress(achievement: gamedataAchievement, trackedData: Int32, opt customTarget: Int32) {
    let record = this.GetAchievementRecordFromGameDataAchievement(achievement);
    let treshold = customTarget != 0 ? customTarget : record.ThresholdValue();
    if trackedData < treshold {
      GameInstance
        .GetAchievementSystem(this.GetGameInstance())
        .SetAchievementProgress(record, Cast<Float>(trackedData) / Cast<Float>(treshold) * 100.0);
    } else {
      this.UnlockAchievement(achievement);
    }
  }

  private const final func GetAchievementRecordFromGameDataAchievement(achievement: gamedataAchievement) -> wref<Achievement_Record> {
    let achievementString = Equals(achievement, gamedataAchievement.LikeFatherLikeSon) ? achievementString = "LikeFatherLIkeSon" : EnumValueToString("gamedataAchievement", Cast<Int64>(EnumInt(achievement)));
    return TweakDBInterface.GetAchievementRecord(TDBID.Create("Achievements." + achievementString));
  }

  private final func OnAddAchievementRequest(request: AddAchievementRequest) {
    this.UnlockAchievement(request.achievement);
  }

  private final func OnSetAchievementProgressRequest(request: SetAchievementProgressRequest) {
    this
      .SetAchievementProgress(request.achievement, request.currentValue, request.customTarget);
  }

  private final func OnUnlockAllAchievementsRequest(request: UnlockAllAchievementsRequest) {
    let i = 0;
    i;
    while i < 58 {
      let achievement = IntEnum<gamedataAchievement>(i);
      if Equals(achievement, gamedataAchievement.Breathtaking)
        || Equals(achievement, gamedataAchievement.Count)
        || Equals(achievement, gamedataAchievement.Invalid) {
      } else {
        this.UnlockAchievement(achievement);
      }
      i += 1;
    }
  }

  private final func ProcessNotTheMobileAchievement(const damageEntry: script_ref<DamageHistoryEntry>) {
    let currentTime = EngineTime.ToFloat(GameInstance.GetSimTime(this.GetGameInstance()));
    if currentTime - this.m_lastKillTimestamp > this.m_timeInterval {
      ArrayClear(this.m_enemiesKilledInTimeInterval);
    }
    this.m_lastKillTimestamp = currentTime;
    let i = 0;
    while i < ArraySize(this.m_enemiesKilledInTimeInterval) {
      if this.m_enemiesKilledInTimeInterval[i] == damageEntry.hitEvent.target {
        return;
      }
      i += 1;
    }
    ArrayPush(this.m_enemiesKilledInTimeInterval, damageEntry.hitEvent.target);
    if ArraySize(this.m_enemiesKilledInTimeInterval) >= this.m_numerOfKillsRequired {
      this.UnlockAchievement(gamedataAchievement.NotTheMobile);
    }
  }

  private final func ProcessHandyManAchievement(targetItem: ItemID, amount: Int32) {
    let gameInstance = this.GetGameInstance();
    let transactionSystem = GameInstance.GetTransactionSystem(gameInstance);
    let itemdata = transactionSystem
      .GetItemData(
        GameInstance.GetPlayerSystem(gameInstance).GetLocalPlayerControlledGameObject(),
        targetItem
      );
    if !itemdata.HasStatData(gamedataStatType.Quality) {
      return;
    } else if itemdata.GetStatValueByType(gamedataStatType.Quality) == 4.0 {
      this.m_legendaryItemsCrafted += amount;
      this
        .SetAchievementProgress(gamedataAchievement.HandyMan, this.m_legendaryItemsCrafted);
    }
  }

  private final func ProcessTwoHeadsOneBulletAchievement(request: NPCKillDataTrackingRequest) {
    let damageData = request.damageEntry;
    if Equals(
      WeaponObject.GetWeaponType(damageData.hitEvent.attackData.GetWeapon().GetItemID()),
      gamedataItemType.Wea_SniperRifle
    ) {
      let entity = damageData.hitEvent.attackData.GetInstigator();
      if this.m_twoHeadssourceID
        == entity.GetEntityID()
        && this.m_twoHeadsValidTimestamp >= EngineTime.ToFloat(GameInstance.GetSimTime(this.GetGameInstance())) {
        this.UnlockAchievement(gamedataAchievement.TwoHeadsOneBullet);
      } else {
        this.m_twoHeadssourceID = entity.GetEntityID();
        this.m_twoHeadsValidTimestamp = EngineTime.ToFloat(GameInstance.GetSimTime(this.GetGameInstance())) + 1.0;
      }
    }
  }

  private final func ProcessGunKataAchievement(request: NPCKillDataTrackingRequest) {
    let damageData = request.damageEntry;
    if (Equals(
      WeaponObject.GetWeaponType(damageData.hitEvent.attackData.GetWeapon().GetItemID()),
      gamedataItemType.Wea_Revolver
    )
      || Equals(
        WeaponObject.GetWeaponType(damageData.hitEvent.attackData.GetWeapon().GetItemID()),
        gamedataItemType.Wea_Handgun
      ))
      && Vector4
        .Distance(damageData.source.GetWorldPosition(), damageData.target.GetWorldPosition()) < 7.5 {
      if this.m_gunKataValidTimestamp >= EngineTime.ToFloat(GameInstance.GetSimTime(this.GetGameInstance())) {
        this.m_gunKataKilledEnemies += 1;
        if this.m_gunKataKilledEnemies >= 3 {
          this.UnlockAchievement(gamedataAchievement.GunKata);
          this.m_gunKataKilledEnemies = 0;
        }
      } else {
        this.m_gunKataKilledEnemies = 1;
        this.m_gunKataValidTimestamp = EngineTime.ToFloat(GameInstance.GetSimTime(this.GetGameInstance())) + 3.5;
      }
    }
  }

  private final func ProcessHardForKneesAchievement() {
    if this.m_hardKneesInProgress {
      this.m_hardKneesKilledEnemies += 1;
      if this.m_harKneesValidTimestamp >= EngineTime.ToFloat(GameInstance.GetSimTime(this.GetGameInstance())) {
        this.UnlockAchievement(gamedataAchievement.ThatIsSoHardForTheKnees);
      } else {
        this.m_hardKneesKilledEnemies = 0;
        this.m_hardKneesInProgress = false;
      }
    } else {
      this.m_hardKneesInProgress = true;
      this.m_hardKneesKilledEnemies += 1;
      this.m_harKneesValidTimestamp = EngineTime.ToFloat(GameInstance.GetSimTime(this.GetGameInstance())) + 1.0;
    }
  }
}

