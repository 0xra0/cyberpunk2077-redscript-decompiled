    this.m_itemDetailsController = widget.GetController() as NewItemTooltipDetailsModule;
    this
      .HandleModuleSpawned(widget, userData as NewItemTooltipModuleSpawnedCallbackData);
    this.UpdateDetailsModule();
  }

