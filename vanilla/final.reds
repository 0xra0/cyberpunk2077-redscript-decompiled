  private final func ResolveQuestMarkOnFact() {
    let factName = this.GetDevicePS().GetFactToDisableQuestMarkName();
    if !IsNameValid(factName) {
      return;
    } else if GameInstance.GetQuestsSystem(this.GetGame()).GetFact(factName) > 0 {
      this.ToggleQuestImportance(false);
    }
  }

  private final func ResolveQuestImportanceOnPerformedAction(action: ScriptableDeviceAction) {
    if !this.GetDevicePS().IsAutoTogglingQuestMark() {
      return;
    }
    let skillcheckAction = action as ActionSkillCheck;
    let authOffAction = action as SetAuthorizationModuleOFF;
    if IsDefined(authOffAction) {
      this.ToggleQuestImportance(false);
    } else if !this.HasAnySkillCheckActive() {
      if Equals(action.GetRequestType(), gamedeviceRequestType.Remote) || Equals(action.GetRequestType(), gamedeviceRequestType.Direct) {
        this.ToggleQuestImportance(false);
      }
    } else if IsDefined(skillcheckAction) {
      if skillcheckAction.IsCompleted() {
        this.ToggleQuestImportance(false);
      }
    }
  }

