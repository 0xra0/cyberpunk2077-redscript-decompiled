abstract class AISubActionBlockData_Record_Implementation extends IScriptable {
  public final static func GetAnimVariation(context: ScriptExecutionContext, record: wref<AISubActionBlockData_Record>) -> Int32 {
    let animVariation = -1;
    let ownerPuppet = ScriptExecutionContext.GetOwner(context) as ScriptedPuppet;
    let attackDirection = (ScriptExecutionContext.GetOwner(context) as ScriptedPuppet).GetHitReactionComponent().GetAttackDirection();
    switch attackDirection {
      case 0:
        animVariation = AISubActionBlockData_Record_Implementation.SetAnimVariation(ownerPuppet, EAIBlockDirection.Center);
        break;
      case 1:
        animVariation = AISubActionBlockData_Record_Implementation.SetAnimVariation(ownerPuppet, EAIBlockDirection.Center);
        break;
      case 2:
        animVariation = AISubActionBlockData_Record_Implementation.SetAnimVariation(ownerPuppet, EAIBlockDirection.Left);
        break;
      case 3:
        animVariation = AISubActionBlockData_Record_Implementation.SetAnimVariation(ownerPuppet, EAIBlockDirection.Left);
        break;
      case 4:
        animVariation = AISubActionBlockData_Record_Implementation.SetAnimVariation(ownerPuppet, EAIBlockDirection.Left);
        break;
      case 5:
        animVariation = AISubActionBlockData_Record_Implementation.SetAnimVariation(ownerPuppet, EAIBlockDirection.Right);
        break;
      case 6:
        animVariation = AISubActionBlockData_Record_Implementation.SetAnimVariation(ownerPuppet, EAIBlockDirection.Right);
        break;
      case 7:
        animVariation = AISubActionBlockData_Record_Implementation.SetAnimVariation(ownerPuppet, EAIBlockDirection.Right);
        break;
      case 8:
        animVariation = AISubActionBlockData_Record_Implementation.SetAnimVariation(ownerPuppet, EAIBlockDirection.Center);
        break;
      default:
        return -1;
    }
    return animVariation;
  }

  public final static func SetAnimVariation(owner: wref<ScriptedPuppet>, direction: EAIBlockDirection) -> Int32 {
    let animVariationList: [Int32];
    let animVariation = -1;
    let blackBoard = owner.GetAIControllerComponent().GetActionBlackboard();
    if !blackBoard.GetBool(GetAllBlackboardDefs().AIAction.ownerCurrentAnimVariationSet) {
      switch direction {
        case EAIBlockDirection.Center:
          ArrayResize(animVariationList, 3);
          animVariationList[0] = 0;
          animVariationList[1] = 1;
          animVariationList[2] = 2;
          break;
        case EAIBlockDirection.Left:
          ArrayResize(animVariationList, 2);
          animVariationList[0] = 0;
          animVariationList[1] = 1;
          break;
        case EAIBlockDirection.Right:
          ArrayResize(animVariationList, 2);
          animVariationList[0] = 0;
          animVariationList[1] = 2;
          if ArraySize(animVariationList) > 1 {
            let previousAnimVariation = AISubActionBlockData_Record_Implementation.GetAnimVariationInBlackBoard(blackBoard, owner);
            if previousAnimVariation == 1 && ArrayContains(animVariationList, 2) {
              animVariation = 2;
            } else if previousAnimVariation == 2 && ArrayContains(animVariationList, 1) {
              animVariation = 1;
            } else if ArrayContains(animVariationList, previousAnimVariation) {
              ArrayRemove(animVariationList, previousAnimVariation);
            } else {
              animVariation = RandRange(0, ArraySize(animVariationList));
              animVariation = animVariationList[animVariation];
            }
          } else {
            animVariation = animVariationList[0];
          }
      }
      AISubActionBlockData_Record_Implementation.SetAnimVariationInBlackBoard(blackBoard, owner, animVariation);
    }
    return AISubActionBlockData_Record_Implementation.GetAnimVariationInBlackBoard(blackBoard, owner);
  }

  public final static func SetAnimVariationInBlackBoard(blackBoard: IBlackboard, owner: wref<ScriptedPuppet>, animVariation: Int32) {
    blackBoard
      .SetInt(GetAllBlackboardDefs().AIAction.ownerLastBlockAnimVariation, animVariation);
    blackBoard.SetBool(GetAllBlackboardDefs().AIAction.ownerCurrentAnimVariationSet, true);
  }

  public final static func GetAnimVariationInBlackBoard(blackBoard: IBlackboard, owner: wref<ScriptedPuppet>) -> Int32 {
    return blackBoard.GetInt(GetAllBlackboardDefs().AIAction.ownerLastBlockAnimVariation);
  }

  public final static func Deactivate(
    context: ScriptExecutionContext,
    record: wref<AISubActionBlockData_Record>,
    const duration: Float,
    interrupted: Bool
  ) {
    let blackBoard = (ScriptExecutionContext.GetOwner(context) as ScriptedPuppet).GetAIControllerComponent().GetActionBlackboard();
    blackBoard.SetBool(GetAllBlackboardDefs().AIAction.ownerCurrentAnimVariationSet, false);
  }
}

