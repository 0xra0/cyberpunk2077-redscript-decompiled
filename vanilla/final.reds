  public final static func GetPSMBlackbordInt(playerPuppet: ScriptedPuppet, id: BlackboardID_Int) -> Int32 {
    let blackboardSystem = GameInstance.GetBlackboardSystem(playerPuppet.GetGame());
    let blackboard = blackboardSystem
      .GetLocalInstanced(playerPuppet.GetEntityID(), GetAllBlackboardDefs().PlayerStateMachine);
    return blackboard.GetInt(id);
  }

