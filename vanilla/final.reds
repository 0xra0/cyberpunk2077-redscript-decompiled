class MeleeFinalAttackDecisions extends MeleeAttackGenericDecisions {
  protected const func EnterCondition(const stateContext: StateContext, const scriptInterface: StateGameScriptInterface) -> Bool {
    if !this.CheckIfFinalAttack(scriptInterface, stateContext) {
      return false;
    } else if MeleeTransition.WantsToStrongAttack(stateContext, scriptInterface) {
      return false;
    } else if !MeleeTransition.WantsToLightAttack(stateContext, scriptInterface) {
      return false;
    } else if !super.EnterCondition(stateContext, scriptInterface) {
      return false;
    }
    return true;
  }
}

