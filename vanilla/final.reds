  private final func CompensateMissingBuzzsawPsalmRecipes() {
    let ss = GameInstance.GetStatsSystem(this.GetGameInstance());
    let player = GetMainPlayer(this.GetGameInstance());
    let playerLevel = ss
      .GetStatValue(Cast<StatsObjectID>(player.GetEntityID()), gamedataStatType.Level);
