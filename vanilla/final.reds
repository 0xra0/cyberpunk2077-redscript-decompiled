      this
        .GetOwnerEntity()
        .GetDeviceLink()
        .TriggerSecuritySystemNotification(
          this.GetOwnerEntity().GetWorldPosition(),
          evt.GetExecutor(),
          ESecurityNotificationType.DEESCALATE
        );
