  private final func ProcessCraftedItemsPowerBoost() {
    let itemList: [wref<gameItemData>];
    let statsSystem: StatsSystem;
    let player = GetPlayer(this.GetGameInstance());
    if IsDefined(player) {
      let transactionSystem = GameInstance.GetTransactionSystem(this.GetGameInstance());
      statsSystem = GameInstance.GetStatsSystem(this.GetGameInstance());
      transactionSystem.GetItemList(player, itemList);
    }
    let i = 0;
    while i < ArraySize(itemList) {
      if RPGManager.IsItemCrafted(itemList[i]) {
        if RPGManager.IsItemWeapon(itemList[i].GetID()) {
          statsSystem
            .RemoveSavedModifiers(
              itemList[i].GetStatsObjectID(),
              gamedataStatType.CraftingBonusWeaponDamage
            );
          statsSystem
            .RemoveSavedModifiers(
              itemList[i].GetStatsObjectID(),
              gamedataStatType.CanLegendaryCraftedWeaponsBeBoosted
            );
        } else if RPGManager.IsItemClothing(itemList[i].GetID()) {
          statsSystem
            .RemoveSavedModifiers(
              itemList[i].GetStatsObjectID(),
              gamedataStatType.CraftingBonusArmorValue
            );
        }
      }
      i += 1;
    }
  }

