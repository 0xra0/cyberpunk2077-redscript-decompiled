class StatPoolSpentPrereq extends IScriptablePrereq {
  public let m_statPoolType: gamedataStatPoolType;
  public let m_valueToCheck: Float;

  protected const func OnRegister(state: PrereqState, game: GameInstance, context: IScriptable) -> Bool {
    let owner = context as GameObject;
    let castedState = state as StatPoolSpentPrereqState;
    castedState.SetThreshold(this.m_valueToCheck);
    castedState.m_listener = new StatPoolSpentPrereqListener();
    castedState.m_listener.RegisterState(castedState);
    castedState.m_listener.SetValue(this.m_valueToCheck);
    GameInstance
      .GetStatPoolsSystem(game)
      .RequestRegisteringListener(
        Cast<StatsObjectID>(owner.GetEntityID()),
        this.m_statPoolType,
        castedState.m_listener
      );
    return false;
  }

  protected const func OnUnregister(state: PrereqState, game: GameInstance, context: IScriptable) {
    let owner = context as GameObject;
    let castedState = state as StatPoolSpentPrereqState;
    GameInstance
      .GetStatPoolsSystem(game)
      .RequestUnregisteringListener(
        Cast<StatsObjectID>(owner.GetEntityID()),
        this.m_statPoolType,
        castedState.m_listener
      );
    castedState.m_listener = null;
  }

  protected func Initialize(recordID: TweakDBID) {
    this.m_statPoolType = IntEnum<gamedataStatPoolType>(
      Cast<Int32>(
        EnumValueFromName(
          n"gamedataStatPoolType",
          TweakDBInterface.GetCName(recordID + t".statPoolType", n"None")
        )
      )
    );
    this.m_valueToCheck = TweakDBInterface.GetFloat(recordID + t".valueToCheck", 0.0);
  }
}

