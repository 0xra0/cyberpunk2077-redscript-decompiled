abstract class AISubActionUpdateFriendlyFireParams_Record_Implementation extends IScriptable {
  public final static func Activate(
    context: ScriptExecutionContext,
    record: wref<AISubActionUpdateFriendlyFireParams_Record>
  ) {
    let aiComponent: AIHumanComponent;
    if !record.UpdateOnDeactivate()
      && AIHumanComponent
        .Get(ScriptExecutionContext.GetOwner(context) as ScriptedPuppet, aiComponent) {
      if !GameInstance
        .GetTransactionSystem(ScriptExecutionContext.GetOwner(context).GetGame())
        .IsSlotEmpty(ScriptExecutionContext.GetOwner(context), t"AttachmentSlots.WeaponRight") {
        let weaponItem = GameInstance
          .GetTransactionSystem(ScriptExecutionContext.GetOwner(context).GetGame())
          .GetItemInSlot(
            ScriptExecutionContext.GetOwner(context),
            t"AttachmentSlots.WeaponRight"
          );
        let equippedItemType = TweakDBInterface
          .GetItemRecord(ItemID.GetTDBID(weaponItem.GetItemID()))
          .ItemType()
          .Type();
        AISubActionUpdateFriendlyFireParams_Record_Implementation
          .SetFriendlyFireGeometry(equippedItemType, aiComponent.GetFriendlyFireSystem());
      }
    }
  }

  public final static func Update(
    context: ScriptExecutionContext,
    record: wref<AISubActionUpdateFriendlyFireParams_Record>,
    const duration: Float
  ) -> AIbehaviorUpdateOutcome {
    return AIbehaviorUpdateOutcome.SUCCESS;
  }

  public final static func Deactivate(
    context: ScriptExecutionContext,
    record: wref<AISubActionUpdateFriendlyFireParams_Record>,
    const duration: Float,
    interrupted: Bool
  ) {
    let aiComponent: AIHumanComponent;
    if record.UpdateOnDeactivate()
      && AIHumanComponent
        .Get(ScriptExecutionContext.GetOwner(context) as ScriptedPuppet, aiComponent) {
      if !GameInstance
        .GetTransactionSystem(ScriptExecutionContext.GetOwner(context).GetGame())
        .IsSlotEmpty(ScriptExecutionContext.GetOwner(context), t"AttachmentSlots.WeaponRight") {
        let weaponItem = GameInstance
          .GetTransactionSystem(ScriptExecutionContext.GetOwner(context).GetGame())
          .GetItemInSlot(
            ScriptExecutionContext.GetOwner(context),
            t"AttachmentSlots.WeaponRight"
          );
        let equippedItemType = TweakDBInterface
          .GetItemRecord(ItemID.GetTDBID(weaponItem.GetItemID()))
          .ItemType()
          .Type();
        AISubActionUpdateFriendlyFireParams_Record_Implementation
          .SetFriendlyFireGeometry(equippedItemType, aiComponent.GetFriendlyFireSystem());
      }
    }
  }

  protected final static func SetFriendlyFireGeometry(equippedItemType: gamedataItemType, ffs: IFriendlyFireSystem) {
    let ffp = new FriendlyFireParams();
    switch equippedItemType {
      case gamedataItemType.Wea_Melee:
