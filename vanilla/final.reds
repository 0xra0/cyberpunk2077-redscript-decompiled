class ConsumablesChargesHelper extends IScriptable {
  public final static func RefreshAllCharges(gameInstance: GameInstance, statPool: gamedataStatPoolType) {
    GameInstance
      .GetStatPoolsSystem(gameInstance)
      .RequestSettingStatPoolMaxValue(Cast<StatsObjectID>(GetPlayer(gameInstance).GetEntityID()), statPool, null);
  }

  public final static func RefreshToSpecificAmount(gameInstance: GameInstance, statPool: gamedataStatPoolType, amount: Int32) {
    let difference: Int32;
    switch statPool {
      case gamedataStatPoolType.HealingItemsCharges:
        difference = amount - GetPlayer(gameInstance).GetHealingItemCharges();
        break;
      case gamedataStatPoolType.GrenadesCharges:
        difference = amount - GetPlayer(gameInstance).GetGrenadeCharges();
        break;
      case gamedataStatPoolType.ProjectileLauncherCharges:
        difference = amount - GetPlayer(gameInstance).GetProjectileLauncherCharges();
        if difference > 0 {
          ConsumablesChargesHelper.RefreshAmountOfCharges(gameInstance, statPool, difference);
        }
    }
  }

  public final static func RefreshAmountOfCharges(gameInstance: GameInstance, statPool: gamedataStatPoolType, amount: Int32) {
    let chargeToRestore: Int32;
    switch statPool {
      case gamedataStatPoolType.HealingItemsCharges:
        chargeToRestore = amount * GetPlayer(gameInstance).GetHealingItemUseCost();
        break;
      case gamedataStatPoolType.GrenadesCharges:
        chargeToRestore = amount * GetPlayer(gameInstance).GetGrenadeThrowCostClean();
        break;
      case gamedataStatPoolType.ProjectileLauncherCharges:
        chargeToRestore = amount * GetPlayer(gameInstance).GetProjectileLauncherShootCost();
        GameInstance
          .GetStatPoolsSystem(gameInstance)
          .RequestChangingStatPoolValue(
            Cast<StatsObjectID>(GetPlayer(gameInstance).GetEntityID()),
            statPool,
            Cast<Float>(chargeToRestore),
            null,
            false,
            false
          );
    }
  }

  public final static func HotkeyRefresh(gameInstance: GameInstance) {
    let eqs = GameInstance.GetScriptableSystemsContainer(gameInstance).Get(n"EquipmentSystem") as EquipmentSystem;
    if IsDefined(eqs) {
      let hotkeyRefresh = new HotkeyRefreshRequest();
      hotkeyRefresh.owner = GameInstance.GetPlayerSystem(gameInstance).GetLocalPlayerControlledGameObject();
      eqs.QueueRequest(hotkeyRefresh);
    }
  }

  public final static func LeaveTheBestQualityConsumable(gameInstance: GameInstance, tag: CName) -> Bool {
    let bestGrenadeQuality: Int32;
    let currentGrenadeQuality: Int32;
    let playerItems: [wref<gameItemData>];
    let itemid: ItemID;
    let itemRemoved = false;
    GameInstance
      .GetTransactionSystem(gameInstance)
      .GetItemListByTag(GetPlayer(gameInstance), tag, playerItems);
    let i = 0;
    while i < ArraySize(playerItems) {
      itemid = playerItems[i].GetID();
      currentGrenadeQuality = TweakDBInterface
        .GetItemRecord(ItemID.GetTDBID(itemid))
        .Quality()
        .Value();
      if currentGrenadeQuality > bestGrenadeQuality {
        bestGrenadeQuality = currentGrenadeQuality;
      }
      i += 1;
    }
    i = 0;
    while i < ArraySize(playerItems) {
      itemid = playerItems[i].GetID();
      currentGrenadeQuality = TweakDBInterface
        .GetItemRecord(ItemID.GetTDBID(itemid))
        .Quality()
        .Value();
      if currentGrenadeQuality < bestGrenadeQuality {
        GameInstance
          .GetTransactionSystem(gameInstance)
          .RemoveItem(GetPlayer(gameInstance), playerItems[i].GetID(), 999);
        itemRemoved = true;
      }
      i += 1;
    }
    GameInstance.GetUISystem(gameInstance).QueueEvent(new ForceRadialWheelRebuild());
    return itemRemoved;
  }

  public final static func HideConsumableRecipe(gameInstance: GameInstance, recipeToHide: TweakDBID) {
    let craftingSystem = CraftingSystem.GetInstance(gameInstance);
    let playerCraftBook = craftingSystem.GetPlayerCraftBook();
    playerCraftBook.HideRecipe(recipeToHide, true);
  }

  public final static func GetConsumableTag(tags: [CName]) -> CName {
    let tag = n"None";
    if ArrayContains(tags, n"FragGrenade") {
      tag = n"FragGrenade";
    } else if ArrayContains(tags, n"FlashGrenade") {
      tag = n"FlashGrenade";
    } else if ArrayContains(tags, n"SmokeGrenade") {
      tag = n"SmokeGrenade";
    } else if ArrayContains(tags, n"EMPGrenade") {
      tag = n"EMPGrenade";
    } else if ArrayContains(tags, n"BiohazardGrenade") {
      tag = n"BiohazardGrenade";
    } else if ArrayContains(tags, n"IncendiaryGrenade") {
      tag = n"IncendiaryGrenade";
    } else if ArrayContains(tags, n"ReconGrenade") {
      tag = n"ReconGrenade";
    } else if ArrayContains(tags, n"CuttingGrenade") {
      tag = n"CuttingGrenade";
    } else if ArrayContains(tags, n"Inhaler") {
      tag = n"Inhaler";
    } else if ArrayContains(tags, n"Injector") {
      tag = n"Injector";
    }
    return tag;
  }
}

class BaseChargesStatListener extends CustomValueStatPoolsListener {
  public let m_player: wref<PlayerPuppet>;
  public let m_playedCueAlready: Bool;
  public let m_currentCharges: Int32;
  public let m_currentStatPoolValue: Int32;
  public let m_rechargeSoundCue: CName;
  public let m_statSystem: StatsSystem;
  public let m_finalString: String;

  public func Init(player: wref<PlayerPuppet>) {
    this.m_player = player;
    this.m_playedCueAlready = false;
    this.m_currentCharges = -1;
    this.m_statSystem = GameInstance.GetStatsSystem(this.m_player.GetGame());
  }

  public func MaxStatPoolValue() -> Int32 {
    return Cast<Int32>(
      GameInstance
        .GetStatPoolsSystem(this.m_player.GetGame())
        .GetStatPoolMaxPointValue(
          Cast<StatsObjectID>(this.m_player.GetEntityID()),
          gamedataStatPoolType.HealingItemsCharges
        )
    );
  }

  public func OnStatPoolValueChanged(oldValue: Float, newValue: Float, percToPoints: Float) {
    this.m_currentStatPoolValue = RoundMath(newValue * percToPoints);
    let charges = this.m_currentStatPoolValue / this.GetRechargeDuration();
    if this.m_currentCharges == -1 {
      this.m_currentCharges = charges;
    } else if charges != this.m_currentCharges {
      ConsumablesChargesHelper.HotkeyRefresh(this.m_player.GetGame());
      if charges > this.m_currentCharges {
        this.Recharged();
      }
      this.m_currentCharges = charges;
    }
  }

  protected func GetActiveItem(hotkey: EHotkey) -> Item_Record {
    let equipmentSystem = EquipmentSystem.GetInstance(this.m_player);
    let activeItem = equipmentSystem.GetItemIDFromHotkey(this.m_player, hotkey);
    return TweakDBInterface.GetItemRecord(ItemID.GetTDBID(activeItem));
  }

  public func GetCharges() -> Int32 {
    return this.m_currentCharges;
  }

  private func Recharged();

  protected func PlayRechagedSoundEvent() {
    let audioEvent = new SoundPlayEvent();
    audioEvent.soundName = this.m_rechargeSoundCue;
    this.m_player.QueueEvent(audioEvent);
  }

  public func GetRechargeDuration() -> Int32 {
    return Cast<Int32>(
      this
        .m_statSystem
        .GetStatValue(
          Cast<StatsObjectID>(this.m_player.GetEntityID()),
          gamedataStatType.HealingItemsRechargeDuration
        )
    );
  }
}

