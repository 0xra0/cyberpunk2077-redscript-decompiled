  public final func SetOpenedMailAdress(documentAdress: SDocumentAdress) {
    if documentAdress.folderID >= 0 && documentAdress.documentID >= 0 {
      this.m_openedMailAdress = documentAdress;
      let wasAlreadyRed = this
        .m_computerSetup
        .m_mailsStructure[documentAdress.folderID]
        .content[documentAdress.documentID]
        .wasRead;
      this
        .m_computerSetup
        .m_mailsStructure[documentAdress.folderID]
        .content[documentAdress.documentID]
        .wasRead = true;
      if !wasAlreadyRed {
        this.RequestMenuButtonWidgetsUpdate(this.GetBlackboard());
      }
    }
  }

