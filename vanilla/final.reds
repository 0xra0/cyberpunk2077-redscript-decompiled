  }

  protected final func UnRegisterPlayerTargetCallback() {
    let blackBoard = GameInstance
      .GetBlackboardSystem(this.GetGame())
      .Get(GetAllBlackboardDefs().UI_TargetingInfo);
    if IsDefined(this.m_currentPlayerTargetCallbackID) {
      blackBoard
        .UnregisterListenerEntityID(
          GetAllBlackboardDefs().UI_TargetingInfo.CurrentVisibleTarget,
          this.m_currentPlayerTargetCallbackID
        );
    }
  }

