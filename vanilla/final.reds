class AISetAutocraftingState extends AIbehaviortaskScript {
  public let newState: Bool;

  protected func Activate(context: ScriptExecutionContext) {
    let autocraftSystem = GameInstance
      .GetScriptableSystemsContainer(ScriptExecutionContext.GetOwner(context).GetGame())
      .Get(n"AutocraftSystem") as AutocraftSystem;
    if this.newState {
      let autocraftActivateRequest = new AutocraftActivateRequest();
      autocraftSystem.QueueRequest(autocraftActivateRequest);
    } else {
      let autocraftDeactivateRequest = new AutocraftDeactivateRequest();
      autocraftDeactivateRequest.resetMemory = false;
      autocraftSystem.QueueRequest(autocraftDeactivateRequest);
    }
  }
}

