class SwimmingFastDivingEvents extends LocomotionSwimmingEvents {
  public let m_lapsedTime: Float;

  protected func OnUpdate(
    timeDelta: Float,
    stateContext: StateContext,
    scriptInterface: StateGameScriptInterface
  ) {
    super.OnUpdate(timeDelta, stateContext, scriptInterface);
    if scriptInterface.GetActionValue(n"Jump") > 0.0 {
      this
        .AddVerticalImpulse(
          stateContext,
          this.GetStaticFloatParameterDefault("divingUpwardsImpulseStrength", 1.0) * this.GetSwimmingImpulseMultiplier(scriptInterface, timeDelta)
        );
    } else if scriptInterface.GetActionValue(n"Dive") > 0.0 || scriptInterface.GetActionValue(n"Crouch") > 0.0 {
      this
        .AddVerticalImpulse(
          stateContext,
          this.GetStaticFloatParameterDefault("divingDownwardsImpulseStrength", 1.0) * this.GetSwimmingImpulseMultiplier(scriptInterface, timeDelta)
        );
    }
    this.UpdateFastDivingStroke(timeDelta, stateContext, scriptInterface);
  }

  private final func UpdateFastDivingStroke(
    timeDelta: Float,
    stateContext: StateContext,
    scriptInterface: StateGameScriptInterface
  ) {
    this.m_lapsedTime += timeDelta;
    let timeBetweenSwimmingStroke = this.GetStaticFloatParameterDefault("timeBetweenFastDivingStroke", 1.0);
    if this.m_lapsedTime >= timeBetweenSwimmingStroke {
      this.m_lapsedTime = 0.0;
      this
        .AddImpulseInMovingDirection(
          stateContext,
          scriptInterface,
          this.GetStaticFloatParameterDefault("fastDivingStrokeImpulseForce", 1.0)
        );
      GameObjectEffectHelper
        .StartEffectEvent(scriptInterface.executionOwner, n"swimming_diving_stroke_fast", false);
    }
  }

  public func OnEnter(stateContext: StateContext, scriptInterface: StateGameScriptInterface) {
    this
      .SetBlackboardIntVariable(scriptInterface, GetAllBlackboardDefs().PlayerStateMachine.Swimming, 2);
    super.OnEnter(stateContext, scriptInterface);
  }

  public func OnExit(stateContext: StateContext, scriptInterface: StateGameScriptInterface) {
    super.OnExit(stateContext, scriptInterface);
  }
}

class SwimmingDeathEvents extends DeathEvents {
  protected final func SetSwimming(stateContext: StateContext, scriptInterface: StateGameScriptInterface) {
    let swapEvent = new PSMAddOnDemandStateMachine();
    swapEvent.stateMachineName = n"LocomotionSwimming";
    swapEvent.tryHotSwap = true;
    scriptInterface.owner.QueueEvent(swapEvent);
  }

  protected func OnEnter(stateContext: StateContext, scriptInterface: StateGameScriptInterface) {
    this.EvaluateSettingCustomDeathAnimation(stateContext, scriptInterface);
    this.ForceFreeze(stateContext);
    if !stateContext.IsStateMachineActive(n"LocomotionSwimming") {
      this.SetSwimming(stateContext, scriptInterface);
    }
    super.OnEnter(stateContext, scriptInterface);
  }
}

