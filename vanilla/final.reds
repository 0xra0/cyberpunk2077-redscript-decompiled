  public final native func AI_PlayChargeStartedSound();

  public final native func AI_PlayMeleeAttackSound(isQuickMelee: Bool);

  public final native func AI_ShootAt(
    targetPositionProvider: IPositionProvider,
    targetObject: GameObject,
    instigator: wref<GameObject>,
    ammoCost: Uint16,
    projectileParams: gameprojectileWeaponParams,
    projectilesPerShot: Uint8,
    charge: Float,
    opt maxSpread: Float,
    opt muzzleOffset: Vector4
  );

  public final native func AI_ShootForwards(
    instigator: wref<GameObject>,
    ammoCost: Uint16,
    projectileParams: gameprojectileWeaponParams,
    projectilesPerShot: Uint8,
    charge: Float,
    opt overridePos: Vector4,
    opt overrideForward: Vector4,
    opt muzzleOffset: Vector4
  );

  public final native func AI_ShootSelfOffScreen(
    targetObject: gamePuppet,
    ammoCost: Uint16,
    projectileParams: gameprojectileWeaponParams,
    projectilesPerShot: Uint8,
    charge: Float
  );

  public final native func GetMuzzleSlotWorldTransform() -> Transform;

  private final native func SetWeaponEffects(weaponVFXActionRecord: [wref<WeaponVFXAction_Record>]);

  private final native func RemoveWeaponEffects();

  public final native func SetVisible(visible: Bool);

  private final func PlayMeleeSound();

  private final func StopMeleeSound();

  protected cb func OnGameAttached() -> Bool {
    let weaponVFXActionRecord: [wref<WeaponVFXAction_Record>];
    super.OnGameAttached();
    this.m_weaponRecord = TweakDBInterface.GetWeaponItemRecord(ItemID.GetTDBID(this.GetItemID()));
    this.m_isHeavyWeapon = Equals(
      EquipmentSystem.GetEquipAreaType(this.GetItemID()),
      gamedataEquipmentArea.WeaponHeavy
    );
    this.m_isMeleeWeapon = this.m_weaponRecord.TagsContains(n"MeleeWeapon");
    this.m_isRangedWeapon = this.m_weaponRecord.TagsContains(n"RangedWeapon");
    this.m_isShotgunWeapon = this.m_weaponRecord.TagsContains(n"ShotgunWeapon");
    this.m_AIBlackboard = IBlackboard.Create(GetAllBlackboardDefs().AIShooting);
    this.OnAttachSetStatPools();
    this.RegisterStatPoolListeners();
    this.RegisterStatListeners();
    let weaponFxPackage = this.m_weaponRecord.FxPackage();
    if this.GetOwner().IsNPC() {
      GameInstance
        .GetDelaySystem(this.GetGame())
        .DelayEvent(this, new UpdateDamageChangeEvent(), 1.0e-5);
    } else if this.GetOwner().IsPlayer() {
    }
    weaponFxPackage.Npc_vfx_set().Actions(weaponVFXActionRecord);
    this.SetWeaponEffects(weaponVFXActionRecord);
    this.m_animOwner = 2;
    this.SetWeaponOwner();
    this.SendWeaponOwnerVehicleData();
    this.m_hasSecondaryTriggerMode = false;
    if IsDefined(this.m_weaponRecord.SecondaryTriggerMode()) {
      if NotEquals(
        this.m_weaponRecord.PrimaryTriggerMode().Type(),
        this.m_weaponRecord.SecondaryTriggerMode().Type()
      ) {
        this.m_hasSecondaryTriggerMode = true;
      }
    }
    this.m_perfectChargeStarted = false;
    this.m_perfectChargeReached = false;
    this.m_perfectChargeShot = false;
  }

  private final func SetupWeaponEffects() {
    let weaponVFXActionRecord: [wref<WeaponVFXAction_Record>];
    this.SendScopeData();
    let localOwner = this.GetNextWeaponOwner();
    if localOwner == this.m_animOwner {
      return;
    } else if this.GetOwner().IsPlayer() || this.GetOwner().IsPaperdoll() {
      this.SendWeaponStatsAnimFeature();
      this.HandleVisualEffectsSetup();
      this.CatcheTriggerEffectFromWeaponType();
      this
        .m_weaponRecord
        .FxPackage()
        .Player_vfx_set()
        .Actions(weaponVFXActionRecord);
      this.SetWeaponEffects(weaponVFXActionRecord);
    }
    this.SetWeaponOwner(localOwner);
    this.m_animOwner = localOwner;
  }

  protected cb func OnVisualSpawnAttached() -> Bool {
    super.OnVisualSpawnAttached();
    this.SetupWeaponEffects();
    (this.GetOwner() as ScriptedPuppet).SetAnimWrappersOnItem(this);
  }

  protected cb func OnPlayerWeaponSetupEvent(evt: PlayerWeaponSetupEvent) -> Bool {
    this.SetupWeaponEffects();
  }

  protected cb func OnDetach() -> Bool {
    super.OnDetach();
    this.RemoveWeaponEffects();
    if IsDefined(this.m_overheatListener) {
      GameInstance
        .GetStatPoolsSystem(this.GetGame())
        .RequestUnregisteringListener(
          Cast<StatsObjectID>(this.GetEntityID()),
          gamedataStatPoolType.WeaponOverheat,
          this.m_overheatListener
        );
      this.m_overheatListener = null;
      this.m_overheatDelaySent = false;
    }
    this.SendWeaponOwnerVehicleData();
    this.UnregisterChargeStatListener();
    if IsDefined(this.m_damageTypeListener) {
      GameInstance
        .GetStatsSystem(this.GetGame())
        .UnregisterListener(Cast<StatsObjectID>(this.GetEntityID()), this.m_damageTypeListener);
      this.m_damageTypeListener = null;
    } else if this.GetOwner().IsPlayer() {
      GameInstance.GetAudioSystem(this.GetGame()).RemoveAllTriggerEffects();
    }
  }

  public const final func HasSecondaryTriggerMode() -> Bool {
    return this.m_hasSecondaryTriggerMode;
  }

  public const final func GetWeaponRecord() -> WeaponItem_Record {
    return this.m_weaponRecord;
  }

  public const final func IsHeavyWeapon() -> Bool {
    return this.m_isHeavyWeapon;
  }

  public const final func IsRanged() -> Bool {
    return this.m_isRangedWeapon;
  }

  public const final func IsMelee() -> Bool {
    return this.m_isMeleeWeapon;
  }

  public const final func IsShotgun() -> Bool {
    return this.m_isShotgunWeapon;
  }

  public const final func IsBlade() -> Bool {
    let type = this.m_weaponRecord.ItemType().Type();
    if Equals(type, gamedataItemType.Wea_Machete)
      || Equals(type, gamedataItemType.Wea_Katana)
      || Equals(type, gamedataItemType.Wea_Sword)
      || Equals(type, gamedataItemType.Wea_Chainsword)
      || Equals(type, gamedataItemType.Wea_LongBlade)
      || Equals(type, gamedataItemType.Cyb_MantisBlades) {
      return true;
    }
    return false;
  }

