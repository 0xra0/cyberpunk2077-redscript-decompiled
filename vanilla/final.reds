    let storageItems: [wref<gameItemData>];
    let transactionSystem = GameInstance.GetTransactionSystem(this.GetGame());
    transactionSystem.GetItemList(this, storageItems);
    let i = 0;
    while i < ArraySize(storageItems) {
      if storageItems[i].HasTag(n"Left_Hand_Retrofix") {
        Stash
          .ScaleLeftHandCompensateWeaponsToPlayerLevelInStash(this, storageItems[i]);
      }
      i += 1;
    }
  }

