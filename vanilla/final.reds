class ActionTargetInDistancePrereq extends IScriptablePrereq {
  public let m_targetRecord: wref<AIActionTarget_Record>;
  public let m_distance: Float;
  public let m_distanceStat: gamedataStatType;
  public let m_invert: Bool;

  protected func Initialize(recordID: TweakDBID) {
    let prereqRecord = TweakDBInterface.GetActionTargetInDistancePrereqRecord(recordID);
    let statRecord = TweakDBInterface.GetStatRecord(TDB.GetForeignKey(recordID + t".distanceStat"));
    this.m_targetRecord = prereqRecord.Target();
    this.m_distance = prereqRecord.Distance();
    if IsDefined(statRecord) {
      this.m_distanceStat = statRecord.StatType();
    }
    this.m_invert = prereqRecord.Invert();
  }

  protected const func OnApplied(state: PrereqState, game: GameInstance, context: IScriptable) {
    state.OnChanged(this.IsFulfilled(game, context));
  }

  public const func IsFulfilled(game: GameInstance, context: IScriptable) -> Bool {
    let targetObject: wref<GameObject>;
    let ownerContext: ScriptExecutionContext;
    let maxDistance: Float;
    let owner = context as ScriptedPuppet;
    if !AIHumanComponent.GetScriptContext(owner, ownerContext) {
      return this.m_invert ? true : false;
    } else if !AIActionTarget.GetObject(ownerContext, this.m_targetRecord, targetObject) {
      return this.m_invert ? true : false;
    } else if NotEquals(this.m_distanceStat, gamedataStatType.Invalid) {
      let statsSystem = GameInstance.GetStatsSystem(owner.GetGame());
      let player = GameInstance.GetPlayerSystem(owner.GetGame()).GetLocalPlayerControlledGameObject();
      maxDistance = statsSystem
        .GetStatValue(Cast<StatsObjectID>(player.GetEntityID()), this.m_distanceStat);
    }
    maxDistance = this.m_distance;
    if maxDistance < 0.0 {
      return this.m_invert ? true : false;
    }
    let distSqr = Vector4.DistanceSquared(owner.GetWorldPosition(), targetObject.GetWorldPosition());
    let succ = distSqr < maxDistance * maxDistance;
    return this.m_invert ? !succ : succ;
  }
}

importonly native class ActionTargetInDistancePrereq_Record extends IPrereq_Record {
  public final native func Target() -> wref<AIActionTarget_Record>;

  public final native func TargetHandle() -> AIActionTarget_Record;

  public final native func DistanceStat() -> wref<Stat_Record>;

  public final native func DistanceStatHandle() -> Stat_Record;

  public final native func Distance() -> Float;

  public final native func Invert() -> Bool;
}

class UsingCoverPSMPrereqState extends PlayerStateMachinePrereqState {
  public let bValue: Bool;

  protected cb func OnStateUpdateBool(value: Bool) -> Bool {
    let prereq = this.GetPrereq() as UsingCoverPSMPrereq;
    if NotEquals(this.bValue, value) {
      let checkPassed = prereq.Evaluate(this.m_owner, value);
      this.OnChanged(checkPassed);
    }
    this.bValue = value;
  }
}

class UsingCoverPSMPrereq extends PlayerStateMachinePrereq {
  protected const func OnRegister(state: PrereqState, game: GameInstance, context: IScriptable) -> Bool {
    let bb = GameInstance
      .GetBlackboardSystem(game)
      .GetLocalInstanced(
        (context as ScriptedPuppet).GetEntityID(),
        GetAllBlackboardDefs().PlayerStateMachine
      );
    let castedState = state as UsingCoverPSMPrereqState;
    if IsDefined(castedState) {
      castedState.m_owner = context as GameObject;
      if IsDefined(bb) {
        castedState.m_listenerInt = bb
          .RegisterListenerBool(
            GetAllBlackboardDefs().PlayerStateMachine.UsingCover,
            castedState,
            n"OnStateUpdateBool"
          );
      }
    }
    return false;
  }

  protected const func OnUnregister(state: PrereqState, game: GameInstance, context: IScriptable) {
    let castedState = state as UsingCoverPSMPrereqState;
    if IsDefined(castedState) {
      let bb = GameInstance.GetBlackboardSystem(game).Get(GetAllBlackboardDefs().PlayerStateMachine);
      if IsDefined(bb) {
        bb
          .UnregisterListenerBool(
            GetAllBlackboardDefs().PlayerStateMachine.UsingCover,
            castedState.m_listenerInt
          );
      }
    }
  }

  protected const func GetStateMachineEnum() -> String {
    return "";
  }

  protected const func GetCurrentPSMStateIndex(bb: IBlackboard) -> Int32 {
    let b = bb.GetBool(GetAllBlackboardDefs().PlayerStateMachine.UsingCover);
    if b {
      return 1;
    }
    return 0;
  }

  protected func Initialize(recordID: TweakDBID) {
    let b = TweakDBInterface.GetBool(recordID + t".isInState", true);
    if b {
      this.m_valueToListen = 1;
    } else {
      this.m_valueToListen = 0;
    }
  }

  public const final func Evaluate(owner: GameObject, value: Bool) -> Bool {
    let b = this.m_valueToListen == 0 ? false : true;
    let checkPassed = Equals(value, b);
    return checkPassed;
  }
}

