class TVControllerPS extends MediaDeviceControllerPS {
  protected persistent let m_tvSetup: TVSetup;
  protected let m_defaultGlitchVideoPath: ResRef;
  protected let m_broadcastGlitchVideoPath: ResRef;
  private let m_globalTVInitialized: Bool;
  private let m_backupCustomChannels: [STvChannel];

  protected cb func OnInstantiated() -> Bool {
    super.OnInstantiated();
    if !IsStringValid(this.m_deviceName) {
      this.m_deviceName = "Gameplay-Devices-DisplayNames-TV";
    }
  }

  protected func GameAttached() {
    this.InitializeTv();
  }

  private final func InitializeTv() {
    if !this.IsGlobalTvOnly() && this.HasBackupedCustomChannels() {
      this.m_tvSetup.m_channels = this.m_backupCustomChannels;
    }
    this.InitializeGlobalTV();
    this.m_amountOfStations = ArraySize(this.m_tvSetup.m_channels);
    this.m_activeChannelName = this.m_tvSetup.m_channels[this.GetActiveStationIndex()].channelName;
    this.SetInteractionState(this.m_tvSetup.m_isInteractive);
  }

  public const final func IsInterfaceMuted() -> Bool {
    return this.m_tvSetup.m_muteInterface;
  }

  public final func SetInterfaceMuted(mute: Bool) {
    this.m_tvSetup.m_muteInterface = mute;
  }

  public final func SetIsInteractive(isInteractive: Bool) {
    this.m_tvSetup.m_isInteractive = isInteractive;
  }

  public const final func GetDefaultGlitchVideoPath() -> ResRef {
    if ResRef.IsValid(this.m_defaultGlitchVideoPath) {
      return this.m_defaultGlitchVideoPath;
    }
    return r"base\\movies\\misc\\generic_noise_white.bk2";
  }

  public const final func GetBroadcastGlitchVideoPath() -> ResRef {
    if ResRef.IsValid(this.m_broadcastGlitchVideoPath) {
      return this.m_broadcastGlitchVideoPath;
    }
    return r"base\\movies\\misc\\distraction_generic.bk2";
  }

  public const final func HasCustomChannels() -> Bool {
    let i = 0;
    while i < ArraySize(this.m_tvSetup.m_channels) {
      if !TDBID.IsValid(this.m_tvSetup.m_channels[i].channelTweakID) {
        return true;
      }
      i += 1;
    }
    return false;
  }

  public final func SetIsGlobalTvOnly(isGlobalTv: Bool) {
    if NotEquals(isGlobalTv, this.m_tvSetup.m_isGlobalTvOnly) {
      this.m_tvSetup.m_isGlobalTvOnly = isGlobalTv;
      this.m_globalTVInitialized = false;
      this.m_dataInitialized = false;
      this.InitializeTv();
    }
  }

  public const final func IsGlobalTvOnly() -> Bool {
    return this.m_tvSetup.m_isGlobalTvOnly;
  }

  public const final func GetGlobalTVChannels() -> [wref<ChannelData_Record>] {
    let channels: [wref<ChannelData_Record>];
    let tvRecord = TweakDBInterface.GetTVBaseRecord(this.m_tweakDBRecord);
    if IsDefined(tvRecord) {
      tvRecord.Channels(channels);
    }
    return channels;
  }

  public const final func GetAmmountOfGlobalTVChannels() -> Int32 {
    let channels = this.GetGlobalTVChannels();
    return ArraySize(channels);
  }

  private final func InitializeGlobalTV() -> Int32 {
    let channelData: STvChannel;
    if this.IsGlobalTvOnly() {
      this.BackupCustomChannels();
      ArrayClear(this.m_tvSetup.m_channels);
    } else if !TDBID.IsValid(this.m_tweakDBRecord) {
      this.InitializeRPGParams();
    }
    let channels = this.GetGlobalTVChannels();
    if this.m_globalTVInitialized {
      return ArraySize(channels);
    }
    let i = 0;
    while i < ArraySize(channels) {
      channelData.channelName = channels[i].LocalizedName();
      channelData.channelTweakID = channels[i].GetID();
      ArrayPush(this.m_tvSetup.m_channels, channelData);
      i += 1;
    }
    this.m_globalTVInitialized = true;
    return ArraySize(channels);
  }

  private final func BackupCustomChannels() {
    let i = 0;
    while i < ArraySize(this.m_tvSetup.m_channels) {
      if !TDBID.IsValid(this.m_tvSetup.m_channels[i].channelTweakID) {
        let currentChannel = this.m_tvSetup.m_channels[i];
        ArrayPush(this.m_backupCustomChannels, currentChannel);
      }
      i += 1;
    }
  }

  private const final func HasBackupedCustomChannels() -> Bool {
    return ArraySize(this.m_backupCustomChannels) > 0;
  }

  protected const func CanCreateAnyQuickHackActions() -> Bool {
    return true;
  }

  protected func GetQuickHackActions(out outActions: [DeviceAction], const context: script_ref<GetActionsContext>) {
    let currentAction: ScriptableDeviceAction;
    if GlitchScreen.IsDefaultConditionMet(this, context) {
      currentAction = this
        .ActionGlitchScreen(t"DeviceAction.GlitchScreenSuicide", t"QuickHack.SuicideHackBase");
      currentAction.SetDurationValue(this.GetDistractionDuration(currentAction));
      ArrayPush(outActions, currentAction);
      currentAction = this
        .ActionGlitchScreen(t"DeviceAction.GlitchScreenBlind", t"QuickHack.BlindHack");
      currentAction.SetDurationValue(this.GetDistractionDuration(currentAction));
      ArrayPush(outActions, currentAction);
      currentAction = this
        .ActionGlitchScreen(t"DeviceAction.GlitchScreenGrenade", t"QuickHack.GrenadeHackBase");
      currentAction.SetDurationValue(this.GetDistractionDuration(currentAction));
      ArrayPush(outActions, currentAction);
    } else if !GlitchScreen.IsDefaultConditionMet(this, context) {
      ScriptableDeviceComponentPS.SetActionsInactiveAll(outActions, "LocKey#7003");
    }
    currentAction = this.ActionQuickHackDistraction();
    currentAction.SetObjectActionID(t"DeviceAction.MalfunctionClassHack");
    currentAction.SetDurationValue(this.GetDistractionDuration(currentAction));
    currentAction
      .SetInactiveWithReason(ScriptableDeviceAction.IsDefaultConditionMet(this, context), "LocKey#7003");
    ArrayPush(outActions, currentAction);
    if this.IsGlitching() || this.IsDistracting() {
      ScriptableDeviceComponentPS.SetActionsInactiveAll(outActions, "LocKey#7004");
    }
    this.FinalizeGetQuickHackActions(outActions, context);
  }

  public func GetQuestActionByName(actionName: CName) -> DeviceAction {
    let action = super.GetQuestActionByName(actionName);
    if action == null {
      switch actionName {
        case n"QuestMuteSounds":
          action = this.ActionQuestMuteSounds(true);
          break;
        case n"QuestUnMuteSounds":
          action = this.ActionQuestMuteSounds(false);
          break;
        case n"QuestEnableInteractivity":
          action = this.ActionQuestToggleInteractivity(true);
          break;
        case n"QuestDisableInteractivity":
          action = this.ActionQuestToggleInteractivity(false);
          return action;
      }
    }
  }

  public func GetQuestActions(out outActions: [DeviceAction], const context: script_ref<GetActionsContext>) {
    super.GetQuestActions(outActions, context);
    ArrayPush(outActions, this.ActionQuestMuteSounds(true));
    ArrayPush(outActions, this.ActionQuestMuteSounds(false));
    ArrayPush(outActions, this.ActionQuestToggleInteractivity(true));
    ArrayPush(outActions, this.ActionQuestToggleInteractivity(false));
  }

  public func OnQuestDefaultStation(evt: QuestDefaultStation) -> EntityNotificationType {
    this.m_activeStation = this.EstablishInitialActiveChannelIndex();
    this.m_activeChannelName = this.m_tvSetup.m_channels[this.m_activeStation].channelName;
    this.UseNotifier(evt);
    return EntityNotificationType.SendThisEventToEntity;
  }

  public func GetActiveStationIndex() -> Int32 {
    if !this.m_dataInitialized {
      this.m_dataInitialized = true;
      this.m_previousStation = -1;
      this.m_activeStation = this.EstablishInitialActiveChannelIndex();
    }
    return this.m_activeStation;
  }

  private final func EstablishInitialActiveChannelIndex() -> Int32 {
    let idx: Int32;
    if !this.m_globalTVInitialized {
      this.InitializeGlobalTV();
    } else if TDBID.IsValid(this.m_tvSetup.m_initialGlobalTvChannel) {
      idx = this.GetGlobalTVChannelIDX(this.m_tvSetup.m_initialGlobalTvChannel);
    } else if this.HasCustomChannels() {
      idx = this.m_tvSetup.m_initialChannel;
    }
    let globalTVChannelsCount = this.GetAmmountOfGlobalTVChannels();
    if globalTVChannelsCount > 0 {
      idx = RandRange(0, globalTVChannelsCount);
    }
    return idx;
  }

  public const final func GetGlobalTVChannelIDX(id: TweakDBID) -> Int32 {
    let i = 0;
    while i < ArraySize(this.m_tvSetup.m_channels) {
      if this.m_tvSetup.m_channels[i].channelTweakID == id {
        return i;
      }
      i += 1;
    }
    return -1;
  }

  private const final func GetActiveChannelVideoPath() -> ResRef {
    let channelData = this.GetChannelData(this.m_activeStation);
    return channelData.videoPath;
  }

  private const final func GetActiveChannelTweakDBID() -> TweakDBID {
    let channelData = this.GetChannelData(this.m_activeStation);
    return channelData.channelTweakID;
  }

  private const final func GlobalTVChannelIDToEnum(id: TweakDBID) -> ETVChannel {
    let channel: ETVChannel;
    switch id {
      case t"Channels.CH1":
        channel = ETVChannel.CH1;
        break;
      case t"Channels.CH2":
        channel = ETVChannel.CH2;
        break;
      case t"Channels.CH3":
        channel = ETVChannel.CH3;
        break;
      case t"Channels.CH4":
        channel = ETVChannel.CH4;
        break;
      case t"Channels.CH5":
        channel = ETVChannel.CH5;
        break;
      default:
        channel = ETVChannel.INVALID;
        return channel;
    }
  }

  private const final func GlobalTVChannelIDToInt(id: TweakDBID) -> Int32 {
    let channel: Int32;
    switch id {
      case t"Channels.CH1":
        channel = 1;
        break;
      case t"Channels.CH2":
        channel = 2;
        break;
      case t"Channels.CH3":
        channel = 3;
        break;
      case t"Channels.CH4":
        channel = 4;
        break;
      case t"Channels.CH5":
        channel = 5;
        break;
      default:
        channel = -1;
        return channel;
    }
  }

  public const final func GetChannelName(index: Int32) -> String {
    if index < 0 {
      return "";
    }
    return this.m_tvSetup.m_channels[index].channelName;
  }

  public const final func GetChannelID(const channelName: script_ref<String>) -> Int32 {
    let i = 0;
    while i < ArraySize(this.m_tvSetup.m_channels) {
      if Equals(this.m_tvSetup.m_channels[i].channelName, channelName) {
        return i;
      }
      i += 1;
    }
    return -1;
  }

  public const final func GetChannelData(channelIndex: Int32) -> STvChannel {
    let invalidChannel: STvChannel;
    if channelIndex < 0 || channelIndex > ArraySize(this.m_tvSetup.m_channels) - 1 {
      return invalidChannel;
    }
    return this.m_tvSetup.m_channels[channelIndex];
  }

  protected func DetermineGameplayViability(const context: script_ref<GetActionsContext>, hasActiveActions: Bool) -> Bool {
    return TVViabilityInterpreter.Evaluate(this, hasActiveActions);
  }

  public func GetDeviceIconPath() -> String {
    return "base/gameplay/gui/brushes/devices/icon_tv.widgetbrush";
  }

  protected func GetInkWidgetTweakDBID(const context: script_ref<GetActionsContext>) -> TweakDBID {
    if !this.IsUserAuthorized(context.processInitiatorObject.GetEntityID()) && !context.ignoresAuthorization {
      return super.GetInkWidgetTweakDBID(context);
    }
    return t"DevicesUIDefinitions.TvDeviceWidget";
  }

  public func GetDeviceWidget(const context: script_ref<GetActionsContext>) -> SDeviceWidgetPackage {
    let widgetData = super.GetDeviceWidget(context);
    if this.IsON() {
      let channel = this.GetChannelData(this.m_activeStation);
      let customData = new TvDeviceWidgetCustomData();
      customData.videoPath = this.GetActiveChannelVideoPath();
      customData.channelID = this.GetActiveChannelTweakDBID();
      customData.looped = channel.looped;
      customData.messageRecordID = channel.m_messageRecordID;
      widgetData.customData = customData;
      widgetData.textData = this.GetDeviceStatusTextData();
      widgetData.deviceStatus = "LocKey#42211";
    }
    return widgetData;
  }

  public const func GetBlackboardDef() -> TVDeviceBlackboardDef {
    return GetAllBlackboardDefs().TVDeviceBlackboard;
  }

  public const func IsInteractive() -> Bool {
    return this.m_tvSetup.m_isInteractive && super.IsInteractive();
  }

  public final func PushResaveData(data: TVResaveData);

  protected func GetDeviceIconTweakDBID() -> TweakDBID {
    return t"DeviceIcons.ScreenDeviceIcon";
  }

  protected func GetBackgroundTextureTweakDBID() -> TweakDBID {
    return t"DeviceIcons.ScreenDeviceBackground";
  }

  protected final func ActionQuestMuteSounds(mute: Bool) -> QuestMuteSounds {
    let action = new QuestMuteSounds();
    action.SetUp(this);
    action.SetProperties(mute);
    action.AddDeviceName(this.m_deviceName);
    return action;
  }

  public func OnQuestMuteSounds(evt: QuestMuteSounds) -> EntityNotificationType {
    this.SetInterfaceMuted(FromVariant<Bool>(evt.prop.first));
    if !IsFinal() {
    }
    return EntityNotificationType.SendThisEventToEntity;
  }

  protected final func ActionQuestToggleInteractivity(enable: Bool) -> QuestToggleInteractivity {
    let action = new QuestToggleInteractivity();
    action.SetUp(this);
    action.SetProperties(enable);
    action.AddDeviceName(this.m_deviceName);
    return action;
  }

  public func OnQuestToggleInteractivity(evt: QuestToggleInteractivity) -> EntityNotificationType {
    this.SetIsInteractive(FromVariant<Bool>(evt.prop.first));
    this.UseNotifier(evt);
    if !IsFinal() {
    }
    return EntityNotificationType.SendThisEventToEntity;
  }

  public const final func IsGlobalTVChannelActive(channel: Int32) -> Bool {
    let channelID = this.GetActiveChannelTweakDBID();
    if !TDBID.IsValid(channelID) {
      return false;
    }
    let activeChannel = this.GlobalTVChannelIDToInt(channelID);
    return activeChannel == channel;
  }
}

