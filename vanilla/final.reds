    let critChance = RPGManager
      .CalculateStatModifiers(
        this.m_applicationChanceMods,
        owner.GetGame(),
        owner,
        Cast<StatsObjectID>(owner.GetEntityID())
      );
    hitEvent.attackData.SetAdditionalCritChance(critChance);
  }
}

