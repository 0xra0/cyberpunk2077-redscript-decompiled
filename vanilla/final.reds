class GameplaySettingsSystem extends ScriptableSystem {
  private persistent let m_gameplaySettingsListener: GameplaySettingsListener;
  private persistent let m_wasEverJohnny: Bool;

  private final func OnPlayerAttach(request: PlayerAttachRequest) {
    let player = request.owner as PlayerPuppet;
    if IsDefined(player) {
      this.m_gameplaySettingsListener = new GameplaySettingsListener();
      this.m_gameplaySettingsListener.Initialize(player);
    }
  }

  private func OnRestored(saveVersion: Int32, gameVersion: Int32) {
    let player = GameInstance.GetPlayerSystem(this.GetGameInstance()).GetLocalPlayerControlledGameObject() as PlayerPuppet;
    if IsDefined(player) {
      this.m_gameplaySettingsListener = new GameplaySettingsListener();
      this.m_gameplaySettingsListener.Initialize(player);
    }
  }

  private final func OnPlayerDetach(request: PlayerDetachRequest);

  public final static func GetGameplaySettingsSystemInstance(owner: GameObject) -> GameplaySettingsSystem {
    return GameInstance
      .GetScriptableSystemsContainer(owner.GetGame())
      .Get(n"GameplaySettingsSystem") as GameplaySettingsSystem;
  }

  public final static func GetAdditiveCameraMovementsSetting(owner: GameObject) -> Float {
    return GameplaySettingsSystem
      .GetGameplaySettingsSystemInstance(owner)
      .m_gameplaySettingsListener
      .m_additiveCameraMovements;
  }

  public final static func GetIsFastForwardByLine(owner: GameObject) -> Bool {
    return GameplaySettingsSystem
      .GetGameplaySettingsSystemInstance(owner)
      .m_gameplaySettingsListener
      .m_isFastForwardByLine;
  }

  public final static func GetMovementDodgeEnabled(owner: GameObject) -> Bool {
    return GameplaySettingsSystem
      .GetGameplaySettingsSystemInstance(owner)
      .m_gameplaySettingsListener
      .m_movementDodgeEnabled;
  }

  public final static func GetVehicleCombatHoldToShootEnabled(owner: GameObject) -> Bool {
    return GameplaySettingsSystem
      .GetGameplaySettingsSystemInstance(owner)
      .m_gameplaySettingsListener
      .m_vehicleCombatHoldToShootEnabled;
  }

  public final static func WasEverJohnny(owner: GameObject) -> Bool {
    return GameplaySettingsSystem.GetGameplaySettingsSystemInstance(owner).m_wasEverJohnny;
  }

  public final static func SetWasEverJohnny(owner: GameObject, value: Bool) {
    GameplaySettingsSystem.GetGameplaySettingsSystemInstance(owner).SetWasEverJohnny(value);
  }

  public const final func GetIsFastForwardByLine() -> Bool {
    return this.m_gameplaySettingsListener.m_isFastForwardByLine;
  }

  public const final func GetIsInputHintEnabled() -> Bool {
    return this.m_gameplaySettingsListener.m_InputHintsEnabled;
  }

  private final func SetWasEverJohnny(value: Bool) {
    this.m_wasEverJohnny = value;
  }
}

class GameplaySettingsListener extends ConfigVarListener {
  private let m_player: wref<PlayerPuppet>;
  private let m_userSettings: UserSettings;
  private let m_diffSettingsGroup: ConfigGroup;
  private let m_miscSettingsGroup: ConfigGroup;
  private let m_controlsGroup: ConfigGroup;
  private let m_vehicleControlsGroup: ConfigGroup;
  private let m_hudGroup: ConfigGroup;
  public let m_additiveCameraMovements: Float;
  public let m_isFastForwardByLine: Bool;
  public let m_InputHintsEnabled: Bool;
  public let m_movementDodgeEnabled: Bool;
  public let m_vehicleCombatHoldToShootEnabled: Bool;
  private let m_difficultyPath: CName;
  private let m_miscPath: CName;
  private let m_controlsPath: CName;
  private let m_vehicleControlsPath: CName;
  private let m_hudPath: CName;
  private let m_additiveCameraOptionName: CName;
  private let m_fastForwardOptionName: CName;
  private let m_inputHintsOptionName: CName;
  private let m_movementDodgeOptionName: CName;
  private let m_vehicleCombatHoldToShootOptionName: CName;

  public final func Initialize(player: wref<PlayerPuppet>) {
    this.m_player = player;
    this.m_userSettings = GameInstance.GetSettingsSystem(this.m_player.GetGame());
    this.m_diffSettingsGroup = this.m_userSettings.GetGroup(this.m_difficultyPath);
    this.m_miscSettingsGroup = this.m_userSettings.GetGroup(this.m_miscPath);
    this.m_controlsGroup = this.m_userSettings.GetGroup(this.m_controlsPath);
    this.m_vehicleControlsGroup = this.m_userSettings.GetGroup(this.m_vehicleControlsPath);
    this.m_hudGroup = this.m_userSettings.GetGroup(this.m_hudPath);
    this.Register(this.m_difficultyPath);
    this.Register(this.m_miscPath);
    this.Register(this.m_controlsPath);
    this.Register(this.m_vehicleControlsPath);
    this.Register(this.m_hudPath);
    this.UpdateInputHintsEnabled();
    this.RefreshAdditiveCameraMovementsSetting();
    this.UpdateFFSetting();
    this.UpdateMovementDodgeSettings();
    this.UpdateVehicleCombatHoldToShootSettings();
    if IsDefined(this.m_player) {
      this.m_player.OnAdditiveCameraMovementsSettingChanged();
      this.RestoreJohnnyRelatedState();
    }
  }

  public func OnVarModified(
    groupPath: CName,
    varName: CName,
    varType: ConfigVarType,
    reason: ConfigChangeReason
  ) {
    if NotEquals(reason, ConfigChangeReason.Accepted) {
      return;
    }
    switch varName {
      case this.m_inputHintsOptionName:
        this.UpdateInputHintsEnabled();
        break;
      case this.m_additiveCameraOptionName:
        this.RefreshAdditiveCameraMovementsSetting();
        this.m_player.OnAdditiveCameraMovementsSettingChanged();
        break;
      case this.m_fastForwardOptionName:
        this.UpdateFFSetting();
        break;
      case this.m_movementDodgeOptionName:
        this.UpdateMovementDodgeSettings();
        break;
      case this.m_vehicleCombatHoldToShootOptionName:
        this.UpdateVehicleCombatHoldToShootSettings();
        break;
    }
  }

  private final func UpdateInputHintsEnabled() {
    if IsDefined(this.m_hudGroup) {
      let settingsVar = this.m_hudGroup.GetVar(this.m_inputHintsOptionName) as ConfigVarBool;
      if IsDefined(settingsVar) {
        this.m_InputHintsEnabled = settingsVar.GetValue();
      }
    }
  }

  private final func RefreshAdditiveCameraMovementsSetting() {
    if IsDefined(this.m_diffSettingsGroup) {
      let additiveCameraMovementsVar = this.m_diffSettingsGroup.GetVar(this.m_additiveCameraOptionName) as ConfigVarListFloat;
      if IsDefined(additiveCameraMovementsVar) {
        this.m_additiveCameraMovements = additiveCameraMovementsVar.GetValue();
      }
    }
  }

  private final func RestoreJohnnyRelatedState() {
    if GameplaySettingsSystem.WasEverJohnny(this.m_player) {
      let johnnyHUDVar = this.m_userSettings.GetVar(n"/interface/hud", n"johnny_hud");
      johnnyHUDVar.SetVisible(true);
    }
  }

  private final func UpdateFFSetting() {
    if IsDefined(this.m_miscSettingsGroup) {
      let FFSettingsVar = this.m_miscSettingsGroup.GetVar(this.m_fastForwardOptionName) as ConfigVarListString;
      this.m_isFastForwardByLine = FFSettingsVar.GetIndex() == 0;
    }
  }

  private final func UpdateMovementDodgeSettings() {
    if IsDefined(this.m_controlsGroup) && this.m_controlsGroup.HasVar(this.m_movementDodgeOptionName) {
      let controlsSettingsVar = this.m_controlsGroup.GetVar(this.m_movementDodgeOptionName) as ConfigVarBool;
      this.m_movementDodgeEnabled = controlsSettingsVar.GetValue();
    } else {
      this.m_movementDodgeEnabled = true;
    }
  }

  private final func UpdateVehicleCombatHoldToShootSettings() {
    if IsDefined(this.m_vehicleControlsGroup)
      && this.m_vehicleControlsGroup.HasVar(this.m_vehicleCombatHoldToShootOptionName) {
      let configVar = this.m_vehicleControlsGroup.GetVar(this.m_vehicleCombatHoldToShootOptionName) as ConfigVarBool;
      this.m_vehicleCombatHoldToShootEnabled = configVar.GetValue();
    } else {
      this.m_vehicleCombatHoldToShootEnabled = false;
    }
  }
}

