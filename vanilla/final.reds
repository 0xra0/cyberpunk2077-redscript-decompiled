class instrumentPanelLogicController extends IVehicleModuleController {
  private let m_lightStateImageWidget: inkImageRef;
  private let m_cautionStateImageWidget: inkImageRef;
  private let m_lightStateBBConnectionId: CallbackHandle;
  private let m_cautionStateBBConnectionId: CallbackHandle;
  private let m_vehBB: wref<IBlackboard>;

  public func RegisterCallbacks(
    vehicle: wref<VehicleObject>,
    vehBB: wref<IBlackboard>,
    gameController: wref<vehicleUIGameController>
  ) {
    if IsDefined(vehBB) {
      if !IsDefined(this.m_lightStateBBConnectionId) {
        this.m_lightStateBBConnectionId = vehBB
          .RegisterListenerInt(
            GetAllBlackboardDefs().Vehicle.HeadLightMode,
            this,
            n"OnHeadLightModeChanged"
          );
      } else if !IsDefined(this.m_cautionStateBBConnectionId) {
        this.m_cautionStateBBConnectionId = vehBB
          .RegisterListenerInt(
            GetAllBlackboardDefs().Vehicle.DamageState,
            this,
            n"OnCautionStateChanged"
          );
      }
      this.m_vehBB = vehBB;
      this.ForceUpdate();
    }
  }

  public func UnregisterCallbacks() {
    if IsDefined(this.m_vehBB) {
      if IsDefined(this.m_lightStateBBConnectionId) {
        this
          .m_vehBB
          .UnregisterListenerInt(
            GetAllBlackboardDefs().Vehicle.HeadLightMode,
            this.m_lightStateBBConnectionId
          );
      } else if IsDefined(this.m_cautionStateBBConnectionId) {
        this
          .m_vehBB
          .UnregisterListenerInt(
            GetAllBlackboardDefs().Vehicle.DamageState,
            this.m_cautionStateBBConnectionId
          );
      }
    }
  }

  protected cb func OnUninitialize() -> Bool {
    if IsDefined(this.m_vehBB) {
      if IsDefined(this.m_lightStateBBConnectionId) {
        this
          .m_vehBB
          .UnregisterListenerInt(
            GetAllBlackboardDefs().Vehicle.HeadLightMode,
            this.m_lightStateBBConnectionId
          );
      } else if IsDefined(this.m_cautionStateBBConnectionId) {
        this
          .m_vehBB
          .UnregisterListenerInt(
            GetAllBlackboardDefs().Vehicle.DamageState,
            this.m_cautionStateBBConnectionId
          );
      }
    }
  }

  protected final func ForceUpdate() {
    this
      .OnHeadLightModeChanged(this.m_vehBB.GetInt(GetAllBlackboardDefs().Vehicle.HeadLightMode));
    this
      .OnCautionStateChanged(this.m_vehBB.GetInt(GetAllBlackboardDefs().Vehicle.DamageState));
  }

  public final func OnHeadLightModeChanged(state: Int32) {
    if state == 0 {
      inkWidgetRef.SetOpacity(this.m_lightStateImageWidget, 0.0);
    } else if state == 1 {
      inkWidgetRef.SetOpacity(this.m_lightStateImageWidget, 0.5);
    } else if state == 2 {
      inkWidgetRef.SetOpacity(this.m_lightStateImageWidget, 1.0);
    }
  }

  public final func OnCautionStateChanged(state: Int32) {
    if state == 2 {
      inkWidgetRef.SetOpacity(this.m_cautionStateImageWidget, 1.0);
    }
  }
}

