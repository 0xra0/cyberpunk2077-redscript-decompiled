class Attack_Beam extends Attack_Continuous {
  public func OnTick(weapon: WeaponObject) {
    if IsDefined(weapon) {
      let beamEffect = this.GetRunningContinuousEffect();
      if IsDefined(beamEffect) {
        EffectData
          .SetVector(
            beamEffect.GetSharedData(),
            GetAllBlackboardDefs().EffectSharedData.position,
            weapon.GetWorldPosition()
          );
        EffectData
          .SetVector(
            beamEffect.GetSharedData(),
            GetAllBlackboardDefs().EffectSharedData.forward,
            weapon.GetWorldForward()
          );
        EffectData
          .SetFloat(
            beamEffect.GetSharedData(),
            GetAllBlackboardDefs().EffectSharedData.minRayAngleDiff,
            2.0
          );
      }
    }
  }
}

class LaserSight extends Attack_Beam {
  private let previousTarget: wref<Entity>;

  public func OnTick(weapon: WeaponObject) {
    let targetComponentVariant: Variant;
    super.OnTick(weapon);
    if IsDefined(weapon) {
      let beamEffect = this.GetRunningContinuousEffect();
      if IsDefined(beamEffect) {
        EffectData
          .GetVariant(
            beamEffect.GetSharedData(),
            GetAllBlackboardDefs().EffectSharedData.targetComponent,
            targetComponentVariant
          );
        if IsDefined(targetComponentVariant) {
          let targetComponent = FromVariant<wref<IPlacedComponent>>(targetComponentVariant);
        } else if IsDefined(targetComponent) {
          let target = targetComponent.GetEntity();
        }
        this.HandleTargetEvents(weapon, target);
      }
    }
  }

  public func OnStop(weapon: WeaponObject) {
    this.HandleTargetEvents(weapon, null);
  }

  private final func HandleTargetEvents(weapon: WeaponObject, target: wref<Entity>) {
    let evt: BeingTargetByLaserSightUpdateEvent;
    if IsDefined(this.previousTarget) && this.previousTarget != target {
      evt = new BeingTargetByLaserSightUpdateEvent();
      evt.weapon = weapon;
      evt.state = LaserTargettingState.End;
      this.previousTarget.QueueEvent(evt);
    } else if IsDefined(target) {
      evt = new BeingTargetByLaserSightUpdateEvent();
      evt.weapon = weapon;
      if this.previousTarget != target {
        evt.state = LaserTargettingState.Start;
      }
      evt.state = LaserTargettingState.Update;
      target.QueueEvent(evt);
    }
    this.previousTarget = target;
  }
}

