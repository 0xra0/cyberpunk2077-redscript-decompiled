    if IsDefined(this.actionTweakIDMapping) {
      this.value = FromVariant<Vector4>(ScriptExecutionContext.GetMappingValue(context, this.actionTweakIDMapping));
      if Vector4.IsZero(this.value) {
        return AIbehaviorConditionOutcomes.False;
      }
    }
    return AIbehaviorConditionOutcomes.True;
  }
}

