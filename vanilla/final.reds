abstract class AISubActionStartCooldown_Record_Implementation extends IScriptable {
  public final static func Activate(context: ScriptExecutionContext, record: wref<AISubActionStartCooldown_Record>) {
    if record.Delay() == 0.0 {
      AISubActionStartCooldown_Record_Implementation.StartCooldowns(context, record);
    }
  }

  public final static func Update(
    context: ScriptExecutionContext,
    record: wref<AISubActionStartCooldown_Record>,
    const duration: Float
  ) -> AIbehaviorUpdateOutcome {
    if record.Delay() <= 0.0 {
      return AIbehaviorUpdateOutcome.SUCCESS;
    } else if record.MinActionDuration() > 0.0 && record.MinActionDuration() > duration {
      return AIbehaviorUpdateOutcome.IN_PROGRESS;
    } else if record.Delay() > 0.0 && duration >= record.Delay() {
      AISubActionStartCooldown_Record_Implementation.StartCooldowns(context, record);
      return AIbehaviorUpdateOutcome.SUCCESS;
    }
    return AIbehaviorUpdateOutcome.IN_PROGRESS;
  }

  public final static func Deactivate(
    context: ScriptExecutionContext,
    record: wref<AISubActionStartCooldown_Record>,
    const duration: Float,
    interrupted: Bool
  ) {
    if record.MinActionDuration() > 0.0 && record.MinActionDuration() > duration {
      return;
    } else if record.Delay() < 0.0 {
      AISubActionStartCooldown_Record_Implementation.StartCooldowns(context, record);
    }
  }

  public final static func StartCooldowns(context: ScriptExecutionContext, record: AISubActionStartCooldown_Record) {
    let count = record.GetCooldownsCount();
    if count > 0 {
      let puppet = ScriptExecutionContext.GetOwner(context);
      let i = 0;
      while i < count {
        AIActionHelper.StartCooldown(puppet, record.GetCooldownsItem(i));
        i += 1;
      }
    }
  }
}

importonly native class AISubActionStartCooldown_Record extends AISubAction_Record {
  public final native func Cooldowns(out outList: [wref<AIActionCooldown_Record>]);

  public final native func GetCooldownsCount() -> Int32;

  public final native func GetCooldownsItem(index: Int32) -> wref<AIActionCooldown_Record>;

  public final native func GetCooldownsItemHandle(index: Int32) -> AIActionCooldown_Record;

  public final native func CooldownsContains(item: wref<AIActionCooldown_Record>) -> Bool;

  public final native func Delay() -> Float;

  public final native func MinActionDuration() -> Float;
}

abstract class AISubActionSquadSync_Record_Implementation extends IScriptable {
  public final static func Activate(context: ScriptExecutionContext, record: wref<AISubActionSquadSync_Record>) {
    AISubActionSquadSync_Record_Implementation.SquadSync(context, record);
  }

  public final static func Update(
    context: ScriptExecutionContext,
    record: wref<AISubActionSquadSync_Record>,
    const duration: Float
  ) -> AIbehaviorUpdateOutcome {
    return AIbehaviorUpdateOutcome.SUCCESS;
  }

  public final static func Deactivate(
    context: ScriptExecutionContext,
    record: wref<AISubActionSquadSync_Record>,
    const duration: Float,
    interrupted: Bool
  ) {
    AISubActionSquadSync_Record_Implementation.SquadSync(context, record);
  }

  public final static func SquadSync(context: ScriptExecutionContext, record: wref<AISubActionSquadSync_Record>) {
    let puppet = ScriptExecutionContext.GetOwner(context) as ScriptedPuppet;
    if !IsDefined(puppet) {
      return;
    }
    let squadType = AISquadType.Combat;
    if !StatusEffectSystem
      .ObjectHasStatusEffectWithTag(ScriptExecutionContext.GetOwner(context), n"ResetSquadSync") {
      if record.Pull() {
        AISquadHelper.PullSquadSync(puppet, squadType);
      } else {
        puppet.GetTargetTrackerComponent().PushSquadSync(squadType);
      }
    }
  }
}

