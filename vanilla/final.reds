  public final static func RequestRevealOutline(obj: GameObject, doReveal: Bool, whoWantsToReveal: EntityID) {
    if !IsDefined(obj) {
      return;
    }
    let evt = new RevealRequestEvent();
    evt.CreateRequest(doReveal, whoWantsToReveal);
    obj.QueueEvent(evt);
  }

  protected cb func OnRevealRequest(evt: RevealRequestEvent) -> Bool {
    this.RequestRevealOutline(evt.GetShouldReveal(), evt.GetRequester());
    if Equals(evt.GetShouldReveal(), true) && evt.IsOneFrame() {
      let toggleEvt = new RevealRequestEvent();
      toggleEvt.CreateRequest(false, evt.GetRequester());
      this.QueueEvent(toggleEvt);
    }
  }

  private final func RequestRevealOutline(shouldIncreaseCounter: Bool, requester: EntityID) {
    if !EntityID.IsDefined(requester) {
      return;
    } else if !ScriptedPuppet.IsAlive(this) && !ScriptedPuppet.IsDefeated(this) {
      return;
    } else if !IsDefined(this.m_shouldBeRevealedStorage) {
      this.m_shouldBeRevealedStorage = new RevealRequestsStorage();
    } else if this
      .m_shouldBeRevealedStorage
      .IsRequesterLegal(requester, shouldIncreaseCounter) {
      this
        .m_shouldBeRevealedStorage
        .RegisterLegalRequest(requester, shouldIncreaseCounter);
    }
    let i = 0;
    while i < ArraySize(this.m_listeners) {
      this
        .m_listeners[i]
        .OnRevealedStateChanged(this.m_shouldBeRevealedStorage.ShouldReveal());
      i += 1;
    }
  }

  public final func ForceVisionAppearanceNetrunner(target: GameObject, sourceID: EntityID, sourceName: CName, toggle: Bool) {
    let visionEvt = new ForceVisionApperanceEvent();
    let data = new FocusForcedHighlightData();
    data.sourceID = sourceID;
    data.sourceName = sourceName;
    data.outlineType = EFocusOutlineType.ENEMY_NETRUNNER;
    data.highlightType = EFocusForcedHighlightType.ENEMY_NETRUNNER;
    data.priority = EPriority.High;
    data.isRevealed = true;
    data.patternType = VisionModePatternType.Netrunner;
    visionEvt.forcedHighlight = data;
    visionEvt.apply = toggle;
    target.QueueEvent(visionEvt);
    if toggle {
      target.m_scanningComponent.SetScannableThroughWallsIfPossible();
    } else {
      target.m_scanningComponent.SetScannableThroughWalls(false);
    }
  }

