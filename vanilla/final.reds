class DestroyBreachEffector extends Effector {
  protected func ActionOn(owner: GameObject) {
    let npc = owner as NPCPuppet;
    if !IsDefined(npc) {
      return;
    }
    let gi = npc.GetGame();
    if GameInstance
      .GetGodModeSystem(gi)
      .HasGodMode(npc.GetEntityID(), gameGodModeType.Invulnerable)
      || GameInstance
        .GetStatsSystem(gi)
        .GetStatValue(Cast<StatsObjectID>(npc.GetEntityID()), gamedataStatType.IsInvulnerable) > 0.0 {
      return;
    }
    let breachController = npc.GetBreachControllerComponent();
    if IsDefined(breachController) {
      breachController.DestroyPreviouslyTrackedBreach();
    }
  }
}

class ShowUIWarningEffector extends Effector {
  public let m_duration: Float;
  public let m_primaryText: String;
  public let m_secondaryText: String;
  public let m_owner: wref<GameObject>;

  protected func Initialize(record: TweakDBID, game: GameInstance, parentRecord: TweakDBID) {
    this.m_duration = TweakDBInterface.GetFloat(record + t".duration", 2.0);
    this.m_primaryText = TweakDBInterface.GetString(record + t".primaryText", "");
    this.m_secondaryText = TweakDBInterface.GetString(record + t".secondaryText", "");
  }

  protected func ActionOn(owner: GameObject) {
    let warningMsg: SimpleScreenMessage;
    let finalString = GetLocalizedText(this.m_primaryText) + " " + GetLocalizedText(this.m_secondaryText);
    warningMsg.isShown = true;
    warningMsg.duration = this.m_duration;
    warningMsg.message = finalString;
    GameInstance
      .GetBlackboardSystem(owner.GetGame())
      .Get(GetAllBlackboardDefs().UI_Notifications)
      .SetVariant(
        GetAllBlackboardDefs().UI_Notifications.WarningMessage,
        ToVariant(warningMsg),
        true
      );
  }
}

class PlayVFXEffector extends Effector {
  public let m_vfxName: CName;
  public let m_startOnUninitialize: Bool;
  public let m_fireAndForget: Bool;
  public let m_owner: wref<GameObject>;

  protected func Initialize(record: TweakDBID, game: GameInstance, parentRecord: TweakDBID) {
    this.m_vfxName = TweakDBInterface.GetCName(record + t".vfxName", n"None");
    this.m_startOnUninitialize = TweakDBInterface.GetBool(record + t".startOnUninitialize", false);
    this.m_fireAndForget = TweakDBInterface.GetBool(record + t".fireAndForget", false);
  }

  protected func ActionOn(owner: GameObject) {
    this.m_owner = owner;
    if !this.m_startOnUninitialize {
      GameObjectEffectHelper.StartEffectEvent(this.m_owner, this.m_vfxName);
    }
  }

  protected func ActionOff(owner: GameObject) {
    this.Deactivate();
  }

  protected func Uninitialize(game: GameInstance) {
    this.Deactivate();
  }

  protected func RepeatedAction(owner: GameObject) {
    if this.m_fireAndForget {
      this.ActionOn(owner);
    }
  }

  protected final func Deactivate() {
    if this.m_startOnUninitialize {
      GameObjectEffectHelper.StartEffectEvent(this.m_owner, this.m_vfxName);
    } else {
      GameObjectEffectHelper.BreakEffectLoopEvent(this.m_owner, this.m_vfxName);
    }
  }
}

