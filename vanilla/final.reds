class ProgressionWidgetGameController extends gameuiGenericNotificationGameController {
  private let m_duration: Float;
  private let m_playerDevelopmentSystem: PlayerDevelopmentSystem;
  private let m_combatModePSM: gamePSMCombat;
  private let m_combatModeListener: CallbackHandle;
  private let m_playerObject: wref<GameObject>;
  private let m_gameInstance: GameInstance;

  public func GetShouldSaveState() -> Bool {
    return true;
  }

  public func GetID() -> Int32 {
    return 5;
  }

  protected cb func OnPlayerAttach(playerPuppet: GameObject) -> Bool {
    this.m_playerObject = this.GetPlayerControlledObject();
    this.m_playerDevelopmentSystem = GameInstance
      .GetScriptableSystemsContainer(this.m_playerObject.GetGame())
      .Get(n"PlayerDevelopmentSystem") as PlayerDevelopmentSystem;
    this.RegisterPSMListeners(this.m_playerObject);
    this.m_gameInstance = this.GetPlayerControlledObject().GetGame();
    let controlledPuppet = GetPlayer(this.m_gameInstance);
    if controlledPuppet != null {
      let controlledPuppetRecordID = controlledPuppet.GetRecordID();
      if controlledPuppetRecordID == t"Character.johnny_replacer" {
        this.GetRootWidget().SetVisible(false);
      } else {
        this.GetRootWidget().SetVisible(true);
      }
    } else {
      this.GetRootWidget().SetVisible(true);
    }
  }

  protected cb func OnPlayerDetach(playerGameObject: GameObject) -> Bool {
    this.UnregisterPSMListeners(this.m_playerObject);
  }

  protected final func RegisterPSMListeners(playerObject: GameObject) {
    let playerSMDef = GetAllBlackboardDefs().PlayerStateMachine;
    if IsDefined(playerSMDef) {
      let playerStateMachineBlackboard = this.GetPSMBlackboard(playerObject);
      if IsDefined(playerStateMachineBlackboard) {
        this.m_combatModeListener = playerStateMachineBlackboard.RegisterListenerInt(playerSMDef.Combat, this, n"OnCombatStateChanged");
      }
    }
  }

  protected final func UnregisterPSMListeners(playerObject: GameObject) {
    let playerSMDef = GetAllBlackboardDefs().PlayerStateMachine;
    if IsDefined(playerSMDef) {
      let playerStateMachineBlackboard = this.GetPSMBlackboard(playerObject);
      if IsDefined(playerStateMachineBlackboard) {
        playerStateMachineBlackboard
          .UnregisterDelayedListener(playerSMDef.Combat, this.m_combatModeListener);
      }
    }
  }

  protected cb func OnCombatStateChanged(value: Int32) -> Bool {
    this.m_combatModePSM = IntEnum<gamePSMCombat>(value);
    if Equals(this.m_combatModePSM, gamePSMCombat.OutOfCombat) || Equals(this.m_combatModePSM, gamePSMCombat.Default) {
      this.SetNotificationPaused(false);
      this.GetRootWidget().SetVisible(true);
    } else {
      this.SetNotificationPaused(true);
      this.GetRootWidget().SetVisible(false);
    }
  }

