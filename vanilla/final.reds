native class HUDActor extends IScriptable {
  private let entityID: EntityID;
  private let type: HUDActorType;
  private let status: HUDActorStatus;
  private let visibility: ActorVisibilityStatus;
  private let activeModules: [wref<HUDModule>];
  private let isRevealed: Bool;
  private let isTagged: Bool;
  private let clueData: HUDClueData;
  private let isRemotelyAccessed: Bool;
  private let canOpenScannerInfo: Bool;
  private let isInIconForcedVisibilityRange: Bool;
  private let isIconForcedVisibleThroughWalls: Bool;
  private let shouldRefreshQHack: Bool;

  public final static func Construct(
    self: HUDActor,
    entityID: EntityID,
    type: HUDActorType,
    status: HUDActorStatus,
    visibility: ActorVisibilityStatus
  ) {
    self.entityID = entityID;
    self.type = type;
    self.status = status;
    self.visibility = visibility;
  }

  public final func UpdateActorData(updateData: HUDActorUpdateData) {
    if updateData == null {
      return;
    } else if updateData.updateVisibility {
      this.visibility = updateData.visibilityValue;
    } else if updateData.updateIsRevealed {
      this.isRevealed = updateData.isRevealedValue;
    } else if updateData.updateIsTagged {
      this.isTagged = updateData.isTaggedValue;
    } else if updateData.updateClueData {
      this.clueData = updateData.clueDataValue;
    } else if updateData.updateIsRemotelyAccessed {
      this.isRemotelyAccessed = updateData.isRemotelyAccessedValue;
    } else if updateData.updateCanOpenScannerInfo {
      this.canOpenScannerInfo = updateData.canOpenScannerInfoValue;
    } else if updateData.updateIsInIconForcedVisibilityRange {
      this.isInIconForcedVisibilityRange = updateData.isInIconForcedVisibilityRangeValue;
    } else if updateData.updateIsIconForcedVisibleThroughWalls {
      this.isIconForcedVisibleThroughWalls = updateData.isIconForcedVisibleThroughWallsValue;
    }
  }

  public final func AddModule(module: HUDModule) {
    let i = 0;
    while i < ArraySize(this.activeModules) {
      if this.activeModules[i] == module {
        return;
      }
      i += 1;
    }
    ArrayPush(this.activeModules, module);
  }

  public final func RemoveModule(module: HUDModule) {
    let i = 0;
    while i < ArraySize(this.activeModules) {
      if this.activeModules[i] == module {
        ArrayErase(this.activeModules, i);
        return;
      }
      i += 1;
    }
  }

  public final func SetStatus(newStatus: HUDActorStatus) {
    this.status = newStatus;
  }

  public final func SetRemotelyAccessed(value: Bool) {
    this.isRemotelyAccessed = value;
  }

  public final func SetRevealed(value: Bool) {
    this.isRevealed = value;
  }

  public final func SetTagged(value: Bool) {
    this.isTagged = value;
  }

  public final func SetClue(value: Bool) {
    this.clueData.isClue = value;
  }

  public final func SetClueGroup(value: CName) {
    this.clueData.clueGroupID = value;
  }

  public final func SetCanOpenScannerInfo(value: Bool) {
    this.canOpenScannerInfo = value;
