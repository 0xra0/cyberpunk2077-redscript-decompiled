class ZoomBlockedDecisions extends ZoomDecisionsTransition {
  public const final func EnterCondition(const stateContext: StateContext, const scriptInterface: StateGameScriptInterface) -> Bool {
    if stateContext.IsStateMachineActive(n"Vehicle")
      && scriptInterface.localBlackboard.GetInt(GetAllBlackboardDefs().PlayerStateMachine.Vehicle) != 6
      && scriptInterface
        .localBlackboard
        .GetInt(GetAllBlackboardDefs().PlayerStateMachine.HighLevel) != 3 {
      if !this.IsGenericDeviceOrFocusActive(stateContext, scriptInterface) && !this.IsInUpperBodyState(stateContext, n"aimingState") {
        return true;
      } else if Equals(stateContext.GetStateMachineCurrentState(n"Vehicle"), n"exiting") {
        return true;
      }
    }
    return false;
  }

  public const final func ExitCondition(const stateContext: StateContext, const scriptInterface: StateGameScriptInterface) -> Bool {
    return !this.EnterCondition(stateContext, scriptInterface);
  }
}

class SwimmingInitialDecisions extends LocomotionSwimming {
  protected const final func IsUnderwater(const stateContext: StateContext, const scriptInterface: StateGameScriptInterface) -> Bool {
    let depthTreshold = this.GetStaticFloatParameterDefault("skipTransitionDepthTreshold", 0.0);
    let currentDepth = this.GetCurrentDepth(stateContext, scriptInterface);
    return currentDepth <= depthTreshold;
  }

  protected const final func ToDiving(const stateContext: StateContext, const scriptInterface: StateGameScriptInterface) -> Bool {
    return this.IsUnderwater(stateContext, scriptInterface);
  }

  protected const final func ToSurface(const stateContext: StateContext, const scriptInterface: StateGameScriptInterface) -> Bool {
    return !this.IsUnderwater(stateContext, scriptInterface);
  }
}

class StrikeExecutor_Heal extends EffectExecutor_Scripted {
  private let healthPerc: Float;

  public final func Process(ctx: EffectScriptContext, applierCtx: EffectExecutionScriptContext) -> Bool {
    let puppet = EffectExecutionScriptContext.GetTarget(applierCtx) as ScriptedPuppet;
    let puppetID = Cast<StatsObjectID>(puppet.GetEntityID());
    if IsDefined(puppet) {
      GameInstance
        .GetStatPoolsSystem(puppet.GetGame())
        .RequestChangingStatPoolValue(puppetID, gamedataStatPoolType.Health, this.healthPerc, puppet, false);
      return true;
    }
    return false;
  }
}

