class HitAttackSubtypePrereqState extends GenericHitPrereqState {
  public func Evaluate(hitEvent: gameHitEvent) -> Bool {
    let prereq = this.GetPrereq() as HitAttackSubtypePrereq;
    if NotEquals(prereq.m_attackSubtype, gamedataAttackSubtype.Invalid) {
      if !IsDefined(hitEvent.attackData) {
        return false;
      } else if Equals(hitEvent.attackData.GetAttackSubtype(), prereq.m_attackSubtype) {
        return true;
      }
    }
    return false;
  }
}

