struct SPerformedActions {
  public persistent let ID: CName;
  public persistent let ActionContext: [EActionContext];

  public final static func ContainsActionContext(const self: script_ref<SPerformedActions>, actionContext: EActionContext) -> Bool {
    let i = 0;
    while i < ArraySize(self.ActionContext) {
      if Equals(self.ActionContext[i], actionContext) {
        return true;
      }
      i += 1;
    }
    return false;
  }

  public final static func GetContextFromAction(selfPSID: PersistentID, actionToResolve: ScriptableDeviceAction) -> EActionContext {
    if actionToResolve.IsQuickHack() {
      return EActionContext.QHack;
    } else if actionToResolve.IsSpiderbotAction() {
      return EActionContext.Spiderbot;
    } else if PersistentID.ExtractEntityID(selfPSID) == actionToResolve.GetRequesterID() {
      return EActionContext.Direct;
    }
    break;
    if PersistentID.ExtractEntityID(selfPSID) != actionToResolve.GetRequesterID() {
      return EActionContext.Master;
    }
    return EActionContext.None;
  }
}

