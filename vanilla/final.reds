class PlayVFXOnHitPositionEffector extends Effector {
  public let m_effectName: CName;
  public let m_effectTag: CName;
  public let m_applicationTarget: CName;

  protected func Initialize(record: TweakDBID, game: GameInstance, parentRecord: TweakDBID) {
    this.m_applicationTarget = TDB.GetCName(record + t".applicationTarget");
    this.m_effectName = TDB.GetCName(record + t".effectName");
    this.m_effectTag = TDB.GetCName(record + t".effectTag");
  }

  protected func ActionOn(owner: GameObject) {
    let target: wref<GameObject>;
    if !this.GetApplicationTarget(owner, this.m_applicationTarget, target) {
      return;
    }
    let pos = (this.GetPrereqState() as GenericHitPrereqState).GetHitEvent().hitPosition;
    let effect = GameInstance
      .GetGameEffectSystem(owner.GetGame())
      .CreateEffectStatic(this.m_effectName, this.m_effectTag, target);
    EffectData
      .SetVector(effect.GetSharedData(), GetAllBlackboardDefs().EffectSharedData.position, pos);
    EffectData
      .SetFloat(effect.GetSharedData(), GetAllBlackboardDefs().EffectSharedData.radius, 1.0);
    effect.Run();
  }

  protected func RepeatedAction(owner: GameObject) {
    this.ActionOn(owner);
  }
}

class GameplayFactCondition extends GameplayConditionBase {
  public let m_factName: CName;
  public let m_value: Int32;
  public let m_comparisonType: ECompareOp;
  public let m_description: String;

  public func Evaluate(requester: GameObject) -> Bool {
    let factValue = GameInstance.GetQuestsSystem(requester.GetGame()).GetFact(this.m_factName);
    return Compare(this.m_comparisonType, factValue, this.m_value);
  }

  public func GetDescription(requester: GameObject) -> Condition {
    let description: Condition;
    description.description = this.m_description;
    description.passed = this.Evaluate(requester);
    return description;
  }
}

public func Compare(comparator: ECompareOp, val1: Int32, val2: Int32) -> Bool {
  switch comparator {
    case ECompareOp.CO_Lesser:
      return val1 < val2;
    case ECompareOp.CO_LesserEq:
      return val1 <= val2;
    case ECompareOp.CO_Greater:
      return val1 > val2;
    case ECompareOp.CO_GreaterEq:
      return val1 >= val2;
    case ECompareOp.CO_Equal:
      return val1 == val2;
    case ECompareOp.CO_NotEqual:
      return val1 != val2;
  }
  return false;
}

