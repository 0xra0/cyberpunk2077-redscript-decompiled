class UnlockMinigameProgramEffector extends Effector {
  public let m_minigameProgram: MinigameProgramData;

  protected func Initialize(record: TweakDBID, game: GameInstance, parentRecord: TweakDBID) {
    let actionID = TDBID.Create(TweakDBInterface.GetString(record + t".networkAction", ""));
    this.m_minigameProgram.actionID = actionID;
    this.m_minigameProgram.programName = StringToName(
      LocKeyToString(TweakDBInterface
        .GetObjectActionRecord(actionID)
        .ObjectActionUI()
        .Caption())
    );
  }

  protected func ActionOn(owner: GameObject) {
    let player = owner as PlayerPuppet;
    if IsDefined(player) {
      this.StoreMinigameProgramsOnPlayer(this.m_minigameProgram, player, true);
    }
  }

  protected func Uninitialize(game: GameInstance) {
    let player = GetPlayer(game);
    if IsDefined(player) {
      this.StoreMinigameProgramsOnPlayer(this.m_minigameProgram, player, false);
    }
  }

  private final func StoreMinigameProgramsOnPlayer(program: MinigameProgramData, player: PlayerPuppet, addOrRemove: Bool) {
    let evt = new UpdateMiniGameProgramsEvent();
    evt.program = program;
    evt.add = addOrRemove;
    player.QueueEvent(evt);
  }
}

