class ItemSlotsFilledPrereq extends IScriptablePrereq {
  public let m_equipAreas: [gamedataEquipmentArea];

  protected func Initialize(recordID: TweakDBID) {
    let areas = TDB.GetCNameArray(recordID + t".equipAreas");
    let i = 0;
    while i < ArraySize(areas) {
      let equipArea = IntEnum<gamedataEquipmentArea>(Cast<Int32>(EnumValueFromName(n"gamedataEquipmentArea", areas[i])));
      ArrayPush(this.m_equipAreas, equipArea);
      i += 1;
    }
  }

  protected const func OnRegister(state: PrereqState, game: GameInstance, context: IScriptable) -> Bool {
    let castedState = state as ItemSlotsFilledPrereqState;
    let player = context as GameObject;
    if IsDefined(player) {
      castedState.m_owner = player;
      let equipmentBlackboard = GameInstance
        .GetBlackboardSystem(player.GetGame())
        .Get(GetAllBlackboardDefs().UI_Equipment);
      castedState.m_equipmentBlackboardCallback = equipmentBlackboard
        .RegisterListenerInt(
          GetAllBlackboardDefs().UI_Equipment.areaChanged,
          castedState,
          n"OnEquipAreaChanged"
        );
      castedState.m_equipAreas = this.m_equipAreas;
    }
    return false;
  }

  protected const func OnUnregister(state: PrereqState, game: GameInstance, context: IScriptable) {
    let castedState = state as ItemSlotsFilledPrereqState;
    let player = context as GameObject;
    if IsDefined(player) {
      let equipmentBlackboard = GameInstance
        .GetBlackboardSystem(player.GetGame())
        .Get(GetAllBlackboardDefs().UI_Equipment);
      if IsDefined(castedState.m_equipmentBlackboardCallback) {
        equipmentBlackboard
          .UnregisterListenerVariant(
            GetAllBlackboardDefs().UI_Equipment.itemEquipped,
            castedState.m_equipmentBlackboardCallback
          );
      }
    }
  }

  protected const func OnApplied(state: PrereqState, game: GameInstance, context: IScriptable) {
    let castedState = state as ItemSlotsFilledPrereqState;
    castedState.CheckEquipAreaSlots();
  }
}

