class GrappleStandDecisions extends LocomotionTakedownDecisions {
  public const let stateMachineInitData: wref<LocomotionTakedownInitData>;

  protected const final func ToTakedownExecuteTakedown(const stateContext: StateContext, const scriptInterface: StateGameScriptInterface) -> Bool {
    if this.IsTakedownAction(this.stateMachineInitData.actionName) {
      return true;
    } else if TakedownUtils.ShouldForceTakedown(scriptInterface) {
      return true;
    }
    return false;
  }

  protected const final func ToTakedownExecuteTakedownAndDispose(const stateContext: StateContext, const scriptInterface: StateGameScriptInterface) -> Bool {
    if this.IsTakedownAndDispose(scriptInterface) {
      return true;
    }
    return false;
  }

  protected const final func ToGrappleStruggle(const stateContext: StateContext, const scriptInterface: StateGameScriptInterface) -> Bool {
    if this.GetInStateTime() >= stateContext.GetFloatParameter(n"grappleTime", true) {
      return this.IsBreakingFreeAllowed(stateContext, scriptInterface);
    } else if this.IsDeepEnoughToSwim(scriptInterface) {
      return true;
    }
    return false;
  }

  protected const final func IsBreakingFreeAllowed(const stateContext: StateContext, const scriptInterface: StateGameScriptInterface) -> Bool {
    if StatusEffectSystem
      .ObjectHasStatusEffectWithTag(scriptInterface.executionOwner, n"GrappleNoBreakFree") {
      return false;
    }
    return true;
  }

  protected const final func ToGrappleBreakFree(const stateContext: StateContext, const scriptInterface: StateGameScriptInterface) -> Bool {
    if this.IsPowerLevelDifferentialTooHigh(this.stateMachineInitData.target)
      || NPCManager
        .HasTag((this.stateMachineInitData.target as NPCPuppet).GetRecordID(), n"MiniBoss")
      || NPCManager
        .HasTag(
          (this.stateMachineInitData.target as NPCPuppet).GetRecordID(),
          n"q305_maxtac"
        )
      || NPCManager
        .HasTag(
          (this.stateMachineInitData.target as NPCPuppet).GetRecordID(),
          n"MaxTac_Prevention"
        ) {
      return this.IsBreakingFreeAllowed(stateContext, scriptInterface);
    }
    return false;
  }

  protected const final func ToTakedownUnmountPrey(const stateContext: StateContext, const scriptInterface: StateGameScriptInterface) -> Bool {
    if scriptInterface.localBlackboard.GetInt(GetAllBlackboardDefs().PlayerStateMachine.Vitals) == 1 {
      return true;
    }
    return false;
  }
}

class sampleScreenProjectionGameController extends inkProjectedHUDGameController {
  private let m_OnTargetHitCallback: CallbackHandle;

  protected cb func OnInitialize() -> Bool {
    let blackboardSystem = this.GetBlackboardSystem();
    let blackboard = blackboardSystem.Get(GetAllBlackboardDefs().UI_ActiveWeaponData);
    this.m_OnTargetHitCallback = blackboard
      .RegisterListenerVariant(
        GetAllBlackboardDefs().UI_ActiveWeaponData.TargetHitEvent,
        this,
        n"OnTargetHit"
      );
  }

  protected cb func OnTargetHit(value: Variant) -> Bool {
    let screenProjectionData: inkScreenProjectionData;
    let targetHitData = FromVariant<gameTargetHitEvent>(value);
    let targetController = this.SpawnFromLocal(this.GetRootWidget(), n"Target").GetController() as sampleScreenProjectionLogicController;
    screenProjectionData.entity = targetHitData.target;
    screenProjectionData.slotComponentName = n"Item_Attachment_Slot";
    screenProjectionData.slotName = n"Head";
    screenProjectionData.fixedWorldOffset = new Vector4(0.0, 0.0, 0.5, 0.0);
    screenProjectionData.userData = targetController;
    let projection = this.RegisterScreenProjection(screenProjectionData);
    targetController.SetProjection(projection);
    targetController.RegisterToCallback(n"OnReadyToRemove", this, n"OnRemoveTarget");
  }

  protected cb func OnScreenProjectionUpdate(projections: gameuiScreenProjectionsData) -> Bool {
    let count = ArraySize(projections.data);
    let i = 0;
    while i < count {
      let projection = projections.data[i];
      let controller = projection.GetUserData() as sampleScreenProjectionLogicController;
      controller.UpdatewidgetPosition(projection);
      i += 1;
    }
  }

  protected cb func OnRemoveTarget(targetWidget: wref<inkWidget>) -> Bool {
    let targetController = targetWidget.GetController() as sampleScreenProjectionLogicController;
    this.UnregisterScreenProjection(targetController.GetProjection());
    let rootWidget = this.GetRootWidget() as inkCompoundWidget;
    rootWidget.RemoveChild(targetWidget);
  }
}

class sampleScreenProjectionLogicController extends inkLogicController {
  private let m_widgetPos: wref<inkText>;
  private let m_worldPos: wref<inkText>;
  private let m_projection: inkScreenProjection;

  protected cb func OnInitialize() -> Bool {
    this.GetRootWidget().SetAnchorPoint(new Vector2(0.5, 0.5));
    this.m_widgetPos = this.GetWidget(n"widgetPos") as inkText;
    this.m_worldPos = this.GetWidget(n"worldPos") as inkText;
    this.PlayAnimation();
  }

  public final func GetProjection() -> inkScreenProjection {
    return this.m_projection;
  }

  public final func SetProjection(projection: inkScreenProjection) {
    this.m_projection = projection;
  }

  public final func UpdatewidgetPosition(projection: inkScreenProjection) {
    let margin: inkMargin;
    let rootWidget = this.GetRootWidget();
    let gameEntity = projection.GetEntity() as GameEntity;
    let widgetPosition = projection.currentPosition;
    let worldPosition = gameEntity.GetWorldPosition() + projection.GetFixedWorldOffset();
    margin.left = widgetPosition.X;
    margin.top = widgetPosition.Y;
    rootWidget.SetMargin(margin);
    this
      .m_widgetPos
      .SetText("Screen: (" + widgetPosition.X + "," + widgetPosition.Y + ")");
    this
      .m_worldPos
      .SetText(
        "World: ("
          + worldPosition.X
          + ","
          + worldPosition.Y
          + ","
          + worldPosition.Z
          + ")"
      );
    rootWidget.SetVisible(projection.IsInScreen());
  }

  private final func PlayAnimation() {
    let anim = new inkAnimDef();
    let alphaInterpolator = new inkAnimTransparency();
    alphaInterpolator.SetStartTransparency(1.0);
    alphaInterpolator.SetEndTransparency(0.0);
    alphaInterpolator.SetDuration(3.0);
    alphaInterpolator.SetType(inkanimInterpolationType.Linear);
    alphaInterpolator.SetMode(inkanimInterpolationMode.EasyIn);
    anim.AddInterpolator(alphaInterpolator);
    let animProxy = this.GetRootWidget().PlayAnimation(anim);
    animProxy.RegisterToCallback(inkanimEventType.OnFinish, this, n"OnAnimFinished");
  }

  protected cb func OnAnimFinished(proxy: inkAnimProxy) -> Bool {
    this.CallCustomCallback(n"OnReadyToRemove");
  }
}

