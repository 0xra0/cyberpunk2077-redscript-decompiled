class ForceCarAlarm extends ActionBool {
  public final func SetProperties(isAlarmTriggered: Bool) {
    this.actionName = n"ForceCarAlarm";
    this.prop = DeviceActionPropertyFunctions
      .SetUpProperty_Bool(this.actionName, isAlarmTriggered, n"LocKey#294", n"LocKey#294");
  }

  public final static func IsDefaultConditionMet(device: VehicleComponentPS, const context: script_ref<GetActionsContext>) -> Bool {
    if ForceCarAlarm.IsAvailable(device) && ForceCarAlarm.IsClearanceValid(context.clearance) {
      return true;
    }
    return false;
  }

  public final static func IsAvailable(device: VehicleComponentPS) -> Bool {
    return true;
  }

  public final static func IsClearanceValid(clearance: Clearance) -> Bool {
    if Clearance.IsInRange(clearance, 2) {
      return true;
    }
    return false;
  }

  public func GetTweakDBChoiceRecord() -> String {
    if TDBID.IsValid(this.m_objectActionID) {
      return super.GetTweakDBChoiceRecord();
    }
    return "StartAlarm";
  }
}

class ToggleVehicle extends ActionBool {
  public final func SetProperties(toggleOn: Bool) {
    this.actionName = n"ToggleVehicle";
    this.prop = DeviceActionPropertyFunctions
      .SetUpProperty_Bool(this.actionName, toggleOn, n"LocKey#296", n"LocKey#297");
  }

  public func GetTweakDBChoiceRecord() -> String {
    let toggleOn: Bool;
    let toggleOnName: CName;
    let toggleOffName: CName;
    DeviceActionPropertyFunctions.GetProperty_Bool(this.prop, toggleOn, toggleOffName, toggleOnName);
    return NameToString(toggleOn ? toggleOnName : toggleOffName);
  }
}

