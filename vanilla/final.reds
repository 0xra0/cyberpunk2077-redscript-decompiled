class TakedownEndEvents extends LocomotionTakedownEvents {
  public func OnEnter(stateContext: StateContext, scriptInterface: StateGameScriptInterface) {
    let emptyEntityID: EntityID;
    let swapEvent = new PSMAddOnDemandStateMachine();
    swapEvent.stateMachineName = n"Locomotion";
    scriptInterface.executionOwner.QueueEvent(swapEvent);
    this.SetLocomotionParameters(stateContext, scriptInterface);
    this
      .SetBlackboardIntVariable(scriptInterface, GetAllBlackboardDefs().PlayerStateMachine.Takedown, 0);
    this
      .SetBlackboardEntityID(
        scriptInterface,
        GetAllBlackboardDefs().PlayerStateMachine.TakedownTargetID,
        emptyEntityID
      );
    this.ForceTemporaryWeaponUnequip(stateContext, scriptInterface, false);
    (this.stateMachineInitData.target as ScriptedPuppet).GetBumpComponent().Toggle(true);
  }

  public func OnExit(stateContext: StateContext, scriptInterface: StateGameScriptInterface) {
    super.OnExit(stateContext, scriptInterface);
  }
}

