  private const final func GetStatsList(
    mapPath: TweakDBID,
    const itemData: script_ref<InventoryItemData>,
    primeStatsList: script_ref<[StatViewData]>,
    secondStatsList: script_ref<[StatViewData]>,
    const compareWithData: script_ref<InventoryItemData>
  ) {
    let statProvider = new StatProvider();
