  private final func StartProcessingVForVendettaAchievement(deathInstigator: GameObject) {
    if GameInstance
      .GetStatsSystem(this.GetGame())
      .GetStatValue(Cast<StatsObjectID>(this.GetEntityID()), gamedataStatType.HasSecondHeart)
      > 0.0
      && IsDefined(deathInstigator as NPCPuppet)
      && this.m_NPCDeathInstigator == null {
      this.m_NPCDeathInstigator = deathInstigator as NPCPuppet;
    }
  }

  private final func CreateVendettaTimeDelayEvent() {
    if IsDefined(this.m_NPCDeathInstigator) {
      let vendettaTimeDelayEvent = new FinishedVendettaTimeEvent();
      GameInstance
        .GetDelaySystem(this.GetGame())
        .DelayEvent(this, vendettaTimeDelayEvent, 5.0);
    }
  }

