class ModifyDamageWithVelocity extends ModifyDamageEffector {
  public let m_percentMult: Float;
  public let m_unitThreshold: Float;

  protected func Initialize(record: TweakDBID, game: GameInstance, parentRecord: TweakDBID) {
    super.Initialize(record, game, parentRecord);
    this.m_percentMult = TweakDBInterface.GetFloat(record + t".percentMult", 0.0);
    this.m_unitThreshold = TweakDBInterface.GetFloat(record + t".unitThreshold", 0.0);
  }

  protected func Uninitialize(game: GameInstance);

  protected func RepeatedAction(owner: GameObject) {
    let hitEvent = this.GetHitEvent();
    if !IsDefined(hitEvent) {
      return;
    } else if this.m_unitThreshold != 0.0 && this.m_percentMult != 0.0 {
      let currentVelocity = Vector4.Length2D((hitEvent.attackData.GetInstigator() as gamePuppet).GetVelocity());
      this.m_value = currentVelocity / this.m_unitThreshold * this.m_percentMult;
      this.ModifyDamage(hitEvent, this.m_operationType, 1.0 + this.m_value);
    }
  }
}

class ModifyDamageWithDistance extends ModifyDamageEffector {
  public let m_percentMult: Float;
  public let m_minDistance: Float;
  public let m_maxDistance: Float;
  public let m_improveWithDistance: Bool;

  protected func Initialize(record: TweakDBID, game: GameInstance, parentRecord: TweakDBID) {
    super.Initialize(record, game, parentRecord);
    this.m_percentMult = TweakDBInterface.GetFloat(record + t".percentMult", 0.0);
    this.m_minDistance = TweakDBInterface.GetFloat(record + t".minDistance", 0.0);
    this.m_maxDistance = TweakDBInterface.GetFloat(record + t".maxDistance", 0.0);
    this.m_improveWithDistance = TweakDBInterface.GetBool(record + t".improveWithDistance", false);
  }

  protected func Uninitialize(game: GameInstance);

  protected func RepeatedAction(owner: GameObject) {
    let distanceDelta = this.m_maxDistance - this.m_minDistance;
    if distanceDelta < 0.0 {
      return;
    }
    let hitEvent = this.GetHitEvent();
    if !IsDefined(hitEvent) {
      return;
    } else if AttackData.IsEffect(hitEvent.attackData.GetAttackType()) || AttackData.IsDoT(hitEvent.attackData) {
      return;
    }
    let coveredDistance = MinF(
      Vector4
        .Distance(hitEvent.attackData.GetAttackPosition(), hitEvent.target.GetWorldPosition()),
      this.m_maxDistance
    );
    let adjustedDistance = MaxF(coveredDistance - this.m_minDistance, 0.0);
    if this.m_improveWithDistance {
      if coveredDistance < this.m_minDistance {
        return;
      }
      this.m_value = distanceDelta > 0.0 ? 1.0 - adjustedDistance / distanceDelta * (1.0 - this.m_percentMult) : this.m_percentMult;
    } else if coveredDistance >= this.m_maxDistance {
      return;
    } else {
      this.m_value = distanceDelta > 0.0 ? this.m_percentMult - adjustedDistance / distanceDelta * (this.m_percentMult - 1.0) : this.m_percentMult;
    }
    this.ModifyDamage(hitEvent, this.m_operationType, this.m_value);
  }
}

