  public final static func Check(
    const context: ScriptExecutionContext,
    condition: wref<AIIsShootingBlockedFromPrevention_Record>
  ) -> Bool {
    let puppet = ScriptExecutionContext.GetOwner(context) as NPCPuppet;
    let result = false;
    if IsDefined(puppet) {
      result = puppet.IsPrevention() && puppet.GetPreventionSystem().IsShootingFromVehicleBlocked();
    }
    return condition.Invert() ? !result : result;
  }

  public final static func Check(
    const context: ScriptExecutionContext,
    condition: wref<AICanShootInCarChaseCond_Record>
  ) -> Bool {
    let vehicle: wref<VehicleObject>;
    let targetVehicle: wref<VehicleObject>;
    let result = false;
    let ownerID = ScriptExecutionContext.GetOwner(context).GetEntityID();
    let ownerMountingInfo = GameInstance
      .GetMountingFacility(ScriptExecutionContext.GetOwner(context).GetGame())
      .GetMountingInfoSingleWithIds(ownerID);
    if !EntityID.IsDefined(ownerMountingInfo.childId) || !EntityID.IsDefined(ownerMountingInfo.parentId) {
      return condition.Invert() ? !result : result;
    }
    VehicleComponent
      .GetVehicleFromID(
        ScriptExecutionContext.GetOwner(context).GetGame(),
        ownerMountingInfo.parentId,
        vehicle
      );
    let target = ScriptExecutionContext.GetArgumentObject(context, n"CombatTarget") as ScriptedPuppet;
    if IsDefined(target) {
      let targetID = target.GetEntityID();
      let targetMountingInfo = GameInstance
        .GetMountingFacility(ScriptExecutionContext.GetOwner(context).GetGame())
        .GetMountingInfoSingleWithIds(targetID);
      VehicleComponent
        .GetVehicleFromID(
          ScriptExecutionContext.GetOwner(context).GetGame(),
          targetMountingInfo.parentId,
          targetVehicle
        );
    } else if IsDefined(vehicle) && !vehicle.IsChasingTarget() {
      result = true;
    } else if IsDefined(targetVehicle) && !targetVehicle.IsPlayerDriver() {
      result = true;
    } else if !IsDefined(targetVehicle) && IsDefined(target) && EntityID.IsDefined(target.TryGetVehicleBelow()) {
      result = true;
    } else if IsDefined(target) && !target.IsPlayer() {
      result = true;
    } else if Equals(ownerMountingInfo.slotId.id, n"seat_front_left") {
      result = GameInstance
        .GetVehicleSystem(ScriptExecutionContext.GetOwner(context).GetGame())
        .CanDriverShootInCarChase(ownerMountingInfo.parentId);
    }
    result = GameInstance
      .GetVehicleSystem(ScriptExecutionContext.GetOwner(context).GetGame())
      .CanPassengersShootInCarChase(ownerMountingInfo.parentId);
    return condition.Invert() ? !result : result;
  }

  private final static func GetDifficultyValue(difficulty: gameDifficulty) -> Int32 {
    switch difficulty {
      case gameDifficulty.Story:
        return 1;
      case gameDifficulty.Easy:
        return 2;
      case gameDifficulty.Hard:
        return 3;
      case gameDifficulty.VeryHard:
        return 4;
    }
    return 0;
  }

  private final static func GetPowerDifferentialValue(difficulty: gameEPowerDifferential) -> Int32 {
    switch difficulty {
      case gameEPowerDifferential.TRASH:
        return 1;
      case gameEPowerDifferential.EASY:
        return 2;
      case gameEPowerDifferential.NORMAL:
        return 3;
      case gameEPowerDifferential.HARD:
        return 4;
      case gameEPowerDifferential.IMPOSSIBLE:
        return 5;
    }
    return 0;
  }

  public final static func Check(const context: ScriptExecutionContext, condition: wref<AIGameDifficultyCond_Record>) -> Bool {
    let currentDifficulty = AICondition
      .GetDifficultyValue(
        GameInstance
          .GetStatsDataSystem(ScriptExecutionContext.GetOwner(context).GetGame())
          .GetDifficulty()
      );
    let comparedDifficulty = condition.ComparedDifficulty();
    let comparisonType = IntEnum<EComparisonType>(Cast<Int32>(EnumValueFromName(n"EComparisonType", condition.ComparisonType())));
    let result = ProcessCompareInt(comparisonType, comparedDifficulty, currentDifficulty);
    return condition.Invert() ? !result : result;
  }

  public final static func Check(const context: ScriptExecutionContext, condition: wref<AINPCDifficultyCond_Record>) -> Bool {
    let result = false;
    let npc = ScriptExecutionContext.GetOwner(context) as NPCPuppet;
    if IsDefined(npc) {
      let currentDifficulty = AICondition.GetPowerDifferentialValue(RPGManager.CalculatePowerDifferential(npc));
      let comparedDifficulty = condition.ComparedDifficulty();
      let comparisonType = IntEnum<EComparisonType>(
        Cast<Int32>(EnumValueFromName(n"EComparisonType", condition.ComparisonType()))
      );
      result = ProcessCompareInt(comparisonType, comparedDifficulty, currentDifficulty);
    }
    return condition.Invert() ? !result : result;
  }

  public final static func Check(const context: ScriptExecutionContext, condition: wref<AINPCRarityCond_Record>) -> Bool {
    let target: wref<GameObject>;
    if !AIActionTarget.GetObject(context, condition.Target(), target) {
      return false;
    }
    let targetPuppet = target as ScriptedPuppet;
    if !IsDefined(targetPuppet) {
      return false;
    }
    let rarity = IntEnum<gamedataNPCRarity>(Cast<Int32>(EnumValueFromString("gamedataNPCRarity", condition.Rarity())));
    let result = Equals(rarity, targetPuppet.GetNPCRarity());
    return condition.Invert() ? !result : result;
  }

  public final static func Check(const context: ScriptExecutionContext, condition: wref<AIInArmedVehicleCond_Record>) -> Bool {
    let vehicle: wref<VehicleObject>;
    if VehicleComponent
      .GetVehicle(
        ScriptExecutionContext.GetOwner(context).GetGame(),
        ScriptExecutionContext.GetOwner(context).GetEntityID(),
        vehicle
      ) {
      if vehicle.IsArmedVehicle() {
        return condition.Invert() ? false : true;
      }
    }
    return condition.Invert() ? true : false;
  }

  public final static func Check(
    const context: ScriptExecutionContext,
    condition: wref<AIPercentageChanceCond_Record>
  ) -> Bool {
    let successProbabilityPercent = condition.SuccessProbability();
    if successProbabilityPercent == 0 {
      return condition.Invert();
    } else if successProbabilityPercent == 100 {
      return !condition.Invert();
    }
    let result = RandRange(0, 100) < successProbabilityPercent;
    return condition.Invert() ? !result : result;
  }
}

