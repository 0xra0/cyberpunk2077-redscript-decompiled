  public final static func Check(
    const context: ScriptExecutionContext,
    condition: wref<AIIsFromPreventionSystem_Record>
  ) -> Bool {
    let preventionSpawnSystem = GameInstance.GetPreventionSpawnSystem(ScriptExecutionContext.GetOwner(context).GetGame());
    let result = preventionSpawnSystem.IsEntityRegistered(ScriptExecutionContext.GetOwner(context).GetEntityID());
    if condition.Invert() {
      return !result;
