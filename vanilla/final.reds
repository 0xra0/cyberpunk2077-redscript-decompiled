    inkImageRef.SetTexturePart(this.m_icon1, part1);
    inkImageRef.SetTexturePart(this.m_icon2, part2);
  }
}

class PerksSkillsLevelsContainerController extends inkLogicController {
  protected let m_topRowItemsContainer: inkCompoundRef;
  protected let m_bottomRowItemsContainer: inkCompoundRef;
  protected let m_levelBar: inkWidgetRef;
  protected let m_levelBarSpacer: inkWidgetRef;
  protected let m_label: inkTextRef;
  protected let m_proficiencyDisplayData: ProficiencyDisplayData;

  public final func Setup(proficiencyDisplayData: ProficiencyDisplayData) {
    this.m_proficiencyDisplayData = proficiencyDisplayData;
    inkTextRef.SetText(this.m_label, this.m_proficiencyDisplayData.m_localizedName);
    this.UpdateLevelsIndicators();
    this.UpdateLevelBar();
  }

  public final func UpdateLevelsIndicators() {
    inkCompoundRef.RemoveAllChildren(this.m_topRowItemsContainer);
    inkCompoundRef.RemoveAllChildren(this.m_bottomRowItemsContainer);
    let i = 0;
    while i < ArraySize(this.m_proficiencyDisplayData.m_areas) {
      if i < 5 {
        let widget = this
          .SpawnFromLocal(
            inkWidgetRef.Get(this.m_topRowItemsContainer),
            n"SkillPerkLevelPreview"
          );
      } else {
        widget = this
          .SpawnFromLocal(
            inkWidgetRef.Get(this.m_bottomRowItemsContainer),
            n"SkillPerkLevelPreview"
          );
      }
      (widget.GetController() as PerksSkillsLevelDisplayController).Setup(this.m_proficiencyDisplayData.m_areas[i]);
      i += 1;
    }
  }

  public final func UpdateLevelBar() {
    let percentage: Float;
    if this.m_proficiencyDisplayData.m_level == this.m_proficiencyDisplayData.m_maxLevel {
      percentage = 100.0;
    } else {
      percentage = Cast<Float>(this.m_proficiencyDisplayData.m_expPoints) / Cast<Float>(this.m_proficiencyDisplayData.m_maxExpPoints) * 100.0;
    }
    inkWidgetRef.SetSizeCoefficient(this.m_levelBar, percentage);
    inkWidgetRef.SetSizeCoefficient(this.m_levelBarSpacer, 100.0 - percentage);
  }
}

class PerksSkillsLevelDisplayController extends inkLogicController {
  protected let m_tint: inkWidgetRef;

  public final func Setup(data: AreaDisplayData) {
    let boughtSum: Int32;
    let maxedSum: Int32;
    let boughtMax: Int32;
    let state: CName;
    let i = 0;
    while i < ArraySize(data.m_perks) {
      let perk = data.m_perks[i];
      if perk.m_level == perk.m_maxLevel {
        maxedSum += 1;
      }
      boughtSum += perk.m_level;
      boughtMax += perk.m_maxLevel - 1;
      i += 1;
    }
    if maxedSum > 0 {
      state = n"Maxed";
      inkWidgetRef
        .SetOpacity(
          this.m_tint,
          Cast<Float>(maxedSum) / Cast<Float>(ArraySize(data.m_perks))
        );
    } else if boughtSum > 0 {
      state = n"Bought";
      inkWidgetRef.SetOpacity(this.m_tint, Cast<Float>(boughtSum) / Cast<Float>(boughtMax));
    } else {
      inkWidgetRef.SetOpacity(this.m_tint, 0.0);
    }
    inkWidgetRef.SetState(this.m_tint, state);
  }
}

