    let bbSystem = this.GetBlackboardSystem();
    this.m_listController = inkWidgetRef.GetController(this.m_listWidget) as ListController;
    this
      .m_listController
      .RegisterToCallback(n"OnItemSelected", this, n"OnItemSelected");
