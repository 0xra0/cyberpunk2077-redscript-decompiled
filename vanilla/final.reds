class SpawnSubCharacterEffector extends Effector {
  public let m_owner: wref<GameObject>;
  public let m_subCharacterTDBID: TweakDBID;

  protected func Initialize(record: TweakDBID, game: GameInstance, parentRecord: TweakDBID) {
    let str = TweakDBInterface.GetString(record + t".subCharacterRecord", "");
    this.m_subCharacterTDBID = TDBID.Create(str);
  }

  protected func Uninitialize(game: GameInstance) {
    this.ActionOff(this.m_owner);
  }

  protected func ActionOn(owner: GameObject) {
    this.m_owner = owner;
    let scs = GameInstance.GetScriptableSystemsContainer(owner.GetGame()).Get(n"SubCharacterSystem") as SubCharacterSystem;
    if IsDefined(scs) {
      let request = new SpawnUniqueSubCharacterRequest();
      request.subCharacterID = this.m_subCharacterTDBID;
      GameInstance
        .GetDelaySystem(owner.GetGame())
        .DelayScriptableSystemRequest(n"SubCharacterSystem", request, 3.0);
