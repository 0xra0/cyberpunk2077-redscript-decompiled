  public final func HasAnyTag(const tagsToCheck: script_ref<[CName]>) -> Bool {
    let i = 0;
    let limit = ArraySize(tagsToCheck);
    while i < limit {
      if this.m_realItemData.HasTag(tagsToCheck[i]) {
        return true;
      }
      i += 1;
    }
    return false;
  }

