class AimDecisions extends CanTransitionToThrowDecisions {
  protected final func ToThrow(const stateContext: StateContext, const scriptInterface: StateGameScriptInterface) -> Bool {
    let player = DefaultTransition.GetPlayerPuppet(scriptInterface);
    if !IsDefined(player) {
      return false;
    } else if player.IsAimingAtFriendly() {
      this.UpdateCanThrow(false, scriptInterface);
      return false;
    }
    this.UpdateCanThrow(true, scriptInterface);
    if !this.ValidThrowNPCActionReleased(stateContext, scriptInterface) && this.IsPlayerCombatAllowed(scriptInterface) {
      return false;
    }
    return true;
  }
}

