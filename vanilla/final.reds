  public func ActionProgramSetDeviceOff() -> ProgramSetDeviceOff {
    let action = super.ActionProgramSetDeviceOff();
    let multiplier = GameInstance
      .GetStatsSystem(this.GetGameInstance())
      .GetStatValue(
        Cast<StatsObjectID>(GetPlayer(this.GetGameInstance()).GetEntityID()),
        gamedataStatType.TurretShutdownExtension
      );
    action
      .SetDurationValue(
        action.GetDurationFromTDBRecord(t"MinigameAction.NetworkTurretShutdown") * multiplier
      );
    return action;
  }

  public func ActionProgramSetDeviceAttitude() -> ProgramSetDeviceAttitude {
    let action = super.ActionProgramSetDeviceAttitude();
    let multiplier = GameInstance
      .GetStatsSystem(this.GetGameInstance())
      .GetStatValue(
        Cast<StatsObjectID>(GetPlayer(this.GetGameInstance()).GetEntityID()),
        gamedataStatType.TurretFriendlyExtension
      );
    action
      .SetDurationValue(
        action.GetDurationFromTDBRecord(t"MinigameAction.NetworkTurretFriendly") * multiplier
      );
    return action;
  }

  public func SendDeviceNotOperationalEvent() {
    if this.m_pendingSecuritySystemDisableRequest && !this.IsTurretOperationalUnderSecuritySystem() {
      let areas = this.GetSecurityAreas();
      let i = 0;
      while i < ArraySize(areas) {
        this.QueuePSEvent(areas[i], new SecurityTurretOffline());
        i += 1;
      }
      this.m_pendingSecuritySystemDisableRequest = false;
    }
  }

  public const final func IsTurretOperationalUnderSecuritySystem() -> Bool {
    let turret = this.GetOwnerEntityWeak() as SecurityTurret;
    let groupName = turret.GetAttitudeAgent().GetAttitudeGroup();
    let isOperational = !this.IsControlledByPlayer()
      && !this.IsSecurityWakeUpBlocked()
      && NotEquals(groupName, n"player")
      && this.IsPowered();
    return isOperational;
  }

  protected func OnSetDeviceAttitude(evt: SetDeviceAttitude) -> EntityNotificationType {
    super.OnSetDeviceAttitude(evt);
    return EntityNotificationType.SendThisEventToEntity;
  }

  protected func GetDeviceIconTweakDBID() -> TweakDBID {
    return t"DeviceIcons.TurretDeviceIcon";
  }

  protected func GetBackgroundTextureTweakDBID() -> TweakDBID {
    return t"DeviceIcons.TurretDeviceBackground";
  }
}

