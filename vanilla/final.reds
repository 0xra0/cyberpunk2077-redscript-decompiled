abstract class AISubActionScaleDurationWithDistance_Record_Implementation extends IScriptable {
  public final static func Activate(
    context: ScriptExecutionContext,
    record: wref<AISubActionScaleDurationWithDistance_Record>
  );

  public final static func Update(
    context: ScriptExecutionContext,
    record: wref<AISubActionScaleDurationWithDistance_Record>,
    const duration: Float
  ) -> AIbehaviorUpdateOutcome {
    return AIbehaviorUpdateOutcome.SUCCESS;
  }

  public final static func Deactivate(
    context: ScriptExecutionContext,
    record: wref<AISubActionScaleDurationWithDistance_Record>,
    const duration: Float,
    interrupted: Bool
  );

  public final static func GetPhaseDuration(
    context: ScriptExecutionContext,
    record: wref<AISubActionScaleDurationWithDistance_Record>,
    actionPhase: Int32,
    baseDuration: Float
  ) -> Float {
    let source: wref<GameObject>;
    let target: wref<GameObject>;
    let sourcePosition: Vector4;
    let targetPosition: Vector4;
    if !AIActionTarget.Get(context, record.Source(), false, source, sourcePosition) {
      return -1.0;
    } else if !AIActionTarget.Get(context, record.Target(), false, target, targetPosition) {
      return -1.0;
    }
    let distance = Vector4.Distance(targetPosition, sourcePosition);
    let distanceRange = record.DistanceRange();
    distanceRange.X = MaxF(0.0, distanceRange.X);
    distanceRange.Y = MaxF(0.0, distanceRange.Y);
    if distanceRange.Y < distanceRange.X {
      distanceRange.Y = distanceRange.X;
    }
    let timeRange = record.ScaleDistanceToTime();
    timeRange.X = MaxF(0.0, timeRange.X);
    timeRange.Y = MaxF(0.0, timeRange.Y);
    if timeRange.Y < timeRange.X {
      timeRange.Y = timeRange.X;
    } else if distanceRange.Y >= 0.0 && distance > distanceRange.Y {
      distance = distanceRange.Y;
    } else if distanceRange.X >= 0.0 && distance < distanceRange.X {
      distance = distanceRange.X;
    }
    return ProportionalClampF(distanceRange.X, distanceRange.Y, distance, timeRange.X, timeRange.Y);
  }
}

