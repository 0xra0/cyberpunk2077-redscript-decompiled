  protected cb func OnGameplayRoleChangeNotification(evt: GameplayRoleChangeNotification) -> Bool {
    if Equals(evt.newRole, EGameplayRole.None) && NotEquals(evt.oldRole, EGameplayRole.None) {
      this.RequestHUDRefresh();
      this.RegisterToHUDManagerByTask(false);
    } else if NotEquals(evt.newRole, EGameplayRole.None)
      && (Equals(evt.oldRole, EGameplayRole.None) || Equals(evt.oldRole, EGameplayRole.UnAssigned)) {
      if this.ShouldRegisterToHUD() {
        this.RegisterToHUDManagerByTask(true);
      }
    }
  }

