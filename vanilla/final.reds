    return instance;
  }
}

abstract class MenuUIUtils extends IScriptable {
  public final static func RequestAutoSave(player: wref<GameObject>, opt delay: Float) {
    if player == null {
      return;
    } else if delay <= 0.0 {
      GameInstance.GetAutoSaveSystem(player.GetGame()).RequestCheckpoint();
    }
    let evt = new AutoSaveEvent();
    evt.maxAttempts = 5;
    evt.isForced = true;
    GameInstance.GetDelaySystem(player.GetGame()).DelayEvent(player, evt, delay, false);
  }
}

class AutoSaveEvent extends Event {
  public let maxAttempts: Int32;
  public let isForced: Bool;
}

