  public const final func IsEnemy() -> Bool {
    return this.IsHostile() || this.IsNeutral() && !this.IsCharacterCivilian() && !this.IsCrowd();
  }

  public const final func IsAggressive() -> Bool {
    if StatusEffectSystem.ObjectHasStatusEffect(this, t"GameplayRestriction.FistFight") {
      return true;
    } else if !IsDefined(this.m_reactionComponent) {
      return false;
    } else if IsDefined(this.m_reactionComponent.GetReactionPreset()) {
      if this.m_reactionComponent.GetReactionPreset().IsAggressive() {
        return true;
      }
    }
    let reactionSystem = GameInstance.GetReactionSystem(this.GetGame());
    if reactionSystem.IsRegisteredAsAggressive(this.GetEntityID()) {
      return true;
    }
    let playerPuppet = GameInstance.GetPlayerSystem(this.GetGame()).GetLocalPlayerMainGameObject() as PlayerPuppet;
    if this.IsActive()
      && Equals(GameObject.GetAttitudeTowards(this, playerPuppet), EAIAttitude.AIA_Hostile) {
      return true;
    }
    return false;
  }

  public const final func IsOnAutonomousAI() -> Bool {
    let returnValue: Bool;
    if IsDefined(this.m_aiController) {
      returnValue = Equals(this.m_aiController.GetStoryTier(), gameStoryTier.Gameplay);
    } else {
      returnValue = false;
    }
    return returnValue;
  }

