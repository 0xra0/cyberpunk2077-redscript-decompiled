    this.m_shouldOpen = shouldOpen;
  }

  public const final func ShouldOpen() -> Bool {
    return this.m_shouldOpen;
  }

  public final static func IsDefaultConditionMet(device: DoorControllerPS, const context: script_ref<GetActionsContext>) -> Bool {
    if ToggleLock.IsAvailable(device, context.requestType) && ToggleLock.IsClearanceValid(context.clearance) {
      return true;
    }
    return false;
  }

  public final static func IsAvailable(device: DoorControllerPS, requestType: gamedeviceRequestType) -> Bool {
    if device.IsDisabled() || device.IsSealed() {
      return false;
    } else if Equals(requestType, gamedeviceRequestType.Internal) {
      return true;
