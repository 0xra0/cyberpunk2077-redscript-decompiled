  public const final func IsNaked() -> Bool {
    if ItemID
      .IsValid(
        EquipmentSystem
          .GetData(
            GameInstance.GetPlayerSystem(this.GetGame()).GetLocalPlayerMainGameObject()
          )
          .GetActiveItem(gamedataEquipmentArea.Legs)
      )
      || ItemID
        .IsValid(
          EquipmentSystem
            .GetData(
              GameInstance.GetPlayerSystem(this.GetGame()).GetLocalPlayerMainGameObject()
            )
            .GetActiveItem(gamedataEquipmentArea.OuterChest)
        )
      || ItemID
        .IsValid(
          EquipmentSystem
            .GetData(
              GameInstance.GetPlayerSystem(this.GetGame()).GetLocalPlayerMainGameObject()
            )
            .GetActiveItem(gamedataEquipmentArea.InnerChest)
        ) {
      return false;
    }
    return true;
  }

