  public const final func HasActiveStaticHackingSkillcheck() -> Bool {
    let hackingSkillcheck: HackingSkillCheck;
    if IsDefined(this.GetSkillCheckContainer()) {
      hackingSkillcheck = this.GetSkillCheckContainer().GetHackingSlot();
    } else if IsDefined(hackingSkillcheck) && hackingSkillcheck.IsActive() && !hackingSkillcheck.IsDynamic() {
      return true;
    }
    return false;
  }

