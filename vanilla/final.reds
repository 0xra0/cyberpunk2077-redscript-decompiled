abstract class AISubActionDroneModifyAltitude_Record_Implementation extends IScriptable {
  public final static func Activate(
    context: ScriptExecutionContext,
    record: wref<AISubActionDroneModifyAltitude_Record>
  ) {
    if record.Delay() <= 0.0 {
      AISubActionDroneModifyAltitude_Record_Implementation.SetDesiredAltitudeOffset(context, record.AltitudeOffset());
    }
  }

  public final static func Update(
    context: ScriptExecutionContext,
    record: wref<AISubActionDroneModifyAltitude_Record>,
    const duration: Float
  ) -> AIbehaviorUpdateOutcome {
    if record.Delay() <= 0.0 {
      return AIbehaviorUpdateOutcome.SUCCESS;
    } else if record.Delay() > 0.0 && duration >= record.Delay() {
      AISubActionDroneModifyAltitude_Record_Implementation.SetDesiredAltitudeOffset(context, record.AltitudeOffset());
      return AIbehaviorUpdateOutcome.SUCCESS;
    }
    return AIbehaviorUpdateOutcome.IN_PROGRESS;
  }

  public final static func Deactivate(
    context: ScriptExecutionContext,
    record: wref<AISubActionDroneModifyAltitude_Record>,
    const duration: Float,
    interrupted: Bool
  ) {
    AISubActionDroneModifyAltitude_Record_Implementation.SetDesiredAltitudeOffset(context, 0.0);
  }

  public final static func SetDesiredAltitudeOffset(context: ScriptExecutionContext, desiredOffset: Float) {
    let altitudeOffsetAnimFeature = new AnimFeature_DroneActionAltitudeOffset();
    altitudeOffsetAnimFeature.desiredOffset = desiredOffset;
    AnimationControllerComponent
      .ApplyFeatureToReplicate(
        ScriptExecutionContext.GetOwner(context),
        n"ActionAltitudeOffset",
        altitudeOffsetAnimFeature
      );
  }
}

