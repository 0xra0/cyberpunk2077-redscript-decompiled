class ElectricLightControllerPS extends ScriptableDeviceComponentPS {
  private persistent let m_isConnectedToCLS: Bool;
  private let m_wasCLSInitTriggered: Bool;

  protected cb func OnInstantiated() -> Bool {
    super.OnInstantiated();
    if !IsStringValid(this.m_deviceName) {
      this.m_deviceName = "LocKey#42165";
    }
  }

  protected func GameAttached();

  protected func LogicReady() {
    super.LogicReady();
    this.m_isAttachedToGame = true;
  }

  public func GetActions(out actions: [DeviceAction], context: GetActionsContext) -> Bool {
    super.GetActions(actions, context);
    if ToggleON.IsDefaultConditionMet(this, context) {
      ArrayPush(actions, this.ActionToggleON());
    }
    this.SetActionIllegality(actions, this.m_illegalActions.regularActions);
    return true;
  }

  public func EvaluateDeviceState() {
    if this.IsDisabled() {
      return;
    } else if this.m_isConnectedToCLS {
      let fuse = this.GetCLSFuse();
      if IsDefined(fuse) {
        this.SetDeviceState(fuse.GetDeviceState());
      }
    } else if this.m_wasCLSInitTriggered || !this.InitializeCLS(true) {
      super.EvaluateDeviceState();
    }
  }

  public const func IsConnectedToCLS() -> Bool {
    if this.m_isConnectedToCLS {
      return true;
    }
    return super.IsConnectedToCLS();
  }

  private final func InitializeCLS(opt setStateInstant: Bool) -> Bool {
    let fuse = this.GetCLSFuse();
    if IsDefined(fuse) {
      if fuse.IsUnpowered() {
        if setStateInstant {
          this.SetDeviceState(EDeviceStatus.UNPOWERED);
        } else {
          this.UpdateStateOnCLS(EDeviceStatus.UNPOWERED);
        }
      } else if fuse.IsCLSInitialized() {
        if setStateInstant {
          this.SetDeviceState(fuse.GetDeviceState());
        } else {
          this.UpdateStateOnCLS(fuse.GetDeviceState());
        }
      } else {
        let evt = new InitializeCLSEvent();
        this.GetPersistencySystem().QueuePSEvent(fuse.GetID(), fuse.GetClassName(), evt);
        if setStateInstant {
          this.SetDeviceState(fuse.GetDeviceStateByCLS());
        }
      }
      this.m_isConnectedToCLS = true;
    }
    this.m_wasCLSInitTriggered = true;
    return this.m_isConnectedToCLS;
  }

  private final func GetCLSFuse() -> FuseControllerPS {
    let masters: [DeviceComponentPS];
    this.GetParents(masters);
    let i = 0;
    while i < ArraySize(masters) {
      let fuse = masters[i] as FuseControllerPS;
      if IsDefined(fuse) {
        if fuse.IsConnectedToCLS() {
          return fuse;
        }
      }
      i += 1;
    }
    return null;
  }

  private final func UpdateStateOnCLS(state: EDeviceStatus) {
    if Equals(state, EDeviceStatus.ON) {
      if this.IsUnpowered() {
        this.ExecutePSAction(this.ActionSetDevicePowered(), this);
      }
      this.ExecutePSAction(this.ActionSetDeviceON(), this);
    } else if Equals(state, EDeviceStatus.OFF) {
      this.ExecutePSAction(this.ActionSetDeviceOFF(), this);
    } else if Equals(state, EDeviceStatus.UNPOWERED) {
      this.ExecutePSAction(this.ActionSetDeviceUnpowered(), this);
    }
  }
}

class FuseControllerPS extends MasterControllerPS {
  protected persistent let m_timeTableSetup: DeviceTimeTableManager;
  protected persistent let m_maxLightsSwitchedAtOnce: Int32;
  protected persistent let m_timeToNextSwitch: Float;
  protected persistent let m_lightSwitchRandomizerType: ELightSwitchRandomizerType;
  private let m_alternativeNameForON: TweakDBID;
  private let m_alternativeNameForOFF: TweakDBID;
  private let m_alternativeNameForPower: TweakDBID;
  private let m_alternativeNameForUnpower: TweakDBID;
  private let m_isCLSInitialized: Bool;

  protected cb func OnInstantiated() -> Bool {
    super.OnInstantiated();
    if !IsStringValid(this.m_deviceName) {
      this.m_deviceName = "LocKey#116";
    }
  }

  protected func Initialize() {
    super.Initialize();
    this.InitializeCLS();
    if this.IsUnpowered() {
      this.RefreshPowerOnSlaves_Event();
    } else if this.m_timeTableSetup == null || !this.m_timeTableSetup.IsValid() {
      this.RefreshSlaves_Event();
    }
  }

  public const func GetExpectedSlaveState() -> EDeviceStatus {
    return this.GetDeviceState();
  }

  public const final func GetTimetableSetup() -> DeviceTimeTableManager {
    return this.m_timeTableSetup;
  }

  protected const func GetClearance() -> Clearance {
    return Clearance.CreateClearance(29, 29);
  }

  public func ActionToggleON() -> ToggleON {
    let action = new ToggleON();
    action.clearanceLevel = 5;
    action.SetUp(this);
    action
      .SetProperties(
        this.m_deviceState,
        this.m_alternativeNameForON,
        this.m_alternativeNameForOFF
      );
    action.AddDeviceName(this.m_deviceName);
    action.CreateActionWidgetPackage();
    return action;
  }

  protected func ActionTogglePower() -> TogglePower {
    let action = new TogglePower();
    action.clearanceLevel = 19;
    action.SetUp(this);
    action
      .SetProperties(
        this.m_deviceState,
        this.m_alternativeNameForPower,
        this.m_alternativeNameForUnpower
      );
    action.AddDeviceName(this.m_deviceName);
    action.CreateActionWidgetPackage();
    return action;
  }

  public func GetActions(out outActions: [DeviceAction], context: GetActionsContext) -> Bool {
    super.GetActions(outActions, context);
    if this.IsDisabled() {
      return false;
    } else if ToggleON.IsDefaultConditionMet(this, context) && Equals(context.requestType, gamedeviceRequestType.External) {
      ArrayPush(outActions, this.ActionToggleON());
    } else if TogglePower.IsDefaultConditionMet(this, context) && Equals(context.requestType, gamedeviceRequestType.External) {
      ArrayPush(outActions, this.ActionTogglePower());
    }
    this.SetActionIllegality(outActions, this.m_illegalActions.regularActions);
    return true;
  }

  protected func OnQuestForceON(evt: QuestForceON) -> EntityNotificationType {
    super.OnQuestForceON(evt);
    this.RefreshSlaves_Event(false, true);
    return EntityNotificationType.DoNotNotifyEntity;
  }

  protected func OnQuestForceOFF(evt: QuestForceOFF) -> EntityNotificationType {
    super.OnQuestForceOFF(evt);
    this.RefreshSlaves_Event(false, true);
    return EntityNotificationType.DoNotNotifyEntity;
  }

  protected func OnSetDeviceON(evt: SetDeviceON) -> EntityNotificationType {
    let notifier = new ActionNotifier();
    notifier.SetNone();
    if this.IsDisabled() || this.IsUnpowered() {
      return this.SendActionFailedEvent(evt, evt.GetRequesterID(), "Unpowered or Disabled");
    }
    this.SetDeviceState(EDeviceStatus.ON);
    this.RefreshSlaves_Event();
    this.Notify(notifier, evt);
    return EntityNotificationType.DoNotNotifyEntity;
  }

  protected func OnSetDeviceOFF(evt: SetDeviceOFF) -> EntityNotificationType {
    let notifier = new ActionNotifier();
    notifier.SetNone();
    if this.IsDisabled() || this.IsUnpowered() {
      return this.SendActionFailedEvent(evt, evt.GetRequesterID(), "Unpowered or Disabled");
    }
    this.SetDeviceState(EDeviceStatus.OFF);
    this.RefreshSlaves_Event();
    this.Notify(notifier, evt);
    return EntityNotificationType.DoNotNotifyEntity;
  }

  protected func OnSetDeviceUnpowered(evt: SetDeviceUnpowered) -> EntityNotificationType {
    let notifier = new ActionNotifier();
    notifier.SetNone();
    if this.IsDisabled() {
      return this.SendActionFailedEvent(evt, evt.GetRequesterID(), "Unpowered or Disabled");
    }
    this.UnpowerDevice();
    this.Notify(notifier, evt);
    return EntityNotificationType.DoNotNotifyEntity;
  }

  protected func OnSetDevicePowered(evt: SetDevicePowered) -> EntityNotificationType {
    let notifier = new ActionNotifier();
    notifier.SetNone();
    if this.IsDisabled() {
      return this.SendActionFailedEvent(evt, evt.GetRequesterID(), "Disabled");
    }
    this.PowerDevice();
    this.Notify(notifier, evt);
    return EntityNotificationType.DoNotNotifyEntity;
  }

  public func OnToggleON(evt: ToggleON) -> EntityNotificationType {
    super.OnToggleON(evt);
    this.RefreshSlaves_Event();
    return EntityNotificationType.DoNotNotifyEntity;
  }

  protected func PowerDevice() {
    let stateFromCLS = EDeviceStatus.DISABLED;
    if this.IsConnectedToCLS() {
      stateFromCLS = this.GetCityLightSystem().GetFuseStateByID(this.GetID());
    } else if NotEquals(stateFromCLS, EDeviceStatus.DISABLED) {
      this.SetDeviceState(stateFromCLS);
    }
    this.SetDeviceState(EDeviceStatus.ON);
    this.RefreshPowerOnSlaves_Event();
  }

  public func UnpowerDevice() {
    super.UnpowerDevice();
    this.RefreshPowerOnSlaves_Event();
  }

  private final func RefreshSlaves(devices: [DeviceComponentPS], opt force: Bool) {
    if this.IsUnpowered() {
      this.RefreshPowerOnSlaves(devices);
      return;
    } else if this.IsConnectedToCLS() {
      this.RefreshCLSoNslaves(this.GetDeviceState(), false, devices);
      return;
    }
    devices = this.GetImmediateSlaves();
    let i = 0;
    while i < ArraySize(devices) {
      if devices[i] == this {
      } else {
        let device = devices[i] as ScriptableDeviceComponentPS;
        if !IsDefined(device) {
        } else if this.IsON() {
          if force {
            let action = device.ActionQuestForceON();
          } else {
            action = device.ActionSetDeviceON();
          }
        } else if force {
          action = device.ActionQuestForceOFF();
        } else {
          action = device.ActionSetDeviceOFF();
          if IsDefined(action) {
            action.RegisterAsRequester(PersistentID.ExtractEntityID(this.GetID()));
            this.GetPersistencySystem().QueuePSDeviceEvent(action);
          }
        }
      }
      i = i + 1;
    }
  }

  private final func RefreshPowerOnSlaves(const devices: script_ref<[DeviceComponentPS]>) {
    if this.IsConnectedToCLS() {
      let restorePower = this.IsON();
      this.RefreshCLSoNslaves(this.GetDeviceState(), restorePower, devices);
      return;
    } else if !this.IsON() {
      this.CutPowerOnSlaveDevices(devices);
    }
    this.RestorePowerOnSlaveDevices(devices);
  }

  private final func RestorePowerOnSlaveDevices(devices: [DeviceComponentPS]) {
    devices = this.GetImmediateSlaves();
    let i = 0;
    while i < ArraySize(devices) {
      if devices[i] == this {
      } else {
        let device = devices[i] as ScriptableDeviceComponentPS;
        if IsDefined(device) {
          let action = device.ActionSetDevicePowered();
        } else if IsDefined(action) {
          this.ExecutePSAction(action, device);
        }
      }
      i = i + 1;
    }
  }

  private final func CutPowerOnSlaveDevices(devices: [DeviceComponentPS]) {
    devices = this.GetImmediateSlaves();
    let i = 0;
    while i < ArraySize(devices) {
      if devices[i] == this {
      } else {
        let device = devices[i] as ScriptableDeviceComponentPS;
        if IsDefined(device) {
          let action = device.ActionSetDeviceUnpowered();
        } else if IsDefined(action) {
          this.ExecutePSAction(action, device);
        }
      }
      i = i + 1;
    }
  }

  protected func OnRefreshSlavesEvent(evt: RefreshSlavesEvent) -> EntityNotificationType {
    this.RefreshSlaves(evt.devices, evt.force);
    return EntityNotificationType.DoNotNotifyEntity;
  }

  protected final func OnRefreshPowerOnSlavesEvent(evt: RefreshPowerOnSlavesEvent) -> EntityNotificationType {
    this.RefreshPowerOnSlaves(evt.devices);
    return EntityNotificationType.DoNotNotifyEntity;
  }

  public const final func IsCLSInitialized() -> Bool {
    return this.m_isCLSInitialized;
  }

  protected final func OnInitializeCLSEvent(evt: InitializeCLSEvent) -> EntityNotificationType {
    this.InitializeCLS();
    return EntityNotificationType.DoNotNotifyEntity;
  }

  protected final func OnDeviceTimetableEvent(evt: DeviceTimetableEvent) -> EntityNotificationType {
    if Equals(evt.state, EDeviceStatus.ON) {
      this.ExecutePSAction(this.ActionSetDeviceON(), this);
    } else if Equals(evt.state, EDeviceStatus.OFF) {
      this.ExecutePSAction(this.ActionSetDeviceOFF(), this);
    } else if Equals(evt.state, EDeviceStatus.UNPOWERED) {
      this.ExecutePSAction(this.ActionSetDeviceUnpowered(), this);
    }
    return EntityNotificationType.DoNotNotifyEntity;
  }

  protected final func OnRefreshCLSoNslaves(evt: RefreshCLSOnSlavesEvent) -> EntityNotificationType {
    if NotEquals(evt.state, this.GetDeviceState()) {
      return EntityNotificationType.DoNotNotifyEntity;
    }
    this.RefreshCLSoNslaves(evt.state, evt.restorePower, evt.slaves);
    return EntityNotificationType.DoNotNotifyEntity;
  }

  private final func RefreshCLSoNslaves(
    state: EDeviceStatus,
    restorePower: Bool,
    const devices: script_ref<[DeviceComponentPS]>
  ) {
    let totalEventsSent: Int32;
    let excessDevices: [DeviceComponentPS];
    let i = 0;
    while i < ArraySize(devices) {
      if devices[i] == null || !devices[i].IsAttachedToGame() {
      } else if totalEventsSent >= this.m_maxLightsSwitchedAtOnce {
        ArrayPush(excessDevices, devices[i]);
      } else {
        let id = PersistentID.ExtractEntityID(devices[i].GetID());
        if EntityID.IsDefined(id) {
          this.SendDeviceTimeTableEvent(id, state, restorePower);
          totalEventsSent += 1;
        }
      }
      i += 1;
    }
    if ArraySize(excessDevices) > 0 {
      if Equals(this.m_lightSwitchRandomizerType, ELightSwitchRandomizerType.NONE) {
        let delay = this.m_timeToNextSwitch;
      } else if Equals(
        this.m_lightSwitchRandomizerType,
        ELightSwitchRandomizerType.RANDOM_PROGRESSIVE
      ) {
        delay += this.GetLightSwitchDelayValue();
      } else {
        delay = this.GetLightSwitchDelayValue();
      }
      this.SendCLSRefreshByEvent(excessDevices, state, restorePower, delay);
    }
  }

  private final func GetLightSwitchDelayValue() -> Float {
    let delay: Float;
    if this.m_timeToNextSwitch == 0.0 {
      delay = 0.0;
    } else {
      delay = RandRangeF(0.0, this.m_timeToNextSwitch);
    }
    return delay;
  }

  private final func SendCLSRefreshByEvent(
    const devices: script_ref<[DeviceComponentPS]>,
    state: EDeviceStatus,
    restorePower: Bool,
    delay: Float
  ) {
    let evt = new RefreshCLSOnSlavesEvent();
    evt.state = state;
    evt.slaves = devices;
    evt.restorePower = restorePower;
    if delay > 0.0 {
      this.QueuePSEventWithDelay(this, evt, delay);
    } else {
      this.QueuePSEvent(this, evt);
    }
  }

  private final func SendDeviceTimeTableEvent(targetID: EntityID, state: EDeviceStatus, restorePower: Bool) {
    let evt = new DeviceTimetableEvent();
    evt.state = state;
    evt.requesterID = PersistentID.ExtractEntityID(this.GetID());
    evt.restorePower = restorePower;
    this.GetPersistencySystem().QueueEntityEvent(targetID, evt);
  }

  private final func SendDeviceTimeTableEventWithDelay(targetID: EntityID, state: EDeviceStatus, restorePower: Bool, delay: Float) {
    let evt = new DeviceTimetableEvent();
    evt.state = state;
    evt.requesterID = PersistentID.ExtractEntityID(this.GetID());
    evt.restorePower = restorePower;
    this.QueuePSEventWithDelay(this, evt, delay);
  }

  protected final func OnDealyedTimetableEvent(evt: DelayedTimetableEvent) -> EntityNotificationType {
    if evt.eventToForward != null && evt.targetPS != null {
      if evt.targetPS.IsAttachedToGame() {
        let id = PersistentID.ExtractEntityID(evt.targetPS.GetID());
        if EntityID.IsDefined(id) {
          this.GetPersistencySystem().QueueEntityEvent(id, evt);
        }
      }
    }
    return EntityNotificationType.DoNotNotifyEntity;
  }

  public const final func GetDeviceStateByCLS() -> EDeviceStatus {
    let deviceState: EDeviceStatus;
    if !this.IsDisabled() && !this.IsUnpowered() {
      deviceState = this.m_deviceState;
    } else if this.IsConnectedToCLS() && !this.m_isCLSInitialized {
      let cls = this.GetCityLightSystem();
      if IsDefined(cls) {
        let clsState = cls.GetState();
        if Equals(clsState, ECLSForcedState.DEFAULT) {
          deviceState = this.m_timeTableSetup.GetDeviceStateForActiveEntry(this.GetGameInstance());
        } else if Equals(clsState, ECLSForcedState.ForcedON) {
          deviceState = EDeviceStatus.ON;
        } else if Equals(clsState, ECLSForcedState.ForcedOFF) {
          deviceState = EDeviceStatus.OFF;
        }
      } else {
        deviceState = this.m_deviceState;
      }
    } else {
      deviceState = this.m_deviceState;
    }
    return deviceState;
  }

  private final func InitializeCLS() {
    let requesterData: PSOwnerData;
    let lights: [LazyDevice];
    if this.m_isCLSInitialized {
      return;
    }
    this.m_isCLSInitialized = true;
    if this.m_timeTableSetup != null && this.m_timeTableSetup.IsValid() {
      let request = new RegisterTimetableRequest();
      request.timeTable = this.m_timeTableSetup.GetTimeTable();
      requesterData.id = this.GetID();
      requesterData.className = this.GetClassName();
      request.requesterData = requesterData;
      if !IsFinal() {
        this.GetLazyChildren(lights);
        request.lights = ArraySize(lights);
      }
      let cls = this.GetCityLightSystem();
      if IsDefined(cls) {
        cls.QueueRequest(request);
        let clsState = cls.GetState();
      } else if !this.IsDisabled() && !this.IsUnpowered() {
        if Equals(clsState, ECLSForcedState.DEFAULT) {
          this
            .SetDeviceState(
              this
                .m_timeTableSetup
                .GetDeviceStateForActiveEntry(this.GetGameInstance())
            );
        } else if Equals(clsState, ECLSForcedState.ForcedON) {
          this.SetDeviceState(EDeviceStatus.ON);
        } else if Equals(clsState, ECLSForcedState.ForcedOFF) {
          this.SetDeviceState(EDeviceStatus.OFF);
        }
      }
    }
  }

  public const func IsConnectedToCLS() -> Bool {
    return this.m_timeTableSetup != null && this.m_timeTableSetup.IsValid();
  }

  protected func GetDeviceIconTweakDBID() -> TweakDBID {
    return t"DeviceIcons.GeneratorDeviceIcon";
  }

  protected func GetBackgroundTextureTweakDBID() -> TweakDBID {
    return t"DeviceIcons.GeneratorDeviceBackground";
  }
}

class DeviceTimeTableManager extends IScriptable {
  protected const persistent let m_timeTable: [SDeviceTimetableEntry];

  public final func InitializeTimetable(owner: GameObject) {
    let timeSystem = GameInstance.GetTimeSystem(owner.GetGame());
    let currentTime = this.GetCurrentTime(owner.GetGame());
    let i = 0;
    while i < ArraySize(this.m_timeTable) {
      let timeout = GameTime.MakeGameTime(0, 0, 0, 30);
      let evt = new DeviceTimetableEvent();
      evt.state = this.m_timeTable[i].state;
      evt.requesterID = owner.GetEntityID();
      let entryTime = GameTime
        .MakeGameTime(
          0,
          this.m_timeTable[i].time.hours,
          this.m_timeTable[i].time.minutes,
          this.m_timeTable[i].time.seconds
        );
      timeout += entryTime;
      this.m_timeTable[i].entryID = timeSystem.RegisterIntervalListener(owner, evt, entryTime, timeout, -1);
      if entryTime != currentTime && this.IsEntryActive(owner.GetGame(), i) {
        owner.QueueEvent(evt);
      }
      i += 1;
    }
  }

  public final func IsValid() -> Bool {
    return ArraySize(this.m_timeTable) > 0;
  }

  public final func UninitializeTimetable(game: GameInstance) {
    let i = 0;
    while i < ArraySize(this.m_timeTable) {
      GameInstance.GetTimeSystem(game).UnregisterListener(this.m_timeTable[i].entryID);
      i += 1;
    }
  }

  public const final func GetTimeTable() -> [SDeviceTimetableEntry] {
    return this.m_timeTable;
  }

  public const final func GetDeviceStateForActiveEntry(game: GameInstance) -> EDeviceStatus {
    let state: EDeviceStatus;
    let id = this.GetACtiveEntryID(game);
    if id >= 0 {
      state = this.m_timeTable[id].state;
    }
    return state;
  }

  public const final func GetACtiveEntryID(game: GameInstance) -> Int32 {
    let storedtime: GameTime;
    let wasTimeStored: Bool;
    let currentTime = this.GetCurrentTime(game);
    let id = -1;
    let i = 0;
    while i < ArraySize(this.m_timeTable) {
      let entryTime = GameTime
        .MakeGameTime(
          0,
          this.m_timeTable[i].time.hours,
          this.m_timeTable[i].time.minutes,
          this.m_timeTable[i].time.seconds
        );
      if currentTime < entryTime {
        let time = GameTime.MakeGameTime(0, 24, 0, 0) - entryTime + currentTime;
      } else {
        time = currentTime - entryTime;
      }
      if time < storedtime || !wasTimeStored {
        wasTimeStored = true;
        storedtime = time;
        id = i;
      }
      i += 1;
    }
    return id;
  }

  private const final func IsEntryActive(game: GameInstance, entryID: Int32) -> Bool {
    return this.GetACtiveEntryID(game) == entryID;
  }

  private const final func GetCurrentTime(game: GameInstance) -> GameTime {
    let currentTime = GameInstance.GetTimeSystem(game).GetGameTime();
    let time = GameTime
      .MakeGameTime(
        0,
        GameTime.Hours(currentTime),
        GameTime.Minutes(currentTime),
        GameTime.Seconds(currentTime)
      );
    return time;
  }
}

public native func OperatorNotEqual(a: GameTime, b: GameTime) -> Bool;

class RefreshCLSOnSlavesEvent extends Event {
  public let slaves: [DeviceComponentPS];
  public let state: EDeviceStatus;
  public let restorePower: Bool;
}

class DelayedTimetableEvent extends Event {
