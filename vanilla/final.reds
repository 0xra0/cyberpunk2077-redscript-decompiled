public func AddFact(game: GameInstance, factName: CName, opt factCount: Int32) -> Bool {
  if !GameInstance.IsValid(game) {
    return false;
  } else if !IsNameValid(factName) {
    return false;
  } else if factCount == 0 {
    factCount = 1;
  }
  let currentFactCount = GameInstance.GetQuestsSystem(game).GetFact(factName) + factCount;
  GameInstance.GetQuestsSystem(game).SetFact(factName, currentFactCount);
  return true;
}

