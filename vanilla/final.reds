    let weaponID = weapon.GetItemID();
    let weaponRecord = TweakDBInterface.GetItemRecord(ItemID.GetTDBID(weaponID)) as WeaponItem_Record;
    let ammoID = ItemID.CreateQuery(weaponRecord.Ammo().GetID());
