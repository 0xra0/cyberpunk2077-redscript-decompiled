class ElectricBoxControllerPS extends MasterControllerPS {
  private let m_techieSkillChecks: EngineeringContainer;
  private let m_questFactSetup: ComputerQuickHackData;
  private persistent let m_isOverriden: Bool;

  protected func GameAttached();

  protected func GetSkillCheckContainerForSetup() -> BaseSkillCheckContainer {
    return this.m_techieSkillChecks;
  }

  public const final func IsOverriden() -> Bool {
    return this.m_isOverriden;
  }

  public func GetActions(out actions: [DeviceAction], context: GetActionsContext) -> Bool {
    if !super.GetActions(actions, context) {
      return false;
    } else if !this.IsON() {
      return false;
    } else if !this.m_isOverriden {
      ArrayPush(actions, this.ActionOverride());
    }
    this.SetActionIllegality(actions, this.m_illegalActions.regularActions);
    return true;
  }

  private final func ActionOverride() -> ActionOverride {
    let action = new ActionOverride();
    action.SetUp(this);
    action.AddDeviceName(this.m_deviceName);
    if TDBID.IsValid(this.m_questFactSetup.alternativeName) {
      action.CreateInteraction(this.m_questFactSetup.alternativeName);
    } else {
      action.CreateInteraction();
    }
    action
      .SetIllegal(this.m_illegalActions.skillChecks || this.m_illegalActions.regularActions);
    return action;
  }

  protected func OnActionEngineering(evt: ActionEngineering) -> EntityNotificationType {
    super.OnActionEngineering(evt);
    this.m_isOverriden = true;
    this.ExecutePSAction(this.ActionOverride(), n"direct");
    return EntityNotificationType.DoNotNotifyEntity;
  }

  protected func OnActionOverride(evt: ActionOverride) -> EntityNotificationType {
    this.m_isOverriden = true;
    if this.IsConnectedToSecuritySystem() {
      this
        .TriggerSecuritySystemNotification(
          evt.GetExecutor(),
          this.GetOwnerEntityWeak().GetWorldPosition(),
          ESecurityNotificationType.ILLEGAL_ACTION
        );
    }
    this.UseNotifier(evt);
    return EntityNotificationType.SendThisEventToEntity;
  }

  public final func GetQuestSetup() -> ComputerQuickHackData {
    return this.m_questFactSetup;
  }

  public final func WorkspotFinished() {
    this.m_isOverriden = true;
    this.RefreshSlaves();
  }

  private const final func RefreshSlaves() {
    this.SendActionToAllSlaves(new ActionOverride());
  }

  protected func GetDeviceIconTweakDBID() -> TweakDBID {
    return t"DeviceIcons.GeneratorDeviceIcon";
  }

  protected func GetBackgroundTextureTweakDBID() -> TweakDBID {
    return t"DeviceIcons.GeneratorDeviceBackground";
  }

  public const func GetBlackboardDef() -> DeviceBaseBlackboardDef {
    return GetAllBlackboardDefs().ElectricBoxBlackBoard;
  }
}

class ActionOverride extends ActionBool {
  public final func SetProperties();

  public func GetTweakDBChoiceRecord() -> String {
    if TDBID.IsValid(this.m_objectActionID) {
      return super.GetTweakDBChoiceRecord();
    }
    return "Override";
  }
}

class NetworkArea extends InteractiveMasterDevice {
  private let m_area: TriggerComponent;

  protected cb func OnRequestComponents(ri: EntityRequestComponentsInterface) -> Bool {
    EntityRequestComponentsInterface.RequestComponent(ri, n"area", n"TriggerComponent", false);
    super.OnRequestComponents(ri);
  }

  protected cb func OnTakeControl(ri: EntityResolveComponentsInterface) -> Bool {
    super.OnTakeControl(ri);
    this.m_area = EntityResolveComponentsInterface.GetComponent(ri, n"area") as TriggerComponent;
    this.m_controller = EntityResolveComponentsInterface.GetComponent(ri, n"controller") as NetworkAreaController;
  }

  private const func GetController() -> NetworkAreaController {
    return this.m_controller as NetworkAreaController;
