class AiControlledDecisions extends HighLevelTransition {
  public const final func EnterCondition(const stateContext: StateContext, const scriptInterface: StateGameScriptInterface) -> Bool {
    let playerPuppet = DefaultTransition.GetPlayerPuppet(scriptInterface);
    let aiComponent = playerPuppet.GetAIControllerComponent();
    if aiComponent == null {
      return false;
    }
    let isPlayerControlled = stateContext.GetTemporaryBoolParameter(n"playerControlled");
    return isPlayerControlled.valid && !isPlayerControlled.value;
  }

  public const final func ExitCondition(const stateContext: StateContext, const scriptInterface: StateGameScriptInterface) -> Bool {
    let isPlayerControlled = stateContext.GetTemporaryBoolParameter(n"playerControlled");
    return isPlayerControlled.valid && isPlayerControlled.value;
  }
}

