class OnlyNearest_AINavPath_Device extends EffectObjectGroupFilter_Scripted {
  public final func Process(out ctx: EffectScriptContext, out filterCtx: EffectGroupFilterScriptContext) -> Bool {
    let targets: [ScriptedPuppet];
    let target: ScriptedPuppet;
    let dataVariant: Variant;
    EffectData
      .GetVariant(
        EffectScriptContext.GetSharedData(ctx),
        GetAllBlackboardDefs().EffectSharedData.forceVisionAppearanceData,
        dataVariant
      );
    let data = FromVariant<PuppetForceVisionAppearanceData>(dataVariant);
    if !IsDefined(data) {
      return false;
    }
    let numAgents = EffectGroupFilterScriptContext.GetNumAgents(filterCtx);
    let i = 0;
    while i < numAgents {
      target = EffectGroupFilterScriptContext.GetEntity(filterCtx, i) as ScriptedPuppet;
      if IsDefined(target) {
        ArrayPush(targets, target);
      }
      i = i + 1;
    }
    let maxCount = data.m_investigationSlots;
    let source = EffectScriptContext.GetSource(ctx) as GameObject;
    let sortedTargets = this.SortTargetsByDistance(source, targets);
    ArrayClear(filterCtx.resultIndices);
    i = 0;
    if i < ArraySize(sortedTargets) {
      if ArraySize(filterCtx.resultIndices) >= maxCount {
      } else {
        let sortedTarget = sortedTargets[i].handle as ScriptedPuppet;
        if sortedTarget != null {
          let j = 0;
          if j < numAgents {
            target = EffectGroupFilterScriptContext.GetEntity(filterCtx, j) as ScriptedPuppet;
            if sortedTarget == target {
              ArrayPush(filterCtx.resultIndices, j);
            } else {
              j = j + 1;
            }
          } else {
            i = i + 1;
          }
        }
      }
    }
    return true;
  }

  private final func SortTargetsByDistance(source: GameObject, const targets: script_ref<[ScriptedPuppet]>) -> [HandleWithValue] {
    let closestNavDist: Float;
    let sortedTargets: [HandleWithValue];
    let singleSortedTarget: HandleWithValue;
    let posSources = (source as Device).GetNodePosition();
    let i = 0;
    while i < ArraySize(targets) {
      let targetPos = targets[i].GetWorldPosition();
      let closestPath = null;
      let j = 0;
      while j < ArraySize(posSources) {
        let navDistance = Vector4.DistanceSquared(posSources[j], targetPos);
        if navDistance < closestNavDist || closestNavDist == 0.0 {
          let path = GameInstance
            .GetAINavigationSystem(source.GetGame())
            .CalculatePathForCharacter(targetPos, posSources[j], 0.0, source);
          if IsDefined(path) {
            closestNavDist = navDistance;
            closestPath = path;
          }
        }
        j += 1;
      }
      if !IsDefined(closestPath) {
      } else {
        let currentDistance = closestPath.CalculateLength();
        singleSortedTarget.value = currentDistance;
        singleSortedTarget.handle = targets[i];
        ArrayPush(sortedTargets, singleSortedTarget);
      }
      i += 1;
    }
    SortHandleWithValueArray(sortedTargets);
    return sortedTargets;
  }
}

