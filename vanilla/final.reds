  public const final func TriggerSecuritySystemNotification(
    lastKnownPosition: Vector4,
    threat: wref<GameObject>,
    type: ESecurityNotificationType,
    opt stimType: gamedataStimType
  ) {
    if IsDefined(threat) {
      if IsDefined(threat as ScriptedPuppet) {
        if NotEquals(type, ESecurityNotificationType.ALARM)
          && ((threat as ScriptedPuppet).IsCharacterCivilian() || Equals(this.GetAttitudeTowards(threat), EAIAttitude.AIA_Friendly)) {
          return;
        } else if IsDefined(this.GetDeviceLink()) {
          this
            .GetDeviceLink()
            .TriggerSecuritySystemNotification(lastKnownPosition, threat, type, stimType);
        }
      }
    }
  }

