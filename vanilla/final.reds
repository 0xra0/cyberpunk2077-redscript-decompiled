  protected cb func OnRemoveAllStatusEffectOfTypeEvent(evt: RemoveAllStatusEffectOfTypeEvent) -> Bool {
    GameInstance
      .GetStatusEffectSystem(this.GetGame())
      .RemoveAllStatusEffectOfType(this.GetEntityID(), evt.statusEffectType);
  }
}

