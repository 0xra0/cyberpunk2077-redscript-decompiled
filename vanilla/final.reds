class EntityHealthBarGameController extends inkGameController {
  private let m_healthControllerRef: inkWidgetRef;
  private let m_healthPercentageRef: inkTextRef;
  private let m_targetEntityRef: EntityReference;
  private let m_healthStatListener: EntityHealthStatListener;
  private let m_healthController: wref<NameplateBarLogicController>;
  private let m_gameInstance: GameInstance;
  private let m_targetEntityID: EntityID;

  protected cb func OnInitialize() -> Bool {
    this.m_gameInstance = (this.GetOwnerEntity() as PlayerPuppet).GetGame();
    this.m_healthController = inkWidgetRef.GetController(this.m_healthControllerRef) as NameplateBarLogicController;
    this.RegisterHealthStatListener();
  }

  protected cb func OnUninitialize() -> Bool {
    GameInstance
      .GetStatPoolsSystem(this.m_gameInstance)
      .RequestUnregisteringListener(
        Cast<StatsObjectID>(this.m_targetEntityID),
        gamedataStatPoolType.Health,
        this.m_healthStatListener
      );
  }

  private final func RegisterHealthStatListener() {
    let entityIds: [EntityID];
    this.m_healthStatListener = new EntityHealthStatListener();
    this.m_healthStatListener.BindHealthbar(this);
    GetFixedEntityIdsFromEntityReference(this.m_targetEntityRef, this.m_gameInstance, entityIds);
    this.m_targetEntityID = entityIds[0];
    GameInstance
      .GetStatPoolsSystem(this.m_gameInstance)
      .RequestRegisteringListener(
        Cast<StatsObjectID>(this.m_targetEntityID),
        gamedataStatPoolType.Health,
        this.m_healthStatListener
      );
  }

  public final func UpdateHealthValue(newValue: Float) {
    this.m_healthController.SetNameplateBarProgress(newValue / 100.0, false);
    inkTextRef.SetText(this.m_healthPercentageRef, IntToString(Cast<Int32>(newValue)));
  }

  protected cb func OnUpdateEntityHealthListenersEvent(evt: questUpdateEntityHealthListenersEvent) -> Bool {
    if Equals(this.m_targetEntityRef, evt.entityRef) {
      GameInstance
        .GetStatPoolsSystem(this.m_gameInstance)
        .RequestUnregisteringListener(
          Cast<StatsObjectID>(this.m_targetEntityID),
          gamedataStatPoolType.Health,
          this.m_healthStatListener
        );
      this.RegisterHealthStatListener();
    }
  }
}

native class questUpdateEntityHealthListenersEvent extends Event {
  public native let entityRef: EntityReference;
}

native class MinimapStubMappinController extends BaseMinimapMappinController {
  private let m_regularIconContainer: inkCompoundRef;
  private let m_preventionVehicleIconContainer: inkCompoundRef;
  private let m_stubMappin: wref<StubMappin>;
  private let m_state: CName;

  protected func Intro() {
    this.m_stubMappin = this.GetMappin() as StubMappin;
    this.SetupStubWidget();
    super.Intro();
  }

  protected func ComputeRootState() -> CName {
    return this.m_state;
  }

  private final func SetupStubWidget() {
    let type = this.m_stubMappin.GetStubMappinType();
    if Equals(type, gameStubMappinType.Police) {
      this.m_state = n"Prevention_LightBlue";
      inkImageRef.SetTexturePart(this.iconWidget, n"enemyMappin-1");
      this.PlayLibraryAnimation(n"Show");
    } else if Equals(type, gameStubMappinType.PoliceVehicle) {
      this.m_state = n"Prevention_LightBlue";
      inkWidgetRef.SetVisible(this.m_regularIconContainer, false);
      inkWidgetRef.SetVisible(this.m_preventionVehicleIconContainer, true);
      this.m_aboveWidget.SetMargin(0.0, 0.0, 0.0, 48.0);
      this.m_belowWidget.SetMargin(0.0, 48.0, 0.0, 0.0);
      this.PlayLibraryAnimation(n"Show");
    } else if Equals(type, gameStubMappinType.Vehicle) {
      this.m_state = n"Neutral_Aggressive";
      inkImageRef.SetTexturePart(this.iconWidget, n"enemyMappin-1");
      this.PlayLibraryAnimation(n"Show");
    } else {
      this.m_state = n"Neutral_Aggressive";
      inkImageRef.SetTexturePart(this.iconWidget, n"enemyMappin");
    }
  }
}

class gearboxLogicController extends IVehicleModuleController {
  private let m_gearboxRImageWidget: inkImageRef;
  private let m_gearboxNImageWidget: inkImageRef;
  private let m_gearboxDImageWidget: inkImageRef;
  private let m_gearboxBBConnectionId: CallbackHandle;
  private let m_vehBB: wref<IBlackboard>;

  public func RegisterCallbacks(
    vehicle: wref<VehicleObject>,
    vehBB: wref<IBlackboard>,
    gameController: wref<vehicleUIGameController>
  ) {
    if IsDefined(vehBB) {
      if !IsDefined(this.m_gearboxBBConnectionId) {
        this.m_gearboxBBConnectionId = vehBB
          .RegisterListenerInt(GetAllBlackboardDefs().Vehicle.GearValue, this, n"OnGearBoxChanged");
        this.m_vehBB = vehBB;
      }
      this.ForceUpdate();
    }
  }

  public func UnregisterCallbacks() {
    if IsDefined(this.m_vehBB) {
      if IsDefined(this.m_gearboxBBConnectionId) {
        this
          .m_vehBB
          .UnregisterListenerInt(GetAllBlackboardDefs().Vehicle.GearValue, this.m_gearboxBBConnectionId);
      }
    }
  }

  protected final func ForceUpdate() {
    this
      .OnGearBoxChanged(this.m_vehBB.GetInt(GetAllBlackboardDefs().Vehicle.GearValue));
  }

  protected cb func OnUninitialize() -> Bool {
    if IsDefined(this.m_vehBB) {
      if IsDefined(this.m_gearboxBBConnectionId) {
        this
          .m_vehBB
          .UnregisterListenerInt(GetAllBlackboardDefs().Vehicle.GearValue, this.m_gearboxBBConnectionId);
      }
    }
  }

  public final func OnGearBoxChanged(gear: Int32) {
    if gear == 0 {
      inkWidgetRef.SetOpacity(this.m_gearboxRImageWidget, 1.0);
      inkWidgetRef.SetOpacity(this.m_gearboxNImageWidget, 0.0);
      inkWidgetRef.SetOpacity(this.m_gearboxDImageWidget, 0.1);
    } else if gear >= 0 {
      inkWidgetRef.SetOpacity(this.m_gearboxRImageWidget, 0.1);
      inkWidgetRef.SetOpacity(this.m_gearboxNImageWidget, 0.1);
      inkWidgetRef.SetOpacity(this.m_gearboxDImageWidget, 1.0);
    } else if gear <= 0 {
      inkWidgetRef.SetOpacity(this.m_gearboxRImageWidget, 0.1);
      inkWidgetRef.SetOpacity(this.m_gearboxNImageWidget, 1.1);
      inkWidgetRef.SetOpacity(this.m_gearboxDImageWidget, 0.1);
    }
  }
}

class VendorItemVirtualController extends inkVirtualCompoundItemController {
  public let m_data: VendorInventoryItemData;
  public let m_newData: VendorUIInventoryItemData;
  public let m_itemViewController: wref<InventoryItemDisplayController>;
  public let m_isSpawnInProgress: Bool;

  protected cb func OnInitialize() -> Bool {
    this.RegisterToCallback(n"OnSelected", this, n"OnSelected");
  }

  public final func OnDataChanged(value: Variant) {
    this.m_newData = FromVariant<IScriptable>(value) as VendorUIInventoryItemData;
    let displayToCreate = n"itemDisplay";
    if IsDefined(this.m_newData) {
      if this.m_newData.Item.IsWeapon() {
        displayToCreate = n"weaponDisplay";
      }
    } else {
      this.m_data = FromVariant<IScriptable>(value) as VendorInventoryItemData;
      if Equals(
        InventoryItemData.GetEquipmentArea(this.m_data.ItemData),
        gamedataEquipmentArea.Weapon
      ) {
        displayToCreate = n"weaponDisplay";
      }
    }
    if !this.m_isSpawnInProgress {
      if !IsDefined(this.m_itemViewController) {
        this.m_isSpawnInProgress = true;
        ItemDisplayUtils
          .AsyncSpawnCommonSlotController(this, this.GetRootWidget(), displayToCreate, n"OnSpawned");
      } else {
        this.UpdateControllerData();
      }
    }
  }

  protected cb func OnSpawned(widget: inkWidget, userData: IScriptable) -> Bool {
    this.m_isSpawnInProgress = false;
    this.m_itemViewController = widget.GetController() as InventoryItemDisplayController;
    this.UpdateControllerData();
  }

  private final func UpdateControllerData() {
    let applyDLCAddedIndicator: Bool;
    if IsDefined(this.m_newData) {
      if this.m_newData.IsVendorItem {
        this
          .m_itemViewController
          .Setup(
            this.m_newData.Item,
            this.m_newData.DisplayContextData,
            this.m_newData.IsEnoughMoney,
            false,
            false,
            this.m_newData.OverrideQuantity
          );
        applyDLCAddedIndicator = this.m_newData.Item.GetItemData().HasTag(n"DLCAdded") && this.m_data.IsDLCAddedActiveItem;
        this.m_itemViewController.SetDLCNewIndicator(applyDLCAddedIndicator);
      } else {
        this
          .m_itemViewController
          .Setup(this.m_newData.Item, this.m_newData.DisplayContextData);
        this.m_itemViewController.SetQuestBought(this.m_newData.IsQuestBought);
      }
      this.m_itemViewController.SetComparisonState(this.m_newData.ComparisonState);
      this.m_itemViewController.SetBuybackStack(this.m_newData.IsBuybackStack);
      this
        .m_itemViewController
        .SetIsPlayerFavourite(this.m_newData.Item.IsPlayerFavourite());
      return;
    } else if this.m_data.IsVendorItem {
      this
        .m_itemViewController
        .Setup(
          this.m_data.ItemData,
          ItemDisplayContext.Vendor,
          this.m_data.IsEnoughMoney
        );
      applyDLCAddedIndicator = InventoryItemData.GetGameItemData(this.m_data.ItemData).HasTag(n"DLCAdded") && this.m_data.IsDLCAddedActiveItem;
      this.m_itemViewController.SetDLCNewIndicator(applyDLCAddedIndicator);
    }
    this
      .m_itemViewController
      .Setup(this.m_data.ItemData, ItemDisplayContext.VendorPlayer);
    this.m_itemViewController.SetComparisonState(this.m_data.ComparisonState);
    this.m_itemViewController.SetBuybackStack(this.m_data.IsBuybackStack);
    this
      .m_itemViewController
      .SetIsPlayerFavourite(this.m_data.Item.IsPlayerFavourite());
  }

  protected cb func OnSelected(itemController: wref<inkVirtualCompoundItemController>, discreteNav: Bool) -> Bool {
    if discreteNav {
      let widget = this.GetRootWidget();
      this.SetCursorOverWidget(widget);
    }
  }
}

class VendorInventoryItemData extends WrappedInventoryItemData {
  public let IsVendorItem: Bool;
  public let IsEnoughMoney: Bool;
  public let IsBuybackStack: Bool;
  public let IsDLCAddedActiveItem: Bool;
}

