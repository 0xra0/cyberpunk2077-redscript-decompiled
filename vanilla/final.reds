class PlayerCombatStateTimePrereq extends IScriptablePrereq {
  private let m_minTime: Float;
  private let m_maxTime: Float;

  public const final func Evaluate(owner: GameObject, value: Float) -> Bool {
    let minCheck = false;
    let maxCheck = false;
    minCheck = this.m_minTime < 0.0 || value >= this.m_minTime;
    maxCheck = this.m_maxTime < 0.0 || value < this.m_maxTime;
    return minCheck && maxCheck;
  }

  protected func Initialize(recordID: TweakDBID) {
    this.m_minTime = TweakDBInterface.GetFloat(recordID + t".minTime", -1.0);
    this.m_maxTime = TweakDBInterface.GetFloat(recordID + t".maxTime", -1.0);
  }

  protected const func OnRegister(state: PrereqState, game: GameInstance, context: IScriptable) -> Bool {
    let castedState = state as PlayerCombatStateTimePrereqState;
    castedState.m_owner = context as GameObject;
    let player = context as PlayerPuppet;
    if IsDefined(player) {
      let bb = GameInstance
        .GetBlackboardSystem(player.GetGame())
        .Get(GetAllBlackboardDefs().PlayerPerkData);
      castedState.m_listener = bb
        .RegisterListenerFloat(
          GetAllBlackboardDefs().PlayerPerkData.CombatStateTime,
          castedState,
          n"OnStateUpdate"
        );
    }
    return false;
  }

  protected const func OnUnregister(state: PrereqState, game: GameInstance, context: IScriptable) {
    let player = context as PlayerPuppet;
    if IsDefined(player) {
      let bb = GameInstance
        .GetBlackboardSystem(player.GetGame())
        .Get(GetAllBlackboardDefs().PlayerPerkData);
      let castedState = state as PlayerCombatStateTimePrereqState;
      bb
        .UnregisterListenerFloat(
          GetAllBlackboardDefs().PlayerPerkData.CombatStateTime,
          castedState.m_listener
        );
    }
  }

  protected const func OnApplied(state: PrereqState, game: GameInstance, context: IScriptable) {
    let player = context as PlayerPuppet;
    if IsDefined(player) {
      let castedState = state as PlayerCombatStateTimePrereqState;
      castedState.OnChanged(this.IsFulfilled(player.GetGame(), context));
    }
  }

  protected const func IsFulfilled(game: GameInstance, context: IScriptable) -> Bool {
    let player = context as PlayerPuppet;
    let bb = GameInstance
      .GetBlackboardSystem(player.GetGame())
      .Get(GetAllBlackboardDefs().PlayerPerkData);
    let checkPassed = this
      .Evaluate(player, bb.GetFloat(GetAllBlackboardDefs().PlayerPerkData.CombatStateTime));
    return checkPassed;
  }
}

