  }
}

class ItemTooltipRecipeDataModule extends ItemTooltipModuleController {
  private let m_randomQualityLabel: inkTextRef;
  private let m_randomQualityWrapper: inkWidgetRef;
  private let m_statsLabel: inkTextRef;
  private let m_statsWrapper: inkWidgetRef;
  private let m_statsContainer: inkCompoundRef;
  private let m_damageTypesLabel: inkTextRef;
  private let m_damageTypesWrapper: inkWidgetRef;
  private let m_damageTypesContainer: inkCompoundRef;

  public func Update(data: MinimalItemTooltipData) {
    this.UpdateRandomQuality(data);
    this.UpdatemRecipeDamageTypes(data);
    this.UpdatemRecipeProperties(data);
  }

  private final func UpdateRandomQuality(data: MinimalItemTooltipData) {
    let itemRecord = TweakDBInterface.GetItemRecord(data.itemTweakID);
    if Equals(itemRecord.Quality().Type(), gamedataQuality.Random) && NotEquals(data.quality, gamedataQuality.Legendary) {
      let qualityParams = new inkTextParams();
      let nextQuality = RPGManager.GetNextItemQuality(data.itemData);
      let nextCraftingLevel = RPGManager.GetPlayerNextLevelBasedOnRandomQuality(nextQuality);
      qualityParams
        .AddString(
          "quality",
          GetLocalizedText(UIItemsHelper.QualityToDefaultString(nextQuality))
        );
      qualityParams.AddNumber("level", nextCraftingLevel);
      inkTextRef
        .SetLocalizedText(
          this.m_randomQualityLabel,
          n"UI-Tooltips-RandomQualityDesc",
          qualityParams
        );
      inkWidgetRef.SetVisible(this.m_randomQualityWrapper, true);
    } else {
      inkWidgetRef.SetVisible(this.m_randomQualityWrapper, false);
    }
  }

  private final func UpdatemRecipeDamageTypes(data: MinimalItemTooltipData) {
    let damagesTypesSize = ArraySize(data.recipeData.damageTypes);
    if damagesTypesSize > 0 {
      while inkCompoundRef.GetNumChildren(this.m_damageTypesContainer) > damagesTypesSize {
        inkCompoundRef.RemoveChildByIndex(this.m_damageTypesContainer, 0);
      }
      while inkCompoundRef.GetNumChildren(this.m_damageTypesContainer) < damagesTypesSize {
        this
          .SpawnFromLocal(inkWidgetRef.Get(this.m_damageTypesContainer), n"itemDetailsStat");
      }
      let i = 0;
      while i < damagesTypesSize {
        let stat = data.recipeData.damageTypes[i];
        let controller = inkCompoundRef.GetWidgetByIndex(this.m_damageTypesContainer, i).GetController() as ItemTooltipStatController;
        controller.SetData(stat);
        i += 1;
      }
      inkWidgetRef.SetVisible(this.m_damageTypesWrapper, true);
    } else {
      inkWidgetRef.SetVisible(this.m_damageTypesWrapper, false);
    }
  }

  private final func UpdatemRecipeProperties(data: MinimalItemTooltipData) {
    if ArraySize(data.recipeData.recipeStats) > 0 {
      let statsQuantityParams = new inkTextParams();
      statsQuantityParams.AddString("value", IntToString(data.recipeData.statsNumber));
      inkTextRef
        .SetLocalizedText(this.m_statsLabel, n"UI-Tooltips-RandomStatsNumber", statsQuantityParams);
      if inkCompoundRef.GetNumChildren(this.m_statsContainer) == 0 {
        let widget = this
          .SpawnFromLocal(inkWidgetRef.Get(this.m_statsContainer), n"itemTooltipRecipeStat");
      } else {
        widget = inkCompoundRef.GetWidgetByIndex(this.m_statsContainer, 0);
      }
      let controller = widget.GetController() as ItemRandomizedStatsController;
      controller.SetData(data.recipeData.recipeStats);
      inkWidgetRef.SetVisible(this.m_statsWrapper, true);
    } else {
      inkWidgetRef.SetVisible(this.m_statsWrapper, false);
    }
  }

  public func NEW_Update(data: wref<UIInventoryItem>);
}

