  public native let points: [Vector4];
}

native class PhoneWaveformGameController extends inkGameController {
  private let m_barItemName: CName;
  private let m_root: wref<inkCompoundWidget>;
  private let m_bars: [wref<inkWidget>];
  private let m_traces: [wref<inkWidget>];
  private let m_cachedRootSize: Vector2;
  private let m_maxValue: Float;
  private let m_barsPadding: Float;
  private let m_barSize: Vector2;

  public final native func SetMeasurementsCount(value: Int32);

  public final native func GetMeasurementsCount() -> Int32;

  public final native func SetMeasurementsIntreval(value: Float);

  public final native func GetMeasurementsIntreval() -> Float;

  public final func SetItemName(value: CName) {
    this.m_barItemName = value;
  }

  protected cb func OnInitialize() -> Bool {
    this.m_root = this.GetRootCompoundWidget();
    this.m_cachedRootSize = this.m_root.GetSize();
    this.InitWaveform();
  }

  protected cb func OnUpdate(audioData: gameuiPhoneWaveformData) -> Bool {
    if IsDefined(this.m_root) && this.m_root.IsVisible() {
      let rootSize = this.m_root.GetSize();
      if NotEquals(this.m_cachedRootSize, rootSize) {
        this.m_cachedRootSize = rootSize;
        this.InitWaveform();
      }
      this.UpdateWaveform(audioData.points);
    }
  }

  private final func InitWaveform() {
    let count = this.GetMeasurementsCount();
    this.m_barSize = new Vector2(
      (this.m_cachedRootSize.X - this.m_barsPadding * Cast<Float>(count)) / Cast<Float>(count),
      this.m_cachedRootSize.Y
    );
    while ArraySize(this.m_bars) > 0 {
      this.m_root.RemoveChild(ArrayPop(this.m_bars));
    }
    let i = 0;
    while i < count {
      let margin = new inkMargin(
        Cast<Float>(i) * this.m_barSize.X + this.m_barsPadding * Cast<Float>(i),
        this.m_cachedRootSize.Y,
        0.0,
        0.0
      );
      let bar = this.SpawnBar(margin);
      ArrayPush(this.m_bars, bar);
      bar = this.SpawnBar(margin);
      bar.SetOpacity(0.5);
      ArrayPush(this.m_traces, bar);
      i += 1;
    }
  }

  private final func SpawnBar(margin: inkMargin) -> wref<inkCompoundWidget> {
    let newBar = this.SpawnFromLocal(this.m_root, this.m_barItemName) as inkCompoundWidget;
    newBar.SetAnchorPoint(new Vector2(0.0, 1.0));
    newBar.SetRenderTransformPivot(new Vector2(0.0, 1.0));
    newBar.SetSize(new Vector2(0.0, 0.0));
    newBar.SetMargin(margin);
    return newBar;
  }

  private final func UpdateWaveform(const audioData: script_ref<[Vector4]>) {
    let count = ArraySize(this.m_bars);
    let i = 0;
    while i < count {
      let value = (this.m_maxValue - AbsF(audioData[i].Z)) / this.m_maxValue;
      if value > 0.0 {
        let rndValue = 0.75 * value + 0.25 * RandF();
      } else {
        rndValue = 0.0;
      }
      let bar = this.m_bars[i];
      let trace = this.m_traces[i];
      let size = this.FixSize(bar, rndValue);
      let traceSize = trace.GetSize();
      if size.Y > traceSize.Y {
        traceSize.Y = size.Y;
        traceSize.X = size.X;
      } else if traceSize.Y > 0.0 {
        traceSize.Y -= 2.0;
        if traceSize.Y < 0.0 {
          traceSize.Y = 0.0;
        }
      }
      trace.SetSize(traceSize);
      i += 1;
    }
  }

  private final func FixSize(bar: wref<inkWidget>, value: Float) -> Vector2 {
    let intX = RoundF(this.m_barSize.X);
    let intY = RoundF(this.m_barSize.Y * value);
    if !FloatIsEqual((Cast<Float>(intX) / 2.0), Cast<Float>(RoundF((Cast<Float>(intX) / 2.0)))) {
      intX += 1;
    } else if !FloatIsEqual((Cast<Float>(intY) / 2.0), Cast<Float>(RoundF((Cast<Float>(intY) / 2.0)))) {
      intY += 1;
    }
    let res = new Vector2(Cast<Float>(intX), Cast<Float>(intY));
    bar.SetSize(res);
    return res;
  }
}

