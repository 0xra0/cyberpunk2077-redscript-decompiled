class EngDemoContainer extends BaseSkillCheckContainer {
  public let m_engineeringCheck: EngineeringSkillCheck;
  public let m_demolitionCheck: DemolitionSkillCheck;

  public func Initialize(container: BaseSkillCheckContainer) {
    let myContainer = container as EngDemoContainer;
    if myContainer == null {
      return;
    } else if !IsDefined(this.m_engineeringCheckSlot) || !this.m_engineeringCheckSlot.IsPassed() {
      this.m_engineeringCheckSlot = myContainer.m_engineeringCheck;
      this.TryToInitialize(this.m_engineeringCheckSlot);
    } else if !IsDefined(this.m_demolitionCheckSlot) || !this.m_demolitionCheckSlot.IsPassed() {
      this.m_demolitionCheckSlot = myContainer.m_demolitionCheck;
      this.TryToInitialize(this.m_demolitionCheckSlot);
    }
    super.Initialize(container);
  }
}

