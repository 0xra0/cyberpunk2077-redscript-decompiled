public func CreateRagdollActivationRequestEvent(
  activationType: entragdollActivationRequestType,
  filterDataOverride: CName,
  applyPowerPose: Bool,
  applyMomentum: Bool,
  debugSourceName: CName
) -> RagdollActivationRequestEvent {
  let evt = new RagdollActivationRequestEvent();
  evt.data.type = activationType;
  evt.data.applyPowerPose = applyPowerPose;
  evt.data.applyMomentum = applyMomentum;
  evt.data.filterDataOverride = filterDataOverride;
  evt.DebugSetSourceName(debugSourceName);
  return evt;
}

