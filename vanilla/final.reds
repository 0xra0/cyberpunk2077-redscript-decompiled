class GrappleInteractionCondition extends InteractionScriptedCondition {
  public const final func Test(const activatorObject: wref<GameObject>, const hotSpotObject: wref<GameObject>) -> Bool {
    return this.IsAreaBetweenPlayerAndVictim(activatorObject, hotSpotObject);
  }

  protected const final func IsAreaBetweenPlayerAndVictim(const activatorObject: wref<GameObject>, const hotSpotObject: wref<GameObject>) -> Bool {
    let maxGrabDistOverCover = 1.3;
    let toHotSpot = hotSpotObject.GetWorldPosition() - activatorObject.GetWorldPosition();
    let distanceFromHotspot = Vector4.Length2D(toHotSpot);
    let behindCoverHeightDifferenceLockout = -0.5;
    if !SpatialQueriesHelper.HasSpaceInFront(activatorObject, toHotSpot, 1.3, 0.5, distanceFromHotspot, 0.4) {
      return false;
    } else if toHotSpot.Z
      < behindCoverHeightDifferenceLockout
      && !SpatialQueriesHelper
        .HasSpaceInFront(activatorObject, toHotSpot, 0.6, 0.5, distanceFromHotspot, 0.7) {
      return false;
    } else if distanceFromHotspot < maxGrabDistOverCover {
      return true;
    }
    return SpatialQueriesHelper
      .HasSpaceInFront(
        hotSpotObject,
        toHotSpot * -1.0,
        0.6,
        0.5,
        distanceFromHotspot - maxGrabDistOverCover,
        1.1
      );
  }
}

