      let index = QuicksortInventoryItemData.Partition(items, comparator, leftIndex, rightIndex);
      if leftIndex < index - 1 {
        QuicksortInventoryItemData.Sort(items, comparator, leftIndex, index - 1);
      } else if index < rightIndex {
        QuicksortInventoryItemData.Sort(items, comparator, index, rightIndex);
      }
    }
  }

  private final static func Partition(
    items: script_ref<[InventoryItemData]>,
    comparator: InventoryItemDataComparator,
    leftIndex: Int32,
    rightIndex: Int32
  ) -> Int32 {
    let i = leftIndex;
    let j = rightIndex;
    let pivot = items[FloorF((Cast<Float>(rightIndex) + Cast<Float>(leftIndex)) / 2.0)];
    while i <= j {
      while comparator.Compare(items[i], pivot) > 0 {
        i += 1;
      }
      while comparator.Compare(items[j], pivot) < 0 {
        j -= 1;
      }
      if i <= j {
        let tempItem = items[i];
        items[i] = items[j];
        items[j] = tempItem;
        i += 1;
        j -= 1;
      }
    }
    return i;
  }
}

