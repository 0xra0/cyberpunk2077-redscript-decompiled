abstract class AISubActionCallSquadSearchBackUp_Record_Implementation extends IScriptable {
  public final static func Activate(
    context: ScriptExecutionContext,
    record: wref<AISubActionCallSquadSearchBackUp_Record>
  ) {
    if record.Delay() == 0.0 {
      AISubActionCallSquadSearchBackUp_Record_Implementation.CallBackup(context, record);
    }
  }

  public final static func Update(
    context: ScriptExecutionContext,
    record: wref<AISubActionCallSquadSearchBackUp_Record>,
    const duration: Float
  ) -> AIbehaviorUpdateOutcome {
    if record.Delay() <= 0.0 {
      return AIbehaviorUpdateOutcome.SUCCESS;
    } else if record.Delay() > 0.0 && duration >= record.Delay() {
      AISubActionCallSquadSearchBackUp_Record_Implementation.CallBackup(context, record);
      return AIbehaviorUpdateOutcome.SUCCESS;
    }
    return AIbehaviorUpdateOutcome.IN_PROGRESS;
  }

  public final static func Deactivate(
    context: ScriptExecutionContext,
    record: wref<AISubActionCallSquadSearchBackUp_Record>,
    const duration: Float,
    interrupted: Bool
  ) {
    if record.Delay() < 0.0 {
      AISubActionCallSquadSearchBackUp_Record_Implementation.CallBackup(context, record);
    }
  }

  public final static func CallBackup(
    context: ScriptExecutionContext,
    record: wref<AISubActionCallSquadSearchBackUp_Record>
  ) {
    let psi: PuppetSquadInterface;
    let membersDistances: [Float];
    let memberObject: GameObject;
    let i: Int32;
    let commsCallEffects: [StatusEffect];
    let whistleEffects: [StatusEffect];
    let owner = ScriptExecutionContext.GetOwner(context);
    let numberOfTargets = 1;
    let maxDistance = 0.0;
    AISquadHelper.GetSquadBaseInterface(owner, psi);
    let members = psi.ListMembersWeak();
    ArrayRemove(members, owner);
    if ArraySize(members) == 0 {
      return;
    } else if record.UseCommsCallLogic() || record.NumberOfTargets() > 0.0 {
      let ownerPosition = owner.GetWorldPosition();
      i = 0;
      if i < ArraySize(members) {
        let diff = members[i].GetWorldPosition() - ownerPosition;
        let distance = Vector4.Length(diff);
        ArrayPush(membersDistances, distance);
        i += 1;
      }
      i = 0;
      if i < ArraySize(members) - 1 {
        let j = 0;
        if j < ArraySize(members) - i - 1 {
          if membersDistances[j] > membersDistances[j + 1] {
            let member = members[j];
            members[j] = members[j + 1];
            members[j + 1] = member;
            distance = membersDistances[j];
            membersDistances[j] = membersDistances[j + 1];
            membersDistances[j + 1] = distance;
          }
          j += 1;
        }
        i += 1;
      } else if !record.UseCommsCallLogic() {
        let broadcaster = owner.GetStimBroadcasterComponent();
        if !IsDefined(broadcaster) {
          return;
        }
        i = 0;
        if i
          < ArraySize(members)
          && (record.NumberOfTargets() <= 0.0 || i < Cast<Int32>(record.NumberOfTargets())) {
          memberObject = members[i] as GameObject;
          broadcaster
            .SendDrirectStimuliToTarget(owner, gamedataStimType.Call, memberObject);
          i += 1;
        }
        return;
      }
    }
    StatusEffectHelper.GetAppliedEffectsWithTag(owner, n"CommsCallIn", commsCallEffects);
    if ArraySize(commsCallEffects) == 0 {
      return;
    }
    StatusEffectHelper.GetAppliedEffectsWithTag(owner, n"Whistle", whistleEffects);
    if ArraySize(whistleEffects) > 0 {
      if StatusEffectSystem.ObjectHasStatusEffectWithTag(owner, n"CommsCallInMultipleOnWhistle") {
        numberOfTargets = 4;
      } else if StatusEffectSystem.ObjectHasStatusEffectWithTag(owner, n"CommsCallInMultipleOnWhistle2") {
        numberOfTargets = 5;
      }
      if whistleEffects[0].GetLastApplicationSimTimestamp() < commsCallEffects[0].GetLastApplicationSimTimestamp() {
        StatusEffectHelper.RemoveStatusEffectsWithTag(owner, n"Whistle");
        let ownerReactionComp = (owner as ScriptedPuppet).GetStimReactionComponent();
        if IsDefined(ownerReactionComp)
          && Equals(ownerReactionComp.GetPendingReactionName(), gamedataOutput.PlayerCall) {
          ownerReactionComp.ClearPendingReaction();
        }
      }
    }
    let statsSystem = GameInstance.GetStatsSystem(owner.GetGame());
    let player = GameInstance.GetPlayerSystem(owner.GetGame()).GetLocalPlayerControlledGameObject();
    maxDistance = statsSystem
      .GetStatValue(
        Cast<StatsObjectID>(player.GetEntityID()),
        gamedataStatType.CommsCallDistance
      );
    let combatVersion = StatusEffectSystem.ObjectHasStatusEffectWithTag(owner, n"CombatCommsCallIn");
    let remainingDuration = commsCallEffects[0].GetRemainingDuration();
    if record.Invert() {
      memberObject = members[0] as GameObject;
      i = 1;
      if i < ArraySize(members) {
        if membersDistances[i] > maxDistance {
        } else {
          memberObject = members[i] as GameObject;
          i += 1;
        }
      }
      AISubActionCallSquadSearchBackUp_Record_Implementation
        .CallBackupOneTarget(memberObject, owner, combatVersion, remainingDuration, true);
      return;
    }
    let calledCount = 0;
    let skippedCount = 0;
    let minDistance = 4.0;
    let minSkipThreshold = 2;
    i = 0;
    if i < ArraySize(members) && calledCount < numberOfTargets {
      if i > 0 && membersDistances[i] > maxDistance {
      } else if i < minSkipThreshold && membersDistances[i] < minDistance {
        skippedCount += 1;
      } else {
        memberObject = members[i] as GameObject;
        AISubActionCallSquadSearchBackUp_Record_Implementation
          .CallBackupOneTarget(owner, memberObject, combatVersion, remainingDuration, false);
        calledCount += 1;
        i += 1;
      }
    }
    i = 0;
    while i < skippedCount && calledCount < numberOfTargets {
      memberObject = members[i] as GameObject;
      AISubActionCallSquadSearchBackUp_Record_Implementation
        .CallBackupOneTarget(owner, memberObject, combatVersion, remainingDuration, false);
      calledCount += 1;
      i += 1;
    }
  }

  private final static func CallBackupOneTarget(
    source: GameObject,
    target: GameObject,
    combatVersion: Bool,
    remainingDuration: Float,
    purelyDirect: Bool
  ) {
    let broadcaster = source.GetStimBroadcasterComponent();
    if !IsDefined(broadcaster) {
      return;
    }
    broadcaster
      .SendDrirectStimuliToTarget(
        source,
        combatVersion ? gamedataStimType.CombatCall : gamedataStimType.Call,
        target,
        purelyDirect
      );
    if combatVersion {
      StatusEffectHelper
        .ApplyStatusEffectForTimeWindow(
          target,
          t"BaseStatusEffect.CommsCallCombatTargetHelper",
          source.GetEntityID(),
          0.0,
          remainingDuration
        );
    }
  }
}

importonly native class AISubActionCallSquadSearchBackUp_Record extends AISubAction_Record {
  public final native func Target() -> wref<AIActionTarget_Record>;

  public final native func TargetHandle() -> AIActionTarget_Record;

  public final native func Delay() -> Float;

  public final native func NumberOfTargets() -> Float;

  public final native func UseCommsCallLogic() -> Bool;

  public final native func Invert() -> Bool;
}

