  public final func IsStateValidForVehicle(state: VehicleDoorInteractionState) -> Bool {
    if this.GetOwnerEntity() == this.GetOwnerEntity() as TankObject {
      if Equals(state, VehicleDoorInteractionState.Locked)
        || Equals(state, VehicleDoorInteractionState.Reserved)
        || Equals(state, VehicleDoorInteractionState.QuestLocked) {
        return false;
      }
    }
    return true;
  }

