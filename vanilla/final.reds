class PerksMenuAttributeDisplayController extends BaseButtonView {
  protected let m_widgetWrapper: inkWidgetRef;
  protected let m_foregroundWrapper: inkWidgetRef;
  protected let m_attributeName: inkTextRef;
  protected let m_attributeIcon: inkImageRef;
  protected let m_attributeLevel: inkTextRef;
  protected let m_frameHovered: inkWidgetRef;
  protected let m_accent1Hovered: inkWidgetRef;
  protected let m_accent1BGHovered: inkWidgetRef;
  protected let m_accent2Hovered: inkWidgetRef;
  protected let m_accent2BGHovered: inkWidgetRef;
  protected let m_topConnectionContainer: inkWidgetRef;
  protected let m_bottomConnectionContainer: inkWidgetRef;
  protected let m_levelContainer: inkWidgetRef;
  protected let m_dataManager: PlayerDevelopmentDataManager;
  protected let m_attribute: PerkMenuAttribute;
  protected let m_attributeData: AttributeData;

  protected cb func OnInitialize() -> Bool {
    this.ResetHoverOpacity();
    super.OnInitialize();
  }

  public final func Setup(attribute: PerkMenuAttribute, dataManager: PlayerDevelopmentDataManager) {
    this.m_dataManager = dataManager;
    this.m_attribute = attribute;
    this.m_attributeData = dataManager.GetAttribute(this.m_dataManager.GetAttributeRecordIDFromEnum(attribute));
    inkWidgetRef
      .SetVisible(this.m_levelContainer, NotEquals(attribute, PerkMenuAttribute.Espionage));
    this
      .GetRootWidget()
      .SetState(
        NotEquals(attribute, PerkMenuAttribute.Espionage) ? n"Default" : n"Espionage"
      );
    this.ResetHoverOpacity();
    this.Update();
  }

  public final func UpdateData(attributeData: AttributeData) {
    this.m_attributeData = attributeData;
    this.Update();
  }

  public final func GetStatType() -> gamedataStatType {
    return this.m_attributeData.type;
  }

  public final func SetHovered(value: Bool) {
    this.PlayHoverAnimation(value);
    inkWidgetRef.SetState(this.m_widgetWrapper, value ? n"Hovered" : n"Default");
    if Equals(this.m_attribute, PerkMenuAttribute.Johnny) {
      inkWidgetRef
        .Get(this.m_widgetWrapper)
        .SetEffectEnabled(inkEffectType.Glitch, n"Glitch_0", value);
    }
  }

  public final func GetAttributeData() -> AttributeData {
    return this.m_attributeData;
  }

  protected final func Update() {
    this.UpdateConnections();
    if Equals(this.m_attribute, PerkMenuAttribute.Johnny) {
      return;
    }
    this.UpdateIcon();
    this.UpdateName();
    this.UpdateLevel();
  }

  protected final func UpdateIcon() {
    let relicIcon = r"base\\gameplay\\gui\\fullscreen\\perks\\atlas_perks.inkatlas";
    let attributeIcon = r"base\\gameplay\\gui\\common\\icons\\attributes_icons.inkatlas";
    if Equals(this.m_attribute, PerkMenuAttribute.Espionage) {
      inkImageRef.SetAtlasResource(this.m_attributeIcon, relicIcon);
      inkImageRef.SetTexturePart(this.m_attributeIcon, n"ico_atrib_relic");
    } else {
      inkImageRef.SetAtlasResource(this.m_attributeIcon, attributeIcon);
      inkImageRef
        .SetTexturePart(
          this.m_attributeIcon,
          PerkAttributeHelper.GetIconAtlasPart(this.m_attribute)
        );
    }
  }

  protected final func UpdateName() {
    inkTextRef.SetText(this.m_attributeName, this.m_attributeData.label);
  }

  protected final func UpdateLevel() {
    inkTextRef.SetText(this.m_attributeLevel, IntToString(this.m_attributeData.value));
  }

  protected final func UpdateConnections() {
    inkWidgetRef
      .SetState(
        this.m_topConnectionContainer,
        PerkAttributeHelper.GetTopConnectionState(this.m_attribute)
      );
    inkWidgetRef
      .SetState(
        this.m_bottomConnectionContainer,
        PerkAttributeHelper.GetBottomConnectionState(this.m_attribute)
      );
  }

  protected final func PlayHoverAnimation(value: Bool) {
    let transparencyAnimation = new inkAnimDef();
    let transparencyAnimation2 = new inkAnimDef();
    let transparencyInterpolator = new inkAnimTransparency();
    transparencyInterpolator.SetDuration(0.35);
    transparencyInterpolator.SetDirection(inkanimInterpolationDirection.To);
    transparencyInterpolator.SetType(inkanimInterpolationType.Linear);
    transparencyInterpolator.SetMode(inkanimInterpolationMode.EasyIn);
    transparencyInterpolator.SetEndTransparency(value ? 1.0 : 0.002);
    let transparencyInterpolator2 = new inkAnimTransparency();
    transparencyInterpolator2.SetDuration(0.35);
    transparencyInterpolator2.SetDirection(inkanimInterpolationDirection.To);
    transparencyInterpolator2.SetType(inkanimInterpolationType.Linear);
    transparencyInterpolator2.SetMode(inkanimInterpolationMode.EasyIn);
    transparencyInterpolator2.SetEndTransparency(value ? 0.133 : 0.002);
    transparencyAnimation.AddInterpolator(transparencyInterpolator);
    transparencyAnimation2.AddInterpolator(transparencyInterpolator2);
    inkWidgetRef.PlayAnimation(this.m_frameHovered, transparencyAnimation);
    inkWidgetRef.PlayAnimation(this.m_accent1Hovered, transparencyAnimation);
    inkWidgetRef.PlayAnimation(this.m_accent2Hovered, transparencyAnimation);
    inkWidgetRef.PlayAnimation(this.m_accent1BGHovered, transparencyAnimation2);
    inkWidgetRef.PlayAnimation(this.m_accent2BGHovered, transparencyAnimation2);
  }

  public final func PlayAnimation(animation: CName) -> inkAnimProxy {
    return this.PlayLibraryAnimation(animation);
  }

  private final func ResetHoverOpacity() {
    inkWidgetRef.SetOpacity(this.m_frameHovered, 0.0);
    inkWidgetRef.SetOpacity(this.m_accent1Hovered, 0.0);
    inkWidgetRef.SetOpacity(this.m_accent2Hovered, 0.0);
    inkWidgetRef.SetOpacity(this.m_accent1BGHovered, 0.0);
    inkWidgetRef.SetOpacity(this.m_accent2BGHovered, 0.0);
  }
}

class WorldMapTooltipContainer extends inkLogicController {
  protected let m_defaultTooltip: inkWidgetRef;
  protected let m_policeTooltip: inkWidgetRef;
  protected let m_defaultTooltipController: wref<WorldMapTooltipBaseController>;
  protected let m_policeTooltipController: wref<WorldMapTooltipBaseController>;
  protected let m_tooltips: [wref<WorldMapTooltipBaseController>; 3];
  protected let m_currentVisibleIndex: Int32;

  protected cb func OnInitialize() -> Bool {
    this.m_defaultTooltipController = inkWidgetRef.GetController(this.m_defaultTooltip) as WorldMapTooltipBaseController;
    this.m_policeTooltipController = inkWidgetRef.GetController(this.m_policeTooltip) as WorldMapTooltipBaseController;
    this.m_tooltips[1] = this.m_policeTooltipController;
    this.m_tooltips[2] = this.m_defaultTooltipController;
    this.HideAll(true);
  }

  public final func Show(target: WorldMapTooltipType) {
    let newController = this.GetTooltipController(target);
    let priority = this.GetControllerPriorityIndex(newController);
    if priority == this.m_currentVisibleIndex {
      return;
    } else if newController.m_active || newController.m_visible {
      return;
    }
    newController.m_active = true;
    if this.m_currentVisibleIndex != -1 {
      let oldController = this.m_tooltips[this.m_currentVisibleIndex];
      if this.m_currentVisibleIndex < priority {
        oldController.HideInstant();
        newController.Show();
        this.m_currentVisibleIndex = priority;
      } else {
        newController.Show();
        this.m_currentVisibleIndex = priority;
      }
    }
  }

  public final func Hide(target: WorldMapTooltipType) {
    let shouldHideInstant = false;
    let oldController = this.GetTooltipController(target);
    let priority = this.GetControllerPriorityIndex(oldController);
    oldController.m_active = false;
    if oldController.m_visible {
      if this.m_currentVisibleIndex != -1 && this.m_currentVisibleIndex == priority {
        this.m_currentVisibleIndex = this.m_currentVisibleIndex - 1;
        if this.m_currentVisibleIndex >= 0 {
          let newController = this.m_tooltips[this.m_currentVisibleIndex];
          if newController.m_active {
            newController.Show();
            shouldHideInstant = true;
          } else {
            this.m_currentVisibleIndex -= 1;
          }
        } else if shouldHideInstant {
          oldController.HideInstant();
        }
      }
      oldController.Hide();
    }
  }

  public final func HideAll(opt force: Bool) {
    let total = ArraySize(this.m_tooltips);
    let i = 0;
    while i < total {
      this.m_tooltips[i].m_active = false;
      this.m_tooltips[i].HideInstant(force);
      i += 1;
    }
  }

  public final func SetData(
    target: WorldMapTooltipType,
    const data: script_ref<WorldMapTooltipData>,
    menu: WorldMapMenuGameController
  ) {
    this.GetTooltipController(target).SetData(data, menu);
  }

  public final func PlayPaymentErrorAnimation() {
    this
      .GetTooltipController(WorldMapTooltipType.Default)
      .PlayLibraryAnimation(n"NotEnoughMoney");
  }

  private final func GetTooltipController(type: WorldMapTooltipType) -> wref<WorldMapTooltipBaseController> {
    switch type {
      case WorldMapTooltipType.Police:
        return this.m_policeTooltipController;
    }
    return this.m_defaultTooltipController;
  }

  private final func GetControllerPriorityIndex(controller: wref<WorldMapTooltipBaseController>) -> Int32 {
    let total = ArraySize(this.m_tooltips);
    let i = 0;
    while i < total {
      if this.m_tooltips[i] == controller {
        return i;
      }
      i += 1;
    }
    return -1;
  }
}

