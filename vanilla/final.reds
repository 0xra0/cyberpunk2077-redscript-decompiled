class FocusModeOperationsTrigger extends DeviceOperationsTrigger {
  public let m_triggerData: FocusModeOperationTriggerData;

  public final func EvaluateTrigger(
    owner: wref<GameObject>,
    operationType: ETriggerOperationType,
    container: DeviceOperationsContainer
  ) {
    if Equals(this.m_triggerData.operationType, operationType) {
      if Equals(this.m_triggerData.operationType, ETriggerOperationType.ENTER) && this.m_triggerData.isLookedAt && !this.IsLookedAt(owner) {
        return;
      }
      this.ResolveOperationsOnTrigger(this.m_triggerData, owner, container);
    }
  }

  private final func IsLookedAt(object: GameObject) -> Bool {
    let lookedAtObect = GameInstance
      .GetTargetingSystem(object.GetGame())
      .GetLookAtObject(
        GameInstance.GetPlayerSystem(object.GetGame()).GetLocalPlayerMainGameObject() as PlayerPuppet
      );
    return lookedAtObect == object;
  }
}

class FocusModeOperationTriggerData extends DeviceOperationTriggerData {
  public let operationType: ETriggerOperationType;
  public let isLookedAt: Bool;
}

