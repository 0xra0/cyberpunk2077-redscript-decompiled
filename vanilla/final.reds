class AIActionChecks extends IScriptable {
  public final static func CheckOwnerState(
    puppet: ScriptedPuppet,
    const npcStates: script_ref<AIActionNPCStates>,
    checkAll: Bool
  ) -> Bool {
    if !IsDefined(puppet) {
      return true;
    } else if checkAll {
      return AIActionChecks.CheckAllNPCStateTypes(puppet, npcStates);
    }
    return AIActionChecks.CheckNPCState(puppet, npcStates);
  }

  public final static func CheckTargetState(
    target: ScriptedPuppet,
    const targetStates: script_ref<AIActionTargetStates>,
    checkAll: Bool
  ) -> Bool {
    if !IsDefined(target) {
      return true;
    } else if target.IsPlayer() {
      if checkAll {
        return AIActionChecks.CheckAllPlayerStateTypes(target, targetStates.playerStates);
      }
      return AIActionChecks.CheckPlayerState(target, targetStates.playerStates);
    }
    break;
    if target.IsNPC() {
      if checkAll {
        return AIActionChecks.CheckAllNPCStateTypes(target, targetStates.npcStates);
      }
      return AIActionChecks.CheckNPCState(target, targetStates.npcStates);
    }
    return true;
  }

  public final static func CheckAllNPCStateTypes(puppet: ScriptedPuppet, const npcStates: script_ref<AIActionNPCStates>) -> Bool {
    if ArraySize(npcStates.highLevelStates)
      == 0
      && ArraySize(npcStates.upperBodyStates) == 0
      && ArraySize(npcStates.stanceStates) == 0
      && ArraySize(npcStates.behaviorStates) == 0
      && ArraySize(npcStates.defenseMode) == 0
      && ArraySize(npcStates.locomotionMode) == 0 {
      return true;
    } else if ArraySize(npcStates.highLevelStates) > 0 && !AIActionChecks.CheckHighLevelState(puppet, npcStates.highLevelStates) {
      return false;
    } else if ArraySize(npcStates.upperBodyStates) > 0 && !AIActionChecks.CheckUpperBodyState(puppet, npcStates.upperBodyStates) {
      return false;
    } else if ArraySize(npcStates.stanceStates) > 0 && !AIActionChecks.CheckStanceState(puppet, npcStates.stanceStates) {
      return false;
    } else if ArraySize(npcStates.behaviorStates) > 0 && !AIActionChecks.CheckBehaviorState(puppet, npcStates.behaviorStates) {
      return false;
    } else if ArraySize(npcStates.locomotionMode) > 0 && !AIActionChecks.CheckLocomotionMode(puppet, npcStates.locomotionMode) {
      return false;
    } else if ArraySize(npcStates.defenseMode) > 0 && !AIActionChecks.CheckDefenseMode(puppet, npcStates.defenseMode) {
      return false;
    }
    return true;
  }

  public final static func CheckNPCState(puppet: ScriptedPuppet, const npcStates: script_ref<AIActionNPCStates>) -> Bool {
    if ArraySize(npcStates.highLevelStates)
      == 0
      && ArraySize(npcStates.upperBodyStates) == 0
      && ArraySize(npcStates.stanceStates) == 0
      && ArraySize(npcStates.behaviorStates) == 0
      && ArraySize(npcStates.defenseMode) == 0
      && ArraySize(npcStates.locomotionMode) == 0 {
      return true;
    } else if ArraySize(npcStates.highLevelStates) > 0 && AIActionChecks.CheckHighLevelState(puppet, npcStates.highLevelStates) {
      return true;
    } else if ArraySize(npcStates.upperBodyStates) > 0 && AIActionChecks.CheckUpperBodyState(puppet, npcStates.upperBodyStates) {
      return true;
    } else if ArraySize(npcStates.stanceStates) > 0 && AIActionChecks.CheckStanceState(puppet, npcStates.stanceStates) {
      return true;
    } else if ArraySize(npcStates.behaviorStates) > 0 && AIActionChecks.CheckBehaviorState(puppet, npcStates.behaviorStates) {
      return true;
    } else if ArraySize(npcStates.locomotionMode) > 0 && AIActionChecks.CheckLocomotionMode(puppet, npcStates.locomotionMode) {
      return true;
    } else if ArraySize(npcStates.defenseMode) > 0 && AIActionChecks.CheckDefenseMode(puppet, npcStates.defenseMode) {
      return true;
    }
    return false;
  }

  public final static func CheckAllPlayerStateTypes(playerPuppet: ScriptedPuppet, const playerStates: script_ref<AIActionPlayerStates>) -> Bool {
    if ArraySize(playerStates.locomotionStates)
      == 0
      && ArraySize(playerStates.upperBodyStates) == 0
      && ArraySize(playerStates.meleeStates) == 0
      && ArraySize(playerStates.zoneStates) == 0
      && ArraySize(playerStates.bodyCarryStates) == 0
      && ArraySize(playerStates.combatStates) == 0 {
      return true;
    } else if ArraySize(playerStates.locomotionStates)
      > 0
      && !AIActionChecks.CheckPSMLocomotionState(playerPuppet, playerStates.locomotionStates) {
      return false;
    } else if ArraySize(playerStates.upperBodyStates)
      > 0
      && !AIActionChecks.CheckPSMUpperBodyState(playerPuppet, playerStates.upperBodyStates) {
      return false;
    } else if ArraySize(playerStates.meleeStates)
      > 0
      && !AIActionChecks.CheckPSMMeleeState(playerPuppet, playerStates.meleeStates) {
      return false;
    } else if ArraySize(playerStates.zoneStates)
      > 0
      && !AIActionChecks.CheckPSMZoneState(playerPuppet, playerStates.zoneStates) {
      return false;
    } else if ArraySize(playerStates.bodyCarryStates)
      > 0
      && !AIActionChecks.CheckPSMBodyCarryState(playerPuppet, playerStates.bodyCarryStates) {
      return false;
    } else if ArraySize(playerStates.combatStates)
      > 0
      && !AIActionChecks.CheckPSMCombatState(playerPuppet, playerStates.combatStates) {
      return false;
    }
    return true;
  }

  public final static func CheckPlayerState(playerPuppet: ScriptedPuppet, const playerStates: script_ref<AIActionPlayerStates>) -> Bool {
    if ArraySize(playerStates.locomotionStates)
      == 0
      && ArraySize(playerStates.upperBodyStates) == 0
      && ArraySize(playerStates.meleeStates) == 0
      && ArraySize(playerStates.zoneStates) == 0
      && ArraySize(playerStates.bodyCarryStates) == 0
      && ArraySize(playerStates.combatStates) == 0 {
      return true;
    } else if ArraySize(playerStates.locomotionStates)
      > 0
      && AIActionChecks.CheckPSMLocomotionState(playerPuppet, playerStates.locomotionStates) {
      return true;
    } else if ArraySize(playerStates.upperBodyStates)
      > 0
      && AIActionChecks.CheckPSMUpperBodyState(playerPuppet, playerStates.upperBodyStates) {
      return true;
    } else if ArraySize(playerStates.meleeStates)
      > 0
      && AIActionChecks.CheckPSMMeleeState(playerPuppet, playerStates.meleeStates) {
      return true;
    } else if ArraySize(playerStates.zoneStates)
      > 0
      && AIActionChecks.CheckPSMZoneState(playerPuppet, playerStates.zoneStates) {
      return true;
    } else if ArraySize(playerStates.bodyCarryStates)
      > 0
      && AIActionChecks.CheckPSMBodyCarryState(playerPuppet, playerStates.bodyCarryStates) {
      return true;
    } else if ArraySize(playerStates.combatStates)
      > 0
      && AIActionChecks.CheckPSMCombatState(playerPuppet, playerStates.combatStates) {
      return true;
    }
    return false;
  }

  public final static func CheckHighLevelState(
    puppet: ScriptedPuppet,
    const highLevelStates: script_ref<[gamedataNPCHighLevelState]>
  ) -> Bool {
    let currentHighLevelState = IntEnum<gamedataNPCHighLevelState>(
      puppet
        .GetPuppetStateBlackboard()
        .GetInt(GetAllBlackboardDefs().PuppetState.HighLevel)
    );
    if !ArrayContains(highLevelStates, currentHighLevelState) {
      return false;
    }
    return true;
  }

  public final static func CheckUpperBodyState(
    puppet: ScriptedPuppet,
    const upperBodyStates: script_ref<[gamedataNPCUpperBodyState]>
  ) -> Bool {
    let currentUpperBodyState = IntEnum<gamedataNPCUpperBodyState>(
      puppet
        .GetPuppetStateBlackboard()
        .GetInt(GetAllBlackboardDefs().PuppetState.UpperBody)
    );
    if !IsDefined(puppet) || !ArrayContains(upperBodyStates, currentUpperBodyState) {
      return false;
    }
    return true;
  }

