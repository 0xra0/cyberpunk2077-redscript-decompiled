class HitOrMissTriggeredPrereqState extends GenericHitPrereqState {
  public func OnMissTriggered(missEvent: gameMissEvent) {
    if Vector4.IsXYZZero(missEvent.hitPosition) {
      return;
    }
    super.OnMissTriggered(missEvent);
    let hitEvent = new gameHitEvent();
    hitEvent.attackData = missEvent.attackData;
    hitEvent.hitPosition = missEvent.hitPosition;
    hitEvent.hitDirection = missEvent.hitDirection;
    hitEvent.attackPentration = missEvent.attackPentration;
    hitEvent.hasPiercedTechSurface = missEvent.hasPiercedTechSurface;
    hitEvent.attackComputed = missEvent.attackComputed;
    this.SetHitEvent(hitEvent);
    let checkPassed = this.Evaluate(hitEvent);
    if checkPassed {
      this.OnChangedRepeated(false);
    }
  }
}

class HitIsMovingPrereqState extends GenericHitPrereqState {
  public func Evaluate(hitEvent: gameHitEvent) -> Bool {
    let prereq = this.GetPrereq() as HitIsMovingPrereq;
    let objectToCheck = this.GetObjectToCheck(prereq.m_object, hitEvent) as gamePuppet;
    if IsDefined(objectToCheck) {
      if prereq.m_isMoving {
        return Vector4.Length2D(objectToCheck.GetVelocity()) > 0.4;
      }
      return Vector4.Length2D(objectToCheck.GetVelocity()) <= 0.1;
    }
    return false;
  }
}

