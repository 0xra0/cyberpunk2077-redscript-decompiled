class DoorStateOperationsTrigger extends DeviceOperationsTrigger {
  protected let m_triggerData: DoorStateOperationTriggerData;
  private let m_wasStateCached: Bool;
  private let m_cachedState: EDoorStatus;

  public final func EvaluateTrigger(
    state: EDoorStatus,
    owner: wref<GameObject>,
    container: DeviceOperationsContainer
  ) {
    if this.m_wasStateCached && Equals(this.m_cachedState, state) {
      return;
    }
    this.m_cachedState = state;
    this.m_wasStateCached = true;
    if this.m_triggerData == null {
      return;
    } else if Equals(this.m_triggerData.state, state) {
      this.ResolveOperationsOnTrigger(this.m_triggerData, owner, container);
    }
  }
}

class DoorStateOperationTriggerData extends DeviceOperationTriggerData {
  public let state: EDoorStatus;
}

