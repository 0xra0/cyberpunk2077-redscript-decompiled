class ShouldNPCReEquipWeaponOnDismount extends AIbehaviorconditionScript {
  protected func Check(context: ScriptExecutionContext) -> AIbehaviorConditionOutcomes {
    let vehicle: wref<GameObject>;
    let vehicleID: EntityID;
    let vehicleSlotID: MountingSlotId;
    let owner = ScriptExecutionContext.GetOwner(context);
    let gameInstance = owner.GetGame();
    if AIBehaviorScriptBase.GetAIComponent(context).GetAssignedVehicle(gameInstance, vehicle) {
      if AIBehaviorScriptBase
        .GetAIComponent(context)
        .GetAssignedVehicleData(vehicleID, vehicleSlotID) {
        if !VehicleComponent
          .GetDriverMounted(ScriptExecutionContext.GetOwner(context).GetGame(), vehicleID)
          .IsPlayer() {
          let bike = vehicle as BikeObject;
          if IsDefined(bike) {
            if !VehicleComponent
              .IsDestroyed(ScriptExecutionContext.GetOwner(context).GetGame(), vehicleID) {
              return AIbehaviorConditionOutcomes.False;
            }
          }
        }
      }
    }
    return AIbehaviorConditionOutcomes.True;
  }
}

