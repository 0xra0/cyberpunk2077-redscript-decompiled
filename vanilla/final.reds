class UiQuickHackPanelContextDecisions extends InputContextTransitionDecisions {
  protected const func EnterCondition(const stateContext: StateContext, const scriptInterface: StateGameScriptInterface) -> Bool {
    if this.IsQuickHackPanelOpened(scriptInterface) && this.CheckRequiredStates(scriptInterface) {
      return true;
    }
    return false;
  }

  protected const func CheckRequiredStates(scriptInterface: StateGameScriptInterface) -> Bool {
    let currentState = scriptInterface.localBlackboard.GetInt(GetAllBlackboardDefs().PlayerStateMachine.Vehicle);
    let vehicleID = scriptInterface
      .localBlackboard
      .GetEntityID(GetAllBlackboardDefs().PlayerStateMachine.EntityIDVehicleRemoteControlled);
    let isDeviceControlled = scriptInterface.executionOwner.GetTakeOverControlSystem().IsDeviceControlled();
    return !EntityID.IsDefined(vehicleID) && (isDeviceControlled || currentState != 1 && currentState != 6);
  }
}

