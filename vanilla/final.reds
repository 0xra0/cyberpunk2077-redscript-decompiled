class CurrentStanceNPCStatePrereq extends IScriptablePrereq {
  public let m_valueToCheck: gamedataNPCStanceState;
  public let m_invert: Bool;

  protected func Initialize(record: TweakDBID) {
    let stateName = TweakDBInterface.GetString(record + t".stateName", "");
    this.m_valueToCheck = IntEnum<gamedataNPCStanceState>(Cast<Int32>(EnumValueFromString("gamedataNPCStanceState", stateName)));
    this.m_invert = TweakDBInterface.GetBool(record + t".invert", false);
  }

  public const func IsFulfilled(game: GameInstance, context: IScriptable) -> Bool {
    let puppet = context as ScriptedPuppet;
    if !IsDefined(puppet) {
      return false;
    }
    let bb = puppet.GetPuppetStateBlackboard();
    let currentPuppetState = IntEnum<gamedataNPCStanceState>(bb.GetInt(GetAllBlackboardDefs().PuppetState.Stance));
    if NotEquals(currentPuppetState, this.m_valueToCheck) {
      return this.m_invert ? true : false;
    }
    return this.m_invert ? false : true;
  }
}

