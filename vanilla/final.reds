class LeaveCoverImmediately extends AIbehaviortaskScript {
  public let m_delay: Float;
  public let m_completeOnLeave: Bool;
  public let m_timeStamp: Float;
  public let m_triggered: Bool;

  protected func Activate(context: ScriptExecutionContext) {
    this.m_triggered = false;
    this.m_timeStamp = EngineTime.ToFloat(ScriptExecutionContext.GetAITime(context));
    if this.m_delay == 0.0 {
      AICoverHelper.LeaveCoverImmediately(AIBehaviorScriptBase.GetPuppet(context));
    } else if this.m_delay <= 0.0 {
      AIbehaviortaskScript.SetUpdateInterval(context, 9.99999e5);
    }
  }

  protected func Update(context: ScriptExecutionContext) -> AIbehaviorUpdateOutcome {
    if !this.m_triggered
      && this.m_delay > 0.0
      && this.m_delay
        + this.m_timeStamp
        >= EngineTime.ToFloat(ScriptExecutionContext.GetAITime(context)) {
      this.m_triggered = true;
      AICoverHelper.LeaveCoverImmediately(AIBehaviorScriptBase.GetPuppet(context));
      if this.m_completeOnLeave {
        return AIbehaviorUpdateOutcome.SUCCESS;
      }
    }
    return AIbehaviorUpdateOutcome.IN_PROGRESS;
  }

  protected func Deactivate(context: ScriptExecutionContext) {
    if this.m_delay < 0.0 {
      AICoverHelper.LeaveCoverImmediately(AIBehaviorScriptBase.GetPuppet(context));
    }
  }
}

class DpadWheelGameController extends inkHUDGameController {
