abstract class AISignalSenderTask extends AIbehaviortaskScript {
  public let tags: [CName];
  public let flags: [EAIGateSignalFlags];
  public let priority: Float;
  private let m_signalId: Uint32;

  protected func Activate(context: ScriptExecutionContext) {
    this.QueueGateSignal(context);
  }

  protected func Deactivate(context: ScriptExecutionContext) {
    AIBehaviorScriptBase
      .GetPuppet(context)
      .GetSignalHandlerComponent()
      .RemoveSignal(this.m_signalId);
  }

  protected final func QueueGateSignal(context: ScriptExecutionContext) {
    let signal: AIGateSignal;
    signal.priority = this.priority;
    signal.lifeTime = this.GetSignalLifeTime();
    let i = 0;
    while i < ArraySize(this.tags) {
      AIGateSignal.AddTag(signal, this.tags[i]);
      i += 1;
    }
    i = 0;
    while i < ArraySize(this.flags) {
      AIGateSignal.AddFlag(signal, Cast<AISignalFlags>(this.flags[i]));
      i += 1;
    }
    this.m_signalId = AIBehaviorScriptBase
      .GetPuppet(context)
      .GetSignalHandlerComponent()
      .AddSignal(signal);
  }

  public func GetSignalLifeTime() -> Float {
    return 0.0;
  }

  protected final func GetSignalTable(context: ScriptExecutionContext) -> gameBoolSignalTable {
    return AIBehaviorScriptBase
      .GetPuppet(context)
      .GetAIControllerComponent()
      .GetSignals();
  }
}

class GetFollowTarget extends FollowVehicleTask {
  private let m_blackboard: IBlackboard;
  private let m_vehicle: wref<VehicleObject>;

  protected func Activate(context: ScriptExecutionContext) {
    VehicleComponent
      .GetVehicle(
        AIBehaviorScriptBase.GetGame(context),
        GameInstance
          .GetPlayerSystem(AIBehaviorScriptBase.GetGame(context))
          .GetLocalPlayerMainGameObject(),
        this.m_vehicle
      );
    this.m_blackboard = IBlackboard.Create(GetAllBlackboardDefs().AIFollowSlot);
    ScriptExecutionContext
      .SetArgumentVector(context, n"MovementTarget", this.m_vehicle.GetWorldPosition());
    let slotRequest = new RequestSlotEvent();
    slotRequest.blackboard = this.m_blackboard;
    slotRequest.requester = ScriptExecutionContext.GetOwner(context);
    this.m_vehicle.QueueEvent(slotRequest);
    AIbehaviortaskScript.SetUpdateInterval(context, 0.1);
  }

  protected func Update(context: ScriptExecutionContext) -> AIbehaviorUpdateOutcome {
    let followSlot = FromVariant<Transform>(
      this.m_blackboard.GetVariant(GetAllBlackboardDefs().AIFollowSlot.slotTransform)
    );
    if !Vector4.IsZero(Transform.GetPosition(followSlot)) {
      let followPointWorldOffset = Vector4
        .RotByAngleXY(
          Transform.GetPosition(followSlot),
          -1.0 * Vector4.Heading(this.m_vehicle.GetWorldForward())
        );
      let target = this.m_vehicle.GetWorldPosition() + followPointWorldOffset;
      let changeDestinationEvent = new gameChangeDestination();
      changeDestinationEvent.destination = target;
      let actionEvent = new ActionEvent();
      actionEvent.name = n"actionEvent";
      actionEvent.internalEvent = changeDestinationEvent;
      ScriptExecutionContext.GetOwner(context).QueueEvent(actionEvent);
      ScriptExecutionContext.SetArgumentVector(context, n"MovementTarget", target);
      return AIbehaviorUpdateOutcome.SUCCESS;
    }
    return AIbehaviorUpdateOutcome.IN_PROGRESS;
  }

  protected func Deactivate(context: ScriptExecutionContext) {
    let slotReleaseRequest = new ReleaseSlotEvent();
    slotReleaseRequest.slotID = this.m_blackboard.GetInt(GetAllBlackboardDefs().AIFollowSlot.slotID);
    this.m_vehicle.QueueEvent(slotReleaseRequest);
  }
}

