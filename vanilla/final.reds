  }

  public const final func IsHumanoid() -> Bool {
    let npcType = this
      .GetRecord()
      .CharacterType()
      .Type();
    return Equals(npcType, gamedataNPCType.Human) || Equals(npcType, gamedataNPCType.Android);
  }

  public const final func IsNetrunnerPuppet() -> Bool {
    return GameInstance
      .GetStatsSystem(this.GetGame())
      .GetStatValue(
        Cast<StatsObjectID>(this.GetEntityID()),
        gamedataStatType.IsNetrunnerArchetype
      ) > 0.0;
  }

  public const final func IsMechanical() -> Bool {
    let npcType = this
      .GetRecord()
      .CharacterType()
      .Type();
    return Equals(npcType, gamedataNPCType.Android)
      || Equals(npcType, gamedataNPCType.Drone)
      || Equals(npcType, gamedataNPCType.Mech)
      || AIActionHelper
        .CheckAbility(this, TweakDBInterface.GetGameplayAbilityRecord(t"Ability.IsMechanical"));
  }

