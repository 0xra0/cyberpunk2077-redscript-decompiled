class PlayerSquadInterface extends PuppetSquadInterface {
  public final func BroadcastCommand(command: AICommand) {
    let members = this.ListMembersWeak();
    let i = 0;
    while i < ArraySize(members) {
      this.GiveCommandToSquadMember(members[i], command.Copy());
      i += 1;
    }
  }

  private final func GiveCommandToSquadMember(member: wref<Entity>, command: AICommand) {
    let puppet = member as ScriptedPuppet;
    if !IsDefined(puppet) {
      return;
    }
    let aiComponent = puppet.GetAIControllerComponent();
    aiComponent.SendCommand(command);
    let executeCommandEvent = new StimuliEvent();
    executeCommandEvent.name = n"FollowerExecuteCommand";
    puppet.QueueEvent(executeCommandEvent);
  }
}

