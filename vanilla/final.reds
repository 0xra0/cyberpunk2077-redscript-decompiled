  public final static func GetItemFromInventory(object: GameObject, item: TweakDBID) -> ItemID {
    let items: [wref<gameItemData>];
    let TS = GameInstance.GetTransactionSystem(object.GetGame());
    TS.GetItemList(object, items);
    let i = i;
    while i < ArraySize(items) {
      if ItemID.GetTDBID(items[i].GetID()) == item {
        return items[i].GetID();
      }
      i += 1;
    }
    return ItemID.None();
  }

