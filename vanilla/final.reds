          this.m_benchmarkSummary.DLSSDEnabled ? locOn : locOff
        );
      if this.m_benchmarkSummary.DLSSQuality == 6 {
        this
          .SpawnSummaryLine(
            this.m_lineEntryName,
            EEntryColumn.right,
            GetLocalizedTextByKey(n"UI-Settings-Video-Advanced-TargetFPS"),
