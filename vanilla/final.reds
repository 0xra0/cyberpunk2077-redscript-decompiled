class CraftingSystemInventoryCallback extends InventoryScriptCallback {
  public let player: wref<PlayerPuppet>;

  public func OnItemAdded(item: ItemID, itemData: wref<gameItemData>, flaggedAsSilent: Bool) {
    if itemData.HasTag(n"Recipe") {
      let craftingSystem = GameInstance
        .GetScriptableSystemsContainer(this.player.GetGame())
        .Get(n"CraftingSystem") as CraftingSystem;
      let recipeRecord = TweakDBInterface.GetItemRecipeRecord(ItemID.GetTDBID(item));
      let itemToAdd = recipeRecord.CraftingResult();
      let addRecipeRequest = new AddRecipeRequest();
      addRecipeRequest.recipe = itemToAdd.Item().GetID();
      addRecipeRequest.amount = itemToAdd.Amount();
      if recipeRecord.GetHideOnItemsAddedCount() > 0 {
        recipeRecord.HideOnItemsAdded(addRecipeRequest.hideOnItemsAdded);
      }
      craftingSystem.QueueRequest(addRecipeRequest);
    }
  }
}

class AddRecipeRequest extends PlayerScriptableSystemRequest {
  public let recipe: TweakDBID;
  public let amount: Int32;
  public let hideOnItemsAdded: [wref<Item_Record>];
}

