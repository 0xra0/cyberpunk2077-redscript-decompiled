native struct Vector4 {
  public native let X: Float;
  public native let Y: Float;
  public native let Z: Float;
  public native let W: Float;

  public final static func Lerp(a: Vector4, b: Vector4, t: Float) -> Vector4 {
    let x = a.X + (b.X - a.X) * t;
    let y = a.Y + (b.Y - a.Y) * t;
    let z = a.Z + (b.Z - a.Z) * t;
    let w = a.W + (b.W - a.W) * t;
    return new Vector4(x, y, z, w);
  }

  public final native static func Dot2D(a: Vector4, b: Vector4) -> Float;

  public final native static func Dot(a: Vector4, b: Vector4) -> Float;

  public final native static func Cross(a: Vector4, b: Vector4) -> Vector4;

  public final native static func Length2D(a: Vector4) -> Float;

  public final native static func LengthSquared(a: Vector4) -> Float;

  public final native static func Length(a: Vector4) -> Float;

  public final native static func Normalize2D(a: Vector4) -> Vector4;

  public final native static func Normalize(a: Vector4) -> Vector4;

  public final native static func Rand2D() -> Vector4;

  public final native static func Rand() -> Vector4;

  public final static func UP() -> Vector4 {
    let v: Vector4;
    v.Z = 1.0;
    return v;
  }

  public final static func FRONT() -> Vector4 {
    let v: Vector4;
    v.Y = 1.0;
    return v;
  }

  public final static func RIGHT() -> Vector4 {
    let v: Vector4;
    v.X = 1.0;
    return v;
  }

  public final static func RandRing(minRadius: Float, maxRadius: Float) -> Vector4 {
    let r = RandRangeF(minRadius, maxRadius);
    let angle = RandRangeF(0.0, 6.2831855);
    return new Vector4(r * CosF(angle), r * SinF(angle), 0.0, 1.0);
  }

  public final static func RandCone(coneDir: Float, coneAngle: Float, minRadius: Float, maxRadius: Float) -> Vector4 {
    let r = RandRangeF(minRadius, maxRadius);
    let angleMin = Deg2Rad(coneDir - coneAngle * 0.5 + 90.0);
    let angleMax = Deg2Rad(coneDir + coneAngle * 0.5 + 90.0);
    let angle = RandRangeF(angleMin, angleMax);
    return new Vector4(r * CosF(angle), r * SinF(angle), 0.0, 1.0);
  }

  public final static func RandRingStatic(seed: Int32, minRadius: Float, maxRadius: Float) -> Vector4 {
    let r = RandNoiseF(seed, maxRadius, minRadius);
    let angle = RandNoiseF(seed, 6.2831855);
    return new Vector4(r * CosF(angle), r * SinF(angle), 0.0, 1.0);
  }

  public final native static func Mirror(dir: Vector4, normal: Vector4) -> Vector4;

  public final native static func Distance(from: Vector4, to: Vector4) -> Float;

  public final native static func DistanceSquared(from: Vector4, to: Vector4) -> Float;

  public final native static func Distance2D(from: Vector4, to: Vector4) -> Float;

  public final native static func DistanceSquared2D(from: Vector4, to: Vector4) -> Float;

  public final native static func DistanceToEdge(point: Vector4, a: Vector4, b: Vector4) -> Float;

  public final native static func NearestPointOnEdge(point: Vector4, a: Vector4, b: Vector4) -> Vector4;

  public final native static func ToRotation(dir: Vector4) -> EulerAngles;

  public final native static func Heading(dir: Vector4) -> Float;

  public final native static func FromHeading(heading: Float) -> Vector4;

  public final native static func Transform(m: Matrix, point: Vector4) -> Vector4;

  public final native static func TransformDir(m: Matrix, point: Vector4) -> Vector4;

  public final native static func TransformH(m: Matrix, point: Vector4) -> Vector4;

  public final native static func GetAngleBetween(from: Vector4, to: Vector4) -> Float;

  public final native static func GetAngleDegAroundAxis(dirA: Vector4, dirB: Vector4, axis: Vector4) -> Float;

  public final native static func ProjectPointToPlane(p1: Vector4, p2: Vector4, p3: Vector4, toProject: Vector4) -> Vector4;

  public final native static func RotateAxis(vector: Vector4, axis: Vector4, angle: Float) -> Vector4;

  public final native static func RotByAngleXY(vec: Vector4, angleDeg: Float) -> Vector4;

  public final native static func Interpolate(v1: Vector4, v2: Vector4, ratio: Float) -> Vector4;

  public final static func ToString(vec: Vector4) -> String {
    return FloatToString(vec.X)
      + " "
      + FloatToString(vec.Y)
      + " "
      + FloatToString(vec.Z)
      + " "
      + FloatToString(vec.W);
  }

  public final static func ToStringPrec(vec: Vector4, precision: Int32) -> String {
    return FloatToStringPrec(vec.X, precision)
      + " "
      + FloatToStringPrec(vec.Y, precision)
      + " "
      + FloatToStringPrec(vec.Z, precision)
      + " "
      + FloatToStringPrec(vec.W, precision);
  }

  public final native static func Zero(out self: Vector4);

  public final native static func IsZero(self: Vector4) -> Bool;

  public final native static func IsXYZZero(self: Vector4) -> Bool;

  public final static func EmptyVector() -> Vector4 {
    let vec: Vector4;
    return vec;
  }

  public final native static func ClampLength(self: Vector4, min: Float, max: Float) -> Vector4;

  public final native static func Vector3To4(v3: Vector3) -> Vector4;

  public final native static func Vector4To3(v4: Vector4) -> Vector3;
}

public native func CosF(a: Float) -> Float;

public native func SinF(a: Float) -> Float;

public native func Deg2Rad(deg: Float) -> Float;

public native func RandNoiseF(seed: Int32, max: Float, opt min: Float) -> Float;

public native func FloatToString(value: Float) -> String;

public native func FloatToStringPrec(value: Float, precision: Int32) -> String;

