class ProgramSetDeviceAttitude extends ActionBool {
  public final func SetProperties() {
    this.actionName = n"ProgramSetDeviceAttitude";
    this.prop = DeviceActionPropertyFunctions
      .SetUpProperty_Bool(n"ProgramSetDeviceAttitude", true, n"LocKey#362", n"LocKey#362");
  }

  public final static func IsDefaultConditionMet(device: ScriptableDeviceComponentPS, const context: script_ref<GetActionsContext>) -> Bool {
    return true;
  }
}

