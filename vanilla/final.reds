  public const func Test(
    const activatorObject: wref<GameObject>,
    const hotSpotObject: wref<GameObject>,
    const hotSpotLayer: wref<HotSpotLayerDefinition>
  ) -> Bool {
    let currentDataOwner = hotSpotObject as PlayerPuppet;
    let receivingPlayer = activatorObject as PlayerPuppet;
    if IsDefined(currentDataOwner) && IsDefined(receivingPlayer) {
      if !currentDataOwner.m_CPOMissionDataState.m_ownerDecidesOnTransfer && currentDataOwner.HasCPOMissionData() && !receivingPlayer.HasCPOMissionData() {
        return true;
