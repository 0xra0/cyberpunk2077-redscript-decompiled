class FirstEquipEvents extends EquipmentBaseEvents {
  public const let stateMachineInstanceData: StateMachineInstanceData;
  public const let stateMachineInitData: wref<EquipmentInitData>;

  protected func OnEnter(stateContext: StateContext, scriptInterface: StateGameScriptInterface) {
    if this.IsRightHandLogic(this.stateMachineInstanceData) {
      if !WeaponObject
        .IsFists(GameObject.GetActiveWeapon(scriptInterface.executionOwner).GetItemID()) {
        let broadcaster = scriptInterface.executionOwner.GetStimBroadcasterComponent();
        if IsDefined(broadcaster) {
          broadcaster
            .TriggerSingleBroadcast(scriptInterface.executionOwner, gamedataStimType.WeaponDisplayed);
        }
        stateContext.SetPermanentBoolParameter(n"weaponDisplayedStimuli", true, true);
      }
    }
  }

  protected func OnExit(stateContext: StateContext, scriptInterface: StateGameScriptInterface) {
    let mappedInstanceData = this.GetMappedInstanceData(this.stateMachineInstanceData.referenceName);
    let itemObject = scriptInterface
      .GetTransactionSystem()
      .GetItemInSlot(
        scriptInterface.executionOwner,
        TDBID.Create(mappedInstanceData.attachmentSlot)
      ) as WeaponObject;
    this
      .CreateAndSendFirstEquipEndRequest(scriptInterface, ItemID.GetTDBID(itemObject.GetItemID()));
    scriptInterface.PushAnimationEvent(n"FirstEquipEnd");
    stateContext.SetConditionBoolParameter(n"firstEquip", false, true);
  }
}

