class AICommandDeviceHandler extends AIbehaviortaskScript {
  public let m_inCommand: AIArgumentMapping;

  protected func Activate(context: ScriptExecutionContext) {
    AIbehaviortaskScript
      .SetUpdateInterval(context, AIBehaviorScriptBase.RandomizeOffsetForUpdateInterval(0.2));
  }

  protected func Update(context: ScriptExecutionContext) -> AIbehaviorUpdateOutcome {
    if !IsDefined(this.m_inCommand) {
      return AIbehaviorUpdateOutcome.FAILURE;
    }
    let rawCommand = ScriptExecutionContext.GetScriptableMappingValue(context, this.m_inCommand);
    let deviceCommand = rawCommand as AIFollowerDeviceCommand;
    if !IsDefined(deviceCommand) {
      return AIbehaviorUpdateOutcome.FAILURE;
    } else if !IsDefined(deviceCommand.target) {
      return AIbehaviorUpdateOutcome.FAILURE;
    } else if ScriptExecutionContext.GetArgumentObject(context, n"Target") != deviceCommand.target {
      ScriptExecutionContext.SetArgumentObject(context, n"Target", deviceCommand.target);
    } else if deviceCommand.overrideMovementTarget
      != null
      && ScriptExecutionContext.GetArgumentObject(context, n"MovementTarget") != deviceCommand.overrideMovementTarget {
      ScriptExecutionContext
        .SetArgumentObject(context, n"MovementTarget", deviceCommand.overrideMovementTarget);
    } else if deviceCommand.overrideMovementTarget == null {
      ScriptExecutionContext.SetArgumentObject(context, n"MovementTarget", deviceCommand.target);
    }
    return AIbehaviorUpdateOutcome.IN_PROGRESS;
  }
}

class IsReprimandOngoing extends AIAutonomousConditions {
  protected func Activate(context: ScriptExecutionContext) {
    AIbehaviorconditionScript
      .SetUpdateInterval(context, AIBehaviorScriptBase.RandomizeOffsetForUpdateInterval(0.2));
  }

  protected func Check(context: ScriptExecutionContext) -> AIbehaviorConditionOutcomes {
    let puppet = AIBehaviorScriptBase.GetPuppet(context);
    let secSys = puppet.GetSecuritySystem();
    if !secSys.IsReprimandOngoing() {
      return AIbehaviorConditionOutcomes.False;
    } else if puppet.GetSecuritySystem().GetReprimandPerformer() == puppet.GetDeviceLink() {
      return AIbehaviorConditionOutcomes.False;
    } else if NotEquals(
      (puppet.GetSecuritySystem().GetReprimandPerformer() as ScriptedPuppet).GetHighLevelStateFromBlackboard(),
      gamedataNPCHighLevelState.Relaxed
    ) {
      return AIbehaviorConditionOutcomes.False;
    }
    return AIbehaviorConditionOutcomes.True;
  }
}

