}

class DeviceMappinsContainer extends IScriptable {
  public let m_mappins: [SDeviceMappinData];
  public let m_newNewFocusMappin: SDeviceMappinData;
  public let m_useNewFocusMappin: Bool;
  private let m_offsetValue: Float;

  public final func Initialize() {
    let mappin: SDeviceMappinData;
    mappin.mappinType = t"Mappins.DeviceMappinDefinition";
    mappin.enabled = false;
    mappin.active = false;
    mappin.range = 35.0;
    if !this.HasMappin(gamedataMappinVariant.NetrunnerVariant) {
      mappin.mappinVariant = gamedataMappinVariant.NetrunnerVariant;
      ArrayPush(this.m_mappins, mappin);
    } else if !this.HasMappin(gamedataMappinVariant.NetrunnerAccessPointVariant) {
      mappin.mappinVariant = gamedataMappinVariant.NetrunnerAccessPointVariant;
      ArrayPush(this.m_mappins, mappin);
    } else if !this.HasMappin(gamedataMappinVariant.TechieVariant) {
      mappin.mappinVariant = gamedataMappinVariant.TechieVariant;
      ArrayPush(this.m_mappins, mappin);
    } else if !this.HasMappin(gamedataMappinVariant.SoloVariant) {
      mappin.mappinVariant = gamedataMappinVariant.SoloVariant;
      ArrayPush(this.m_mappins, mappin);
    } else if this.m_useNewFocusMappin {
      mappin.mappinVariant = this.m_newNewFocusMappin.mappinVariant;
      mappin.enabled = true;
      ArrayPush(this.m_mappins, mappin);
    }
  }

  public final func HasNewFocusMappin() -> Bool {
    return this.m_useNewFocusMappin;
  }

  private final func EvaluatePositions(owner: GameObject) {
    let transform: WorldTransform;
    let direction = 0;
    let rootPos = owner.GetPlaystyleMappinLocalPos();
    WorldTransform.SetPosition(transform, owner.GetWorldPosition());
    WorldTransform.SetOrientation(transform, owner.GetWorldOrientation());
    let i = 0;
    while i < ArraySize(this.m_mappins) {
      if !this.m_mappins[i].enabled {
      }
      if direction != 0 {
        direction *= -1;
        let offsetValue = this.m_offsetValue * Cast<Float>(direction);
      } else if direction == 0 {
        offsetValue = 0.0;
        direction = 1;
      }
      let currentOffset = rootPos + this.m_mappins[i].offset;
      currentOffset.X = currentOffset.X + offsetValue;
      let currentPos = WorldPosition.ToVector4(WorldTransform.TransformPoint(transform, currentOffset));
      this.m_mappins[i].position = currentPos;
      currentOffset = new Vector4(0.0, 0.0, 0.0, 0.0);
      currentPos = new Vector4(0.0, 0.0, 0.0, 0.0);
      i += 1;
    }
  }

  private final func GetNextAxis(currentAxis: EAxisType) -> EAxisType {
    let nextAxis: EAxisType;
    let axisValue: Int32;
    if EnumInt(currentAxis) < 3 {
      axisValue += 1;
      nextAxis = IntEnum<EAxisType>(axisValue);
    } else {
      nextAxis = EAxisType.X;
    }
    return nextAxis;
  }

  public final func ShowMappins(owner: GameObject) {
    let mappinData: MappinData;
    this.EvaluatePositions(owner);
    let i = 0;
    while i < ArraySize(this.m_mappins) {
      if this.m_mappins[i].enabled && !this.m_mappins[i].active {
        mappinData.mappinType = this.m_mappins[i].mappinType;
        mappinData.variant = this.m_mappins[i].mappinVariant;
        mappinData.active = true;
        mappinData.debugCaption = this.m_mappins[i].caption;
        let system = GameInstance.GetMappinSystem(owner.GetGame());
        this.m_mappins[i].id = system.RegisterMappin(mappinData, this.m_mappins[i].position);
        this.m_mappins[i].active = true;
      }
      i += 1;
    }
  }

  public final func HideMappins(owner: GameObject) {
    let i = 0;
    while i < ArraySize(this.m_mappins) {
      if this.m_mappins[i].active {
        this.HideSingleMappin(i, owner);
      }
      i += 1;
    }
  }

  private final func HideSingleMappin(index: Int32, owner: GameObject) {
    GameInstance.GetMappinSystem(owner.GetGame()).UnregisterMappin(this.m_mappins[index].id);
    this.m_mappins[index].active = false;
  }

  private final func HasMappin(mappinVariant: gamedataMappinVariant) -> Bool {
    let i = 0;
    while i < ArraySize(this.m_mappins) {
      if Equals(this.m_mappins[i].mappinVariant, mappinVariant) {
        return true;
      }
      i += 1;
    }
    return false;
  }

  private final func HasMappin(const data: script_ref<SDeviceMappinData>) -> Bool {
    let i = 0;
    while i < ArraySize(this.m_mappins) {
      if Equals(this.m_mappins[i].mappinVariant, data.mappinVariant)
        && this.m_mappins[i].mappinType == data.mappinType
        && Equals(this.m_mappins[i].caption, data.caption) {
        return true;
      }
      i += 1;
    }
    return false;
  }

  public final func ToggleMappin(owner: GameObject, mappinVariant: gamedataMappinVariant, enable: Bool) {
    let i = 0;
    while i < ArraySize(this.m_mappins) {
      if Equals(this.m_mappins[i].mappinVariant, mappinVariant) {
        this.m_mappins[i].enabled = enable;
        if !enable {
          if this.m_mappins[i].active {
            this.HideSingleMappin(i, owner);
          }
        }
      }
      i += 1;
    }
  }

  public final func AddMappin(const data: script_ref<SDeviceMappinData>) {
    if !this.HasMappin(data) {
      ArrayPush(this.m_mappins, data);
    }
  }
}

class BaseDestructibleController extends ScriptableDeviceComponent {
  public const func GetPS() -> BaseDestructibleControllerPS {
    return this.GetBasePS() as BaseDestructibleControllerPS;
  }
}

class BaseDestructibleControllerPS extends ScriptableDeviceComponentPS {
  protected let m_destroyed: Bool;

  protected cb func OnInstantiated() -> Bool {
    super.OnInstantiated();
    if !IsStringValid(this.m_deviceName) {
      this.m_deviceName = "LocKey#127";
    }
  }

  protected func Initialize() {
    super.Initialize();
  }

  protected func GameAttached() {
    super.GameAttached();
    if this.IsDisabled() && !this.m_destroyed {
      this.ForceEnableDevice();
    }
  }

  public final func OnMasterDeviceDestroyed(evt: MasterDeviceDestroyed) -> EntityNotificationType {
    if !this.IsDisabled() {
      this.ForceDisableDevice();
    }
    this.UseNotifier(evt);
    return EntityNotificationType.SendThisEventToEntity;
  }

  public final func IsMasterDestroyed() -> Bool {
    let masters: [DeviceComponentPS];
    this.GetParents(masters);
    let i = 0;
    while i < ArraySize(masters) {
      let master = masters[i] as DestructibleMasterDeviceControllerPS;
      if IsDefined(master) {
        return master.IsDestroyed();
      }
      i += 1;
    }
    return false;
  }

  public final func SetDestroyed() {
    this.m_destroyed = true;
  }

  public final func IsDestroyed() -> Bool {
    return this.m_destroyed;
  }
}

class BaseDestructibleDevice extends Device {
  protected let m_minTime: Float;
  protected let m_maxTime: Float;
  protected let m_destroyedMesh: PhysicalMeshComponent;

  protected cb func OnRequestComponents(ri: EntityRequestComponentsInterface) -> Bool {
    super.OnRequestComponents(ri);
    EntityRequestComponentsInterface.RequestComponent(ri, n"mesh_destroyed", n"PhysicalMeshComponent", false);
  }

  protected cb func OnTakeControl(ri: EntityResolveComponentsInterface) -> Bool {
    super.OnTakeControl(ri);
    this.m_destroyedMesh = EntityResolveComponentsInterface.GetComponent(ri, n"mesh_destroyed") as PhysicalMeshComponent;
    this.m_controller = EntityResolveComponentsInterface.GetComponent(ri, n"controller") as BaseDestructibleController;
  }

  protected func ResolveGameplayState() {
    super.ResolveGameplayState();
    if this.GetDevicePS().IsMasterDestroyed() || this.GetDevicePS().IsDestroyed() {
      this.DeactivateDeviceSilent();
    } else {
      this.ActivateDevice();
    }
  }

  protected cb func OnMasterDeviceDestroyed(evt: MasterDeviceDestroyed) -> Bool {
    this.CreateDestructionEffects();
  }

  protected cb func OnPhysicalDestructionEvent(evt: PhysicalDestructionEvent) -> Bool {
    this.GetDevicePS().SetDestroyed();
    this.GetDevicePS().ForceDisableDevice();
    this.CreateDestructionEffects();
  }

  protected func CreateDestructionEffects() {
    let delayEvent = new DelayEvent();
    this.CreatePhysicalBody();
    GameInstance
      .GetDelaySystem(this.GetGame())
      .DelayEvent(this, delayEvent, RandRangeF(this.m_minTime, this.m_maxTime));
  }

  protected func CreatePhysicalBody() {
    if !this.m_destroyedMesh.IsEnabled() {
      this.m_destroyedMesh.Toggle(true);
    }
    let meshInterface = this.m_destroyedMesh.CreatePhysicalBodyInterface();
    meshInterface.ToggleKinematic(true);
    meshInterface.AddLinearImpulse(new Vector4(0.0, 0.5, 0.0, 0.0), true);
  }

  protected cb func OnDelayEvent(evt: DelayEvent) -> Bool {
    this.HidePhysicalBody();
  }

  protected func HidePhysicalBody() {
    this.m_destroyedMesh.Toggle(false);
  }

  protected func DeactivateDevice() {
    this
      .GetDevicePS()
      .GetDeviceOperationsContainer()
      .Execute(n"death_VFX", this);
  }

  protected func DeactivateDeviceSilent() {
    if this.m_destroyedMesh.IsEnabled() {
      this.m_destroyedMesh.Toggle(false);
    }
  }

  protected func ActivateDevice() {
    this.m_destroyedMesh.Toggle(true);
  }

  private const func GetController() -> BaseDestructibleController {
    return this.m_controller as BaseDestructibleController;
  }

  public const func GetDevicePS() -> BaseDestructibleControllerPS {
    return this.GetController().GetPS();
  }
}

