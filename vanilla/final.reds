class LeftHandCyberwareChargeRepeatActionDecisions extends LeftHandCyberwareActionAbstractDecisions {
  protected const func ToLeftHandCyberwareWaitForUnequip(const stateContext: StateContext, const scriptInterface: StateGameScriptInterface) -> Bool {
    let projectilesReleased = stateContext.GetPermanentIntParameter(n"projectilesReleased");
    let m_maxProjectiles = this.GetStaticIntParameterDefault("maxProjectiles", 3);
    if this.ShouldInstantlyUnequipCyberware(scriptInterface, stateContext) {
      return true;
    } else if stateContext.GetBoolParameter(n"InterruptLeftHandAction") {
      return true;
    }
    return projectilesReleased.valid && projectilesReleased.value >= m_maxProjectiles;
  }

  protected const final func ToLeftHandCyberwareChargeRepeatAction(const stateContext: StateContext, const scriptInterface: StateGameScriptInterface) -> Bool {
    let projectilesReleased = stateContext.GetPermanentIntParameter(n"projectilesReleased");
    let m_maxProjectiles = this.GetStaticIntParameterDefault("maxProjectiles", 3);
    if this.GetInStateTime() >= this.GetStaticFloatParameterDefault("stateDuration", 0.3) {
      return projectilesReleased.valid && projectilesReleased.value < m_maxProjectiles;
    }
    return false;
  }
}

