class ModifyStatPoolValueQuickhackCostEffector extends HitEventEffector {
  public let m_statPoolValue: Float;
  public let m_statPoolType: gamedataStatPoolType;
  public let m_recoverMemoryAmount: Float;
  public let m_skipLastCombatHack: Bool;

  protected func Initialize(record: TweakDBID, game: GameInstance, parentRecord: TweakDBID) {
    this.m_statPoolValue = TDB.GetFloat(record + t".statPoolValue");
    this.m_statPoolType = IntEnum<gamedataStatPoolType>(
      Cast<Int32>(
        EnumValueFromString(
          "gamedataStatPoolType",
          TweakDBInterface.GetString(record + t".statPoolType", "")
        )
      )
    );
    this.m_recoverMemoryAmount = TweakDBInterface.GetFloat(record + t".recoverMemoryAmount", 1.0);
    this.m_skipLastCombatHack = TweakDBInterface.GetBool(record + t".skipLastCombatHack", false);
  }

  protected func ActionOn(owner: GameObject) {
    this.ProcessEffector(owner);
  }

  protected func RepeatedAction(owner: GameObject) {
    this.ProcessEffector(owner);
  }

  private final func ProcessEffector(owner: GameObject) {
    let appliedEffects: [StatusEffect];
    let activeQHCost: Int32;
    let actionEffectsCost: [Int32];
    let actionEffects: [wref<ObjectActionEffect_Record>];
    let actionEffectsOfEffects: [[wref<ObjectActionEffect_Record>]];
    let statPoolValue = this.m_recoverMemoryAmount;
    let hitEvent = this.GetHitEvent();
    if !IsDefined(hitEvent) {
      return;
    }
    let poolSys = GameInstance.GetStatPoolsSystem(owner.GetGame());
    if !IsDefined(poolSys) {
      return;
    }
    GameInstance
      .GetStatusEffectSystem(owner.GetGame())
      .GetAppliedEffectsWithTag(hitEvent.target.GetEntityID(), n"Quickhack", appliedEffects);
    let activeQHHistory = this.GetActiveQuickhackActionHistory(hitEvent.target);
    let foundAppliedEffect = false;
    let i = ArraySize(activeQHHistory) - 1;
    while i >= 0 {
      let activeQH = activeQHHistory[i];
      activeQHCost = activeQH.GetCost();
      let actionRecord = activeQH.GetObjectActionRecord();
      if IsDefined(actionRecord) {
        if this.m_skipLastCombatHack
          && !foundAppliedEffect
          && Equals(actionRecord.HackCategory().Type(), gamedataHackCategory.DamageHack) {
          foundAppliedEffect = true;
        } else {
          actionRecord.CompletionEffects(actionEffects);
          ArrayPush(actionEffectsOfEffects, actionEffects);
          ArrayPush(actionEffectsCost, activeQHCost);
          ArrayClear(actionEffects);
        }
      }
      i -= 1;
    }
    i = 0;
    while i < ArraySize(actionEffectsOfEffects) {
      actionEffects = actionEffectsOfEffects[i];
      activeQHCost = actionEffectsCost[i];
      foundAppliedEffect = false;
      let j = 0;
      if j < ArraySize(actionEffects) {
        let activeActionEffectTweakDBID = actionEffects[j].StatusEffect().GetID();
        if IsDefined(actionEffects[j].EffectorToTrigger())
          && Equals(
            actionEffects[j].EffectorToTrigger().EffectorClassName(),
            n"ApplyLegendaryWhistleEffector"
          ) {
          activeActionEffectTweakDBID = t"BaseStatusEffect.WhistleLvl4";
        }
        let k = 0;
        if k < ArraySize(appliedEffects) {
          let appliedEffectTweakDBID = appliedEffects[k].GetRecord().GetID();
          if activeActionEffectTweakDBID == appliedEffectTweakDBID {
            statPoolValue += this.m_statPoolValue * Cast<Float>(activeQHCost);
            foundAppliedEffect = true;
          } else {
            k += 1;
          }
        }
        activeActionEffectTweakDBID = TDBID.None();
        if foundAppliedEffect {
        } else {
          j += 1;
        }
      }
      i += 1;
    }
    poolSys
      .RequestChangingStatPoolValue(
        Cast<StatsObjectID>(owner.GetEntityID()),
        this.m_statPoolType,
        statPoolValue,
        owner,
        false,
        false
      );
  }

  private final func GetActiveQuickhackActionHistory(target: wref<GameObject>) -> [ScriptableDeviceAction] {
    let scriptableDeviceActionArray: [ScriptableDeviceAction];
    if IsDefined(target as ScriptedPuppet) {
      scriptableDeviceActionArray = (target as ScriptedPuppet).GetActiveQuickhackActionHistory();
    }
    return scriptableDeviceActionArray;
  }
}

class GrenadeLvl4HackEffector extends Effector {
  private let m_grenadeChangeEntity: wref<GameObject>;
  private let m_grenadeChangedListener: AttachmentSlotsScriptListener;

  protected func ActionOn(owner: GameObject) {
    if !IsDefined(this.m_grenadeChangedListener) {
      this.m_grenadeChangeEntity = owner;
      let grenadeChangedCallback = new GrenadeChangedCallback();
      grenadeChangedCallback.grenadeChangeEntity = this.m_grenadeChangeEntity;
      grenadeChangedCallback.slotID = t"AttachmentSlots.WeaponLeft";
      this.m_grenadeChangedListener = GameInstance
        .GetTransactionSystem(owner.GetGame())
        .RegisterAttachmentSlotListener(this.m_grenadeChangeEntity, grenadeChangedCallback);
      grenadeChangedCallback.grenadeChangeListener = this.m_grenadeChangedListener;
    }
    this.ProcessEffector(owner);
  }

  protected func RepeatedAction(owner: GameObject) {
    this.ProcessEffector(owner);
  }

  private final func ProcessEffector(owner: GameObject) {
    let item: TweakDBID;
    let puppet = owner as gamePuppet;
    let transactionSystem = GameInstance.GetTransactionSystem(puppet.GetGame());
    let statSystem = GameInstance.GetStatsSystem(puppet.GetGame());
    let hasFrag = statSystem
      .GetStatValue(
        Cast<StatsObjectID>(owner.GetEntityID()),
        gamedataStatType.CanUseFragGrenades
      ) > 0.0;
    let hasFire = statSystem
      .GetStatValue(
        Cast<StatsObjectID>(owner.GetEntityID()),
        gamedataStatType.CanUseIncendiaryGrenades
      ) > 0.0;
    let hasBio = statSystem
      .GetStatValue(
        Cast<StatsObjectID>(owner.GetEntityID()),
        gamedataStatType.CanUseBiohazardGrenades
      ) > 0.0;
    let hasEMP = statSystem
      .GetStatValue(Cast<StatsObjectID>(owner.GetEntityID()), gamedataStatType.CanUseEMPGrenades) > 0.0;
    let inventoryManager = new InventoryDataManagerV2();
    inventoryManager.Initialize(owner as PlayerPuppet);
    if !IsDefined(puppet) {
      return;
    } else if hasFrag {
      item = t"Items.GrenadeFragRegularHack";
    } else if hasFire {
      item = t"Items.GrenadeIncendiaryRegularHack";
    } else if hasBio {
      item = t"Items.GrenadeBiohazardRegularHack";
    } else if hasEMP {
      item = t"Items.GrenadeEMPRegularHack";
    }
    item = t"Items.GrenadeFragRegularHack";
    let itemID = ItemID.CreateQuery(item);
    if !ItemID.IsValid(itemID) {
      return;
    } else if !IsDefined(transactionSystem) {
      return;
    } else if transactionSystem.HasItemInAnySlot(owner, itemID) {
      if !transactionSystem.HasItem(owner, itemID) {
        if !transactionSystem.GiveItem(owner, itemID, 1) {
          return;
        } else if !transactionSystem.ChangeItemToSlot(owner, t"AttachmentSlots.WeaponLeft", itemID) {
          return;
        }
      }
    } else if !transactionSystem.HasItem(owner, itemID) {
      if !transactionSystem.GiveItem(owner, itemID, 1) {
        return;
      }
    }
    let highPriority = NotEquals(WeaponObject.GetWeaponType(itemID), gamedataItemType.Invalid);
    if !transactionSystem.AddItemToSlot(owner, t"AttachmentSlots.WeaponLeft", itemID, highPriority) {
      return;
    }
    AIActionHelper.ClearItemsToEquip(owner as ScriptedPuppet);
  }
}

