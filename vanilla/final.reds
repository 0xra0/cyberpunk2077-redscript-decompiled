  public func ResloveUIOnAction(action: ScriptableDeviceAction) {
    if IsDefined(action) {
      if !action.HasUI() {
        return;
      }
      let entityID = PersistentID.ExtractEntityID(this.GetID());
      this.RequestActionWidgetsUpdate(this.GetBlackboard());
      if action.GetRequesterID() != entityID {
        let deviceWidgetEvent = new RequestDeviceWidgetUpdateEvent();
        deviceWidgetEvent.requester = this.GetID();
        this
          .GetPersistencySystem()
          .QueueEntityEvent(action.GetRequesterID(), deviceWidgetEvent);
      }
    }
  }

  public const func GetVirtualSystem(out vs: VirtualSystemPS) -> Bool {
    let masters: [DeviceComponentPS];
    this.GetParents(masters);
    let i = 0;
    while i < ArraySize(masters) {
      if IsDefined(masters[i] as TerminalControllerPS) {
        if masters[i].GetVirtualSystem(this, vs) {
          return true;
        }
      }
      i += 1;
    }
    return false;
  }

