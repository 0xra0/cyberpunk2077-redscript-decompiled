class ResurrectDecisions extends HighLevelTransition {
  protected const final func ToExploration(const stateContext: StateContext, const scriptInterface: StateGameScriptInterface) -> Bool {
    if StatusEffectHelper
      .GetStatusEffectByID(scriptInterface.owner, t"BaseStatusEffect.SecondHeart")
      .GetRemainingDuration() <= 0.0 {
      return true;
    }
    return false;
  }

  protected const final func ToDeath(const stateContext: StateContext, const scriptInterface: StateGameScriptInterface) -> Bool {
    let state = IntEnum<gamePSMLandingState>(
      scriptInterface.localBlackboard.GetInt(GetAllBlackboardDefs().PlayerStateMachine.Landing)
    );
    return Equals(state, gamePSMLandingState.DeathLand) || Equals(state, gamePSMLandingState.VeryHardLand);
  }
}

