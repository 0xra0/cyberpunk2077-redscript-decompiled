public func GetFact(game: GameInstance, factName: CName) -> Int32 {
  if !IsNameValid(factName) {
    return 0;
  } else if !GameInstance.IsValid(game) {
    return 0;
  }
  return GameInstance.GetQuestsSystem(game).GetFact(factName);
}

