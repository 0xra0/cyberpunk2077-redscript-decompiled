}

class CombatGadgetInactiveDecisions extends CombatGadgetTransitions {
  protected const final func ToCombatGadgetQuickThrow(const stateContext: StateContext, const scriptInterface: StateGameScriptInterface) -> Bool {
    return scriptInterface.GetActionValue(n"UseCombatGadget")
      == 0.0
      && NotEquals(stateContext.GetStateMachineCurrentState(n"UpperBody"), n"useConsumable")
      && !this.IsInWeaponReloadState(scriptInterface);
  }

  protected const final func ToCombatGadgetEquip(const stateContext: StateContext, const scriptInterface: StateGameScriptInterface) -> Bool {
    return scriptInterface.IsActionJustHeld(n"UseCombatGadget") || stateContext.GetBoolParameter(n"cgCached", true);
  }
}

