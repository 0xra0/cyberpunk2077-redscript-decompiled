class WallScreenControllerPS extends TVControllerPS {
  private persistent let m_isShown: Bool;

  protected cb func OnInstantiated() -> Bool {
    super.OnInstantiated();
    if !IsStringValid(this.m_deviceName) {
      this.m_deviceName = "Gameplay-Devices-DisplayNames-WallScreen";
    }
  }

  protected func Initialize() {
    super.Initialize();
  }

  private final func ActionToggleShow() -> ToggleShow {
    let action = new ToggleShow();
    action.clearanceLevel = 2;
    action.SetUp(this);
    action.SetProperties(this.m_isShown);
    action.AddDeviceName(this.m_deviceName);
    return action;
  }

  public func GetActions(out actions: [DeviceAction], context: GetActionsContext) -> Bool {
    super.GetActions(actions, context);
    if !this.IsUserAuthorized(context.processInitiatorObject.GetEntityID()) {
      return false;
    } else if Clearance.IsInRange(context.clearance, 2) {
      ArrayPush(actions, this.ActionToggleShow());
    }
    this.SetActionIllegality(actions, this.m_illegalActions.regularActions);
    return true;
  }

  public final func OnToggleShow(evt: ToggleShow) -> EntityNotificationType {
    this.UseNotifier(evt);
    if this.IsUnpowered() || this.IsDisabled() {
      return EntityNotificationType.DoNotNotifyEntity;
    }
    this.m_isShown = !this.m_isShown;
    return EntityNotificationType.SendThisEventToEntity;
  }

  public const final func IsShown() -> Bool {
    return this.m_isShown;
  }

  public func GetDeviceIconPath() -> String {
    return "";
  }
}

class ToggleShow extends ActionBool {
