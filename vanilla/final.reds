  public const final func TryGetControlledProxy() -> GameObject {
    if this.IsPlayer()
      && StatusEffectSystem.ObjectHasStatusEffect(this, t"GameplayRestriction.NoCameraControl")
      && this.GetTakeOverControlSystem().IsDeviceControlled() {
      let proxy = this.GetTakeOverControlSystem().GetControlledObject();
      if proxy.IsSensor() && (proxy as SensorDevice).IsSurveillanceCamera() {
        return proxy;
      }
    }
    return null;
  }

