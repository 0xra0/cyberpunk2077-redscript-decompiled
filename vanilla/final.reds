    let context = this
      .GenerateContext(
        gamedeviceRequestType.Remote,
        this.GetClearance(),
        this.GetPlayerMainObject(),
        PersistentID.ExtractEntityID(this.GetID())
      );
    context.ignoresRPG = true;
    this.GetQuickHackActions(actions, context);
    return ArraySize(actions) > 0;
  }

  protected final func UpdateAvailAbleQuickHacks(const actions: script_ref<[DeviceAction]>) {
    this.ClearAvailableQuickHacks();
    let i = 0;
    while i < ArraySize(actions) {
      let action = actions[i] as ScriptableDeviceAction;
      if IsDefined(action) {
        this.AddAvailableQuickHack(action.GetActionID());
      }
      i += 1;
    }
  }

