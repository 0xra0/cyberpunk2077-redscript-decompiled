abstract class AISubActionActivateLightPreset_Record_Implementation extends IScriptable {
  public final static func Activate(
    context: ScriptExecutionContext,
    record: wref<AISubActionActivateLightPreset_Record>
  ) {
    if record.Delay() == 0.0 {
      AISubActionActivateLightPreset_Record_Implementation.ActivateLightPreset(context, record);
    }
  }

  public final static func Update(
    context: ScriptExecutionContext,
    record: wref<AISubActionActivateLightPreset_Record>,
    const duration: Float
  ) -> AIbehaviorUpdateOutcome {
    if record.Delay() <= 0.0 {
      return AIbehaviorUpdateOutcome.SUCCESS;
    } else if record.Delay() > 0.0 && duration >= record.Delay() {
      AISubActionActivateLightPreset_Record_Implementation.ActivateLightPreset(context, record);
      return AIbehaviorUpdateOutcome.SUCCESS;
    }
    return AIbehaviorUpdateOutcome.IN_PROGRESS;
  }

  public final static func Deactivate(
    context: ScriptExecutionContext,
    record: wref<AISubActionActivateLightPreset_Record>,
    const duration: Float,
    interrupted: Bool
  ) {
    if record.Delay() < 0.0 {
      AISubActionActivateLightPreset_Record_Implementation.ActivateLightPreset(context, record);
    }
  }

  protected final static func ActivateLightPreset(
    context: ScriptExecutionContext,
    record: wref<AISubActionActivateLightPreset_Record>
  ) {
    let preset: DiodeLightPreset;
    let recordPreset = record.LightPreset();
    preset.state = recordPreset.On();
    preset.colorMax = recordPreset.ColorMax();
    preset.colorMin = recordPreset.ColorMin();
    preset.overrideColorMin = recordPreset.OverrideColorMin();
    preset.strength = recordPreset.Strength();
    preset.curve = recordPreset.Curve();
    preset.time = recordPreset.Time();
    preset.loop = recordPreset.Loop();
    preset.duration = recordPreset.Duration();
    preset.force = recordPreset.Force();
    let applyPresetEvent = new ApplyDiodeLightPresetEvent();
    applyPresetEvent.preset = preset;
    ScriptExecutionContext.GetOwner(context).QueueEvent(applyPresetEvent);
  }
}

importonly native class AISubActionActivateLightPreset_Record extends AISubAction_Record {
  public final native func LightPreset() -> wref<LightPreset_Record>;

  public final native func LightPresetHandle() -> LightPreset_Record;

  public final native func Delay() -> Float;
}

