class ScriptedReactionSystem extends ScriptableSystem {
  private let m_fleeingNPCs: Int32;
  private let m_runners: [wref<Entity>];
  private let m_registeredTimeout: Float;
  private let m_callInAction: Bool;
  private let m_policeCaller: wref<Entity>;

  private final func OnRegisterFleeingNPC(request: RegisterFleeingNPC) {
    if !this.IsRegistered(request.runner) {
      this.m_fleeingNPCs = this.m_fleeingNPCs + 1;
      ArrayPush(this.m_runners, request.runner);
      if request.timestamp > this.m_registeredTimeout {
        this.m_registeredTimeout = request.timestamp + 2.0;
      }
    }
  }

  private final func OnUnregisterFleeingNPC(request: UnregisterFleeingNPC) {
    if this.IsRegistered(request.runner) {
      this.m_fleeingNPCs = this.m_fleeingNPCs - 1;
      ArrayRemove(this.m_runners, request.runner);
    }
  }

  public const final func GetFleeingNPCsCount() -> Int32 {
    return this.m_fleeingNPCs;
  }

  public const final func GetFleeingNPCsCountInDistance(position: Vector4, distance: Float) -> Int32 {
    let runners: Int32;
    let count = ArraySize(this.m_runners);
    let i = 0;
    while i < count {
      let distanceSquaredCheck = Vector4.DistanceSquared(this.m_runners[i].GetWorldPosition(), position);
      if distanceSquaredCheck < distance * distance {
        runners = runners + 1;
      }
      i += 1;
    }
    return runners;
  }

  public const final func GetRegisterTimeout() -> Float {
    return this.m_registeredTimeout;
  }

  private final func IsRegistered(runner: Entity) -> Bool {
    if ArrayContains(this.m_runners, runner) {
      return true;
    }
    return false;
  }

  private final func OnRegisterPoliceCaller(request: RegisterPoliceCaller) {
    if !this.m_callInAction || this.IsCallerCloser(request.caller, request.crimePosition) {
      this.m_callInAction = true;
      this.m_policeCaller = request.caller;
    }
  }

  private final func OnUnregisterPoliceCaller(request: UnregisterPoliceCaller) {
    this.m_callInAction = false;
    this.m_policeCaller = null;
  }

  private final func IsCallerCloser(newCaller: Entity, crimePosition: Vector4) -> Bool {
    let callerDistance = Vector4.DistanceSquared(this.m_policeCaller.GetWorldPosition(), crimePosition);
    let newCallerDistance = Vector4.DistanceSquared(newCaller.GetWorldPosition(), crimePosition);
    if newCallerDistance != 0.0 && newCallerDistance < callerDistance {
      return true;
    }
    return false;
  }

  public const final func IsCaller(entity: Entity) -> Bool {
    return entity == this.m_policeCaller;
  }
}

