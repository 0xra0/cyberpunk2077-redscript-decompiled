class TutorialPopupDisplayController extends inkLogicController {
  protected let m_title: inkTextRef;
  protected let m_message: inkTextRef;
  protected let m_image: inkImageRef;
  protected let m_video_1360x768: inkVideoRef;
  protected let m_video_1024x576: inkVideoRef;
  protected let m_video_1280x720: inkVideoRef;
  protected let m_video_720x405: inkVideoRef;
  protected let m_inputHint: inkWidgetRef;
  private let m_data: TutorialPopupData;

  public final func SetData(data: TutorialPopupData, inputDevice: InputDevice, inputScheme: InputScheme) {
    this.m_data = data;
    inkTextRef.SetText(this.m_title, this.m_data.title);
    this.UpdateMessage(inputDevice, inputScheme);
    this.SetVideoData(this.m_data.videoType, this.m_data.video);
    if TDBID.IsValid(this.m_data.imageId) {
      inkWidgetRef.SetVisible(this.m_image, true);
      InkImageUtils.RequestSetImage(this, this.m_image, this.m_data.imageId);
    } else {
      inkWidgetRef.SetVisible(this.m_image, false);
    }
    inkWidgetRef.SetVisible(this.m_inputHint, this.m_data.closeAtInput);
  }

  public final func Refresh(inputDevice: InputDevice, inputScheme: InputScheme) {
    this.UpdateMessage(inputDevice, inputScheme);
  }

  private final func UpdateMessage(inputDevice: InputDevice, inputScheme: InputScheme) {
    if inkWidgetRef.IsValid(this.m_message) {
      let i = 0;
      if i < ArraySize(this.m_data.messageOverrideDataList) {
        if Equals(this.m_data.messageOverrideDataList[i].inputDevice, inputDevice)
          && (Equals(this.m_data.messageOverrideDataList[i].inputDevice, InputDevice.KBM)
            || Equals(this.m_data.messageOverrideDataList[i].inputScheme, inputScheme)) {
          inkTextRef
            .SetText(
              this.m_message,
              this.m_data.messageOverrideDataList[i].GetOverriddenLocalizedText()
            );
          let isEntryDescriptionOverridden = true;
        } else {
          i += 1;
        }
      } else if !isEntryDescriptionOverridden {
        inkTextRef.SetText(this.m_message, this.m_data.message);
      }
    }
  }

  private final func SetVideoData(videoType: VideoType, video: ResRef) {
    inkWidgetRef.SetVisible(this.m_video_1360x768, false);
    inkWidgetRef.SetVisible(this.m_video_1024x576, false);
    inkWidgetRef.SetVisible(this.m_video_1280x720, false);
    inkWidgetRef.SetVisible(this.m_video_720x405, false);
    switch videoType {
      case VideoType.Tutorial_720x405:
        this.PlayVideo(this.m_video_720x405, video);
        break;
      case VideoType.Tutorial_1024x576:
        this.PlayVideo(this.m_video_1024x576, video);
        break;
      case VideoType.Tutorial_1280x720:
        this.PlayVideo(this.m_video_1280x720, video);
        break;
      case VideoType.Tutorial_1360x768:
        this.PlayVideo(this.m_video_1360x768, video);
        break;
    }
  }

  private final func PlayVideo(videoWidget: inkVideoRef, video: ResRef) {
    if ResRef.IsValid(video) {
      inkVideoRef.Stop(videoWidget);
      inkVideoRef.SetVideoPath(videoWidget, video);
      inkVideoRef.SetLoop(videoWidget, true);
      inkVideoRef.Play(videoWidget);
      inkWidgetRef.SetVisible(videoWidget, true);
    }
  }
}

