class OnStatusEffectAppliedListener extends ScriptStatusEffectListener {
  public let m_effector: wref<ModifyStatusEffectDurationEffector>;
  public let m_tags: [CName];
  public let m_owner: wref<GameObject>;

  public func OnStatusEffectApplied(statusEffect: wref<StatusEffect_Record>) {
    let j = 0;
    while j < ArraySize(this.m_tags) {
      if StatusEffectHelper.HasTag(statusEffect, this.m_tags[j]) {
        this.m_effector.ProcessAction(this.m_owner);
      }
      j += 1;
    }
  }
}

class ModifyStatusEffectDurationEffector extends Effector {
  private let m_statusEffectListener: OnStatusEffectAppliedListener;
  public let m_tags: [CName];
  public let m_change: Float;
  public let m_isPercentage: Bool;
  public let m_listenConstantly: Bool;
  public let m_canGoOverInitialDuration: Bool;
  public let m_gameInstance: GameInstance;

  protected func Initialize(record: TweakDBID, game: GameInstance, parentRecord: TweakDBID) {
    this.m_tags = TweakDBInterface.GetCNameArray(record + t".gameplayTags");
    this.m_change = TweakDBInterface.GetFloat(record + t".change", 0.0);
    this.m_isPercentage = TweakDBInterface.GetBool(record + t".isPercentage", false);
    this.m_listenConstantly = TweakDBInterface.GetBool(record + t".listenConstantly", false);
    this.m_canGoOverInitialDuration = TweakDBInterface.GetBool(record + t".canGoOverInitialDuration", true);
    this.m_gameInstance = game;
  }

  public final func ProcessAction(owner: GameObject) {
    let appliedStatusEffects: [StatusEffect];
    let statModifiers: [wref<StatModifier_Record>];
    let durationValue = 1.0;
    let finalChange = this.m_change;
    let j = 0;
    while j < ArraySize(this.m_tags) {
      if StatusEffectHelper.GetAppliedEffectsWithTag(owner, this.m_tags[j], appliedStatusEffects) {
        let i = 0;
        while i < ArraySize(appliedStatusEffects) {
          let remainingDuration = appliedStatusEffects[i].GetRemainingDuration();
          if remainingDuration <= 0.0 {
          } else {
            let duration = appliedStatusEffects[i].GetRecord().Duration();
            duration.StatModifiers(statModifiers);
            durationValue = RPGManager
              .CalculateStatModifiers(
                statModifiers,
                this.m_gameInstance,
                owner,
                Cast<StatsObjectID>(owner.GetEntityID())
              );
            if this.m_isPercentage {
              finalChange = durationValue * (this.m_change / 100.0);
            } else {
              remainingDuration = MaxF(0.0, remainingDuration + finalChange);
              if !this.m_canGoOverInitialDuration && remainingDuration > durationValue {
                remainingDuration = durationValue;
              } else {
                GameInstance
                  .GetStatusEffectSystem(this.m_gameInstance)
                  .SetStatusEffectRemainingDuration(
                    owner.GetEntityID(),
                    appliedStatusEffects[i].GetRecord().GetID(),
                    remainingDuration
                  );
              }
            }
          }
          i += 1;
        }
      }
      j += 1;
    }
  }

  protected func ActionOn(owner: GameObject) {
    this.ProcessAction(owner);
    if this.m_listenConstantly {
      this.m_statusEffectListener = new OnStatusEffectAppliedListener();
      this.m_statusEffectListener.m_owner = owner;
      this.m_statusEffectListener.m_tags = this.m_tags;
      this.m_statusEffectListener.m_effector = this;
      GameInstance
        .GetStatusEffectSystem(this.m_gameInstance)
        .RegisterListener(owner.GetEntityID(), this.m_statusEffectListener);
    }
  }

  protected func RepeatedAction(owner: GameObject) {
    this.ProcessAction(owner);
  }

  protected func ActionOff(owner: GameObject) {
    this.m_statusEffectListener = null;
  }
}

