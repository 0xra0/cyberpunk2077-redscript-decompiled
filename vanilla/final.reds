class AIQuickHackAction extends PuppetAction {
  public let m_target: wref<GameObject>;
  public let m_scaleUploadTime: Bool;
  public let m_HUDData: HUDProgressBarData;

  protected func SetRegenBehavior(gameInstance: GameInstance) {
    let regenMod: StatPoolModifier;
    let statValue: Float;
    let multiplier: Float;
    GameInstance
      .GetStatPoolsSystem(gameInstance)
      .GetModifier(
        Cast<StatsObjectID>(this.GetRequesterID()),
        gamedataStatPoolType.QuickHackUpload,
        gameStatPoolModificationTypes.Regeneration,
        regenMod
      );
    if this.m_scaleUploadTime {
      statValue = GameInstance
        .GetStatsSystem(this.m_target.GetGame())
        .GetStatValue(
          Cast<StatsObjectID>(this.m_target.GetEntityID()),
          gamedataStatType.NPCUploadTime
        );
      let distanceToTarget = Vector4
        .Distance(
          this.m_executor.GetWorldPosition(),
          GameInstance.FindEntityByID(gameInstance, this.m_requesterID).GetWorldPosition()
        );
      multiplier = PowF(1.02, distanceToTarget);
    } else {
      statValue = 1.0;
      multiplier = 1.0;
    }
    let activationTime = this.GetActivationTime();
    regenMod.enabled = true;
    regenMod.valuePerSec = 100.0 / (multiplier * activationTime * statValue);
    regenMod.rangeEnd = 100.0;
    GameInstance
      .GetStatPoolsSystem(gameInstance)
      .RequestSettingModifier(
        Cast<StatsObjectID>(this.GetRequesterID()),
        gamedataStatPoolType.QuickHackUpload,
        gameStatPoolModificationTypes.Regeneration,
        regenMod
      );
  }

  private func StartUpload(gameInstance: GameInstance) {
    let uploadListener: QuickHackUploadListener;
    let requesterGO = GameInstance.FindEntityByID(gameInstance, this.m_requesterID) as GameObject;
    let statPoolSys = GameInstance.GetStatPoolsSystem(gameInstance);
    if requesterGO.IsPlayer() {
      let npcToPlayerListener = new UploadFromNPCToPlayerListener();
      npcToPlayerListener.m_npcPuppet = this.m_executor as ScriptedPuppet;
      npcToPlayerListener.m_playerPuppet = requesterGO as ScriptedPuppet;
      npcToPlayerListener.m_HUDData = this.m_HUDData;
      uploadListener = npcToPlayerListener;
    } else {
      let npcToNpcListener = new UploadFromNPCToNPCListener();
      npcToNpcListener.m_npcPuppet = this.m_executor as ScriptedPuppet;
      uploadListener = npcToNpcListener;
    }
    uploadListener.m_action = this;
    uploadListener.m_gameInstance = gameInstance;
    let statMod = RPGManager
      .CreateStatModifier(
        gamedataStatType.QuickHackUpload,
        gameStatModifierType.Additive,
        this.GetActivationTime()
      );
    GameInstance
      .GetStatsSystem(gameInstance)
      .RemoveAllModifiers(Cast<StatsObjectID>(this.m_requesterID), gamedataStatType.QuickHackUpload);
    GameInstance
      .GetStatsSystem(gameInstance)
      .AddModifier(Cast<StatsObjectID>(this.m_requesterID), statMod);
    statPoolSys
      .RequestSettingStatPoolValue(
        Cast<StatsObjectID>(this.m_requesterID),
        gamedataStatPoolType.QuickHackUpload,
        0.0,
        this.m_executor
      );
    statPoolSys
      .RequestRegisteringListener(
        Cast<StatsObjectID>(this.m_requesterID),
        gamedataStatPoolType.QuickHackUpload,
        uploadListener
      );
    statPoolSys
      .RequestAddingStatPool(
        Cast<StatsObjectID>(this.m_requesterID),
        t"BaseStatPools.BaseQuickHackUpload"
      );
    uploadListener.Initialize();
    this.SetRegenBehavior(gameInstance);
  }

  protected func ProcessStatusEffects(
    const actionEffects: script_ref<[wref<ObjectActionEffect_Record>]>,
    gameInstance: GameInstance
  ) {
    super.ProcessStatusEffects(actionEffects, gameInstance);
  }
}

class UploadFromNPCToNPCListener extends QuickHackUploadListener {
  public let m_npcPuppet: wref<ScriptedPuppet>;

  public func OnStatPoolValueChanged(oldValue: Float, newValue: Float, percToPoints: Float) {
    if !ScriptedPuppet.IsActive(this.m_npcPuppet) {
      this.RemoveLinkedStatusEffects(this.m_npcPuppet);
      GameInstance
        .GetStatPoolsSystem(this.m_gameInstance)
        .RequestRemovingStatPool(
          Cast<StatsObjectID>(this.m_action.GetRequesterID()),
          gamedataStatPoolType.QuickHackUpload
        );
      GameInstance
        .GetStatPoolsSystem(this.m_gameInstance)
        .RequestUnregisteringListener(
          Cast<StatsObjectID>(this.m_action.GetRequesterID()),
          gamedataStatPoolType.QuickHackUpload,
          this
        );
      let uploadEvent = new UploadProgramProgressEvent();
      uploadEvent.state = EUploadProgramState.COMPLETED;
      GameInstance
        .GetPersistencySystem(this.m_gameInstance)
        .QueueEntityEvent(this.m_action.GetRequesterID(), uploadEvent);
    }
  }
}

