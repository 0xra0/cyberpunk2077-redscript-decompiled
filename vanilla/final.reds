class EffectExecutor_GameObjectOutline extends EffectExecutor_Scripted {
  public let m_outlineType: EOutlineType;

  public final func Process(ctx: EffectScriptContext, applierCtx: EffectExecutionScriptContext) -> Bool {
    let data: OutlineData;
    let id: CName;
    let lifetime = 30.0;
    if Equals(this.m_outlineType, EOutlineType.RED) {
      id = n"EffectExecutor_GameObjectOutline_RED";
    } else {
      id = n"EffectExecutor_GameObjectOutline_GREEN";
    }
    let target = EffectExecutionScriptContext.GetTarget(applierCtx);
    let outlineEvent = new OutlineRequestEvent();
    data.outlineType = this.m_outlineType;
    data.outlineOpacity = 1.0;
    outlineEvent.outlineRequest = OutlineRequest.CreateRequest(id, data, lifetime);
    target.QueueEvent(outlineEvent);
    let revealEvent = new RevealObjectEvent();
    revealEvent.reveal = true;
    revealEvent.reason.reason = n"tag";
    revealEvent.lifetime = lifetime;
    target.QueueEvent(revealEvent);
    return true;
  }
}

importonly native struct EffectExecutionScriptContext {
  public final native static func GetTimeDelta(applierCtx: EffectExecutionScriptContext) -> Float;

  public final native static func GetTarget(applierCtx: EffectExecutionScriptContext) -> Entity;

  public final native static func GetTargetNode(applierCtx: EffectExecutionScriptContext) -> GlobalNodeID;

  public final native static func GetHitPosition(applierCtx: EffectExecutionScriptContext) -> Vector4;

  public final native static func GetHitNormal(applierCtx: EffectExecutionScriptContext) -> Vector4;

  public final native static func GetHitThroughTechSurface(applierCtx: EffectExecutionScriptContext) -> Bool;

  public final native static func GetHitThroughWaterSurface(applierCtx: EffectExecutionScriptContext) -> Bool;

  public final native static func IsTargetWater(applierCtx: EffectExecutionScriptContext) -> Bool;
}

