class MinigameGenerationRulePredefinedBoardWithTraps extends MinigameGenerationRule {
  protected func OnProcessRule(size: Uint32, out grid: [[GridCell]]) -> Bool {
    let tempCell: GridCell;
    let tempArray: [GridCell];
    let recordGrid: [wref<RowSymbols_Record>];
    let recordTrapsGrid: [wref<RowTraps_Record>];
    this.m_minigameRecord.GridSymbols(recordGrid);
    this.m_minigameRecord.GridTraps(recordTrapsGrid);
    let i = 0;
    while i < Cast<Int32>(size) {
      let j = 0;
      while j < Cast<Int32>(size) {
        let recordRow = recordGrid[i];
        let row = recordRow.Symbols();
        tempCell.rarityValue = row[j];
        let recordTrapsRow = recordTrapsGrid[i];
        let rowTraps = recordTrapsRow.Traps();
        tempCell.currentTrap = this.IntToTrap(rowTraps[j]);
        ArrayPush(tempArray, tempCell);
        j += 1;
      }
      ArrayPush(grid, tempArray);
      ArrayClear(tempArray);
      i += 1;
    }
    return true;
  }
}

