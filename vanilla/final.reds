class BlacklistEntry extends IScriptable {
  private persistent let entryID: EntityID;
  private persistent let entryReason: BlacklistReason;
  private persistent let warningsCount: Int32;
  private persistent let reprimandID: Int32;

  public final func Initialize(entityID: EntityID, reason: BlacklistReason, id: Int32) {
    this.entryID = entityID;
    this.entryReason = reason;
    if Equals(reason, BlacklistReason.REPRIMAND) {
      this.reprimandID = id;
      this.warningsCount = 1;
    }
  }

  public const final func GetEntityID() -> EntityID {
    return this.entryID;
  }

  public const final func GetReason() -> BlacklistReason {
    return this.entryReason;
  }

  public const final func GetWarningsCount() -> Int32 {
    return this.warningsCount;
  }

  private final func AddWarning() {
    this.warningsCount += 1;
  }

  private final func ResetWarnings() {
    this.warningsCount = 0;
  }

  public final func UpdateBlacklistEntry(reason: BlacklistReason, id: Int32) -> Bool {
    if EnumInt(reason) < EnumInt(this.GetReason()) {
      return false;
    } else if Equals(reason, BlacklistReason.COMBAT) {
      this.ResetWarnings();
    } else if Equals(reason, BlacklistReason.REPRIMAND) && this.reprimandID != id {
      this.AddWarning();
    } else if NotEquals(reason, this.GetReason()) {
      this.entryReason = reason;
      return true;
    }
    return false;
  }

  public final func ForgetReason() {
    this.entryReason = BlacklistReason.UNINITIALIZED;
  }
}

public func OperatorGreaterEqual(enum1: ESecurityNotificationType, enum2: ESecurityNotificationType) -> Bool {
  if EnumInt(enum1) >= EnumInt(enum2) {
