  protected func UpdateRequirementsModule() {
    let anyRequirementNotMet = this.m_data.requirements.isLevelRequirementNotMet
      || this.m_data.requirements.isSmartlinkRequirementNotMet
      || this.m_data.requirements.isStrengthRequirementNotMet
      || this.m_data.requirements.isReflexRequirementNotMet
      || this.m_data.requirements.isAnyStatRequirementNotMet
      || this.m_data.requirements.isPerkRequirementNotMet
      || this.m_data.requirements.isRarityRequirementNotMet;
    if anyRequirementNotMet || ArraySize(this.m_data.attributeAllocationStats) > 0 {
      if !IsDefined(this.m_itemRequirementsController) {
        this
          .RequestModule(
            this.m_itemRequirementsContainer,
            n"itemRequirements",
            n"OnRequirementsModuleSpawned"
          );
        return;
      }
      inkWidgetRef.SetVisible(this.m_itemRequirementsContainer, true);
      this.m_itemRequirementsController.Update(this.m_data);
      if !this.m_inCrafting {
        this.m_itemRequirementsController.UpdateWrapping(this.m_bigFontEnabled);
      }
    } else {
      inkWidgetRef.SetVisible(this.m_itemRequirementsContainer, false);
    }
  }

