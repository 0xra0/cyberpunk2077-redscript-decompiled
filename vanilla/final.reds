    if this.m_initialized {
      return;
    }
    this.m_initialized = true;
    this.m_result = true;
    if !AIActionHelper
      .CheckAbility(
        ScriptExecutionContext.GetOwner(context),
        TweakDBInterface.GetGameplayAbilityRecord(t"Ability.CanSprintHarass")
      ) {
