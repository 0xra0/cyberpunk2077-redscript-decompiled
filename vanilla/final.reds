native struct inkTextRef extends inkLeafRef {
  public final native static func GetText(self: inkTextRef) -> String;

  public final native static func SetText(self: inkTextRef, displayText: String, opt textParams: inkTextParams);

  public final native static func SetTextDirect(self: inkTextRef, displayText: String);

  public final native static func SetLocalizedText(self: inkTextRef, locKey: CName, opt textParams: inkTextParams);

  public final native static func SetLocalizedTextString(self: inkTextRef, locKey: String, opt textParams: inkTextParams);

  public final static func SetLocalizedTextScript(self: inkTextRef, const locKey: script_ref<String>, opt textParams: inkTextParams) {
    if IsStringNumber(locKey) {
      inkTextRef.SetText(self, locKey, textParams);
    } else if !IsStringValid(locKey) {
      inkTextRef.SetText(self, "", textParams);
    } else {
      inkTextRef.SetLocalizedTextString(self, locKey, textParams);
    }
  }

  public final static func SetLocalizedTextScript(self: inkTextRef, locKey: CName, opt textParams: inkTextParams) {
    if !IsNameValid(locKey) {
      inkTextRef.SetText(self, "", textParams);
    } else {
      inkTextRef.SetLocalizedText(self, locKey, textParams);
    }
  }

  public final native static func GetTextParameters(self: inkTextRef) -> inkTextParams;

  public final native static func SetTextParameters(self: inkTextRef, textParams: inkTextParams);

  public final native static func GetLocalizationKey(self: inkTextRef) -> CName;

  public final native static func SetLocalizationKey(self: inkTextRef, displayText: CName);

  public final native static func SetLocalizationKeyString(self: inkTextRef, displayText: String);

  public final native static func UpdateLanguageResources(self: inkTextRef, opt applyFontModifiers: Bool);

  public final native static func SetTextFromParts(self: inkTextRef, textpart1: String, opt textpart2: String, opt textpart3: String);

  public final native static func GetVerticalAlignment(self: inkTextRef) -> textVerticalAlignment;

  public final native static func SetVerticalAlignment(self: inkTextRef, verticalAlignment: textVerticalAlignment);

  public final static func GetVerticalAlignmentEnumValue(self: inkTextRef, nameValue: CName) -> textVerticalAlignment {
    let returnValue: textVerticalAlignment;
    if Equals(nameValue, n"Top") {
      returnValue = textVerticalAlignment.Top;
    } else if Equals(nameValue, n"Bottom") {
      returnValue = textVerticalAlignment.Bottom;
    } else if Equals(nameValue, n"Center") {
      returnValue = textVerticalAlignment.Center;
    }
    return returnValue;
  }

  public final native static func GetHorizontalAlignment(self: inkTextRef) -> textHorizontalAlignment;

  public final native static func SetHorizontalAlignment(self: inkTextRef, horizontalAlignment: textHorizontalAlignment);

  public final static func GetHorizontalAlignmentEnumValue(self: inkTextRef, nameValue: CName) -> textHorizontalAlignment {
    let returnValue: textHorizontalAlignment;
    if Equals(nameValue, n"Left") {
      returnValue = textHorizontalAlignment.Left;
    } else if Equals(nameValue, n"Right") {
      returnValue = textHorizontalAlignment.Right;
    } else if Equals(nameValue, n"Center") {
      returnValue = textHorizontalAlignment.Center;
    }
    return returnValue;
  }

  public final native static func SetFontFamily(self: inkTextRef, fontFamilyPath: String, opt fontStyle: CName);

  public final native static func GetFontStyle(self: inkTextRef) -> CName;

  public final native static func SetFontStyle(self: inkTextRef, fontStyle: CName);

  public final native static func GetFontSize(self: inkTextRef) -> Int32;

  public final native static func SetFontSize(self: inkTextRef, textSize: Int32);

  public final native static func GetLetterCase(self: inkTextRef) -> textLetterCase;

  public final native static func SetLetterCase(self: inkTextRef, letterCase: textLetterCase);

  public final native static func EnableAutoScroll(self: inkTextRef, enableState: Bool);

  public final native static func SetDateTimeByTimestamp(self: inkTextRef, timestamp: Uint64);

  public final native static func GetScrollTextSpeed(self: inkTextRef) -> Float;

  public final native static func SetScrollTextSpeed(self: inkTextRef, scrollTextSpeed: Float);

  public final native static func SetWrappingAtPosition(self: inkTextRef, position: Float);
}

