class VendingMachine extends InteractiveDevice {
  private let m_vendorID: VendorComponent;
  protected let m_advUiComponent: IComponent;
  protected let m_isShortGlitchActive: Bool;
  protected let m_shortGlitchDelayID: DelayID;

  protected cb func OnRequestComponents(ri: EntityRequestComponentsInterface) -> Bool {
    super.OnRequestComponents(ri);
    EntityRequestComponentsInterface.RequestComponent(ri, n"ui", n"worlduiWidgetComponent", false);
    EntityRequestComponentsInterface.RequestComponent(ri, n"ads", n"AdvertisementWidgetComponent", false);
    EntityRequestComponentsInterface.RequestComponent(ri, n"VendorID", n"VendorComponent", false);
  }

  protected cb func OnTakeControl(ri: EntityResolveComponentsInterface) -> Bool {
    super.OnTakeControl(ri);
    this.m_uiComponent = EntityResolveComponentsInterface.GetComponent(ri, n"ui") as worlduiWidgetComponent;
    this.m_advUiComponent = EntityResolveComponentsInterface.GetComponent(ri, n"ads");
    this.m_vendorID = EntityResolveComponentsInterface.GetComponent(ri, n"VendorID") as VendorComponent;
    this.m_controller = EntityResolveComponentsInterface.GetComponent(ri, n"controller") as VendingMachineController;
  }

  protected final func AttachVendor() {
    GameInstance
      .GetDelaySystem(this.GetGame())
      .QueueTask(this, null, n"AttachVendorTask", gameScriptTaskExecutionStage.Any);
  }

  protected final func AttachVendorTask(data: ScriptTaskData) {
    let vendorID = this.GetVendorID();
    if TDBID.IsValid(vendorID) {
      let request = new AttachVendorRequest();
      request.owner = this;
      request.vendorID = vendorID;
      MarketSystem.GetInstance(this.GetGame()).QueueRequest(request);
    }
  }

  protected final func DeattachVendor() {
    GameInstance
      .GetDelaySystem(this.GetGame())
      .QueueTask(this, null, n"DeattachVendorTask", gameScriptTaskExecutionStage.Any);
  }

  protected final func DeattachVendorTask(data: ScriptTaskData) {
    let vendorID = this.GetVendorID();
    if TDBID.IsValid(vendorID) {
      let request = new DeattachVendorRequest();
      request.owner = this;
      request.vendorID = vendorID;
      MarketSystem.GetInstance(this.GetGame()).QueueRequest(request);
    }
  }

  protected func ResolveGameplayState() {
    super.ResolveGameplayState();
    this.AttachVendor();
    if this.IsUIdirty() && this.m_isInsideLogicArea {
      this.RefreshUI();
    }
  }

  public func GetVendorID() -> TweakDBID {
    return this.m_vendorID.GetVendorID();
  }

  protected func DeactivateDevice() {
    super.DeactivateDevice();
    this.TurnOffDevice();
  }

  protected func TurnOffDevice() {
    this.m_uiComponent.Toggle(false);
    this.m_advUiComponent.Toggle(false);
    this.ToggleLights(false);
    super.TurnOffDevice();
  }

  protected func TurnOnDevice() {
    this.m_uiComponent.Toggle(true);
    this.m_advUiComponent.Toggle(true);
    this.ToggleLights(true);
    super.TurnOnDevice();
  }

  protected cb func OnAreaEnter(evt: AreaEnteredEvent) -> Bool {
    this.RefreshUI();
  }

  protected func GetProcessingSFX() -> CName {
    return this.m_vendorID.GetProcessingSFX();
  }

  protected cb func OnDispenceItemFromVendor(evt: DispenceItemFromVendor) -> Bool {
    if evt.IsStarted() {
      let transactionSys = GameInstance.GetTransactionSystem(this.GetGame());
      let price = MarketSystem.GetBuyPrice(this, evt.GetItemID());
      let playerMoney = transactionSys.GetItemQuantity(GetPlayer(this.GetGame()), MarketSystem.Money());
      if playerMoney > price {
        this
          .DelayVendingMachineEvent(this.GetDevicePS().GetTimeToCompletePurchase(), false, true, evt.GetItemID());
        GameObject.PlaySoundEvent(this, this.GetProcessingSFX());
        this.SendDataToUIBlackboard(PaymentStatus.IN_PROGRESS);
      } else {
        this.SendDataToUIBlackboard(PaymentStatus.NO_MONEY);
      }
    } else {
      this.SendDataToUIBlackboard(PaymentStatus.DEFAULT);
    }
  }

  protected final func DelayVendingMachineEvent(time: Float, isFree: Bool, isReady: Bool, opt itemID: ItemID) {
    let evt = new VendingMachineFinishedEvent();
    if ItemID.IsValid(itemID) {
      evt.itemID = itemID;
    }
    evt.isFree = isFree;
    evt.isReady = isReady;
    GameInstance.GetDelaySystem(this.GetGame()).DelayEvent(this, evt, time);
  }

  protected cb func OnVendingMachineFinishedEvent(evt: VendingMachineFinishedEvent) -> Bool {
    if this.GetDevicePS().IsSoldOut() {
      this.SendSoldOutToUIBlackboard(true);
    } else if evt.isReady {
      this.GetDevicePS().SetIsReady(true);
    }
    this.DispenseItems(this.CreateDispenseRequest(!evt.isFree, evt.itemID));
    this.PlayItemFall();
    this.RefreshUI();
  }

  protected func DispenseItems(request: DispenseRequest) {
    MarketSystem.GetInstance(this.GetGame()).QueueRequest(request);
  }

  protected final func DispenseStack(request: DispenseStackRequest) {
    MarketSystem.GetInstance(this.GetGame()).QueueRequest(request);
  }

  protected func CreateDispenseRequest(shouldPay: Bool, item: ItemID) -> DispenseRequest {
    let dispenseRequest = new DispenseRequest();
    dispenseRequest.owner = this;
    dispenseRequest.position = this.RandomizePosition();
    dispenseRequest.shouldPay = shouldPay;
    if ItemID.IsValid(item) {
      dispenseRequest.itemID = item;
    }
    return dispenseRequest;
  }

  protected func CreateQuestDispenseStackRequest(item: ItemID, amount: Int32) -> DispenseStackRequest {
    let dispenseRequest = new DispenseStackRequest();
    dispenseRequest.owner = this;
    dispenseRequest.itemID = item;
    dispenseRequest.amount = amount;
    dispenseRequest.position = this.RandomizePosition();
    dispenseRequest.shouldPay = false;
    dispenseRequest.bypassStock = true;
    return dispenseRequest;
  }

  protected func BuyItems(request: BuyRequest) {
    let uiSys = GameInstance.GetUISystem(this.GetGame());
    let evt = new VendorBoughtItemEvent();
    let i = 0;
    let limit = ArraySize(request.items);
    while i < limit {
      ArrayPush(evt.items, request.items[i].itemID);
      i += 1;
    }
    uiSys.QueueEvent(evt);
    MarketSystem.GetInstance(this.GetGame()).QueueRequest(request);
  }

  protected final func CreateBuyRequest(opt itemID: ItemID) -> BuyRequest {
    let buyRequestData: TransactionRequestData;
    if ItemID.IsValid(itemID) {
      buyRequestData.itemID = itemID;
    }
    let buyRequest = new BuyRequest();
    buyRequest.owner = this;
    ArrayPush(buyRequest.items, buyRequestData);
    return buyRequest;
  }

  protected func PlayItemFall() {
    GameObject.PlaySoundEvent(this, this.m_vendorID.GetItemFallSFX());
  }

  protected final func RandomizePosition() -> Vector4 {
    let offset: Vector4;
    let transform: WorldTransform;
    this.GetSlotComponent().GetSlotTransform(n"itemSpawn", transform);
    offset.X = RandRangeF(-0.1, 0.1);
    offset.Y = RandRangeF(-0.02, 0.02);
    offset.Z = RandRangeF(-0.05, 0.02);
    offset.W = 1.0;
    let position = WorldPosition.ToVector4(WorldTransform.TransformPoint(transform, offset));
    return position;
  }

  protected func StartGlitching(glitchState: EGlitchState, opt intensity: Float) {
    this.HackedEffect();
    this.AdvertGlitch(true, this.GetGlitchData(glitchState));
    GameObject.PlaySoundEvent(this, this.GetDevicePS().GetGlitchStartSFX());
    this.RefreshUI();
  }

  protected func StopGlitching() {
    this.AdvertGlitch(false, this.GetGlitchData(EGlitchState.NONE));
    GameObject.PlaySoundEvent(this, this.GetDevicePS().GetGlitchStopSFX());
    this.GetDevicePS().SetIsReady(true);
    this.RefreshUI();
  }

  protected final func GetGlitchData(glitchState: EGlitchState) -> GlitchData {
    let data: GlitchData;
    data.state = glitchState;
    if NotEquals(glitchState, EGlitchState.NONE) {
      data.intensity = 1.0;
    }
    return data;
  }

  protected func HackedEffect() {
    if this
      .GetBlackboard()
      .GetBool(GetAllBlackboardDefs().VendingMachineDeviceBlackboard.SoldOut) {
      return;
    }
    let TS = GameInstance.GetTransactionSystem(this.GetGame());
    let max = this.GetDevicePS().GetHackedItemCount();
    let itemCount = this.m_vendorID.GetJunkCount();
    let junkPool = this.m_vendorID.GetJunkItemIDs();
    let i = 0;
    while i < max {
      if itemCount > 1 {
        let index = RandRange(0, itemCount);
      } else if ArraySize(junkPool) > 0 {
        let junkItem = ItemID.FromTDBID(junkPool[index].m_junkItemID);
        if ItemID.IsValid(junkItem) {
          TS.GiveItem(this, junkItem, 1);
          this.DelayHackedEvent(Cast<Float>(i) / 5.0, junkItem);
        }
      }
      i += 1;
    }
    if this.GetDevicePS().IsSoldOut() {
      this.SendSoldOutToUIBlackboard(true);
    }
  }

  protected func GetJunkItem() -> ItemID {
    return ItemID.None();
  }

  protected final func DelayHackedEvent(time: Float, itemID: ItemID) {
    let evt = new DelayHackedEvent();
    if ItemID.IsValid(itemID) {
      evt.itemID = itemID;
      GameInstance.GetDelaySystem(this.GetGame()).DelayEvent(this, evt, time);
    }
  }

  protected cb func OnDelayHackedEvent(evt: DelayHackedEvent) -> Bool {
    GameInstance
      .GetLootManager(this.GetGame())
      .SpawnItemDrop(this, evt.itemID, this.RandomizePosition());
    this.PlayItemFall();
  }

  protected final func AdvertGlitch(start: Bool, data: GlitchData) {
    this.SimpleGlitch(start);
    this
      .GetBlackboard()
      .SetVariant(this.GetBlackboardDef().GlitchData, ToVariant(data), true);
    this.GetBlackboard().FireCallbacks();
  }

  protected final func SimpleGlitch(on: Bool) {
    let evt = new AdvertGlitchEvent();
    if on {
      evt.SetShouldGlitch(1.0);
    } else {
      evt.SetShouldGlitch(0.0);
    }
    this.QueueEvent(evt);
  }

  protected cb func OnQuestDispenseFreeItem(evt: DispenseFreeItem) -> Bool {
    this.DelayVendingMachineEvent(0.5, true, true);
  }

  protected cb func OnQuestDispenseSpecificItem(evt: DispenseFreeSpecificItem) -> Bool {
    this.DelayVendingMachineEvent(0.5, true, true, ItemID.FromTDBID(evt.item));
  }

  protected cb func OnDispenseStackOfItems(evt: DispenseStackOfItems) -> Bool {
    this
      .DispenseStack(
        this
          .CreateQuestDispenseStackRequest(ItemID.FromTDBID(evt.item), evt.amount)
      );
  }

  protected final func ToggleLights(on: Bool) {
    let evt = new ToggleLightEvent();
    evt.toggle = on;
    this.QueueEvent(evt);
  }

  public const func DeterminGameplayRole() -> EGameplayRole {
    return EGameplayRole.Distract;
  }

  private func InitializeScreenDefinition() {
    if !TDBID.IsValid(this.m_screenDefinition.screenDefinition) {
      this.m_screenDefinition.screenDefinition = t"DevicesUIDefinitions.Terminal_4x3";
    } else if !TDBID.IsValid(this.m_screenDefinition.style) {
      this.m_screenDefinition.style = t"DevicesUIStyles.None";
    }
  }

  public const func GetBlackboardDef() -> VendingMachineDeviceBlackboardDef {
    return this.GetDevicePS().GetBlackboardDef();
  }

  protected func CreateBlackboard() {
    this.m_blackboard = IBlackboard.Create(GetAllBlackboardDefs().VendingMachineDeviceBlackboard);
  }

  protected final func SendDataToUIBlackboard(status: PaymentStatus) {
    this
      .GetBlackboard()
      .SetVariant(
        GetAllBlackboardDefs().VendingMachineDeviceBlackboard.ActionStatus,
        ToVariant(status)
      );
    this.GetBlackboard().FireCallbacks();
  }

  protected final func SendSoldOutToUIBlackboard(soldOut: Bool) {
    this
      .GetBlackboard()
      .SetBool(GetAllBlackboardDefs().VendingMachineDeviceBlackboard.SoldOut, soldOut);
    this.GetBlackboard().FireCallbacks();
  }

  protected const func GetController() -> VendingMachineController {
    return this.m_controller as VendingMachineController;
  }

  public const func GetDevicePS() -> VendingMachineControllerPS {
    return this.GetController().GetPS();
  }

  protected cb func OnHitEvent(hit: gameHitEvent) -> Bool {
    super.OnHitEvent(hit);
    this.StartShortGlitch();
  }

  private final func StartShortGlitch() {
    if this.GetDevicePS().IsGlitching() {
      return;
    } else if !this.m_isShortGlitchActive {
      let evt = new StopShortGlitchEvent();
      this.SimpleGlitch(true);
      this.m_shortGlitchDelayID = GameInstance.GetDelaySystem(this.GetGame()).DelayEvent(this, evt, 0.25);
      this.m_isShortGlitchActive = true;
    }
  }

  protected cb func OnStopShortGlitch(evt: StopShortGlitchEvent) -> Bool {
    this.m_isShortGlitchActive = false;
    if !this.GetDevicePS().IsGlitching() {
      this.SimpleGlitch(false);
    }
  }
}

class VendorComponent extends ScriptableComponent {
  private let m_vendorTweakID: TweakDBID;
  private const let m_junkItemArray: [JunkItemRecord];
  private let m_brandProcessingSFX: CName;
  private let m_itemFallSFX: CName;

  public const final func GetVendorID() -> TweakDBID {
    return this.m_vendorTweakID;
  }

  public const final func GetJunkItemIDs() -> [JunkItemRecord] {
    return this.m_junkItemArray;
  }

  public const final func GetJunkCount() -> Int32 {
    return ArraySize(this.m_junkItemArray);
  }

  public const final func GetProcessingSFX() -> CName {
    return this.m_brandProcessingSFX;
  }

  public const final func GetItemFallSFX() -> CName {
    return this.m_itemFallSFX;
  }
}

class VendingMachineController extends ScriptableDeviceComponent {
  public const func GetPS() -> VendingMachineControllerPS {
    return this.GetBasePS() as VendingMachineControllerPS;
  }
}

class VendingMachineControllerPS extends ScriptableDeviceComponentPS {
  private persistent let m_vendingMachineSetup: VendingMachineSetup;
  private let m_vendingMachineSFX: VendingMachineSFX;
  protected let m_soldOutProbability: Float;
  protected let m_isReady: Bool;
  protected let m_isSoldOut: Bool;
  protected let m_hackCount: Int32;
  private let m_shopStock: [SItemStack];
  protected let m_shopStockInit: Bool;

  protected func LogicReady() {
    super.LogicReady();
    this.m_shopStockInit = false;
  }

  public func GetTimeToCompletePurchase() -> Float {
    return this.m_vendingMachineSetup.m_timeToCompletePurchase;
  }

  public func GetGlitchStartSFX() -> CName {
    return this.m_vendingMachineSFX.m_glitchingStart;
  }

  public func GetGlitchStopSFX() -> CName {
    return this.m_vendingMachineSFX.m_glitchingStop;
  }

  protected final func GetShopStock() -> [SItemStack] {
    if !this.m_shopStockInit {
      this.m_shopStock = MarketSystem.GetVendorItemsForSale(this.GetOwnerEntityWeak() as GameObject, false);
      this.m_shopStockInit = true;
    }
    return this.m_shopStock;
  }

  public func GetHackedItemCount() -> Int32 {
    return 10;
  }

  public final func IsSoldOut() -> Bool {
    return this.m_isSoldOut;
  }

  protected final func ActionDispenceItemFromVendor(item: ItemID, price: Int32) -> DispenceItemFromVendor {
    let buttonTextureName = TweakDBInterface.GetConsumableItemRecord(ItemID.GetTDBID(item)).AtlasIcon();
    let action = new DispenceItemFromVendor();
    action.clearanceLevel = 1;
    action.SetUp(this);
    action.SetProperties(item, price, buttonTextureName);
    action.AddDeviceName(this.m_deviceName);
    action.CreateActionWidgetPackage();
    action.SetDurationValue(this.GetTimeToCompletePurchase());
    return action;
  }

  public func GetActions(out actions: [DeviceAction], context: GetActionsContext) -> Bool {
    if !super.GetActions(actions, context) {
      this.m_isReady = false;
      return false;
    }
    this.PushShopStockActions(actions, context);
    this.SetActionIllegality(actions, this.m_illegalActions.regularActions);
    return true;
  }

  protected func PushShopStockActions(actions: script_ref<[DeviceAction]>, const context: script_ref<GetActionsContext>) {
    if DispenceItemFromVendor.IsDefaultConditionMet(this, context) && this.m_isReady {
      let shopStock = this.GetShopStock();
      let i = 0;
      while i < ArraySize(shopStock) {
        let price = MarketSystem
          .GetBuyPrice(this.GetOwnerEntityWeak() as GameObject, shopStock[i].itemID);
        ArrayPush(actions, this.ActionDispenceItemFromVendor(shopStock[i].itemID, price));
        i += 1;
      }
    }
  }

  protected const func CanCreateAnyQuickHackActions() -> Bool {
    return true;
  }

  protected func GetQuickHackActions(out outActions: [DeviceAction], const context: script_ref<GetActionsContext>) {
    let currentAction = this
      .ActionGlitchScreen(t"DeviceAction.GlitchScreenSuicide", t"QuickHack.GrenadeHackBase");
    currentAction.SetDurationValue(this.GetDistractionDuration(currentAction));
    ArrayPush(outActions, currentAction);
    currentAction = this
      .ActionGlitchScreen(t"DeviceAction.GlitchScreenBlind", t"QuickHack.BlindHack");
    currentAction.SetDurationValue(this.GetDistractionDuration(currentAction));
    ArrayPush(outActions, currentAction);
    currentAction = this
      .ActionGlitchScreen(t"DeviceAction.GlitchScreenGrenade", t"QuickHack.GrenadeHackBase");
    currentAction.SetDurationValue(this.GetDistractionDuration(currentAction));
    ArrayPush(outActions, currentAction);
    if !GlitchScreen.IsDefaultConditionMet(this, context) {
      ScriptableDeviceComponentPS.SetActionsInactiveAll(outActions, "LocKey#7003");
    }
    currentAction = this.ActionQuickHackDistraction();
    currentAction.SetObjectActionID(t"DeviceAction.MalfunctionClassHack");
    currentAction.SetDurationValue(this.GetDistractionDuration(currentAction));
    if !ScriptableDeviceAction.IsDefaultConditionMet(this, context) || this.m_hackCount < 1 {
      currentAction.SetInactiveWithReason(false, "LocKey#7003");
    }
    ArrayPush(outActions, currentAction);
    if this.IsGlitching() || this.IsDistracting() {
      ScriptableDeviceComponentPS.SetActionsInactiveAll(outActions, "LocKey#7004");
    } else if !this.IsON() {
      ScriptableDeviceComponentPS.SetActionsInactiveAll(outActions, "LocKey#7005");
    }
    this.FinalizeGetQuickHackActions(outActions, context);
  }

  public func GetQuestActions(out outActions: [DeviceAction], const context: script_ref<GetActionsContext>) {
    super.GetQuestActions(outActions, context);
  }

  public func OnDispenceItemFromVendor(evt: DispenceItemFromVendor) -> EntityNotificationType {
    if evt.IsStarted() {
      this.m_isReady = false;
      this.ExecutePSActionWithDelay(evt, this, evt.GetDurationValue());
    } else if RandF() <= this.m_soldOutProbability {
      this.m_isSoldOut = true;
    } else {
      this.m_isReady = true;
    }
    this.UseNotifier(evt);
    return EntityNotificationType.SendThisEventToEntity;
  }

  public func OnQuickHackDistraction(evt: QuickHackDistraction) -> EntityNotificationType {
    if evt.IsStarted() {
      this.m_isReady = false;
      this.m_hackCount -= 1;
      if this.m_hackCount == 0 {
        this.m_isSoldOut = true;
      }
    }
    return super.OnQuickHackDistraction(evt);
  }

  public final func SetIsReady(value: Bool) {
    this.m_isReady = value;
  }

  public const func GetBlackboardDef() -> VendingMachineDeviceBlackboardDef {
    return GetAllBlackboardDefs().VendingMachineDeviceBlackboard;
  }
}

struct VendingMachineSetup {
  public let m_timeToCompletePurchase: Float;
}

struct VendingMachineSFX {
  public let m_glitchingStart: CName;
  public let m_glitchingStop: CName;
}

importonly native class ConsumableItem_Record extends Item_Record {
  public final native func ConsumableType() -> wref<ConsumableType_Record>;

  public final native func ConsumableTypeHandle() -> ConsumableType_Record;

  public final native func ConsumableBaseName() -> wref<ConsumableBaseName_Record>;

  public final native func ConsumableBaseNameHandle() -> ConsumableBaseName_Record;

  public final native func AtlasIcon() -> CName;

  public final native func CycleDuration() -> Float;

  public final native func CastPoint() -> Float;

  public final native func InitBlendDuration() -> Float;

  public final native func RemovePoint() -> Float;
}

class DispenceItemFromVendor extends ActionBool {
  private let m_itemID: ItemID;
  private let m_price: Int32;
  private let m_atlasTexture: CName;

  public final func SetProperties(iteID: ItemID, opt price: Int32, opt texture: CName) {
    this.actionName = n"DispenceItem";
    this.prop = DeviceActionPropertyFunctions
      .SetUpProperty_Bool(n"Dispence Item", true, n"LocKey#17849", n"LocKey#17849");
    this.m_itemID = iteID;
    this.m_price = price;
    this.m_atlasTexture = texture;
  }

  public final static func IsDefaultConditionMet(device: ScriptableDeviceComponentPS, const context: script_ref<GetActionsContext>) -> Bool {
    if DispenceItemFromVendor.IsAvailable(device) {
      return true;
    }
    return false;
  }

  public final static func IsAvailable(device: ScriptableDeviceComponentPS) -> Bool {
    if device.IsON() {
      return true;
    }
    return false;
  }

  public final func CanPay(opt user: GameObject) -> Bool {
    if !IsDefined(user) {
      user = this.GetExecutor();
    } else if !IsDefined(user) {
      return false;
    }
    let transactionSys = GameInstance.GetTransactionSystem(user.GetGame());
    let userMoney = transactionSys.GetItemQuantity(user, MarketSystem.Money());
    let price = this.m_price;
    if price == -1 {
      price = MarketSystem
        .GetBuyPrice(
          user.GetGame(),
          PersistentID.ExtractEntityID(this.GetPersistentID()),
          this.m_itemID
        );
    }
    return userMoney > price;
  }

  public const final func GetItemID() -> ItemID {
    return this.m_itemID;
