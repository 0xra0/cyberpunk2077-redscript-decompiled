  public final native func GetGodModeCount(entID: EntityID, gmType: gameGodModeType) -> Uint32;

  public final native func GetGodModeSources(entID: EntityID, gmType: gameGodModeType) -> [CName];

  public final native func ClearGodMode(entID: EntityID, sourceInfo: CName);

  public final native func EnableOverride(entID: EntityID, gmType: gameGodModeType, sourceInfo: CName) -> Bool;

  public final native func DisableOverride(entID: EntityID, sourceInfo: CName) -> Bool;
}

public native func Cast(a: Int64) -> Bool;

public func OperatorAnd(i: Int64, f: damageSystemLogFlags) -> Int64 {
  return i & EnumInt(f);
}

public native func OperatorAnd(a: Int64, b: Int64) -> Int64;

