class PatrolControllerTask extends AIbehaviortaskScript {
  protected func Activate(context: ScriptExecutionContext) {
    AIbehaviortaskScript
      .SetUpdateInterval(context, AIBehaviorScriptBase.RandomizeOffsetForUpdateInterval(0.2));
  }

  protected func Update(context: ScriptExecutionContext) -> AIbehaviorUpdateOutcome {
    let pathOverride: AIPatrolPathParameters;
    let selectedPath: AIPatrolPathParameters;
    let bbDef = GetAllBlackboardDefs().AIPatrol;
    let bb = AIBehaviorScriptBase
      .GetPuppet(context)
      .GetAIControllerComponent()
      .GetAIPatrolBlackboard();
    let pathVariant = bb.GetVariant(bbDef.selectedPath);
    let pathOverrideVariant = bb.GetVariant(bbDef.patrolPathOverride);
    if IsDefined(pathVariant) {
      selectedPath = FromVariant<AIPatrolPathParameters>(pathVariant);
    } else if IsDefined(pathOverrideVariant) {
      pathOverride = FromVariant<AIPatrolPathParameters>(pathOverrideVariant);
    } else if IsDefined(pathOverride) && selectedPath != pathOverride {
      selectedPath = pathOverride;
      bb.SetVariant(bbDef.selectedPath, ToVariant(selectedPath));
    }
    return AIbehaviorUpdateOutcome.IN_PROGRESS;
  }
}

