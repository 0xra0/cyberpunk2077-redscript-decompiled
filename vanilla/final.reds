class ItemInSlotPrereqState extends PrereqState {
  public let m_listener: ItemInSlotCallback;
  public let m_owner: wref<GameObject>;

  public final func SlotFilled(slotID: TweakDBID, itemID: ItemID) {
    let prereq = this.GetPrereq() as ItemInSlotPrereq;
    if slotID == prereq.m_slotID {
      let checkPassed = prereq.Evaluate(itemID, this.m_owner);
      this.OnChanged(checkPassed);
    }
  }

  public final func SlotEmptied(slotID: TweakDBID, itemID: ItemID) {
    let prereq = this.GetPrereq() as ItemInSlotPrereq;
    if slotID == prereq.m_slotID {
      this.OnChanged(false);
    }
  }
}

class ItemInSlotPrereq extends IScriptablePrereq {
  public let m_slotID: TweakDBID;
  public let m_slotCheckType: gamedataCheckType;
  public let m_itemType: gamedataItemType;
  public let m_itemCategory: gamedataItemCategory;
  public let m_weaponEvolution: gamedataWeaponEvolution;
  public let m_itemTag: CName;
  public let m_invert: Bool;
  public let m_skipOnApply: Bool;
  public let m_waitForVisuals: Bool;

  protected const func OnRegister(state: PrereqState, game: GameInstance, context: IScriptable) -> Bool {
    let owner = context as GameObject;
    let castedState = state as ItemInSlotPrereqState;
    castedState.m_listener = new ItemInSlotCallback();
    castedState.m_listener.m_waitForVisuals = this.m_waitForVisuals;
    castedState.m_listener.slotID = this.m_slotID;
    castedState.m_owner = owner;
    castedState.m_listener.RegisterState(castedState);
    GameInstance
      .GetTransactionSystem(game)
      .RegisterAttachmentSlotListener(owner, castedState.m_listener);
    return false;
  }

  protected const func OnUnregister(state: PrereqState, game: GameInstance, context: IScriptable) {
    let castedState = state as StatPrereqState;
    if IsDefined(castedState) {
      castedState.m_listener = null;
    }
  }

  protected const func OnApplied(state: PrereqState, game: GameInstance, context: IScriptable) {
    let castedState = state as ItemInSlotPrereqState;
    let owner = context as GameObject;
    if this.m_skipOnApply {
      return;
    }
    let itemObj = GameInstance.GetTransactionSystem(owner.GetGame()).GetItemInSlot(owner, this.m_slotID);
    if IsDefined(itemObj) {
      castedState.SlotFilled(this.m_slotID, itemObj.GetItemID());
    }
  }

  public const func IsFulfilled(game: GameInstance, context: IScriptable) -> Bool {
    let owner = context as GameObject;
    if this.m_skipOnApply {
      return false;
    }
    let itemObj = GameInstance.GetTransactionSystem(owner.GetGame()).GetItemInSlot(owner, this.m_slotID);
    if IsDefined(itemObj) {
      return this.Evaluate(itemObj.GetItemID(), owner);
    }
    return false;
  }

  protected func Initialize(recordID: TweakDBID) {
    this.m_slotCheckType = TweakDBInterface
      .GetCheckTypeRecord(TweakDBInterface.GetForeignKeyDefault(recordID + t".checkType"))
      .Type();
    this.m_slotID = TweakDBInterface
      .GetAttachmentSlotRecord(TweakDBInterface.GetForeignKeyDefault(recordID + t".attachmentSlot"))
      .GetID();
    this.m_itemType = TweakDBInterface
      .GetItemTypeRecord(TweakDBInterface.GetForeignKeyDefault(recordID + t".itemType"))
      .Type();
    this.m_itemCategory = TweakDBInterface
      .GetItemCategoryRecord(TweakDBInterface.GetForeignKeyDefault(recordID + t".itemCategory"))
      .Type();
    this.m_weaponEvolution = TweakDBInterface
      .GetWeaponEvolutionRecord(TweakDBInterface.GetForeignKeyDefault(recordID + t".weaponEvolution"))
      .Type();
    this.m_itemTag = TweakDBInterface.GetCName(recordID + t".itemTag", n"None");
    this.m_invert = TweakDBInterface.GetBool(recordID + t".inverted", false);
    this.m_skipOnApply = TweakDBInterface.GetBool(recordID + t".skipOnApply", false);
    this.m_waitForVisuals = TweakDBInterface.GetBool(recordID + t".waitForVisuals", false);
  }

  public const final func Evaluate(itemID: ItemID, owner: wref<GameObject>) -> Bool {
    let result: Bool;
    switch this.m_slotCheckType {
      case gamedataCheckType.None:
        result = false;
        break;
      case gamedataCheckType.Tag:
        result = this.Evaluate(itemID, this.m_itemTag);
        break;
      case gamedataCheckType.Type:
        result = this.Evaluate(RPGManager.GetItemType(itemID));
        break;
      case gamedataCheckType.Category:
        result = this.Evaluate(RPGManager.GetItemCategory(itemID));
        break;
      case gamedataCheckType.Evolution:
        result = this.Evaluate(RPGManager.GetWeaponEvolution(itemID));
        break;
      case gamedataCheckType.FullyModded:
        result = this.CheckGenericWeaponModSlots(itemID, owner);
        break;
      default:
        result = false;
        return this.m_invert ? !result : result;
    }
  }

  public const final func Evaluate(itemCategory: gamedataItemCategory) -> Bool {
    return Equals(itemCategory, this.m_itemCategory);
  }

  public const final func Evaluate(itemType: gamedataItemType) -> Bool {
    return Equals(itemType, this.m_itemType);
  }

  public const final func Evaluate(weaponEvolution: gamedataWeaponEvolution) -> Bool {
    return Equals(weaponEvolution, this.m_weaponEvolution);
  }

  public const final func Evaluate(itemID: ItemID, tag: CName) -> Bool {
    let tags = RPGManager.GetItemRecord(itemID).Tags();
    return ArrayContains(tags, tag);
  }

  public const final func CheckGenericWeaponModSlots(itemID: ItemID, owner: wref<GameObject>) -> Bool {
    let attachmentSlotList: [TweakDBID];
    GameInstance
      .GetTransactionSystem(owner.GetGame())
      .GetEmptySlotsOnItem(owner, itemID, attachmentSlotList);
    let quality = GameInstance
      .GetTransactionSystem(owner.GetGame())
      .GetItemData(owner, itemID)
      .GetStatValueByType(gamedataStatType.Quality);
    let index = 0;
    while index < ArraySize(attachmentSlotList) && index < 4 {
      if this.IsGenericWeaponMod(attachmentSlotList[index], Cast<Int32>(quality)) {
        return false;
      }
      index += 1;
    }
    return true;
  }

  public const final func IsGenericWeaponMod(tweakDBID: TweakDBID, quality: Int32) -> Bool {
    let weaponModSlotIDs: [TweakDBID; 4];
    weaponModSlotIDs[0] = t"AttachmentSlots.Power_AR_SMG_LMG_WeaponMod1";
    weaponModSlotIDs[1] = t"AttachmentSlots.Power_AR_SMG_LMG_WeaponMod2";
    weaponModSlotIDs[2] = t"AttachmentSlots.Tech_AR_SMG_LMG_WeaponMod1";
    weaponModSlotIDs[3] = t"AttachmentSlots.Tech_AR_SMG_LMG_WeaponMod2";
    let index = 0;
    while index < quality {
      if tweakDBID == weaponModSlotIDs[index] {
        return true;
      }
      index = index + 1;
    }
    return false;
  }
}

class ItemInSlotCallback extends AttachmentSlotsScriptCallback {
  protected let m_state: wref<ItemInSlotPrereqState>;
  public let m_waitForVisuals: Bool;

  public func OnItemEquipped(slot: TweakDBID, item: ItemID) {
    if !this.m_waitForVisuals {
      this.m_state.SlotFilled(slot, item);
    }
  }

  public func OnItemEquippedVisual(slot: TweakDBID, item: ItemID) {
    if this.m_waitForVisuals {
      this.m_state.SlotFilled(slot, item);
    }
  }

  public func OnItemUnequipped(slot: TweakDBID, item: ItemID) {
    this.m_state.SlotEmptied(slot, item);
  }

  public final func RegisterState(state: PrereqState) {
    this.m_state = state as ItemInSlotPrereqState;
  }
}

