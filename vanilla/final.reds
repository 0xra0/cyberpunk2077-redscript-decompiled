        return 3;
      case gamedataItemType.Fla_Support:
        return 4;
      case gamedataItemType.Gad_Grenade:
        return 1;
      case gamedataItemType.Gen_CraftingMaterial:
        return 2;
      case gamedataItemType.Gen_DataBank:
        return 3;
