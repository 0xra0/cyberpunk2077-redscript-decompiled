      case 7:
        return gamedataQuality.EpicPlus;
      case 8:
        return gamedataQuality.Legendary;
      case 9:
        return gamedataQuality.LegendaryPlus;
      case 10:
        return gamedataQuality.LegendaryPlusPlus;
    }
    return gamedataQuality.Common;
