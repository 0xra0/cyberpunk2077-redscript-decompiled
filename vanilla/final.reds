class VehicleDeviceLinkPS extends DeviceLinkComponentPS {
  public final static func CreateAndAcquirVehicleDeviceLinkPS(game: GameInstance, entityID: EntityID) -> VehicleDeviceLinkPS {
    let linkPSID = DeviceLinkComponentPS.GenerateID(entityID);
    let link = GameInstance
      .GetPersistencySystem(game)
      .GetConstAccessToPSObject(linkPSID, n"VehicleDeviceLinkPS") as VehicleDeviceLinkPS;
    if IsDefined(link) {
      return link;
    }
    return null;
  }

  public final static func AcquireVehicleDeviceLink(game: GameInstance, entityID: EntityID) -> VehicleDeviceLinkPS {
    let link = VehicleDeviceLinkPS.CreateAndAcquirVehicleDeviceLinkPS(game, entityID);
    if IsDefined(link) && link.IsConnected() {
      return link;
    }
    return null;
  }

  protected func OnDeviceLinkRequest(evt: DeviceLinkRequest) -> EntityNotificationType {
    super.OnDeviceLinkRequest(evt);
    return EntityNotificationType.DoNotNotifyEntity;
  }
}

