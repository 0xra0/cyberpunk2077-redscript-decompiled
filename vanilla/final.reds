native struct Vector3 {
  public native let X: Float;
  public native let Y: Float;
  public native let Z: Float;

  public final static func Lerp(a: Vector3, b: Vector3, t: Float) -> Vector3 {
    let x = a.X + (b.X - a.X) * t;
    let y = a.Y + (b.Y - a.Y) * t;
    let z = a.Z + (b.Z - a.Z) * t;
    return new Vector3(x, y, z);
  }
}

