class AIAlertedStateDelegate extends ScriptBehaviorDelegate {
  public let m_attackInstigatorPosition: Vector4;

  public final func DoSetExplosionInstigatorPositionAsStimSource(context: ScriptExecutionContext) -> Bool {
    if !Vector4.IsZero(this.m_attackInstigatorPosition) {
      ScriptExecutionContext
        .SetArgumentVector(context, n"StimSource", this.m_attackInstigatorPosition);
    } else {
      let stimuliCache = (ScriptExecutionContext.GetOwner(context) as ScriptedPuppet).GetStimReactionComponent().GetStimuliCache();
      if ArraySize(stimuliCache) != 0 {
        let investigateData = stimuliCache[ArraySize(stimuliCache) - 1].cachedEvt.stimInvestigateData;
        if Equals(
          stimuliCache[ArraySize(stimuliCache) - 1].cachedEvt.GetStimType(),
          gamedataStimType.Explosion
        ) && investigateData.revealsInstigatorPosition {
          this.m_attackInstigatorPosition = investigateData.attackInstigatorPosition;
          ScriptExecutionContext
            .SetArgumentVector(context, n"StimSource", investigateData.attackInstigatorPosition);
        }
      }
    }
    return true;
  }

  public final func DoSetRandomAimPointLeft(context: ScriptExecutionContext) -> Bool {
    let aimPoint = this
      .GetPositionAroundInstigator(context, RandRangeF(2.8, 4.6), 0.0, RandRangeF(1.8, 3.6));
    ScriptExecutionContext.SetArgumentVector(context, n"StimSource", aimPoint);
    return true;
  }

  public final func DoSetRandomAimPointRight(context: ScriptExecutionContext) -> Bool {
    let aimPoint = this
      .GetPositionAroundInstigator(context, RandRangeF(-2.8, -4.6), 0.0, RandRangeF(1.8, 3.4));
    ScriptExecutionContext.SetArgumentVector(context, n"StimSource", aimPoint);
    return true;
  }

  public final func DoLowerWeapon(context: ScriptExecutionContext) -> Bool {
    let animFeature = new AnimFeature_AIAction();
    animFeature.state = 3;
    AnimationControllerComponent
      .ApplyFeatureToReplicate(ScriptExecutionContext.GetOwner(context), n"NonCombatAim", animFeature);
    return true;
  }

  private final func GetPositionAroundInstigator(
    context: ScriptExecutionContext,
    xOffset: Float,
    yOffset: Float,
    zOffset: Float
  ) -> Vector4 {
    let ownerPuppet = ScriptExecutionContext.GetOwner(context) as ScriptedPuppet;
    let instigatorSimulatedRotation = Quaternion
      .BuildFromDirectionVector(
        ownerPuppet.GetWorldPosition() - this.m_attackInstigatorPosition,
        ownerPuppet.GetWorldUp()
      );
    let aimOffset = new Vector4(xOffset, yOffset, zOffset, 1.0);
    let worldAimOffset = Vector4
      .RotByAngleXY(
        aimOffset,
        Vector4.Heading(Quaternion.GetForward(instigatorSimulatedRotation))
      );
    let worldPosition = this.m_attackInstigatorPosition + worldAimOffset;
    return worldPosition;
  }
}

class CheckWoundedStatusEffectState extends AIStatusEffectCondition {
  public let m_stateToCheck: EstatusEffectsState;

  protected func Check(context: ScriptExecutionContext) -> AIbehaviorConditionOutcomes {
    switch this.m_stateToCheck {
      case EstatusEffectsState.Deactivated:
        return Cast<AIbehaviorConditionOutcomes>(
          !StatusEffectSystem
            .ObjectHasStatusEffectOfType(
              AIBehaviorScriptBase.GetPuppet(context),
              gamedataStatusEffectType.Wounded
            )
        );
      case EstatusEffectsState.Activating:
        return Cast<AIbehaviorConditionOutcomes>(
          GameInstance.GetSimTime(AIBehaviorScriptBase.GetPuppet(context).GetGame())
            - StatusEffectHelper
              .GetTopPriorityEffect(
                AIBehaviorScriptBase.GetPuppet(context),
                gamedataStatusEffectType.Wounded
              )
              .GetInitialApplicationSimTimestamp()
            < 10.0
        );
    }
    return Cast<AIbehaviorConditionOutcomes>(
      StatusEffectSystem
        .ObjectHasStatusEffectOfType(
          AIBehaviorScriptBase.GetPuppet(context),
          gamedataStatusEffectType.Wounded
        )
    );
  }
}

class AssignRestrictMovementAreaHandler extends AIbehaviortaskScript {
  public let m_inCommand: AIArgumentMapping;
  public let m_resultOnNoChange: AIbehaviorCompletionStatus;

  protected func Update(context: ScriptExecutionContext) -> AIbehaviorUpdateOutcome {
    if !IsDefined(this.m_inCommand) {
      return AIbehaviorUpdateOutcome.FAILURE;
    }
    let rawCommand = ScriptExecutionContext.GetScriptableMappingValue(context, this.m_inCommand);
    let typedCommand = rawCommand as AIAssignRestrictMovementAreaCommand;
    if !IsDefined(typedCommand) {
      return AIbehaviorUpdateOutcome.FAILURE;
    }
    let restrictMovementArea = typedCommand.restrictMovementAreaRef;
    let gam = GameInstance.GetRestrictMovementAreaManager(AIBehaviorScriptBase.GetGame(context));
    if !IsDefined(gam) {
      return AIbehaviorUpdateOutcome.FAILURE;
    } else if !gam
      .AssignRestrictMovementArea(AIBehaviorScriptBase.GetPuppet(context).GetEntityID(), restrictMovementArea) {
      if Equals(this.m_resultOnNoChange, AIbehaviorCompletionStatus.SUCCESS) {
        return AIbehaviorUpdateOutcome.SUCCESS;
      }
      return AIbehaviorUpdateOutcome.FAILURE;
    }
    return AIbehaviorUpdateOutcome.SUCCESS;
  }
}

