    return this.m_chargesState;
  }

  public final func SetTypeOfItem(value: EChargesItem) {
    this.m_typeOfItem = value;
  }

  public final func getTypeOfItem() -> EChargesItem {
    return this.m_typeOfItem;
  }
}

class IgnoreBarbedWirePrereq extends IScriptablePrereq {
  public let m_minStateTime: Float;
  public let m_invert: Bool;

  protected func Initialize(recordID: TweakDBID) {
    this.m_minStateTime = TweakDBInterface.GetFloat(recordID + t".minStateTime", 0.0);
    this.m_invert = TweakDBInterface.GetBool(recordID + t".invert", false);
  }

  protected const func OnApplied(state: PrereqState, game: GameInstance, context: IScriptable) {
    state.OnChanged(this.IsFulfilled(game, context));
  }

  public const func IsFulfilled(game: GameInstance, context: IScriptable) -> Bool {
    let checkPassed = false;
    let bb = GameInstance
      .GetBlackboardSystem(game)
      .GetLocalInstanced(
        (context as ScriptedPuppet).GetEntityID(),
        GetAllBlackboardDefs().PlayerStateMachine
      );
    if !IsDefined(bb) {
      return false;
    }
    let stateEnterTime = bb
      .GetFloat(GetAllBlackboardDefs().PlayerStateMachine.IgnoreBarbedWireStateEnterTime);
    checkPassed = stateEnterTime
      > 0.0
      && EngineTime.ToFloat(GameInstance.GetSimTime(game)) - stateEnterTime > this.m_minStateTime;
    return NotEquals(checkPassed, this.m_invert);
  }
}

