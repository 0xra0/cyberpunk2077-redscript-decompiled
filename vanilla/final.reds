abstract class HUDModule extends IScriptable {
  protected let m_hud: wref<HUDManager>;
  protected let m_state: ModuleState;
  protected let m_instancesList: [ModuleInstance];

  public const final func GetState() -> ModuleState {
    return this.m_state;
  }

  public const func IsModuleOperational() -> Bool {
    return Equals(this.m_state, ModuleState.ON) || Equals(this.m_state, ModuleState.MALFUNCTIONING);
  }

  public final func InitializeModule(hud: wref<HUDManager>, state: ModuleState) {
    if !IsDefined(hud) {
      return;
    }
    this.m_hud = hud;
    this.m_state = state;
  }

  public func UnregisterActor(actor: HUDActor) {
    if !IsDefined(actor) {
      return;
    }
    let i = 0;
    while i < ArraySize(this.m_instancesList) {
      if this.m_instancesList[i].GetEntityID() == actor.GetEntityID() {
        ArrayErase(this.m_instancesList, i);
        return;
      }
      i += 1;
    }
  }

  protected final func OverrideInstance(index: Int32, instance: ModuleInstance) {
    if this.IsIndexOK(index) {
      this.m_instancesList[index] = instance;
    }
  }

  protected func DuplicateLastInstance(actor: HUDActor) -> ModuleInstance {
    let i: Int32;
    let instanceDuplicate: ModuleInstance;
    return null;
  }

  protected final func IsIndexOK(index: Int32) -> Bool {
    if index < 0 || index > ArraySize(this.m_instancesList) - 1 {
      return false;
    }
    return true;
  }

  public final func Iterate(out jobs: [HUDJob], opt forcedMode: ActiveMode) {
    if this.IsModuleOperational() {
      if Equals(forcedMode, ActiveMode.UNINITIALIZED) {
        forcedMode = this.GetActiveMode();
      }
      this.Process(jobs, forcedMode);
    }
  }

  public final func Iterate(out job: HUDJob, opt forcedMode: ActiveMode) {
    if this.IsModuleOperational() {
      if Equals(forcedMode, ActiveMode.UNINITIALIZED) {
        forcedMode = this.GetActiveMode();
      }
      this.Process(job, forcedMode);
    }
  }

  public func Suppress(jobs: script_ref<[HUDJob]>);

  protected func Process(out jobs: [HUDJob], mode: ActiveMode);

  protected func Process(out task: HUDJob, mode: ActiveMode);

  protected const final func GetPlayer() -> GameObject {
    return this.m_hud.GetPlayer();
  }

  protected func GetActiveMode() -> ActiveMode {
    return this.m_hud.GetActiveMode();
  }

  protected const final func IsActorLookedAt(actor: HUDActor) -> Bool {
    return this.m_hud.GetCurrentTarget() == actor;
  }

  protected const final func IsActorQuickHackTarget(actor: HUDActor) -> Bool {
    return this.m_hud.GetQuickHackTargetID() == actor.GetEntityID();
  }

  protected const final func HasCurrentTarget() -> Bool {
    return this.m_hud.HasCurrentTarget();
  }

  protected const final func IsActorLooted(actor: HUDActor) -> Bool {
    return this.m_hud.GetLootedTargetID() == actor.GetEntityID();
  }
}

class QuickhackModule extends HUDModule {
  private let m_calculateClose: Bool;

  public final func SetCalculateClose(value: Bool) {
    this.m_calculateClose = value;
  }

  public const func IsModuleOperational() -> Bool {
    if this.m_hud.IsBraindanceActive() {
      return false;
    } else if this.m_hud.IsQuickHackPanelOpened() && NotEquals(this.m_hud.GetActiveMode(), ActiveMode.FOCUS) {
      return true;
    } else if Equals(this.m_hud.GetActiveMode(), ActiveMode.FOCUS) {
      return true;
    }
    return false;
  }

  protected func Process(out task: HUDJob, mode: ActiveMode) {
    if !IsDefined(task.actor) {
      return;
    } else if IsDefined(this.m_hud.GetCurrentTarget())
      && (Equals(this.m_hud.GetCurrentTarget().GetType(), HUDActorType.VEHICLE)
        || Equals(this.m_hud.GetCurrentTarget().GetType(), HUDActorType.DEVICE)
        || Equals(this.m_hud.GetCurrentTarget().GetType(), HUDActorType.BODY_DISPOSAL_DEVICE)
        || Equals(this.m_hud.GetCurrentTarget().GetType(), HUDActorType.PUPPET)) {
      if task.actor == this.m_hud.GetCurrentTarget() {
        if this.m_hud.GetCurrentTarget().GetShouldRefreshQHack() {
          this.m_calculateClose = true;
          this.m_hud.GetCurrentTarget().SetShouldRefreshQHack(false);
          let instruction = task.instruction.quickhackInstruction;
          if IsDefined(instruction) && IsDefined(task.actor) {
            instruction.SetState(InstanceState.ON, this.DuplicateLastInstance(task.actor));
            instruction.SetContext(this.BaseOpenCheck());
          }
        }
      }
    } else if this.m_calculateClose {
      this.m_calculateClose = false;
      this.m_hud.GetLastTarget().SetShouldRefreshQHack(true);
      QuickhackModule
        .SendRevealQuickhackMenu(this.m_hud, this.m_hud.GetPlayer().GetEntityID(), false);
    }
  }

  protected func Process(out jobs: [HUDJob], mode: ActiveMode) {
    let i = 0;
    while i < ArraySize(jobs) {
      this.Process(jobs[i], mode);
      i += 1;
    }
  }

  public func Suppress(jobs: script_ref<[HUDJob]>) {
    let i = 0;
    while i < ArraySize(jobs) {
      let instruction = jobs[i].instruction.quickhackInstruction;
      instruction
        .SetState(InstanceState.DISABLED, this.DuplicateLastInstance(jobs[i].actor));
      i += 1;
    }
  }

  protected func DuplicateLastInstance(actor: HUDActor) -> QuickhackInstance {
    return super.DuplicateLastInstance(actor) as QuickhackInstance;
  }

  protected final func BaseOpenCheck() -> Bool {
    if NotEquals(this.GetActiveMode(), ActiveMode.FOCUS) {
      return false;
    } else if QuickhackModule.IsQuickhackBlockedByScene(this.m_hud.GetPlayer()) {
      return false;
    } else if !this.m_hud.IsCyberdeckEquipped() {
      return false;
    }
    return true;
  }

  public final static func IsQuickhackBlockedByScene(player: GameObject) -> Bool {
    let tier = (player as PlayerPuppet)
      .GetPlayerStateMachineBlackboard()
      .GetInt(GetAllBlackboardDefs().PlayerStateMachine.HighLevel);
    if StatusEffectSystem.ObjectHasStatusEffectWithTag(player, n"NoQuickHacks") || tier >= 3 && tier <= 5 {
      return true;
    }
    return false;
  }

  public final static func RequestRefreshQuickhackMenu(context: GameInstance, requester: EntityID) {
    let self = GameInstance.GetScriptableSystemsContainer(context).Get(n"HUDManager") as HUDManager;
    if IsDefined(self) {
      if self.IsQuickHackPanelOpened() && self.GetCurrentTargetID() == requester {
        QuickhackModule.SendRevealQuickhackMenu(self, requester, true);
      }
    }
  }

  public final static func RequestCloseQuickhackMenu(context: GameInstance, requester: EntityID) {
    let self = GameInstance.GetScriptableSystemsContainer(context).Get(n"HUDManager") as HUDManager;
    if IsDefined(self) {
      QuickhackModule.SendRevealQuickhackMenu(self, requester, false);
    }
  }

  private final static func SendRevealQuickhackMenu(hudManager: HUDManager, requester: EntityID, shouldOpen: Bool) {
    let request = new RevealQuickhackMenu();
    request.shouldOpenWheel = shouldOpen;
    request.ownerID = requester;
    hudManager.QueueRequest(request);
  }

  public final static func TranslateEmptyQuickSlotCommands(context: GameInstance) -> [QuickhackData] {
    let commands: [QuickhackData];
    let newCommand = new QuickhackData();
    newCommand.m_title = "LocKey#42170";
    newCommand.m_isLocked = true;
    newCommand.m_description = "LocKey#34276";
    newCommand.m_inactiveReason = "LocKey#27694";
    newCommand.m_actionState = EActionInactivityReson.Invalid;
    newCommand.m_noQuickhackData = true;
    ArrayPush(commands, newCommand);
    return commands;
  }

  private final func SendFakeCommands(const commands: script_ref<[QuickhackData]>, shouldReveal: Bool) {
    let playerRef = this.GetPlayer() as PlayerPuppet;
    let quickSlotsManagerNotification = new RevealInteractionWheel();
    quickSlotsManagerNotification.lookAtObject = null;
    quickSlotsManagerNotification.shouldReveal = shouldReveal;
    quickSlotsManagerNotification.commands = commands;
    this
      .m_hud
      .QueueEntityEvent(playerRef.GetEntityID(), quickSlotsManagerNotification);
  }

  public final static func CheckCommandDuplicates(commands: script_ref<[QuickhackData]>, opt characterRecord: wref<Character_Record>) {
    let removeIndexes: [Int32];
    let i = ArraySize(commands) - 1;
    if i >= 0 {
      let remove = false;
      let i1 = 0;
      if i1 < ArraySize(commands) {
        if i <= i1 {
        } else if Equals(commands[i].m_title, commands[i1].m_title) {
          remove = true;
        } else {
          i1 += 1;
        }
      } else if remove {
        if IsDefined(characterRecord) {
          if IsDefined(commands[i].m_action) {
            if characterRecord.ObjectActionsContains(commands[i].m_action.GetObjectActionRecord()) {
              ArrayPush(removeIndexes, i1);
            } else if IsDefined(commands[i1].m_action) {
              let actionRectord = commands[i1].m_action.GetObjectActionRecord();
              if characterRecord.ObjectActionsContains(actionRectord) {
                ArrayPush(removeIndexes, i);
              }
            }
          }
          ArrayPush(removeIndexes, i);
        } else if ArrayContains(removeIndexes, i) {
          ArrayPush(removeIndexes, i1);
        } else if ArrayContains(removeIndexes, i1) {
          ArrayPush(removeIndexes, i);
        } else if commands[i].m_actionMatchesTarget {
          ArrayPush(removeIndexes, i1);
        }
        ArrayPush(removeIndexes, i);
      }
      i -= 1;
    }
    i = 0;
  }

  public final static func SortCommandPriority(commands: script_ref<[QuickhackData]>, context: GameInstance) {
    let sortedArray: [QuickhackData];
    let activeIndex = -1;
    let i = ArraySize(commands) - 1;
    while i >= 0 {
      if !commands[i].m_isLocked || commands[i].m_actionMatchesTarget {
        let actionTDB = commands[i].m_action.GetObjectActionID();
        if actionTDB
          == t"QuickHack.RemoteBreach"
          || actionTDB == t"DeviceAction.RemoteBreach"
          || actionTDB == t"QuickHack.ICEBreakerHack" {
          ArrayInsert(sortedArray, 0, commands[i]);
        } else {
          ArrayPush(sortedArray, commands[i]);
        }
        ArrayErase(commands, i);
        activeIndex += 1;
      }
      i -= 1;
    }
    if !NetworkSystem.ShouldShowOnlyTargetQuickHacks(context) {
      i = 0;
      while i < ArraySize(commands) {
        if commands[i].m_isLocked {
          ArrayPush(sortedArray, commands[i]);
        }
        i += 1;
      }
    } else if ArraySize(sortedArray) == 0 {
      sortedArray = QuickhackModule.TranslateEmptyQuickSlotCommands(context);
      i = 0;
      if i < ArraySize(sortedArray) {
        sortedArray[i].m_inactiveReason = "LocKey#34276";
        sortedArray[i].m_title = "LocKey#42171";
        i += 1;
      }
    }
    commands = sortedArray;
  }
}

