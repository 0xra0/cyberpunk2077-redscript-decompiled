  public final func TryRegisterToPrevention() {
    if !this.IsPrevention() {
      return;
    }
    let preventionSystem = GameInstance.GetScriptableSystemsContainer(this.GetGame()).Get(n"PreventionSystem") as PreventionSystem;
    if preventionSystem.IsRegistered(this.GetEntityID()) {
      return;
    }
    let registrationRequest = new RegisterNPCRequest();
    registrationRequest.puppet = this;
    preventionSystem.QueueRequest(registrationRequest);
  }

