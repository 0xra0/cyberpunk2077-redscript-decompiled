class MovableDevice extends InteractiveDevice {
  public let m_workspotSideName: CName;
  protected const let m_sideTriggerNames: [CName];
  protected let m_triggerComponents: [TriggerComponent];
  protected const let m_offMeshConnectionsToOpenNames: [CName];
  protected let m_offMeshConnectionsToOpen: [OffMeshConnectionComponent];
  protected let m_additionalMeshComponent: MeshComponent;
  protected let m_UseWorkspotComponentPosition: Bool;
  protected let m_shouldMoveRight: Bool;

  protected cb func OnRequestComponents(ri: EntityRequestComponentsInterface) -> Bool {
    super.OnRequestComponents(ri);
    EntityRequestComponentsInterface.RequestComponent(ri, n"additionalMesh", n"MeshComponent", false);
    let i = 0;
    while i < ArraySize(this.m_sideTriggerNames) {
      EntityRequestComponentsInterface
        .RequestComponent(ri, this.m_sideTriggerNames[i], n"TriggerComponent", true);
      i += 1;
    }
    i = 0;
    while i < ArraySize(this.m_offMeshConnectionsToOpenNames) {
      EntityRequestComponentsInterface
        .RequestComponent(
          ri,
          this.m_offMeshConnectionsToOpenNames[i],
          n"OffMeshConnectionComponent",
          true
        );
      i += 1;
    }
  }

  protected cb func OnTakeControl(ri: EntityResolveComponentsInterface) -> Bool {
    super.OnTakeControl(ri);
    this.m_additionalMeshComponent = EntityResolveComponentsInterface.GetComponent(ri, n"additionalMesh") as MeshComponent;
    let i = 0;
    while i < ArraySize(this.m_sideTriggerNames) {
      ArrayPush(
        this.m_triggerComponents,
        EntityResolveComponentsInterface.GetComponent(ri, this.m_sideTriggerNames[i]) as TriggerComponent
      );
      i += 1;
    }
    i = 0;
    while i < ArraySize(this.m_offMeshConnectionsToOpenNames) {
      ArrayPush(
        this.m_offMeshConnectionsToOpen,
        EntityResolveComponentsInterface.GetComponent(ri, this.m_offMeshConnectionsToOpenNames[i]) as OffMeshConnectionComponent
      );
      i += 1;
    }
    this.m_controller = EntityResolveComponentsInterface.GetComponent(ri, n"controller") as MovableDeviceController;
  }

  protected func ResolveGameplayState() {
    super.ResolveGameplayState();
    this.UpdateOffMeshLinks();
  }

  protected cb func OnGameAttached() -> Bool {
    super.OnGameAttached();
    this.UpdateAnimState();
  }

  protected func EnterWorkspot(
    activator: GameObject,
    opt freeCamera: Bool,
    opt componentName: CName,
    opt syncSlotName: CName
  ) {
    let sideSuffix: CName;
    let workspotSlidingBehaviour: WorkspotSlidingBehaviour;
    let workspotSystem = GameInstance.GetWorkspotSystem(activator.GetGame());
    if this.m_shouldMoveRight {
      sideSuffix = this.m_workspotSideName + n"Right";
    } else {
      sideSuffix = this.m_workspotSideName + n"Left";
    }
    if this.m_UseWorkspotComponentPosition {
      workspotSlidingBehaviour = WorkspotSlidingBehaviour.PlayAtResourcePosition;
    } else {
      workspotSlidingBehaviour = WorkspotSlidingBehaviour.DontPlayAtResourcePosition;
    }
    workspotSystem
      .PlayInDevice(
        this,
        activator,
        n"lockedCamera",
        componentName + sideSuffix,
        n"deviceWorkspot" + sideSuffix,
        n"movableSync",
        0.5,
        workspotSlidingBehaviour
      );
  }

  protected cb func OnActionDemolition(evt: ActionDemolition) -> Bool {
    if !evt.IsCompleted() {
      return false;
    }
    this.HandleMoveDevice();
  }

  protected cb func OnActionMoveObstacle(evt: MoveObstacle) -> Bool {
    this.HandleMoveDevice();
  }

  protected final func HandleMoveDevice() {
    let player = GameInstance.GetPlayerSystem(this.GetGame()).GetLocalPlayerControlledGameObject();
    this.PlayTransformAnim();
    this.CheckCurrentSide();
    this.EnterWorkspot(player, false, n"playerWorkspot");
    let playerStateMachineBlackboard = GameInstance
      .GetBlackboardSystem(this.GetGame())
      .GetLocalInstanced(player.GetEntityID(), GetAllBlackboardDefs().PlayerStateMachine);
    playerStateMachineBlackboard
      .SetBool(GetAllBlackboardDefs().PlayerStateMachine.IsInteractingWithDevice, true);
    this.UpdateAnimState();
    this.UpdateOffMeshLinks();
  }

  protected final func PlayTransformAnim() {
    let playEvent = new gameTransformAnimationPlayEvent();
    playEvent.animationName = n"start";
    playEvent.looping = false;
    playEvent.timesPlayed = 1u;
    playEvent.timeScale = 1.0;
    this.QueueEvent(playEvent);
  }

  private final func UpdateAnimState() {
    let animFeature = new AnimFeature_SimpleDevice();
    if (this.GetDevicePS() as MovableDeviceControllerPS).WasDeviceMoved() {
      animFeature.isOpen = true;
      if this.m_shouldMoveRight {
        animFeature.isOpenRight = true;
      } else {
        animFeature.isOpenLeft = true;
      }
      AnimationControllerComponent.ApplyFeature(this, n"MovableDevice", animFeature);
      this.SetGameplayRoleToNone();
    }
  }

  public const func DeterminGameplayRole() -> EGameplayRole {
    return EGameplayRole.Push;
  }

  protected final func UpdateOffMeshLinks() {
    let i: Int32;
    if (this.GetDevicePS() as MovableDeviceControllerPS).WasDeviceMoved() {
      i = 0;
      while i < ArraySize(this.m_offMeshConnectionsToOpen) {
        this.m_offMeshConnectionsToOpen[i].EnableOffMeshConnection();
        this.m_offMeshConnectionsToOpen[i].EnableForPlayer();
        i += 1;
      }
    } else {
      i = 0;
      if i < ArraySize(this.m_offMeshConnectionsToOpen) {
        this.m_offMeshConnectionsToOpen[i].DisableOffMeshConnection();
        this.m_offMeshConnectionsToOpen[i].DisableForPlayer();
        i += 1;
      }
    }
  }

  protected final func CheckCurrentSide() {
    let i = 0;
    while i < ArraySize(this.m_triggerComponents) {
      let overlappingEntities = this.m_triggerComponents[i].GetOverlappingEntities();
      let j = 0;
      while j < ArraySize(overlappingEntities) {
        if (overlappingEntities[j] as GameObject).IsPlayer() {
          let finalName = "Side" + ToString((i + 1));
          this.m_workspotSideName = StringToName(finalName);
        }
        j += 1;
      }
      i += 1;
    }
    if Equals(this.m_workspotSideName, n"None") {
      this.m_workspotSideName = n"Side1";
    }
  }
}

