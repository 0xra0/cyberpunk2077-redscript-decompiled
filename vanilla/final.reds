class NPCTypePrereq extends IScriptablePrereq {
  public let m_allowedTypes: [gamedataNPCType];
  public let m_invert: Bool;

  protected func Initialize(recordID: TweakDBID) {
    let prereqRecord = TweakDBInterface.GetNPCTypePrereqRecord(recordID);
    let i = 0;
    while i < prereqRecord.GetAllowedTypesCount() {
      let allowedTypeItem = prereqRecord.GetAllowedTypesItem(i);
      ArrayPush(this.m_allowedTypes, allowedTypeItem.Type());
      i += 1;
    }
    this.m_invert = prereqRecord.Invert();
  }

  protected const func OnApplied(state: PrereqState, game: GameInstance, context: IScriptable) {
    state.OnChanged(this.IsFulfilled(game, context));
  }

  public const func IsFulfilled(game: GameInstance, context: IScriptable) -> Bool {
    let owner = context as GameObject;
    let targetPuppet = owner as ScriptedPuppet;
    let targetType = targetPuppet.GetNPCType();
    if !ArrayContains(this.m_allowedTypes, targetType) {
      return this.m_invert ? true : false;
    }
    return this.m_invert ? false : true;
  }
}

importonly native class NPCTypePrereq_Record extends IPrereq_Record {
  public final native func AllowedTypes(out outList: [wref<NPCType_Record>]);

