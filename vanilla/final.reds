class BaseCrosshairStateEvents extends BaseCrosshairState {
  protected func OnEnter(stateContext: StateContext, scriptInterface: StateGameScriptInterface) {
    this
      .SetBlackboardIntVariable(
        scriptInterface,
        GetAllBlackboardDefs().PlayerStateMachine.Crosshair,
        EnumInt(this.GetCrosshairStateEnumValue())
      );
  }
}

class SafeCrosshairStateDecisions extends BaseCrosshairState {
  protected const func EnterCondition(const stateContext: StateContext, const scriptInterface: StateGameScriptInterface) -> Bool {
    if this.IsInSafeZone(scriptInterface) {
      return true;
    } else if this.IsInSafeSceneTier(scriptInterface) {
      return true;
    } else if (scriptInterface.executionOwner as PlayerPuppet).IsAimingAtFriendly() && stateContext.IsStateActive(n"UpperBody", n"singleWield") {
      return true;
    } else if this.GetHudManager(scriptInterface).IsQuickHackPanelOpened() {
      return true;
    }
    return false;
  }

  protected const func ExitCondition(const stateContext: StateContext, const scriptInterface: StateGameScriptInterface) -> Bool {
    if !this.EnterCondition(stateContext, scriptInterface) {
      return true;
    }
    return false;
  }
}

