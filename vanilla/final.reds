class PlayerIsNewPerkBoughtPrereq extends IScriptablePrereq {
  public let m_invert: Bool;
  public let m_perkType: gamedataNewPerkType;
  public let m_level: Int32;

  protected const func OnRegister(state: PrereqState, game: GameInstance, context: IScriptable) -> Bool {
    let castedState = state as PlayerIsNewPerkBoughtPrereqState;
    castedState.m_owner = context as GameObject;
    let player = context as PlayerPuppet;
    if IsDefined(player) {
      let bb = GameInstance.GetBlackboardSystem(game).Get(GetAllBlackboardDefs().UI_PlayerStats);
      castedState.m_listenerPerksVariant = bb
        .RegisterListenerVariant(
          GetAllBlackboardDefs().UI_PlayerStats.Perks,
          castedState,
          n"OnPerkStateUpdate"
        );
    }
    return false;
  }

  protected const func OnUnregister(state: PrereqState, game: GameInstance, context: IScriptable) {
    let player = context as PlayerPuppet;
    if IsDefined(player) {
      let castedState = state as PlayerIsNewPerkBoughtPrereqState;
      if IsDefined(castedState.m_listenerPerksVariant) {
        let bb = GameInstance.GetBlackboardSystem(game).Get(GetAllBlackboardDefs().UI_PlayerStats);
        bb
          .UnregisterListenerVariant(
            GetAllBlackboardDefs().UI_PlayerStats.Perks,
            castedState.m_listenerPerksVariant
          );
      }
    }
  }

  protected func Initialize(recordID: TweakDBID) {
    let str = TweakDBInterface.GetString(recordID + t".perkType", "");
    this.m_perkType = IntEnum<gamedataNewPerkType>(Cast<Int32>(EnumValueFromString("gamedataNewPerkType", str)));
    this.m_invert = TDB.GetBool(recordID + t".invert");
    this.m_level = TweakDBInterface.GetInt(recordID + t".level", 0);
  }

  protected const func OnApplied(state: PrereqState, game: GameInstance, context: IScriptable) {
    let castedState = state as PlayerIsNewPerkBoughtPrereqState;
    castedState.OnChanged(this.IsFulfilled(game, context));
  }

  public const func IsFulfilled(game: GameInstance, context: IScriptable) -> Bool {
    let player = GameInstance.GetPlayerSystem(game).GetLocalPlayerControlledGameObject();
    let result = PlayerDevelopmentSystem.GetData(player).IsNewPerkBought(this.m_perkType) >= this.m_level;
    if this.m_invert {
      return !result;
    }
    return result;
  }
}

class GameplayTagsPrereq extends IScriptablePrereq {
  public let m_allowedTags: [CName];
  public let m_invert: Bool;

  protected func Initialize(recordID: TweakDBID) {
    let prereqRecord = TweakDBInterface.GetGameplayTagsPrereqRecord(recordID);
    this.m_allowedTags = prereqRecord.AllowedTags();
    this.m_invert = prereqRecord.Invert();
  }

  protected const func OnApplied(state: PrereqState, game: GameInstance, context: IScriptable) {
    state.OnChanged(this.IsFulfilled(game, context));
  }

  public const func IsFulfilled(game: GameInstance, context: IScriptable) -> Bool {
    let owner = context as ScriptedPuppet;
    if !IsDefined(owner) {
      return this.m_invert ? true : false;
    } else if !NPCManager.HasAllTags(owner.GetRecordID(), this.m_allowedTags) {
      return this.m_invert ? true : false;
    }
    return this.m_invert ? false : true;
  }
}

