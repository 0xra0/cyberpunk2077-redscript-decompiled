  public func OnSetExposeQuickHacks(evt: SetExposeQuickHacks) -> EntityNotificationType {
    if this.IsQuickHacksExposed() {
      return EntityNotificationType.DoNotNotifyEntity;
    }
    this.ExposeQuickHacks(true);
    this.UseNotifier(evt);
    let backdoors = this.GetBackdoorDevices();
    let i = 0;
    while i < ArraySize(backdoors) {
      if !backdoors[i].IsBreached() {
        let validate = new Validate();
        this.QueuePSEvent(backdoors[i].GetBackdoorAccessPoint(), validate);
      }
      i += 1;
    }
    return EntityNotificationType.SendThisEventToEntity;
  }

  protected cb func OnRevokeQuickHackAccess(evt: RevokeQuickHackAccess) -> Bool {
    this.ExposeQuickHacks(false);
  }

  protected func ActionQuickHackToggleON() -> QuickHackToggleON {
    let action = new QuickHackToggleON();
    action.Repeat = true;
    action.clearanceLevel = 19;
    action.SetUp(this);
    action.SetProperties(this.m_deviceState);
    action.AddDeviceName(this.m_deviceName);
    action.SetObjectActionID(t"DeviceAction.ToggleStateClassHack");
    action.CreateInteraction();
    return action;
  }

  public func OnQuickHackToggleOn(evt: QuickHackToggleON) -> EntityNotificationType {
    this.SetBlockSecurityWakeUp(FromVariant<Bool>(evt.prop.first));
    evt.SetDurationValue(evt.GetDurationTime());
    let action = this.ActionToggleON();
    this.ExecutePSAction(action, n"remote");
    this.UseNotifier(evt);
    if !this.IsON() && evt.Repeat {
      evt.Repeat = false;
    } else if this.IsON() && evt.IsStarted() && evt.Repeat {
      this.m_isTimedTurnOff = true;
    }
    this.m_isTimedTurnOff = false;
    return EntityNotificationType.SendThisEventToEntity;
  }

  protected func ActionGlitchScreen(actionID: TweakDBID, programID: TweakDBID, opt timeout: Float) -> GlitchScreen {
    let action = new GlitchScreen();
    action.clearanceLevel = 2;
    action.SetUp(this);
    action.SetProperties(this.m_isGlitching, actionID, programID);
    action.AddDeviceName(this.m_deviceName);
    action.CreateInteraction();
    action.SetDurationValue(timeout);
    return action;
  }

  public final func OnGlitchScreen(evt: GlitchScreen) -> EntityNotificationType {
    if !this.IsON() {
      return this.SendActionFailedEvent(evt, evt.GetRequesterID(), "Disabled or Unpowered");
    } else if evt.IsStarted() {
      this.m_isGlitching = true;
      evt.SetCanTriggerStim(true);
      this.ExecutePSActionWithDelay(evt, this, evt.GetDurationValue());
    }
    this.m_isGlitching = false;
    evt.SetCanTriggerStim(false);
    this.UseNotifier(evt);
    if !IsFinal() {
    }
    return EntityNotificationType.SendThisEventToEntity;
  }

