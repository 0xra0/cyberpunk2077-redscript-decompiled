  private final func FindBestMatchingVertice(
    point: Vector4,
    direction: Vector4,
    angle: Float,
    radius: Float,
    excludeVertice: Vector4,
    const vertices: script_ref<[Vector4]>
  ) -> Vector4 {
    let foundVertice: Vector4;
    let bestAngle = angle;
    let i = 0;
    while i < ArraySize(vertices) {
      if Equals(vertices[i], excludeVertice) {
      } else {
        let distance = Vector4.Distance(point, vertices[i]);
        if distance > radius {
        } else {
          let foundVerticeDirection = Vector4.Normalize(vertices[i] - point);
          let currentAngle = Vector4.GetAngleBetween(direction, foundVerticeDirection);
          if currentAngle > angle {
          } else if currentAngle < bestAngle {
            bestAngle = currentAngle;
            foundVertice = vertices[i];
          }
        }
      }
      i += 1;
    }
    return foundVertice;
  }

  private final func GetRandomPoint(direction: Vector4, radius: Float, angle: Float) -> Vector4 {
    let orientation: EulerAngles;
    let quat: Quaternion;
    let minAngle = Deg2Rad(20.0);
    let point = direction;
    if angle > 0.0 {
      let halfAngle = angle * 0.5;
      orientation.Pitch = RandRangeF(-halfAngle, halfAngle);
      orientation.Yaw = RandRangeF(-halfAngle, halfAngle);
      orientation.Pitch = SgnF(orientation.Pitch) * minAngle + orientation.Pitch;
      orientation.Yaw = SgnF(orientation.Yaw) * minAngle + orientation.Yaw;
      Quaternion.SetYRot(quat, orientation.Pitch);
      point = quat * point;
      Quaternion.SetZRot(quat, orientation.Yaw);
      point = quat * point;
      point = Vector4.Normalize(point);
    }
    point = point * radius;
    return point;
  }

  private final func GetRandomPointOnSphere(sphereCentre: Vector4, radius: Float, slice: Int32) -> Vector4 {
    let point: Vector4;
    let angleIncrementPhi = 0.62831855;
    let angleIncrementTheta = 0.15707964;
    let minAngleTheta = Cast<Float>(slice) * angleIncrementTheta;
    let maxAngleTheta = Cast<Float>(slice + 1) * angleIncrementTheta;
    let minAnglePhi = Cast<Float>(slice) * angleIncrementPhi;
    let maxAnglePhi = Cast<Float>(slice + 1) * angleIncrementPhi;
    let theta = RandRangeF(minAngleTheta, maxAngleTheta);
    let phi = RandRangeF(minAnglePhi, maxAnglePhi);
    point.X = sphereCentre.X + radius * SinF(phi) * CosF(theta);
    point.Y = sphereCentre.Y + radius * SinF(phi) * SinF(theta);
    point.Z = sphereCentre.Z + radius * CosF(theta);
    return point;
  }

  private final func GetRandomPointOnSphere(sphereCentre: Vector4, radius: Float) -> Vector4 {
    let point: Vector4;
    let u = RandF();
    let v = RandF();
    let theta = 6.2831855 * u;
    let phi = AcosF(2.0 * v - 1.0);
    point.X = sphereCentre.X + radius * SinF(phi) * CosF(theta);
    point.Y = sphereCentre.Y + radius * SinF(phi) * SinF(theta);
    point.Z = sphereCentre.Z + radius * CosF(phi);
    return point;
  }

  private final func GetRandomPointOnSphereQuadrant0() -> Vector4 {
    let point: Vector4;
    let u = RandF();
    let v = RandF();
    let theta = 3.1415927 * u * 0.5;
    let cosPhi = SqrtF(1.0 - v);
    let sinPhi = SqrtF(1.0 - cosPhi * cosPhi);
    point.X = sinPhi * CosF(theta);
    point.Y = sinPhi * SinF(theta);
    point.Z = cosPhi;
    return point;
  }

  private final func GetRandomPointOnSphereInFacingQuadrant(sphereCenter: Vector4, radius: Float, facePoint: Vector4) -> Vector4 {
    let point = this.GetRandomPointOnSphereQuadrant0();
    if facePoint.X < sphereCenter.X {
      point.X = -point.X;
    } else if facePoint.Y < sphereCenter.Y {
      point.Y = -point.Y;
    } else if facePoint.Z < sphereCenter.Z {
      point.Z = -point.Z;
    }
    point.X = sphereCenter.X + point.X * radius;
    point.Y = sphereCenter.Y + point.Y * radius;
    point.Z = sphereCenter.Z + point.Z * radius;
    return point;
  }

