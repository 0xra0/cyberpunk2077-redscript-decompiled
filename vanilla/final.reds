    this.actionName = n"HackVolume";
    this.prop = DeviceActionPropertyFunctions
      .SetUpProperty_Bool(this.actionName, true, this.actionName, this.actionName);
  }

  public final static func IsDefaultConditionMet(device: ScriptableDeviceComponentPS) -> Bool {
    if PlayDeafeningMusic.IsAvailable(device) {
      return true;
    }
    return false;
