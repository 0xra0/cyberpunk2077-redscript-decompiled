native class AICommandNodeFunctionProvider extends IScriptable {
  private final static func Add(
    functions: script_ref<[AICommandNodeFunction]>,
    nodeType: CName,
    category: CName,
    const friendlyName: script_ref<String>,
    paramsType: CName,
    color: Color
  ) {
    let fn: AICommandNodeFunction;
    fn.order = Cast<Uint32>(ArraySize(functions));
    fn.nodeType = nodeType;
    fn.commandCategory = category;
    fn.friendlyName = friendlyName;
    fn.paramsType = paramsType;
    fn.nodeColor = color;
    ArrayPush(functions, fn);
  }

  public final static func CollectFunctions() -> [AICommandNodeFunction] {
    let functions: [AICommandNodeFunction];
    let green = new Color(100u, 200u, 100u, 255u);
    let red = new Color(150u, 27u, 27u, 255u);
    let yellow = new Color(204u, 202u, 99u, 255u);
    let gray = new Color(128u, 128u, 128u, 255u);
    AICommandNodeFunctionProvider
      .Add(
        functions,
        n"Move",
        n"move",
        "Move On Spline",
        n"questMoveOnSplineParams",
        green
