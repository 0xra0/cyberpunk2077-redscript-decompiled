public native func AngleNormalize180(a: Float) -> Float;

public func SpaceFill(str: String, length: Int32, opt mode: ESpaceFillMode, opt fillChar: String) -> String {
  let addLeft: Int32;
  let addRight: Int32;
  let fillLen = StrLen(fillChar);
  if fillLen == 0 {
    fillChar = " ";
  } else if fillLen > 1 {
    fillChar = StrChar(0);
  }
  let strLen = StrLen(str);
  if strLen >= length {
    return str;
  } else if Equals(mode, ESpaceFillMode.JustifyLeft) {
    addLeft = 0;
    addRight = length - strLen;
  } else if Equals(mode, ESpaceFillMode.JustifyRight) {
    addLeft = length - strLen;
    addRight = 0;
  } else if Equals(mode, ESpaceFillMode.JustifyCenter) {
    addLeft = FloorF((Cast<Float>(length) - Cast<Float>(strLen)) / 2.0);
    addRight = length - strLen - addLeft;
  }
  let i = 0;
  while i < addLeft {
    str = fillChar + str;
    i += 1;
  }
  i = 0;
  while i < addRight {
    str += fillChar;
    i += 1;
  }
  return str;
}

public native func StrChar(i: Int32) -> String;

