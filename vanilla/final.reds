importonly native class AISubActionChimeraMetalstorm_Record extends AISubActionShootWithWeapon_Record {
}

class InCoverStanceState extends AINPCStanceStateCheck {
  private func GetStateToCheck() -> gamedataNPCStanceState {
    return gamedataNPCStanceState.Cover;
  }
}

class InSwimStanceState extends AINPCStanceStateCheck {
  private func GetStateToCheck() -> gamedataNPCStanceState {
    return gamedataNPCStanceState.Swim;
  }
}

class IsCrowdNPC extends AIbehaviorconditionScript {
  protected func Check(context: ScriptExecutionContext) -> AIbehaviorConditionOutcomes {
    return Cast<AIbehaviorConditionOutcomes>(AIBehaviorScriptBase.GetPuppet(context).IsCrowd());
  }
}

class IsAggressiveCrowd extends AIbehaviorconditionScript {
  public let m_reactionSystem: ReactionSystem;
  public let m_entityID: EntityID;
  public let m_npc: wref<NPCPuppet>;

  private func Activate(context: ScriptExecutionContext) {
    if !IsDefined(this.m_reactionSystem) {
      this.m_npc = ScriptExecutionContext.GetOwner(context) as NPCPuppet;
      this.m_entityID = this.m_npc.GetEntityID();
      this.m_reactionSystem = GameInstance.GetReactionSystem(this.m_npc.GetGame());
    }
  }

  protected func Check(context: ScriptExecutionContext) -> AIbehaviorConditionOutcomes {
    if this.m_reactionSystem.IsRegisteredAsAggressive(this.m_entityID) {
      return AIbehaviorConditionOutcomes.True;
    } else if this.m_npc.GetWasAggressiveCrowd() {
      return AIbehaviorConditionOutcomes.True;
    }
    return AIbehaviorConditionOutcomes.False;
  }
}

class TwintoneDescriptionGameController extends BaseChunkGameController {
  private let m_cursorRootContainerRef: inkWidgetRef;
  private let m_paintjobInterface: inkWidgetRef;
  private let m_restrictedPaintjobInterface: inkWidgetRef;
  private let m_videoHeaderRef: inkVideoRef;
  private let m_videoGroupRef: inkWidgetRef;
  private let m_defaultVideoLoop: ResRef;
  private let m_thanksVideo: ResRef;
  private let m_vehicleManufacturer: inkImageRef;
  private let m_applicableGroupRef: inkWidgetRef;
  private let m_buyButtonText: inkTextRef;
  private let m_applicableModelNamesText: inkTextRef;
  private let m_templateTypeText: inkTextRef;
  private let m_priceText: inkTextRef;
  private let m_profileNotAvailableText: inkTextRef;
  private let m_colorTemplatePreviewContainer: inkWidgetRef;
  private const let c_progressBarDuration: Uint32;
  private const let c_progressBarUpdateRate: Uint32;
  private let m_colorTemplatePreview: wref<ColorTemplatePreviewDisplayController>;
  private let m_vehicleCustomizationChangedCallbackID: CallbackHandle;
  private let m_vehicleManufacturerCallbackID: CallbackHandle;
  private let m_playerMountedCallbackID: CallbackHandle;
  private let m_scannerModeChangedCallbackID: CallbackHandle;
  private let m_activeTabChangedCallbackID: CallbackHandle;
  private let m_progressBarDelayID: DelayID;
  private let m_scannedVehicleTemplate: VehicleVisualCustomizationTemplate;
  private let m_scannedModelName: CName;
  private let m_cachedVehicleTemplate: VehicleVisualCustomizationTemplate;
  private let m_cachedModelName: CName;
  private let m_isScanInProgress: Bool;
  private let m_blackboardUI: wref<IBlackboard>;
  private let m_game: GameInstance;
  private let m_playerVVCComponent: vehicleVisualCustomizationComponent;
  private let m_progressBarUpdateProxy: inkAnimProxy;
  private let m_progressBarCounter: Float;
  private let m_buyAnimationProxy: inkAnimProxy;
  private let m_twintoneVisible: Bool;
  private let m_scanAvailable: Bool;
  private let m_applyAvailable: Bool;
  private let m_applyAfterSave: Bool;
  private let m_endAnimationCancelled: Bool;

  protected cb func OnInitialize() -> Bool {
    super.OnInitialize();
    this.m_colorTemplatePreview = this
      .SpawnFromExternal(
        inkWidgetRef.Get(this.m_colorTemplatePreviewContainer),
        r"base\\gameplay\\gui\\widgets\\scanning\\twintone\\twintone_color_template_preview.inkwidget",
        n"preview"
      )
      .GetControllerByType(n"ColorTemplatePreviewDisplayController") as ColorTemplatePreviewDisplayController;
    this.m_colorTemplatePreview.SetColorCorrectionEnabled(true);
    this.m_game = (this.GetOwnerEntity() as GameObject).GetGame();
    this.m_playerVVCComponent = GetPlayer(this.m_game).GetVehicleVisualCustomizationComponent();
    this.m_blackboardUI = this.GetBlackboardSystem().Get(GetAllBlackboardDefs().UI_Scanner);
    this.m_vehicleCustomizationChangedCallbackID = this
      .m_chunkBlackboard
      .RegisterDelayedListenerVariant(
        this.m_chunkBlackboardDef.ScannerVehicleCustomization,
        this,
        n"OnVehicleCustomizationChanged"
      );
    this.m_vehicleManufacturerCallbackID = this
      .m_chunkBlackboard
      .RegisterDelayedListenerVariant(
        this.m_chunkBlackboardDef.ScannerVehicleManufacturer,
        this,
        n"OnVehicleManufacturerChanged"
      );
    this.m_playerMountedCallbackID = GetPlayer(this.m_game)
      .GetPlayerStateMachineBlackboard()
      .RegisterDelayedListenerBool(
        GetAllBlackboardDefs().PlayerStateMachine.MountedToVehicle,
        this,
        n"OnPlayerMountedChanged"
      );
    this.m_scannerModeChangedCallbackID = this
      .m_blackboardUI
      .RegisterListenerVariant(GetAllBlackboardDefs().UI_Scanner.ScannerMode, this, n"OnScannerModeChanged");
    this.m_activeTabChangedCallbackID = this
      .m_blackboardUI
      .RegisterListenerVariant(
        GetAllBlackboardDefs().UI_Scanner.scannerActiveTab,
        this,
        n"OnActiveTabChanged"
      );
  }

  protected cb func OnUninitialize() -> Bool {
    this
      .m_chunkBlackboard
      .UnregisterDelayedListener(
        this.m_chunkBlackboardDef.ScannerVehicleCustomization,
        this.m_vehicleCustomizationChangedCallbackID
      );
    this
      .m_chunkBlackboard
      .UnregisterDelayedListener(
        GetAllBlackboardDefs().UI_ScannerModules.ScannerVehicleManufacturer,
        this.m_vehicleManufacturerCallbackID
      );
    this
      .m_blackboardUI
      .UnregisterDelayedListener(
        GetAllBlackboardDefs().PlayerStateMachine.MountedToVehicle,
        this.m_playerMountedCallbackID
      );
    this
      .m_blackboardUI
      .UnregisterDelayedListener(
        GetAllBlackboardDefs().UI_Scanner.ScannerMode,
        this.m_scannerModeChangedCallbackID
      );
    this
      .m_blackboardUI
      .UnregisterDelayedListener(
        GetAllBlackboardDefs().UI_Scanner.scannerActiveTab,
        this.m_activeTabChangedCallbackID
      );
    this.StopProgressBar();
  }

  protected cb func OnScannerModeChanged(val: Variant) -> Bool {
    this
      .OnTwintoneVisibleChanged(
        NotEquals(FromVariant<ScanningModeEvent>(val).mode, gameScanningMode.Inactive)
      );
  }

  protected cb func OnActiveTabChanged(val: Variant) -> Bool {
    this
      .OnTwintoneVisibleChanged(Equals(FromVariant<ScannerDetailTab>(val), ScannerDetailTab.TwinTone));
  }

  private final func OnTwintoneVisibleChanged(visible: Bool) {
    if Equals(this.m_twintoneVisible, visible) {
      return;
    }
    this.m_twintoneVisible = visible;
    if visible {
      this.GetPlayerControlledObject().RegisterInputListener(this, n"twintone_buy");
      this.RefreshTwintoneAvailability();
    } else {
      this.GetPlayerControlledObject().UnregisterInputListener(this);
      this.CancelScanningFinishAnimation();
    }
  }

  protected cb func OnAction(action: ListenerAction, consumer: ListenerActionConsumer) -> Bool {
    if Equals(ListenerAction.GetType(action), gameinputActionType.BUTTON_RELEASED) {
      if Equals(ListenerAction.GetName(action), n"twintone_buy") && this.m_scanAvailable {
        ListenerActionConsumer.Consume(consumer);
        this.SaveTwintoneProfile(false);
      }
    } else if Equals(ListenerAction.GetType(action), gameinputActionType.BUTTON_HOLD_COMPLETE) {
      if Equals(ListenerAction.GetName(action), n"twintone_buy") && this.m_applyAvailable {
        ListenerActionConsumer.Consume(consumer);
        ListenerActionConsumer.DontSendReleaseEvent(consumer);
        if !this
          .m_playerVVCComponent
          .HasVisualCustomizationTemplateStored(this.m_scannedVehicleTemplate, this.m_scannedModelName) {
          this.SaveTwintoneProfile(true);
        } else {
          this.ApplyTwintoneProfile();
        }
      } else {
        ListenerActionConsumer.Consume(consumer);
      }
    }
  }

  protected cb func OnVehicleCustomizationChanged(value: Variant) -> Bool {
    let scannedInfo = FromVariant<ScannerVehicleCustomizationTemplate>(value);
    this.m_scannedVehicleTemplate = scannedInfo.GetVehicleCustomizationTemplate();
    let profileRestricted = scannedInfo.GetProfileRestricted();
    this.m_scannedModelName = scannedInfo.GetModelName();
    this.CancelScanningFinishAnimation();
    inkWidgetRef.SetVisible(this.m_videoGroupRef, true);
    inkVideoRef.SetVideoPath(this.m_videoHeaderRef, this.m_defaultVideoLoop);
    inkVideoRef.SetLoop(this.m_videoHeaderRef, true);
    inkVideoRef.Play(this.m_videoHeaderRef);
    inkWidgetRef.SetVisible(this.m_applicableGroupRef, false);
    this
      .GetUIScannerBlackboard()
      .SetBool(GetAllBlackboardDefs().UI_Scanner.twintoneNoModelAvailable, false, true);
    if VehicleVisualCustomizationTemplate.IsValid(this.m_scannedVehicleTemplate) {
      inkWidgetRef.SetVisible(this.m_paintjobInterface, true);
      inkWidgetRef.SetVisible(this.m_restrictedPaintjobInterface, false);
      this.m_colorTemplatePreview.SetTemplate(this.m_scannedVehicleTemplate);
      inkTextRef
        .SetLocalizedTextScript(
          this.m_templateTypeText,
          Equals(
            VehicleVisualCustomizationTemplate.GetType(this.m_scannedVehicleTemplate),
            VehicleVisualCustomizationType.Unique
          ) ? "LocKey#96228" : "LocKey#96227"
        );
      inkWidgetRef
        .SetVisible(
          this.m_vehicleManufacturer,
          Equals(
            VehicleVisualCustomizationTemplate.GetType(this.m_scannedVehicleTemplate),
            VehicleVisualCustomizationType.Unique
          )
        );
      inkTextRef
        .SetText(
          this.m_priceText,
          IntToString(
            this
              .GetScanningPrice(
                VehicleVisualCustomizationTemplate.GetType(this.m_scannedVehicleTemplate)
              )
          )
        );
      if Equals(
        VehicleVisualCustomizationTemplate.GetType(this.m_scannedVehicleTemplate),
        VehicleVisualCustomizationType.Unique
      ) {
        let applicableModelNames = this.GetApplicableModelsForTemplate(this.m_scannedVehicleTemplate);
        if NotEquals(applicableModelNames, "") {
          inkWidgetRef.SetVisible(this.m_applicableGroupRef, true);
          this
            .GetUIScannerBlackboard()
            .SetBool(GetAllBlackboardDefs().UI_Scanner.twintoneNoModelAvailable, false, true);
          inkTextRef.SetText(this.m_applicableModelNamesText, applicableModelNames);
        } else {
          inkWidgetRef.SetVisible(this.m_applicableGroupRef, false);
          this
            .GetUIScannerBlackboard()
            .SetBool(GetAllBlackboardDefs().UI_Scanner.twintoneNoModelAvailable, true, true);
        }
      } else if !this
        .m_playerVVCComponent
        .HasVisualCustomizationTemplateStored(this.m_scannedVehicleTemplate, this.m_scannedModelName)
        && !VehicleVisualCustomizationTemplate.Equals(this.m_cachedVehicleTemplate, this.m_scannedVehicleTemplate) {
        this
          .SetupBuyButtonState(
            true,
            Equals(
              VehicleVisualCustomizationTemplate.GetType(this.m_scannedVehicleTemplate),
              VehicleVisualCustomizationType.Unique
            )
          );
        this.SetSaveAvailable(true);
      }
      inkWidgetRef.SetVisible(this.m_videoGroupRef, false);
      inkVideoRef.Stop(this.m_videoHeaderRef);
      this.SetupBuyButtonState(false);
      this.SetSaveAvailable(false);
    } else {
      inkWidgetRef.SetVisible(this.m_paintjobInterface, false);
      inkWidgetRef.SetVisible(this.m_restrictedPaintjobInterface, true);
      inkWidgetRef.SetVisible(this.m_vehicleManufacturer, false);
      inkTextRef
        .SetLocalizedTextScript(
          this.m_profileNotAvailableText,
          profileRestricted ? "LocKey#96248" : "LocKey#96322"
        );
      this.SetSaveAvailable(false);
    }
    this.RefreshTwintoneAvailability();
  }

  private final func CancelScanningFinishAnimation() {
    if !this.m_isScanInProgress {
      return;
    }
    this.m_buyAnimationProxy.GotoEndAndStop();
    this.SetupBuyButtonState(false);
    inkWidgetRef.SetVisible(this.m_videoGroupRef, false);
    inkVideoRef.Stop(this.m_videoHeaderRef);
    this.m_endAnimationCancelled = true;
  }

  protected cb func OnVehicleManufacturerChanged(value: Variant) -> Bool {
    let vehicleManufacturer = FromVariant<ScannerVehicleManufacturer>(value);
    if IsDefined(vehicleManufacturer) {
      let iconRecord = TweakDBInterface
        .GetUIIconRecord(TDBID.Create("UIIcon." + vehicleManufacturer.GetVehicleManufacturer()));
      inkImageRef.SetTexturePart(this.m_vehicleManufacturer, iconRecord.AtlasPartName());
    }
  }

  private final func SetupBuyButtonState(twintoneAvailable: Bool, opt uniqueTemplate: Bool) {
    if twintoneAvailable {
      this
        .PlayLibraryAnimation(
          uniqueTemplate ? n"twintone_buy_start_unique" : n"twintone_buy_start_generic"
        )
        .GotoStartAndStop(true);
      inkTextRef.SetLocalizedTextScript(this.m_buyButtonText, "LocKey#96223");
    } else {
      this.PlayLibraryAnimation(n"twintone_buy_end").GotoEndAndStop(true);
      inkTextRef.SetLocalizedTextScript(this.m_buyButtonText, "LocKey#96235");
    }
  }

  private final func SaveTwintoneProfile(applyAfterSave: Bool) {
    if !VehicleVisualCustomizationTemplate.IsValid(this.m_scannedVehicleTemplate) {
      return;
    } else if NotEquals(
      FromVariant<ScannerDetailTab>(
        this
          .GetUIScannerBlackboard()
          .GetVariant(GetAllBlackboardDefs().UI_Scanner.scannerActiveTab)
      ),
      ScannerDetailTab.TwinTone
    ) {
      return;
    } else if this.GetPlayerMoney()
      < this
        .GetScanningPrice(
          VehicleVisualCustomizationTemplate.GetType(this.m_scannedVehicleTemplate)
        ) {
      this.ShowNotEnoughMoneyWarning();
      return;
    } else if this
      .m_playerVVCComponent
      .HasVisualCustomizationTemplateStored(this.m_scannedVehicleTemplate, this.m_scannedModelName)
      || VehicleVisualCustomizationTemplate.Equals(this.m_scannedVehicleTemplate, this.m_cachedVehicleTemplate) {
      return;
    }
    this.m_applyAfterSave = applyAfterSave;
    this.m_endAnimationCancelled = false;
    if !this.m_applyAfterSave {
      if this
        .m_playerVVCComponent
        .CanStoreVisualCustomizationTemplateType(
          VehicleVisualCustomizationTemplate.GetType(this.m_scannedVehicleTemplate),
          this.m_scannedModelName
        ) {
        if this.m_isScanInProgress {
          this.FinishScanningAndSave();
          if !this
            .m_playerVVCComponent
            .CanStoreVisualCustomizationTemplateType(
              VehicleVisualCustomizationTemplate.GetType(this.m_scannedVehicleTemplate),
              this.m_scannedModelName
            ) {
            this.OpenOverridePopUp();
            return;
          }
        }
        this.m_cachedVehicleTemplate = this.m_scannedVehicleTemplate;
        this.m_cachedModelName = this.m_scannedModelName;
        this.StartTwintoneScan();
      } else {
        this.OpenOverridePopUp();
      }
    } else if this.m_isScanInProgress {
      this.FinishScanningAndSave();
    } else {
      this.m_cachedVehicleTemplate = this.m_scannedVehicleTemplate;
      this.m_cachedModelName = this.m_scannedModelName;
      if this
        .m_playerVVCComponent
        .GetNumberOfStoredVisualCustomizationTemplates(
          VehicleVisualCustomizationTemplate.GetType(this.m_cachedVehicleTemplate),
          this.m_cachedModelName
        )
        == this
          .m_playerVVCComponent
          .GetMaxNumberOfVisualCustomizationTemplates(
            VehicleVisualCustomizationTemplate.GetType(this.m_cachedVehicleTemplate)
          ) {
        let templateToDelete = this
          .m_playerVVCComponent
          .GetStoredVisualCustomizationTemplate(
            VehicleVisualCustomizationTemplate.GetType(this.m_cachedVehicleTemplate),
            0,
            this.m_cachedModelName
          );
        this
          .m_playerVVCComponent
          .DeleteVisualCustomizationTemplate(templateToDelete, this.m_cachedModelName);
      } else {
        this.StartTwintoneScan();
      }
    }
  }

  private final func ApplyTwintoneProfile() {
    if !VehicleVisualCustomizationTemplate.IsValid(this.m_scannedVehicleTemplate) {
      return;
    } else if NotEquals(
      FromVariant<ScannerDetailTab>(
        this
          .GetUIScannerBlackboard()
          .GetVariant(GetAllBlackboardDefs().UI_Scanner.scannerActiveTab)
      ),
      ScannerDetailTab.TwinTone
    ) {
      return;
    } else if !this
      .m_playerVVCComponent
      .HasVisualCustomizationTemplateStored(this.m_scannedVehicleTemplate, this.m_scannedModelName) {
      return;
    }
    this.SendCustomizationToVehicle(this.m_scannedVehicleTemplate);
  }

  private final func OpenOverridePopUp() {
    let evt = new ShowTwintoneOverrideEvent();
    evt.template = this.m_scannedVehicleTemplate;
    evt.modelName = this.m_scannedModelName;
    this
      .GetUIGameDataBlackboard()
      .SetBool(GetAllBlackboardDefs().UIGameData.Popup_TwintoneOverride_IsShown, true);
    GetPlayer(this.m_game).QueueEvent(evt);
  }

  protected cb func OnOverridePopUpClosed(evt: OnTwintoneOverrideClosedEvent) -> Bool {
    if this
      .m_playerVVCComponent
      .CanStoreVisualCustomizationTemplateType(VehicleVisualCustomizationTemplate.GetType(evt.template), evt.modelName) {
      if this.m_isScanInProgress {
        this.FinishScanningAndSave();
      }
      this.m_cachedVehicleTemplate = evt.template;
      this.m_cachedModelName = evt.modelName;
      this.StartTwintoneScan();
    }
  }

  private final func StartTwintoneScan() {
    if this.GetPlayerMoney()
      < this
        .GetScanningPrice(VehicleVisualCustomizationTemplate.GetType(this.m_cachedVehicleTemplate)) {
      this.ShowNotEnoughMoneyWarning();
      this.m_isScanInProgress = false;
    } else {
      inkVideoRef.PreloadNextVideo(this.m_videoHeaderRef, this.m_thanksVideo);
      this.StartProgressBar();
      this.PlayButtonAnimationStart();
    }
  }

  private final func StartProgressBar() {
    let animOptions: inkAnimOptions;
    let frameTime = 1.0 / Cast<Float>(this.c_progressBarUpdateRate);
    if this.m_isScanInProgress {
      this.StopProgressBar(true);
    }
    this.m_isScanInProgress = true;
    let anim = new inkAnimDef();
    let alphaInterpolator = new inkAnimTransparency();
    alphaInterpolator.SetDuration(frameTime);
    alphaInterpolator.SetStartTransparency(1.0);
    alphaInterpolator.SetEndTransparency(1.0);
    alphaInterpolator.SetType(inkanimInterpolationType.Linear);
    alphaInterpolator.SetMode(inkanimInterpolationMode.EasyIn);
    anim.AddInterpolator(alphaInterpolator);
    animOptions.playReversed = false;
    animOptions.executionDelay = 0.0;
    animOptions.dependsOnTimeDilation = false;
    animOptions.loopType = inkanimLoopType.Cycle;
    animOptions.loopCounter = this.c_progressBarUpdateRate * this.c_progressBarDuration;
    this.m_progressBarUpdateProxy = inkWidgetRef.PlayAnimationWithOptions(this.m_cursorRootContainerRef, anim, animOptions);
    this
      .m_progressBarUpdateProxy
      .RegisterToCallback(inkanimEventType.OnEndLoop, this, n"OnUpdateProgressBar");
    this
      .m_progressBarUpdateProxy
      .RegisterToCallback(inkanimEventType.OnFinish, this, n"OnProgressBarDone");
    this.m_progressBarCounter = 0.0;
    this
      .GetProgressBarBlackboard()
      .SetBool(GetAllBlackboardDefs().UI_HUDProgressBar.Active, true, true);
    this
      .GetProgressBarBlackboard()
      .SetString(
        GetAllBlackboardDefs().UI_HUDProgressBar.Header,
        LocKeyToString(n"UI-Scanner-Twintone-ScanBarHeader"),
        true
      );
    this
      .GetProgressBarBlackboard()
      .SetString(
        GetAllBlackboardDefs().UI_HUDProgressBar.BottomText,
        LocKeyToString(n"UI-Scanner-Twintone-ScanBarBottomText"),
        true
      );
    this
      .GetProgressBarBlackboard()
      .SetString(
        GetAllBlackboardDefs().UI_HUDProgressBar.CompletedText,
        LocKeyToString(n"UI-Scanner-Twintone-ScanBarDone"),
        true
      );
    this
      .GetProgressBarBlackboard()
      .SetVariant(
        GetAllBlackboardDefs().UI_HUDProgressBar.MessageType,
        ToVariant(SimpleMessageType.Twintone),
        true
      );
  }

  private final func StopProgressBar(opt keepBarWidgetAlive: Bool) {
    if !keepBarWidgetAlive {
      this
        .GetProgressBarBlackboard()
        .SetBool(GetAllBlackboardDefs().UI_HUDProgressBar.Active, false, true);
    }
    this
      .m_progressBarUpdateProxy
      .UnregisterFromCallback(inkanimEventType.OnEndLoop, this, n"OnUpdateProgressBar");
    this
      .m_progressBarUpdateProxy
      .UnregisterFromCallback(inkanimEventType.OnFinish, this, n"OnProgressBarDone");
    this.m_progressBarUpdateProxy.Stop();
    this.m_progressBarCounter = 0.0;
  }

  private final func PlayButtonAnimationStart() {
    let animOptions: inkAnimOptions;
    animOptions.dependsOnTimeDilation = false;
    this.m_buyAnimationProxy = this
      .PlayLibraryAnimation(
        Equals(
          VehicleVisualCustomizationTemplate.GetType(this.m_cachedVehicleTemplate),
          VehicleVisualCustomizationType.Unique
        ) ? n"twintone_buy_start_unique" : n"twintone_buy_start_generic",
        animOptions
      );
  }

  private final func ShowNotEnoughMoneyWarning() {
    let warningMsg: SimpleScreenMessage;
    warningMsg.isShown = true;
    warningMsg.duration = 3.0;
    warningMsg.message = LocKeyToString(n"UI-Scanner-Twintone-NotEnoughMoney");
    warningMsg.type = SimpleMessageType.Negative;
    GameInstance
      .GetBlackboardSystem(this.m_game)
      .Get(GetAllBlackboardDefs().UI_Notifications)
      .SetVariant(
        GetAllBlackboardDefs().UI_Notifications.WarningMessage,
        ToVariant(warningMsg),
        true
      );
  }

  protected cb func OnUpdateProgressBar(proxy: inkAnimProxy) -> Bool {
    let frameTime = 1.0 / Cast<Float>(this.c_progressBarUpdateRate);
    this.m_progressBarCounter += frameTime;
    this
      .GetProgressBarBlackboard()
      .SetFloat(
        GetAllBlackboardDefs().UI_HUDProgressBar.Progress,
        this.m_progressBarCounter / Cast<Float>(this.c_progressBarDuration)
      );
  }

  protected cb func OnProgressBarDone(proxy: inkAnimProxy) -> Bool {
    this.StopProgressBar();
    this.m_isScanInProgress = false;
    this.FinishScanningAndSave();
    if this.m_endAnimationCancelled {
      return false;
    }
    inkVideoRef.SetVideoPath(this.m_videoHeaderRef, this.m_thanksVideo);
    inkVideoRef.SetLoop(this.m_videoHeaderRef, false);
    inkVideoRef.Play(this.m_videoHeaderRef);
    let videoWidget = inkWidgetRef.Get(this.m_videoHeaderRef) as inkVideo;
    videoWidget.RegisterToCallback(n"OnVideoFinished", this, n"OnVideoFinished");
    this.PlayButtonAnimationEnd();
    this.SetSaveAvailable(false);
  }

  private final func FinishScanningAndSave() {
    let emptyTemplate: VehicleVisualCustomizationTemplate;
    let emptyName: CName;
    this
      .RemovePlayerMoney(
        this
          .GetScanningPrice(
            VehicleVisualCustomizationTemplate.GetType(this.m_cachedVehicleTemplate)
          )
      );
    this
      .m_playerVVCComponent
      .StoreVisualCustomizationTemplate(this.m_cachedVehicleTemplate, this.m_cachedModelName);
    if this.m_applyAfterSave {
      this.m_applyAfterSave = false;
      this.SendCustomizationToVehicle(this.m_cachedVehicleTemplate);
    } else if VehicleVisualCustomizationTemplate.Equals(this.m_scannedVehicleTemplate, this.m_cachedVehicleTemplate) {
      this.SetSaveAvailable(false);
    }
    this.m_cachedVehicleTemplate = emptyTemplate;
    this.m_cachedModelName = emptyName;
  }

  protected cb func OnVideoFinished(videoWidget: wref<inkVideo>) -> Bool {
    let videoWidgetHandle = videoWidget;
    videoWidgetHandle.UnregisterFromCallback(n"OnVideoFinished", this, n"OnVideoFinished");
    inkWidgetRef.SetVisible(this.m_videoGroupRef, false);
  }

  private final func PlayButtonAnimationEnd() {
    let animOptions: inkAnimOptions;
    animOptions.dependsOnTimeDilation = false;
    this.PlayLibraryAnimation(n"twintone_buy_end", animOptions);
    inkTextRef.SetLocalizedTextScript(this.m_buyButtonText, "LocKey#96235");
  }

  private final func GetProgressBarBlackboard() -> IBlackboard {
    return GameInstance
      .GetBlackboardSystem(this.m_game)
      .Get(GetAllBlackboardDefs().UI_HUDProgressBar);
  }

  private final func GetUIGameDataBlackboard() -> IBlackboard {
    return GameInstance.GetBlackboardSystem(this.m_game).Get(GetAllBlackboardDefs().UIGameData);
  }

  private final func GetUIScannerBlackboard() -> IBlackboard {
    return GameInstance.GetBlackboardSystem(this.m_game).Get(GetAllBlackboardDefs().UI_Scanner);
  }

  private final func GetScanningPrice(type: VehicleVisualCustomizationType) -> Int32 {
    return Equals(type, VehicleVisualCustomizationType.Unique) ? TDB.GetInt(t"player.vehicle.twintoneUniqueScanningPrice") : TDB.GetInt(t"player.vehicle.twintoneGenericScanningPrice");
  }

  private final func GetPlayerMoney() -> Int32 {
    return GameInstance
      .GetTransactionSystem(this.m_game)
      .GetItemQuantity(GetMainPlayer(this.m_game), MarketSystem.Money());
  }

  private final func RemovePlayerMoney(amount: Int32) -> Bool {
    return GameInstance
      .GetTransactionSystem(this.m_game)
      .RemoveItem(GetMainPlayer(this.m_game), MarketSystem.Money(), amount);
  }

  protected cb func OnPlayerMountedChanged(mounted: Bool) -> Bool {
    this.RefreshTwintoneAvailability();
  }

  private final func RefreshTwintoneAvailability() {
    this.SetSaveAvailable(this.m_scanAvailable);
    this.UpdateApplyAvailable();
  }

  private final func SetSaveAvailable(available: Bool) {
    this.m_scanAvailable = available;
    this
      .GetUIScannerBlackboard()
      .SetBool(GetAllBlackboardDefs().UI_Scanner.twintoneAvailable, available);
  }

  private final func UpdateApplyAvailable() {
    this.m_applyAvailable = IsDefined(GetPlayer(this.m_game))
      && IsDefined(GetPlayer(this.m_game).GetMountedVehicle())
      && GetPlayer(this.m_game)
        .GetMountedVehicle()
        .GetVehicleComponent()
        .CanApplyTemplateOnVehicle(this.m_scannedVehicleTemplate);
    this
      .GetUIScannerBlackboard()
      .SetBool(
        GetAllBlackboardDefs().UI_Scanner.twintoneApplyAvailable,
        this.m_applyAvailable
      );
  }

  private final func SendCustomizationToVehicle(template: VehicleVisualCustomizationTemplate) {
    let evt = new NewVehicleVisualCustomizationEvent();
    evt.template = template;
    if IsDefined(GetPlayer(this.m_game)) && IsDefined(GetPlayer(this.m_game).GetMountedVehicle()) {
      GetPlayer(this.m_game).GetMountedVehicle().QueueEvent(evt);
    } else if VehicleVisualCustomizationTemplate.Equals(template, this.m_scannedVehicleTemplate) {
      this.m_applyAvailable = false;
      this
        .GetUIScannerBlackboard()
        .SetBool(
          GetAllBlackboardDefs().UI_Scanner.twintoneApplyAvailable,
          this.m_applyAvailable
        );
    }
  }

  private const final func GetApplicableModelsForTemplate(template: VehicleVisualCustomizationTemplate) -> String {
    let result: String;
    let unlockedVehicles: [PlayerVehicle];
    GameInstance.GetVehicleSystem(this.m_game).GetPlayerUnlockedVehicles(unlockedVehicles);
    let i = 0;
    while i < ArraySize(unlockedVehicles) {
      let vehicleRecord = TweakDBInterface.GetVehicleRecord(unlockedVehicles[i].recordID);
      if vehicleRecord.HasVisualCustomization()
        && !vehicleRecord.VisualCustomizationTeaser()
        && Equals(vehicleRecord.TwintoneModelName(), template.uniqueData.twintoneModelName) {
        if NotEquals(result, "") {
          result += ", ";
        }
        result += GetLocalizedText(LocKeyToString(vehicleRecord.DisplayName()));
      }
      i += 1;
    }
    return result;
  }
}

public native func OperatorMultiply(a: Uint32, b: Uint32) -> Uint32;

abstract class AISubActionMissileRainGrid_Record_Implementation extends IScriptable {
  public final static func Activate(
    context: ScriptExecutionContext,
    record: wref<AISubActionMissileRainGrid_Record>
  ) {
    AISubActionShootWithWeapon_Record_Implementation.Activate(context, record);
  }

  public final static func Update(
    context: ScriptExecutionContext,
