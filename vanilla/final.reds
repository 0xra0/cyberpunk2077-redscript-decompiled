class PuppetListener extends IScriptable {
  public let prereqOwner: PrereqState;

  public final func RegisterOwner(owner: PrereqState) -> Bool {
    if !IsDefined(this.prereqOwner) {
      this.prereqOwner = owner;
      return true;
    }
    return false;
  }

  public final func ModifyOwner(owner: PrereqState) {
    this.prereqOwner = owner;
  }

  public final func OnRevealedStateChanged(isRevealed: Bool) {
    let castedOwner = this.prereqOwner as NPCRevealedPrereqState;
    if IsDefined(castedOwner) {
      castedOwner.OnChanged(isRevealed);
    }
  }

  public final func OnHitReactionTypeChanged(hitType: Int32) {
    let castedPrereq = this.prereqOwner.GetPrereq() as NPCHitReactionTypePrereq;
    if IsDefined(castedPrereq) {
      this
        .prereqOwner
        .OnChanged(
          castedPrereq
            .EvaluateCondition(this.prereqOwner.GetContext() as ScriptedPuppet, hitType)
        );
    }
  }

  public final func OnHitReactionSourceChanged(hitSource: Int32) {
    let castedPrereq = this.prereqOwner.GetPrereq() as NPCHitSourcePrereq;
    if IsDefined(castedPrereq) {
      this.prereqOwner.OnChanged(castedPrereq.EvaluateCondition(hitSource));
    }
  }

  public final func OnIsTrackingPlayerChanged(isTrackingPlayer: Bool) {
    let castedPrereq = this.prereqOwner.GetPrereq() as NPCTrackingPlayerPrereq;
    if IsDefined(castedPrereq) {
      this.prereqOwner.OnChanged(castedPrereq.EvaluateCondition(isTrackingPlayer));
    }
  }
}

class NPCRevealedPrereqState extends PrereqState {
  public let m_listener: PuppetListener;
}

class NPCHitReactionTypePrereq extends IScriptablePrereq {
  public let m_hitReactionType: animHitReactionType;
  public let m_timeout: Float;
  public let m_invert: Bool;

  protected func Initialize(recordID: TweakDBID) {
    let str = TweakDBInterface.GetString(recordID + t".hitReactionType", "");
    this.m_hitReactionType = IntEnum<animHitReactionType>(Cast<Int32>(EnumValueFromString("animHitReactionType", str)));
    this.m_timeout = TweakDBInterface.GetFloat(recordID + t".timeout", -1.0);
    this.m_invert = TweakDBInterface.GetBool(recordID + t".invert", false);
  }

  protected const func OnRegister(state: PrereqState, game: GameInstance, context: IScriptable) -> Bool {
    let puppet = context as ScriptedPuppet;
    if IsDefined(puppet) {
      let castedState = state as NPCHitReactionTypePrereqState;
      castedState.m_listener = new PuppetListener();
      castedState.m_listener.RegisterOwner(castedState);
      ScriptedPuppet.AddListener(puppet, castedState.m_listener);
      return false;
    }
    return false;
  }

  protected const func OnUnregister(state: PrereqState, game: GameInstance, context: IScriptable) {
    let puppet = context as ScriptedPuppet;
    let castedState = state as NPCHitReactionTypePrereqState;
    if IsDefined(puppet) && IsDefined(castedState.m_listener) {
      ScriptedPuppet.RemoveListener(puppet, castedState.m_listener);
    }
    castedState.m_listener = null;
  }

  protected const func OnApplied(state: PrereqState, game: GameInstance, context: IScriptable) {
    let puppet = context as ScriptedPuppet;
    if !IsDefined(puppet) {
      return;
    }
    let hitReactionComponent = puppet.GetHitReactionComponent();
    if !IsDefined(hitReactionComponent) {
      return;
    }
    let castedState = state as NPCHitReactionTypePrereqState;
    if IsDefined(castedState.m_listener) {
      castedState
        .m_listener
        .OnHitReactionTypeChanged(hitReactionComponent.GetHitReactionData().hitType);
    }
  }

  public const func IsFulfilled(game: GameInstance, context: IScriptable) -> Bool {
    let puppet = context as ScriptedPuppet;
    if !IsDefined(puppet) {
      return false;
    }
    let hitReactionComponent = puppet.GetHitReactionComponent();
    if !IsDefined(hitReactionComponent) {
      return false;
    }
    return this.EvaluateCondition(puppet, hitReactionComponent.GetHitReactionData().hitType);
  }

  public const final func EvaluateCondition(puppet: wref<ScriptedPuppet>, hitType: Int32) -> Bool {
    let arrayElement: NPCHitTypeTimeoutStruct;
    let result: Bool;
    if hitType != EnumInt(this.m_hitReactionType) {
      result = this.m_invert ? true : false;
    } else {
      result = this.m_invert ? false : true;
    }
    if !result && hitType > 0 && this.m_timeout > 0.0 {
      let bb = puppet.GetAIControllerComponent().GetAIPrereqsBlackboard();
      let delayArray = FromVariant<[NPCHitTypeTimeoutStruct]>(bb.GetVariant(GetAllBlackboardDefs().AIPrereqs.npcHitTypeTimeout));
      let evt = new ResetNPCHitReactionTypePrereqStateEvent();
      let i = 0;
      while i < ArraySize(delayArray) {
        if delayArray[i].delayID != GetInvalidDelayID() {
          GameInstance.GetDelaySystem(puppet.GetGame()).CancelDelay(delayArray[i].delayID);
          delayArray[i].delayID = GetInvalidDelayID();
        } else if delayArray[i].timeout == this.m_timeout {
          let instanceFound = true;
          delayArray[i].delayID = GameInstance
            .GetDelaySystem(puppet.GetGame())
            .DelayEvent(puppet, evt, this.m_timeout);
          bb
            .SetVariant(
              GetAllBlackboardDefs().AIPrereqs.npcHitTypeTimeout,
              ToVariant(delayArray),
              true
            );
        }
        i += 1;
      }
      if !instanceFound {
        arrayElement.timeout = this.m_timeout;
        arrayElement.delayID = GameInstance
          .GetDelaySystem(puppet.GetGame())
          .DelayEvent(puppet, evt, this.m_timeout);
        ArrayPush(delayArray, arrayElement);
        bb
          .SetVariant(
            GetAllBlackboardDefs().AIPrereqs.npcHitTypeTimeout,
            ToVariant(delayArray),
            true
          );
      }
    }
    return result;
  }
}

