class RoadBlockTrap extends InteractiveMasterDevice {
  protected let m_areaComponent: TriggerComponent;

  protected cb func OnRequestComponents(ri: EntityRequestComponentsInterface) -> Bool {
    super.OnRequestComponents(ri);
    EntityRequestComponentsInterface.RequestComponent(ri, n"trapArea", n"TriggerComponent", false);
  }

  protected cb func OnTakeControl(ri: EntityResolveComponentsInterface) -> Bool {
    super.OnTakeControl(ri);
    this.m_areaComponent = EntityResolveComponentsInterface.GetComponent(ri, n"trapArea") as TriggerComponent;
    this.m_controller = EntityResolveComponentsInterface.GetComponent(ri, n"controller") as RoadBlockTrapController;
  }

  protected cb func OnActivateDevice(evt: ActivateDevice) -> Bool {
    if this.IsPlayerInside() {
      this.GetDevicePS().RefreshSlaves_Event();
    }
  }

  protected cb func OnAreaEnter(evt: AreaEnteredEvent) -> Bool {
    super.OnAreaEnter(evt);
    if NotEquals(evt.componentName, n"trapArea") {
      return false;
    } else if !this.GetDevicePS().IsActivated() || this.GetDevicePS().IsDisabled() {
      return false;
    }
    let activator = EntityGameInterface.GetEntity(evt.activator) as GameObject;
    if activator.IsPlayer() {
      this.TrapPlayer(activator as PlayerPuppet);
      this.GetDevicePS().RefreshSlaves_Event();
      this.GetDevicePS().ForceDisableDevice();
    }
  }

  protected cb func OnAreaExit(evt: AreaExitedEvent) -> Bool {
    super.OnAreaExit(evt);
  }

  private final func IsPlayerInside() -> Bool {
    let puppets = this.m_areaComponent.GetOverlappingEntities();
    if ArraySize(puppets) > 0 {
      let i = 0;
      while i < ArraySize(puppets) {
        if IsDefined(puppets[i] as PlayerPuppet) {
          return true;
        }
        i += 1;
      }
    }
    return false;
  }

  private const func GetController() -> RoadBlockTrapController {
    return this.m_controller as RoadBlockTrapController;
  }

  public const func GetDevicePS() -> RoadBlockTrapControllerPS {
    return this.GetController().GetPS();
  }

  private final func TrapPlayer(player: wref<PlayerPuppet>) {
    let ev = new PSMImpulse();
    ev.id = n"impulse";
    let playerVelocity = player.GetVelocity();
    playerVelocity.Z = 0.0;
    ev.impulse = -1.0 * playerVelocity;
    player.QueueEvent(ev);
    GameInstance
      .GetTeleportationFacility(this.GetGame())
      .Teleport(player, this.GetWorldPosition(), Vector4.ToRotation(player.GetWorldForward()));
  }
}

class RoadBlockTrapController extends MasterController {
  public const func GetPS() -> RoadBlockTrapControllerPS {
    return this.GetBasePS() as RoadBlockTrapControllerPS;
  }
}

class IsNotWeakspotFilter extends EffectObjectSingleFilter_Scripted {
  public final func Process(ctx: EffectScriptContext, filterCtx: EffectSingleFilterScriptContext) -> Bool {
    let entity = EffectSingleFilterScriptContext.GetEntity(filterCtx);
    if IsDefined(entity as WeakspotObject) {
      return false;
    }
    return true;
  }
}

class IsNotInstigatorWeakspotFilter extends EffectObjectSingleFilter_Scripted {
  public final func Process(ctx: EffectScriptContext, filterCtx: EffectSingleFilterScriptContext) -> Bool {
    let weakSpotObjectOwner: Entity;
    let instigator = EffectScriptContext.GetInstigator(ctx);
    let entity = EffectSingleFilterScriptContext.GetEntity(filterCtx);
    let weakSpotObject = entity as WeakspotObject;
    if IsDefined(weakSpotObject) {
      weakSpotObjectOwner = weakSpotObject.GetOwner();
    } else if IsDefined(entity as WeakspotObject) && weakSpotObjectOwner == instigator {
      return false;
    }
    break;
    return true;
  }
}

class IsNotInstigatorProjectileFilter extends EffectObjectSingleFilter_Scripted {
  public final func Process(ctx: EffectScriptContext, filterCtx: EffectSingleFilterScriptContext) -> Bool {
    let instigator = EffectScriptContext.GetInstigator(ctx);
    let entity = EffectSingleFilterScriptContext.GetEntity(filterCtx);
    let projectileObject = entity as BaseProjectile;
    if IsDefined(projectileObject) {
      let projectileInstigator = projectileObject.GetInstigator();
      if IsDefined(projectileInstigator) && projectileInstigator == instigator as GameObject {
        return false;
      }
    }
    return true;
  }
}

