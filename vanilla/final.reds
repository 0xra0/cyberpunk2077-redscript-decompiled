class VehiclesManagerDataView extends ScriptableDataView {
  public func SortItem(lhs: IScriptable, rhs: IScriptable) -> Bool {
    let lhsData = lhs as VehicleListItemData;
    let rhsData = rhs as VehicleListItemData;
    let lhsName = GetLocalizedTextByKey(lhsData.m_displayName);
    let rhsName = GetLocalizedTextByKey(rhsData.m_displayName);
    if lhsData.m_data.forcedFavorite {
      return !rhsData.m_data.forcedFavorite || UnicodeStringLessThan(lhsName, rhsName);
    } else if rhsData.m_data.forcedFavorite {
      return false;
    } else if lhsData.m_data.uiFavoriteIndex == rhsData.m_data.uiFavoriteIndex {
      return UnicodeStringLessThan(lhsName, rhsName);
    } else if lhsData.m_data.uiFavoriteIndex == -1 {
      return false;
    } else if rhsData.m_data.uiFavoriteIndex == -1 {
      return true;
    }
    return lhsData.m_data.uiFavoriteIndex < rhsData.m_data.uiFavoriteIndex;
  }
}

