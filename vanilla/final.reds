      GameInstance
        .GetBlackboardSystem(GetGameInstance())
        .Get(GetAllBlackboardDefs().QuickMeleeData)
        .SetBool(GetAllBlackboardDefs().QuickMeleeData.NPCHit, true);
    }
    return true;
  }
}

