abstract class LocomotionAirDecisions extends LocomotionTransition {
  protected const func EnterCondition(const stateContext: StateContext, const scriptInterface: StateGameScriptInterface) -> Bool {
    return true;
  }

  protected const final func ShouldFall(const stateContext: StateContext, const scriptInterface: StateGameScriptInterface) -> Bool {
    if this.IsTouchingGround(scriptInterface) {
      return false;
    }
    this.IsTouchingGround(scriptInterface);
    if scriptInterface.IsOnMovingPlatform() {
      return false;
    } else if stateContext.GetBoolParameter(n"isAttacking", true) {
      return true;
    }
    let regularLandingFallingSpeed = this
      .GetFallingSpeedBasedOnHeight(
        scriptInterface,
        this.GetStaticFloatParameterDefault("regularLandingHeight", 0.1)
      );
    let verticalSpeed = this.GetVerticalSpeed(scriptInterface);
    return verticalSpeed < regularLandingFallingSpeed;
  }

  protected const func ToRegularLand(const stateContext: StateContext, const scriptInterface: StateGameScriptInterface) -> Bool {
    let landingType = this.GetLandingType(stateContext);
    if !this.IsTouchingGround(scriptInterface) || this.GetVerticalSpeed(scriptInterface) > 0.0 {
      return false;
    } else if landingType <= 1 {
      return true;
    }
    return false;
  }

  protected const final func ToHardLand(const stateContext: StateContext, const scriptInterface: StateGameScriptInterface) -> Bool {
    if !this.IsTouchingGround(scriptInterface) || this.GetVerticalSpeed(scriptInterface) > 0.0 {
      return false;
    }
    let landingType = this.GetLandingType(stateContext);
    if landingType == 2 {
      return true;
    }
    return false;
  }

  protected const final func ToVeryHardLand(const stateContext: StateContext, const scriptInterface: StateGameScriptInterface) -> Bool {
    if !this.IsTouchingGround(scriptInterface) {
      return false;
    }
    let landingType = this.GetLandingType(stateContext);
    if landingType == 3 {
      return true;
    }
    return false;
  }

  protected const final func ToSuperheroLand(const stateContext: StateContext, const scriptInterface: StateGameScriptInterface) -> Bool {
    if this.IsTouchingGround(scriptInterface) {
      return true;
    }
    return false;
  }

  protected const func ToDeathLand(const stateContext: StateContext, const scriptInterface: StateGameScriptInterface) -> Bool {
    if !this.IsTouchingGround(scriptInterface) {
      return false;
    }
    let landingType = this.GetLandingType(stateContext);
    if landingType == 5 {
      return true;
    }
    return false;
  }
}

abstract class AbstractLandEvents extends LocomotionGroundEvents {
  public let m_blockLandingStimBroadcasting: Bool;

  public func OnEnter(stateContext: StateContext, scriptInterface: StateGameScriptInterface) {
    let bottomCollisionNormal: Vector4;
    let up = DefaultTransition.GetUpVector();
    super.OnEnter(stateContext, scriptInterface);
    this.SetAudioParameter(n"RTPC_Landing_Type", 0.0, scriptInterface);
    scriptInterface.PushAnimationEvent(n"Land");
    let capsuleRadius = FromVariant<Float>(scriptInterface.GetStateVectorParameter(physicsStateValue.Radius));
    let playerPosition = DefaultTransition.GetPlayerPosition(scriptInterface);
    let collisionReport = scriptInterface.GetCollisionReport();
    let playerPositionCentreOfSphere = playerPosition + up * capsuleRadius;
    let bottomCollisionFound = false;
    let collisionIndex = 0;
    while collisionIndex < ArraySize(collisionReport) && !bottomCollisionFound {
      let hit = collisionReport[collisionIndex];
      let touchNormal = Vector4.Normalize(playerPositionCentreOfSphere - hit.worldPos);
      if touchNormal.Z > 0.0 && bottomCollisionNormal.Z < touchNormal.Z {
        bottomCollisionNormal = touchNormal;
        if bottomCollisionNormal.Z < 1.0 {
          bottomCollisionFound = true;
        }
      }
      collisionIndex += 1;
    }
    this.ResetFallingParameters(stateContext);
  }

  protected final func BroadcastLandingStim(
    stateContext: StateContext,
    scriptInterface: StateGameScriptInterface,
    stimType: gamedataStimType
  ) {
    let broadcastLandingStim = scriptInterface
      .GetStatsSystem()
      .GetStatValue(
        Cast<StatsObjectID>(scriptInterface.ownerEntityID),
        gamedataStatType.CanLandSilently
      ) < 1.0;
    if !broadcastLandingStim || this.m_blockLandingStimBroadcasting {
      this.m_blockLandingStimBroadcasting = false;
      return;
    } else if LocomotionGroundDecisions.CheckCrouchEnterCondition(stateContext, scriptInterface) && Equals(stimType, gamedataStimType.LandingRegular) {
      return;
    }
    break;
    let impactSpeed = stateContext.GetPermanentFloatParameter(n"ImpactSpeed");
    let speedThresholdToSendStim = this.GetFallingSpeedBasedOnHeight(scriptInterface, 1.2);
    if impactSpeed.value < speedThresholdToSendStim {
      let broadcaster = scriptInterface.executionOwner.GetStimBroadcasterComponent();
      if IsDefined(broadcaster) {
        broadcaster.TriggerSingleBroadcast(scriptInterface.executionOwner, stimType);
      }
    }
  }

  protected final func EvaluatePlayingLandingVFX(stateContext: StateContext, scriptInterface: StateGameScriptInterface) {
    let impactSpeed = stateContext.GetPermanentFloatParameter(n"ImpactSpeed");
    let minFallSpeed = this.GetFallingSpeedBasedOnHeight(scriptInterface, 2.0);
    if impactSpeed.value < minFallSpeed {
      this.StartEffect(scriptInterface, n"landing_regular");
    }
  }

  public func OnExit(stateContext: StateContext, scriptInterface: StateGameScriptInterface) {
    super.OnExit(stateContext, scriptInterface);
    this
      .SetBlackboardIntVariable(scriptInterface, GetAllBlackboardDefs().PlayerStateMachine.Landing, 0);
  }
}

