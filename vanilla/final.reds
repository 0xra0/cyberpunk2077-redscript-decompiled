class CyberwareUtility extends IScriptable {
  public final static func GetMaxActiveTimeFromTweak(item: TweakDBID) -> Float {
    return TweakDBInterface.GetFloat(item + t".maxActiveTime", 6.0);
  }

  public final static func GetActiveCyberwareItem(player: PlayerPuppet) -> TweakDBID {
    let cs = GameInstance.GetScriptableSystemsContainer(player.GetGame()).Get(n"EquipmentSystem") as EquipmentSystem;
    let item = cs.GetPlayerData(player).GetActiveItem(gamedataEquipmentArea.QuickSlot);
    return ItemID.GetTDBID(item);
  }

  public final static func StartGenericCwCooldown(player: PlayerPuppet);

  public final static func IsCurrentCyberwareOnCooldown(player: PlayerPuppet) -> Bool {
    return false;
  }
}

