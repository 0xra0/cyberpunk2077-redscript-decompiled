    super.OnUninitialize();
    this
      .UnregisterFromGlobalInputCallback(n"OnPostOnRelease", this, n"OnShortcutPress");
    this.UnregisterFromCallback(n"OnHoverOver", this, n"OnHoverOverWidget");
    inkWidgetRef
      .UnregisterFromCallback(this.m_attribute_01, n"OnValueIncremented", this, n"OnValueIncremented");
