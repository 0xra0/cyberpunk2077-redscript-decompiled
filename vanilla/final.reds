class AIFollowerTakedownCommandHandler extends AIbehaviortaskScript {
  public let m_inCommand: AIArgumentMapping;

  protected func Activate(context: ScriptExecutionContext) {
    AIbehaviortaskScript
      .SetUpdateInterval(context, AIBehaviorScriptBase.RandomizeOffsetForUpdateInterval(0.2));
  }

  protected func Update(context: ScriptExecutionContext) -> AIbehaviorUpdateOutcome {
    let target: wref<GameObject>;
    let targetEntityIds: [EntityID];
    if !IsDefined(this.m_inCommand) {
      return AIbehaviorUpdateOutcome.FAILURE;
    }
    let rawCommand = ScriptExecutionContext.GetScriptableMappingValue(context, this.m_inCommand);
    let typedCommand = rawCommand as AIFollowerTakedownCommand;
    if !IsDefined(typedCommand) {
      return AIbehaviorUpdateOutcome.FAILURE;
    } else if IsDefined(typedCommand.target) {
      target = typedCommand.target;
    }
    GetFixedEntityIdsFromEntityReference(
      typedCommand.targetRef,
      ScriptExecutionContext.GetOwner(context).GetGame(),
      targetEntityIds
    );
    if !this.SelectBestTarget(context, targetEntityIds, target) {
      target = ScriptExecutionContext.PuppetRefToObject(context, typedCommand.targetRef);
      if IsDefined(target)
        && (!ScriptedPuppet.IsActive(target) || ScriptedPuppet.IsBeingGrappled(target)) {
        target = null;
      } else if !IsDefined(target) {
        return AIbehaviorUpdateOutcome.FAILURE;
      } else if ScriptExecutionContext.GetArgumentObject(context, n"CombatTarget") != target {
        ScriptExecutionContext.SetArgumentObject(context, n"CombatTarget", target);
      }
    }
    NPCPuppet
      .ChangeHighLevelState(
        ScriptExecutionContext.GetOwner(context),
        gamedataNPCHighLevelState.Stealth
      );
    return AIbehaviorUpdateOutcome.IN_PROGRESS;
  }

  private final func Deactivate(context: ScriptExecutionContext) {
    let rawCommand = ScriptExecutionContext.GetScriptableMappingValue(context, this.m_inCommand);
    let takedownCommand = rawCommand as AIFollowerTakedownCommand;
    let aiComponent = AIBehaviorScriptBase.GetPuppet(context).GetAIControllerComponent();
    if IsDefined(takedownCommand) {
      aiComponent.StopExecutingCommand(takedownCommand, true);
    }
    ScriptExecutionContext.SetArgumentObject(context, n"CombatTarget", null);
    ScriptExecutionContext.SetMappingValue(context, this.m_inCommand, ToVariant(null));
  }

  private final func SelectBestTarget(
    context: ScriptExecutionContext,
    const targetEntityIds: script_ref<[EntityID]>,
    out target: wref<GameObject>
  ) -> Bool {
    let validTargets: [GameObject];
    let shortestDistance: Float;
    if ArraySize(targetEntityIds) == 0 {
      return false;
    }
    let i = 0;
    while i < ArraySize(targetEntityIds) {
      target = GameInstance
        .FindEntityByID(ScriptExecutionContext.GetOwner(context).GetGame(), targetEntityIds[i]) as GameObject;
      if IsDefined(target)
        && ScriptedPuppet.IsActive(target)
        && !ScriptedPuppet.IsBeingGrappled(target) {
        ArrayPush(validTargets, target);
      }
      i += 1;
    }
    let selectedTargetIndex = -1;
    i = 0;
    while i < ArraySize(validTargets) {
      let distToTarget = Vector4
        .Distance(
          ScriptExecutionContext.GetOwner(context).GetWorldPosition(),
          validTargets[i].GetWorldPosition()
        );
      if i == 0 || distToTarget < shortestDistance {
        shortestDistance = distToTarget;
        selectedTargetIndex = i;
      }
      i += 1;
    }
    if selectedTargetIndex >= 0 {
      target = validTargets[selectedTargetIndex];
      return target != null;
    }
    target = null;
    return false;
  }
}

class SquadAlertedSync extends SquadTask {
  protected func Activate(context: ScriptExecutionContext) {
    let psi: PuppetSquadInterface;
    AISquadHelper.GetSquadBaseInterface(ScriptExecutionContext.GetOwner(context), psi);
    let members = psi.ListMembers();
    ArrayRemove(members, ScriptExecutionContext.GetOwner(context));
    let count = ArraySize(members);
    let i = 0;
    while i < count {
      if Equals(
        (members[i] as ScriptedPuppet).GetHighLevelStateFromBlackboard(),
        gamedataNPCHighLevelState.Relaxed
      ) {
        NPCPuppet
          .ChangeHighLevelState(members[i] as GameObject, gamedataNPCHighLevelState.Alerted);
      }
      i += 1;
    }
  }
}

