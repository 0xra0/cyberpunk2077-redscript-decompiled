class CheckDroppedThreat extends CheckThreat {
  protected func Check(context: ScriptExecutionContext) -> AIbehaviorConditionOutcomes {
    let tte = AIBehaviorScriptBase.GetPuppet(context).GetTargetTrackerComponent() as TargetTrackingExtension;
    if !IsDefined(tte) {
      return AIbehaviorConditionOutcomes.False;
    }
    let threatData = tte.GetRecentlyDroppedThreat();
    return Cast<AIbehaviorConditionOutcomes>(IsDefined(threatData.threat));
  }
}

