abstract class UpperBodyTransition extends DefaultTransition {
  protected const final func EmptyHandsCondition(const stateContext: StateContext, const scriptInterface: StateGameScriptInterface) -> Bool {
    if this.IsInSafeSceneTier(scriptInterface)
      && (Equals(
        scriptInterface
          .localBlackboard
          .GetBool(GetAllBlackboardDefs().PlayerStateMachine.SceneAimForced),
        true
      )
        || Equals(
          scriptInterface
            .localBlackboard
            .GetBool(GetAllBlackboardDefs().PlayerStateMachine.SceneSafeForced),
          true
        )) {
      return false;
    } else if scriptInterface
      .localBlackboard
      .GetBool(GetAllBlackboardDefs().PlayerStateMachine.UseUnarmed) {
      return true;
    } else if DefaultTransition.HasRightWeaponEquipped(scriptInterface) && stateContext.GetBoolParameter(n"requestWeaponUnequip", false) {
      return true;
    }
    return false;
  }

  protected const final func GetTransactionSystem(const scriptInterface: StateGameScriptInterface) -> TransactionSystem {
    let transactionSystem = scriptInterface.GetTransactionSystem();
    if !IsDefined(transactionSystem) {
      return null;
    }
    return transactionSystem;
  }

  public final static func HasLeftWeaponEquipped(const scriptInterface: StateGameScriptInterface) -> Bool {
    if IsDefined(
      scriptInterface
        .GetTransactionSystem()
        .GetItemInSlot(scriptInterface.executionOwner, t"AttachmentSlots.WeaponLeft") as WeaponObject
    ) {
      return true;
    }
    return false;
  }

  public final static func HasAnyWeaponEquipped(const scriptInterface: StateGameScriptInterface) -> Bool {
    if UpperBodyTransition.HasLeftWeaponEquipped(scriptInterface) || DefaultTransition.HasRightWeaponEquipped(scriptInterface) {
      return true;
    }
    return false;
  }

  public final static func HasMeleeWeaponEquipped(const scriptInterface: StateGameScriptInterface) -> Bool {
    let weapon = scriptInterface
      .GetTransactionSystem()
      .GetItemInSlot(scriptInterface.executionOwner, t"AttachmentSlots.WeaponRight") as WeaponObject;
    if IsDefined(weapon) {
      if scriptInterface
        .GetTransactionSystem()
        .HasTag(scriptInterface.executionOwner, n"MeleeWeapon", weapon.GetItemID()) {
        return true;
      }
    }
    return false;
  }

  public final static func HasRangedWeaponEquipped(const executionOwner: wref<GameObject>) -> Bool {
    let transactionSystem = GameInstance.GetTransactionSystem(executionOwner.GetGame());
    let weapon = transactionSystem.GetItemInSlot(executionOwner, t"AttachmentSlots.WeaponRight") as WeaponObject;
    if IsDefined(weapon) {
      if transactionSystem.HasTag(executionOwner, n"RangedWeapon", weapon.GetItemID()) {
        return true;
      }
    }
    return false;
  }

  public final static func HasThrowableMeleeEqupped(const executionOwner: wref<GameObject>) -> Bool {
    let transactionSystem = GameInstance.GetTransactionSystem(executionOwner.GetGame());
    let weapon = transactionSystem.GetItemInSlot(executionOwner, t"AttachmentSlots.WeaponRight") as WeaponObject;
    return Equals(
      RPGManager.GetWeaponEvolution(weapon.GetItemID()),
      gamedataWeaponEvolution.Throwable
    );
  }

  public final static func HasMeleewareEquipped(const scriptInterface: StateGameScriptInterface) -> Bool {
    let weapon = scriptInterface
      .GetTransactionSystem()
      .GetItemInSlot(scriptInterface.executionOwner, t"AttachmentSlots.WeaponRight") as WeaponObject;
    if IsDefined(weapon) {
      if scriptInterface
        .GetTransactionSystem()
        .HasTag(scriptInterface.executionOwner, n"Meleeware", weapon.GetItemID()) {
        return true;
      }
    }
    return false;
  }

  protected final func IsItemMeleeware(item: ItemID) -> Bool {
    let itemTags = TweakDBInterface.GetItemRecord(ItemID.GetTDBID(item)).Tags();
    return ArrayContains(itemTags, n"Meleeware");
  }

  public final func StopEffectOnHeldItems(scriptInterface: StateGameScriptInterface, effectName: CName) {
    let leftItem = scriptInterface
      .GetTransactionSystem()
      .GetItemInSlot(scriptInterface.executionOwner, t"AttachmentSlots.WeaponLeft");
    let rightItem = scriptInterface
      .GetTransactionSystem()
      .GetItemInSlot(scriptInterface.executionOwner, t"AttachmentSlots.WeaponRight");
    let killEffectEvent = new entKillEffectEvent();
    killEffectEvent.effectName = effectName;
    if IsDefined(leftItem) {
      leftItem.QueueEventToChildItems(killEffectEvent);
    } else if IsDefined(rightItem) {
      rightItem.QueueEventToChildItems(killEffectEvent);
    }
  }

  public final func BreakEffectLoopOnHeldItems(scriptInterface: StateGameScriptInterface, effectName: CName) {
    let leftItem = scriptInterface
      .GetTransactionSystem()
      .GetItemInSlot(scriptInterface.executionOwner, t"AttachmentSlots.WeaponLeft");
    let rightItem = scriptInterface
      .GetTransactionSystem()
      .GetItemInSlot(scriptInterface.executionOwner, t"AttachmentSlots.WeaponRight");
    let BreakEffectLoopEvent = new entBreakEffectLoopEvent();
    BreakEffectLoopEvent.effectName = effectName;
    if IsDefined(leftItem) {
      leftItem.QueueEventToChildItems(BreakEffectLoopEvent);
    } else if IsDefined(rightItem) {
      rightItem.QueueEventToChildItems(BreakEffectLoopEvent);
    }
  }

  protected final func SendDOFData(scriptInterface: StateGameScriptInterface, const dofSetting: script_ref<String>) {
    let dofAnimFeature = new AnimFeature_DOFControl();
    let prefix = "player." + dofSetting + ".";
    dofAnimFeature.dofIntensity = TweakDBInterface.GetFloat(TDBID.Create(prefix + "intensity"), 0.0);
    dofAnimFeature.dofNearBlur = TweakDBInterface.GetFloat(TDBID.Create(prefix + "nearBlur"), -1.0);
    dofAnimFeature.dofNearFocus = TweakDBInterface.GetFloat(TDBID.Create(prefix + "nearFocus"), -1.0);
    dofAnimFeature.dofFarBlur = TweakDBInterface.GetFloat(TDBID.Create(prefix + "farBlur"), -1.0);
    dofAnimFeature.dofFarFocus = TweakDBInterface.GetFloat(TDBID.Create(prefix + "farFocus"), -1.0);
    dofAnimFeature.dofBlendInTime = TweakDBInterface.GetFloat(TDBID.Create(prefix + "dofBlendInTime"), -1.0);
    dofAnimFeature.dofBlendOutTime = TweakDBInterface.GetFloat(TDBID.Create(prefix + "dofBlendOutTime"), -1.0);
    scriptInterface.SetAnimationParameterFeature(n"DOFControl", dofAnimFeature);
  }

  protected final func SetWeaponHolster(scriptInterface: StateGameScriptInterface, newState: Bool) {
    let weaponHolsterAnimFeature = new AnimFeature_PlayerCoverActionWeaponHolster();
    weaponHolsterAnimFeature.isWeaponHolstered = newState;
    scriptInterface
      .SetAnimationParameterFeature(n"PlayerCoverWeaponHolstered", weaponHolsterAnimFeature);
  }

  private final func ProcessWeaponSlotInput(
    scriptInterface: StateGameScriptInterface,
    actionName: CName,
    requestType: EquipmentManipulationAction
  ) -> Bool {
    if scriptInterface.IsActionJustTapped(actionName) {
      this
        .SendEquipmentSystemWeaponManipulationRequest(scriptInterface, requestType);
      return true;
    } else if scriptInterface.IsActionJustHeld(actionName) {
      this
        .SendEquipmentSystemWeaponManipulationRequest(scriptInterface, requestType, gameEquipAnimationType.FirstEquip);
      return true;
    }
    return false;
  }

  protected final func ProcessWeaponSlotInput(scriptInterface: StateGameScriptInterface) -> Bool {
    return this
      .ProcessWeaponSlotInput(
        scriptInterface,
        n"WeaponSlot1",
        EquipmentManipulationAction.RequestWeaponSlot1
      )
      || this
        .ProcessWeaponSlotInput(
          scriptInterface,
          n"WeaponSlot2",
          EquipmentManipulationAction.RequestWeaponSlot2
        )
      || this
        .ProcessWeaponSlotInput(
          scriptInterface,
          n"WeaponSlot3",
          EquipmentManipulationAction.RequestWeaponSlot3
        )
      || this
        .ProcessWeaponSlotInput(
          scriptInterface,
          n"WeaponSlot4",
          EquipmentManipulationAction.RequestWeaponSlot4
        );
  }

  protected final func CheckRangedAttackInput(scriptInterface: StateGameScriptInterface) -> Bool {
    return scriptInterface.IsActionJustPressed(n"RangedAttack") && !DefaultTransition.IsInteractingWithTerminal(scriptInterface);
  }

  protected final func CheckMeleeStatesForCombatGadget(scriptInterface: StateGameScriptInterface, stateContext: StateContext) -> Bool {
    let inQuickmelee = scriptInterface.localBlackboard.GetInt(GetAllBlackboardDefs().PlayerStateMachine.Weapon) == 3;
    if UpperBodyTransition.HasMeleeWeaponEquipped(scriptInterface) {
      return !stateContext.GetBoolParameter(n"isAttacking", true);
    }
    return !inQuickmelee;
  }
}

