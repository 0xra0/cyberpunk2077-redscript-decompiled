  protected final func HandleChainLightningEffectAndDamageTask(data: ScriptTaskData) {
    let closestEnemies: [ScriptedPuppet];
    let effectAndDamageEventData = data as EffectAndDamageEventData;
    if !IsDefined(effectAndDamageEventData) {
      return;
    }
    let hitevent = effectAndDamageEventData.hitevent;
    let threats = effectAndDamageEventData.threats;
    effectAndDamageEventData.effectorInstance.GetClosestEnemies(hitevent, threats, closestEnemies);
    effectAndDamageEventData.effectorInstance.SendEffectAndDamageToEnemies(hitevent, closestEnemies);
  }

