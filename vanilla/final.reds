class NetworkMinigameEndScreenController extends inkLogicController {
  protected let m_outcomeText: inkTextRef;
  protected let m_finishBarContainer: wref<NetworkMinigameProgramController>;
  protected let m_programsListContainer: inkWidgetRef;
  protected let m_programLibraryName: CName;
  protected let m_slotList: [wref<NetworkMinigameProgramController>];
  protected let m_endData: EndScreenData;
  protected let m_closeButton: inkWidgetRef;
  protected let header_bg: inkWidgetRef;
  protected let m_completionColor: Color;
  protected let m_failureColor: Color;

  public final func SetUp(const endData: script_ref<EndScreenData>) {
    this.m_endData = endData;
    if Equals(endData.outcome, OutcomeMessage.Success) {
      inkWidgetRef.SetTintColor(this.header_bg, this.m_completionColor);
      inkTextRef
        .SetText(
          this.m_outcomeText,
          "UI-Cyberpunk-Fullscreen-HackingMiniGame-AccessGranted"
        );
    } else {
      inkTextRef
        .SetText(
          this.m_outcomeText,
          "UI-Cyberpunk-Fullscreen-HackingMiniGame-AccessDenied"
        );
      inkWidgetRef.SetTintColor(this.header_bg, this.m_failureColor);
    }
    let i = 0;
    while i < ArraySize(endData.unlockedPrograms) {
      let slot = this
        .SpawnFromLocal(
          inkWidgetRef.Get(this.m_programsListContainer),
          this.m_programLibraryName
        );
      let slotLogic = slot.GetController() as NetworkMinigameProgramController;
      slotLogic.Spawn(endData.unlockedPrograms[i]);
      ArrayPush(this.m_slotList, slotLogic);
      i += 1;
    }
  }

  public final func GetCloseButtonRef() -> inkWidgetRef {
    return this.m_closeButton;
  }
}

