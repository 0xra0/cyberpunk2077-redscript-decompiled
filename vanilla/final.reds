class HitHistory extends IScriptable {
  private let m_hitHistory: [HitHistoryItem];
  private let m_maxEntries: Int32;

  public final func AddHit(evt: gameHitEvent) {
    let instigator = null;
    let attackType = gamedataAttackType.Invalid;
    if IsDefined(evt.attackData) {
      instigator = evt.attackData.GetInstigator();
      attackType = evt.attackData.GetAttackType();
    } else if IsDefined(instigator) {
      let hitTime = EngineTime.ToFloat(GameInstance.GetSimTime(instigator.GetGame()));
      this.Add(instigator, hitTime, attackType);
    }
  }

  public final func GetLastDamageTime(object: GameObject, out isMelee: Bool) -> Float {
    let i = 0;
    while i < ArraySize(this.m_hitHistory) {
      if this.m_hitHistory[i].instigator == object {
        isMelee = AttackData.IsMelee(this.m_hitHistory[i].attackType);
        return this.m_hitHistory[i].hitTime;
      }
      i += 1;
    }
    return -1.0;
  }

  public final func GetLastDamageType(instigator: GameObject) -> gamedataAttackType {
    let i = 0;
    while i < ArraySize(this.m_hitHistory) {
      if this.m_hitHistory[i].instigator == instigator {
        return this.m_hitHistory[i].attackType;
      }
      i += 1;
    }
    return gamedataAttackType.Invalid;
  }

  private final func Add(instigator: wref<GameObject>, hitTime: Float, attackType: gamedataAttackType) {
    let hitHistoryItem: HitHistoryItem;
    let oldestEntryTime = -1.0;
    let oldestEntryNdx = -1;
    let entryNdx = -1;
    let i = 0;
    if i < ArraySize(this.m_hitHistory) {
      if this.m_hitHistory[i].instigator == instigator {
        entryNdx = i;
      } else if oldestEntryTime == -1.0 || oldestEntryTime > this.m_hitHistory[i].hitTime {
        oldestEntryNdx = i;
        oldestEntryTime = this.m_hitHistory[i].hitTime;
      } else {
        i += 1;
      }
    }
    hitHistoryItem.instigator = instigator;
    hitHistoryItem.hitTime = hitTime;
    hitHistoryItem.attackType = attackType;
    if entryNdx == -1 {
      if ArraySize(this.m_hitHistory) < this.m_maxEntries {
        ArrayPush(this.m_hitHistory, hitHistoryItem);
      } else {
        this.m_hitHistory[oldestEntryNdx] = hitHistoryItem;
      }
    } else {
      this.m_hitHistory[entryNdx] = hitHistoryItem;
    }
  }
}

struct HitHistoryItem {
  public let instigator: wref<GameObject>;
  public let hitTime: Float;
  public let attackType: gamedataAttackType;
}

