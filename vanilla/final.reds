class AICommandHandlerBase extends AIbehaviortaskScript {
  protected let m_inCommand: AIArgumentMapping;

  protected func Update(context: ScriptExecutionContext) -> AIbehaviorUpdateOutcome {
    if !IsDefined(this.m_inCommand) {
      return AIbehaviorUpdateOutcome.FAILURE;
    }
    let rawCommand = ScriptExecutionContext.GetScriptableMappingValue(context, this.m_inCommand);
    if !IsDefined(rawCommand) {
      return AIbehaviorUpdateOutcome.FAILURE;
    }
    let typedCommand = rawCommand as AICommand;
    if !IsDefined(typedCommand) {
      return AIbehaviorUpdateOutcome.FAILURE;
    }
    return this.UpdateCommand(context, typedCommand);
  }

  protected func UpdateCommand(context: ScriptExecutionContext, command: AICommand) -> AIbehaviorUpdateOutcome {
    return AIbehaviorUpdateOutcome.FAILURE;
  }

  protected final func CheckArgument(argument: AIArgumentMapping, argName: CName) -> Bool {
    if !IsDefined(argument) {
      return false;
    }
    return true;
  }
}

class AIPatrolCommandPrologue extends AICommandHandlerBase {
  public let outPatrolPath: AIArgumentMapping;

  protected func UpdateCommand(context: ScriptExecutionContext, command: AICommand) -> AIbehaviorUpdateOutcome {
    let typedCommand = command as AIPatrolCommand;
    if !IsDefined(typedCommand) {
      return AIbehaviorUpdateOutcome.FAILURE;
    } else if !IsDefined(typedCommand.pathParams) {
      return AIbehaviorUpdateOutcome.FAILURE;
    } else if !ScriptExecutionContext
      .SetMappingValue(context, this.outPatrolPath, ToVariant(typedCommand.pathParams)) {
      return AIbehaviorUpdateOutcome.FAILURE;
    }
    return AIbehaviorUpdateOutcome.SUCCESS;
  }
}

