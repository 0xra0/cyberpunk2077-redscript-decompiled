class LocomotionBraindance extends LocomotionTransition {
  protected const final func CanEnterFastFlying(const stateContext: StateContext, const scriptInterface: StateGameScriptInterface) -> Bool {
    let minLinearVelocityThreshold = this.GetStaticFloatParameterDefault("minLinearVelocityThreshold", 0.5);
    let minStickInputThreshold = this.GetStaticFloatParameterDefault("minStickInputThreshold", 0.9);
    let enterAngleThreshold = this.GetStaticFloatParameterDefault("enterAngleThreshold", -180.0);
    if !scriptInterface.HasStatFlag(gamedataStatType.CanSprint) {
      return false;
    } else if !scriptInterface.IsMoveInputConsiderable()
      || AbsF(scriptInterface.GetInputHeading()) > enterAngleThreshold
      || DefaultTransition.GetMovementInputActionValue(stateContext, scriptInterface) <= minStickInputThreshold
      || scriptInterface.GetOwnerStateVectorParameterFloat(physicsStateValue.LinearSpeed) < minLinearVelocityThreshold {
      stateContext.SetConditionBoolParameter(n"SprintToggled", false, true);
      return false;
    } else if stateContext.GetConditionBool(n"SprintToggled") {
      return true;
    } else if scriptInterface.GetActionValue(n"ToggleSprint") > 0.0 {
      stateContext.SetConditionBoolParameter(n"SprintToggled", true, true);
    } else if scriptInterface.GetActionValue(n"Sprint") > 0.0 {
      return true;
    }
    return false;
  }

  protected final func OnDetach(const stateContext: StateContext, scriptInterface: StateGameScriptInterface) {
    scriptInterface.SetAnimationParameterFloat(n"crouch", 0.0);
  }
}

abstract class LookAtPresetBaseDecisions extends DefaultTransition {
  public const final func HasItemEquipped(const scriptInterface: StateGameScriptInterface) -> Bool {
    let equippedObject: ItemObject;
    let desiredTypeStr = this.GetStaticStringParameterDefault("itemType", "");
    let desiredItemType = IntEnum<gamedataItemType>(Cast<Int32>(EnumValueFromString("gamedataItemType", desiredTypeStr)));
    if this.GetStaticBoolParameterDefault("leftHandItem", false) {
      equippedObject = scriptInterface
        .GetTransactionSystem()
        .GetItemInSlot(scriptInterface.executionOwner, t"AttachmentSlots.WeaponLeft");
    } else {
      equippedObject = scriptInterface
        .GetTransactionSystem()
        .GetItemInSlot(scriptInterface.executionOwner, t"AttachmentSlots.WeaponRight");
    }
    if equippedObject == null {
      return false;
    }
    let equippedItemType = TweakDBInterface
      .GetItemRecord(ItemID.GetTDBID(equippedObject.GetItemID()))
      .ItemType()
      .Type();
    return Equals(desiredItemType, equippedItemType);
  }

  protected const func EnterCondition(const stateContext: StateContext, const scriptInterface: StateGameScriptInterface) -> Bool {
    if this.HasItemEquipped(scriptInterface) {
      return true;
    }
    return false;
  }

  protected const func ExitCondition(const stateContext: StateContext, const scriptInterface: StateGameScriptInterface) -> Bool {
    if !this.HasItemEquipped(scriptInterface) {
      return true;
    }
    return false;
  }
}

