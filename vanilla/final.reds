class PickUpDecisions extends CanTransitionToThrowDecisions {
  public const final func ToCarry(const stateContext: StateContext, const scriptInterface: StateGameScriptInterface) -> Bool {
    let toCarryStateDuration: Float;
    if this.ShouldThrow(scriptInterface) {
      return false;
    } else if this.GetFastModeParameter(stateContext) {
      toCarryStateDuration = this.GetStaticFloatParameterDefault("toCarryStateDurationFastMode", 1.0);
    }
    toCarryStateDuration = this.GetStaticFloatParameterDefault("toCarryStateDuration", 1.0);
    return !stateContext.GetConditionBool(n"CarriedObjectPlayPickUp") || this.GetInStateTime() > toCarryStateDuration;
  }

  public final func ToAim(const stateContext: StateContext, const scriptInterface: StateGameScriptInterface) -> Bool {
    if !this.ShouldThrow(scriptInterface) {
      return false;
    } else if this.ValidThrowNPCActionReleased(stateContext, scriptInterface) || !this.IsPlayerCombatAllowed(scriptInterface) {
      return false;
    } else if this.GetInStateTime() < this.GetStaticFloatParameterDefault("toAimStateDuration", 1.0) {
      return false;
    }
    return true;
  }

  public final func ToThrow(const stateContext: StateContext, const scriptInterface: StateGameScriptInterface) -> Bool {
    if !this.ShouldThrow(scriptInterface) {
      return false;
    } else if !this.ValidThrowNPCActionReleased(stateContext, scriptInterface) && this.IsPlayerCombatAllowed(scriptInterface) {
      return false;
    } else if this.GetInStateTime() < this.GetStaticFloatParameterDefault("toThrowStateDuration", 1.0) {
      return false;
    }
    return true;
  }

  private const final func ShouldThrow(const scriptInterface: StateGameScriptInterface) -> Bool {
    if !StatusEffectSystem
      .ObjectHasStatusEffect(scriptInterface.owner, t"BaseStatusEffect.ThrownNPC") {
      return false;
    }
    return true;
  }
}

class SwimmingForceFreezeDecisions extends LocomotionSwimming {
  protected const final func EnterCondition(const stateContext: StateContext, const scriptInterface: StateGameScriptInterface) -> Bool {
    return this.IsFreezeForced(stateContext);
