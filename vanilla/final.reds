  }

  protected const final func GetControllerPersistentState() -> PersistentState {
    let psID = this.GetVehicleComponent().GetPersistentID();
    if PersistentID.IsDefined(psID) {
      return GameInstance
        .GetPersistencySystem(this.GetGame())
        .GetConstAccessToPSObject(psID, this.GetVehicleComponent().GetPSName());
    }
    return null;
  }

