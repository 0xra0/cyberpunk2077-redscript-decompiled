  private final func RetrofixHolsteredArms() {
    let slotID = t"AttachmentSlots.WeaponRight";
    let ts = GameInstance.GetTransactionSystem(this.GetGameInstance());
    let i = 0;
    while i < ArraySize(this.m_ownerData) {
      let player = this.m_ownerData[i].GetOwner() as PlayerPuppet;
      if !IsDefined(player) {
      } else {
        let activeItemID = ts.GetActiveItemInSlot(player, slotID);
        let armsItemID = this.m_ownerData[i].GetActiveItem(gamedataEquipmentArea.ArmsCW);
        if ItemID.IsValid(armsItemID) {
          if activeItemID != armsItemID {
            EquipmentSystemPlayerData.UpdateArmSlot(player, armsItemID, true);
          }
        } else {
          armsItemID = this.m_ownerData[i].GetActiveItem(gamedataEquipmentArea.BaseFists);
          if ItemID.IsValid(armsItemID) && activeItemID != armsItemID {
            EquipmentSystemPlayerData.UpdateArmSlot(player, armsItemID, true);
          }
        }
      }
      i += 1;
    }
  }

