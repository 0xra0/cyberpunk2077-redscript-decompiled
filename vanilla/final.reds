abstract class AISubActionHitData_Record_Implementation extends IScriptable {
  public final static func GetAnimVariation(context: ScriptExecutionContext, record: wref<AISubActionHitData_Record>) -> Int32 {
    let object: wref<GameObject>;
    let backDirection: Int32;
    let animVariation = -1;
    let hitData = (ScriptExecutionContext.GetOwner(context) as ScriptedPuppet).GetHitReactionComponent().GetLastHitReactionData();
    if !IsDefined(hitData) {
      return -1;
    } else if record.OverrideHitDirection() {
      if AIActionTarget.GetObject(context, record.DirectionObj(), object) {
        let newDirection = GameObject
          .GetTargetAngleInInt(object, ScriptExecutionContext.GetOwner(context), backDirection);
      }
      switch hitData.hitBodyPart {
        case 1:
          switch hitData.hitDirection {
            case 1:
              if newDirection == 1 {
                animVariation = 24;
              } else if newDirection == 2 {
                if backDirection == 1 {
                  animVariation = 1;
                }
                animVariation = 0;
              } else if newDirection == 3 {
                animVariation = 26;
              }
              animVariation = 3;
            case 2:
              if newDirection == 1 {
                animVariation = 24;
              } else if newDirection == 2 {
                if backDirection == 1 {
                  animVariation = 1;
                }
                animVariation = 0;
              } else if newDirection == 3 {
                animVariation = 26;
              }
              animVariation = 3;
            case 3:
              if newDirection == 1 {
                animVariation = 24;
              } else if newDirection == 2 {
                if backDirection == 1 {
                  animVariation = 1;
                }
                animVariation = 0;
              } else if newDirection == 3 {
                animVariation = 26;
              }
              animVariation = 3;
            case 4:
              if newDirection == 1 {
                animVariation = 24;
              } else if newDirection == 2 {
                if backDirection == 1 {
                  animVariation = 1;
                }
                animVariation = 0;
              } else if newDirection == 3 {
                animVariation = 26;
              }
              animVariation = 3;
          }
          return -1;
      }
    }
  }
}

