    this.ErasePassedSkillchecks();
    this.TryInitializeSkillChecks();
    if this.IsDisabled() {
      this.ForceDeviceON();
    }
  }

  protected final func AccessGrantedNotification() {
    let notification = new AuthorisationNotificationEvent();
    let player = this.GetPlayerMainObject() as PlayerPuppet;
    notification.type = gameuiAuthorisationNotificationType.AccessGranted;
    player.QueueEvent(notification);
  }

  public func OnSetAuthorizationModuleOFF(evt: SetAuthorizationModuleOFF) -> EntityNotificationType {
    super.OnSetAuthorizationModuleOFF(evt);
    this.ResolveOtherSkillchecks();
    if !this.IsSealed() {
      this.SetIsLocked(false);
      this.SetIsOpened(true);
    }
    this.UseNotifier(evt);
    return EntityNotificationType.SendPSChangedEventToEntity;
  }

  public final func ActionUnauthorized() -> PlayerUnauthorized {
    let action = new PlayerUnauthorized();
    action.clearanceLevel = 2;
    action.SetUp(this);
    action.SetProperties(this.m_isLiftDoor);
    action.AddDeviceName(this.m_deviceName);
    action.CreateInteraction(this);
    return action;
  }

  protected final func ResolveTerminalSkillchecks(id: EntityID) {
    let parents: [DeviceComponentPS];
    let evt = new ResolveSkillchecksEvent();
    this.GetParents(parents);
    let i = 0;
    while i < ArraySize(parents) {
      if IsDefined(parents[i] as TerminalControllerPS) && parents[i].GetMyEntityID() != id {
        this
          .GetPersistencySystem()
          .QueuePSEvent(parents[i].GetID(), parents[i].GetClassName(), evt);
      }
      i += 1;
    }
  }

  public final func OnQuickHackToggleOpen(evt: QuickHackToggleOpen) -> EntityNotificationType {
    let notifier = new ActionNotifier();
    notifier.SetNone();
    this.TurnAuthorizationModuleOFF();
    if this.IsOpen() {
      let actionClose = this.ActionToggleOpen();
      actionClose.SetExecutor(evt.GetExecutor());
      actionClose.RegisterAsRequester(PersistentID.ExtractEntityID(this.GetID()));
      this.GetPersistencySystem().QueuePSDeviceEvent(actionClose);
    } else {
      this.ExecuteForceOpen(evt.GetExecutor());
    }
    this.Notify(notifier, evt);
    return EntityNotificationType.DoNotNotifyEntity;
  }

  protected func OnActivateDevice(evt: ActivateDevice) -> EntityNotificationType {
    super.OnActivateDevice(evt);
    if this.IsUnpowered() {
      this.SetDeviceState(EDeviceStatus.ON);
    }
    this.UseNotifier(evt);
    return EntityNotificationType.SendThisEventToEntity;
  }

  public func OnAuthorizeUser(evt: AuthorizeUser) -> EntityNotificationType {
    let wasAuthorized: Bool;
    let notifier = new ActionNotifier();
    notifier.SetNone();
    if evt.IsForced() {
      this.GiveKeycardsToExecutor(evt.GetExecutor());
    } else if evt.GetRequesterID()
      == this.GetMyEntityID()
      && this
        .MasterUserAuthorizationAttempt(evt.GetExecutor().GetEntityID(), evt.GetEnteredPassword()) {
      wasAuthorized = true;
    } else if this
      .UserAuthorizationAttempt(evt.GetExecutor().GetEntityID(), evt.GetEnteredPassword(), evt.GetExecutor()) {
      wasAuthorized = true;
    } else if wasAuthorized {
      if !evt.IsForced() {
        this.GiveKeycardsToExecutor(evt.GetExecutor());
      } else if this.IsLocked() {
        let actionLock = this.ActionToggleLock();
        actionLock.SetExecutor(evt.GetExecutor());
        actionLock.RegisterAsRequester(this.GetMyEntityID());
        this.GetPersistencySystem().QueuePSDeviceEvent(actionLock);
      }
      let actionOpen = this.ActionToggleOpen();
      actionOpen.SetExecutor(evt.GetExecutor());
      actionOpen.RegisterAsRequester(this.GetMyEntityID());
      this.GetPersistencySystem().QueuePSDeviceEvent(actionOpen);
      this.ResolveOtherSkillchecks();
    }
    this.Notify(notifier, evt);
    return EntityNotificationType.SendThisEventToEntity;
  }

  public const func CanPayToAuthorize() -> Bool {
    return this.CanPayToUnlock();
  }

  public const func IsUserAuthorized(user: EntityID) -> Bool {
    if this.IsLocked() {
      if this.IsDeviceSecured() && this.IsTriggerValid(this.GetDoorAuthorizationSide()) {
        return super.IsUserAuthorized(user);
      }
      if this.m_doorProperties.m_canPlayerToggleLockState {
        return true;
      }
      return false;
    }
    if this.IsTriggerValid(this.GetDoorAuthorizationSide()) {
      return super.IsUserAuthorized(user);
    }
    return true;
  }

  public final func RequiresAuthorization() -> Bool {
    if this.IsDeviceSecured()
      && this.IsTriggerValid(this.GetDoorAuthorizationSide())
      && this.IsUserAuthorized(GetPlayerObject(this.GetGameInstance()).GetEntityID()) {
      return true;
    }
    return false;
  }

  public final func UpdatePlayerAuthorization() {
    this.m_isPlayerAuthorised = this.IsUserAuthorized(this.GetPlayerEntityID());
  }

  public final func WasPlayerAuthorized() -> Bool {
    return this.m_isPlayerAuthorised;
  }

  private final func ToggleOpenOnDoor() -> Bool {
    if this.IsSealed() || this.IsLocked() {
      return false;
    } else if this.IsLogicallyClosed() {
      this.SetIsOpened(true);
      return true;
    }
    break;
    this.SetIsOpened(false);
    return true;
  }

  private final func ToggleLockOnDoor() -> Bool {
    if this.IsSealed() {
      return false;
    } else if this.IsLocked() {
      this.SetIsLocked(false);
      return true;
    }
    break;
    this.SetIsLocked(true);
    return true;
  }

  private final func ToggleSealOnDoor() -> Bool {
    if this.IsSealed() {
      this.SetIsSealed(false);
      return true;
    }
    this.SetIsSealed(true);
    return true;
  }

  protected func ShouldForceAuthorizeUser(const context: script_ref<GetActionsContext>) -> Bool {
    return super.ShouldForceAuthorizeUser(context)
      || Equals(context.requestType, gamedeviceRequestType.External) && this.canPlayerRemotelyAuthorize();
  }

  private final func GiveKeycardsToExecutor(executor: GameObject) {
    let transaction = GameInstance.GetTransactionSystem(this.GetGameInstance());
    if transaction != null && executor != null {
      let keycards = this.GetKeycards();
      let i = 0;
      while i < ArraySize(keycards) {
        let item = ItemID.FromTDBID(keycards[i]);
        if !transaction.HasItem(executor, item) {
          transaction.GiveItem(executor, item, 1);
        }
        i += 1;
      }
    }
  }

  protected final func AddToken(id: EntityID) -> Bool {
    if !EntityID.IsDefined(id) {
      return false;
    } else if ArrayContains(this.m_openingTokens, id) {
      return false;
    }
    ArrayPush(this.m_openingTokens, id);
    return true;
  }

  public final func DepleteToken(id: EntityID) -> Bool {
    if !EntityID.IsDefined(id) {
      return false;
    }
    return ArrayRemove(this.m_openingTokens, id);
  }
}

struct DoorSetup {
  public persistent let m_doorType: EDoorType;
  public persistent let m_doorTypeSideOne: EDoorType;
  public persistent let m_doorTypeSideTwo: EDoorType;
  public let m_skillCheckSide: EDoorSkillcheckSide;
  public let m_authorizationSide: EDoorSkillcheckSide;
  public let m_doorTriggerSide: EDoorTriggerSide;
  public persistent let m_isShutter: Bool;
  public persistent let m_initialDoorState: EDoorStatus;
  public persistent let m_canPlayerToggleLockState: Bool;
  public persistent let m_canPlayerToggleSealState: Bool;
  public persistent let m_canPlayerRemotelyAuthorize: Bool;
  public persistent let m_automaticallyClosesItself: Bool;
  public let m_openingSpeed: Float;
  public let m_doorOpeningTime: Float;
  public let m_doorOpeningStimRange: Float;
  public persistent let m_canPayToUnlock: Bool;
  public persistent let m_paymentRecordID: TweakDBID;
  public let m_exposeQuickHacksIfNotConnectedToAP: Bool;
}

class TerminalControllerPS extends MasterControllerPS {
  private persistent let m_terminalSetup: TerminalSetup;
  private let m_terminalSkillChecks: HackEngContainer;
  protected let m_spawnedSystems: [VirtualSystemPS];
  private let m_useKeyloggerHack: Bool;
  protected let m_shouldShowTerminalTitle: Bool;
  protected let m_defaultGlitchVideoPath: ResRef;
  protected let m_broadcastGlitchVideoPath: ResRef;
  protected persistent let m_state: gameinteractionsReactionState;
  protected persistent let m_forcedElevatorArrowsState: EForcedElevatorArrowsState;

  protected cb func OnInstantiated() -> Bool {
    super.OnInstantiated();
    if !IsStringValid(this.m_deviceName) {
      this.m_deviceName = "Gameplay-Devices-DisplayNames-Terminal";
    }
  }

  protected func GameAttached();

  protected func GetSkillCheckContainerForSetup() -> BaseSkillCheckContainer {
    return this.m_terminalSkillChecks;
  }

  protected func LogicReady() {
    this.InitializeVirtualSystems();
    super.LogicReady();
  }

  private final func InitializeVirtualSystems_Test() {
    let i: Int32;
    let systemsData: [DeviceCounter];
    let data: DeviceCounter;
    if !this.m_terminalSetup.m_shouldForceVirtualSystem {
      return;
    }
    let devices = this.GetImmediateSlaves();
    while ArraySize(devices) > 0 {
      i = ArraySize(devices) - 1;
      if this.GetMatchingVirtualSystemsData(devices[i], devices, data) {
        ArrayPush(systemsData, data);
        let k = ArraySize(data.devices) - 1;
        while k >= 0 {
          ArrayRemove(devices, data.devices[k]);
          k -= 1;
        }
      } else {
        ArrayErase(devices, i);
      }
    }
    i = 0;
    while i < ArraySize(systemsData) {
      if Equals(systemsData[i].systemType, EVirtualSystem.SurveillanceSystem) {
        this.SpawnSurveillanceSystemUI(systemsData[i].devices);
      } else if Equals(systemsData[i].systemType, EVirtualSystem.SecuritySystem) {
        this.SpawnSecuritySystemUI(systemsData[i].devices);
      } else if Equals(systemsData[i].systemType, EVirtualSystem.DoorSystem) {
        this.SpawnDoorSystemUI(systemsData[i].devices);
      } else if Equals(systemsData[i].systemType, EVirtualSystem.MediaSystem) {
        this.SpawnMediaSystemUI(systemsData[i].devices);
      }
      i += 1;
    }
  }

  private final func InitializeVirtualSystems() {
    let i: Int32;
    let systemsData: [DeviceCounter];
    let data: DeviceCounter;
    if !this.m_terminalSetup.m_shouldForceVirtualSystem {
      return;
    }
    let devices = this.GetImmediateSlaves();
    while ArraySize(devices) > 0 {
      i = ArraySize(devices) - 1;
      if this.GetMatchingVirtualSystemsData(devices[i], devices, data) {
        ArrayPush(systemsData, data);
        let k = ArraySize(data.devices) - 1;
        while k >= 0 {
          ArrayRemove(devices, data.devices[k]);
          k -= 1;
        }
      } else {
        ArrayErase(devices, i);
      }
    }
    i = 0;
    while i < ArraySize(systemsData) {
      if Equals(systemsData[i].systemType, EVirtualSystem.SurveillanceSystem) {
        this.SpawnSurveillanceSystemUI(systemsData[i].devices);
      } else if Equals(systemsData[i].systemType, EVirtualSystem.SecuritySystem) {
        this.SpawnSecuritySystemUI(systemsData[i].devices);
      } else if Equals(systemsData[i].systemType, EVirtualSystem.DoorSystem) {
        this.SpawnDoorSystemUI(systemsData[i].devices);
      } else if Equals(systemsData[i].systemType, EVirtualSystem.MediaSystem) {
        this.SpawnMediaSystemUI(systemsData[i].devices);
      }
      i += 1;
    }
  }

  protected const func GetClearance() -> Clearance {
    return Clearance
      .CreateClearance(this.m_terminalSetup.m_minClearance, this.m_terminalSetup.m_maxClearance);
  }

  public const final func ShouldShowTerminalTitle() -> Bool {
    return this.m_shouldShowTerminalTitle;
  }

  public const final func GetDefaultGlitchVideoPath() -> ResRef {
    return this.m_defaultGlitchVideoPath;
  }

  public const final func GetBroadcastGlitchVideoPath() -> ResRef {
    if ResRef.IsValid(this.m_broadcastGlitchVideoPath) {
      return this.m_broadcastGlitchVideoPath;
    }
    return r"base\\movies\\misc\\distraction_generic.bk2";
  }

  protected const func GenerateContext(
    requestType: gamedeviceRequestType,
    providedClearance: Clearance,
    opt providedProcessInitiator: GameObject,
    opt providedRequestor: EntityID
  ) -> GetActionsContext {
    let generatedContext = super
      .GenerateContext(
        requestType,
        providedClearance,
        providedProcessInitiator,
        providedRequestor
      );
    generatedContext.ignoresAuthorization = this.m_terminalSetup.m_ignoreSlaveAuthorizationModule;
    generatedContext.allowsRemoteAuthorization = this.m_terminalSetup.m_allowRemoteAuthorization;
    return generatedContext;
  }

  private final func GetMatchingVirtualSystemsData(
    device: DeviceComponentPS,
    const listToCheck: script_ref<[DeviceComponentPS]>,
    data: script_ref<DeviceCounter>
  ) -> Bool {
    if device == null {
      return false;
    }
    let returnValue = false;
    let type = device.GetVirtualSystemType();
    if NotEquals(type, EVirtualSystem.None) {
      data.systemType = type;
      let i = 0;
      while i < ArraySize(listToCheck) {
        if device == listToCheck[i] {
        } else if Equals(listToCheck[i].GetVirtualSystemType(), type) {
          ArrayPush(data.devices, listToCheck[i]);
          returnValue = true;
        }
        i += 1;
      }
    } else if returnValue {
      ArrayPush(data.devices, device);
    }
    return returnValue;
  }

  private final func HasMatchingVirtualSystemType(
    device: DeviceComponentPS,
    const listToCheck: script_ref<[DeviceComponentPS]>,
    out type: EVirtualSystem
  ) -> Bool {
    if device == null {
      return false;
    }
    type = device.GetVirtualSystemType();
    if NotEquals(type, EVirtualSystem.None) {
      let i = 0;
      while i < ArraySize(listToCheck) {
        if device == listToCheck[i] {
        } else if Equals(listToCheck[i].GetVirtualSystemType(), type) {
          return true;
        }
        i += 1;
      }
    }
    return false;
  }

  public const final func HasAnyVirtualSystem() -> Bool {
    return ArraySize(this.m_spawnedSystems) > 0;
  }

  public const final func GetVirtualSystemsCount() -> Int32 {
    return ArraySize(this.m_spawnedSystems);
  }

  public const final func IsPartOfAnyVirtualSystem(slave: DeviceComponentPS) -> Bool {
    let vs: VirtualSystemPS;
    return this.GetVirtualSystem(slave, vs);
  }

  public const final func IsPartOfAnyVirtualSystem(slaveID: PersistentID) -> Bool {
    let vs: VirtualSystemPS;
    return this.GetVirtualSystem(slaveID, vs);
  }

  public const func GetVirtualSystem(slave: DeviceComponentPS, out vs: VirtualSystemPS) -> Bool {
    let i = 0;
    while i < ArraySize(this.m_spawnedSystems) {
      if this.m_spawnedSystems[i].IsPartOfSystem(slave) {
        vs = this.m_spawnedSystems[i];
        return true;
      }
      i += 1;
    }
    return false;
  }

  public const func GetVirtualSystem(id: PersistentID, out vs: VirtualSystemPS) -> Bool {
    let i = 0;
    while i < ArraySize(this.m_spawnedSystems) {
      if Equals(id, this.m_spawnedSystems[i].GetID()) || this.m_spawnedSystems[i].IsPartOfSystem(id) {
        vs = this.m_spawnedSystems[i];
        return true;
      }
      i += 1;
    }
    return false;
  }

  public func GetSlaveDeviceWidget(deviceID: PersistentID) -> SDeviceWidgetPackage {
    let vs: VirtualSystemPS;
    if this.GetVirtualSystem(deviceID, vs) {
      return vs
        .GetDeviceWidget(this.GenerateContext(gamedeviceRequestType.External, this.GetClearance()));
    }
    return super.GetSlaveDeviceWidget(deviceID);
  }

  public func GetDeviceWidgets() -> [SDeviceWidgetPackage] {
    let widgetsData: [SDeviceWidgetPackage];
    if !this.HasAnyVirtualSystem() {
      return super.GetDeviceWidgets();
    }
    let i = 0;
    while i < ArraySize(this.m_spawnedSystems) {
      this
        .m_spawnedSystems[i]
        .GetDeviceWidget(
          this.GenerateContext(gamedeviceRequestType.External, this.GetClearance()),
          widgetsData
        );
      i += 1;
    }
    let devices = this.GetImmediateSlaves();
    i = 0;
    while i < ArraySize(devices) {
      if this.IsPartOfAnyVirtualSystem(devices[i]) {
      } else {
        let currentWidget = devices[i]
          .GetDeviceWidget(
            this.GenerateContext(gamedeviceRequestType.External, this.GetClearance())
          );
        if currentWidget.isValid {
          ArrayPush(
            widgetsData,
            devices[i]
              .GetDeviceWidget(
                this
                  .GenerateContext(gamedeviceRequestType.External, this.GetClearance())
              )
          );
        }
      }
      i += 1;
    }
    return widgetsData;
  }

  public func GetThumbnailWidgets() -> [SThumbnailWidgetPackage] {
    let widgetsData: [SThumbnailWidgetPackage];
    if !this.HasAnyVirtualSystem() {
      return super.GetThumbnailWidgets();
    }
    let i = 0;
    while i < ArraySize(this.m_spawnedSystems) {
      ArrayPush(widgetsData, this.m_spawnedSystems[i].GetThumbnailWidget());
      i += 1;
    }
    let devices = this.GetImmediateSlaves();
    i = 0;
    while i < ArraySize(devices) {
      if Equals(devices[i].GetID(), this.GetID()) {
      } else if this.IsPartOfAnyVirtualSystem(devices[i]) {
      } else {
        let currentWidget = devices[i].GetThumbnailWidget();
        if currentWidget.isValid {
          ArrayPush(widgetsData, currentWidget);
        }
      }
      i += 1;
    }
    return widgetsData;
  }

  private final func SpawnSurveillanceSystemUI(const slavesToConnect: script_ref<[DeviceComponentPS]>) {
    let virtualSystem = SpawnVirtualPS(
      this.GetGameInstance(),
      this.GetMyEntityID(),
      n"virtualPS",
      n"SurveillanceSystemUIPS"
    ) as SurveillanceSystemUIPS;
    if IsDefined(virtualSystem) {
      virtualSystem.Initialize(slavesToConnect, this);
      ArrayPush(this.m_spawnedSystems, virtualSystem);
    }
  }

  private final func SpawnSecuritySystemUI(const slavesToConnect: script_ref<[DeviceComponentPS]>) {
    let virtualSystem = SpawnVirtualPS(
      this.GetGameInstance(),
      this.GetMyEntityID(),
      n"virtualPS",
      n"SecuritySystemUIPS"
    ) as SecuritySystemUIPS;
    if IsDefined(virtualSystem) {
      virtualSystem.Initialize(slavesToConnect, this);
      ArrayPush(this.m_spawnedSystems, virtualSystem);
    }
  }

  private final func SpawnDoorSystemUI(const slavesToConnect: script_ref<[DeviceComponentPS]>) {
    let virtualSystem = SpawnVirtualPS(this.GetGameInstance(), this.GetMyEntityID(), n"virtualPS", n"DoorSystemUIPS") as DoorSystemUIPS;
    if IsDefined(virtualSystem) {
      virtualSystem.Initialize(slavesToConnect, this);
      ArrayPush(this.m_spawnedSystems, virtualSystem);
    }
  }

  private final func SpawnMediaSystemUI(const slavesToConnect: script_ref<[DeviceComponentPS]>) {
    let virtualSystem = SpawnVirtualPS(this.GetGameInstance(), this.GetMyEntityID(), n"virtualPS", n"DoorSystemUIPS") as MediaSystemUIPS;
    if IsDefined(virtualSystem) {
      virtualSystem.Initialize(slavesToConnect, this);
      ArrayPush(this.m_spawnedSystems, virtualSystem);
    }
