abstract class BraindanceControlsTransition extends DefaultTransition {
  protected const final func SetBraindaneVisionModeBB(const scriptInterface: StateGameScriptInterface, newMode: braindanceVisionMode) {
    let BraindanceBB = scriptInterface.GetBlackboardSystem().Get(GetAllBlackboardDefs().Braindance);
    BraindanceBB
      .SetInt(
        GetAllBlackboardDefs().Braindance.activeBraindanceVisionMode,
        EnumInt(newMode),
        true
      );
  }

  protected const final func SetLastBraindanceVisionMode(const scriptInterface: StateGameScriptInterface, newMode: braindanceVisionMode) {
    let BraindanceBB = scriptInterface.GetBlackboardSystem().Get(GetAllBlackboardDefs().Braindance);
    BraindanceBB
      .SetInt(
        GetAllBlackboardDefs().Braindance.lastBraindanceVisionMode,
        EnumInt(newMode),
        true
      );
  }

  protected const final func SetBraindanceVisionFact(const scriptInterface: StateGameScriptInterface, newMode: braindanceVisionMode) {
    scriptInterface.GetQuestsSystem().SetFact(n"braindanceVisionMode", EnumInt(newMode));
  }

  protected const final func SetCachedPlaySpeedPermVariable(scriptInterface: StateGameScriptInterface, stateContext: StateContext) {
    stateContext
      .SetPermanentIntParameter(
        n"cachedPlaySpeed",
        EnumInt(
          this
            .GetSceneSystemInterface(scriptInterface)
            .GetRewindableSectionPlaySpeed()
        ),
        true
      );
  }

  protected const final func SetPlaybackSpeedInBlackboard(const scriptInterface: StateGameScriptInterface, speed: scnPlaySpeed) {
    let BraindanceBB = scriptInterface.GetBlackboardSystem().Get(GetAllBlackboardDefs().Braindance);
    BraindanceBB
      .SetVariant(GetAllBlackboardDefs().Braindance.PlaybackSpeed, ToVariant(speed), true);
  }

  protected const final func SetPlaybackDirectionInBlackboard(const scriptInterface: StateGameScriptInterface, direction: scnPlayDirection) {
    let BraindanceBB = scriptInterface.GetBlackboardSystem().Get(GetAllBlackboardDefs().Braindance);
    BraindanceBB
      .SetVariant(
        GetAllBlackboardDefs().Braindance.PlaybackDirection,
