native class gameEffectExecutor_KatanaBulletBending extends EffectExecutor_Scripted {
  public final native func SpawnFX(
    tag: CName,
    object: GameObject,
    from: Vector4,
    to: Vector4,
    attachSlotName: CName
  );

  public final func Process(ctx: EffectScriptContext, target: Entity, hitPosition: Vector4) {
    let hitDirection: Vector4;
    let weapon = target as Katana;
    EffectData
      .GetVector(
        EffectScriptContext.GetSharedData(ctx),
        GetAllBlackboardDefs().EffectSharedData.forward,
        hitDirection
      );
    if IsDefined(weapon) {
      this.SpawnRicochet(weapon, hitPosition, hitDirection);
      EffectData
        .SetVector(
          EffectScriptContext.GetSharedData(ctx),
          GetAllBlackboardDefs().EffectSharedData.raycastEnd,
          hitPosition
        );
    }
  }

  private final func SpawnRicochet(katana: Katana, out hitPosition: Vector4, hitDirection: Vector4) {
    let slotTransform: WorldTransform;
    let ricochetDirectionLocal: Vector4;
    let itemRecordPath = ItemID.GetTDBID(katana.GetItemID());
    let slotName = TweakDBInterface.GetCName(itemRecordPath + t".magneticFieldSlotName", n"None");
    let ricochetReferenceOffset = TweakDBInterface.GetFloat(itemRecordPath + t".bulletRicochetReferenceOffset", 0.0);
    let ricochetBendFactor = TweakDBInterface.GetFloat(itemRecordPath + t".bulletRicochetBendFactor", 1.0);
    let bladeLength = TweakDBInterface.GetFloat(itemRecordPath + t".bladeLength", 1.0);
    let ricochetLocalY = TweakDBInterface.GetFloat(itemRecordPath + t".ricochetLocalY", -0.5);
    let ricochetLocalZOffsetMax = TweakDBInterface.GetFloat(itemRecordPath + t".ricochetLocalZOffsetMax", 0.1);
    let hitPositionLogicalLocalOffset = TweakDBInterface
      .GetVector3(itemRecordPath + t".hitPositionLogicalLocalOffset", new Vector3(0.0, 0.0, 0.0));
    let hitPositionVisualLocalOffset = TweakDBInterface
      .GetVector3(itemRecordPath + t".hitPositionVisualLocalOffset", new Vector3(0.0, 0.0, 0.0));
    katana.GetSlotComponent().GetSlotTransform(slotName, slotTransform);
    let playerOrientation = GetPlayer(GetGameInstance()).GetWorldOrientation();
    WorldTransform.SetOrientation(slotTransform, playerOrientation);
    let hitPositionLocal = WorldPosition
      .ToVector4(
        WorldTransform.TransformPoint(WorldTransform.GetInverse(slotTransform), hitPosition)
      );
    hitPositionLocal.X = SgnF(hitPositionLocal.X) * 0.01;
    hitPositionLocal.Y = 0.0;
    hitPositionLocal.Z = ClampF(
      hitPositionLocal.Z + RandNoiseF(0, ricochetLocalZOffsetMax),
      -bladeLength * 0.5,
      bladeLength * 0.5
    );
    hitPositionLocal
      += new Vector4(
        hitPositionLogicalLocalOffset.X,
        hitPositionLogicalLocalOffset.Y,
        hitPositionLogicalLocalOffset.Z,
        0.0
      );
    ricochetDirectionLocal.X = hitPositionLocal.X;
    ricochetDirectionLocal.Y = ricochetLocalY;
    ricochetDirectionLocal.Z = (hitPositionLocal.Z + ricochetReferenceOffset) * ricochetBendFactor;
    let ricochetDirection = Vector4
      .Normalize(
        Transform
          .TransformVector(WorldTransform._ToXForm(slotTransform), ricochetDirectionLocal)
      );
    hitPositionLocal
      += new Vector4(
        hitPositionVisualLocalOffset.X,
        hitPositionVisualLocalOffset.Y,
        hitPositionVisualLocalOffset.Z,
        0.0
      );
    hitPosition = WorldPosition.ToVector4(WorldTransform.TransformPoint(slotTransform, hitPositionLocal));
    this.SpawnRicochetFx(katana, hitPosition, ricochetDirection, slotName);
  }

  private final func SpawnBeamSpark(
    katana: Katana,
    bladeTransform: Transform,
    hitPosition: Vector4,
    slotName: CName
  ) {
    let bladePositionOffsetMax = TweakDBInterface
      .GetFloat(ItemID.GetTDBID(katana.GetItemID()) + t".bladePositionOffsetMax", 0.0);
    let bladeLength = TweakDBInterface.GetFloat(ItemID.GetTDBID(katana.GetItemID()) + t".bladeLength", 1.0);
    let hitPositionLocal = Transform.TransformPoint(Transform.GetInverse(bladeTransform), hitPosition);
    hitPositionLocal.X = 0.0;
    hitPositionLocal.Y = 0.0;
    hitPositionLocal.Z += RandNoiseF(0, bladePositionOffsetMax, -bladePositionOffsetMax);
    hitPositionLocal.Z = ClampF(hitPositionLocal.Z, -bladeLength * 0.5, bladeLength * 0.5);
    let positionOnBlade = Transform.TransformPoint(bladeTransform, hitPositionLocal);
    this.SpawnFX(n"lightning", katana, positionOnBlade, hitPosition, slotName);
  }

  private final func SpawnRicochetFx(katana: Katana, position: Vector4, direction: Vector4, slotName: CName) {
    let targetPosition = position + Vector4.Normalize(direction) * 50.0;
    this.SpawnFX(n"sparks", katana, position, targetPosition, slotName);
    this.SpawnFX(n"trail", katana, position, targetPosition, slotName);
  }
}

