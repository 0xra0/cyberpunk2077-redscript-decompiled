class EntityAttachementComponentPS extends GameComponentPS {
  private persistent let m_pendingChildAttachements: [EntityAttachementData];

  private const final func GetMyEntityID() -> EntityID {
    return PersistentID.ExtractEntityID(this.GetID());
  }

  private const final func GetOwnerEntityWeak() -> wref<Entity> {
    return GameInstance.FindEntityByID(this.GetGameInstance(), this.GetMyEntityID());
  }

  public const final func GetPendingChildAttachementsData() -> [EntityAttachementData] {
    return this.m_pendingChildAttachements;
  }

  private final func OnChildAttachementRequest(evt: EntityAttachementRequestEvent) -> EntityNotificationType {
    if this.GetOwnerEntityWeak() == null {
      this.AddPendingChildAttachementRequest(evt.attachementData);
      return EntityNotificationType.DoNotNotifyEntity;
    }
    return EntityNotificationType.SendThisEventToEntity;
  }

  private final func AddPendingChildAttachementRequest(const data: script_ref<EntityAttachementData>) {
    if !this.HasPendingChildAttachementRequest(data) {
      ArrayPush(this.m_pendingChildAttachements, data);
    }
  }

  private final func HasPendingChildAttachementRequest(const data: script_ref<EntityAttachementData>) -> Bool {
    let i = 0;
    while i < ArraySize(this.m_pendingChildAttachements) {
      if data.ownerID == this.m_pendingChildAttachements[i].ownerID {
        return true;
      }
      i += 1;
    }
    return false;
  }

  public final func ClearPendingChildAttachementRequests() {
    ArrayClear(this.m_pendingChildAttachements);
  }
}

class CheckBoolisValid extends AIbehaviorconditionScript {
  public let actionTweakIDMapping: AIArgumentMapping;

  protected func Check(context: ScriptExecutionContext) -> AIbehaviorConditionOutcomes {
    if IsDefined(this.actionTweakIDMapping) {
      let value = FromVariant<Bool>(ScriptExecutionContext.GetMappingValue(context, this.actionTweakIDMapping));
      if Equals(value, false) {
        return AIbehaviorConditionOutcomes.False;
      }
    }
    return AIbehaviorConditionOutcomes.True;
  }
}

class CheckVectorIsValid extends AIbehaviorconditionScript {
