public func RoundTo(f: Float, decimal: Int32) -> Float {
  if decimal < 0 {
    decimal = 0;
  }
  let ret = Cast<Float>(FloorF(AbsF(f)));
  let isNeg = false;
  if f < 0.0 {
    isNeg = true;
    f *= -1.0;
  }
  f -= ret;
  let i = 0;
  while i < decimal {
    f *= 10.0;
    let digit = FloorF(f);
    ret += Cast<Float>(digit) / PowF(10.0, Cast<Float>((i + 1)));
    f -= Cast<Float>(digit);
    i += 1;
  }
  if isNeg {
    ret *= -1.0;
  }
  return ret;
}

public func OperatorXor(a: Bool, b: Bool) -> Bool {
  return NotEquals(a, b);
}

