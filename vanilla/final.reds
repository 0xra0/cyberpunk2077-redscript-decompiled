  protected const final func GetDistractionDuration(effectName: CName) -> Float {
    let duration: Float;
    let device = this.GetOwnerEntityWeak() as Device;
    if IsDefined(device) {
      duration = device.GetAreaEffectLifetimeByName(effectName);
    }
    return duration;
  }

  public const final func GetUniqueConnectionTypes() -> [DeviceConnectionScannerData] {
    let connection: DeviceConnectionScannerData;
    let uniqueConnections: [DeviceConnectionScannerData];
    let parents: [DeviceComponentPS];
    this.GetParents(parents);
    let i = 0;
    while i < ArraySize(parents) {
      let parent = parents[i] as ScriptableDeviceComponentPS;
      if !IsDefined(parent) {
      } else {
        let isRepetition = false;
        if !parent.ShouldRevealDevicesGrid() && !parent.ShouldRevealNetworkGrid() {
        } else if IsDefined(parent as ComputerControllerPS) {
          let parentRecord = (parent as TerminalControllerPS).GetTweakDBRecord();
        } else {
          parentRecord = parent.GetTweakDBRecord();
          TDBID.Append(parentRecord, t".deviceType");
          let categoryName = TweakDBInterface.GetString(parentRecord, "Default");
          let deviceRole = TweakDBInterface
            .GetScannableDataRecord(TDBID.Create("device_role_actions." + categoryName));
          if !IsDefined(deviceRole) {
          } else {
            connection.connectionType = LocKeyToString(deviceRole.LocalizedDescription());
            connection.icon = deviceRole.IconName();
            connection.amount = 1;
            let k = 0;
            if k < ArraySize(uniqueConnections) {
              if Equals(uniqueConnections[k].connectionType, connection.connectionType) {
                uniqueConnections[k].amount += 1;
                isRepetition = true;
              } else {
                k += 1;
              }
            } else if isRepetition {
            } else {
              ArrayPush(uniqueConnections, connection);
            }
          }
        }
      }
      i += 1;
    }
    return uniqueConnections;
  }

  public const final func GetDistractionDuration(action: ScriptableDeviceAction) -> Float {
    let device: wref<Device>;
    let result = 0.0;
    if this.TryGetDevice(device) {
      result = MaxF(device.GetAreaEffectLifetimeByAction(action), action.GetDurationTime());
    }
    return result;
  }

