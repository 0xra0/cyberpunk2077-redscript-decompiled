    this
      .m_hotkeyController
      .UpdateChargeValue(newValue, percToPoints, oldValue != newValue);
  }
}

class BaseAnimatedDevice extends InteractiveDevice {
  public let m_openingSpeed: Float;
  public let m_closingSpeed: Float;
  protected let m_animationController: AnimationControllerComponent;
  protected let m_animFeature: AnimFeature_RoadBlock;
  protected let m_animationType: EAnimationType;

  protected cb func OnRequestComponents(ri: EntityRequestComponentsInterface) -> Bool {
    super.OnRequestComponents(ri);
    EntityRequestComponentsInterface
      .RequestComponent(ri, n"animController", n"AnimationControllerComponent", false);
  }

  protected cb func OnTakeControl(ri: EntityResolveComponentsInterface) -> Bool {
    super.OnTakeControl(ri);
    this.m_animationController = EntityResolveComponentsInterface.GetComponent(ri, n"animController") as AnimationControllerComponent;
    this.m_controller = EntityResolveComponentsInterface.GetComponent(ri, n"controller") as BaseAnimatedDeviceController;
  }

  protected func ResolveGameplayState() {
    super.ResolveGameplayState();
    if Equals(this.m_animationType, EAnimationType.REGULAR) {
      this.m_animFeature = new AnimFeature_RoadBlock();
      this.m_animFeature.initOpen = this.GetDevicePS().IsActive();
    }
    this.ActivateAnimation();
  }

  private const func GetController() -> BaseAnimatedDeviceController {
    return this.m_controller as BaseAnimatedDeviceController;
  }

  public const func GetDevicePS() -> BaseAnimatedDeviceControllerPS {
    return this.GetController().GetPS();
  }

  protected cb func OnQuickHackToggleActivate(evt: QuickHackToggleActivate) -> Bool {
    this.ActivateAnimation();
    this.UpdateDeviceState();
  }

  protected cb func OnActivateDevice(evt: ActivateDevice) -> Bool {
    this.ActivateAnimation();
    this.UpdateDeviceState();
  }

  protected cb func OnDeactivateDevice(evt: DeactivateDevice) -> Bool {
    this.ActivateAnimation();
    this.UpdateDeviceState();
  }

  protected func DeactivateDevice() {
    super.DeactivateDevice();
    this.m_animationController.Toggle(false);
  }

  protected func ActivateDevice() {
    super.ActivateDevice();
    this.m_animationController.Toggle(true);
  }

  protected func ActivateAnimation() {
    if Equals(this.m_animationType, EAnimationType.REGULAR) {
      this.Animate();
    } else if Equals(this.m_animationType, EAnimationType.TRANSFORM) {
      this.InvokePlayAnimationEvent();
    }
  }

  protected func Animate() {
    if this.GetDevicePS().IsActive() {
      this.m_animFeature.isOpening = true;
      this.m_animFeature.duration = this.m_openingSpeed;
    } else {
      this.m_animFeature.isOpening = false;
      this.m_animFeature.duration = this.m_closingSpeed;
    }
    AnimationControllerComponent.ApplyFeature(this, n"Road_block", this.m_animFeature);
  }

  private final func InvokePlayAnimationEvent() {
    let playEvent = new gameTransformAnimationPlayEvent();
    playEvent.looping = false;
    playEvent.timesPlayed = 1u;
    playEvent.timeScale = this.GetTimeScale();
    playEvent.animationName = this.GetCurrentAnimationName();
    this.QueueEvent(playEvent);
    this.OnPlayAnimation();
  }

  protected func GetTimeScale() -> Float {
    if this.GetDevicePS().Randomize() {
      return RandRangeF(0.8, 1.2);
    }
    return 1.0;
  }

  private final func GetCurrentAnimationName() -> CName {
    return this.GetDevicePS().IsActive() ? n"opening" : n"closing";
  }

  protected func OnPlayAnimation();

  public const func DeterminGameplayRole() -> EGameplayRole {
    return EGameplayRole.ClearPath;
  }
}

class AnimFeature_RoadBlock extends AnimFeature {
  public let isOpening: Bool;
  public let duration: Float;
  public let initOpen: Bool;
}

class TV extends InteractiveDevice {
  private let m_isShortGlitchActive: Bool;
  private let m_shortGlitchDelayID: DelayID;
  protected let m_isTVMoving: Bool;

  protected cb func OnRequestComponents(ri: EntityRequestComponentsInterface) -> Bool {
    EntityRequestComponentsInterface.RequestComponent(ri, n"tv_ui", n"worlduiWidgetComponent", false);
    super.OnRequestComponents(ri);
  }

  public func ResavePersistentData(ps: PersistentState) -> Bool {
    return true;
  }

  protected func IsDeviceMovableScript() -> Bool {
    return this.m_isTVMoving;
  }

  protected cb func OnTakeControl(ri: EntityResolveComponentsInterface) -> Bool {
    this.m_uiComponent = EntityResolveComponentsInterface.GetComponent(ri, n"tv_ui") as worlduiWidgetComponent;
    super.OnTakeControl(ri);
    this.m_controller = EntityResolveComponentsInterface.GetComponent(ri, n"controller") as TVController;
  }

  protected func ResolveGameplayState() {
    super.ResolveGameplayState();
    if this.GetDevicePS().IsInterfaceMuted() {
      this.ToggleSoundEmmiter(true);
    } else if !this.GetDevicePS().IsInteractive() {
      this.ToggleDirectLayer(false);
    } else if this.IsUIdirty() && this.m_isInsideLogicArea {
      this.RefreshUI();
    }
  }

  public const func IsReadyForUI() -> Bool {
    return this.m_isVisible || this.GetDevicePS().ForceResolveGameplayStateOnAttach();
  }

  protected cb func OnDetach() -> Bool {
    super.OnDetach();
    GameInstance.GetGlobalTVSystem(this.GetGame()).UnregisterTVChannelFromEntity(this);
  }

  protected func CreateBlackboard() {
    this.m_blackboard = IBlackboard.Create(GetAllBlackboardDefs().TVDeviceBlackboard);
  }

  public const func GetBlackboardDef() -> TVDeviceBlackboardDef {
    return this.GetDevicePS().GetBlackboardDef();
  }

  protected const func GetController() -> TVController {
    return this.m_controller as TVController;
  }

  public const func GetDevicePS() -> TVControllerPS {
    return this.GetController().GetPS();
  }

  public const final func IsInteractive() -> Bool {
    return this.GetDevicePS().IsInteractive();
  }

  protected cb func OnToggleON(evt: ToggleON) -> Bool {
    super.OnToggleON(evt);
    this
      .TriggerArreaEffectDistraction(this.GetDefaultDistractionAreaEffectData(), evt.GetExecutor());
  }

  protected cb func OnTogglePower(evt: TogglePower) -> Bool {
    super.OnTogglePower(evt);
    this
      .TriggerArreaEffectDistraction(this.GetDefaultDistractionAreaEffectData(), evt.GetExecutor());
  }

  protected cb func OnNextChannel(evt: NextStation) -> Bool {
    let currentIndex = this.GetDevicePS().GetActiveStationIndex();
    this.SelectChannel(currentIndex);
    this.GetDevicePS().PassChannelName(this.GetChannelName(currentIndex));
    this
      .TriggerArreaEffectDistraction(this.GetDefaultDistractionAreaEffectData(), evt.GetExecutor());
  }

  protected cb func OnPreviousChannel(evt: PreviousStation) -> Bool {
    let currentIndex = this.GetDevicePS().GetActiveStationIndex();
    this.SelectChannel(currentIndex);
    this.GetDevicePS().PassChannelName(this.GetChannelName(currentIndex));
    this
      .TriggerArreaEffectDistraction(this.GetDefaultDistractionAreaEffectData(), evt.GetExecutor());
  }

  protected cb func OnQuestSetChannel(evt: QuestSetChannel) -> Bool {
    this.SelectChannel(this.GetDevicePS().GetActiveStationIndex());
  }

  protected cb func OnQuestDefaultStation(evt: QuestDefaultStation) -> Bool {
    this.SelectChannel(this.GetDevicePS().GetActiveStationIndex());
  }

  protected cb func OnQuestSetGlobalChannel(evt: SetGlobalTvChannel) -> Bool {
    let idx = this.GetDevicePS().GetGlobalTVChannelIDX(evt.m_channel);
    if idx >= 0 {
      this.GetDevicePS().SetActiveStationIndex(idx);
      this.SelectChannel(idx);
    }
  }

  protected cb func OnQuestSetGlobalTvOnly(evt: SetGlobalTvOnly) -> Bool {
    this.GetDevicePS().SetIsGlobalTvOnly(evt.m_isGlobalTvOnly);
    this.SelectChannel(this.GetDevicePS().GetActiveStationIndex());
  }

  public const final func GetDefaultGlitchVideoPath() -> ResRef {
    return this.GetDevicePS().GetDefaultGlitchVideoPath();
  }

  public const final func GetBroadcastGlitchVideoPath() -> ResRef {
    return this.GetDevicePS().GetBroadcastGlitchVideoPath();
  }

  protected func StartGlitching(glitchState: EGlitchState, opt intensity: Float) {
    let glitchData: GlitchData;
    glitchData.state = glitchState;
    glitchData.intensity = intensity;
    if intensity == 0.0 {
      intensity = 1.0;
    }
    let evt = new AdvertGlitchEvent();
    evt.SetShouldGlitch(intensity);
    this.QueueEvent(evt);
    this
      .GetBlackboard()
      .SetVariant(GetAllBlackboardDefs().TVDeviceBlackboard.GlitchData, ToVariant(glitchData));
    this.GetBlackboard().FireCallbacks();
    GameObject.PlaySound(this, n"dev_screen_glitch_distraction");
  }

  protected func StopGlitching() {
    let glitchData: GlitchData;
    let evt = new AdvertGlitchEvent();
    evt.SetShouldGlitch(0.0);
    this.QueueEvent(evt);
    glitchData.state = EGlitchState.NONE;
    this
      .GetBlackboard()
      .SetVariant(GetAllBlackboardDefs().TVDeviceBlackboard.GlitchData, ToVariant(glitchData));
    this.GetBlackboard().FireCallbacks();
    GameObject.StopSound(this, n"dev_screen_glitch_distraction");
  }

  protected cb func OnHitEvent(hit: gameHitEvent) -> Bool {
    super.OnHitEvent(hit);
    this.StartShortGlitch();
  }

  protected cb func OnStopShortGlitch(evt: StopShortGlitchEvent) -> Bool {
    this.m_isShortGlitchActive = false;
    if !this.GetDevicePS().IsGlitching() {
      this.StopGlitching();
    }
  }

  private final func StartShortGlitch() {
    if this.GetDevicePS().IsGlitching() {
      return;
    } else if !this.m_isShortGlitchActive {
      let evt = new StopShortGlitchEvent();
      this.StartGlitching(EGlitchState.DEFAULT, 1.0);
      this.m_shortGlitchDelayID = GameInstance.GetDelaySystem(this.GetGame()).DelayEvent(this, evt, 0.25);
      this.m_isShortGlitchActive = true;
    }
  }

  protected func TurnOnDevice() {
    super.TurnOnDevice();
    this.TurnOnScreen();
  }

  protected func TurnOffDevice() {
    super.TurnOffDevice();
    this.TurnOffScreen();
  }

  private final func ToggleSoundEmmiter(mute: Bool) {
    if mute {
      GameObject.PlaySound(this, n"mute_tv_emitter");
    } else {
      GameObject.PlaySound(this, n"unmute_tv_emitter");
    }
  }

  private final func SelectChannel(currentChannelIDX: Int32) {
    this
      .GetBlackboard()
      .SetInt(GetAllBlackboardDefs().TVDeviceBlackboard.CurrentChannel, currentChannelIDX);
    this.GetBlackboard().FireCallbacks();
  }

  private const final func GetChannelName(index: Int32) -> String {
    return this.GetDevicePS().GetChannelName(index);
  }

  private final func SelectChannel(const channelName: script_ref<String>) {
    let channelId = this.GetChannelId(channelName);
    this
      .GetBlackboard()
      .SetInt(GetAllBlackboardDefs().TVDeviceBlackboard.CurrentChannel, channelId);
  }

  private final func GetChannelId(const channelName: script_ref<String>) -> Int32 {
    return this.GetDevicePS().GetChannelID(channelName);
  }

  public const final func GetChannelData(channelIDX: Int32) -> STvChannel {
    return this.GetDevicePS().GetChannelData(channelIDX);
  }

  protected func TurnOffScreen() {
    this.m_uiComponent.Toggle(false);
    GameInstance.GetGlobalTVSystem(this.GetGame()).UnregisterTVChannelFromEntity(this);
    this.ToggleSoundEmmiter(true);
    this.RefreshUI();
  }

  protected func TurnOnScreen() {
    this.m_uiComponent.Toggle(true);
    if !this.GetDevicePS().IsInterfaceMuted() {
      this.ToggleSoundEmmiter(false);
    }
    this.RefreshUI();
  }

  public const func DeterminGameplayRole() -> EGameplayRole {
    return EGameplayRole.Distract;
  }

  protected func ApplyActiveStatusEffect(target: EntityID, statusEffect: TweakDBID) {
    if this.IsActiveStatusEffectValid() && this.GetDevicePS().IsGlitching() {
      GameInstance
        .GetStatusEffectSystem(this.GetGame())
        .ApplyStatusEffect(target, statusEffect);
    }
  }

  protected func UploadActiveProgramOnNPC(targetID: EntityID) {
    if this.IsActiveProgramToUploadOnNPCValid() && this.GetDevicePS().IsGlitching() {
      let evt = new ExecutePuppetActionEvent();
      evt.actionID = this.GetActiveProgramToUploadOnNPC();
      this.QueueEventForEntityID(targetID, evt);
    }
  }

  protected cb func OnQuestMuteSounds(evt: QuestMuteSounds) -> Bool {
    this.ToggleSoundEmmiter(this.GetDevicePS().IsInterfaceMuted());
  }

  protected cb func OnQuestToggleInteractivity(evt: QuestToggleInteractivity) -> Bool;

  public const final func GetGlobalTVChannels() -> [wref<ChannelData_Record>] {
    return this.GetDevicePS().GetGlobalTVChannels();
  }
}

