class VendingMachineInkGameController extends DeviceInkGameControllerBase {
  protected let m_ActionsPanel: inkHorizontalPanelRef;
  protected let m_ActionsPanel2: inkHorizontalPanelRef;
  protected let m_priceText: inkTextRef;
  protected let m_noMoneyPanel: inkCompoundRef;
  protected let m_soldOutPanel: inkCompoundRef;
  protected let m_state: PaymentStatus;
  protected let m_soldOut: Bool;
  private let m_onUpdateStatusListener: CallbackHandle;
  private let m_onGlitchingStateChangedListener: CallbackHandle;
  private let m_onSoldOutListener: CallbackHandle;

  protected cb func OnInitialize() -> Bool {
    super.OnInitialize();
    inkWidgetRef.SetVisible(this.m_noMoneyPanel, false);
    inkWidgetRef.SetVisible(this.m_soldOutPanel, false);
  }

  protected func RegisterBlackboardCallbacks(blackboard: IBlackboard) {
    super.RegisterBlackboardCallbacks(blackboard);
    if IsDefined(blackboard) {
      this.m_onUpdateStatusListener = blackboard
        .RegisterListenerVariant(this.GetOwner().GetBlackboardDef().ActionStatus, this, n"OnUpdateStatus");
      this.m_onGlitchingStateChangedListener = blackboard
        .RegisterListenerVariant(
          this.GetOwner().GetBlackboardDef().GlitchData,
          this,
          n"OnGlitchingStateChanged"
        );
      this.m_onSoldOutListener = blackboard
        .RegisterListenerBool(this.GetOwner().GetBlackboardDef().SoldOut, this, n"OnSoldOut");
    }
  }

  protected func UnRegisterBlackboardCallbacks(blackboard: IBlackboard) {
    super.UnRegisterBlackboardCallbacks(blackboard);
    if IsDefined(blackboard) {
      blackboard
        .UnregisterListenerVariant(
          this.GetOwner().GetBlackboardDef().ActionStatus,
          this.m_onUpdateStatusListener
        );
      blackboard
        .UnregisterListenerVariant(
          this.GetOwner().GetBlackboardDef().GlitchData,
          this.m_onGlitchingStateChangedListener
        );
      blackboard
        .UnregisterListenerBool(this.GetOwner().GetBlackboardDef().SoldOut, this.m_onSoldOutListener);
    }
  }

  public func UpdateActionWidgets(const widgetsData: script_ref<[SActionWidgetPackage]>) {
    this.HideActionWidgets();
    if !this.m_soldOut {
      inkWidgetRef.SetVisible(this.m_ActionsPanel, true);
      inkWidgetRef.SetVisible(this.m_ActionsPanel2, true);
      inkWidgetRef.SetVisible(this.m_noMoneyPanel, false);
      inkWidgetRef.SetVisible(this.m_soldOutPanel, false);
      let i = 0;
      while i < ArraySize(widgetsData) {
        let widget = this.GetActionWidget(widgetsData[i]);
        if widget == null {
          if i <= 2 {
            this
              .CreateActionWidgetAsync(inkWidgetRef.Get(this.m_ActionsPanel), widgetsData[i]);
          } else {
            this
              .CreateActionWidgetAsync(inkWidgetRef.Get(this.m_ActionsPanel2), widgetsData[i]);
          }
        } else {
          this.InitializeActionWidget(widget, widgetsData[i]);
        }
        i += 1;
      }
      let action = widgetsData[0].action as DispenceItemFromVendor;
      this.UpdatePrice(action.GetPrice());
    }
  }

  protected cb func OnSoldOut(value: Bool) -> Bool {
    this.m_soldOut = value;
    if this.m_soldOut {
      inkWidgetRef.SetVisible(this.m_soldOutPanel, true);
      inkWidgetRef.SetVisible(this.m_ActionsPanel, false);
      inkWidgetRef.SetVisible(this.m_ActionsPanel2, false);
      this.TriggerAnimationByName(n"sold_out", EInkAnimationPlaybackOption.PLAY);
    } else {
      inkWidgetRef.SetVisible(this.m_soldOutPanel, false);
      inkWidgetRef.SetVisible(this.m_ActionsPanel, true);
      inkWidgetRef.SetVisible(this.m_ActionsPanel2, true);
    }
  }

  protected cb func OnUpdateStatus(value: Variant) -> Bool;

  protected func ExecuteDeviceActions(controller: DeviceActionWidgetControllerBase) {
    let actions: [wref<DeviceAction>];
    if controller != null {
      if controller.CanExecuteAction() {
        actions = controller.GetActions();
      }
    }
    let executor = GetPlayer(this.GetOwner().GetGame());
    let i = 0;
    while i < ArraySize(actions) {
      let buyAction = actions[i] as DispenceItemFromVendor;
      if IsDefined(buyAction) && !buyAction.CanPay(executor) {
        inkWidgetRef.SetVisible(this.m_noMoneyPanel, true);
        this.PlayLibraryAnimation(n"no_money");
      } else {
        this.ExecuteAction(actions[i], executor);
        controller.FinalizeActionExecution(executor, actions[i]);
      }
      i += 1;
    }
  }

  protected cb func OnButtonHoverOver(e: inkPointerEvent) -> Bool {
    let button = e.GetCurrentTarget().GetController() as ImageActionButtonLogicController;
    if IsDefined(button) {
      this.UpdatePrice(button.GetPrice());
    }
  }

  private final func UpdatePrice(price: Int32) {
    let textParams = new inkTextParams();
    textParams.AddNumber("COST", price);
    textParams.AddLocalizedString("ED", "LocKey#884");
    inkTextRef.SetLocalizedTextString(this.m_priceText, "LocKey#45350", textParams);
  }

  protected func GetOwner() -> VendingMachine {
    return this.GetOwnerEntity() as VendingMachine;
  }

  protected func Refresh(state: EDeviceStatus) {
    this.SetupWidgets();
    switch state {
      case EDeviceStatus.ON:
        this.TurnOn();
        break;
      case EDeviceStatus.OFF:
        this.TurnOff();
        break;
      case EDeviceStatus.UNPOWERED:
        this.TurnOff();
        break;
      case EDeviceStatus.DISABLED:
        this.TurnOff();
        break;
      default:
        super.Refresh(state);
    }
  }

  protected func TurnOn() {
    this.m_rootWidget.SetVisible(true);
    this.RequestActionWidgetsUpdate();
  }

  protected func TurnOff() {
    this.m_rootWidget.SetVisible(false);
  }
}

class WeaponMachineInkGameController extends VendingMachineInkGameController {
  private let m_buttonRef: wref<WeaponVendorActionWidgetController>;

  protected cb func OnUpdateStatus(value: Variant) -> Bool {
    this.m_state = FromVariant<PaymentStatus>(value);
    switch this.m_state {
      case PaymentStatus.IN_PROGRESS:
        this.m_buttonRef.Processing();
        this.Processing();
        break;
      case PaymentStatus.NO_MONEY:
        this.m_buttonRef.NoMoney();
        this.NoMoney();
        break;
      default:
        this.m_buttonRef.ResetToDefault();
        this.Refresh(this.GetOwner().GetDeviceState());
    }
  }

  private final func Processing() {
    inkTextRef.SetLocalizedTextScript(this.m_priceText, "LocKey#45353");
    this.m_rootWidget.SetState(n"Processing");
  }

  private final func NoMoney() {
    this.m_rootWidget.SetState(n"Disabled");
  }

  public func UpdateActionWidgets(const widgetsData: script_ref<[SActionWidgetPackage]>) {
    if !IsDefined(this.m_buttonRef) || IsDefined(this.m_buttonRef) && !this.m_buttonRef.IsProcessing() {
      this.HideActionWidgets();
      this.m_rootWidget.SetState(n"Default");
      inkWidgetRef.SetVisible(this.m_ActionsPanel, true);
      if ArraySize(widgetsData) > 0 {
        let widget = this.GetActionWidget(widgetsData[0]);
        let action = widgetsData[0].action as DispenceItemFromVendor;
        if IsDefined(action) {
          let textParams = new inkTextParams();
          textParams.AddNumber("COST", action.GetPrice());
          textParams.AddLocalizedString("ED", "LocKey#884");
          inkTextRef.SetLocalizedTextScript(this.m_priceText, "LocKey#45350", textParams);
        } else if widget == null {
          this
            .CreateActionWidgetAsync(inkWidgetRef.Get(this.m_ActionsPanel), widgetsData[0]);
        }
        this.InitializeActionWidget(widget, widgetsData[0]);
      }
    }
  }

  protected cb func OnActionWidgetSpawned(widget: inkWidget, userData: IScriptable) -> Bool {
    super.OnActionWidgetSpawned(widget, userData);
    this.m_buttonRef = widget.GetController() as WeaponVendorActionWidgetController;
  }

  protected func GetOwner() -> WeaponVendingMachine {
    return this.GetOwnerEntity() as WeaponVendingMachine;
  }

  protected func Refresh(state: EDeviceStatus) {
    super.Refresh(state);
    this.HideActionWidgets();
    this.RequestActionWidgetsUpdate();
  }
}

class WeaponVendingMachine extends VendingMachine {
  protected let m_bigAdScreen: wref<IWorldWidgetComponent>;

  protected cb func OnRequestComponents(ri: EntityRequestComponentsInterface) -> Bool {
    super.OnRequestComponents(ri);
    EntityRequestComponentsInterface.RequestComponent(ri, n"bigAdvertScreen", n"worlduiWidgetComponent", false);
  }

  protected cb func OnTakeControl(ri: EntityResolveComponentsInterface) -> Bool {
    super.OnTakeControl(ri);
    this.m_bigAdScreen = EntityResolveComponentsInterface.GetComponent(ri, n"bigAdvertScreen") as worlduiWidgetComponent;
    this.m_controller = EntityResolveComponentsInterface.GetComponent(ri, n"controller") as WeaponVendingMachineController;
  }

  public func GetVendorID() -> TweakDBID {
    return this.GetDevicePS().GetVendorTweakID();
  }

  protected func PlayItemFall() {
    GameObject.PlaySoundEvent(this, this.GetDevicePS().GetGunFallSFX());
  }

  protected func GetJunkItem() -> ItemID {
    return ItemID.FromTDBID(this.GetDevicePS().GetJunkItemID());
  }

  protected func GetProcessingSFX() -> CName {
    return this.GetDevicePS().GetProcessingSFX();
  }

  protected func CreateDispenseRequest(shouldPay: Bool, item: ItemID) -> DispenseRequest {
    let dispenseRequest = new DispenseRequest();
    dispenseRequest.owner = this;
    dispenseRequest.position = this.RandomizePosition();
    dispenseRequest.shouldPay = shouldPay;
    if ItemID.IsValid(item) {
      dispenseRequest.itemID = ItemID.CreateQuery(ItemID.GetTDBID(item));
    }
    return dispenseRequest;
  }

  protected func TurnOffDevice() {
    super.TurnOffDevice();
    if IsDefined(this.m_bigAdScreen) {
      this.m_bigAdScreen.Toggle(false);
    }
  }

  protected func TurnOnDevice() {
    super.TurnOnDevice();
    if IsDefined(this.m_bigAdScreen) {
      this.m_bigAdScreen.Toggle(true);
    }
  }

  protected const func GetController() -> WeaponVendingMachineController {
    return this.m_controller as WeaponVendingMachineController;
  }

  public const func GetDevicePS() -> WeaponVendingMachineControllerPS {
    return this.GetController().GetPS();
  }

  public const func DeterminGameplayRole() -> EGameplayRole {
    return EGameplayRole.Distract;
  }
}

