  public func OnQuestForceEnabled(evt: QuestForceEnabled) -> EntityNotificationType {
    if !this.IsDisabled() {
      return EntityNotificationType.DoNotNotifyEntity;
    } else if this.m_wasStateCached && NotEquals(this.m_cachedDeviceState, EDeviceStatus.DISABLED) {
      this.SetDeviceState(this.m_cachedDeviceState);
    }
    this.SetDeviceState(EDeviceStatus.OFF);
    if !IsFinal() {
    }
    this.InitializeBackdoorSkillcheck();
    this.DetermineInitialPlaystyle();
    this.UseNotifier(evt);
    return EntityNotificationType.SendThisEventToEntity;
  }

