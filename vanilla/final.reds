class DeviceRemoteInteractionCondition extends InteractionScriptedCondition {
  public const final func Test(const activatorObject: wref<GameObject>, const hotSpotObject: wref<GameObject>) -> Bool {
    if !this.IsScannerTarget(hotSpotObject) && !this.IsLookaAtTarget(activatorObject, hotSpotObject) {
      return false;
    }
    return this.ShouldEnableLayer(hotSpotObject);
  }

  private const final func IsScannerTarget(const hotSpotObject: wref<GameObject>) -> Bool {
    let blackBoard = GameInstance
      .GetBlackboardSystem(hotSpotObject.GetGame())
      .Get(GetAllBlackboardDefs().UI_Scanner);
    let entityID = blackBoard.GetEntityID(GetAllBlackboardDefs().UI_Scanner.ScannedObject);
    return hotSpotObject.GetEntityID() == entityID;
  }

  private const final func IsLookaAtTarget(const activatorObject: wref<GameObject>, const hotSpotObject: wref<GameObject>) -> Bool {
    return GameInstance
      .GetInteractionManager(activatorObject.GetGame())
      .IsInteractionLookAtTarget(activatorObject, hotSpotObject);
  }

  private const final func ShouldEnableLayer(const hotSpotObject: wref<GameObject>) -> Bool {
    if IsDefined(hotSpotObject) {
      return hotSpotObject.ShouldEnableRemoteLayer();
    }
    return false;
  }
}

