abstract class StaminaTransition extends DefaultTransition {
  public let staminaChangeToggle: Bool;

  protected const final func ShouldRegenStamina(stateContext: StateContext, scriptInterface: StateGameScriptInterface) -> Bool {
    let isBodySlamming = scriptInterface
      .localBlackboard
      .GetBool(GetAllBlackboardDefs().PlayerStateMachine.IsInBodySlamState);
    if isBodySlamming {
      return false;
    }
    let staminaState = scriptInterface.localBlackboard.GetInt(GetAllBlackboardDefs().PlayerStateMachine.Stamina);
    if staminaState == 2 {
      return true;
    } else if scriptInterface.HasStatFlag(gamedataStatType.CanIgnoreStamina) {
      return true;
    }
    let meleeWeaponState = scriptInterface
      .localBlackboard
      .GetInt(GetAllBlackboardDefs().PlayerStateMachine.MeleeWeapon);
    if meleeWeaponState == 7 {
      return true;
    }
    let meleeState = scriptInterface.localBlackboard.GetInt(GetAllBlackboardDefs().PlayerStateMachine.Melee);
    if meleeState == 1 {
      return true;
    }
    let locomotionState = scriptInterface
      .localBlackboard
      .GetInt(GetAllBlackboardDefs().PlayerStateMachine.LocomotionDetailed);
    if locomotionState == 7 || locomotionState == 5 || locomotionState == 22 || locomotionState == 25 {
      return false;
    } else if GameObject.IsCooldownActive(scriptInterface.owner, n"OnBlockStaminaCooldown") {
      return false;
    }
    return true;
  }

  protected final func EnableStaminaPoolRegen(
    stateContext: StateContext,
    scriptInterface: StateGameScriptInterface,
    enable: Bool
  ) {
    let staminaCost = 0.1;
    if !enable {
      if this.staminaChangeToggle {
        staminaCost = staminaCost * -1.0;
      }
      this.staminaChangeToggle = !this.staminaChangeToggle;
      PlayerStaminaHelpers
        .ModifyStamina(scriptInterface.executionOwner as PlayerPuppet, staminaCost, true);
    }
  }

  protected final func OnUpdate(
    timeDelta: Float,
    stateContext: StateContext,
    scriptInterface: StateGameScriptInterface
  ) {
    let shouldRegenStamina = true;
    shouldRegenStamina = this.ShouldRegenStamina(stateContext, scriptInterface);
    this.EnableStaminaPoolRegen(stateContext, scriptInterface, shouldRegenStamina);
  }
}

