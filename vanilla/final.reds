  public const final func GetMasterDevicesTweaks() -> [TweakDBID] {
    let parents: [DeviceComponentPS];
    let MastersTweaks: [TweakDBID];
    this.GetParents(parents);
    let i = 0;
    while i < ArraySize(parents) {
      let parent = parents[i] as ScriptableDeviceComponentPS;
      if !IsDefined(parent) {
      } else if !parent.ShouldRevealDevicesGrid() {
      } else {
        ArrayPush(MastersTweaks, parent.GetTweakDBRecord());
      }
      i += 1;
    }
    return MastersTweaks;
  }

