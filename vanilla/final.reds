    EntityRequestComponentsInterface.RequestComponent(ri, n"statsComponent", n"gameStatsComponent", false);
    EntityRequestComponentsInterface.RequestComponent(ri, n"IKslots", n"SlotComponent", false);
    EntityRequestComponentsInterface
      .RequestComponent(ri, n"FxResourceMapper", n"FxResourceMapperComponent", false);
    EntityRequestComponentsInterface
      .RequestComponent(ri, n"AreaEffectVisualization", n"AreaEffectVisualizationComponent", false);
    EntityRequestComponentsInterface
