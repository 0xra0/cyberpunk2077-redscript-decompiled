class EntityHasVisualTag extends IScriptablePrereq {
  private let m_visualTag: CName;
  private let m_hasTag: Bool;

  protected func Initialize(recordID: TweakDBID) {
    this.m_visualTag = StringToName(TweakDBInterface.GetString(recordID + t".visualTag", ""));
    this.m_hasTag = TweakDBInterface.GetBool(recordID + t".hasTag", false);
  }

  public const func IsFulfilled(game: GameInstance, context: IScriptable) -> Bool {
    let owner = context as Entity;
    if !IsDefined(owner) {
      return false;
    } else if this.m_hasTag {
      if owner.MatchVisualTag(this.m_visualTag) {
        return true;
      }
    } else if !owner.MatchVisualTag(this.m_visualTag) {
      return true;
    }
    return false;
  }
}

