  public final static func GetTDBID(object: wref<GameObject>) -> TweakDBID {
    let puppet = object as ScriptedPuppet;
    if IsDefined(puppet) {
      return puppet.GetRecordID();
    }
    let device = object as Device;
    if IsDefined(device) {
      return device.GetTweakDBRecord();
    }
    let vehicle = object as VehicleObject;
    if IsDefined(vehicle) {
      return vehicle.GetRecord().GetID();
    }
    return TDBID.None();
  }

  public final static func GetActiveWeapon(object: wref<GameObject>) -> WeaponObject {
    if !IsDefined(object) || !object.IsAttached() {
      return null;
    }
    let weapon = GameInstance
      .GetTransactionSystem(object.GetGame())
      .GetItemInSlot(object, t"AttachmentSlots.WeaponRight") as WeaponObject;
    if IsDefined(weapon) {
      return weapon;
    }
    weapon = GameInstance
      .GetTransactionSystem(object.GetGame())
      .GetItemInSlot(object, t"AttachmentSlots.WeaponLeft") as WeaponObject;
    if IsDefined(weapon) {
      return weapon;
    }
    return weapon;
  }

  public final static func StartCooldown(
    self: GameObject,
    cooldownName: CName,
    cooldownDuration: Float,
    opt ignoreTimeDilation: Bool
  ) -> Int32 {
    let cdRequest: RegisterNewCooldownRequest;
    if cooldownDuration < 0.0 || !IsNameValid(cooldownName) {
      return -1;
    } else if cooldownDuration == 0.0 {
      GameObject.RemoveCooldown(self, cooldownName);
      return -1;
    }
    let cs = CSH.GetCooldownSystem(self);
    cdRequest.cooldownName = cooldownName;
    cdRequest.duration = cooldownDuration;
    cdRequest.owner = self;
    cdRequest.affectedByTimeDilation = !ignoreTimeDilation;
    return cs.Register(cdRequest);
  }

  public final static func RemoveCooldown(self: GameObject, cooldownName: CName) {
    if !IsNameValid(cooldownName) {
      return;
    }
    let cs = CSH.GetCooldownSystem(self);
    let cid = cs.GetCIDByOwnerAndName(self, cooldownName);
    if cs.DoesCooldownExist(cid) {
      cs.Remove(cid);
    }
  }

  public final static func IsCooldownActive(self: GameObject, cooldownName: CName, opt id: Int32) -> Bool {
    let cs = CSH.GetCooldownSystem(self);
    if !IsDefined(cs) {
      return false;
    } else if id > 0 {
      return cs.DoesCooldownExist(id);
    }
    id = cs.GetCIDByOwnerAndName(self, cooldownName);
    return cs.DoesCooldownExist(id);
  }

  public final static func GetTargetAngleInFloat(target: GameObject, owner: GameObject) -> Float {
    let forwardLocalToWorldAngle = Vector4.Heading(owner.GetWorldForward());
    let localHitDirection = Vector4.RotByAngleXY(target.GetWorldForward(), forwardLocalToWorldAngle);
    let finalHitDirectionCalculationFloat = Vector4.Heading(localHitDirection) + 180.0;
    return finalHitDirectionCalculationFloat;
  }

  public final static func GetTargetAngleInInt(target: GameObject, owner: GameObject) -> Int32 {
    let forwardLocalToWorldAngle = Vector4.Heading(target.GetWorldForward());
    let localHitDirection = Vector4.RotByAngleXY(owner.GetWorldForward(), forwardLocalToWorldAngle);
    let finalHitDirectionCalculationFloat = Vector4.Heading(localHitDirection) + 180.0;
    if finalHitDirectionCalculationFloat > 225.0 && finalHitDirectionCalculationFloat < 275.5 {
      return 1;
    }
    if finalHitDirectionCalculationFloat > 135.0 && finalHitDirectionCalculationFloat < 225.0 {
      return 2;
    }
    if finalHitDirectionCalculationFloat > 85.0 && finalHitDirectionCalculationFloat < 135.0 {
      return 3;
    }
    return 4;
  }

  public final static func GetTargetAngleInInt(target: GameObject, owner: GameObject, out backDirection: Int32) -> Int32 {
    let forwardLocalToWorldAngle = Vector4.Heading(target.GetWorldForward());
    let localHitDirection = Vector4.RotByAngleXY(owner.GetWorldForward(), forwardLocalToWorldAngle);
    let finalHitDirectionCalculationFloat = Vector4.Heading(localHitDirection) + 180.0;
    backDirection = 0;
    if finalHitDirectionCalculationFloat > 225.0 && finalHitDirectionCalculationFloat < 275.5 {
      return 1;
    }
    if finalHitDirectionCalculationFloat > 135.0 && finalHitDirectionCalculationFloat < 225.0 {
      if finalHitDirectionCalculationFloat > 135.0 && finalHitDirectionCalculationFloat < 180.0 {
        backDirection = 1;
      } else {
        backDirection = -1;
      }
      return 2;
    }
    if finalHitDirectionCalculationFloat > 85.0 && finalHitDirectionCalculationFloat < 135.0 {
      return 3;
    }
    return 4;
  }

  public final static func GetAttackAngleInInt(hitEvent: gameHitEvent, opt hitSource: Int32) -> Int32 {
    if hitSource == 0 {
      return GameObject.GetLocalAngleForDirectionInInt(hitEvent.hitDirection, hitEvent.target);
    }
    return GameObject.GetTargetAngleInInt(hitEvent.attackData.GetSource(), hitEvent.target);
  }

  public final static func GetLocalAngleForDirectionInInt(direction: Vector4, owner: GameObject) -> Int32 {
    let forwardLocalToWorldAngle = Vector4.Heading(owner.GetWorldForward());
    let localHitDirection = Vector4.RotByAngleXY(direction, forwardLocalToWorldAngle);
    let finalHitDirectionCalculationInt = RoundMath((Vector4.Heading(localHitDirection) + 180.0) / 90.0);
    return finalHitDirectionCalculationInt;
  }

  public final static func GetAttackAngleInFloat(hitEvent: gameHitEvent) -> Float {
    let forwardLocalToWorldAngle = Vector4.Heading(hitEvent.target.GetWorldForward());
    let localHitDirection = Vector4.RotByAngleXY(hitEvent.hitDirection, forwardLocalToWorldAngle);
    let finalHitDirectionCalculationfloat = Vector4.Heading(localHitDirection) + 180.0;
    return finalHitDirectionCalculationfloat;
  }

  public final func GetEntitiesAroundObject(opt range: Float, opt searchFilter: TargetSearchFilter) -> [Entity] {
    let searchQuery: TargetSearchQuery;
    let targetParts: [TS_TargetPartInfo];
    let targets: [Entity];
    searchQuery.testedSet = TargetingSet.Complete;
    searchQuery.searchFilter = searchFilter;
    searchQuery.maxDistance = range;
    searchQuery.filterObjectByDistance = range > 0.0;
    searchQuery.includeSecondaryTargets = false;
    searchQuery.ignoreInstigator = true;
    GameInstance
      .GetTargetingSystem(this.GetGame())
      .GetTargetParts(this, searchQuery, targetParts);
    let i = 0;
    while i < ArraySize(targetParts) {
      let targetingComponent = TS_TargetPartInfo.GetComponent(targetParts[i]);
      if !IsDefined(targetingComponent) {
      } else {
        let target = targetingComponent.GetEntity();
        if !ArrayContains(targets, target) {
          ArrayPush(targets, target);
        }
      }
      i += 1;
    }
    return targets;
  }

  public final func GetNPCsAroundObject(opt range: Float) -> [NPCPuppet] {
    let targets: [NPCPuppet];
    let entities = this.GetEntitiesAroundObject(range, TSF_NPC());
    let i = 0;
    while i < ArraySize(entities) {
      let target = entities[i] as NPCPuppet;
      if !IsDefined(target) {
      } else if !ArrayContains(targets, target) {
        ArrayPush(targets, target);
      }
      i += 1;
    }
    return targets;
  }

