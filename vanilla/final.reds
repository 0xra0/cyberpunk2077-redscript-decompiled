public func IsHostileTowardsPlayer(object: wref<GameObject>) -> Bool {
  if !IsDefined(object) {
    return false;
  }
  let player = GetPlayer(object.GetGame());
  if IsDefined(player)
    && Equals(GameObject.GetAttitudeTowards(object, player), EAIAttitude.AIA_Hostile) {
    return true;
  }
  return false;
}

