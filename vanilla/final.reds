class ActionDisposal extends ActionBool {
  public func CompleteAction(gameInstance: GameInstance) {
    let rewards: [wref<RewardBase_Record>];
    let actionEffects: [wref<ObjectActionEffect_Record>];
    GameInstance.GetPersistencySystem(gameInstance).QueuePSDeviceEvent(this);
    let mountingInfo = GameInstance
      .GetMountingFacility(gameInstance)
      .GetMountingInfoSingleWithObjects(this.GetExecutor());
    this.GetObjectActionRecord().Rewards(rewards);
    let i = 0;
    while i < ArraySize(rewards) {
      RPGManager
        .GiveReward(
          gameInstance,
          rewards[i].GetID(),
          Cast<StatsObjectID>(mountingInfo.childId)
        );
      i += 1;
    }
    this.GetObjectActionRecord().CompletionEffects(actionEffects);
    this.ProcessStatusEffects(actionEffects, gameInstance);
  }
}

