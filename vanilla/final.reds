  ) -> Bool {
    let dynamicSpawnSystem = GameInstance.GetDynamicSpawnSystem(ScriptExecutionContext.GetOwner(context).GetGame());
    let result = dynamicSpawnSystem.IsEntityRegistered(ScriptExecutionContext.GetOwner(context).GetEntityID());
    return condition.Invert() ? !result : result;
