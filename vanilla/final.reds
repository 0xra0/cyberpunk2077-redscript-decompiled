class HitOperations extends DeviceOperations {
  protected const let m_hitOperations: [SHitOperationData];

  public func RequestComponents(ri: EntityRequestComponentsInterface) {
    let i = 0;
    while i < ArraySize(this.m_hitOperations) {
      this.m_hitOperations[i].operation.id = i;
      let k = 0;
      while k < ArraySize(this.m_hitOperations[i].operation.components) {
        let componentName = this
          .m_hitOperations[i]
          .operation
          .components[k]
          .componentName;
        EntityRequestComponentsInterface.RequestComponent(ri, componentName, n"IPlacedComponent", false);
        k += 1;
      }
      i += 1;
    }
  }

  public func TakeControl(ri: EntityResolveComponentsInterface) {
    let i = 0;
    while i < ArraySize(this.m_hitOperations) {
      let k = 0;
      while k < ArraySize(this.m_hitOperations[i].operation.components) {
        let componentName = this
          .m_hitOperations[i]
          .operation
          .components[k]
          .componentName;
        let component = EntityResolveComponentsInterface.GetComponent(ri, componentName) as IPlacedComponent;
        if component != null && !ArrayContains(this.m_components, component) {
          ArrayPush(this.m_components, component);
        }
        k += 1;
      }
      i += 1;
    }
  }

  public func ToggleOperation(enable: Bool, index: Int32) {
    if index >= 0 && index < ArraySize(this.m_hitOperations) {
      this.m_hitOperations[index].operation.isEnabled = enable;
    }
  }

  public const func IsOperationEnabled(index: Int32) -> Bool {
    if index >= 0 && index < ArraySize(this.m_hitOperations) {
      return this.m_hitOperations[index].operation.isEnabled;
    }
    return false;
  }

  public func SetDelayIdOnOperation(delayId: DelayID, operationID: Int32) {
    if operationID >= 0 && operationID < ArraySize(this.m_hitOperations) {
      this.m_hitOperations[operationID].operation.delayID = delayId;
      this.m_hitOperations[operationID].operation.isDelayActive = true;
    }
  }

  public func ClearDelayIdOnOperation(operationID: Int32) {
    if operationID >= 0 && operationID < ArraySize(this.m_hitOperations) {
      this.m_hitOperations[operationID].operation.isDelayActive = false;
    }
  }

  public final func ExecuteOperation(owner: wref<GameObject>, activator: wref<GameObject>, attackData: AttackData) {
    let device = owner as Device;
    if device == null {
      return;
    }
    let attackType = attackData.GetAttackType();
    let healthPercentage = device.GetCurrentHealth();
    let i = 0;
    while i < ArraySize(this.m_hitOperations) {
      if AttackData.IsRangedOrDirect(attackType) && !this.m_hitOperations[i].bullets {
        return;
      } else if AttackData.IsExplosion(attackType) && !this.m_hitOperations[i].explosions {
        return;
      } else if AttackData.IsMelee(attackType) && !this.m_hitOperations[i].melee {
        return;
      } else if healthPercentage > this.m_hitOperations[i].healthPercentage {
        return;
      } else if IsDefined(activator as PlayerPuppet) && this.m_hitOperations[i].isAttackerPlayer {
        this.Execute(this.m_hitOperations[i].operation, owner);
      } else if activator as PlayerPuppet == null && this.m_hitOperations[i].isAttackerNPC {
        this.Execute(this.m_hitOperations[i].operation, owner);
      }
      i += 1;
    }
  }

  public final func RestoreOperation(owner: wref<GameObject>, activator: wref<GameObject>) {
    let i = 0;
    while i < ArraySize(this.m_hitOperations) {
      this.Restore(this.m_hitOperations[i].operation, owner);
      i += 1;
    }
  }
}

class PlayTransformAnimationDeviceOperation extends DeviceOperationBase {
  public const let transformAnimations: [STransformAnimationData];

  public func Execute(owner: wref<GameObject>) {
    super.Execute(owner);
    this.ResolveTransformAnimations(this.transformAnimations, owner);
  }

  public func Restore(owner: wref<GameObject>) {
    this.ResolveTransformAnimations(this.transformAnimations, owner);
  }

  private final func ResolveTransformAnimations(const animations: script_ref<[STransformAnimationData]>, owner: wref<GameObject>) {
    if owner == null {
      return;
    }
    let i = 0;
    while i < ArraySize(animations) {
      if Equals(animations[i].operationType, ETransformAnimationOperationType.PLAY) {
        let playEvent = new gameTransformAnimationPlayEvent();
        playEvent.animationName = animations[i].animationName;
        playEvent.timeScale = animations[i].playData.timeScale;
        playEvent.looping = animations[i].playData.looping;
        playEvent.timesPlayed = animations[i].playData.timesPlayed;
        owner.QueueEvent(playEvent);
        return;
      }
      if Equals(animations[i].operationType, ETransformAnimationOperationType.PAUSE) {
        let pauseEvent = new gameTransformAnimationPauseEvent();
        pauseEvent.animationName = animations[i].animationName;
        owner.QueueEvent(pauseEvent);
        return;
      }
      if Equals(animations[i].operationType, ETransformAnimationOperationType.RESET) {
        let resetEvent = new gameTransformAnimationResetEvent();
        resetEvent.animationName = animations[i].animationName;
        owner.QueueEvent(resetEvent);
        return;
      }
      if Equals(animations[i].operationType, ETransformAnimationOperationType.SKIP) {
        let skipEvent = new gameTransformAnimationSkipEvent();
        skipEvent.animationName = animations[i].animationName;
        skipEvent.time = animations[i].skipData.time;
        skipEvent.skipToEnd = animations[i].skipData.skipToEnd;
        owner.QueueEvent(skipEvent);
        return;
      }
      i += 1;
    }
  }
}

