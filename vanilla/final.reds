class SensesOperationsTrigger extends DeviceOperationsTrigger {
  protected let m_triggerData: SensesOperationTriggerData;

  public final func EvaluateTrigger(
    owner: wref<GameObject>,
    activator: wref<GameObject>,
    operationType: ETriggerOperationType,
    container: DeviceOperationsContainer
  ) {
    if this.m_triggerData == null {
      return;
    } else if Equals(this.m_triggerData.operationType, operationType) {
      if this.IsPlayerActivator(activator) && this.m_triggerData.isActivatorPlayer {
        this.ResolveOperationsOnTrigger(this.m_triggerData, owner, container);
      } else if !this.IsPlayerActivator(activator) && this.m_triggerData.isActivatorNPC {
        if IsNameValid(this.m_triggerData.attitudeGroup) {
          let attitudeAgent = activator.GetAttitudeAgent();
          if attitudeAgent != null {
            let attitudeGroup = attitudeAgent.GetAttitudeGroup();
            if NotEquals(attitudeGroup, this.m_triggerData.attitudeGroup) {
              return;
            }
          }
        }
        this.ResolveOperationsOnTrigger(this.m_triggerData, owner, container);
      }
    }
  }
}

class SensesOperationTriggerData extends DeviceOperationTriggerData {
  public let isActivatorPlayer: Bool;
  public let isActivatorNPC: Bool;
  public let attitudeGroup: CName;
  public let operationType: ETriggerOperationType;
}

