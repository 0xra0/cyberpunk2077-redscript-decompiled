  public const final native func GetTemporaryIntParameter(parameterName: CName) -> StateResultInt;

  public const final native func GetTemporaryFloatParameter(parameterName: CName) -> StateResultFloat;

  public const final native func GetTemporaryDoubleParameter(parameterName: CName) -> StateResultDouble;

  public const final native func GetTemporaryVectorParameter(parameterName: CName) -> StateResultVector;

  public const final native func GetTemporaryCNameParameter(parameterName: CName) -> StateResultCName;

  public const final native func GetTemporaryScriptableParameter(parameterName: CName) -> IScriptable;

  public const final native func GetTemporaryTweakDBIDParameter(parameterName: CName) -> TweakDBID;

  public const final native func GetPermanentBoolParameter(parameterName: CName) -> StateResultBool;

  public const final native func GetPermanentIntParameter(parameterName: CName) -> StateResultInt;

  public const final native func GetPermanentFloatParameter(parameterName: CName) -> StateResultFloat;

  public const final native func GetPermanentDoubleParameter(parameterName: CName) -> StateResultDouble;

  public const final native func GetPermanentVectorParameter(parameterName: CName) -> StateResultVector;

  public const final native func GetPermanentCNameParameter(parameterName: CName) -> StateResultCName;

  public const final native func GetPermanentScriptableParameter(parameterName: CName) -> IScriptable;

  public const final native func GetPermanentTweakDBIDParameter(parameterName: CName) -> TweakDBID;

  public const final native func GetBoolParameter(parameterName: CName, opt isPermanent: Bool) -> Bool;

  public const final native func GetFloatParameter(parameterName: CName, opt isPermanent: Bool) -> Float;

  public const final native func GetDoubleParameter(parameterName: CName, opt isPermanent: Bool) -> Double;

  public const final native func GetIntParameter(parameterName: CName, opt isPermanent: Bool) -> Int32;

  public const final native func GetVectorParameter(parameterName: CName, opt isPermanent: Bool) -> Vector4;

  public const final native func GetConditionBoolParameter(parameterName: CName) -> StateResultBool;

  public const final native func GetConditionBool(parameterName: CName) -> Bool;

  public const final native func GetConditionIntParameter(parameterName: CName) -> StateResultInt;

  public const final native func GetConditionInt(parameterName: CName) -> Int32;

  public const final native func GetConditionFloatParameter(parameterName: CName) -> StateResultFloat;

  public const final native func GetConditionFloat(parameterName: CName) -> Float;

  public const final native func GetConditionVectorParameter(parameterName: CName) -> StateResultVector;

