  private final func ResolveFocusClueExtendedDescription(clueIndex: Int32) {
    if this.m_scanningComponent != null {
      let clueRecords = this.m_scanningComponent.GetExtendedClueRecords(clueIndex);
      let i = 0;
      while i < ArraySize(clueRecords) {
        if !clueRecords[i].wasInspected
          && clueRecords[i].percentage >= this.m_scanningComponent.GetScanningProgress() {
          this.ResolveFacts(clueRecords[i].facts);
          this
            .m_scanningComponent
            .SetClueExtendedDescriptionAsInspected(clueIndex, i);
        }
        i += 1;
      }
    }
  }

  private final func ResolveFocusClueConclusion(clueIndex: Int32, conclusionData: ScanningTooltipElementDef) {
    if this.m_scanningComponent != null {
      if clueIndex < 0 {
        return;
      } else if !TDBID.IsValid(conclusionData.recordID) {
        return;
      } else if !this.m_scanningComponent.WasConclusionShown(clueIndex) && conclusionData.timePct >= this.m_scanningComponent.GetScanningProgress() {
        let clue = this.m_scanningComponent.GetClueByIndex(clueIndex);
        this.ResolveFacts(clue.facts);
        this.m_scanningComponent.SetConclusionAsShown(clueIndex);
      }
    }
  }

  protected final func ResolveFacts(const facts: script_ref<[SFactOperationData]>) {
    let i = 0;
    while i < ArraySize(facts) {
      if IsNameValid(facts[i].factName) {
        if Equals(facts[i].operationType, EMathOperationType.Add) {
          AddFact(this.GetGame(), facts[i].factName, facts[i].factValue);
        } else {
          SetFactValue(this.GetGame(), facts[i].factName, facts[i].factValue);
        }
      }
      i += 1;
    }
  }

