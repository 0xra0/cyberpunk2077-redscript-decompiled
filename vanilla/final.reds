    this.m_invert = TweakDBInterface.GetBool(recordID + t".invert", false);
  }

  protected const func OnRegister(state: PrereqState, game: GameInstance, context: IScriptable) -> Bool {
    let puppet = context as ScriptedPuppet;
    let castedState = state as NPCInScenePrereqState;
    if IsDefined(puppet) {
      castedState.sceneListener = gameScriptedPrereqSceneInspectionListenerWrapper.CreateEntityListener(game, puppet.GetEntityID(), castedState);
      return false;
    }
    return false;
  }

  protected const func OnUnregister(state: PrereqState, game: GameInstance, context: IScriptable) {
    let castedState = state as NPCInScenePrereqState;
    castedState.sceneListener = null;
  }

  public const func IsFulfilled(game: GameInstance, context: IScriptable) -> Bool {
    let targetPuppet = context as ScriptedPuppet;
    return this
      .Evaluate(
        GameInstance
          .GetSceneSystem(game)
          .GetScriptInterface()
          .IsEntityInScene(targetPuppet.GetEntityID())
      );
  }

  public const final func Evaluate(isEntityInScene: Bool) -> Bool {
    if isEntityInScene {
      return this.m_invert ? false : true;
    }
    return this.m_invert ? true : false;
  }
}

