  public final func TriggerSecuritySystemNotification(
    whoBreached: GameObject,
    lastKnownPosition: Vector4,
    type: ESecurityNotificationType,
    opt forceNotification: Bool
  ) {
    if this.IsON() || this.IsOFF() || forceNotification {
      let secSys = this.GetSecuritySystem();
      if !IsDefined(secSys) {
        return;
      }
      secSys
        .ReportPotentialSituation(
          this
            .ActionSecurityBreachNotification(lastKnownPosition, whoBreached, type)
        );
      return;
    }
  }

  public const func ActionSecurityBreachNotification(
    lastKnownPosition: Vector4,
    whoBreached: GameObject,
    type: ESecurityNotificationType
  ) -> SecuritySystemInput {
    let action = new SecuritySystemInput();
    action.SetUp(this);
    action
      .SetProperties(lastKnownPosition, whoBreached, this, type, this.CanPerformReprimand(), false);
    action.AddDeviceName(this.GetDeviceName());
    return action;
  }

