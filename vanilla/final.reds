    owner: Entity
  ) -> NavigationFindWallResult;

  public const final native func FindPointInSphereForCharacter(center: Vector4, radius: Float, owner: Entity) -> NavigationFindPointResult;

  public const final native func FindPointInBoxForCharacter(center: Vector4, extents: Vector4, owner: Entity) -> NavigationFindPointResult;

  public const final func IsPointOnNavmesh(const character: wref<Entity>, point: Vector4, opt tolerance: Float) -> Bool {
    if tolerance <= 0.0 {
      tolerance = 0.5;
    }
    let pointResults = this.FindPointInSphereForCharacter(point, tolerance, character);
    if NotEquals(pointResults.status, worldNavigationRequestStatus.OK) {
      return false;
    }
    return true;
  }

  public const final func IsPointOnNavmesh(const character: wref<Entity>, point: Vector4, tolerance: Vector4) -> Bool {
    let pointResults = this.FindPointInBoxForCharacter(point, tolerance, character);
    if NotEquals(pointResults.status, worldNavigationRequestStatus.OK) {
      return false;
    }
    return true;
  }

  public const final func IsPointOnNavmesh(
    const character: wref<Entity>,
    point: Vector4,
    tolerance: Vector4,
    out navmeshPoint: Vector4
  ) -> Bool {
    let pointResults = this.FindPointInBoxForCharacter(point, tolerance, character);
    navmeshPoint = pointResults.point;
    if NotEquals(pointResults.status, worldNavigationRequestStatus.OK) {
      return false;
    }
    return true;
  }

  public const final func FindPointBelowForCharacter(
    origin: Vector4,
    querySphereRadius: Float,
    numberOfSpheres: Int32,
    const character: wref<Entity>,
    out resultingZOffset: Float
  ) -> NavigationFindPointResult {
    let pointResults: NavigationFindPointResult;
    let i = 0;
    if i < numberOfSpheres {
      pointResults = this.FindPointInSphereForCharacter(origin, querySphereRadius, character);
      if Equals(pointResults.status, worldNavigationRequestStatus.OK) {
      } else {
        origin.Z -= querySphereRadius;
        i += 1;
      }
    }
    resultingZOffset = -1.0 * Cast<Float>(i) * querySphereRadius;
    return pointResults;
  }

  public const final func FindPointBelowForCharacter(
    origin: Vector4,
    querySphereRadius: Float,
    numberOfSpheres: Int32,
    const character: wref<Entity>
  ) -> NavigationFindPointResult {
    let resultingZOffset: Float;
    return this
      .FindPointBelowForCharacter(origin, querySphereRadius, numberOfSpheres, character, resultingZOffset);
  }

  public const final func GetNearestNavmeshPointBelow(
    const character: wref<Entity>,
    origin: Vector4,
    querySphereRadius: Float,
    numberOfSpheres: Int32
  ) -> Vector4 {
    let point: Vector4;
    let pointResults = this
      .FindPointBelowForCharacter(origin, querySphereRadius, numberOfSpheres, character);
    if Equals(pointResults.status, worldNavigationRequestStatus.OK) {
      point = pointResults.point;
    }
    return point;
  }

  public const final func GetNearestNavmeshPointBehind(
    const origin: wref<Entity>,
    const querySphereRadius: Float,
    const numberOfSpheres: Int32,
    out point: Vector4,
    opt checkPathToOrigin: Bool
  ) -> Bool {
    if !IsDefined(origin) {
      false;
    }
    let originPosition = origin.GetWorldPosition();
    let originHeading = origin.GetWorldForward();
    let i = 1;
    if i <= numberOfSpheres {
      let center = originPosition - originHeading * querySphereRadius * Cast<Float>(i);
      let pointResults = this.FindPointInSphereForCharacter(center, querySphereRadius, origin);
      if NotEquals(pointResults.status, worldNavigationRequestStatus.OK) {
      }
      point = pointResults.point;
      if checkPathToOrigin {
        let navigationPath = this.CalculatePathForCharacter(point, origin.GetWorldPosition(), 0.5, origin);
        if ArraySize(navigationPath.path) <= 0 {
        } else {
          return true;
        }
      }
      i += 1;
    }
    return false;
  }

  public const final func GetFurthestNavmeshPointBehind(
    const origin: wref<Entity>,
    const querySphereRadius: Float,
    const numberOfSpheres: Int32,
    out point: Vector4,
    opt const offsetFromOrigin: Vector4,
    opt checkPathToOrigin: Bool,
    opt ratioCurveName: CName
  ) -> Bool {
    if !IsDefined(origin) {
      false;
    }
    let statsDataSystem = GameInstance.GetStatsDataSystem((origin as GameObject).GetGame());
    let originPosition = origin.GetWorldPosition() + offsetFromOrigin;
    let originHeading = origin.GetWorldForward();
    let i = numberOfSpheres;
    if i > 0 {
      let center = originPosition - originHeading * querySphereRadius * Cast<Float>(i);
      let pointResults = this.FindPointInSphereForCharacter(center, querySphereRadius, origin);
      if NotEquals(pointResults.status, worldNavigationRequestStatus.OK) {
      }
      point = pointResults.point;
      if checkPathToOrigin {
        let navigationPath = this.CalculatePathForCharacter(point, origin.GetWorldPosition(), 0.5, origin);
        if ArraySize(navigationPath.path) <= 0 {
        } else if NotEquals(ratioCurveName, n"None") && IsDefined(statsDataSystem) {
          let directLength = Vector4.Length(originPosition - point);
          let pathLength = navigationPath.CalculateLength();
          let ratio = statsDataSystem
            .GetValueFromCurve(n"pathLengthToDirectDistancesRatio", pathLength, ratioCurveName);
          if ratio > 1.0 && pathLength > ratio * directLength {
          } else {
            return true;
          }
        }
      }
      i -= 1;
    }
    return false;
  }

  public const final func GetFurthestNavmeshPointInFront(
    const origin: wref<Entity>,
    const querySphereRadius: Float,
    const numberOfSpheres: Int32,
    out point: Vector4,
    opt const offsetFromOrigin: Vector4,
    opt checkPathToOrigin: Bool,
    opt ratioCurveName: CName
  ) -> Bool {
    if !IsDefined(origin) {
      false;
    }
    let statsDataSystem = GameInstance.GetStatsDataSystem((origin as GameObject).GetGame());
    let originPosition = origin.GetWorldPosition() + offsetFromOrigin;
    let originHeading = origin.GetWorldForward();
    let i = numberOfSpheres;
    if i > 0 {
      let center = originPosition - originHeading * querySphereRadius * Cast<Float>(i);
      let pointResults = this.FindPointInSphereForCharacter(center, querySphereRadius, origin);
      if NotEquals(pointResults.status, worldNavigationRequestStatus.OK) {
      }
      point = pointResults.point;
      if checkPathToOrigin {
        let navigationPath = this.CalculatePathForCharacter(point, origin.GetWorldPosition(), 0.5, origin);
        if ArraySize(navigationPath.path) <= 0 {
        } else if NotEquals(ratioCurveName, n"None") && IsDefined(statsDataSystem) {
          let directLength = Vector4.Length(originPosition - point);
          let pathLength = navigationPath.CalculateLength();
          let ratio = statsDataSystem
            .GetValueFromCurve(n"pathLengthToDirectDistancesRatio", pathLength, ratioCurveName);
          if ratio > 1.0 && pathLength < ratio * directLength {
          } else {
            return true;
          }
        }
      }
      i -= 1;
    }
    return false;
  }

  public const final func TryToFindNavmeshPointAroundPoint(
    const owner: wref<Entity>,
    const originPosition: Vector4,
    const originOrientation: Quaternion,
    const probeDimensions: Vector4,
    const numberOfSpheres: Int32,
    const sphereDistanceFromOrigin: Float,
    out point: Vector4,
    opt checkPathToOrigin: Bool
  ) -> Bool {
    let currentAngle: Float;
    let quat: Quaternion;
    let i = numberOfSpheres;
    if i > 0 {
      Quaternion.SetIdentity(quat);
      let currentAngleRad = Deg2Rad(currentAngle);
      Quaternion.SetZRot(quat, currentAngleRad);
      quat = originOrientation * quat;
      let currentCheckPosition = originPosition + Quaternion.GetForward(quat) * sphereDistanceFromOrigin;
      let pointResults = this.FindPointInBoxForCharacter(currentCheckPosition, probeDimensions, owner);
      currentAngle += Cast<Float>(360 / numberOfSpheres);
      if NotEquals(pointResults.status, worldNavigationRequestStatus.OK) {
      }
      point = pointResults.point;
      if checkPathToOrigin {
        let navigationPath = this.CalculatePathForCharacter(point, originPosition, 0.5, owner);
        if ArraySize(navigationPath.path) <= 0 {
        } else {
          return true;
        }
      }
      i -= 1;
    }
    return false;
  }

  public const final func HasPathForward(const sourceObject: wref<GameObject>, const distance: Float) -> Bool {
    let originPoint = sourceObject.GetWorldPosition();
    let destinationPoint = originPoint + Vector4.Normalize(sourceObject.GetWorldForward()) * distance;
    let originPointNavmeshResult = this
      .FindPointInBoxForCharacter(originPoint, new Vector4(0.2, 0.2, 0.75, 1.0), sourceObject);
    let destinationPointNavmeshResult = this
      .FindPointInBoxForCharacter(destinationPoint, new Vector4(0.2, 0.2, 0.75, 1.0), sourceObject);
    if Equals(originPointNavmeshResult.status, worldNavigationRequestStatus.OK)
      && Equals(destinationPointNavmeshResult.status, worldNavigationRequestStatus.OK) {
      let navigationPath = this
        .CalculatePathForCharacter(
          originPointNavmeshResult.point,
          destinationPointNavmeshResult.point,
          0.5,
          sourceObject
        );
      if ArraySize(navigationPath.path) > 0 {
        return true;
      }
    }
    return false;
  }

  public final static func HasPathFromAtoB(
    const owner: wref<Entity>,
    game: GameInstance,
    originPoint: Vector4,
    targetPoint: Vector4
  ) -> Bool {
    if !GameInstance.IsValid(game) {
      return false;
    }
    let navigationPath = GameInstance
      .GetAINavigationSystem(game)
      .CalculatePathForCharacter(originPoint, targetPoint, 0.5, owner);
    if ArraySize(navigationPath.path) <= 0 {
      return false;
    }
    return true;
  }
}

