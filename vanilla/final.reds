class IsAnyThreatClose extends AIAutonomousConditions {
  public let m_distance: Float;

  protected func Activate(context: ScriptExecutionContext) {
    AIbehaviorconditionScript
      .SetUpdateInterval(context, AIBehaviorScriptBase.RandomizeOffsetForUpdateInterval(0.2));
  }

  protected func Check(context: ScriptExecutionContext) -> AIbehaviorConditionOutcomes {
    let trackerComponent = AIBehaviorScriptBase.GetPuppet(context).GetTargetTrackerComponent();
    let threats = trackerComponent.GetThreats(false);
    let puppetPosition = ScriptExecutionContext.GetOwner(context).GetWorldPosition();
    let i = 0;
    while i < ArraySize(threats) {
      let distance = Vector4.Distance(puppetPosition, threats[i].location.position);
      if distance <= this.m_distance {
        ScriptExecutionContext
          .SetArgumentObject(context, n"ClosestThreat", threats[i].entity as GameObject);
        return AIbehaviorConditionOutcomes.True;
      }
      i += 1;
    }
    return AIbehaviorConditionOutcomes.False;
  }
}

