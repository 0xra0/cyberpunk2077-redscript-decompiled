native class CurrencyUpdateNotificationViewData extends GenericNotificationViewData {
  public native let diff: Int32;
  public native let total: Uint32;

  public func CanMerge(data: GenericNotificationViewData) -> Bool {
    let compareTo = data as CurrencyUpdateNotificationViewData;
    if IsDefined(compareTo) {
      this.total = compareTo.total;
      this.diff = this.diff + compareTo.diff;
      return true;
    }
    return false;
  }
}

class RewardNotificationCurrencyDelayed extends DelayCallback {
  private let m_notificationQueue: wref<ItemsNotificationQueue>;
  private let m_notificationData: gameuiGenericNotificationData;

  public final static func CreateAndDispatch(
    queue: wref<ItemsNotificationQueue>,
    notificationData: gameuiGenericNotificationData,
    delaySystem: wref<DelaySystem>
  ) {
    let DELAY_UNTIL_NOTIFY = 0.1;
    let notification = new RewardNotificationCurrencyDelayed();
    notification.m_notificationQueue = queue;
    notification.m_notificationData = notificationData;
    if IsDefined(delaySystem) {
      delaySystem.DelayCallback(notification, DELAY_UNTIL_NOTIFY, false);
    }
  }

  public func Call() {
    if IsDefined(this.m_notificationQueue) {
      this.m_notificationQueue.AddNewNotificationData(this.m_notificationData);
    }
  }
}

