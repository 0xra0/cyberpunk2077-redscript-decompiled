    } else if GameInstance
      .GetStatusEffectSystem(obj.GetGame())
      .HasStatusEffect(obj.GetEntityID(), t"BaseStatusEffect.Grappled") {
      return true;
    }
    let mountingInfo = GameInstance.GetMountingFacility(obj.GetGame()).GetMountingInfoSingleWithObjects(obj);
    if !EntityID.IsDefined(mountingInfo.childId) {
