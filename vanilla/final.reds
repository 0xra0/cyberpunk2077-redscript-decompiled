    return this.m_started;
  }

  private final func OnSetContainerStateEventEvent(evt: SetContainerStateEvent) -> EntityNotificationType {
    let shouldSendToEntity = NotEquals(this.m_isDisabled, evt.isDisabled);
    this.m_isDisabled = evt.isDisabled;
    if shouldSendToEntity {
      return EntityNotificationType.SendThisEventToEntity;
    }
    return EntityNotificationType.DoNotNotifyEntity;
  }

  private final func OnToggleContainerLockEvent(evt: ToggleContainerLockEvent) -> EntityNotificationType {
    let shouldSendToEntity = NotEquals(this.m_isLocked, evt.isLocked);
    this.m_isLocked = evt.isLocked;
    if shouldSendToEntity {
      return EntityNotificationType.SendThisEventToEntity;
    }
    return EntityNotificationType.DoNotNotifyEntity;
  }
}

