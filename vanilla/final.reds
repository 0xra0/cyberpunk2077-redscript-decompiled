class RefreshActorRequest extends HUDManagerRequest {
  private let actorUpdateData: HUDActorUpdateData;
  private let requestedModules: [wref<HUDModule>];

  public final static func Construct(
    requesterID: EntityID,
    opt updateData: HUDActorUpdateData,
    opt suggestedModules: [wref<HUDModule>]
  ) -> RefreshActorRequest {
    let request = new RefreshActorRequest();
    request.ownerID = requesterID;
    if IsDefined(updateData) {
      request.actorUpdateData = updateData;
    }
    let i = 0;
    while i < ArraySize(suggestedModules) {
      if IsDefined(suggestedModules[i]) {
        ArrayPush(request.requestedModules, suggestedModules[i]);
      }
      i += 1;
    }
    return request;
  }

  public const final func GetActorUpdateData() -> HUDActorUpdateData {
    return this.actorUpdateData;
  }

  public const final func GetRequestedModules() -> [wref<HUDModule>] {
    return this.requestedModules;
  }
}

