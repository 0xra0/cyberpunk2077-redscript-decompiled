  ) -> StimuliEvent;

  public final native static func ProcessSingleStimuliBroadcast(
    owner: GameObject,
    stimuli: StimuliEvent,
    isCrowd: Bool,
    isSurveillanceCamera: Bool,
    invalidDistraction: Bool,
    targets: [NPCstubData]
  ) -> Bool;
}

