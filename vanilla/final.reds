native class frameWidgetComponent extends worlduiWidgetComponent {
  public final func InitDefaultScreenshot() {
    let controller = this.GetGameController() as FrameInkGameController;
    let widget = controller.GetDefaultScreenWidget();
    let size = widget.GetSize();
    let format = this.GetFormat();
    if format.X > format.Y {
      size.Y *= format.X / format.Y;
    } else if format.Y > format.X {
      size.X *= format.Y / format.X;
    }
    widget.SetSize(size);
    controller.SetDefaultScreenshot(true);
  }

  public final func SetDefaultScreenshot(value: Bool) {
    let controller = this.GetGameController() as FrameInkGameController;
    controller.SetDefaultScreenshot(value);
  }

  public final func GetScreenshotWidget() -> wref<inkImage> {
    let controller = this.GetGameController() as FrameInkGameController;
    return controller.GetScreenWidget();
  }

  public final func StartGlitchTransition() {
    let evt = new AdvertGlitchEvent();
    evt.SetShouldGlitch(1.0);
    this.QueueEntityEvent(evt);
  }

  public final func StopGlitchTransition() {
    let evt = new AdvertGlitchEvent();
    evt.SetShouldGlitch(0.0);
    this.QueueEntityEvent(evt);
  }

  public final native func InitScreenshot(
    hash: Uint32,
    widget: wref<inkImage>,
    opt object: wref<IScriptable>,
    opt callback: CName
  );

  public final native func GetRequestHandler() -> inkISystemRequestsHandler;

  public final native func GetFormat() -> Vector2;

  public final native func GetPathHash(path: String) -> Int32;
}

class FrameInkGameController extends inkGameController {
  protected let m_screenshotWidget: inkImageRef;
  protected let m_defaultScreenshotWidget: inkImageRef;

  protected cb func OnInitialize() -> Bool {
    let frame = this.GetOwnerEntity() as Frame;
    let e = new FrameInitialisation();
    if frame != null {
      e.widget = this.GetScreenWidget();
      if e.widget != null {
        frame.QueueEvent(e);
      }
    }
  }

  public const final func GetScreenWidget() -> wref<inkImage> {
    return inkWidgetRef.Get(this.m_screenshotWidget) as inkImage;
  }

  public const final func GetDefaultScreenWidget() -> wref<inkImage> {
    return inkWidgetRef.Get(this.m_defaultScreenshotWidget) as inkImage;
  }

  public final func SetDefaultScreenshot(value: Bool) {
    inkWidgetRef.SetVisible(this.m_screenshotWidget, !value);
    inkWidgetRef.SetVisible(this.m_defaultScreenshotWidget, value);
  }
}

class Frame extends InteractiveDevice {
  private let m_isLinkedToPower: Bool;
  private let m_smartFrameName: String;
  private let m_smartFrameDescriptionLocKey: String;
  private let m_systemHandler: wref<inkISystemRequestsHandler>;
  private let m_squatFactToken: Uint32;
  private let m_questFactToken: Uint32;
  private let m_powerFactToken: Uint32;
  private let m_activePhotoID: Int32;
  private let m_activePhotoHash: Uint32;
  private let m_activePhotoUV: RectF;
  private let m_frameSwitcherToken: inkGameNotificationToken;

  protected cb func OnFrameInitialisation(evt: FrameInitialisation) -> Bool {
    let ps = this.GetPS();
    let frameComp = this.m_uiComponent as frameWidgetComponent;
    this.m_activePhotoHash = ps.GetHash();
    this.m_activePhotoUV = ps.GetUV();
    frameComp.InitDefaultScreenshot();
    if this.m_activePhotoHash != 0u {
      frameComp
        .InitScreenshot(this.m_activePhotoHash, evt.widget, this, n"OnScreenshotChanged");
      frameComp.StartGlitchTransition();
      GameObjectEffectHelper.StartEffectEvent(this, n"frameEffect");
    }
    frameComp
      .GetRequestHandler()
      .RegisterToCallback(n"OnDeleteSreenshotComplete", this, n"OnDeleteSreenshotComplete");
    if this.m_isLinkedToPower {
      this.LinkToPower();
    }
  }

  protected cb func OnRequestComponents(ri: EntityRequestComponentsInterface) -> Bool {
    super.OnRequestComponents(ri);
    EntityRequestComponentsInterface.RequestComponent(ri, n"ui", n"frameWidgetComponent", true);
  }

  protected cb func OnTakeControl(ri: EntityResolveComponentsInterface) -> Bool {
    super.OnTakeControl(ri);
    this.m_uiComponent = EntityResolveComponentsInterface.GetComponent(ri, n"ui") as frameWidgetComponent;
    this.m_controller = EntityResolveComponentsInterface.GetComponent(ri, n"controller") as FrameController;
  }

  protected cb func OnScanningLookedAt(evt: ScanningLookAtEvent) -> Bool {
    super.OnScanningLookedAt(evt);
  }

  private const func GetController() -> FrameController {
    return this.m_controller as FrameController;
  }

  public const func GetDevicePS() -> FrameControllerPS {
    return this.GetController().GetPS();
  }

  protected const func GetPS() -> FramePS {
    return super.GetPS() as FramePS;
  }

  public const func CompileScannerChunks() -> Bool {
    let customDescriptions: [String];
    let devicePS = this.GetDevicePS();
    let scannerBlackboard = GameInstance
      .GetBlackboardSystem(this.GetGame())
      .Get(GetAllBlackboardDefs().UI_ScannerModules);
    if !IsDefined(devicePS) || !IsDefined(scannerBlackboard) {
      return false;
    } else if devicePS.IsDisabled() {
      return false;
    }
    scannerBlackboard.SetInt(GetAllBlackboardDefs().UI_ScannerModules.ObjectType, 3, true);
    let nameParams = new inkTextParams();
    nameParams.AddString("TEXT_PRIMARY", this.m_smartFrameName);
    nameParams.AddString("TEXT_SECONDARY", "");
    let nameChunk = new ScannerName();
    nameChunk.SetTextParams(nameParams);
    scannerBlackboard
      .SetVariant(GetAllBlackboardDefs().UI_ScannerModules.ScannerName, ToVariant(nameChunk));
    if devicePS.ShouldScannerShowStatus() {
      let deviceStatusChunk = new ScannerDeviceStatus();
      deviceStatusChunk
        .Set(
          LocKeyToString(
            TweakDBInterface
              .GetScannableDataRecord(devicePS.GetScannerStatusRecord())
              .LocalizedDescription()
          )
        );
      deviceStatusChunk
        .SetFriendlyName(
          TweakDBInterface
            .GetScannableDataRecord(devicePS.GetScannerStatusRecord())
            .FriendlyName()
        );
      scannerBlackboard
        .SetVariant(
          GetAllBlackboardDefs().UI_ScannerModules.ScannerDeviceStatus,
          ToVariant(deviceStatusChunk)
        );
    }
    let descriptionChunk = new ScannerDescription();
    descriptionChunk.Set(this.m_smartFrameDescriptionLocKey, customDescriptions);
    scannerBlackboard
      .SetVariant(
        GetAllBlackboardDefs().UI_ScannerModules.ScannerDescription,
        ToVariant(descriptionChunk)
      );
    return true;
  }

  public const func DeterminGameplayRole() -> EGameplayRole {
    return EGameplayRole.SmartFrame;
  }

  private final func LinkToPower() {
    let questSystem = GameInstance.GetQuestsSystem(this.GetGame());
    this.m_questFactToken = questSystem.RegisterEntity(n"q302_squat_sh_unlocked", this.GetEntityID());
    if !this.TestPowerFact(questSystem) {
      this.m_uiComponent.Toggle(false);
      this.GetDevicePS().SetState(false);
    }
  }

  private final func TestPowerFact(questSystem: QuestsSystem) -> Bool {
    return Cast<Bool>(questSystem.GetFact(n"q302_squat_sh_unlocked"));
  }

  protected cb func OnFactChangedEvent(evt: FactChangedEvent) -> Bool {
    let questSystem = GameInstance.GetQuestsSystem(this.GetGame());
    if this.TestPowerFact(questSystem) {
      this.m_uiComponent.Toggle(true);
      this.GetDevicePS().SetState(true);
      questSystem.UnregisterEntity(n"q302_squat_sh_unlocked", this.m_questFactToken);
    }
  }

  private final func UpdateCurrentPhoto() {
    let frameComp = this.m_uiComponent as frameWidgetComponent;
    if this.m_activePhotoHash != 0u {
      if frameComp
        .GetRequestHandler()
        .RequestGameScreenshotByHash(
          this.m_activePhotoHash,
          frameComp.GetScreenshotWidget(),
          this,
          n"OnScreenshotChanged"
        ) {
        frameComp.StartGlitchTransition();
        GameObjectEffectHelper.StartEffectEvent(this, n"glitchEffect");
      }
    } else {
      GameObjectEffectHelper.StartEffectEvent(this, n"glitchEffect");
      frameComp.SetDefaultScreenshot(true);
    }
  }

  private final func TrySpawnFrameSwitcherPopup() -> Bool {
    if this
      .GetBlackboard()
      .GetBool(GetAllBlackboardDefs().UIGameData.Popup_FrameSwitcher_IsShown) {
      return false;
    }
    this.SpawnFrameSwitcherPopup();
    return true;
  }

  private final func SpawnFrameSwitcherPopup() {
    let evt = new FrameSwitcherEvent();
    evt.frame = this;
    evt.hash = this.m_activePhotoHash;
    evt.index = this.m_activePhotoID;
    evt.uv = this.m_activePhotoUV;
    GetPlayer(this.GetGame()).QueueEvent(evt);
  }

  public const final func GetFrameSize() -> Vector2 {
    return (this.m_uiComponent as frameWidgetComponent).GetFormat();
  }

  protected cb func OnFrameSwitcher(evt: FrameSwitcher) -> Bool {
    this.TrySpawnFrameSwitcherPopup();
  }

  protected cb func OnFrameSwitch(evt: FrameSwitch) -> Bool {
    this.m_activePhotoHash = evt.hash;
    this.m_activePhotoID = evt.index;
    this.m_activePhotoUV = evt.uv;
    this.UpdateCurrentPhoto();
    this.GetPS().SetHash(this.m_activePhotoHash);
    this.GetPS().SetUV(this.m_activePhotoUV);
  }

  protected cb func OnScreenshotChanged(screenshotSize: Vector2, errorCode: Int32) -> Bool {
    let frameComp = this.m_uiComponent as frameWidgetComponent;
    let widget = frameComp.GetScreenshotWidget();
    frameComp.StopGlitchTransition();
    if screenshotSize.X == 0.0 || screenshotSize.Y == 0.0 {
      frameComp.SetDefaultScreenshot(true);
    } else {
      frameComp.SetDefaultScreenshot(false);
      widget.SetDynamicTextureUV(this.m_activePhotoUV);
    }
    widget.FlagForVisualInvalidation();
  }

  protected cb func OnDeleteSreenshotComplete(hash: Uint32) -> Bool {
    let frameComp = this.m_uiComponent as frameWidgetComponent;
    if hash == this.m_activePhotoHash {
      frameComp.SetDefaultScreenshot(true);
    }
  }
}

class FramePS extends GameObjectPS {
  private persistent let m_screenshotHash: Uint32;
  private persistent let m_screenshotID: Int32;
  private persistent let m_screenshotUVLeft: Float;
  private persistent let m_screenshotUVRight: Float;
  private persistent let m_screenshotUVTop: Float;
  private persistent let m_screenshotUVBottom: Float;

  public final func SetHash(hash: Uint32) {
    this.m_screenshotHash = hash;
  }

  public final func SetUV(uv: RectF) {
    this.m_screenshotUVLeft = uv.Left;
    this.m_screenshotUVRight = uv.Right;
    this.m_screenshotUVTop = uv.Top;
    this.m_screenshotUVBottom = uv.Bottom;
  }

  public const final func GetHash() -> Uint32 {
    return this.m_screenshotHash;
  }

  public const final func GetIndex() -> Int32 {
    return this.m_screenshotID;
  }

  public const final func GetUV() -> RectF {
    let rect: RectF;
    rect.Left = this.m_screenshotUVLeft;
    rect.Right = this.m_screenshotUVRight;
    rect.Top = this.m_screenshotUVTop;
    rect.Bottom = this.m_screenshotUVBottom;
    return rect;
  }
}

native struct RectF {
  public native let Left: Float;
  public native let Top: Float;
  public native let Right: Float;
  public native let Bottom: Float;
}

class FrameInitialisation extends Event {
  public let widget: wref<inkImage>;
}

class FrameControllerPS extends ScriptableDeviceComponentPS {
  public func GetActions(out actions: [DeviceAction], context: GetActionsContext) -> Bool {
    if FrameSwitcher.IsPlayerInAcceptableState(this, context) {
      ArrayPush(actions, this.ActionOpen());
    }
    this.SetActionIllegality(actions, this.m_illegalActions.regularActions);
    return true;
  }

  protected final func ActionOpen() -> FrameSwitcher {
    let action = new FrameSwitcher();
    action.clearanceLevel = 2;
    action.SetUp(this);
    action.SetProperties();
    action.AddDeviceName(this.m_deviceName);
    action.CreateInteraction();
    return action;
  }

  public final func OnFrameSwitcher(evt: FrameSwitcher) -> EntityNotificationType {
    this.UseNotifier(evt);
    if evt.IsStarted() {
      this.ExecutePSAction(evt, this);
    }
    return EntityNotificationType.SendThisEventToEntity;
  }

  public final func SetState(state: Bool) {
    this.SetDeviceState(state ? EDeviceStatus.ON : EDeviceStatus.OFF);
    this.SetInteractionState(state);
  }
}

class FrameSwitcher extends ActionBool {
  public final func SetProperties() {
    this.actionName = n"FrameSwitcher";
    this.prop = DeviceActionPropertyFunctions
      .SetUpProperty_Bool(this.actionName, true, this.actionName, this.actionName);
  }

  public final static func IsPlayerInAcceptableState(device: ScriptableDeviceComponentPS, const context: script_ref<GetActionsContext>) -> Bool {
    let playerSMBlackboard = FrameSwitcher.GetPlayerStateMachine(context.processInitiatorObject);
    if playerSMBlackboard.GetBool(GetAllBlackboardDefs().PlayerStateMachine.Carrying) {
      return false;
    } else if StatusEffectSystem.ObjectHasStatusEffectWithTag(context.processInitiatorObject, n"PhoneCall") {
      return false;
    } else if StatusEffectSystem
      .ObjectHasStatusEffectWithTag(context.processInitiatorObject, n"NoWorldInteractions") {
      return false;
    }
    return true;
  }

  public final static func GetPlayerStateMachine(requester: GameObject) -> IBlackboard {
    let playerPuppet = GameInstance.GetPlayerSystem(requester.GetGame()).GetLocalPlayerMainGameObject() as PlayerPuppet;
    let playerStateMachineBlackboard = GameInstance
      .GetBlackboardSystem(requester.GetGame())
      .GetLocalInstanced(playerPuppet.GetEntityID(), GetAllBlackboardDefs().PlayerStateMachine);
    return playerStateMachineBlackboard;
  }
}

class FrameController extends ScriptableDeviceComponent {
  public const func GetPS() -> FrameControllerPS {
    return this.GetBasePS() as FrameControllerPS;
  }
}

class ScannerDescription extends ScannerChunk {
  private let defaultFluffDescription: String;
  private let customDescriptions: [String];

  public const final func GetDefaultDescription() -> String {
    return this.defaultFluffDescription;
  }

  public const final func GetCustomDescriptions() -> [String] {
    return this.customDescriptions;
  }

  public final func Set(const defaultDesc: script_ref<String>, opt customDesc: [String]) {
    this.defaultFluffDescription = defaultDesc;
    if ArraySize(customDesc) > 0 {
      this.customDescriptions = customDesc;
    }
  }

  public func GetType() -> ScannerDataType {
    return ScannerDataType.Description;
  }
}

