  public final func Setup(backpackInstance: wref<BackpackMainGameController>) {
    this.m_backpackInstance = backpackInstance;
  }
}

class ItemDisplayTemplateClassifier extends inkVirtualItemTemplateClassifier {
  public func ClassifyItem(data: Variant) -> Uint32 {
    let m_wrappedData = FromVariant<IScriptable>(data) as WrappedInventoryItemData;
    if !IsDefined(m_wrappedData) {
      return 0u;
    } else if IsDefined(m_wrappedData.Item) {
      if m_wrappedData.Item.IsWeapon() {
        return 1u;
      } else if Equals(
        InventoryItemData.GetEquipmentArea(m_wrappedData.ItemData),
        gamedataEquipmentArea.Weapon
      ) {
        return 1u;
      }
    }
    return 0u;
  }
}

class ItemPositionProvider extends inkItemPositionProvider {
  public func GetItemPosition(data: Variant) -> Uint32 {
    let m_wrappedData = FromVariant<IScriptable>(data) as WrappedInventoryItemData;
    if !IsDefined(m_wrappedData) {
      return 4294967295u;
    }
    return InventoryItemData.GetPositionInBackpack(m_wrappedData.ItemData);
  }

  public func SaveItemPosition(data: Variant, position: Uint32) {
    let m_wrappedData = FromVariant<IScriptable>(data) as WrappedInventoryItemData;
    if IsDefined(m_wrappedData) {
      InventoryItemData.SetPositionInBackpack(m_wrappedData.ItemData, position);
    }
  }
}

