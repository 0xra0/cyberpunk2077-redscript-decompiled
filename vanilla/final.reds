class LeftHandCyberwareSafeDecisions extends LeftHandCyberwareTransition {
  protected const final func EnterCondition(const stateContext: StateContext, const scriptInterface: StateGameScriptInterface) -> Bool {
    if this.IsSafeStateForced(stateContext, scriptInterface) {
      return true;
    } else if (scriptInterface.executionOwner as PlayerPuppet).IsAimingAtFriendly() {
      return true;
    } else if this.IsInVisionModeActiveState(stateContext, scriptInterface) && this.GetInStateTime() > 0.1 {
      return true;
    } else if StatusEffectSystem
      .ObjectHasStatusEffectOfType(scriptInterface.executionOwner, gamedataStatusEffectType.Stunned) {
      return true;
    }
    return false;
  }

  protected const final func ToLeftHandCyberwareUnequip(const stateContext: StateContext, const scriptInterface: StateGameScriptInterface) -> Bool {
    if this.GetInStateTime() >= this.GetStaticFloatParameterDefault("stateDuration", 2.0) {
      return true;
    }
    return this.ShouldInstantlyUnequipCyberware(scriptInterface, stateContext);
  }
}

