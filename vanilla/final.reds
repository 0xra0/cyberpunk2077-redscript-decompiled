abstract native class gamePuppetBase extends TimeDilatable {
  public const final native func GetRecordID() -> TweakDBID;

  public const final native func GetTweakDBDisplayName(useDisplayNameAsFallback: Bool) -> String;

  public const final native func GetTweakDBFullDisplayName(useDisplayNameAsFallback: Bool) -> String;

  public const final func GetIntFromCharacterTweak(const varName: script_ref<String>, opt defaultValue: Int32) -> Int32 {
    let tweakID = this.GetRecordID();
    TDBID.Append(tweakID, TDBID.Create("." + varName));
    return TweakDBInterface.GetInt(tweakID, defaultValue);
  }

  public const final func GetFloatFromCharacterTweak(const varName: script_ref<String>, opt defaultValue: Float) -> Float {
    let tweakID = this.GetRecordID();
    TDBID.Append(tweakID, TDBID.Create("." + varName));
    return TweakDBInterface.GetFloat(tweakID, defaultValue);
  }

  public const final func GetStringFromCharacterTweak(const varName: script_ref<String>, opt defaultValue: String) -> String {
    let tweakID = this.GetRecordID();
    TDBID.Append(tweakID, TDBID.Create("." + varName));
    return TweakDBInterface.GetString(tweakID, defaultValue);
  }

  public const final func GetBoolFromCharacterTweak(const varName: script_ref<String>, opt defaultValue: Bool) -> Bool {
    let tweakID = this.GetRecordID();
    TDBID.Append(tweakID, TDBID.Create("." + varName));
    return TweakDBInterface.GetBool(tweakID, defaultValue);
  }

  public const final func GetCNameFromCharacterTweak(const varName: script_ref<String>, opt defaultValue: CName) -> CName {
    let tweakID = this.GetRecordID();
    TDBID.Append(tweakID, TDBID.Create("." + varName));
    return TweakDBInterface.GetCName(tweakID, defaultValue);
  }

  public const func IsIncapacitated() -> Bool {
    return false;
  }
}

