class StillageControllerPS extends ScriptableDeviceComponentPS {
  private let m_isCleared: Bool;

  public func GetActions(out actions: [DeviceAction], context: GetActionsContext) -> Bool {
    if !super.GetActions(actions, context) {
      return false;
    } else if this.m_isCleared {
      return false;
    } else if Equals(context.requestType, gamedeviceRequestType.Direct) {
      ArrayPush(actions, this.ActionThrowStuff());
    }
    return true;
  }

  public func GetQuestActionByName(actionName: CName) -> DeviceAction {
    let action = super.GetQuestActionByName(actionName);
    if action == null {
      switch actionName {
        case n"QuestResetDeviceToInitialState":
          action = this.ActionQuestResetDeviceToInitialState();
          return action;
      }
    }
  }

  public func GetQuestActions(out actions: [DeviceAction], const context: script_ref<GetActionsContext>) {
    super.GetQuestActions(actions, context);
    ArrayPush(actions, this.ActionQuestResetDeviceToInitialState());
  }

  protected const final func ActionThrowStuff() -> ThrowStuff {
    let action = new ThrowStuff();
    action.clearanceLevel = 2;
    action.SetUp(this);
    action.SetProperties();
    action.AddDeviceName(this.m_deviceName);
    action.CreateInteraction();
    action.SetIllegal(true);
    return action;
  }

  protected final func OnThrowStuff(evt: ThrowStuff) -> EntityNotificationType {
    this.m_isCleared = true;
    this.UseNotifier(evt);
    return EntityNotificationType.SendThisEventToEntity;
  }

  protected func OnQuestResetDeviceToInitialState(evt: QuestResetDeviceToInitialState) -> EntityNotificationType {
    this.m_isCleared = false;
    this.UseNotifier(evt);
    return EntityNotificationType.SendThisEventToEntity;
  }
}

