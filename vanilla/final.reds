  public final func AddPlaystyle(playstyle: EPlaystyle) {
    if !this.HasPlaystyle(playstyle) {
      ArrayPush(this.m_playstyles, playstyle);
    }
  }

  public final func RemovePlaystyle(playstyle: EPlaystyle) {
    let i = ArraySize(this.m_playstyles) - 1;
    if i >= 0 {
      if Equals(this.m_playstyles[i], playstyle) {
        ArrayErase(this.m_playstyles, i);
      } else {
        i -= 1;
      }
    }
  }

  public final func DetermineInitialPlaystyle() {
    if !this.m_disableQuickHacks
      && this.CanCreateAnyQuickHackActions()
      && (this.IsQuickHacksExposed() || this.IsConnectedToBackdoorDevice() || this.HasNetworkBackdoor()) {
      this.AddPlaystyle(EPlaystyle.NETRUNNER);
      this.UpdateQuickHackableState(true);
    } else {
      this.RemovePlaystyle(EPlaystyle.NETRUNNER);
      this.UpdateQuickHackableState(false);
    }
    if this.CanCreateAnySpiderbotActions() {
      this.AddPlaystyle(EPlaystyle.TECHIE);
    } else {
      this.RemovePlaystyle(EPlaystyle.TECHIE);
    }
    this.m_quickHackVulnerabiltiesInitialized = false;
  }

  protected func OnActionOverride(evt: ActionOverride) -> EntityNotificationType {
    this.QueuePSEvent(this, this.ActionSetDeviceOFF());
    return EntityNotificationType.SendThisEventToEntity;
  }

  public final func GetAllQuickHackVulnerabilities() -> [TweakDBID] {
    this.InitializeQuickHackVulnerabilities();
    return this.m_quickHackVulnerabilties;
  }

  public final func GetActiveQuickHackVulnerabilities() -> [TweakDBID] {
    let returnValue: [TweakDBID];
    this.InitializeQuickHackVulnerabilities();
    let i = 0;
    while i < ArraySize(this.m_quickHackVulnerabilties) {
      if this.CanPlayerUseQuickHackVulnerability(this.m_quickHackVulnerabilties[i]) {
        ArrayPush(returnValue, this.m_quickHackVulnerabilties[i]);
      }
      i += 1;
    }
    return returnValue;
  }

  public final func HasAnyActiveQuickHackVulnerabilities() -> Bool {
    if !this.HasPlaystyle(EPlaystyle.NETRUNNER) {
      return false;
    }
    let list = this.GetActiveQuickHackVulnerabilities();
    return ArraySize(list) > 0;
  }

  public const final func CanPlayerUseQuickHackVulnerability(data: TweakDBID) -> Bool {
    let playerQhackList = RPGManager.GetPlayerQuickHackList(GetPlayer(this.GetGameInstance()));
    let i = 0;
    while i < ArraySize(playerQhackList) {
      let objectActionRecord = TweakDBInterface.GetObjectActionRecord(playerQhackList[i]);
      if IsDefined(objectActionRecord)
        && IsDefined(objectActionRecord.GameplayCategory())
        && objectActionRecord.GameplayCategory().GetID() == data {
        return true;
      }
      i += 1;
    }
    return false;
  }

  private final func InitializeQuickHackVulnerabilities() {
    let actions: [DeviceAction];
    if this.m_quickHackVulnerabiltiesInitialized {
      return;
    }
    ArrayClear(this.m_quickHackVulnerabilties);
    let context = this
      .GenerateContext(
        gamedeviceRequestType.Remote,
        this.GetClearance(),
        this.GetPlayerMainObject(),
        PersistentID.ExtractEntityID(this.GetID())
      );
    context.ignoresRPG = true;
    this.GetQuickHackActions(actions, context);
    let i = 0;
    while i < ArraySize(actions) {
      let action = actions[i] as ScriptableDeviceAction;
      if IsDefined(action) {
        let categoryID = action.GetGameplayCategoryID();
        if TDBID.IsValid(categoryID) {
          this.AddQuickHackVulnerability(categoryID);
        }
      }
      i += 1;
    }
    this.m_quickHackVulnerabiltiesInitialized = true;
  }

  public const final func HasQuickHackVulnerability(data: TweakDBID) -> Bool {
    let i = 0;
    while i < ArraySize(this.m_quickHackVulnerabilties) {
      if this.m_quickHackVulnerabilties[i] == data {
        return true;
      }
      i += 1;
    }
    return false;
  }

  private const final func HasHasQuickHackVulnerabilitiesInitialized() -> Bool {
    return this.m_quickHackVulnerabiltiesInitialized;
  }

  public final func AddQuickHackVulnerability(data: TweakDBID) {
    if !this.HasQuickHackVulnerability(data) {
      ArrayPush(this.m_quickHackVulnerabilties, data);
    }
  }

  public final func RemoveQuickHackVoulnerability(data: TweakDBID) {
    let i = ArraySize(this.m_quickHackVulnerabilties) - 1;
    if i >= 0 {
      if this.m_quickHackVulnerabilties[i] == data {
        ArrayErase(this.m_quickHackVulnerabilties, i);
      } else {
        i -= 1;
      }
    }
  }

  private final func UpdateQuickHackableState(isQuickHackable: Bool) {
    let quickHackableEvent = new SetQuickHackableMask();
    quickHackableEvent.isQuickHackable = isQuickHackable;
    this
      .GetPersistencySystem()
      .QueueEntityEvent(PersistentID.ExtractEntityID(this.GetID()), quickHackableEvent);
  }

