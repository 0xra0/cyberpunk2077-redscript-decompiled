  public final static func ForceEquipItemOnPlayer(puppet: GameObject, itemTDBID: TweakDBID, addToInv: Bool) {
    if puppet == null || !IsDefined((puppet as PlayerPuppet)) {
      return;
    }
    let itemID = ItemID.FromTDBID(itemTDBID);
    let equipRequest = new EquipRequest();
    equipRequest.itemID = itemID;
    equipRequest.owner = puppet;
    equipRequest.addToInventory = addToInv;
    GameInstance
      .GetScriptableSystemsContainer(puppet.GetGame())
      .Get(n"EquipmentSystem")
      .QueueRequest(equipRequest);
  }

