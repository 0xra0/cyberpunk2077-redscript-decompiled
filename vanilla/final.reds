struct SSensesOperationData {
  public let isActivatorPlayer: Bool;
  public let isActivatorNPC: Bool;
  public let attitudeGroup: CName;
  public let operationType: ETriggerOperationType;
  public let operation: SBaseDeviceOperationData;
}

struct SFocusModeOperationData {
  public let operationType: ETriggerOperationType;
  public let isLookedAt: Bool;
  public let operation: SBaseDeviceOperationData;
}

class FocusModeOperations extends DeviceOperations {
  protected const let m_focusModeOperations: [SFocusModeOperationData];

  public func RequestComponents(ri: EntityRequestComponentsInterface) {
    let i = 0;
    while i < ArraySize(this.m_focusModeOperations) {
      this.m_focusModeOperations[i].operation.id = i;
      let k = 0;
      while k < ArraySize(this.m_focusModeOperations[i].operation.components) {
        let componentName = this
          .m_focusModeOperations[i]
          .operation
          .components[k]
          .componentName;
        EntityRequestComponentsInterface.RequestComponent(ri, componentName, n"IPlacedComponent", false);
        k += 1;
      }
      i += 1;
    }
  }

  public func TakeControl(ri: EntityResolveComponentsInterface) {
    let i = 0;
    while i < ArraySize(this.m_focusModeOperations) {
      let k = 0;
      while k < ArraySize(this.m_focusModeOperations[i].operation.components) {
        let componentName = this
          .m_focusModeOperations[i]
          .operation
          .components[k]
          .componentName;
        let component = EntityResolveComponentsInterface.GetComponent(ri, componentName) as IPlacedComponent;
        if component != null && !ArrayContains(this.m_components, component) {
          ArrayPush(this.m_components, component);
        }
        k += 1;
      }
      i += 1;
    }
  }

  public func ToggleOperation(enable: Bool, index: Int32) {
    if index >= 0 && index < ArraySize(this.m_focusModeOperations) {
      this.m_focusModeOperations[index].operation.isEnabled = enable;
    }
  }

  public const func IsOperationEnabled(index: Int32) -> Bool {
    if index >= 0 && index < ArraySize(this.m_focusModeOperations) {
      return this.m_focusModeOperations[index].operation.isEnabled;
    }
    return false;
  }

  public func SetDelayIdOnOperation(delayId: DelayID, operationID: Int32) {
    if operationID >= 0 && operationID < ArraySize(this.m_focusModeOperations) {
      this.m_focusModeOperations[operationID].operation.delayID = delayId;
      this.m_focusModeOperations[operationID].operation.isDelayActive = true;
    }
  }

  public func ClearDelayIdOnOperation(operationID: Int32) {
    if operationID >= 0 && operationID < ArraySize(this.m_focusModeOperations) {
      this.m_focusModeOperations[operationID].operation.isDelayActive = false;
    }
  }

  public final func ExecuteOperation(owner: wref<GameObject>, operationType: ETriggerOperationType) {
    let i = 0;
    while i < ArraySize(this.m_focusModeOperations) {
      if Equals(this.m_focusModeOperations[i].operationType, operationType) {
        if Equals(this.m_focusModeOperations[i].operationType, ETriggerOperationType.ENTER) && this.m_focusModeOperations[i].isLookedAt && !this.IsLookedAt(owner) {
          return;
        }
        this.Execute(this.m_focusModeOperations[i].operation, owner);
      }
      i += 1;
    }
  }

  public final func RestoreOperation(owner: wref<GameObject>, operationType: ETriggerOperationType) {
    let i = 0;
    while i < ArraySize(this.m_focusModeOperations) {
      if Equals(this.m_focusModeOperations[i].operationType, operationType) {
        this.Restore(this.m_focusModeOperations[i].operation, owner);
      }
      i += 1;
    }
  }

  private final func IsLookedAt(object: GameObject) -> Bool {
    let lookedAtObect = GameInstance
      .GetTargetingSystem(object.GetGame())
      .GetLookAtObject(
        GameInstance.GetPlayerSystem(object.GetGame()).GetLocalPlayerMainGameObject() as PlayerPuppet
      );
    return lookedAtObect == object;
  }
}

class BlinkingEvent extends Event {
  public let requestNumber: Int32;
}

class SecurityAlarm extends InteractiveMasterDevice {
  protected let m_workingAlarm: MeshComponent;
  protected let m_destroyedAlarm: MeshComponent;
  protected let m_isGlitching: Bool;

  protected cb func OnRequestComponents(ri: EntityRequestComponentsInterface) -> Bool {
    super.OnRequestComponents(ri);
    EntityRequestComponentsInterface.RequestComponent(ri, n"alarm", n"MeshComponent", false);
    EntityRequestComponentsInterface.RequestComponent(ri, n"alarm_destroyed", n"MeshComponent", false);
  }

  protected cb func OnTakeControl(ri: EntityResolveComponentsInterface) -> Bool {
    super.OnTakeControl(ri);
    this.m_workingAlarm = EntityResolveComponentsInterface.GetComponent(ri, n"alarm") as MeshComponent;
    this.m_destroyedAlarm = EntityResolveComponentsInterface.GetComponent(ri, n"alarm_destroyed") as MeshComponent;
    this.m_controller = EntityResolveComponentsInterface.GetComponent(ri, n"controller") as SecurityAlarmController;
  }

  protected func ResolveGameplayState() {
    super.ResolveGameplayState();
    this.DetermineState();
  }

  private const func GetController() -> SecurityAlarmController {
    return this.m_controller as SecurityAlarmController;
  }

  public const func GetDevicePS() -> SecurityAlarmControllerPS {
    return this.GetController().GetPS();
  }

  protected cb func OnToggleAlarm(evt: ToggleAlarm) -> Bool {
    this.DetermineState();
  }

  protected cb func OnSecuritySystemOutput(evt: SecuritySystemOutput) -> Bool {
    super.OnSecuritySystemOutput(evt);
    this.DetermineState();
  }

  protected cb func OnSecurityAlarmBreachResponse(evt: SecurityAlarmBreachResponse) -> Bool {
    this.DetermineState();
  }

  protected cb func OnTargetAssessmentRequest(evt: TargetAssessmentRequest) -> Bool {
    this.DetermineState();
  }

  protected cb func OnQuestForceSecuritySystemSafe(evt: QuestForceSecuritySystemSafe) -> Bool {
    this.DetermineState();
  }

  protected cb func OnQuestForceSecuritySystemArmed(evt: QuestForceSecuritySystemArmed) -> Bool {
    this.DetermineState();
  }

  protected func StartGlitching(glitchState: EGlitchState, opt intensity: Float) {
    if NotEquals(this.GetDevicePS().GetAlarmState(), ESecuritySystemState.COMBAT) {
      this.m_isGlitching = true;
      this.TurnOnLights();
      this.StartBlinking();
    }
  }

  protected func StopGlitching() {
    this.m_isGlitching = false;
    this.StopBlinking();
    this.DetermineState();
  }

  protected final func DetermineState() {
    if !this.m_isGlitching {
      this.DeactivateState();
      if Equals(this.GetDevicePS().GetAlarmState(), ESecuritySystemState.COMBAT) {
        this.SetCombatState();
      }
    }
  }

  protected final func SetCombatState() {
    if this.GetDevicePS().IsON() {
      this.TurnOnLights();
      this.PlaySound();
      this.SendStim();
    }
  }

  protected final func DeactivateState() {
    this.TurnOffLights();
    this.StopSound();
    this.StopStim();
  }

  protected final func PlaySound() {
    if this.GetDevicePS().UsesSound() {
      GameObject.PlaySound(this, this.GetDevicePS().AlarmSound());
    }
  }

  protected final func StopSound() {
    if this.GetDevicePS().UsesSound() {
      GameObject.StopSound(this, this.GetDevicePS().AlarmSound());
    }
  }

  protected final func SendStim() {
    let stimType = this.GetDevicePS().UsesSound() ? gamedataStimType.Alarm : gamedataStimType.SilentAlarm;
    let broadcaster = this.GetStimBroadcasterComponent();
    if IsDefined(broadcaster) {
      broadcaster.SetSingleActiveStimuli(this, stimType, 20.0);
    }
  }

  protected final func StopStim() {
    let stimType = this.GetDevicePS().UsesSound() ? gamedataStimType.Alarm : gamedataStimType.SilentAlarm;
    let broadcaster = this.GetStimBroadcasterComponent();
    if IsDefined(broadcaster) {
      broadcaster.RemoveActiveStimuliByName(this, stimType);
    }
  }

  protected func TurnOffLights() {
    let evt = new ToggleLightEvent();
    evt.toggle = false;
    this.QueueEvent(evt);
  }

  protected final func TurnOnLights() {
    let evt = new ToggleLightEvent();
    evt.toggle = true;
    this.QueueEvent(evt);
  }

  protected final func StartBlinking() {
    let evt = new ChangeCurveEvent();
    evt.time = 3.0;
    evt.curve = n"BrokenLamp3";
    evt.loop = true;
    this.QueueEvent(evt);
  }

  protected final func StopBlinking() {
    let evt = new ChangeCurveEvent();
    evt.time = 3.0;
    evt.curve = n"alarm";
    evt.loop = true;
    this.QueueEvent(evt);
  }

  protected func TurnOnDevice() {
    this.DetermineState();
  }

  protected func TurnOffDevice() {
    this.DeactivateState();
  }

  protected func CutPower() {
    this.DeactivateState();
  }

  protected func DeactivateDevice() {
    super.DeactivateDevice();
    this
      .GetDevicePS()
      .GetDeviceOperationsContainer()
      .Execute(n"death_VFX", this);
    this.m_workingAlarm.Toggle(false);
    this.m_destroyedAlarm.Toggle(true);
  }

  protected func ActivateDevice() {
    super.ActivateDevice();
    this.m_workingAlarm.Toggle(true);
    this.m_destroyedAlarm.Toggle(false);
  }

  protected func BreakDevice() {
    this.DeactivateState();
  }

  public const func DeterminGameplayRole() -> EGameplayRole {
    return EGameplayRole.Alarm;
  }
}

class SecurityAlarmController extends MasterController {
  public const func GetPS() -> SecurityAlarmControllerPS {
    return this.GetBasePS() as SecurityAlarmControllerPS;
  }
}

class SimpleSwitch extends InteractiveMasterDevice {
  protected let m_animationType: EAnimationType;
  protected let m_animationSpeed: Float;

  protected cb func OnRequestComponents(ri: EntityRequestComponentsInterface) -> Bool {
    super.OnRequestComponents(ri);
  }

  protected cb func OnTakeControl(ri: EntityResolveComponentsInterface) -> Bool {
    super.OnTakeControl(ri);
    this.m_controller = EntityResolveComponentsInterface.GetComponent(ri, n"controller") as SimpleSwitchController;
  }

  private const func GetController() -> SimpleSwitchController {
    return this.m_controller as SimpleSwitchController;
  }

  public const func GetDevicePS() -> SimpleSwitchControllerPS {
    return this.GetController().GetPS();
  }

  protected func TurnOnDevice() {
    super.TurnOnDevice();
    this.SetDiodeAppearance(true);
    this.PlayAnimation(n"ToggleOn");
  }

  protected func TurnOffDevice() {
    super.TurnOffDevice();
    this.SetDiodeAppearance(false);
    this.PlayAnimation(n"ToggleOn");
  }

  private final func SetDiodeAppearance(on: Bool) {
    let lightSettings: ScriptLightSettings;
    let evt = new ChangeLightEvent();
    if on {
      lightSettings.color = new Color(25u, 135u, 0u, 255u);
    } else {
      lightSettings.color = new Color(130u, 0u, 0u, 0u);
    }
    lightSettings.strength = 1.0;
    evt.settings = lightSettings;
    this.QueueEvent(evt);
  }

  private final func PlayAnimation(id: CName) {
    if Equals(this.m_animationType, EAnimationType.REGULAR) {
    } else if Equals(this.m_animationType, EAnimationType.TRANSFORM) {
      let playEvent = new gameTransformAnimationPlayEvent();
      playEvent.animationName = id;
      playEvent.looping = false;
      playEvent.timesPlayed = 1u;
      if this.GetDevicePS().IsON() {
        playEvent.timeScale = this.m_animationSpeed;
      } else if this.GetDevicePS().IsOFF() {
        playEvent.timeScale = this.m_animationSpeed * -1.0;
      } else {
        this.QueueEvent(playEvent);
      }
    }
  }

  protected final func TurnOnLights() {
    let evt = new ToggleLightEvent();
    evt.toggle = true;
    this.QueueEvent(evt);
  }

  public const func DeterminGameplayRole() -> EGameplayRole {
    return EGameplayRole.ControlOtherDevice;
  }
}

class SimpleSwitchController extends MasterController {
  public const func GetPS() -> SimpleSwitchControllerPS {
    return this.GetBasePS() as SimpleSwitchControllerPS;
  }
}

