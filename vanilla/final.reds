  private let m_itemWrapper: inkWidgetRef;
  private let m_cyberwareSlotRootRefs: inkCompoundRef;
  private let m_cyberwareHolder: inkWidgetRef;
  private let m_cyberdeckInventoryStatsContainer: inkCompoundRef;
  private let m_paperDollWidget: inkWidgetRef;
  private let m_sortingButton: inkWidgetRef;
  private let m_sortingDropdown: inkWidgetRef;
  private let m_notificationRoot: inkWidgetRef;
  private let m_playerStatsWidget: inkWidgetRef;
  private let m_btnBackpack: inkWidgetRef;
  private let m_btnCyberware: inkWidgetRef;
  private let m_btnCrafting: inkWidgetRef;
  private let m_btnStats: inkWidgetRef;
  private let m_btnSets: inkWidgetRef;
  private let m_itemNotificationRoot: inkWidgetRef;
  private let m_TooltipsManager: wref<gameuiTooltipsManager>;
  private let m_menuEventDispatcher: wref<inkMenuEventDispatcher>;
  private let m_buttonHintsController: wref<ButtonHints>;
  private let m_player: wref<PlayerPuppet>;
  private let m_mode: InventoryModes;
  private let m_itemViewMode: ItemViewModes;
  private let m_itemModeLogicController: wref<InventoryItemModeLogicController>;
  private let m_animationProxy: inkAnimProxy;
  private let m_animDef: inkAnimDef;
  private let m_itemModeProxy: inkAnimProxy;
  private let m_itemModeOutroProxy: inkAnimProxy;
  private let m_paperDollProxy: inkAnimProxy;
  private let m_targetPaperDollVisibility: Bool;
  private let m_refreshUIRequested: Bool;
  private let m_InventoryList: [wref<InventoryItemDisplay>];
  private let m_WeaponsList: [wref<InventoryItemDisplayController>];
  private let m_EquipmentList: [wref<InventoryItemDisplayController>];
  private let m_CyberwareList: [wref<InventoryItemDisplayController>];
