  private final func UpdateEquializer() {
    let isCurrentRadioStation = this.m_currentRadioStationId == this.m_stationData.m_record.Index() && this.m_currentRadioStationId != -1;
    inkWidgetRef.SetVisible(this.m_equilizerIcon, isCurrentRadioStation);
    inkWidgetRef.SetVisible(this.m_codeTLicon, !isCurrentRadioStation);
  }
}

