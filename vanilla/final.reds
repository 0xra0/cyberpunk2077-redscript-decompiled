  private final static func HasItemTypeInnerIndex(itemType: gamedataItemType) -> Bool {
    return Equals(itemType, gamedataItemType.Prt_Mod);
  }

  private final static func GetItemTypeInnerIndex(itemType: gamedataItemType, itemData: wref<gameItemData>) -> Int32 {
    if RPGManager.IsWeaponMod(itemType) {
      let tags = TweakDBInterface.GetItemRecord(ItemID.GetTDBID(itemData.GetID())).Tags();
      if ArrayContains(tags, n"Power") {
        return 1;
      }
      if ArrayContains(tags, n"Tech") {
        return 2;
      }
      if ArrayContains(tags, n"Smart") {
        return 3;
      }
      if ArrayContains(tags, n"MeleeMod") {
        return 4;
      }
    }
    return 0;
  }

  public final static func GetItemTypeOrder(const item: script_ref<InventoryItemData>) -> Int32 {
    let value: Int32;
    let equipmentArea = InventoryItemData.GetEquipmentArea(item);
    let itemType = InventoryItemData.GetItemType(item);
    if Equals(itemType, gamedataItemType.Invalid) {
      return 0;
    }
    value += ItemCompareBuilder.GetEquipmentAreaIndex(equipmentArea) * 10000;
    value += ItemCompareBuilder.GetItemTypeIndex(itemType) * 100;
    if ItemCompareBuilder.HasItemTypeInnerIndex(itemType) {
      value
        += ItemCompareBuilder
          .GetItemTypeInnerIndex(itemType, InventoryItemData.GetGameItemData(item));
    }
    return value;
  }

  public final static func GetItemTypeOrder(
    itemData: wref<gameItemData>,
    equipmentArea: gamedataEquipmentArea,
    itemType: gamedataItemType
  ) -> Int32 {
    let value: Int32;
    if Equals(itemType, gamedataItemType.Invalid) {
      return 0;
    }
    value += ItemCompareBuilder.GetEquipmentAreaIndex(equipmentArea) * 10000;
    value += ItemCompareBuilder.GetItemTypeIndex(itemType) * 100;
    if ItemCompareBuilder.HasItemTypeInnerIndex(itemType) {
      value += ItemCompareBuilder.GetItemTypeInnerIndex(itemType, itemData);
    }
    return value;
  }
}

class CompareBuilder extends IScriptable {
  private let FLOAT_EQUAL_EPSILON: Float;
  private let value: Int32;

  public final static func Make() -> CompareBuilder {
    let builder = new CompareBuilder();
    return builder;
  }

  public final func Reset() {
    this.value = 0;
  }

  public final func Get() -> Int32 {
    return this.value;
  }

  public final func GetBool() -> Bool {
    return this.value > 0;
  }

  public final func StringAsc(const a: script_ref<String>, const b: script_ref<String>) -> CompareBuilder {
    if this.value == 0 {
      this.value = UnicodeStringCompare(a, b) * -1;
    }
    return this;
  }

  public final func StringDesc(const a: script_ref<String>, const b: script_ref<String>) -> CompareBuilder {
    if this.value == 0 {
      this.value = UnicodeStringCompare(a, b);
    }
    return this;
  }

  public final func UnicodeStringAsc(const a: script_ref<String>, const b: script_ref<String>) -> CompareBuilder {
    if this.value == 0 {
      this.value = UnicodeStringLessThan(a, b) ? 1 : -1;
    }
    return this;
  }

  public final func UnicodeStringDesc(const a: script_ref<String>, const b: script_ref<String>) -> CompareBuilder {
    if this.value == 0 {
      this.value = !UnicodeStringLessThanEqual(a, b) ? 1 : -1;
    }
    return this;
  }

  public final func IntAsc(a: Int32, b: Int32) -> CompareBuilder {
    if this.value == 0 {
      if a == b {
        this.value = 0;
      } else {
        this.value = a < b ? 1 : -1;
      }
    }
    return this;
  }

  public final func IntDesc(a: Int32, b: Int32) -> CompareBuilder {
    if this.value == 0 {
      if a == b {
        this.value = 0;
      } else {
        this.value = a > b ? 1 : -1;
      }
    }
    return this;
  }

  public final func FloatAsc(a: Float, b: Float) -> CompareBuilder {
    if this.value == 0 {
      if AbsF(a - b) < this.FLOAT_EQUAL_EPSILON {
        this.value = 0;
      } else {
        this.value = a < b ? 1 : -1;
      }
    }
    return this;
  }

  public final func FloatDesc(a: Float, b: Float) -> CompareBuilder {
    if this.value == 0 {
      if AbsF(a - b) < this.FLOAT_EQUAL_EPSILON {
        this.value = 0;
      } else {
        this.value = a > b ? 1 : -1;
      }
    }
    return this;
  }

  public final func BoolTrue(a: Bool, b: Bool) -> CompareBuilder {
    if this.value == 0 {
      if Equals(a, b) {
        this.value = 0;
      } else {
        this.value = a ? 1 : -1;
      }
    }
    return this;
  }

  public final func BoolFalse(a: Bool, b: Bool) -> CompareBuilder {
    if this.value == 0 {
      if Equals(a, b) {
        this.value = 0;
      } else {
        this.value = a ? -1 : 1;
      }
    }
    return this;
  }

  public final func GameTimeAsc(a: GameTime, b: GameTime) -> CompareBuilder {
    if this.value == 0 {
      if a == b {
        this.value = 0;
      } else {
        this.value = a < b ? 1 : -1;
      }
    }
    return this;
  }

  public final func GameTimeDesc(a: GameTime, b: GameTime) -> CompareBuilder {
    if this.value == 0 {
      if a == b {
        this.value = 0;
      } else {
        this.value = a > b ? 1 : -1;
      }
    }
    return this;
  }
}

public native func OperatorMultiply(a: Int32, b: Int32) -> Int32;

public native func UnicodeStringCompare(const str: script_ref<String>, const str2: script_ref<String>) -> Int32;

public native func UnicodeStringLessThan(const str: script_ref<String>, const str2: script_ref<String>) -> Bool;

public native func UnicodeStringLessThanEqual(const str: script_ref<String>, const str2: script_ref<String>) -> Bool;

public native func AbsF(a: Float) -> Float;

public native func OperatorEqual(a: GameTime, b: GameTime) -> Bool;

public native func OperatorLess(a: GameTime, b: GameTime) -> Bool;

public native func OperatorGreater(a: GameTime, b: GameTime) -> Bool;

importonly native struct InventoryItemSortData {
  public native let Name: String;
  public native let Quality: Int32;
  public native let Price: Int32;
  public native let Weight: Float;
  public native let DPS: Int32;
  public native let ItemType: Int32;
  public native let QuestItem: Bool;
  public native let NewItem: Bool;
  public native let DLCAddedItem: Bool;
  public native let ChimeraMod: Bool;
  public native let IsPlayerFavourite: Bool;
}

public native func GetLocalizedText(const textKey: script_ref<String>) -> String;

importonly native struct StatViewData {
  public native let type: gamedataStatType;
  public native let statName: String;
  public native let value: Int32;
  public native let diffValue: Int32;
  public native let isMaxValue: Bool;
  public native let valueF: Float;
  public native let diffValueF: Float;
  public native let statMinValueF: Float;
  public native let statMaxValueF: Float;
  public native let canBeCompared: Bool;
  public native let isCompared: Bool;
  public native let statMinValue: Int32;
  public native let statMaxValue: Int32;
}

class UIScriptableSystem extends ScriptableSystem {
  private persistent let m_backpackActiveSorting: Int32;
  private persistent let m_backpackActiveFilter: Int32;
  private persistent let m_isBackpackActiveFilterSaved: Bool;
  private persistent let m_vendorPanelPlayerActiveSorting: Int32;
  private persistent let m_vendorPanelVendorActiveSorting: Int32;
  private persistent let m_playerFavouriteItems: [ItemID];
  private persistent let m_newItems: [ItemID];
  private persistent let m_DLCAddedItems: [TweakDBID];
  private persistent let m_newWardrobeSets: [gameWardrobeClothingSetIndex];
  private persistent let m_newWardrobeItems: [ItemID];
  private persistent let m_availableCars: [CName];
  private persistent let m_previousAttributeLevels: [UIScriptableSystemAttributeLevel];
  private persistent let m_comparisionTooltipDisabled: Bool;
  private let m_attachedPlayer: wref<PlayerPuppet>;
  private let m_inventoryListenerCallback: UIScriptableInventoryListenerCallback;
  private let m_inventoryListener: InventoryScriptListener;
  private persistent let m_DEV_useNewTooltips: Bool;
  private persistent let m_DEV_useLongScanTooltips: Bool;

  private func OnAttach() {
    this.SetupInstance();
  }

  private func OnRestored(saveVersion: Int32, gameVersion: Int32) {
    this.SetupInstance();
  }

  private func OnDetach() {
    GameInstance
      .GetTransactionSystem(this.m_attachedPlayer.GetGame())
      .UnregisterInventoryListener(this.m_attachedPlayer, this.m_inventoryListener);
    this.m_inventoryListener = null;
  }

  private final func SetupInstance() {
    this.m_inventoryListenerCallback = new UIScriptableInventoryListenerCallback();
  }

  private final func OnPlayerAttach(request: PlayerAttachRequest) {
    if this.m_attachedPlayer != null {
      GameInstance
        .GetTransactionSystem(this.m_attachedPlayer.GetGame())
        .UnregisterInventoryListener(this.m_attachedPlayer, this.m_inventoryListener);
    }
    this.m_attachedPlayer = request.owner as PlayerPuppet;
    this.m_inventoryListener = GameInstance
      .GetTransactionSystem(this.m_attachedPlayer.GetGame())
      .RegisterInventoryListener(this.m_attachedPlayer, this.m_inventoryListenerCallback);
    this
      .m_inventoryListenerCallback
      .AttachScriptableSystem(this.m_attachedPlayer.GetGame());
  }

  public final static func GetInstance(gameInstance: GameInstance) -> UIScriptableSystem {
    let system = GameInstance.GetScriptableSystemsContainer(gameInstance).Get(n"UIScriptableSystem") as UIScriptableSystem;
    return system;
  }

  private final func OnSetBackpackSorting(request: UIScriptableSystemSetBackpackSorting) {
    this.m_backpackActiveSorting = request.sortMode;
  }

  private final func OnSetBackpackFilter(request: UIScriptableSystemSetBackpackFilter) {
    this.m_backpackActiveFilter = request.filterMode;
    this.m_isBackpackActiveFilterSaved = true;
  }

  private final func OnSetVendorPanelVendorSorting(request: UIScriptableSystemSetVendorPanelVendorSorting) {
    this.m_vendorPanelVendorActiveSorting = request.sortMode;
  }

  private final func OnSetVendorPanelPlayerSorting(request: UIScriptableSystemSetVendorPanelPlayerSorting) {
    this.m_vendorPanelPlayerActiveSorting = request.sortMode;
  }

  private final func OnComparisionTooltipDisabled(request: UIScriptableSystemSetComparisionTooltipDisabled) {
    this.m_comparisionTooltipDisabled = request.value;
  }

  private final func OnInventoryItemAdded(request: UIScriptableSystemInventoryAddItem) {
    if !ArrayContains(this.m_newItems, request.itemID) {
      ArrayPush(this.m_newItems, request.itemID);
    }
  }

  private final func OnInventoryItemRemoved(request: UIScriptableSystemInventoryRemoveItem) {
    if ArrayContains(this.m_newItems, request.itemID) {
      ArrayRemove(this.m_newItems, request.itemID);
    }
  }

  private final func OnInventoryItemInspected(request: UIScriptableSystemInventoryInspectItem) {
    if ArrayContains(this.m_newItems, request.itemID) {
      ArrayRemove(this.m_newItems, request.itemID);
    }
  }

  private final func OnDLCAddedItemInspected(request: UIScriptableSystemDLCAddedItemInspected) {
    if !ArrayContains(this.m_DLCAddedItems, request.itemTDBID) {
      ArrayPush(this.m_DLCAddedItems, request.itemTDBID);
    }
  }

  private final func OnWardrobeSetAdded(request: UIScriptableSystemWardrobeSetAdded) {
    if !ArrayContains(this.m_newWardrobeSets, request.wardrobeSet) {
      ArrayPush(this.m_newWardrobeSets, request.wardrobeSet);
    }
  }

  private final func OnWardrobeSetInspected(request: UIScriptableSystemWardrobeSetInspected) {
    if ArrayContains(this.m_newWardrobeSets, request.wardrobeSet) {
      ArrayRemove(this.m_newWardrobeSets, request.wardrobeSet);
    }
  }

  private final func OnWardrobeItemAdded(request: UIScriptableSystemWardrobeAddItem) {
    if !ArrayContains(this.m_newWardrobeItems, request.itemID) {
      ArrayPush(this.m_newWardrobeItems, request.itemID);
    }
  }

  private final func OnWardrobeItemInspected(request: UIScriptableSystemWardrobeInspectItem) {
    if ArrayContains(this.m_newWardrobeItems, request.itemID) {
      ArrayRemove(this.m_newWardrobeItems, request.itemID);
    }
  }

  private final func OnAvailableCarAdded(request: UIScriptableSystemAddAvailableCar) {
    if !ArrayContains(this.m_availableCars, request.carFact) {
      ArrayPush(this.m_availableCars, request.carFact);
    }
  }

  private final func OnSetItemPlayerFavourite(request: UIScriptableSystemSetItemPlayerFavourite) {
    if request.favourite {
      if !ArrayContains(this.m_playerFavouriteItems, request.itemID) {
        ArrayPush(this.m_playerFavouriteItems, request.itemID);
      }
    } else {
      ArrayRemove(this.m_playerFavouriteItems, request.itemID);
    }
  }

  private final func OnSetPreviousAttributeLevel(request: UIScriptableSystemSetPreviousAttributeLevel) {
    let set: Bool;
    let attributeLevel: UIScriptableSystemAttributeLevel;
    let i = 0;
    let limit = ArraySize(this.m_previousAttributeLevels);
    while i < limit {
      if Equals(this.m_previousAttributeLevels[i].m_stat, request.stat) {
        this.m_previousAttributeLevels[i].m_level = request.level;
        set = true;
      }
      i += 1;
    }
    if !set {
      attributeLevel.m_stat = request.stat;
      attributeLevel.m_level = request.level;
      ArrayPush(this.m_previousAttributeLevels, attributeLevel);
    }
  }

  private final func On_DEV_ScriptableSystemUseNewTooltips(request: UI_DEV_ScriptableSystemUseNewTooltips) {
    this.m_DEV_useNewTooltips = request.value;
  }

  private final func OnEnableScanLongDescription(request: ScanLongDescriptionCall) {
    this.m_DEV_useLongScanTooltips = request.isEnabled;
  }

  public const final func GetBackpackActiveSorting(opt defaultValue: Int32) -> Int32 {
    if this.m_backpackActiveSorting == 0 {
      return defaultValue;
    }
    return this.m_backpackActiveSorting;
  }

  public const final func GetBackpackActiveFilter(opt defaultValue: Int32) -> Int32 {
    if !this.m_isBackpackActiveFilterSaved {
      return defaultValue;
    }
    return this.m_backpackActiveFilter;
  }

  public const final func GetVendorPanelVendorActiveSorting(opt defaultValue: Int32) -> Int32 {
    if this.m_vendorPanelVendorActiveSorting == 0 {
      return defaultValue;
    }
    return this.m_vendorPanelVendorActiveSorting;
  }

  public const final func GetVendorPanelPlayerActiveSorting(opt defaultValue: Int32) -> Int32 {
    if this.m_vendorPanelPlayerActiveSorting == 0 {
      return defaultValue;
    }
    return this.m_vendorPanelPlayerActiveSorting;
  }

  public const final func IsInventoryItemNew(itemID: ItemID) -> Bool {
    return ArrayContains(this.m_newItems, itemID);
  }

  public const final func IsWardrobeSetNew(wardrobeSet: gameWardrobeClothingSetIndex) -> Bool {
    return ArrayContains(this.m_newWardrobeSets, wardrobeSet);
  }

  public const final func IsWardrobeItemNew(itemID: ItemID) -> Bool {
    return ArrayContains(this.m_newWardrobeItems, itemID);
  }

  public const final func IsAvailableCarNew(carFact: CName) -> Bool {
    return !ArrayContains(this.m_availableCars, carFact);
  }

  public const final func IsDLCAddedActiveItem(itemTweakDBID: TweakDBID) -> Bool {
    return !ArrayContains(this.m_DLCAddedItems, itemTweakDBID);
  }

  public const final func IsItemPlayerFavourite(itemID: ItemID) -> Bool {
    return ArrayContains(this.m_playerFavouriteItems, itemID);
  }

  public const final func GetPreviousAttributeLevel(stat: gamedataStatType) -> Int32 {
    let i = 0;
    let limit = ArraySize(this.m_previousAttributeLevels);
    while i < limit {
      if Equals(this.m_previousAttributeLevels[i].m_stat, stat) {
        return this.m_previousAttributeLevels[i].m_level;
      }
      i += 1;
    }
    return -1;
  }

  public const final func IsComparisionTooltipDisabled() -> Bool {
    return this.m_comparisionTooltipDisabled;
  }

  public const final func DEV_IsNewTooltipEnabled() -> Bool {
    return this.m_DEV_useNewTooltips;
  }

  public const final func DEV_IsScanLongTooltipEnabled() -> Bool {
    return this.m_DEV_useLongScanTooltips;
  }
}

class UIScriptableInventoryListenerCallback extends InventoryScriptCallback {
  private let m_uiScriptableSystem: wref<UIScriptableSystem>;

  public final func AttachScriptableSystem(gameInstance: GameInstance) {
    this.m_uiScriptableSystem = UIScriptableSystem.GetInstance(gameInstance);
  }

  public func OnItemAdded(item: ItemID, itemData: wref<gameItemData>, flaggedAsSilent: Bool) {
    let request = new UIScriptableSystemInventoryAddItem();
    request.itemID = item;
    this.m_uiScriptableSystem.QueueRequest(request);
  }

  public func OnItemRemoved(item: ItemID, difference: Int32, currentQuantity: Int32) {
    let request = new UIScriptableSystemInventoryRemoveItem();
    request.itemID = item;
    this.m_uiScriptableSystem.QueueRequest(request);
  }

  public func OnItemExtracted(item: ItemID) {
    let request = new UIScriptableSystemInventoryRemoveItem();
    request.itemID = item;
    this.m_uiScriptableSystem.QueueRequest(request);
  }
}

