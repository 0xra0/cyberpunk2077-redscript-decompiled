  public const final func CanActivateRemoteActionWheel() -> Bool {
    if this.HasCurrentTarget() {
      let object = GameInstance.FindEntityByID(this.GetGameInstance(), this.m_currentTarget.GetEntityID()) as GameObject;
      if IsDefined(object) {
        return object.ShouldShowScanner() && object.CanRevealRemoteActionsWheel();
      }
      return false;
    }
    return false;
  }

