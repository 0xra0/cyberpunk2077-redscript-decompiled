abstract final class ItemFilters extends IScriptable {
  public final static func GetLabelKey(filterType: Int32) -> CName {
    return ItemFilters.GetLabelKey(IntEnum<ItemFilterType>(filterType));
  }

  public final static func GetLabelKey(filterType: ItemFilterType) -> CName {
    switch filterType {
      case ItemFilterType.All:
        return n"UI-Filters-AllItems";
      case ItemFilterType.Weapons:
        return n"UI-Filters-Weapons";
      case ItemFilterType.Clothes:
        return n"UI-Filters-Clothes";
      case ItemFilterType.Consumables:
        return n"UI-Filters-Consumables";
      case ItemFilterType.Cyberware:
        return n"UI-Filters-Cyberware";
      case ItemFilterType.Attachments:
        return n"UI-Filters-Attachments";
      case ItemFilterType.Quest:
        return n"UI-Filters-QuestItems";
      case ItemFilterType.Buyback:
        return n"UI-Filters-Buyback";
      case ItemFilterType.LightWeapons:
        return n"UI-Filters-LightWeapons";
      case ItemFilterType.HeavyWeapons:
        return n"UI-Filters-HeavyWeapons";
      case ItemFilterType.MeleeWeapons:
        return n"UI-Filters-MeleeWeapons";
      case ItemFilterType.Hacks:
        return n"UI-Filters-Hacks";
    }
    return n"UI-Filters-AllItems";
  }

  public final static func GetIcon(filterType: Int32) -> String {
    return ItemFilters.GetIcon(IntEnum<ItemFilterType>(filterType));
  }

  public final static func GetIcon(filterType: ItemFilterType) -> String {
    switch filterType {
      case ItemFilterType.All:
        return "UIIcon.Filter_AllItems";
      case ItemFilterType.Weapons:
        return "UIIcon.Filter_Weapons";
      case ItemFilterType.Clothes:
        return "UIIcon.Filter_Clothes";
      case ItemFilterType.Consumables:
        return "UIIcon.Filter_Consumables";
      case ItemFilterType.Cyberware:
        return "UIIcon.Filter_Cyberware";
      case ItemFilterType.Attachments:
        return "UIIcon.Filter_Attachments";
      case ItemFilterType.Quest:
        return "UIIcon.Filter_QuestItems";
      case ItemFilterType.Buyback:
        return "UIIcon.Filter_Buyback";
      case ItemFilterType.LightWeapons:
        return "UIIcon.Filter_LightWeapons";
      case ItemFilterType.HeavyWeapons:
        return "UIIcon.Filter_HeavyWeapons";
      case ItemFilterType.MeleeWeapons:
        return "UIIcon.Filter_MeleeWeapons";
      case ItemFilterType.Hacks:
        return "UIIcon.Filter_Hacks";
    }
    return "UIIcon.Filter_AllItems";
  }
}

class CodexGameController extends gameuiMenuGameController {
  private let m_buttonHintsManagerRef: inkWidgetRef;
  private let m_entryViewRef: inkCompoundRef;
  private let m_characterEntryViewRef: inkCompoundRef;
  private let m_noEntrySelectedWidget: inkWidgetRef;
  private let m_virtualList: inkWidgetRef;
  private let m_emptyPlaceholderRef: inkWidgetRef;
  private let m_leftBlockControllerRef: inkWidgetRef;
  private let m_filtersContainer: inkCompoundRef;
  private let m_journalManager: wref<JournalManager>;
  private let m_buttonHintsController: wref<ButtonHints>;
  private let m_menuEventDispatcher: wref<inkMenuEventDispatcher>;
  private let m_listController: wref<CodexListVirtualNestedListController>;
  private let m_entryViewController: wref<CodexEntryViewController>;
  private let m_characterEntryViewController: wref<CodexEntryViewController>;
  private let m_player: wref<PlayerPuppet>;
  private let m_activeData: CodexListSyncData;
  private let m_selectedData: CodexEntryData;
  private let m_userDataEntry: Int32;
  private let m_doubleInputPreventionFlag: Bool;
  private let m_filtersControllers: [wref<CodexFilterButtonController>];
  private let m_onInputDeviceChangedCallbackID: CallbackHandle;

  protected cb func OnInitialize() -> Bool {
    let hintsWidget = this
      .SpawnFromExternal(
        inkWidgetRef.Get(this.m_buttonHintsManagerRef),
        r"base\\gameplay\\gui\\common\\buttonhints.inkwidget",
        n"Root"
      );
    this.m_buttonHintsController = hintsWidget.GetController() as ButtonHints;
    this.RefreshButtonHints();
    this.m_entryViewController = inkWidgetRef.GetController(this.m_entryViewRef) as CodexEntryViewController;
    this.m_characterEntryViewController = inkWidgetRef.GetController(this.m_characterEntryViewRef) as CodexEntryViewController;
    this.m_listController = inkWidgetRef.GetController(this.m_virtualList) as CodexListVirtualNestedListController;
    this.m_activeData = new CodexListSyncData();
    inkWidgetRef.SetVisible(this.m_entryViewRef, true);
    inkWidgetRef.SetVisible(this.m_characterEntryViewRef, false);
    this.SetupFilterButtons();
    this.PlayLibraryAnimation(n"codex_intro");
  }

  private final func SetupFilterButtons() {
    ArrayClear(this.m_filtersControllers);
    let i = 1;
    while i < 5 {
      let widget = this
        .SpawnFromLocal(inkWidgetRef.Get(this.m_filtersContainer), n"CodexFilterButton");
      let controller = widget.GetController() as CodexFilterButtonController;
      controller.Setup(IntEnum<CodexCategoryType>(i));
      ArrayPush(this.m_filtersControllers, controller);
      i += 1;
    }
  }

  private final func RefreshButtonHints() {
    this.m_buttonHintsController.ClearButtonHints();
    this
      .m_buttonHintsController
      .AddButtonHint(n"back", GetLocalizedText("Common-Access-Close"));
  }

  protected cb func OnPlayerAttach(playerPuppet: GameObject) -> Bool {
    this.m_player = playerPuppet as PlayerPuppet;
    this.m_journalManager = GameInstance.GetJournalManager(playerPuppet.GetGame());
    this
      .m_journalManager
      .RegisterScriptCallback(this, n"OnEntryVisitedUpdate", gameJournalListenerType.Visited);
    this.m_onInputDeviceChangedCallbackID = this
      .GetBlackboardSystem()
      .Get(GetAllBlackboardDefs().InputSchemes)
      .RegisterListenerUint(GetAllBlackboardDefs().InputSchemes.Device, this, n"OnInputDeviceChanged");
    this.PopulateData();
    this.SelectEntry();
  }

  protected cb func OnPlayerDetach(playerPuppet: GameObject) -> Bool {
    this.m_journalManager.UnregisterScriptCallback(this, n"OnJournalUpdate");
    if IsDefined(this.m_onInputDeviceChangedCallbackID) {
      this
        .GetBlackboardSystem()
        .Get(GetAllBlackboardDefs().InputSchemes)
        .UnregisterListenerUint(
          GetAllBlackboardDefs().InputSchemes.Device,
          this.m_onInputDeviceChangedCallbackID
        );
    }
  }

  protected cb func OnSetUserData(userData: IScriptable) -> Bool {
    this.m_userDataEntry = (userData as ShardForceSelectionEvent).m_hash;
    this.SelectEntry();
  }

  protected cb func OnInputDeviceChanged(value: Uint32) -> Bool {
    let inputDevice = IntEnum<InputDevice>(Cast<Uint8>(value));
    if Equals(this.m_selectedData.m_imageType, CodexImageType.Default) {
      let inputScheme = IntEnum<InputScheme>(
        Cast<Uint8>(
          this
            .GetBlackboardSystem()
            .Get(GetAllBlackboardDefs().InputSchemes)
            .GetUint(GetAllBlackboardDefs().InputSchemes.Scheme)
        )
      );
      this.m_entryViewController.Refresh(inputDevice, inputScheme);
    }
  }

  private final func SelectEntry() {
    if this.m_userDataEntry != 0 && this.m_listController.GetDataSize() != 0 {
      let itemIndex = this.FindItem(this.m_userDataEntry);
      if itemIndex >= 0 {
        this.ForceSelectIndex(Cast<Uint32>(itemIndex));
      }
    }
  }

  public func FindItem(hash: Int32) -> Int32 {
    let i = 0;
    while i < this.m_listController.GetDataSize() {
      let entryData = FromVariant<CodexEntryData>(this.m_listController.GetItem(Cast<Uint32>(i)));
      if entryData.m_hash == hash {
        return i;
      }
      i += 1;
    }
    return -1;
  }

  protected cb func OnUninitialize() -> Bool {
    this.m_menuEventDispatcher.UnregisterFromEvent(n"OnBack", this, n"OnBack");
  }

  protected cb func OnSetMenuEventDispatcher(menuEventDispatcher: wref<inkMenuEventDispatcher>) -> Bool {
    this.m_menuEventDispatcher = menuEventDispatcher;
    this.m_menuEventDispatcher.RegisterToEvent(n"OnBack", this, n"OnBack");
    this.m_menuEventDispatcher.RegisterToEvent(n"OnAccept", this, n"OnAccept");
  }

  protected cb func OnBack(userData: IScriptable) -> Bool {
    if !StatusEffectSystem
      .ObjectHasStatusEffectWithTag(this.GetPlayerControlledObject(), n"LockInHubMenu") {
      this.m_menuEventDispatcher.SpawnEvent(n"OnCloseHubMenu");
    }
  }

  protected cb func OnEntryVisitedUpdate(
    entryHash: Uint32,
    className: CName,
    notifyOption: JournalNotifyOption,
    changeType: JournalChangeType
  ) -> Bool {
    if Equals(className, n"gameJournalCodexEntry") || Equals(className, n"gameJournalOnscreen") {
      this.ForceSelectIndex(this.m_listController.GetSelectedIndex());
      let selectedEvent = new CodexEntrySelectedEvent();
      selectedEvent.m_hash = entryHash;
      this.QueueEvent(selectedEvent);
    }
  }

  protected cb func OnEntryActivated(evt: CodexSelectedEvent) -> Bool {
    let inputBB = this.GetBlackboardSystem().Get(GetAllBlackboardDefs().InputSchemes);
    let inputDevice = IntEnum<InputDevice>(Cast<Uint8>(inputBB.GetUint(GetAllBlackboardDefs().InputSchemes.Device)));
    let inputScheme = IntEnum<InputScheme>(Cast<Uint8>(inputBB.GetUint(GetAllBlackboardDefs().InputSchemes.Scheme)));
    if evt.m_group {
      this.m_listController.ToggleLevel(evt.m_level);
    } else {
      this.m_selectedData = evt.m_data;
      if Equals(this.m_selectedData.m_imageType, CodexImageType.Character) {
        inkWidgetRef.SetVisible(this.m_entryViewRef, false);
        inkWidgetRef.SetVisible(this.m_characterEntryViewRef, true);
        this
          .m_characterEntryViewController
          .ShowEntry(this.m_selectedData, inputDevice, inputScheme);
      } else {
        inkWidgetRef.SetVisible(this.m_entryViewRef, true);
        inkWidgetRef.SetVisible(this.m_characterEntryViewRef, false);
        this
          .m_entryViewController
          .ShowEntry(this.m_selectedData, inputDevice, inputScheme);
        this.RefreshButtonHints();
      }
    }
    this.m_activeData.m_entryHash = evt.m_entryHash;
    this.m_activeData.m_level = evt.m_level;
    this.m_activeData.m_toggledLevels = this.m_listController.GetToggledLevels();
    let selectedEntry = this.m_journalManager.GetEntry(Cast<Uint32>(this.m_activeData.m_entryHash));
    if !this.m_journalManager.IsEntryVisited(selectedEntry) {
      this.m_journalManager.SetEntryVisited(selectedEntry, true);
    }
    let syncEvent = new CodexSyncBackEvent();
    this.QueueEvent(syncEvent);
  }

  protected cb func OnCodexForceSelectionEvent(evt: CodexForceSelectionEvent) -> Bool {
    if evt.m_selectionIndex != -1 {
      this.m_listController.SelectItem(Cast<Uint32>(evt.m_selectionIndex));
      this.m_listController.ToggleItem(Cast<Uint32>(evt.m_selectionIndex));
    }
  }

  private final func ForceSelectIndex(idx: Uint32) {
    let initEvent = new CodexForceSelectionEvent();
    initEvent.m_selectionIndex = Cast<Int32>(idx);
    this.QueueEvent(initEvent);
  }

  private final func PopulateData() {
    let data = CodexUtils.GetCodexDataArray(this.m_journalManager, this.m_activeData);
    if ArraySize(data) <= 0 {
      this.ShowNodataWarning();
    } else {
      this.HideNodataWarning();
      this.m_listController.SetData(data);
    }
  }

  private final func ShowNodataWarning() {
    inkWidgetRef.SetVisible(this.m_emptyPlaceholderRef, true);
    inkWidgetRef.SetVisible(this.m_entryViewRef, false);
    inkWidgetRef.SetVisible(this.m_characterEntryViewRef, false);
    inkWidgetRef.SetVisible(this.m_leftBlockControllerRef, false);
  }

  private final func HideNodataWarning() {
    inkWidgetRef.SetVisible(this.m_emptyPlaceholderRef, false);
    inkWidgetRef.SetVisible(this.m_leftBlockControllerRef, true);
  }

  protected cb func OnCodexFilterButtonClicked(e: CodexFilterButtonClicked) -> Bool {
    let targetCategory = e.toggled ? e.category : CodexCategoryType.All;
    this.m_listController.SetFilter(targetCategory);
    let i = 0;
    while i < ArraySize(this.m_filtersControllers) {
      this.m_filtersControllers[i].UpdateSelectedCategory(targetCategory);
      i += 1;
    }
  }
}

class CodexListVirtualNestedListController extends VirtualNestedListController {
  private let m_currentDataView: wref<CodexListVirtualNestedDataView>;

  public final func SetFilter(filterType: CodexCategoryType) {
    this.m_currentDataView.SetFilter(filterType);
  }

  protected func GetDataView() -> VirtualNestedListDataView {
    let view = new CodexListVirtualNestedDataView();
    this.m_currentDataView = view;
    return view;
  }
}

class CodexListVirtualNestedDataView extends VirtualNestedListDataView {
  public let m_currentFilter: CodexCategoryType;

  public final func SetFilter(filterType: CodexCategoryType) {
    this.m_currentFilter = filterType;
    this.Filter();
    this.EnableSorting();
    this.Sort();
    this.DisableSorting();
  }

  protected func FilterItems(data: VirutalNestedListData) -> Bool {
    if Equals(this.m_currentFilter, CodexCategoryType.All) || Equals(this.m_currentFilter, CodexCategoryType.Invalid) {
      return true;
    }
    let entryData = data.m_data as CodexEntryData;
    return entryData.m_category == EnumInt(this.m_currentFilter);
  }

  protected func SortItems(
    compareBuilder: CompareBuilder,
    left: VirutalNestedListData,
    right: VirutalNestedListData
  ) {
    let leftData = left.m_data as CodexEntryData;
    let rightData = right.m_data as CodexEntryData;
    if IsDefined(leftData) && IsDefined(rightData) && left.m_isSortable && right.m_isSortable {
      let leftDataTitle = GetLocalizedText(leftData.m_title);
      let rightDataTitle = GetLocalizedText(rightData.m_title);
      compareBuilder
        .BoolTrue(leftData.m_isNew, rightData.m_isNew)
        .StringAsc(leftDataTitle, rightDataTitle);
    }
  }
}

class CodexFilterButtonController extends inkLogicController {
  protected let m_root: inkWidgetRef;
  protected let m_image: inkImageRef;
  protected let m_category: CodexCategoryType;
  protected let m_toggled: Bool;
  protected let m_hovered: Bool;

  protected cb func OnInitialize() -> Bool {
    this.RegisterToCallback(n"OnHoverOut", this, n"OnHoverOut");
    this.RegisterToCallback(n"OnHoverOver", this, n"OnHoverOver");
    this.RegisterToCallback(n"OnRelease", this, n"OnClicked");
  }

  public final func Setup(category: CodexCategoryType) {
    this.m_category = category;
    InkImageUtils
      .RequestSetImage(this, this.m_image, CodexUtils.GetCodexFilterIcon(category));
  }

  public final func UpdateSelectedCategory(selectedCategory: CodexCategoryType) {
    if NotEquals(this.m_category, selectedCategory) {
      this.m_toggled = false;
    }
    this.UpdateState();
  }

  protected cb func OnHoverOut(e: inkPointerEvent) -> Bool {
    this.m_hovered = false;
    this.UpdateState();
  }

  protected cb func OnHoverOver(e: inkPointerEvent) -> Bool {
    this.m_hovered = true;
    this.UpdateState();
  }

  protected cb func OnClicked(e: inkPointerEvent) -> Bool {
    if e.IsAction(n"click") {
      this.m_toggled = !this.m_toggled;
      let evt = new CodexFilterButtonClicked();
      evt.category = this.m_category;
      evt.toggled = this.m_toggled;
      this.QueueEvent(evt);
      this.UpdateState();
    }
  }

  protected final func UpdateState() {
    if this.m_hovered {
      inkWidgetRef.SetState(this.m_root, n"Hover");
    } else if this.m_toggled {
      inkWidgetRef.SetState(this.m_root, n"Active");
    } else {
      inkWidgetRef.SetState(this.m_root, n"Default");
    }
  }
}

class CodexFilterButtonClicked extends Event {
  public let category: CodexCategoryType;
  public let toggled: Bool;
}

class CodexForceSelectionEvent extends Event {
  public let m_selectionIndex: Int32;
  public let m_hash: Int32;
}

public native func Cast(a: Uint32) -> Uint8;

class CodexSyncBackEvent extends Event {
}

class SettingsSelectorControllerListInt extends SettingsSelectorControllerList {
  public func Setup(entry: ConfigVar, isPreGame: Bool) {
    super.Setup(entry, isPreGame);
    let value = this.m_SettingsEntry as ConfigVarListInt;
    let data = value.GetValues();
    this.PopulateDots(ArraySize(data));
    this.SelectDot(value.GetIndex());
  }

  private func ChangeValue(forward: Bool) {
    let value = this.m_SettingsEntry as ConfigVarListInt;
    let listElements = value.GetValues();
    let index = value.GetIndex();
    let newIndex = index + (forward ? 1 : -1);
    if newIndex < 0 {
      newIndex = ArraySize(listElements) - 1;
    } else if newIndex >= ArraySize(listElements) {
      newIndex = 0;
    }
    if index != newIndex {
      value.SetIndex(newIndex);
    }
  }

  public func Refresh() {
    super.Refresh();
    let value = this.m_SettingsEntry as ConfigVarListInt;
    let index = value.GetIndex();
    this.UpdateValueTextLanguageResources();
    if !value.ListHasDisplayValues() {
      inkTextRef.SetText(this.m_ValueText, IntToString(value.GetValue()));
    } else {
      inkTextRef
        .SetText(this.m_ValueText, GetLocalizedTextByKey(value.GetDisplayValue(index)));
    }
    this.SelectDot(index);
  }
}

class IsAssignedVehicleAV extends PreventionConditionAbstract {
  protected func Check(context: ScriptExecutionContext) -> AIbehaviorConditionOutcomes {
    let puppet = AIBehaviorScriptBase.GetPuppet(context);
    let gameInstance = puppet.GetGame();
    if IsDefined(puppet) {
      let assignedVehicleID = puppet.GetAIControllerComponent().GetAssignedVehicleId();
      let vehicleObject = GameInstance.FindEntityByID(gameInstance, assignedVehicleID) as VehicleObject;
      if IsDefined(vehicleObject) && vehicleObject == vehicleObject as AVObject {
        return AIbehaviorConditionOutcomes.True;
      }
    }
    return AIbehaviorConditionOutcomes.False;
  }
}

class ItemCategoryFliterManager extends IScriptable {
  private let m_filtersToCheck: [ItemFilterCategory];
  private let m_filters: [ItemFilterCategory];
  private let m_sharedFiltersToCheck: [ItemFilterCategory];
  private let m_isOrderDirty: Bool;

  public final static func Make(opt skipDefaultFilters: Bool) -> ItemCategoryFliterManager {
    let instance = new ItemCategoryFliterManager();
    ArrayClear(instance.m_filters);
    ArrayClear(instance.m_filtersToCheck);
    ArrayClear(instance.m_sharedFiltersToCheck);
    if !skipDefaultFilters {
      let i = 0;
      while i < 10 {
        ArrayPush(instance.m_filtersToCheck, IntEnum<ItemFilterCategory>(i));
        i += 1;
      }
    }
    return instance;
  }

  public final func AddItem(itemData: wref<gameItemData>) {
    let i = 0;
    if i < ArraySize(this.m_sharedFiltersToCheck) {
      if ItemCategoryFliter.IsOfCategoryType(this.m_sharedFiltersToCheck[i], itemData) {
        if !ArrayContains(this.m_filters, this.m_sharedFiltersToCheck[i]) {
          ArrayPush(this.m_filters, this.m_sharedFiltersToCheck[i]);
        }
        ArrayErase(this.m_sharedFiltersToCheck, i);
        this.m_isOrderDirty = true;
        i += 1;
      }
    }
    i = 0;
    while i < ArraySize(this.m_filtersToCheck) {
      if ItemCategoryFliter.IsOfCategoryType(this.m_filtersToCheck[i], itemData) {
        if !ArrayContains(this.m_filters, this.m_filtersToCheck[i]) {
          ArrayPush(this.m_filters, this.m_filtersToCheck[i]);
        }
        ArrayRemove(this.m_filtersToCheck, this.m_filtersToCheck[i]);
        this.m_isOrderDirty = true;
        return;
      }
      i += 1;
    }
  }

  public final func AddItem(itemCategory: ItemFilterCategory) {
    let i = 0;
    while i < ArraySize(this.m_filtersToCheck) {
      if Equals(this.m_filtersToCheck[i], itemCategory) {
        ArrayPush(this.m_filters, this.m_filtersToCheck[i]);
        ArrayErase(this.m_filtersToCheck, i);
        this.m_isOrderDirty = true;
        return;
      }
      i += 1;
    }
  }

  public final func GetAt(index: Int32) -> ItemFilterCategory {
    if index >= 0 && index < ArraySize(this.m_filters) {
      return this.m_filters[index];
    }
    return ItemFilterCategory.Invalid;
  }

  public final func Contains(category: ItemFilterCategory) -> Bool {
    return ArrayContains(this.m_filters, category);
  }

  public final func GetFiltersList() -> [ItemFilterCategory] {
    let fallbackResult: [ItemFilterCategory];
    if ArraySize(this.m_filters) == 0 {
      ArrayPush(fallbackResult, ItemFilterCategory.AllItems);
      return fallbackResult;
    }
    return this.m_filters;
  }

  public final func GetFiltersListSize() -> Int32 {
    return ArraySize(this.m_filters);
  }

  public final func SortFiltersList() {
    let result: [ItemFilterCategory];
    if this.m_isOrderDirty {
      let i = 0;
      while i < 15 {
        if ArrayContains(this.m_filters, IntEnum<ItemFilterCategory>(i)) {
          ArrayPush(result, IntEnum<ItemFilterCategory>(i));
        }
        i += 1;
      }
      this.m_filters = result;
      this.m_isOrderDirty = false;
    }
  }

  public final func GetSortedFiltersList() -> [ItemFilterCategory] {
    this.SortFiltersList();
    return this.GetFiltersList();
  }

  public final func GetIntFiltersList() -> [Int32] {
    let result: [Int32];
    let filters = this.GetFiltersList();
    let i = 0;
    while i < ArraySize(filters) {
      ArrayPush(result, EnumInt(filters[i]));
      i += 1;
    }
    return result;
  }

  public final func GetSortedIntFiltersList() -> [Int32] {
    this.SortFiltersList();
    return this.GetIntFiltersList();
  }

  public final func InsertFilter(position: Int32, filter: ItemFilterCategory) {
    ArrayRemove(this.m_filters, filter);
    ArrayInsert(this.m_filters, position, filter);
  }

  public final func Clear(opt skipDefaultFilters: Bool) {
    ArrayClear(this.m_filters);
    ArrayClear(this.m_sharedFiltersToCheck);
    ArrayClear(this.m_filtersToCheck);
    if !skipDefaultFilters {
      let i = 0;
      while i < 10 {
        ArrayPush(this.m_filtersToCheck, IntEnum<ItemFilterCategory>(i));
        i += 1;
      }
    }
  }

  public final func AddFilter(filter: ItemFilterCategory) {
    if !ArrayContains(this.m_filters, filter) {
      ArrayPush(this.m_filters, filter);
      this.m_isOrderDirty = true;
    }
  }

  private final func IsSharedFilter(filter: ItemFilterCategory) -> Bool {
    return Equals(filter, ItemFilterCategory.Quest);
  }

  public final func AddFilterToCheck(filter: ItemFilterCategory) {
    if this.IsSharedFilter(filter) {
      ArrayPush(this.m_sharedFiltersToCheck, filter);
      return;
    }
    ArrayPush(this.m_filtersToCheck, filter);
  }

  public final func RemvoeFilterToCheck(filter: ItemFilterCategory) {
    if this.IsSharedFilter(filter) {
      ArrayRemove(this.m_sharedFiltersToCheck, filter);
      return;
    }
    ArrayRemove(this.m_filtersToCheck, filter);
  }
}

