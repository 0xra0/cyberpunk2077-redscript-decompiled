public func TSQ_ALL() -> TargetSearchQuery {
  let tsq: TargetSearchQuery;
  return tsq;
}

public func TSQ_NPC() -> TargetSearchQuery {
  let tsq: TargetSearchQuery;
  tsq.searchFilter = TSF_NPC();
  return tsq;
}

public func TSF_NPC() -> TargetSearchFilter {
  let tsf = TSF_And(TSF_All(IntEnum<TSFMV>(2050)), TSF_Not(TSFMV.Obj_Player));
  return tsf;
}

