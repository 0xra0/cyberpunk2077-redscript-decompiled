importonly native class AIGameDifficultyCond_Record extends AIActionSubCondition_Record {
  public final native func ComparisonType() -> CName;

  public final native func ComparedDifficulty() -> Int32;
}

public func ProcessCompareInt(comparator: EComparisonType, valA: Int32, valB: Int32) -> Bool {
  switch comparator {
    case EComparisonType.Greater:
      return valA > valB;
    case EComparisonType.GreaterOrEqual:
      return valA >= valB;
    case EComparisonType.Equal:
      return valA == valB;
    case EComparisonType.NotEqual:
      return valA != valB;
    case EComparisonType.Less:
      return valA < valB;
  }
  return valA <= valB;
}

