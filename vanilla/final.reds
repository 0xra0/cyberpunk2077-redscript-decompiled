    let crackActionRecord = TweakDBInterface.GetCrackActionRecord(this.GetObjectActionID());
    let effector = crackActionRecord.Effector().GetID();
    GameInstance
      .GetEffectorSystem(gameInstance)
      .ApplyEffector(
        this.GetExecutor().GetEntityID(),
        this.GetExecutor(),
        effector,
        ItemID.GetTDBID(this.GetItemData().GetID())
      );
  }
}

