class AOEEffector extends ActivatedDeviceTransfromAnim {
  protected cb func OnRequestComponents(ri: EntityRequestComponentsInterface) -> Bool {
    super.OnRequestComponents(ri);
  }

  protected cb func OnTakeControl(ri: EntityResolveComponentsInterface) -> Bool {
    super.OnTakeControl(ri);
    this.m_controller = EntityResolveComponentsInterface.GetComponent(ri, n"controller") as AOEEffectorController;
  }

  protected cb func OnGameAttached() -> Bool {
    super.OnGameAttached();
    if Equals(this.GetDeviceState(), EDeviceStatus.ON) {
      this.StartEffects();
    } else {
      this.BreakEffects();
    }
  }

  protected const func GetController() -> AOEEffectorController {
    return this.m_controller as AOEEffectorController;
  }

  public const func GetDevicePS() -> AOEEffectorControllerPS {
    return this.GetController().GetPS();
  }

  protected func PushPersistentData() {
    super.PushPersistentData();
  }

  protected cb func OnToggleAOEEffect(evt: ToggleAOEEffect) -> Bool {
    if Equals(this.GetDeviceState(), EDeviceStatus.ON) {
      this.StartEffects();
    } else {
      this.BreakEffects();
    }
    this.SetGameplayRoleToNone();
  }

  protected final func StartEffects() {
    let effects = this.GetDevicePS().GetEffectsToPlay();
    let i = 0;
    while i < ArraySize(effects) {
      GameObject.StartReplicatedEffectEvent(this, effects[i]);
      i += 1;
    }
  }

  protected final func BreakEffects() {
    let effects = this.GetDevicePS().GetEffectsToPlay();
    let i = 0;
    while i < ArraySize(effects) {
      GameObject.BreakReplicatedEffectLoopEvent(this, effects[i]);
      i += 1;
    }
  }

  public const func DeterminGameplayRole() -> EGameplayRole {
    return EGameplayRole.SpreadGas;
  }

  public const func IsGameplayRelevant() -> Bool {
    return true;
  }
}

class AOEEffectorController extends ScriptableDeviceComponent {
  public const func GetPS() -> AOEEffectorControllerPS {
    return this.GetBasePS() as AOEEffectorControllerPS;
  }
}

class AOEEffectorControllerPS extends ActivatedDeviceControllerPS {
  protected const persistent let m_effectsToPlay: [CName];

  private final func ActionToggleAOEEffect() -> ToggleAOEEffect {
    let action = new ToggleAOEEffect();
    action.clearanceLevel = 1;
    action.SetUp(this);
    action.SetProperties();
    action.AddDeviceName(this.m_deviceName);
    action.CreateActionWidgetPackage();
    return action;
  }

  public final func GetEffectsToPlay() -> [CName] {
    return this.m_effectsToPlay;
  }

  public func GetActions(out actions: [DeviceAction], context: GetActionsContext) -> Bool {
    ArrayPush(actions, this.ActionToggleAOEEffect());
    this.SetActionIllegality(actions, this.m_illegalActions.regularActions);
    return true;
  }

  public final func OnToggleAOEEffect(evt: ToggleAOEEffect) -> EntityNotificationType {
    let notifier = new ActionNotifier();
    notifier.SetNone();
    if this.IsON() {
      this.SetDeviceState(EDeviceStatus.OFF);
    } else {
      this.SetDeviceState(EDeviceStatus.ON);
    }
    this.Notify(notifier, evt);
    return EntityNotificationType.SendThisEventToEntity;
  }
}

class ToggleAOEEffect extends ActionBool {
  public final func SetProperties() {
    this.actionName = n"ToggleAOEEffect";
    this.prop = DeviceActionPropertyFunctions
      .SetUpProperty_Bool(n"ToggleAOEEffect", true, n"LocKey#17809", n"LocKey#17809");
  }

  public final static func IsDefaultConditionMet(device: ScriptableDeviceComponentPS, const context: script_ref<GetActionsContext>) -> Bool {
    return true;
  }
}

