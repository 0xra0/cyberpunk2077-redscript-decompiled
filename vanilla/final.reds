class WaitForEquipDecisions extends UpperBodyTransition {
  protected const func ToSingleWield(const stateContext: StateContext, const scriptInterface: StateGameScriptInterface) -> Bool {
    return IsDefined(DefaultTransition.GetActiveWeapon(scriptInterface));
  }

  protected const final func ToEmptyHands(const stateContext: StateContext, const scriptInterface: StateGameScriptInterface) -> Bool {
    return this.GetInStateTime() > 2.0;
  }
}

class WaitForEquipEvents extends UpperBodyEventsTransition {
  protected func OnEnter(stateContext: StateContext, scriptInterface: StateGameScriptInterface) {
    this
      .SendEquipmentSystemWeaponManipulationRequest(scriptInterface, EquipmentManipulationAction.ReequipWeapon);
  }
}

class AdHocAnimationDecisions extends UpperBodyEventsTransition {
  protected const final func EnterCondition(const stateContext: StateContext, const scriptInterface: StateGameScriptInterface) -> Bool {
    let blackboardSystem = scriptInterface.GetBlackboardSystem();
    let blackboard = blackboardSystem.Get(GetAllBlackboardDefs().AdHocAnimation);
    if blackboard.GetBool(GetAllBlackboardDefs().AdHocAnimation.IsActive) {
      return true;
    }
    return false;
  }

  protected const func ToSingleWield(const stateContext: StateContext, const scriptInterface: StateGameScriptInterface) -> Bool {
    if this.GetInStateTime()
      > this.GetAnimationDuration(scriptInterface)
      && DefaultTransition.HasRightWeaponEquipped(scriptInterface) {
      return true;
    }
    return false;
  }

  protected const func ToEmptyHands(const stateContext: StateContext, const scriptInterface: StateGameScriptInterface) -> Bool {
    if this.GetInStateTime()
      > this.GetAnimationDuration(scriptInterface)
      && !DefaultTransition.HasRightWeaponEquipped(scriptInterface) {
      return true;
    }
    return false;
  }

  private const final func GetAnimationDuration(const scriptInterface: StateGameScriptInterface) -> Float {
    let blackboardSystem = scriptInterface.GetBlackboardSystem();
    let blackboard = blackboardSystem.Get(GetAllBlackboardDefs().AdHocAnimation);
    let blackboardAnimationDuration = blackboard.GetFloat(GetAllBlackboardDefs().AdHocAnimation.AnimationDuration);
    return blackboardAnimationDuration == -1.0 ? this.GetStaticFloatParameterDefault("animDuration", 2.0) : blackboardAnimationDuration;
  }
}

class VehiclePassengerContextDecisions extends VehicleGameplayContextDecisions {
  protected const func EnterCondition(const stateContext: StateContext, const scriptInterface: StateGameScriptInterface) -> Bool {
    let isVehicleRemoteControlled = this.IsVehicleRemoteControlled(scriptInterface);
    if isVehicleRemoteControlled {
      return false;
    }
    return true;
  }

  protected const func ExitCondition(const stateContext: StateContext, const scriptInterface: StateGameScriptInterface) -> Bool {
    let currentState = scriptInterface.localBlackboard.GetInt(GetAllBlackboardDefs().PlayerStateMachine.Vehicle);
    let isVehicleRemoteControlled = this.IsVehicleRemoteControlled(scriptInterface);
    if currentState == 0 {
      return true;
    } else if currentState != 7 && currentState != 3 {
      return true;
    } else if isVehicleRemoteControlled {
      return true;
    }
    return false;
  }
}

