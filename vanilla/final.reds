class BaseBunkerComputerGameController extends gameuiBaseBunkerComputerGameController {
  public let m_factsSet: BunkerSystemsFactsSet;
  public let m_gateClosedFact: CName;

  protected final func GetGame() -> GameInstance {
    let gameInstance: GameInstance;
    let gameObject = this.GetOwnerEntity() as GameObject;
    if IsDefined(gameObject) {
      gameInstance = gameObject.GetGame();
    }
    return gameInstance;
  }

  protected final func SetStatusOffline(controller: wref<inkLogicController>, fact: CName) {
    this.SetStatusOffline(controller, GetFact(this.GetGame(), fact) > 0);
  }

  protected final func SetStatusOffline(controller: wref<inkLogicController>, isOffline: Bool) {
    let isGateClosed = GetFact(this.GetGame(), this.m_gateClosedFact) > 0;
    let statusController = controller as SystemStatusLogicController;
    if IsDefined(statusController) {
      statusController.SetOffline(isOffline, isGateClosed);
    }
  }

  protected final func GetCurrentSystem() -> BunkerSystems {
    let sysIndex = GetFact(this.GetGame(), n"q305_server_index");
    let system = BunkerSystems.MAX;
    if sysIndex >= 0 && sysIndex < 4 {
      system = IntEnum<BunkerSystems>(sysIndex);
    }
    return system;
  }

  protected final func GetCurrentSystemFact(factsSet: script_ref<BunkerSystemsFactsSet>) -> CName {
    let fact: CName;
    let system = this.GetCurrentSystem();
    if NotEquals(system, BunkerSystems.MAX) {
      switch system {
        case BunkerSystems.ALPHA:
          fact = factsSet.ALPHA_FACT;
          break;
        case BunkerSystems.BRAVO:
          fact = factsSet.BRAVO_FACT;
          break;
        case BunkerSystems.SIERRA:
          fact = factsSet.SIERRA_FACT;
          break;
        case BunkerSystems.VICTOR:
          fact = factsSet.VICTOR_FACT;
          return fact;
      }
    }
  }
}

class SystemStatusLogicController extends inkLogicController {
  public let m_onlineRoot: inkWidgetRef;
  public let m_offlineRoot: inkWidgetRef;
  public let m_onlineIco: inkWidgetRef;
  public let m_offlineIco: inkWidgetRef;
  public let m_sysIndicator: inkWidgetRef;
  public let m_statusBackground: inkWidgetRef;
  public let m_statusBackgroundProxy: inkAnimProxy;
  public let m_stateAnimName: CName;
  public const let m_widgetsToColor: [inkWidgetRef];
  public const let m_textStatuses: [inkTextRef];

  protected cb func OnInitialize() -> Bool {
    this.GetRootWidget().SetVisible(false);
    this
      .PlayStateAnim(
        inkWidgetRef.Get(this.m_onlineIco),
        inkWidgetRef.Get(this.m_sysIndicator),
        inkWidgetRef.Get(this.m_offlineIco)
      );
  }

  public final func SetOffline(offline: Bool, isGateClosed: Bool) {
    let offlineName = n"Offline";
    let onlineName = n"Online";
    inkWidgetRef.SetVisible(this.m_onlineRoot, !offline);
    inkWidgetRef.SetVisible(this.m_offlineRoot, offline);
    let count = ArraySize(this.m_widgetsToColor);
    let i = 0;
    while i < count {
      inkWidgetRef.SetState(this.m_widgetsToColor[i], offline ? offlineName : onlineName);
      i = i + 1;
    }
    count = ArraySize(this.m_textStatuses);
    i = 0;
    while i < count {
      inkTextRef
        .SetLocalizedTextScript(this.m_textStatuses[i], offline ? "LocKey#93580" : "LocKey#93579");
      i = i + 1;
    }
    this.m_statusBackgroundProxy.Stop();
    if isGateClosed && !offline {
      this.m_statusBackgroundProxy = this.PlayStateAnim(inkWidgetRef.Get(this.m_statusBackground), null, null);
    }
    this.GetRootWidget().SetVisible(true);
  }

  private final func PlayStateAnim(target1: inkWidget, target2: inkWidget, target3: inkWidget) -> inkAnimProxy {
    let playbackOptions: inkAnimOptions;
    if NotEquals(this.m_stateAnimName, n"None") {
      let targets = new inkWidgetsSet();
      if IsDefined(target1) {
        targets.Select(target1);
      } else if IsDefined(target2) {
        targets.Select(target2);
      } else if IsDefined(target3) {
        targets.Select(target3);
      }
      playbackOptions.loopType = inkanimLoopType.Cycle;
      playbackOptions.loopInfinite = true;
      return this
        .PlayLibraryAnimationOnTargets(this.m_stateAnimName, targets, playbackOptions);
    }
    return null;
  }
}

