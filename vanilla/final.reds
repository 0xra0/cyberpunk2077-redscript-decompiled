class GetRandomThreat extends AIRandomTasks {
  public let m_outThreatArgument: AIArgumentMapping;

  protected func Activate(context: ScriptExecutionContext) {
    let threats = ScriptExecutionContext
      .GetOwner(context)
      .GetTargetTracker()
      .GetThreats(false);
    if ArraySize(threats) > 0 {
      let chosenIndex = this.RollInteger(ArraySize(threats), 0);
      let chosenThreat = threats[chosenIndex].entity as GameObject;
      ScriptExecutionContext
        .SetMappingValue(context, this.m_outThreatArgument, ToVariant(chosenThreat));
    }
  }
}

