    if IsDefined(puppet) && puppet.IsBoss() {
      GameObjectEffectHelper.BreakEffectLoopEvent(this, n"fx_candles_lightup");
    }
  }
}

abstract class AISubActionSetStimSource_Record_Implementation extends IScriptable {
  public final static func Activate(context: ScriptExecutionContext, record: wref<AISubActionSetStimSource_Record>) {
    if record.Delay() == 0.0 {
      AISubActionSetStimSource_Record_Implementation.SetStimSource(context, record);
    }
  }

  public final static func Update(
    context: ScriptExecutionContext,
    record: wref<AISubActionSetStimSource_Record>,
    const duration: Float
  ) -> AIbehaviorUpdateOutcome {
    if record.Delay() <= 0.0 {
      return AIbehaviorUpdateOutcome.SUCCESS;
    } else if record.Delay() > 0.0 && duration >= record.Delay() {
      AISubActionSetStimSource_Record_Implementation.SetStimSource(context, record);
      return AIbehaviorUpdateOutcome.SUCCESS;
    }
    return AIbehaviorUpdateOutcome.IN_PROGRESS;
  }

  public final static func Deactivate(
    context: ScriptExecutionContext,
    record: wref<AISubActionSetStimSource_Record>,
    const duration: Float,
    interrupted: Bool
  ) {
    if record.Delay() < 0.0 {
      AISubActionSetStimSource_Record_Implementation.SetStimSource(context, record);
    }
  }

  public final static func SetStimSource(context: ScriptExecutionContext, record: wref<AISubActionSetStimSource_Record>) {
    let object: wref<GameObject>;
    let position: Vector4;
    let puppet: wref<ScriptedPuppet>;
    let closestDistance: Float;
    if record.UseInvestigateData() {
      puppet = ScriptExecutionContext.GetOwner(context) as ScriptedPuppet;
      let investigateData = puppet.GetStimReactionComponent().GetActiveReactionData().stimInvestigateData;
      let investigationPositions = (investigateData.controllerEntity as Device).GetNodePosition();
      let i = 0;
      while i < ArraySize(investigationPositions) {
        let distance = Vector4
          .Distance(
            investigationPositions[i],
            ScriptExecutionContext.GetOwner(context).GetWorldPosition()
          );
        if distance < closestDistance || closestDistance == 0.0 {
          closestDistance = distance;
          position = investigationPositions[i];
        }
        i += 1;
      }
      if !Vector4.IsZero(position) {
        AISubActionSetStimSource_Record_Implementation.SetStimSourcePosition(context, record, position);
      } else {
        AISubActionSetStimSource_Record_Implementation
          .SetStimSourcePosition(context, record, investigateData.controllerEntity.GetWorldPosition());
      }
      ScriptExecutionContext
        .SetArgumentObject(context, n"StimTarget", investigateData.controllerEntity as GameObject);
    } else if record.StimTarget().IsObject() {
      if AIActionTarget.GetObject(context, record.StimTarget(), object) {
        ScriptExecutionContext.SetArgumentObject(context, n"StimTarget", object);
        AISubActionSetStimSource_Record_Implementation.SetStimSourcePosition(context, record, object.GetWorldPosition());
      }
    } else if record.StimTarget().IsPosition() {
      if AIActionTarget.GetPosition(context, record.StimTarget(), position, false) {
        AISubActionSetStimSource_Record_Implementation.SetStimSourcePosition(context, record, position);
      }
    } else {
      puppet = ScriptExecutionContext.GetOwner(context) as ScriptedPuppet;
      let reactionData = puppet.GetStimReactionComponent().GetDesiredReactionData();
      ScriptExecutionContext.SetArgumentObject(context, n"StimTarget", reactionData.stimTarget);
      AISubActionSetStimSource_Record_Implementation.SetStimSourcePosition(context, record, reactionData.stimSource);
    }
  }

  private final static func SetStimSourcePosition(
    context: ScriptExecutionContext,
    record: wref<AISubActionSetStimSource_Record>,
    position: Vector4
  ) {
    if record.RevertStimSourceDirection() {
      position = 2.0 * ScriptExecutionContext.GetOwner(context).GetWorldPosition() - position;
    }
    ScriptExecutionContext.SetArgumentVector(context, n"StimSource", position);
  }
}

importonly native class AISubActionSetStimSource_Record extends AISubAction_Record {
  public final native func StimTarget() -> wref<AIActionTarget_Record>;

  public final native func StimTargetHandle() -> AIActionTarget_Record;

