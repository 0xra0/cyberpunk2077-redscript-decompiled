struct SWidgetPackageBase {
  public let libraryPath: ResRef;
  public let libraryID: CName;
  public let widgetTweakDBID: TweakDBID;
  public let widget: wref<inkWidget>;
  public let widgetName: String;
  public let placement: EWidgetPlacementType;
  public let orientation: inkEOrientation;
  public let isValid: Bool;

  public final static func ResolveWidgetTweakDBData(widgetTweakDBID: TweakDBID, out id: CName, out path: ResRef) -> Bool {
    if TDBID.IsValid(widgetTweakDBID) {
      let record = TweakDBInterface.GetWidgetDefinitionRecord(widgetTweakDBID);
      if record != null {
        path = record.LibraryPath();
        id = StringToName(record.LibraryID());
        return true;
      }
    }
    return false;
  }

  public final static func GetLibraryPath(widgetDef: WidgetDefinition_Record) -> ResRef {
    return widgetDef.LibraryPath();
  }

  public final static func GetLibraryID(
    widgetDef: WidgetDefinition_Record,
    screenTypeDef: DeviceScreenType_Record,
    styleDef: WidgetStyle_Record
  ) -> String {
    let id: String;
    let styles: [wref<WidgetStyle_Record>];
    let ratios: [wref<WidgetRatio_Record>];
    if !IsDefined(widgetDef) {
      return id;
    }
    id = widgetDef.LibraryID();
    widgetDef.Styles(styles);
    widgetDef.Ratios(ratios);
    let i = 0;
    while i < ArraySize(styles) {
      if Equals(styleDef.Type(), styles[i].Type()) {
        id += "_" + styles[i].EnumName();
      }
      i += 1;
    }
    if IsDefined(screenTypeDef) {
      if widgetDef.UseContentRatio() {
        let contentRatio = screenTypeDef.ContentRatio();
      } else if IsDefined(contentRatio) {
        let expectedRatio = contentRatio.EnumName();
      }
      expectedRatio = screenTypeDef.Ratio().EnumName();
      i = 0;
      while i < ArraySize(ratios) {
        if Equals(expectedRatio, ratios[i].EnumName()) {
          id += "_" + ratios[i].EnumName();
        }
        i += 1;
      }
    }
    return id;
  }

  public final static func GetLibraryIDPackage(
    widgetDef: WidgetDefinition_Record,
    screenTypeDef: DeviceScreenType_Record,
    styleDef: WidgetStyle_Record
  ) -> [String] {
    let styles: [wref<WidgetStyle_Record>];
    let ratios: [wref<WidgetRatio_Record>];
    let idPackage: [String];
    let idpart2: String;
    let idpart3: String;
    if !IsDefined(widgetDef) {
      return idPackage;
    }
    let idpart1 = widgetDef.LibraryID();
    widgetDef.Styles(styles);
    widgetDef.Ratios(ratios);
    let fullID = idpart1;
    let i = 0;
    if i < ArraySize(styles) {
      if Equals(styleDef.Type(), styles[i].Type()) {
        idpart2 = styles[i].EnumName();
        fullID += "_" + idpart2;
      } else {
        i += 1;
      }
    } else if IsDefined(screenTypeDef) {
      if widgetDef.UseContentRatio() {
        let contentRatio = screenTypeDef.ContentRatio();
      } else if IsDefined(contentRatio) {
        let expectedRatio = contentRatio.EnumName();
      }
      expectedRatio = screenTypeDef.Ratio().EnumName();
      i = 0;
      if i < ArraySize(ratios) {
        if Equals(expectedRatio, ratios[i].EnumName()) {
          idpart3 = ratios[i].EnumName();
          fullID += "_" + idpart3;
        }
        i += 1;
      }
    }
    ArrayPush(idPackage, fullID);
    if IsStringValid(idpart2) {
      ArrayPush(idPackage, idpart1 + "_" + idpart2);
    } else if IsStringValid(idpart3) {
      ArrayPush(idPackage, idpart1 + "_" + idpart3);
    }
    ArrayPush(idPackage, idpart1);
    return idPackage;
  }
}

