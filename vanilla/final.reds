class CyberdeckInventoryStatsController extends inkLogicController {
  public let m_bufferTotal: inkTextRef;
  public let m_bufferBase: inkTextRef;
  public let m_bufferBonus: inkTextRef;
  public let m_bufferHoverArea: inkWidgetRef;
  public let m_bufferTooltipPlacement: gameuiETooltipPlacement;
  public let m_ramTotal: inkTextRef;
  public let m_ramBase: inkTextRef;
  public let m_ramBonus: inkTextRef;
  public let m_ramHoverArea: inkWidgetRef;
  public let m_ramTooltipPlacement: gameuiETooltipPlacement;
  private let m_tooltipsManager: wref<gameuiTooltipsManager>;

  protected cb func OnInitialize() -> Bool {
    inkWidgetRef
      .RegisterToCallback(this.m_bufferHoverArea, n"OnHoverOver", this, n"OnBufferHoverOver");
    inkWidgetRef
      .RegisterToCallback(this.m_bufferHoverArea, n"OnHoverOut", this, n"OnHoverOut");
    inkWidgetRef
      .RegisterToCallback(this.m_ramHoverArea, n"OnHoverOver", this, n"OnRamHoverOver");
    inkWidgetRef
      .RegisterToCallback(this.m_ramHoverArea, n"OnHoverOut", this, n"OnHoverOut");
  }

  protected cb func OnUninitialize() -> Bool {
    inkWidgetRef
      .UnregisterFromCallback(this.m_bufferHoverArea, n"OnHoverOver", this, n"OnBufferHoverOver");
    inkWidgetRef
      .UnregisterFromCallback(this.m_bufferHoverArea, n"OnHoverOut", this, n"OnHoverOut");
    inkWidgetRef
      .UnregisterFromCallback(this.m_ramHoverArea, n"OnHoverOver", this, n"OnRamHoverOver");
    inkWidgetRef
      .UnregisterFromCallback(this.m_ramHoverArea, n"OnHoverOut", this, n"OnHoverOut");
  }

  public final func SetupData(
    tweakID: TweakDBID,
    player: wref<PlayerPuppet>,
    tooltipsManager: wref<gameuiTooltipsManager>
  ) {
    let cyberdeckBufferValue: Int32;
    let cyberdeckMemoryValue: Int32;
    let onEquipList: [wref<GameplayLogicPackage_Record>];
    let statsList: [wref<StatModifier_Record>];
    this.m_tooltipsManager = tooltipsManager;
    let tweakRecord = TweakDBInterface.GetItemRecord(tweakID);
    tweakRecord.OnEquip(onEquipList);
    let i = 0;
    while i < ArraySize(onEquipList) {
      onEquipList[i].Stats(statsList);
      let j = 0;
      while j < ArraySize(statsList) {
        let statType = statsList[j].StatType();
        let stat = statsList[j] as ConstantStatModifier_Record;
        if IsDefined(stat) {
          if Equals(statType.StatType(), gamedataStatType.Memory) {
            cyberdeckMemoryValue = RoundMath(stat.Value());
          } else if Equals(statType.StatType(), gamedataStatType.BufferSize) {
            cyberdeckBufferValue = RoundMath(stat.Value());
          }
        }
        j += 1;
      }
      i += 1;
    }
    let playerBufferValue = RoundMath(
      GameInstance
        .GetStatsSystem(player.GetGame())
        .GetStatValue(Cast<StatsObjectID>(player.GetEntityID()), gamedataStatType.BufferSize)
    );
    let playerMemoryValue = RoundMath(
      GameInstance
        .GetStatPoolsSystem(player.GetGame())
        .GetStatPoolValue(
          Cast<StatsObjectID>(player.GetEntityID()),
          gamedataStatPoolType.Memory,
          false
        )
    );
    inkTextRef.SetText(this.m_bufferTotal, IntToString(playerBufferValue));
    inkTextRef
      .SetText(this.m_bufferBase, IntToString(playerBufferValue - cyberdeckBufferValue));
    inkTextRef.SetText(this.m_bufferBonus, IntToString(cyberdeckBufferValue));
    inkTextRef.SetText(this.m_ramTotal, IntToString(playerMemoryValue));
    inkTextRef
      .SetText(this.m_ramBase, IntToString(playerMemoryValue - cyberdeckMemoryValue));
    inkTextRef.SetText(this.m_ramBonus, IntToString(cyberdeckMemoryValue));
  }

  protected cb func OnBufferHoverOver(evt: inkPointerEvent) -> Bool {
    let messageData = new MessageTooltipData();
    messageData.Title = GetLocalizedItemNameByCName(n"UI-Inventory-Cyberdeck-BufferTooltip");
    this
      .m_tooltipsManager
      .ShowTooltipAtWidget(
        0,
        inkWidgetRef.Get(this.m_bufferHoverArea),
        messageData,
        this.m_bufferTooltipPlacement
      );
  }

  protected cb func OnRamHoverOver(evt: inkPointerEvent) -> Bool {
    let messageData = new MessageTooltipData();
    messageData.Title = GetLocalizedItemNameByCName(n"UI-Inventory-Cyberdeck-RamTooltip");
    this
      .m_tooltipsManager
      .ShowTooltipAtWidget(
        0,
        inkWidgetRef.Get(this.m_ramHoverArea),
        messageData,
        this.m_ramTooltipPlacement
      );
  }

  protected cb func OnHoverOut(evt: inkPointerEvent) -> Bool {
    this.m_tooltipsManager.HideTooltips();
  }
}

