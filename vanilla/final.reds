            evt.type,
            evt.currentLevel,
            evt.isLevelMaxed
          );
        break;
      case gamedataProficiencyType.CoolSkill:
        this
          .AddToNotificationQueue(
            evt.expValue,
            evt.remainingXP,
            evt.delta,
            n"Skills",
            "LocKey#92109",
            evt.type,
            evt.currentLevel,
            evt.isLevelMaxed
          );
    }
  }

  public final func AddToNotificationQueue(
    value: Int32,
    remainingPointsToLevelUp: Int32,
    delta: Int32,
    notificationColorTheme: CName,
    const notificationName: script_ref<String>,
    type: gamedataProficiencyType,
    currentLevel: Int32,
    isLevelMaxed: Bool
  ) {
    let notificationData: gameuiGenericNotificationData;
    let sum = remainingPointsToLevelUp + value;
    notificationData.time = this.m_duration;
    let progress = Cast<Float>(value) / Cast<Float>(sum);
    if progress == 0.0 {
      progress = Cast<Float>(sum);
    }
    notificationData.widgetLibraryItemName = n"progression";
    let userData = new ProgressionViewData();
    userData.expProgress = progress;
    userData.expValue = value;
    userData.notificationColorTheme = notificationColorTheme;
    userData.title = notificationName;
    userData.delta = delta;
    userData.type = type;
    userData.currentLevel = currentLevel;
    userData.isLevelMaxed = isLevelMaxed;
    notificationData.notificationData = userData;
    this.AddNewNotificationData(notificationData);
  }
}

