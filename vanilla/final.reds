class SetGameplayObjectiveStateRequest extends ScriptableSystemRequest {
  public let objectiveData: GemplayObjectiveData;
  public let objectiveState: gameJournalEntryState;
}

class GameplayQuestSystem extends ScriptableSystem {
  private let m_quests: [GamplayQuestData];

  private final func OnRegisterObjective(request: RegisterGameplayObjectiveRequest) {
    this.AddObjective(request.objectiveData);
  }

  private final func OnSetObjectiveState(request: SetGameplayObjectiveStateRequest) {
    this.SetObjectiveState(request.objectiveData, request.objectiveState);
  }

  private final func AddObjective(objectiveData: GemplayObjectiveData) {
    let questData = this.GetQuestData(objectiveData);
    questData.AddObjective(objectiveData, this.GetJournal());
  }

  private final func SetObjectiveState(objectiveData: GemplayObjectiveData, objectiveState: gameJournalEntryState) {
    let questData = this.GetQuestData(objectiveData);
    questData.SetObjectiveState(objectiveData, this.GetJournal(), objectiveState);
    this.EvaluateQuest(questData);
  }

  private final func HasQuest(const questUniqueId: script_ref<String>) -> Bool {
    let i = 0;
    while i < ArraySize(this.m_quests) {
      if Equals(this.m_quests[i].m_questUniqueID, questUniqueId) {
        return true;
      }
      i += 1;
    }
    return false;
  }

  private final func GetQuestData(objectiveData: GemplayObjectiveData) -> GamplayQuestData {
    let questData: GamplayQuestData;
    let i = 0;
    while i < ArraySize(this.m_quests) {
      if Equals(this.m_quests[i].m_questUniqueID, objectiveData.GetUniqueID()) {
        questData = this.m_quests[i];
      }
      i += 1;
    }
    if questData == null {
      questData = this.CreateQuest(objectiveData);
    }
    return questData;
  }

  private final func CreateQuest(objectiveData: GemplayObjectiveData) -> GamplayQuestData {
    let questData = new GamplayQuestData();
    let isValid = this
      .GetJournal()
      .CreateScriptedQuestFromTemplate(
        questData.GetQuestEntryID(),
        objectiveData.GetUniqueID(),
        objectiveData.GetQuestTitle()
      );
    if isValid {
      questData.m_questUniqueID = objectiveData.GetUniqueID();
      ArrayPush(this.m_quests, questData);
      return questData;
    }
    return null;
  }

  private final func EvaluateQuest(questData: GamplayQuestData) {
    if questData.IsCompleted() {
      if this.RemoveQuest(questData) {
        ArrayRemove(this.m_quests, questData);
        questData = null;
      }
    }
  }

  private final func RemoveQuest(questData: GamplayQuestData) -> Bool {
    return this
      .GetJournal()
      .DeleteScriptedQuest(questData.GetQuestEntryID(), questData.m_questUniqueID);
  }

  private const final func GetJournal() -> JournalManager {
    return GameInstance.GetJournalManager(this.GetGameInstance());
  }
}

class GamplayQuestData extends IScriptable {
  public let m_questUniqueID: String;
  public let m_objectives: [GemplayObjectiveData];

  public const final func GetFreeObjectivePath() -> String {
    return this.GetPhaseEntryID() + "/" + this.GetFreeObjectiveEntryID();
  }

  public const final func GetbjectivePath(objectiveData: GemplayObjectiveData) -> String {
    return this.GetPhaseEntryID() + "/" + objectiveData.GetObjectiveEntryID();
  }

  public const final func GetFreeObjectiveEntryID() -> String {
    let sufix: String;
    if ArraySize(this.m_objectives) > 0 {
      sufix = ToString(ArraySize(this.m_objectives));
    }
    return this.GetBaseObjectiveEntryID() + sufix;
  }

  public final func AddObjective(objectiveData: GemplayObjectiveData, journal: JournalManager) {
    if this.HasObjective(objectiveData) {
      return;
    } else if this.CreateObjective(objectiveData, journal) {
      ArrayPush(this.m_objectives, objectiveData);
      this.SetObjectiveState(objectiveData, journal, gameJournalEntryState.Active);
    }
  }

  public const final func HasObjective(objectiveData: GemplayObjectiveData) -> Bool {
    let i = 0;
    while i < ArraySize(this.m_objectives) {
      if this.m_objectives[i].GetOwnerID()
        == objectiveData.GetOwnerID()
        && Equals(this.m_objectives[i].GetClassName(), objectiveData.GetClassName()) {
        return true;
      }
      i += 1;
    }
    return false;
  }

  public const final func GetObjective(objectiveData: GemplayObjectiveData) -> GemplayObjectiveData {
    let i = 0;
    while i < ArraySize(this.m_objectives) {
      if this.m_objectives[i].GetOwnerID()
        == objectiveData.GetOwnerID()
        && Equals(this.m_objectives[i].GetClassName(), objectiveData.GetClassName()) {
        return this.m_objectives[i];
      }
      i += 1;
    }
    return null;
  }

  private final func CreateObjective(objectiveData: GemplayObjectiveData, journal: JournalManager) -> Bool {
    let mappinData: MappinData;
    let objectivePath = this.GetFreeObjectivePath();
    let isValid = journal
      .SetScriptedQuestObjectiveDescription(
        this.GetQuestEntryID(),
        objectiveData.GetUniqueID(),
        objectivePath,
        objectiveData.GetObjectiveDescription()
      );
    if !isValid {
      return false;
    }
    let mappinPath = this.GetFreeQuestMappinPath();
    isValid = journal
      .SetScriptedQuestMappinEntityID(
        this.GetQuestEntryID(),
        objectiveData.GetUniqueID(),
        mappinPath,
        objectiveData.GetOwnerID()
      );
    if !isValid {
      return false;
    }
    mappinData.mappinType = t"Mappins.QuestStaticMappinDefinition";
    mappinData.variant = gamedataMappinVariant.DefaultQuestVariant;
    objectiveData.SetObjectiveEntryID(this.GetFreeObjectiveEntryID());
    journal
      .SetScriptedQuestMappinSlotName(
        this.GetQuestEntryID(),
        objectiveData.GetUniqueID(),
        mappinPath,
        t"AttachmentSlots.QuestDeviceMappin"
      );
    journal
      .SetScriptedQuestMappinData(
        this.GetQuestEntryID(),
        objectiveData.GetUniqueID(),
        this.GetFreeQuestMappinPath(),
        mappinData
      );
    return true;
  }

  public final func SetObjectiveState(
    objectiveData: GemplayObjectiveData,
    journal: JournalManager,
    state: gameJournalEntryState
  ) {
    let track: Bool;
    let objective = this.GetObjective(objectiveData);
    if objective == null {
      return;
    } else if Equals(state, gameJournalEntryState.Active) {
      track = true;
    }
    journal
      .SetScriptedQuestEntryState(
        this.GetQuestEntryID(),
        objectiveData.GetUniqueID(),
        this.GetbjectivePath(objectiveData),
        state,
        JournalNotifyOption.Notify,
        track
      );
    objective.SetObjectiveState(state);
  }

  public const final func IsCompleted() -> Bool {
    let i = 0;
    while i < ArraySize(this.m_objectives) {
      if NotEquals(this.m_objectives[i].GetObjectiveState(), gameJournalEntryState.Inactive) {
        return false;
      }
      i += 1;
    }
    return true;
  }

  public const final func GetQuestEntryID() -> String {
    return "generic_gameplay_quest";
  }

  public const final func GetPhaseEntryID() -> String {
    return "generic_gameplay_phase";
  }

  public const final func GetBaseObjectiveEntryID() -> String {
    return "generic_gameplay_objective";
  }

  public const final func GetMappinEntryID() -> String {
    return "generic_gameplay_mappin";
  }

  public const final func GetFreeQuestMappinPath() -> String {
    return this.GetPhaseEntryID() + "/" + this.GetFreeObjectiveEntryID() + "/" + this.GetMappinEntryID();
  }
}

