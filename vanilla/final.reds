class TemporalPrereqDelayCallback extends DelayCallback {
  protected let m_state: wref<TemporalPrereqState>;

  public func Call() {
    this.m_state.CallbackRecall();
  }

  public final func RegisterState(state: PrereqState) {
    this.m_state = state as TemporalPrereqState;
  }
}

class TemporalPrereqState extends PrereqState {
  public let m_delaySystem: DelaySystem;
  public let m_callback: TemporalPrereqDelayCallback;
  public let m_lapsedTime: Float;
  public let m_delayID: DelayID;

  public func RegisterDealyCallback(delayTime: Float) {
    this.m_delayID = this.m_delaySystem.DelayCallback(this.m_callback, delayTime);
  }

  public func CallbackRecall() {
    let prereq = this.GetPrereq() as TemporalPrereq;
    let newState = this.m_lapsedTime >= prereq.m_totalDuration;
    this.OnChanged(newState);
    this.m_lapsedTime += prereq.m_totalDuration;
    if !this.IsFulfilled() {
      this.RegisterDealyCallback(prereq.m_totalDuration);
    }
  }
}

class TemporalPrereq extends IScriptablePrereq {
  public let m_totalDuration: Float;

  protected const func OnRegister(state: PrereqState, game: GameInstance, context: IScriptable) -> Bool {
    let castedState = state as TemporalPrereqState;
    castedState.m_delaySystem = GameInstance.GetDelaySystem(game);
    castedState.m_callback = new TemporalPrereqDelayCallback();
    castedState.m_callback.RegisterState(castedState);
    castedState.m_lapsedTime = 0.0;
    castedState.RegisterDealyCallback(0.0);
    return false;
  }

  protected const func OnUnregister(state: PrereqState, game: GameInstance, context: IScriptable) {
    let castedState = state as TemporalPrereqState;
    GameInstance.GetDelaySystem(game).CancelCallback(castedState.m_delayID);
    castedState.m_callback = null;
  }

  protected func Initialize(recordID: TweakDBID) {
    this.m_totalDuration = TweakDBInterface.GetFloat(recordID + t".duration", 0.0);
    let randRange = TweakDBInterface.GetFloat(recordID + t".randRange", 0.0);
    if randRange > 0.0 {
      this.m_totalDuration = RandRangeF(this.m_totalDuration - randRange, this.m_totalDuration + randRange);
    }
  }
}

