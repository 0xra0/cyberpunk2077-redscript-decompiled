class IsNPCInPrevention extends PreventionConditionAbstract {
  protected func Check(context: ScriptExecutionContext) -> AIbehaviorConditionOutcomes {
    if AIBehaviorScriptBase.GetPuppet(context).IsPrevention()
      && !NPCManager
        .HasTag(ScriptExecutionContext.GetOwner(context).GetRecordID(), n"Scripted_Patrol") {
      return AIbehaviorConditionOutcomes.True;
    }
    return AIbehaviorConditionOutcomes.False;
  }
}

class TestFalseConditon extends WorkspotCondition {
  protected const func CheckCondition(const ent: Entity) -> Bool {
    return false;
  }
}

class IsUnarmedCondition extends WorkspotCondition {
  protected const func CheckCondition(ent: Entity) -> Bool {
    let items: [wref<ItemObject>];
    let obj = ent as GameObject;
    if !IsDefined(obj) {
      return true;
    } else if !obj.IsNPC() {
      return false;
    }
    return !AIActionHelper.GetItemsFromWeaponSlots(obj, items);
  }
}

