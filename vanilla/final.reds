  public final func PushPersistentData(const data: script_ref<BaseDeviceData>) {
    let defaultState: EDeviceStatus;
    if !this.m_wasStateSet {
      this
        .SetDeviceState(
          NotEquals(data.m_deviceState, defaultState) ? data.m_deviceState : defaultState
        );
      this
        .CacheDeviceState(
          NotEquals(this.m_deviceState, defaultState) ? this.m_deviceState : defaultState
        );
    }
    this.m_destructionProperties.m_durabilityType = data.m_durabilityType;
  }

