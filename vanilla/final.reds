class InputContextSystem extends ScriptableSystem {
  private let activeContext: inputContextType;

  private final func OnPlayerAttach(request: PlayerAttachRequest) {
    this.activeContext = inputContextType.RPG;
  }

  public const final func GetActiveContext() -> inputContextType {
    return this.activeContext;
  }

  public const final func IsActiveContextAction() -> Bool {
    return Equals(this.activeContext, inputContextType.Action);
  }

  public const final func IsActiveContextRPG() -> Bool {
    return Equals(this.activeContext, inputContextType.RPG);
  }

  private final func OnChangeActiveContextRequest(request: ChangeActiveContextRequest) {
    this.activeContext = request.newContext;
  }
}

