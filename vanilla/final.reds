class BasicDistractionDevice extends InteractiveDevice {
  protected let m_animFeatureDataDistractor: AnimFeature_DistractionState;
  protected let m_animFeatureDataNameDistractor: CName;
  protected const let m_distractionComponentSwapNamesToON: [CName];
  protected const let m_distractionComponentSwapNamesToOFF: [CName];
  private let m_distractionComponentON: [IPlacedComponent];
  private let m_distractionComponentOFF: [IPlacedComponent];
  protected let m_meshAppearanceNameON: CName;
  protected let m_meshAppearanceNameOFF: CName;

  protected cb func OnRequestComponents(ri: EntityRequestComponentsInterface) -> Bool {
    let i = 0;
    while i < ArraySize(this.m_distractionComponentSwapNamesToON) {
      EntityRequestComponentsInterface
        .RequestComponent(
          ri,
          this.m_distractionComponentSwapNamesToON[i],
          n"IPlacedComponent",
          true
        );
      i += 1;
    }
    i = 0;
    while i < ArraySize(this.m_distractionComponentSwapNamesToOFF) {
      EntityRequestComponentsInterface
        .RequestComponent(
          ri,
          this.m_distractionComponentSwapNamesToOFF[i],
          n"IPlacedComponent",
          true
        );
      i += 1;
    }
    super.OnRequestComponents(ri);
  }

  protected cb func OnTakeControl(ri: EntityResolveComponentsInterface) -> Bool {
    let i = 0;
    while i < ArraySize(this.m_distractionComponentSwapNamesToON) {
      ArrayPush(
        this.m_distractionComponentON,
        EntityResolveComponentsInterface.GetComponent(ri, this.m_distractionComponentSwapNamesToON[i]) as IPlacedComponent
      );
      i += 1;
    }
    i = 0;
    while i < ArraySize(this.m_distractionComponentSwapNamesToOFF) {
      ArrayPush(
        this.m_distractionComponentOFF,
        EntityResolveComponentsInterface.GetComponent(ri, this.m_distractionComponentSwapNamesToOFF[i]) as IPlacedComponent
      );
      i += 1;
    }
    super.OnTakeControl(ri);
    this.m_controller = EntityResolveComponentsInterface.GetComponent(ri, n"controller") as BasicDistractionDeviceController;
  }

  protected cb func OnGameAttached() -> Bool {
    this.m_animFeatureDataDistractor = new AnimFeature_DistractionState();
    this.m_animFeatureDataNameDistractor = n"distraction";
    super.OnGameAttached();
    if this.GetDevicePS().GetForceAnimationSystem() {
      this
        .ToggleForcedVisibilityInAnimSystem(n"DistractionDeviceSpecialForce", true, 0.0);
    }
  }

  protected cb func OnDetach() -> Bool {
    super.OnDetach();
    if this.GetDevicePS().GetForceAnimationSystem() {
      this
        .ToggleForcedVisibilityInAnimSystem(n"DistractionDeviceSpecialForce", false, 0.0);
    }
  }

  private const func GetController() -> BasicDistractionDeviceController {
    return this.m_controller as BasicDistractionDeviceController;
  }

  public const func GetDevicePS() -> BasicDistractionDeviceControllerPS {
    return this.GetController().GetPS();
  }

  protected func TurnOnDevice() {
    super.TurnOnDevice();
    this.PlayTransformAnimation(n"turnON", true);
  }

  protected func TurnOffDevice() {
    super.TurnOffDevice();
    this.StopTransformDistractAnimation(n"turnON");
  }

  public const func DeterminGameplayRole() -> EGameplayRole {
    return EGameplayRole.Distract;
  }

  protected cb func OnSpiderbotDistractDevicePerformed(evt: SpiderbotDistractDevicePerformed) -> Bool {
    if evt.IsStarted() {
      this.StartDistraction(true);
    } else {
      this.StopDistraction();
    }
  }

  protected cb func OnQuickHackDistraction(evt: QuickHackDistraction) -> Bool {
    super.OnQuickHackDistraction(evt);
    if evt.IsStarted() {
      this.StartDistraction(true);
    } else {
      this.StopDistraction();
    }
  }

  protected cb func OnQuestStartGlitch(evt: QuestStartGlitch) -> Bool {
    super.OnQuestStartGlitch(evt);
    this.StartDistraction(true);
  }

  protected cb func OnQuestStopGlitch(evt: QuestStopGlitch) -> Bool {
    super.OnQuestStopGlitch(evt);
    this.StopDistraction();
  }

  protected func StartDistraction(opt loopAnimation: Bool) {
    this.PlayDistractAnimation(loopAnimation);
    this.SetMeshAppearance(this.m_meshAppearanceNameON);
    this.EffectsOnStartPlay();
    this.MeshSwapOnDistraction(true);
  }

  protected func StopDistraction() {
    this.StopDistractAnimation();
    this.EffectsOnStartStop();
    this.SetMeshAppearance(this.m_meshAppearanceNameOFF);
    this.MeshSwapOnDistraction(false);
  }

  protected func PlayDistractAnimation(opt loop: Bool) {
    if Equals(this.GetDevicePS().GetAnimationType(), EAnimationType.REGULAR) {
      this.PlayAnimgraphTransformAnimation();
    } else if Equals(this.GetDevicePS().GetAnimationType(), EAnimationType.TRANSFORM) {
      this.PlayTransformAnimation(n"distraction", loop);
    }
  }

  protected func StopDistractAnimation() {
    if Equals(this.GetDevicePS().GetAnimationType(), EAnimationType.REGULAR) {
      this.StopAnimgraphTransformAnimation();
    } else if Equals(this.GetDevicePS().GetAnimationType(), EAnimationType.TRANSFORM) {
      this.StopTransformDistractAnimation(n"distraction");
    }
  }

  protected func PlayAnimgraphTransformAnimation() {
    this.m_animFeatureDataDistractor.isOn = true;
    this
      .ApplyAnimFeatureToReplicate(
        this,
        this.m_animFeatureDataNameDistractor,
        this.m_animFeatureDataDistractor
      );
  }

  protected func StopAnimgraphTransformAnimation() {
    this.m_animFeatureDataDistractor.isOn = false;
    this
      .ApplyAnimFeatureToReplicate(
        this,
        this.m_animFeatureDataNameDistractor,
        this.m_animFeatureDataDistractor
      );
  }

  protected func PlayTransformAnimation(animationName: CName, opt loop: Bool) {
    let playEvent = new gameTransformAnimationPlayEvent();
    playEvent.animationName = animationName;
    playEvent.timeScale = 1.0;
    playEvent.looping = loop;
    if loop {
      playEvent.timesPlayed = 1u;
    } else {
      playEvent.timesPlayed = 100u;
    }
    this.QueueEvent(playEvent);
  }

  protected func StopTransformDistractAnimation(animationName: CName) {
    let playEvent = new gameTransformAnimationPlayEvent();
    playEvent.timeScale = 1.0;
    playEvent.looping = false;
    playEvent.timesPlayed = 1u;
    playEvent.animationName = animationName;
    this.QueueEvent(playEvent);
  }

  protected final func EffectsOnStartPlay() {
    let effectNames = this.GetDevicePS().GetEffectOnStartNames();
    let i = 0;
    while i < ArraySize(effectNames) {
      GameObjectEffectHelper.StartEffectEvent(this, effectNames[i]);
      i += 1;
    }
  }

  protected final func EffectsOnStartStop(opt shouldStop: Bool) {
    let effectNames = this.GetDevicePS().GetEffectOnStartNames();
    let i = 0;
    while i < ArraySize(effectNames) {
      if shouldStop {
        GameObjectEffectHelper.StopEffectEvent(this, effectNames[i]);
      } else {
        GameObjectEffectHelper.BreakEffectLoopEvent(this, effectNames[i]);
      }
      i += 1;
    }
  }

  protected final func MeshSwapOnDistraction(start: Bool) {
    let i = 0;
    while i < ArraySize(this.m_distractionComponentON) {
      this.m_distractionComponentON[i].Toggle(start);
      i += 1;
    }
    i = 0;
    while i < ArraySize(this.m_distractionComponentOFF) {
      this.m_distractionComponentOFF[i].Toggle(!start);
      i += 1;
    }
  }
}

class BasicDistractionDeviceController extends ScriptableDeviceComponent {
  public const func GetPS() -> BasicDistractionDeviceControllerPS {
    return this.GetBasePS() as BasicDistractionDeviceControllerPS;
  }
}

class AnimFeature_DistractionState extends AnimFeature {
  public let isOn: Bool;
}

class ActionUploadListener extends CustomValueStatPoolsListener {
  public let m_action: ScriptableDeviceAction;
  public let m_gameInstance: GameInstance;
}

class QuickHackDurationListener extends ActionUploadListener {
  protected cb func OnStatPoolAdded() -> Bool {
    this.SendUploadStartedEvent(this.m_action);
    this.SetRegenBehavior();
  }

  protected func SetRegenBehavior() {
    let regenMod: StatPoolModifier;
    let activationTime = this.m_action.GetDurationValue();
    regenMod.enabled = true;
    regenMod.valuePerSec = 100.0 / activationTime;
    regenMod.rangeEnd = 100.0;
    GameInstance
      .GetStatPoolsSystem(this.m_gameInstance)
      .RequestSettingModifier(
        Cast<StatsObjectID>(this.m_action.GetRequesterID()),
        gamedataStatPoolType.QuickHackDuration,
        gameStatPoolModificationTypes.Regeneration,
        regenMod
      );
  }

  protected cb func OnStatPoolMaxValueReached(value: Float) -> Bool {
    this.m_action.CompleteAction(this.m_gameInstance);
    GameInstance
      .GetStatPoolsSystem(this.m_gameInstance)
      .RequestRemovingStatPool(
        Cast<StatsObjectID>(this.m_action.GetRequesterID()),
        gamedataStatPoolType.QuickHackDuration
      );
    GameInstance
      .GetStatPoolsSystem(this.m_gameInstance)
      .RequestUnregisteringListener(
        Cast<StatsObjectID>(this.m_action.GetRequesterID()),
        gamedataStatPoolType.QuickHackDuration,
        this
      );
    this.SendUploadFinishedEvent();
  }

  protected func SendUploadStartedEvent(action: ScriptableDeviceAction) {
    let evt = new UploadProgramProgressEvent();
    let uploadDuration = this.m_action.GetDurationValue();
    evt.state = EUploadProgramState.STARTED;
    evt.duration = uploadDuration;
    evt.progressBarType = EProgressBarType.DURATION;
    evt.action = action;
    evt.iconRecord = action.GetInteractionIcon();
    evt.statPoolType = gamedataStatPoolType.QuickHackDuration;
    GameInstance
      .GetPersistencySystem(this.m_gameInstance)
      .QueueEntityEvent(this.m_action.GetRequesterID(), evt);
  }

  protected final func SendUploadFinishedEvent() {
    let evt = new UploadProgramProgressEvent();
    evt.state = EUploadProgramState.COMPLETED;
    evt.action = this.m_action;
    evt.statPoolType = gamedataStatPoolType.QuickHackDuration;
    GameInstance
      .GetPersistencySystem(this.m_gameInstance)
      .QueueEntityEvent(this.m_action.GetRequesterID(), evt);
  }
}

