class GameTimePrereq extends IScriptablePrereq {
  public let m_delay: Float;
  public let m_repeated: Bool;
  private let m_delayFromStat: gamedataStatType;

  protected const func OnRegister(state: PrereqState, game: GameInstance, context: IScriptable) -> Bool {
    let delay = this.m_delay;
    let castedState = state as GameTimePrereqState;
    let evt = new DelayPrereqEvent();
    evt.m_state = castedState;
    castedState.m_repeated = this.m_repeated;
    if NotEquals(this.m_delayFromStat, gamedataStatType.Invalid) {
      let statVal = GameInstance
        .GetStatsSystem(game)
        .GetStatValue(
          Cast<StatsObjectID>((context as GameObject).GetEntityID()),
          this.m_delayFromStat
        );
      if statVal > 0.0 {
        delay = statVal
          / TweakDBInterface.GetFloat(t"timeSystem.settings.realTimeMultiplier", 1.0);
      } else if this.m_repeated {
        castedState.m_listener = GameInstance
          .GetTimeSystem(game)
          .RegisterDelayedListener(
            context as GameObject,
            evt,
            GameInstance.GetTimeSystem(game).RealTimeSecondsToGameTime(delay),
            -1,
            false
          );
      }
    }
    castedState.m_listener = GameInstance
      .GetTimeSystem(game)
      .RegisterDelayedListener(
        context as GameObject,
        evt,
        GameInstance.GetTimeSystem(game).RealTimeSecondsToGameTime(delay),
        1,
        false
      );
    return false;
  }

  protected const func OnUnregister(state: PrereqState, game: GameInstance, context: IScriptable) {
    GameInstance
      .GetTimeSystem(game)
      .UnregisterListener((state as GameTimePrereqState).m_listener);
  }

  protected func Initialize(recordID: TweakDBID) {
    this.m_delay = TweakDBInterface.GetFloat(recordID + t".delay", 0.0);
    this.m_repeated = TweakDBInterface.GetBool(recordID + t".repeated", false);
    let statRecord = TweakDBInterface.GetStatRecord(TDB.GetForeignKey(recordID + t".delayFromStat"));
    if IsDefined(statRecord) {
      this.m_delayFromStat = statRecord.StatType();
    }
  }
}

class FactValuePrereqState extends PrereqState {
  public let m_listenerID: Uint32;

  public final func OnFactChanged(factValue: Int32) {
    let prereq = this.GetPrereq() as FactValuePrereq;
    let evaluation = prereq.Evaluate(factValue);
    if prereq.m_repeated && this.IsFulfilled() && evaluation {
      this.OnChangedRepeated(false);
    } else {
      this.OnChanged(evaluation);
    }
  }
}

class FactValuePrereq extends IScriptablePrereq {
  public let m_fact: CName;
  public let m_value: Int32;
  public let m_comparisonType: EComparisonType;
  public let m_repeated: Bool;

  protected func Initialize(recordID: TweakDBID) {
    this.m_fact = TweakDBInterface.GetCName(recordID + t".fact", n"None");
    this.m_value = TweakDBInterface.GetInt(recordID + t".value", 0);
    let compType = TweakDBInterface.GetCName(recordID + t".comparisonType", n"None");
    this.m_comparisonType = IntEnum<EComparisonType>(Cast<Int32>(EnumValueFromName(n"EComparisonType", compType)));
    this.m_repeated = TweakDBInterface.GetBool(recordID + t".repeated", false);
  }

  protected const func OnRegister(state: PrereqState, game: GameInstance, context: IScriptable) -> Bool {
    if IsNameValid(this.m_fact) {
      let castedState = state as FactValuePrereqState;
      castedState.m_listenerID = GameInstance
        .GetQuestsSystem(game)
        .RegisterListener(this.m_fact, castedState, n"OnFactChanged");
    }
    return false;
  }

  protected const func OnUnregister(state: PrereqState, game: GameInstance, context: IScriptable) {
    if IsNameValid(this.m_fact) {
      let castedState = state as FactValuePrereqState;
      GameInstance
        .GetQuestsSystem(game)
        .UnregisterListener(this.m_fact, castedState.m_listenerID);
    }
  }

  protected const func OnApplied(state: PrereqState, game: GameInstance, context: IScriptable) {
    let castedState = state as FactValuePrereqState;
    castedState.OnChanged(this.IsFulfilled(game, context));
  }

  public const func IsFulfilled(game: GameInstance, context: IScriptable) -> Bool {
    let result = false;
    if IsNameValid(this.m_fact) {
      result = this.Evaluate(GameInstance.GetQuestsSystem(game).GetFact(this.m_fact));
    }
    return result;
  }

  public const final func Evaluate(value: Int32) -> Bool {
    return ProcessCompare(this.m_comparisonType, Cast<Float>(value), Cast<Float>(this.m_value));
  }
}

class cameraShotEffect_PositionShake extends CameraShotEffect_VectorDamper {
  public let shakeStrength: Float;
  public let frequency: Float;
  public let directionsCoef: Vector3;

  public func Start(data: CinematicCameraData) {
    super.Start(data);
    this.SetDampFactor(this.damping);
  }

  public func StartDelayed(data: CinematicCameraData, resultTransform: script_ref<WorldTransform>) {
    super.StartDelayed(data, resultTransform);
    this.SetDampFactor(this.damping);
  }

  public func Update(data: CinematicCameraData, resultTransform: script_ref<WorldTransform>) {
    let randomVertical = RandPerlinNoiseF(Cast<Int32>(data.shotStartTime) + 100, data.currentTime * this.frequency) * this.shakeStrength;
    let randomHorizontal = RandPerlinNoiseF(Cast<Int32>(data.shotStartTime) + 200, data.currentTime * this.frequency) * this.shakeStrength;
    let randomForward = RandPerlinNoiseF(Cast<Int32>(data.shotStartTime) + 300, data.currentTime * this.frequency) * this.shakeStrength;
    let cameraOffset = new Vector4(
      randomHorizontal * this.directionsCoef.X,
      randomForward * this.directionsCoef.Y,
      randomVertical * this.directionsCoef.Z,
      0.0
    );
    this.UpdateDamp(cameraOffset, data.deltaTime);
    let dampedOffset = this.GetDampValue();
    let cameraPosition = WorldPosition.ToVector4(WorldTransform.GetWorldPosition(resultTransform));
    cameraPosition += WorldTransform.GetRight(resultTransform) * dampedOffset.X;
    cameraPosition += WorldTransform.GetForward(resultTransform) * dampedOffset.Y;
    cameraPosition += WorldTransform.GetUp(resultTransform) * dampedOffset.Z;
    WorldTransform.SetPosition(resultTransform, cameraPosition);
  }
}

