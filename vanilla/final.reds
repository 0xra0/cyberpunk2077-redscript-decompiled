  protected final func SendForceRevealObjectEvent(
    reveal: Bool,
    reason: CName,
    opt instigatorID: EntityID,
    opt lifetime: Float,
    opt delay: Float
  ) {
    let evt = new RevealObjectEvent();
    evt.reveal = reveal;
    evt.reason.reason = reason;
    evt.reason.sourceEntityId = instigatorID;
    evt.lifetime = lifetime;
