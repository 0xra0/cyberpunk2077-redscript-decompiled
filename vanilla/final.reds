class CustomAnimationsGameController extends inkGameController {
  protected let m_customAnimations: WidgetAnimationManager;
  protected let m_onSpawnAnimations: [CName];
  protected let m_defaultLibraryItemName: CName;
  protected let m_defaultLibraryItemAnchor: inkEAnchor;
  protected let m_spawnedLibrararyItem: wref<inkWidget>;
  protected let m_curentLibraryItemName: CName;
  protected let m_currentLibraryItemAnchor: inkEAnchor;
  protected let m_root: wref<inkCompoundWidget>;
  protected let m_isInitialized: Bool;
  private let m_ownerID: EntityID;

  protected cb func OnInitialize() -> Bool {
    this.m_ownerID = this.GetOwnerEntity().GetEntityID();
    this.InitalizeAnimationsData();
    this.m_root = this.GetRootWidget() as inkCompoundWidget;
    if !this
      .ResolveLibraryItemSpawn(this.m_defaultLibraryItemName, this.m_defaultLibraryItemAnchor, true) {
      this.PlayOnSpawnAnimations();
    }
    this.m_isInitialized = true;
  }

  protected cb func OnCustomUIAnimationEvent(evt: CustomUIAnimationEvent) -> Bool {
    if this.m_ownerID != evt.ownerID {
      return false;
    } else if this.m_customAnimations != null {
      this
        .m_customAnimations
        .UpdateAnimationsList(evt.animationName, evt.animOptionsOverride);
      this
        .ResolveLibraryItemSpawn(
          evt.libraryItemName,
          evt.libraryItemAnchor,
          false,
          evt.forceRespawnLibraryItem
        );
      this.PlayAnimation(evt.animationName, evt.playbackOption);
    }
  }

  private final func InitalizeAnimationsData() {
    let owner = this.GetOwnerEntity() as SceneScreen;
    if IsDefined(owner) {
      let data = owner.GetUIAnimationData();
      if IsDefined(data) {
        if IsDefined(data.m_customAnimations) {
          let manager = new WidgetAnimationManager();
          manager.Initialize(data.m_customAnimations.GetAnimations());
          this.m_customAnimations = manager;
        } else if ArraySize(data.m_onSpawnAnimations) > 0 {
          this.m_onSpawnAnimations = data.m_onSpawnAnimations;
        } else if IsNameValid(data.m_defaultLibraryItemName) {
          this.m_defaultLibraryItemName = data.m_defaultLibraryItemName;
          this.m_defaultLibraryItemAnchor = data.m_defaultLibraryItemAnchor;
        }
      }
    }
  }

  protected final func PlayAnimation(animationName: CName, playbackOption: EInkAnimationPlaybackOption) {
    if this.m_customAnimations != null {
      this
        .m_customAnimations
        .TriggerAnimationByName(this, animationName, playbackOption, this.m_spawnedLibrararyItem);
    }
  }

  private final func PlayOnSpawnAnimations() {
    let i = 0;
    while i < ArraySize(this.m_onSpawnAnimations) {
      this
        .PlayAnimation(this.m_onSpawnAnimations[i], EInkAnimationPlaybackOption.PLAY);
      i += 1;
    }
  }

  private final func ResolveLibraryItemSpawn(
    itemName: CName,
    anchor: inkEAnchor,
    opt async: Bool,
    opt forceRespawnLibraryItem: Bool
  ) -> Bool {
    if !IsDefined(this.m_root) {
      return false;
    } else if !IsNameValid(itemName) {
      return false;
    } else if IsDefined(this.m_spawnedLibrararyItem)
      && Equals(itemName, this.m_curentLibraryItemName)
      && Equals(anchor, this.m_currentLibraryItemAnchor)
      && !forceRespawnLibraryItem {
      return false;
    } else if !this.HasLocalLibrary(itemName) {
      return false;
    } else if IsDefined(this.m_spawnedLibrararyItem) {
      this.m_root.RemoveChild(this.m_spawnedLibrararyItem);
      this.m_customAnimations.CleanAllAnimationsChachedData();
    } else if async {
      this
        .AsyncSpawnFromLocal(this.m_root, itemName, this, n"OnInitialSpawnLibrararyItem");
      this.m_curentLibraryItemName = itemName;
      this.m_currentLibraryItemAnchor = anchor;
    }
    this.m_spawnedLibrararyItem = this.SpawnFromLocal(this.m_root, itemName);
    this.m_spawnedLibrararyItem.SetAnchor(anchor);
    this.m_curentLibraryItemName = itemName;
    this.m_currentLibraryItemAnchor = anchor;
    return true;
  }

  protected cb func OnInitialSpawnLibrararyItem(widget: inkWidget, userData: IScriptable) -> Bool {
    this.m_spawnedLibrararyItem = widget;
    this.m_spawnedLibrararyItem.SetAnchor(this.m_currentLibraryItemAnchor);
    this.PlayOnSpawnAnimations();
  }
}

class SceneScreen extends GameObject {
  public let m_uiAnimationsData: SceneScreenUIAnimationsData;
  protected let m_blackboard: IBlackboard;

  protected cb func OnRequestComponents(ri: EntityRequestComponentsInterface) -> Bool {
    super.OnRequestComponents(ri);
  }

  protected cb func OnTakeControl(ri: EntityResolveComponentsInterface) -> Bool {
    this.CreateBlackboard();
    super.OnTakeControl(ri);
  }

  protected cb func OnChangeUIAnimEvent(evt: ChangeUIAnimEvent) -> Bool {
    this.SendDataToUIBlackboard(evt.animName);
  }

  protected final func SendDataToUIBlackboard(animName: CName) {
    this
      .GetBlackboard()
      .SetName(GetAllBlackboardDefs().UI_SceneScreen.AnimName, animName);
    this.GetBlackboard().FireCallbacks();
  }

  public const func GetBlackboard() -> IBlackboard {
    return this.m_blackboard;
  }

  protected func CreateBlackboard() {
    this.m_blackboard = IBlackboard.Create(GetAllBlackboardDefs().UI_SceneScreen);
  }

  public const final func GetUIAnimationData() -> SceneScreenUIAnimationsData {
    return this.m_uiAnimationsData;
  }
}

class ChangeUIAnimEvent extends Event {
  public let animName: CName;

  public final func GetFriendlyDescription() -> String {
    return "Change Anim On UI";
  }
}

class SceneScreenUIAnimationsData extends IScriptable {
  public let m_customAnimations: WidgetAnimationManager;
  public const let m_onSpawnAnimations: [CName];
  public let m_defaultLibraryItemName: CName;
  public let m_defaultLibraryItemAnchor: inkEAnchor;
}

