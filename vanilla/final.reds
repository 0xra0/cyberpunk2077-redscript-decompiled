  protected const final func IsInEditorMode(const scriptInterface: StateGameScriptInterface) -> Bool {
    return !this
      .GetSceneSystemInterface(scriptInterface)
      .GetSceneSystemCameraControlEnabled();
  }

  protected const final func StartGlitchFx(const scriptInterface: StateGameScriptInterface, opt fxState: Bool) {
    if fxState {
      return;
    }
    let effectName = !this.IsInEditorMode(scriptInterface) ? n"transition_glitch_loop_braindance" : n"transition_glitch_loop";
    GameObjectEffectHelper.StopEffectEvent(scriptInterface.executionOwner, effectName);
    effectName = this.IsInEditorMode(scriptInterface) ? n"transition_glitch_loop_braindance" : n"transition_glitch_loop";
    GameObjectEffectHelper.StartEffectEvent(scriptInterface.executionOwner, effectName);
  }

  protected const final func StopGlitchFx(const scriptInterface: StateGameScriptInterface) {
    let effectName = this.IsInEditorMode(scriptInterface) ? n"transition_glitch_loop_braindance" : n"transition_glitch_loop";
    GameObjectEffectHelper.StopEffectEvent(scriptInterface.executionOwner, effectName);
  }

  protected const final func SetEndRecordingNotificationState(newState: Bool, const scriptInterface: StateGameScriptInterface) {
    let simpleScreenMessage: SimpleScreenMessage;
    simpleScreenMessage.isShown = newState;
    simpleScreenMessage.duration = 0.0;
    simpleScreenMessage.message = "LocKey#52608";
    simpleScreenMessage.isInstant = true;
    scriptInterface
      .GetBlackboardSystem()
      .Get(GetAllBlackboardDefs().UI_Notifications)
      .SetVariant(
        GetAllBlackboardDefs().UI_Notifications.WarningMessage,
        ToVariant(simpleScreenMessage),
        true
      );
  }

  protected const final func ApplyBraindanceRestriction(const scriptInterface: StateGameScriptInterface) {
    StatusEffectHelper
      .ApplyStatusEffect(scriptInterface.executionOwner, t"GameplayRestriction.Braindance");
  }

  protected const final func RemoveBraindanceRestriction(const scriptInterface: StateGameScriptInterface) {
    StatusEffectHelper
      .RemoveStatusEffect(scriptInterface.executionOwner, t"GameplayRestriction.Braindance");
  }

  protected const final func ApplyNoMovementRestriction(const scriptInterface: StateGameScriptInterface) {
    StatusEffectHelper
      .ApplyStatusEffect(scriptInterface.executionOwner, t"GameplayRestriction.NoMovement");
  }

  protected const final func RemoveNoMovementRestriction(const scriptInterface: StateGameScriptInterface) {
    StatusEffectHelper
      .RemoveStatusEffect(scriptInterface.executionOwner, t"GameplayRestriction.NoMovement");
  }

  protected const final func ApplyNoHubRestrictionOnLocalPlayer(const scriptInterface: StateGameScriptInterface) {
    StatusEffectHelper
      .ApplyStatusEffect(
        scriptInterface.GetPlayerSystem().GetLocalPlayerMainGameObject(),
        t"GameplayRestriction.BlockAllHubMenu"
      );
  }

  protected const final func RemoveNoHubRestrictionFromLocalPlayer(const scriptInterface: StateGameScriptInterface) {
    StatusEffectHelper
      .RemoveStatusEffect(
        scriptInterface.GetPlayerSystem().GetLocalPlayerMainGameObject(),
        t"GameplayRestriction.BlockAllHubMenu"
      );
  }
}

