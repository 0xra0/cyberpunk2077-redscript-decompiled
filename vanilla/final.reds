}

class VehiclePassengerRemoteControlDriverContextDecisions extends VehicleGameplayContextDecisions {
  protected const final func ToVehiclePassengerContext(const stateContext: StateContext, const scriptInterface: StateGameScriptInterface) -> Bool {
    let currentState = scriptInterface.localBlackboard.GetInt(GetAllBlackboardDefs().PlayerStateMachine.Vehicle);
    let isVehicleRemoteControlled = this.IsVehicleRemoteControlled(scriptInterface);
    if isVehicleRemoteControlled {
      return false;
    } else if currentState == 3 {
      return true;
    }
    return false;
  }

  protected const func EnterCondition(const stateContext: StateContext, const scriptInterface: StateGameScriptInterface) -> Bool {
    let currentState = scriptInterface.localBlackboard.GetInt(GetAllBlackboardDefs().PlayerStateMachine.Vehicle);
    let isVehicleRemoteControlled = this.IsVehicleRemoteControlled(scriptInterface);
    if (currentState == 7 || currentState == 3) && isVehicleRemoteControlled {
      return true;
    }
    return false;
  }

  protected const func ExitCondition(const stateContext: StateContext, const scriptInterface: StateGameScriptInterface) -> Bool {
    let currentState = scriptInterface.localBlackboard.GetInt(GetAllBlackboardDefs().PlayerStateMachine.Vehicle);
    let isVehicleRemoteControlled = this.IsVehicleRemoteControlled(scriptInterface);
    if currentState == 0 {
      return true;
    } else if currentState != 7 && currentState != 3 {
      return true;
    } else if !isVehicleRemoteControlled {
      return true;
    }
    return false;
  }
}

class AdHocAnimationEvents extends TemporaryUnequipEvents {
  protected func OnEnter(stateContext: StateContext, scriptInterface: StateGameScriptInterface) {
    let blackboardSystem = scriptInterface.GetBlackboardSystem();
    let blackboard = blackboardSystem.Get(GetAllBlackboardDefs().AdHocAnimation);
    let adHocFeature = new AnimFeature_AdHocAnimation();
    adHocFeature.useBothHands = true;
    adHocFeature.isActive = true;
    adHocFeature.animationIndex = blackboard.GetInt(GetAllBlackboardDefs().AdHocAnimation.AnimationIndex);
    if !blackboard.GetBool(GetAllBlackboardDefs().AdHocAnimation.UseBothHands) {
      adHocFeature.useBothHands = false;
    } else if blackboard.GetBool(GetAllBlackboardDefs().AdHocAnimation.UnequipWeapon) {
      super.OnEnter(stateContext, scriptInterface);
    }
    scriptInterface.SetAnimationParameterFeature(n"AdHoc", adHocFeature);
  }

  protected func OnExit(stateContext: StateContext, scriptInterface: StateGameScriptInterface) {
    let blackboardSystem = scriptInterface.GetBlackboardSystem();
    let blackboard = blackboardSystem.Get(GetAllBlackboardDefs().AdHocAnimation);
    if blackboard.GetBool(GetAllBlackboardDefs().AdHocAnimation.UnequipWeapon) {
      super.OnExit(stateContext, scriptInterface);
    }
    let adHocFeature = new AnimFeature_AdHocAnimation();
    adHocFeature.isActive = false;
    scriptInterface.SetAnimationParameterFeature(n"AdHoc", adHocFeature);
    blackboard.SetBool(GetAllBlackboardDefs().AdHocAnimation.IsActive, false);
  }
}

class VehicleRemoteControlDriverContextEvents extends InputContextTransitionEvents {
  protected final func OnUpdate(
    timeDelta: Float,
    stateContext: StateContext,
    scriptInterface: StateGameScriptInterface
  ) {
    if scriptInterface.IsActionJustReleased(n"ToggleVehCamera") {
      this.ToggleVehicleRemoteControlCamera(scriptInterface);
    } else if scriptInterface.IsActionJustPressed(n"Exit") {
      this.SetVehicleRemoteControlled(scriptInterface, false);
    }
  }

  protected func OnEnter(stateContext: StateContext, scriptInterface: StateGameScriptInterface) {
    this.RemoveAllInputHints(stateContext, scriptInterface);
    this.ShowVehicleRemoteControlDriverInputHints(stateContext, scriptInterface);
    SaveLocksManager.RequestSaveLockAdd(scriptInterface.owner.GetGame(), n"RemoteControl");
  }

  protected final func OnForcedExit(stateContext: StateContext, scriptInterface: StateGameScriptInterface) {
    this.OnCommonExit(stateContext, scriptInterface);
  }

  protected func OnExit(stateContext: StateContext, scriptInterface: StateGameScriptInterface) {
    this.OnCommonExit(stateContext, scriptInterface);
  }

  private final func OnCommonExit(stateContext: StateContext, scriptInterface: StateGameScriptInterface) {
    this.RemoveVehicleRemoteControlDriverInputHints(stateContext, scriptInterface);
    SaveLocksManager.RequestSaveLockRemove(scriptInterface.owner.GetGame(), n"RemoteControl");
  }
}

