    this.m_tweakDBPackage = t"AIGeneralSettings";
    let duration = AITweakParams.GetFloatFromTweak(this.m_tweakDBPackage, "guardbreak_duration");
    if duration > 0.0 {
      return duration;
    }
    return 1.0;
  }
}

