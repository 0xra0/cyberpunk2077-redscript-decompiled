native class WeaponGrenade extends ItemObject {
  protected native let deliveryMethod: gamedataGrenadeDeliveryMethodType;
  protected native let lastHitNormal: Vector4;

  public final native func OnExplosion();

  public final native func ActivateFocusedShootingAim(aimRequest: AimRequest);

  public final native func DeactivateFocusedShootingAim();

  public final native func IsGrenadeTargetedWithFocusedShootingPerk() -> Bool;

  public final func EnableFocusedShootingHighlight() {
    let highlightData = new FocusForcedHighlightData();
    highlightData.sourceID = this.GetOwner().GetEntityID();
    highlightData.sourceName = this.GetOwner().GetClassName();
    highlightData.outlineType = EFocusOutlineType.HOSTILE;
    highlightData.highlightType = EFocusForcedHighlightType.HOSTILE;
    highlightData.priority = EPriority.VeryHigh;
    highlightData.inTransitionTime = 0.0;
    highlightData.outTransitionTime = 0.5;
    highlightData.patternType = VisionModePatternType.Netrunner;
    highlightData.isRevealed = true;
    GameObject.ForceVisionAppearance(this, highlightData);
  }

  public final func DisableFocusedShootingHighlight() {
    let highlightData = new FocusForcedHighlightData();
    highlightData.sourceID = this.GetOwner().GetEntityID();
    highlightData.sourceName = this.GetOwner().GetClassName();
    highlightData.outlineType = EFocusOutlineType.HOSTILE;
    highlightData.highlightType = EFocusForcedHighlightType.HOSTILE;
    highlightData.priority = EPriority.VeryHigh;
    highlightData.inTransitionTime = 0.0;
    highlightData.outTransitionTime = 0.5;
    highlightData.patternType = VisionModePatternType.Netrunner;
    highlightData.isRevealed = true;
    this.CancelForcedVisionAppearance(highlightData);
  }

  public final func TriggerLookAtThisGrenade() {
    let aimRequest: AimRequest;
    aimRequest.duration = 0.1;
    aimRequest.adjustPitch = true;
    aimRequest.adjustYaw = true;
    aimRequest.endOnTargetReached = false;
    aimRequest.endOnCameraInputApplied = true;
    aimRequest.endOnTimeExceeded = false;
    aimRequest.endOnAimingStopped = true;
    aimRequest.cameraInputMagToBreak = 0.4;
    aimRequest.cameraMouseInputMagToBreak = 10.0;
    aimRequest.easeIn = true;
    aimRequest.easeOut = true;
    aimRequest.bodyPartsTracking = false;
    aimRequest.checkRange = false;
    aimRequest.processAsInput = true;
    this.ActivateFocusedShootingAim(aimRequest);
  }
}

