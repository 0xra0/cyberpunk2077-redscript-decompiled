class TerminalInkGameControllerBase extends MasterDeviceInkGameControllerBase {
  protected let m_layoutID: TweakDBID;
  protected let m_currentLayoutLibraryID: CName;
  protected let m_mainLayout: wref<inkWidget>;
  protected let m_currentlyActiveDevices: [PersistentID];
  private let m_buttonVisibility: Bool;
  private let m_mainDisplayWidget: wref<inkVideo>;
  private let m_terminalTitle: String;
  private let m_onGlitchingStateChangedListener: CallbackHandle;

  protected cb func OnUninitialize() -> Bool {
    super.OnUninitialize();
    if IsDefined(this.m_mainDisplayWidget) {
      this.m_mainDisplayWidget.Stop();
    }
  }

  protected func SetupWidgets() {
    if !this.m_isInitialized {
      this.m_mainDisplayWidget = this.GetWidget(n"main_display") as inkVideo;
      this.m_mainDisplayWidget.SetVisible(false);
      this.InitializeMainLayout();
    }
  }

  protected func RegisterBlackboardCallbacks(blackboard: IBlackboard) {
    super.RegisterBlackboardCallbacks(blackboard);
    if IsDefined(blackboard) {
      this.m_onGlitchingStateChangedListener = blackboard
        .RegisterListenerVariant(
          this.GetOwner().GetBlackboardDef().GlitchData,
          this,
          n"OnGlitchingStateChanged"
        );
    }
  }

  protected func UnRegisterBlackboardCallbacks(blackboard: IBlackboard) {
    super.UnRegisterBlackboardCallbacks(blackboard);
    if IsDefined(blackboard) {
      blackboard
        .UnregisterListenerVariant(
          this.GetOwner().GetBlackboardDef().GlitchData,
          this.m_onGlitchingStateChangedListener
        );
    }
  }

  private final func SetupTerminalTitle() {
    if this.GetOwner().ShouldShowTerminalTitle() {
      this.m_terminalTitle = this.GetOwner().GetDisplayName();
    }
  }

  public const final func GetTerminalTitle() -> String {
    return this.m_terminalTitle;
  }

  protected func InitializeMainLayout() {
    if !TDBID.IsValid(this.m_layoutID) {
      this.m_layoutID = t"DevicesUIDefinitions.TerminalLayoutWidget";
    }
    let screenDef = this.GetScreenDefinition();
    let layoutRecord = TweakDBInterface.GetWidgetDefinitionRecord(this.m_layoutID);
    let newLibraryID = this
      .GetCurrentFullLibraryID(
        layoutRecord,
        screenDef.screenDefinition.TerminalScreenType(),
        screenDef.style
      );
    if Equals(this.m_currentLayoutLibraryID, newLibraryID) {
      return;
    } else if this.m_mainLayout != null {
      (this.GetRootWidget() as inkCompoundWidget).RemoveChild(this.m_mainLayout);
    }
    let spawnData = new AsyncSpawnData();
    spawnData.Initialize(this, n"OnMainLayoutSpawned", ToVariant(null), this);
    this.m_currentLayoutLibraryID = this
      .RequestWidgetFromLibrary(
        this.GetRootWidget(),
        layoutRecord,
        screenDef.screenDefinition.TerminalScreenType(),
        screenDef.style,
        spawnData
      );
    this.SetupTerminalTitle();
  }

  protected final func IsMainLayoutInitialized() -> Bool {
    return this.m_mainLayout != null;
  }

  protected cb func OnMainLayoutSpawned(widget: inkWidget, userData: IScriptable) -> Bool {
    this.m_mainLayout = widget;
    this.m_mainLayout.SetAnchor(inkEAnchor.Fill);
    let controller = this.GetMainLayoutController();
    if IsDefined(controller) {
      this.RegisterReturnButtonCallback();
      controller.Initialize(this);
    } else if this.GetOwner().IsReadyForUI() {
      this.Refresh(this.GetOwner().GetDeviceState());
    }
  }

  protected func UpdateThumbnailWidgets(const widgetsData: script_ref<[SThumbnailWidgetPackage]>) {
    let i: Int32;
    super.UpdateThumbnailWidgets(widgetsData);
    this
      .GetMainLayoutController()
      .GetDevicesSlot()
      .SetVisible(false);
    this
      .GetMainLayoutController()
      .GetThumbnailListSlot()
      .SetVisible(true);
    if ArraySize(widgetsData) == 1 {
      if !this.IsOwner(widgetsData[i].ownerID) {
        this.m_buttonVisibility = false;
        ArrayClear(this.m_currentlyActiveDevices);
        ArrayPush(this.m_currentlyActiveDevices, widgetsData[i].ownerID);
        this.RequestDeviceWidgetsUpdate(this.m_currentlyActiveDevices);
      }
    } else {
      this.m_buttonVisibility = true;
      i = 0;
      if i < ArraySize(widgetsData) {
        let widget = this.GetThumbnailWidget(widgetsData[i]);
        if widget == null {
          this
            .CreateThumbnailWidgetAsync(this.GetMainLayoutController().GetThumbnailListSlot(), widgetsData[i]);
        } else {
          this.InitializeThumbnailWidget(widget, widgetsData[i]);
          i += 1;
        }
      }
    }
    this.GoUp();
    this.UpdateReturnButtonVisibility();
  }

  protected func UpdateDeviceWidgets(const widgetsData: script_ref<[SDeviceWidgetPackage]>) {
    super.UpdateDeviceWidgets(widgetsData);
    ArrayClear(this.m_currentlyActiveDevices);
    this
      .GetMainLayoutController()
      .GetDevicesSlot()
      .SetVisible(true);
    this
      .GetMainLayoutController()
      .GetThumbnailListSlot()
      .SetVisible(false);
    this.GetMainLayoutController().HideBackgroundIcon();
    let i = 0;
    while i < ArraySize(widgetsData) {
      if !this.IsOwner(widgetsData[i].ownerID) {
        ArrayPush(this.m_currentlyActiveDevices, widgetsData[i].ownerID);
      }
      let widget = this.GetDeviceWidget(widgetsData[i]);
      if widget == null {
        this
          .CreateDeviceWidgetAsync(this.GetMainLayoutController().GetDevicesSlot(), widgetsData[i]);
      } else {
        this.InitializeDeviceWidget(widget, widgetsData[i]);
      }
      i += 1;
    }
    let element = this.GetCurrentBreadcrumbElement();
    if NotEquals(element.elementName, "device") {
      element.elementName = "device";
      this.GoDown(element);
    }
    this.UpdateReturnButtonVisibility();
  }

  protected func GetOwner() -> InteractiveMasterDevice {
    return this.GetOwnerEntity() as InteractiveMasterDevice;
  }

  protected func Refresh(state: EDeviceStatus) {
    this.SetupWidgets();
    this.InitializeMainLayout();
    if !this.IsMainLayoutInitialized() {
      return;
    }
    switch state {
      case EDeviceStatus.ON:
        this.TurnOn();
        break;
      case EDeviceStatus.OFF:
        this.TurnOff();
        break;
      case EDeviceStatus.UNPOWERED:
        this.TurnOff();
        break;
      case EDeviceStatus.DISABLED:
        this.TurnOff();
        break;
      default:
        super.Refresh(state);
    }
  }

  protected final func RegisterReturnButtonCallback() {
    this
      .GetMainLayoutController()
      .GetReturnButton()
      .RegisterToCallback(n"OnRelease", this, n"OnReturnCallback");
  }

  protected cb func OnReturnCallback(e: inkPointerEvent) -> Bool {
    if e.IsAction(n"click") {
      this.GoUp();
      this.ResolveBreadcrumbLevel();
    }
  }

  protected func ResolveBreadcrumbLevel() {
    if !this
      .GetOwner()
      .GetDevicePS()
      .IsPlayerAuthorized()
      || this.GetOwner().HasActiveStaticHackingSkillcheck()
      || this.GetOwner().ShouldAlwaysUpdateDeviceWidgets() {
      this.RequestDeviceWidgetsUpdate();
      return;
    } else if ArraySize(this.m_currentlyActiveDevices) == 0 {
      this.ClearBreadcrumbStack();
    }
    let element = this.GetCurrentBreadcrumbElement();
    if !IsStringValid(element.elementName) {
      this.RequestThumbnailWidgetsUpdate();
      this.GetMainLayoutController().ShowBackgroundIcon();
    } else if Equals(element.elementName, "device") {
      this.RequestDeviceWidgetsUpdate(this.m_currentlyActiveDevices);
      this.GetMainLayoutController().HideBackgroundIcon();
    }
  }

  public func UpdateBreadCrumbBar(const data: script_ref<SBreadCrumbUpdateData>) {
    let currentElement = this.GetCurrentBreadcrumbElement();
    if NotEquals(data.elementName, currentElement.elementName) {
      if !IsStringValid(data.elementName) {
        this.ClearBreadcrumbStack();
        this.ResolveBreadcrumbLevel();
      }
    }
  }

  public func GetMainLayoutController() -> TerminalMainLayoutWidgetController {
    return this.m_mainLayout.GetController() as TerminalMainLayoutWidgetController;
  }

  protected final func TurnOn() {
    this.m_mainLayout.SetVisible(true);
    this.ResolveBreadcrumbLevel();
  }

  protected final func TurnOff() {
    this.ClearBreadcrumbStack();
    this.m_mainLayout.SetVisible(false);
  }

  protected final func UpdateReturnButtonVisibility() {
    if ArraySize(this.m_breadcrumbStack) == 0 {
      this
        .GetMainLayoutController()
        .GetReturnButton()
        .SetVisible(false);
    } else {
      this
        .GetMainLayoutController()
        .GetReturnButton()
        .SetVisible(true && this.m_buttonVisibility);
    }
  }

  private func StartGlitchingScreen(glitchData: GlitchData) {
    let glitchVideoPath: ResRef;
    if Equals(glitchData.state, EGlitchState.SUBLIMINAL_MESSAGE) {
      glitchVideoPath = this.GetOwner().GetBroadcastGlitchVideoPath();
    } else {
      glitchVideoPath = this.GetOwner().GetDefaultGlitchVideoPath();
    }
    if ResRef.IsValid(glitchVideoPath) {
      this.m_mainDisplayWidget.SetVisible(true);
      this.m_mainLayout.SetVisible(false);
      this.StopVideo();
      this.PlayVideo(glitchVideoPath, true, n"None");
    }
  }

  private func StopGlitchingScreen() {
    this.StopVideo();
    this.m_mainDisplayWidget.SetVisible(false);
    this.m_mainLayout.SetVisible(true);
  }

  public final func PlayVideo(videoPath: ResRef, looped: Bool, audioEvent: CName) {
    this.m_mainDisplayWidget.SetVideoPath(videoPath);
    this.m_mainDisplayWidget.SetLoop(looped);
    if IsNameValid(audioEvent) {
      this.m_mainDisplayWidget.SetAudioEvent(audioEvent);
    }
    this.m_mainDisplayWidget.Play();
  }

  public final func StopVideo() {
    this.m_mainDisplayWidget.Stop();
  }
}

class TriggerFearRunningVO extends AIbehaviortaskScript {
  protected func Activate(context: ScriptExecutionContext) {
    let stimTarget = ScriptExecutionContext.GetArgumentObject(context, n"StimTarget");
    let vehicle = stimTarget as VehicleObject;
    let triggerVOEvent = new SoundPlayVo();
    if VehicleComponent
      .IsMountedToVehicle(ScriptExecutionContext.GetOwner(context).GetGame(), stimTarget) || IsDefined(vehicle) {
      triggerVOEvent.voContext = n"pedestrian_hit";
      triggerVOEvent.debugInitialContext = n"Script:TriggerFearRunningVO/pedestrian";
      GameInstance
        .GetDelaySystem(ScriptExecutionContext.GetOwner(context).GetGame())
        .DelayEvent(
          ScriptExecutionContext.GetOwner(context),
          triggerVOEvent,
          RandRangeF(0.2, 0.7)
        );
    } else {
      triggerVOEvent.voContext = n"fear_run";
      triggerVOEvent.debugInitialContext = n"Script:TriggerFearRunningVO";
      GameInstance
        .GetDelaySystem(ScriptExecutionContext.GetOwner(context).GetGame())
        .DelayEvent(
          ScriptExecutionContext.GetOwner(context),
          triggerVOEvent,
          RandRangeF(0.2, 0.7)
        );
    }
  }
}

class ComputerYaibaShowroomController extends inkGameController {
  private let m_orderedFact: CName;
  private let m_toBuyPageAnim: CName;
  protected let m_modelText: inkTextRef;
  protected let m_homePage: inkWidgetRef;
  protected let m_buyButton: inkWidgetRef;
  protected let m_buyPage: inkWidgetRef;
  protected let m_playerBalanceText: inkTextRef;
  protected let m_detailsCanvas: inkWidgetRef;
  protected let m_speedometer: inkImageRef;
  protected let m_orderButton: inkWidgetRef;
  protected let m_backButton: inkWidgetRef;
  private let m_wheelCoverCheckBox: inkWidgetRef;
  private let m_wheelRimsCheckBox: inkWidgetRef;
  private let m_brandingCheckBox: inkWidgetRef;
  private let m_backRestCheckBox: inkWidgetRef;
  private let m_wheelCoverPreview: inkWidgetRef;
  private let m_wheelRimsPreview: inkWidgetRef;
  private let m_brandingPreview: inkWidgetRef;
  private let m_backRestPreview: inkWidgetRef;
  private let m_inventoryListener: InventoryScriptListener;
  private let m_orderButtonController: wref<YaibaButton>;
  private let m_backButtonController: wref<YaibaButton>;
  private let m_wheelCoverCheckController: wref<CheckYaibaOption>;
  private let m_wheelRimsCheckController: wref<CheckYaibaOption>;
  private let m_brandingCheckController: wref<CheckYaibaOption>;
  private let m_backRestCheckController: wref<CheckYaibaOption>;
  private let m_wheelCoverFact: CName;
  private let m_WheelRimsFact: CName;
  private let m_BrandingFact: CName;
  private let m_BackRestFact: CName;
  private let m_isAnimated: Bool;
  private let m_settings: UserSettings;

  protected cb func OnInitialize() -> Bool {
    let isAvailable = this.CheckAvailability();
    this.RefreshModelText();
    inkWidgetRef
      .RegisterToCallback(this.m_buyButton, n"OnRelease", this, n"OnReleaseBuyButton");
    let isVehicleAvailable = isAvailable;
    this.m_orderButtonController = inkWidgetRef.GetController(this.m_orderButton) as YaibaButton;
    this
      .m_orderButtonController
      .RegisterToCallback(n"OnRelease", this, n"OnOrderRelease");
    this.m_orderButtonController.SetEnabled(isAvailable);
    this.m_backButtonController = inkWidgetRef.GetController(this.m_backButton) as YaibaButton;
    this
      .m_backButtonController
      .RegisterToCallback(n"OnRelease", this, n"OnBackRelease");
    this.m_wheelCoverCheckController = this
      .InitCheckBox(
        this.m_wheelCoverCheckBox,
        isVehicleAvailable,
        inkWidgetRef.Get(this.m_wheelCoverPreview),
        this.m_wheelCoverFact
      );
    this.m_wheelRimsCheckController = this
      .InitCheckBox(
        this.m_wheelRimsCheckBox,
        isVehicleAvailable,
        inkWidgetRef.Get(this.m_wheelRimsPreview),
        this.m_WheelRimsFact
      );
    this.m_brandingCheckController = this
      .InitCheckBox(
        this.m_brandingCheckBox,
        isVehicleAvailable,
        inkWidgetRef.Get(this.m_brandingPreview),
        this.m_BrandingFact
      );
    this.m_backRestCheckController = this
      .InitCheckBox(
        this.m_backRestCheckBox,
        isVehicleAvailable,
        inkWidgetRef.Get(this.m_backRestPreview),
        this.m_BackRestFact
      );
    this.m_settings = this.GetSystemRequestsHandler().GetUserSettings();
    let speedunitsVar = this.m_settings.GetVar(n"/interface", n"SpeedometerUnits") as ConfigVarListString;
    switch speedunitsVar.GetIndex() {
      case 0:
        inkImageRef.SetTexturePart(this.m_speedometer, n"muramasa_maxspeed_kph");
        break;
      case 1:
        inkImageRef.SetTexturePart(this.m_speedometer, n"muramasa_maxspeed_mph");
    }
  }

  protected cb func OnReleaseBuyButton(e: inkPointerEvent) -> Bool {
    if this.m_isAnimated {
      return false;
    } else if e.IsAction(n"click") {
      this.SwitchToBuyPage();
      e.Handle();
    }
  }

  protected cb func OnBackRelease(e: inkPointerEvent) -> Bool {
    if this.m_isAnimated {
      return false;
    } else if e.IsAction(n"click") {
      this.SwitchToHomePage();
      e.Handle();
    }
  }

  protected cb func OnAnimFinished(proxy: inkAnimProxy) -> Bool {
    this.m_isAnimated = false;
  }

  protected cb func OnCheckChanged(checkBox: wref<inkWidget>) -> Bool {
    this.RefreshModelText();
  }

  protected cb func OnOrderRelease(e: inkPointerEvent) -> Bool {
    if this.m_isAnimated {
      return false;
    } else if e.IsAction(n"click") {
      if this.CheckAvailability() {
        this
          .SetFact(
            this.m_wheelCoverFact,
            this.m_wheelCoverCheckController.IsChecked() ? 1 : 0
          );
        this
          .SetFact(
            this.m_WheelRimsFact,
            this.m_wheelRimsCheckController.IsChecked() ? 1 : 0
          );
        this
          .SetFact(this.m_BrandingFact, this.m_brandingCheckController.IsChecked() ? 1 : 0);
        this
          .SetFact(this.m_BackRestFact, this.m_backRestCheckController.IsChecked() ? 1 : 0);
        this.SetFact(this.m_orderedFact, 1);
        this.OnOrdered();
      }
    }
  }

  private final func InitCheckBox(checkBox: inkWidgetRef, isEnabled: Bool, preview: wref<inkWidget>, fact: CName) -> wref<CheckYaibaOption> {
    let controller = inkWidgetRef.GetController(checkBox) as CheckYaibaOption;
    controller.Initialize((this.GetOwnerEntity() as GameObject).GetGame(), preview, fact);
    controller.SetEnabled(isEnabled);
    controller.RegisterToCallback(n"OnValueChanged", this, n"OnCheckChanged");
    return controller;
  }

  private final func RefreshModelText() {
    let text = GetLocalizedTextByKey(
      n"Story-base-journal-onscreens-emails-quests-minor_quest-mq060-terminal-Mq060_terminal_Muramasa_subtitle_codename"
    );
    text += " - ";
    text += (this.m_wheelCoverCheckController.IsChecked() ? "1" : "0");
    text += (this.m_wheelRimsCheckController.IsChecked() ? "1" : "0");
    text += (this.m_brandingCheckController.IsChecked() ? "1" : "0");
    text += (this.m_backRestCheckController.IsChecked() ? "1" : "0");
    inkTextRef.SetText(this.m_modelText, text);
  }

  private final func SwitchToHomePage() {
    let options: inkAnimOptions;
    options.playReversed = true;
    this
      .PlayLibraryAnimation(this.m_toBuyPageAnim, options)
      .RegisterToCallback(inkanimEventType.OnFinish, this, n"OnAnimFinished");
    this.m_isAnimated = true;
  }

  private final func SwitchToBuyPage() {
    this
      .PlayLibraryAnimation(this.m_toBuyPageAnim)
      .RegisterToCallback(inkanimEventType.OnFinish, this, n"OnAnimFinished");
    this.m_isAnimated = true;
  }

  public final func CheckAvailability() -> Bool {
    return GetFact(this.GetGame(), this.m_orderedFact) == 0;
  }

  public final func SetFact(factName: CName, factCount: Int32) -> Bool {
    return SetFactValue(this.GetGame(), factName, factCount);
  }

  protected final func GetGame() -> GameInstance {
    let gameInstance: GameInstance;
    let gameObject = this.GetOwnerEntity() as GameObject;
    if IsDefined(gameObject) {
      gameInstance = gameObject.GetGame();
    }
    return gameInstance;
  }

  private final func GetPlayerMoney() -> Int32 {
    let gi = this.GetGame();
    let player = GameInstance.GetPlayerSystem(gi).GetLocalPlayerControlledGameObject() as PlayerPuppet;
    let transactionSystem = GameInstance.GetTransactionSystem(gi);
    return transactionSystem.GetItemQuantity(player, MarketSystem.Money());
  }

  private final func RemovePlayerMoney(amount: Int32) -> Bool {
    let gi = this.GetGame();
    let player = GameInstance.GetPlayerSystem(gi).GetLocalPlayerControlledGameObject() as PlayerPuppet;
    let transactionSystem = GameInstance.GetTransactionSystem(gi);
    return transactionSystem.RemoveItem(player, MarketSystem.Money(), amount);
  }

  private final func OnOrdered() {
    this.m_wheelCoverCheckController.SetEnabled(false);
    this.m_wheelRimsCheckController.SetEnabled(false);
    this.m_brandingCheckController.SetEnabled(false);
    this.m_backRestCheckController.SetEnabled(false);
    this.m_orderButtonController.SetEnabled(false);
    this.ShowNotification();
  }

  private final func ShowNotification() {
    this.PlayLibraryAnimation(n"notification_anim");
  }
}

class SimpleBinkGameController extends DeviceInkGameControllerBase {
  protected let playCommonAd: Bool;
  protected let m_Video1Path: CName;
  protected let m_Video2Path: CName;
  private let m_Video1: inkVideoRef;
  private let m_Video2: inkVideoRef;

  protected cb func OnInitialize() -> Bool {
    super.OnInitialize();
    if this.playCommonAd {
      this.StartVideo1();
    }
  }

  protected cb func OnUninitialize() -> Bool;

  public final func switchAd() {
    if this.playCommonAd {
      this.StartVideo2();
      this.playCommonAd = false;
    } else {
      this.StartVideo1();
      this.playCommonAd = true;
    }
  }

  public final func StartVideo2() {
    inkVideoRef.Stop(this.m_Video2);
    inkWidgetRef.SetVisible(this.m_Video1, false);
    inkWidgetRef.SetVisible(this.m_Video2, true);
    inkVideoRef.Play(this.m_Video2);
  }

  private final func StartVideo1() {
    inkVideoRef.Stop(this.m_Video1);
    inkWidgetRef.SetVisible(this.m_Video2, false);
    inkWidgetRef.SetVisible(this.m_Video1, true);
    inkVideoRef.Play(this.m_Video1);
  }
}

