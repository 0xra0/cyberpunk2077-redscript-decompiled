    super.Initialize(recordID);
    let str = TweakDBInterface.GetString(recordID + t".attackSubtype", "");
    let result = Cast<Int32>(EnumValueFromString("gamedataAttackSubtype", str));
    if result < 0 {
      this.m_attackSubtype = gamedataAttackSubtype.Invalid;
    } else {
      this.m_attackSubtype = IntEnum<gamedataAttackSubtype>(result);
    }
  }
}

