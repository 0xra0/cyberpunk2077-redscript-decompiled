class DoorStatus extends BaseDeviceStatus {
  public func SetProperties(const deviceRef: ScriptableDeviceComponentPS) {
    super.SetProperties(deviceRef);
    this.actionName = n"DoorStatus";
    this.prop.second = ToVariant(EnumInt((deviceRef as DoorControllerPS).GetDoorState()));
  }

  public const func GetCurrentDisplayString() -> String {
    let str: String;
    if FromVariant<Int32>(this.prop.first) >= 0 {
      switch this.prop.second {
        case ToVariant(-2):
          str = "LocKey#17804";
          break;
        case ToVariant(-1):
          str = "LocKey#17805";
          break;
        case ToVariant(0):
          str = "LocKey#17806";
          break;
        case ToVariant(1):
          str = "LocKey#17807";
          break;
      }
    } else {
      return super.GetCurrentDisplayString();
    }
    return str;
  }

  public const func GetStatusValue() -> Int32 {
    if FromVariant<Int32>(this.prop.first) > 0 {
      return FromVariant<Int32>(this.prop.second);
    }
    return FromVariant<Int32>(this.prop.first);
  }

  public final static func IsDefaultConditionMet(device: ScriptableDeviceComponentPS, const context: script_ref<GetActionsContext>) -> Bool {
    if DoorStatus.IsAvailable(device) && DoorStatus.IsClearanceValid(context.clearance) {
      return true;
    }
    return false;
  }

  public final static func IsAvailable(device: ScriptableDeviceComponentPS) -> Bool {
    return BaseDeviceStatus.IsAvailable(device);
  }

  public final static func IsClearanceValid(clearance: Clearance) -> Bool {
    return BaseDeviceStatus.IsClearanceValid(clearance);
  }

  public func GetTweakDBChoiceRecord() -> String {
    return "wrong_action";
  }
}

class DoorViabilityInterpreter extends IScriptable {
  public final static func Evaluate(device: DoorControllerPS, hasActiveActions: Bool) -> Bool {
    let basicCheckResult = BasicViabilityInterpreter.Evaluate(device, hasActiveActions);
    if device.IsOpen() {
      return false;
    } else if Equals(basicCheckResult, EViabilityDecision.VIABLE) {
      return true;
    } else if Equals(basicCheckResult, EViabilityDecision.NONVIABLE) {
      return false;
    } else if Equals(device.GetDoorType(), EDoorType.REMOTELY_CONTROLLED) {
      return false;
    } else if device.IsSealed() || device.IsLocked() {
      return false;
    } else if device.IsUnpowered() {
      return false;
    }
    return true;
  }
}

