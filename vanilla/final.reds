  private final func GetMaxNumberOfSegmentsForVirtualNetwork(virtualNetworkRecord: wref<VirtualNetwork_Record>) -> Int32 {
    let paths: [wref<VirtualNetworkPath_Record>];
    let segments: Int32;
    virtualNetworkRecord.Paths(paths);
    let i = 0;
    while i < ArraySize(paths) {
      let points = paths[i].Points();
      let currentSegments = ArraySize(points) - 1;
      if i == 0 {
        segments = currentSegments;
      } else if currentSegments > segments {
        segments = currentSegments;
      }
      i += 1;
    }
    return segments;
  }

