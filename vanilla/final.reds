    if !this.m_initialized {
      this.m_actionBBoard = AIBehaviorScriptBase
        .GetPuppet(context)
        .GetAIControllerComponent()
        .GetActionBlackboard();
    } else if !this.m_onDeactivation {
      this
        .m_actionBBoard
        .SetFloat(GetAllBlackboardDefs().AIAction.avoidLOSTimeStamp, 0.0);
    }
  }

  protected func Deactivate(context: ScriptExecutionContext) {
    if this.m_onDeactivation {
      this
        .m_actionBBoard
        .SetFloat(GetAllBlackboardDefs().AIAction.avoidLOSTimeStamp, 0.0);
    }
  }
}

