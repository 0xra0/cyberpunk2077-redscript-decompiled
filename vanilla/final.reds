class PlayerHandicapSystem extends IPlayerHandicapSystem {
  private let m_canDropHealingConsumable: Bool;
  private let m_canDropAmmo: Bool;

  public final static func GetInstance(owner: wref<GameObject>) -> PlayerHandicapSystem {
    let PHS = GameInstance.GetScriptableSystemsContainer(owner.GetGame()).Get(n"PlayerHandicapSystem") as PlayerHandicapSystem;
    return PHS;
  }

  public const final func CanDropHealingConsumable() -> Bool {
    return this.m_canDropHealingConsumable;
  }

  private final func OnBlockHealingConsumableDrop(request: BlockHealingConsumableDrop) {
    if this.m_canDropHealingConsumable {
      let newRequest = new UnblockHealingConsumableDrop();
      let delay = TweakDBInterface.GetFloat(t"GlobalStats.DelayOnDroppingSupportiveConsumable.value", 30.0);
      GameInstance
        .GetDelaySystem(this.GetGameInstance())
        .DelayScriptableSystemRequest(n"PlayerHandicapSystem", newRequest, delay, true);
    }
    this.m_canDropHealingConsumable = false;
  }

  private final func OnUnblockHealingConsumableDrop(request: UnblockHealingConsumableDrop) {
    this.m_canDropHealingConsumable = true;
  }

  public const final func CanDropAmmo() -> Bool {
    return this.m_canDropAmmo;
  }

  private final func OnBlockAmmoDrop(request: BlockAmmoDrop) {
    if this.m_canDropAmmo {
      let delay = TweakDBInterface.GetFloat(t"GlobalStats.DelayOnDroppingHandicapAmmo.value", 30.0);
      let unblockRequest = new UnblockAmmoDrop();
      GameInstance
        .GetDelaySystem(this.GetGameInstance())
        .DelayScriptableSystemRequest(n"PlayerHandicapSystem", unblockRequest, delay, true);
    }
    this.m_canDropAmmo = false;
  }

  private final func OnUnblockAmmoDrop(request: UnblockAmmoDrop) {
    this.m_canDropAmmo = true;
  }
}

