class ApplyRandomStatusEffectEffector extends Effector {
  public let m_targetEntityID: EntityID;
  public let m_applicationTarget: CName;
  public let m_effects: [TweakDBID];
  public let m_appliedEffect: TweakDBID;

  protected func Initialize(record: TweakDBID, game: GameInstance, parentRecord: TweakDBID) {
    let strs = TDB.GetStringArray(record + t".statusEffects");
    let i = 0;
    while i < ArraySize(strs) {
      ArrayPush(this.m_effects, TDBID.Create(strs[i]));
      i += 1;
    }
    this.m_applicationTarget = TweakDBInterface.GetCName(record + t".applicationTarget", n"None");
  }

  protected func Uninitialize(game: GameInstance) {
    this.RemoveStatusEffect(game);
  }

  protected func ActionOn(owner: GameObject) {
    if !this
      .GetApplicationTarget(owner, this.m_applicationTarget, this.m_targetEntityID) {
      return;
    }
    this.SetRandomStatusEffect();
    let ses = GameInstance.GetStatusEffectSystem(owner.GetGame());
    ses.ApplyStatusEffect(this.m_targetEntityID, this.m_appliedEffect);
  }

  protected func ActionOff(owner: GameObject) {
    this.RemoveStatusEffect(owner.GetGame());
  }

  private final func RemoveStatusEffect(gameInstance: GameInstance) {
    if !EntityID.IsDefined(this.m_targetEntityID) {
      return;
    }
    let ses = GameInstance.GetStatusEffectSystem(gameInstance);
    ses.RemoveStatusEffect(this.m_targetEntityID, this.m_appliedEffect);
  }

  private final func SetRandomStatusEffect() {
    let i = RandRange(0, ArraySize(this.m_effects));
    this.m_appliedEffect = this.m_effects[i];
  }
}

