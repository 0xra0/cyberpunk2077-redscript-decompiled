class LocomotionSwimming extends LocomotionTransition {
  protected const final func IsFallingSpeedToEnterDiveAcceptable(const stateContext: StateContext, const scriptInterface: StateGameScriptInterface) -> Bool {
    let height = this.GetStaticFloatParameterDefault("minFallHeight", 2.0);
    let fallingSpeedThreshold = this.GetFallingSpeedBasedOnHeight(scriptInterface, height);
    let verticalSpeed = this.GetVerticalSpeed(scriptInterface);
    if verticalSpeed <= fallingSpeedThreshold {
      return true;
    }
    return false;
  }

  protected const final func IsDivingBlockedByPhoneCall(const stateContext: StateContext, const scriptInterface: StateGameScriptInterface) -> Bool {
    return StatusEffectSystem.ObjectHasStatusEffectWithTag(scriptInterface.executionOwner, n"PhoneCall") && !scriptInterface.HasStatFlag(gamedataStatType.CanUsePhoneUnderWater);
  }

  protected const final func IsDeepEnoughToDive(const stateContext: StateContext, const scriptInterface: StateGameScriptInterface) -> Bool {
    let depthTreshold = this.GetStaticFloatParameterDefault("depthTreshold", 0.0);
    let tolerance = this.GetStaticFloatParameterDefault("tolerance", 0.0);
    let currentDepth = this.GetCurrentDepth(stateContext, scriptInterface);
    if currentDepth <= depthTreshold + tolerance {
      return true;
    }
    return false;
  }

  protected const final func GetCurrentDepth(const stateContext: StateContext, const scriptInterface: StateGameScriptInterface) -> Float {
    let waterLevel: Float;
    let maxDepth = 100.0;
    let playerFeetPosition = DefaultTransition.GetPlayerPosition(scriptInterface);
    let depthRaycastDestination = playerFeetPosition;
    depthRaycastDestination.Z = depthRaycastDestination.Z - maxDepth;
    let currentDepth = maxDepth;
    if scriptInterface.GetWaterLevel(playerFeetPosition, depthRaycastDestination, waterLevel) {
      currentDepth = playerFeetPosition.Z - waterLevel;
    }
    return currentDepth;
  }

  protected const final func CanEnterFastSwimming(const stateContext: StateContext, const scriptInterface: StateGameScriptInterface) -> Bool {
    let isAiming = scriptInterface.localBlackboard.GetInt(GetAllBlackboardDefs().PlayerStateMachine.UpperBody) == 6;
    let isReloading = scriptInterface.localBlackboard.GetInt(GetAllBlackboardDefs().PlayerStateMachine.Weapon) == 2;
    let isFocusMode = scriptInterface.localBlackboard.GetInt(GetAllBlackboardDefs().PlayerStateMachine.Vision) == 1;
    let isChargingCyberware = scriptInterface
      .localBlackboard
      .GetInt(GetAllBlackboardDefs().PlayerStateMachine.LeftHandCyberware) == 5;
    let minLinearVelocityThreshold = this.GetStaticFloatParameterDefault("minLinearVelocityThreshold", 0.5);
    let minStickInputThreshold = this.GetStaticFloatParameterDefault("minStickInputThreshold", 0.9);
    let enterAngleThreshold = this.GetStaticFloatParameterDefault("enterAngleThreshold", -180.0);
    if !scriptInterface.IsMoveInputConsiderable()
      || AbsF(scriptInterface.GetInputHeading()) > enterAngleThreshold
      || DefaultTransition.GetMovementInputActionValue(stateContext, scriptInterface) <= minStickInputThreshold
      || scriptInterface.GetOwnerStateVectorParameterFloat(physicsStateValue.LinearSpeed) < minLinearVelocityThreshold {
      stateContext.SetConditionBoolParameter(n"SprintToggled", false, true);
      return false;
    } else if isAiming {
      return false;
    } else if isChargingCyberware {
      return false;
    } else if (isFocusMode || stateContext.GetConditionBool(n"VisionToggled")) && !DefaultTransition.IsInRpgContext(scriptInterface) {
      return false;
    } else if scriptInterface
      .localBlackboard
      .GetInt(GetAllBlackboardDefs().PlayerStateMachine.CombatGadget) == 3 {
      return false;
    } else if isReloading
      && scriptInterface.GetActionValue(n"Sprint") > 0.0
      && !scriptInterface.IsActionJustPressed(n"Sprint") {
      return false;
    } else if stateContext.GetConditionBool(n"SprintToggled") {
      return true;
    } else if scriptInterface.GetActionValue(n"ToggleSprint") > 0.0 {
      stateContext.SetConditionBoolParameter(n"SprintToggled", true, true);
    } else if scriptInterface.GetActionValue(n"Sprint") > 0.0 {
      return true;
    }
    return false;
  }

  protected const final func ShouldExitFastSwimming(const stateContext: StateContext, const scriptInterface: StateGameScriptInterface) -> Bool {
    if stateContext.GetBoolParameter(n"InterruptSprint") {
      stateContext.SetConditionBoolParameter(n"SprintToggled", false, true);
      return true;
    }
    let minLinearVelocityThreshold = this.GetStaticFloatParameterDefault("minLinearVelocityThreshold", 0.5);
    if scriptInterface.GetOwnerStateVectorParameterFloat(physicsStateValue.LinearSpeed) < minLinearVelocityThreshold {
      stateContext.SetConditionBoolParameter(n"SprintToggled", false, true);
      return true;
    }
    let enterAngleThreshold = this.GetStaticFloatParameterDefault("enterAngleThreshold", 45.0);
    if !scriptInterface.IsMoveInputConsiderable() || !(AbsF(scriptInterface.GetInputHeading()) <= enterAngleThreshold) {
      stateContext.SetConditionBoolParameter(n"SprintToggled", false, true);
      return true;
    }
    let minStickInputThreshold = this.GetStaticFloatParameterDefault("minStickInputThreshold", 0.9);
    if stateContext.GetConditionBool(n"SprintToggled")
      && DefaultTransition.GetMovementInputActionValue(stateContext, scriptInterface) <= minStickInputThreshold {
      stateContext.SetConditionBoolParameter(n"SprintToggled", false, true);
      return true;
    } else if scriptInterface.IsActionJustReleased(n"Sprint") {
      stateContext.SetConditionBoolParameter(n"SprintToggled", false, true);
      return true;
    }
    return false;
  }
}

