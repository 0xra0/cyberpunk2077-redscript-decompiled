class IsAccessPointFilter extends EffectObjectSingleFilter_Scripted {
  public final func Process(ctx: EffectScriptContext, filterCtx: EffectSingleFilterScriptContext) -> Bool {
    let entity = EffectSingleFilterScriptContext.GetEntity(filterCtx);
    if IsDefined(entity as AccessPoint) {
      return true;
    }
    return false;
  }
}

class IsDeviceTargetValidFilter extends EffectObjectSingleFilter_Scripted {
  public final func Process(ctx: EffectScriptContext, filterCtx: EffectSingleFilterScriptContext) -> Bool {
    let dataVariant: Variant;
    let target = EffectSingleFilterScriptContext.GetEntity(filterCtx) as ScriptedPuppet;
    if target == null || !ScriptedPuppet.IsActive(target) || !target.IsOnAutonomousAI() {
      return false;
    }
    let characterRecord = TweakDBInterface.GetCharacterRecord(target.GetRecordID());
    if !IsDefined(characterRecord) {
      return false;
    }
    EffectData
      .GetVariant(
        EffectScriptContext.GetSharedData(ctx),
        GetAllBlackboardDefs().EffectSharedData.forceVisionAppearanceData,
        dataVariant
      );
    let data = FromVariant<PuppetForceVisionAppearanceData>(dataVariant);
    if data != null {
      if !this.CanReactOnStimType(target, data.m_stimRecord) {
        return false;
      }
    }
    let reactionPresetRecord = target.GetAIControllerComponent().GetCurrentReactionPreset();
    let reactionPreset = reactionPresetRecord.Type();
    if Equals(reactionPreset, gamedataReactionPresetType.Cerberus_Aggressive)
      || Equals(reactionPreset, gamedataReactionPresetType.Corpo_Aggressive)
      || Equals(reactionPreset, gamedataReactionPresetType.Corpo_Passive)
      || Equals(reactionPreset, gamedataReactionPresetType.Ganger_Aggressive)
      || Equals(reactionPreset, gamedataReactionPresetType.Ganger_Passive)
      || Equals(reactionPreset, gamedataReactionPresetType.Police_Aggressive)
      || Equals(reactionPreset, gamedataReactionPresetType.Police_Passive)
      || Equals(reactionPreset, gamedataReactionPresetType.Mechanical_Aggressive)
      || Equals(reactionPreset, gamedataReactionPresetType.Mechanical_Passive)
      || Equals(reactionPreset, gamedataReactionPresetType.Mechanical_NonCombat) {
      return true;
    }
    return false;
  }

  private final func CanReactOnStimType(puppet: ScriptedPuppet, stimRecord: Stim_Record) -> Bool {
    let returnValue = true;
    if stimRecord != null {
      let propagationType = stimRecord.Propagation().Type();
      if Equals(propagationType, gamedataStimPropagation.Audio) && ScriptedPuppet.IsDeaf(puppet) {
        returnValue = false;
      }
    }
    return returnValue;
  }
}

importonly native class StimPropagation_Record extends TweakDBRecord {
  public final native func Comment() -> String;

  public final native func EnumName() -> CName;

  public final native func Type() -> gamedataStimPropagation;
}

class ChargedHotkeyItemConsumableController extends ChargedHotkeyItemBaseController {
  public const let c_statPool: gamedataStatPoolType;

  protected func RegisterStatListener() {
    if !IsDefined(this.m_statListener) {
      return;
    }
    let gi = (this.GetOwnerEntity() as GameObject).GetGame();
    let player = GameInstance.GetPlayerSystem(gi).GetLocalPlayerControlledGameObject() as PlayerPuppet;
    GameInstance
      .GetStatPoolsSystem(gi)
      .RequestRegisteringListener(
        Cast<StatsObjectID>(player.GetEntityID()),
        gamedataStatPoolType.HealingItemsCharges,
        this.m_statListener
      );
  }

  protected func UnregisterStatListener() {
    if !IsDefined(this.m_statListener) {
      return;
    }
    let gi = (this.GetOwnerEntity() as GameObject).GetGame();
    let player = GameInstance.GetPlayerSystem(gi).GetLocalPlayerControlledGameObject() as PlayerPuppet;
    GameInstance
      .GetStatPoolsSystem(gi)
      .RequestUnregisteringListener(
        Cast<StatsObjectID>(player.GetEntityID()),
        gamedataStatPoolType.HealingItemsCharges,
        this.m_statListener
      );
  }

  protected func IsInDefaultState() -> Bool {
    return this.IsActivatedByQuest() && this.IsAllowedByGameplay();
  }

  protected func GetRechargeDuration() -> Float {
    let statsSystem = GameInstance.GetStatsSystem(this.GetPlayer().GetGame());
    return statsSystem
      .GetStatValue(
        Cast<StatsObjectID>(this.GetPlayer().GetEntityID()),
        gamedataStatType.HealingItemsRechargeDuration
      );
  }

  protected func GetMaxCharges() -> Float {
    let statsSystem = GameInstance.GetStatsSystem(this.GetPlayer().GetGame());
    return statsSystem
      .GetStatValue(
        Cast<StatsObjectID>(this.GetPlayer().GetEntityID()),
        gamedataStatType.HealingItemMaxCharges
      );
  }

  protected func UpdateCurrentItem() {
    let oldItem = this.m_currentItem;
    this.m_currentItem = this.m_inventoryManager.GetHotkeyItemData(this.m_hotkey);
    this.ResolveState();
    this
      .GetRootWidget()
      .SetVisible(
        ItemID.IsValid(this.m_currentItem.ID) && !this.IsBerserkActive() && !this.IsControllingDevice()
      );
    if oldItem.ID != this.m_currentItem.ID {
      this
        .UpdateChargeValue(
          this.GetStatPoolCurrentValue(this.c_statPool, true),
          this.GetStatPoolMaxPoints(this.c_statPool) / 100.0,
          false
        );
    } else if Equals(this.m_currentItem.ItemType, gamedataItemType.Cyb_HealingAbility) {
      let gi = (this.GetOwnerEntity() as GameObject).GetGame();
      let player = GameInstance.GetPlayerSystem(gi).GetLocalPlayerControlledGameObject() as PlayerPuppet;
      this.m_currentItem.Quantity = player.GetHealingItemCharges();
    } else if oldItem.ID != this.m_currentItem.ID || oldItem.Quantity == this.m_currentItem.Quantity {
      this
        .m_hotkeyItemController
        .Setup(this.m_currentItem, ItemDisplayContext.DPAD_RADIAL);
      return;
    } else if oldItem.Quantity < this.m_currentItem.Quantity {
      this.PlayRechargeFinishedAnimation();
    }
    this.StopShowChargesAnimation();
    this.PlayHideChargesAnimation(true);
  }
}

