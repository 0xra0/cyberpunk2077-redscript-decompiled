class SwimmingTransitionEvents extends LocomotionSwimmingEvents {
  public let m_maxDownwardSpeed: Float;
  public let m_minDownwardsSpeed: Float;
  public let m_upwardsImpulseStrength: Float;

  protected func OnAttach(const stateContext: StateContext, const scriptInterface: StateGameScriptInterface) {
    super.OnAttach(stateContext, scriptInterface);
    this.m_minDownwardsSpeed = this.GetStaticFloatParameterDefault("minDownwardVerticalSpeed", 1.0);
    this.m_maxDownwardSpeed = this.GetStaticFloatParameterDefault("maxDownwardVerticalSpeed", 1.0);
    this.m_upwardsImpulseStrength = this.GetStaticFloatParameterDefault("upwardsImpulseStrength", 1.0);
    if this.m_maxDownwardSpeed <= 0.0 {
      this.m_maxDownwardSpeed = 1.0;
    }
  }

  public func OnEnter(stateContext: StateContext, scriptInterface: StateGameScriptInterface) {
    let minDownwardsSpeed: Float;
    super.OnEnter(stateContext, scriptInterface);
    let verticalVelocity = AbsF(this.GetVerticalSpeed(scriptInterface));
    if verticalVelocity < minDownwardsSpeed {
      this
        .AddVerticalImpulse(
          stateContext,
          this.GetStaticFloatParameterDefault("downwardsImpulseStrength", 1.0)
        );
    }
    this.PlaySound(n"hold_breath", scriptInterface);
    DefaultTransition.PlayRumble(scriptInterface, "light_slow");
    GameObjectEffectHelper
      .StartEffectEvent(scriptInterface.executionOwner, n"swimming_enter_dive", false);
  }

  public func OnUpdate(
    timeDelta: Float,
    stateContext: StateContext,
    scriptInterface: StateGameScriptInterface
  ) {
    super.OnUpdate(timeDelta, stateContext, scriptInterface);
    let verticalVelocity = this.GetVerticalSpeed(scriptInterface);
    if verticalVelocity < 0.0 && AbsF(verticalVelocity) > this.m_maxDownwardSpeed {
      let upwardsImpulseStrengthMod = AbsF(verticalVelocity / this.m_maxDownwardSpeed);
      this
        .AddVerticalImpulse(stateContext, upwardsImpulseStrengthMod * this.m_upwardsImpulseStrength);
    }
  }

  public func OnExit(stateContext: StateContext, scriptInterface: StateGameScriptInterface) {
    super.OnExit(stateContext, scriptInterface);
  }
}

