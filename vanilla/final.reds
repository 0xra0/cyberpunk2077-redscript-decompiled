  protected cb func OnSetDeviceAttitude(evt: SetDeviceAttitude) -> Bool {
    if !evt.IsCompleted() && evt.Repeat {
      evt.Repeat = false;
      evt.Attitude = EAIAttitude.AIA_Neutral;
      this.ShowQuickHackDuration(evt);
    }
  }

  protected cb func OnQuickHackToggleOn(evt: QuickHackToggleON) -> Bool {
    if !evt.IsCompleted() && evt.Repeat && evt.GetDurationTime() > 0.0 {
      evt.Repeat = false;
      this.ShowQuickHackDuration(evt);
    }
  }

  protected cb func OnQuickHackDistraction(evt: QuickHackDistraction) -> Bool {
    if evt.IsCompleted() {
      this.StopGlitching();
    } else {
      this.StartGlitching(EGlitchState.DEFAULT, 1.0);
      this.ShowQuickHackDuration(evt);
    }
  }

  protected cb func OnQuestStartGlitch(evt: QuestStartGlitch) -> Bool {
    this.StartGlitching(EGlitchState.DEFAULT);
  }

  protected cb func OnQuestStopGlitch(evt: QuestStopGlitch) -> Bool {
    this.StopGlitching();
  }

  protected cb func OnGlitchScreen(evt: GlitchScreen) -> Bool {
    let action = evt;
    if evt.IsCompleted() {
      this.StopGlitching();
      this.ClearActiveStatusEffect();
      this.ClearActiveProgramToUploadOnNPC();
    } else if IsDefined(action) {
      this.SetActiveStatusEffect(action.GetActiveStatusEffectTweakDBID());
      this.SetActiveProgramToUploadOnNPC(action.GetAttachedProgramTweakDBID());
    } else {
      this.StartGlitching(EGlitchState.SUBLIMINAL_MESSAGE, 1.0);
      this.ShowQuickHackDuration(evt);
    }
  }

  protected func StartGlitching(glitchState: EGlitchState, opt intensity: Float);

