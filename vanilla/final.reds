class VendingTerminal extends InteractiveDevice {
  public let m_position: Vector4;
  protected let m_canMeshComponent: MeshComponent;
  protected const let m_vendingBlacklist: [EVendorMode];

  protected cb func OnRequestComponents(ri: EntityRequestComponentsInterface) -> Bool {
    super.OnRequestComponents(ri);
    EntityRequestComponentsInterface.RequestComponent(ri, n"ui", n"worlduiWidgetComponent", false);
    EntityRequestComponentsInterface.RequestComponent(ri, n"CanMesh", n"MeshComponent", false);
    EntityRequestComponentsInterface.RequestComponent(ri, n"Trigger", n"gameStaticTriggerAreaComponent", false);
  }

  protected cb func OnTakeControl(ri: EntityResolveComponentsInterface) -> Bool {
    this.m_canMeshComponent = EntityResolveComponentsInterface.GetComponent(ri, n"CanMesh") as MeshComponent;
    this.m_uiComponent = EntityResolveComponentsInterface.GetComponent(ri, n"ui") as worlduiWidgetComponent;
    super.OnTakeControl(ri);
    this.m_controller = EntityResolveComponentsInterface.GetComponent(ri, n"controller") as VendingTerminalController;
  }

  protected func ResolveGameplayState() {
    super.ResolveGameplayState();
    this.GetDevicePS().Prepare(this);
    if this.IsUIdirty() && this.m_isInsideLogicArea {
      this.RefreshUI();
    }
  }

  protected cb func OnDetach() -> Bool {
    super.OnDetach();
  }

  public const func GetBlackboardDef() -> VendingMachineDeviceBlackboardDef {
    return this.GetDevicePS().GetBlackboardDef();
  }

  protected func CreateBlackboard() {
    this.m_blackboard = IBlackboard.Create(GetAllBlackboardDefs().VendingMachineDeviceBlackboard);
  }

  protected const func GetController() -> VendingTerminalController {
    return this.m_controller as VendingTerminalController;
  }

  public const func GetDevicePS() -> VendingTerminalControllerPS {
    return this.GetController().GetPS();
  }

  protected func PushPersistentData() {
    super.PushPersistentData();
  }

  protected cb func OnAreaEnter(evt: AreaEnteredEvent) -> Bool {
    this.RefreshUI();
  }

  protected cb func OnAreaExit(evt: AreaExitedEvent) -> Bool {
    this
      .GetDevicePS()
      .GetVendorDataManager()
      .ClearCart();
    this.RefreshUI();
  }

  protected cb func OnCraftItemForTarget(evt: CraftItemForTarget) -> Bool {
    this.RefreshUI();
    GameObject.PlaySoundEvent(this, n"dev_vending_machine_processing");
  }

  protected cb func OnBuyItemFromVendor(evt: BuyItemFromVendor) -> Bool {
    let buyRequestData: TransactionRequestData;
    buyRequestData.itemID = evt.itemID;
    let buyRequest = new BuyRequest();
    buyRequest.owner = this;
    ArrayPush(buyRequest.items, buyRequestData);
    MarketSystem.GetInstance(this.GetGame()).QueueRequest(buyRequest);
    this.RefreshUI();
    GameObject.PlaySoundEvent(this, n"dev_vending_machine_processing");
  }

  protected cb func OnSellItemToVendor(evt: SellItemToVendor) -> Bool {
    let sellRequestData: TransactionRequestData;
    sellRequestData.itemID = evt.itemID;
    let sellRequest = new SellRequest();
    sellRequest.owner = this;
    ArrayPush(sellRequest.items, sellRequestData);
    MarketSystem.GetInstance(this.GetGame()).QueueRequest(sellRequest);
    this.RefreshUI();
    GameObject.PlaySoundEvent(this, n"dev_vending_machine_processing");
  }

  protected cb func OnDispenceItemFromVendor(evt: DispenceItemFromVendor) -> Bool {
    this.RefreshUI();
    this
      .DelayVendingMachineEvent(
        this
          .GetDevicePS()
          .GetVendorDataManager()
          .GetTimeToCompletePurchase(),
        evt.GetItemID()
      );
    GameObject.PlaySoundEvent(this, n"dev_vending_machine_processing");
  }

  protected cb func OnVendingMachineFinishedEvent(evt: VendingMachineFinishedEvent) -> Bool {
    this.m_position = Matrix.GetTranslation(this.m_canMeshComponent.GetLocalToWorld());
    GameInstance
      .GetLootManager(this.GetGame())
      .SpawnItemDrop(this, evt.itemID, this.m_position);
    GameObject.PlaySoundEvent(this, n"dev_vending_machine_can_falls");
    this.GetDevicePS().SetIsReady(true);
    this.RefreshUI();
  }

  protected final func SendDataToUIBlackboard(const TopText: script_ref<String>, const BottomText: script_ref<String>) {
    this.GetBlackboard().FireCallbacks();
  }

  protected final func DelayVendingMachineEvent(time: Float, itemID: ItemID) {
    let evt = new VendingMachineFinishedEvent();
    evt.itemID = itemID;
    GameInstance.GetDelaySystem(this.GetGame()).DelayEvent(this, evt, time);
  }

  private func InitializeScreenDefinition() {
    if !TDBID.IsValid(this.m_screenDefinition.screenDefinition) {
      this.m_screenDefinition.screenDefinition = t"DevicesUIDefinitions.Terminal_4x3";
    } else if !TDBID.IsValid(this.m_screenDefinition.style) {
      this.m_screenDefinition.style = t"DevicesUIStyles.None";
    }
  }
}

