native class AnimationControllerComponent extends IComponent {
  private final native func PushEvent(eventName: CName);

  private final native func SetInputFloat(inputName: CName, value: Float);

  private final native func SetInputInt(inputName: CName, value: Int32);

  private final native func SetInputBool(inputName: CName, value: Bool);

  private final native func SetInputQuaternion(inputName: CName, value: Quaternion);

  private final native func SetInputVector(inputName: CName, value: Vector4);

  private final native func SetUsesSleepMode(allowSleepState: Bool);

  private final native func ScheduleFastForward();

  public final native func PreloadAnimations(streamingContextName: CName, highPriority: Bool) -> Bool;

  private final native func ApplyFeature(inputName: CName, value: AnimFeature);

  public const final native func GetAnimationDuration(animationName: CName) -> Float;

  protected cb func OnSetInputVectorEvent(evt: AnimInputSetterVector) -> Bool {
    this.SetInputVector(evt.key, evt.value);
  }

  public final static func ApplyFeature(obj: GameObject, inputName: CName, value: AnimFeature, opt delay: Float) {
    let evt = new AnimInputSetterAnimFeature();
    evt.key = inputName;
    evt.value = value;
    evt.delay = delay;
    obj.QueueEvent(evt);
    let item = obj as ItemObject;
    if IsDefined(item) {
      item.QueueEventToChildItems(evt);
    }
  }

  public final static func ApplyFeatureToReplicate(obj: GameObject, inputName: CName, value: AnimFeature, opt delay: Float) {
    AnimationControllerComponent.ApplyFeature(obj, inputName, value, delay);
    obj.ReplicateAnimFeature(obj, inputName, value);
  }

  public final static func ApplyFeatureToReplicateOnHeldItems(obj: GameObject, inputName: CName, value: AnimFeature, opt delay: Float) {
    let leftItem = GameInstance
      .GetTransactionSystem(obj.GetGame())
      .GetItemInSlot(obj, t"AttachmentSlots.WeaponLeft");
    let rightItem = GameInstance
      .GetTransactionSystem(obj.GetGame())
      .GetItemInSlot(obj, t"AttachmentSlots.WeaponRight");
    if IsDefined(leftItem) {
      AnimationControllerComponent.ApplyFeature(leftItem, inputName, value, delay);
      leftItem.ReplicateAnimFeature(leftItem, inputName, value);
    } else if IsDefined(rightItem) {
      AnimationControllerComponent.ApplyFeature(rightItem, inputName, value, delay);
      rightItem.ReplicateAnimFeature(rightItem, inputName, value);
    }
  }

  public final static func PushEvent(obj: GameObject, eventName: CName) {
    let evt = new AnimExternalEvent();
    evt.name = eventName;
    obj.QueueEvent(evt);
    let item = obj as ItemObject;
    if IsDefined(item) {
      item.QueueEventToChildItems(evt);
    }
  }

  public final static func PushEventToObjAndHeldItems(obj: GameObject, eventName: CName) {
    if !IsDefined(obj) {
      return;
    }
    AnimationControllerComponent.PushEvent(obj, eventName);
    let item = GameInstance
      .GetTransactionSystem(obj.GetGame())
      .GetItemInSlot(obj, t"AttachmentSlots.WeaponLeft");
    if IsDefined(item) {
      AnimationControllerComponent.PushEvent(item, eventName);
    }
    item = GameInstance
      .GetTransactionSystem(obj.GetGame())
      .GetItemInSlot(obj, t"AttachmentSlots.WeaponRight");
    if IsDefined(item) {
      AnimationControllerComponent.PushEvent(item, eventName);
    }
  }

  public final static func PushEventToReplicate(obj: GameObject, eventName: CName) {
    AnimationControllerComponent.PushEvent(obj, eventName);
    obj.ReplicateAnimEvent(obj, eventName);
  }

  public final static func SetInputFloat(obj: GameObject, inputName: CName, value: Float) {
    let evt = new AnimInputSetterFloat();
    evt.key = inputName;
    evt.value = value;
    obj.QueueEvent(evt);
  }

  public final static func SetInputFloatToReplicate(obj: GameObject, inputName: CName, value: Float) {
    AnimationControllerComponent.SetInputFloat(obj, inputName, value);
    obj.ReplicateInputFloat(obj, inputName, value);
  }

  public final static func SetInputBool(obj: GameObject, inputName: CName, value: Bool) {
    let evt = new AnimInputSetterBool();
    evt.key = inputName;
    evt.value = value;
    obj.QueueEvent(evt);
  }

  public final static func SetInputBoolToReplicate(obj: GameObject, inputName: CName, value: Bool) {
    AnimationControllerComponent.SetInputBool(obj, inputName, value);
    obj.ReplicateInputBool(obj, inputName, value);
  }

  public final static func SetInputInt(obj: GameObject, inputName: CName, value: Int32) {
    let evt = new AnimInputSetterInt();
    evt.key = inputName;
    evt.value = value;
    obj.QueueEvent(evt);
  }

  public final static func SetInputIntToReplicate(obj: GameObject, inputName: CName, value: Int32) {
    AnimationControllerComponent.SetInputInt(obj, inputName, value);
    obj.ReplicateInputInt(obj, inputName, value);
  }

  public final static func SetInputVector(obj: GameObject, inputName: CName, value: Vector4) {
    let evt = new AnimInputSetterVector();
    evt.key = inputName;
    evt.value = value;
    obj.QueueEvent(evt);
  }

  public final static func SetInputVectorToReplicate(obj: GameObject, inputName: CName, value: Vector4) {
    AnimationControllerComponent.SetInputVector(obj, inputName, value);
    obj.ReplicateInputVector(obj, inputName, value);
  }

  public final static func SetUsesSleepMode(obj: GameObject, state: Bool) {
    let evt = new AnimInputSetterUsesSleepMode();
    evt.value = state;
    obj.QueueEvent(evt);
  }

  public final static func SetAnimWrapperWeight(obj: GameObject, key: CName, value: Float) {
    if !IsNameValid(key) {
      return;
    }
    let evt = new AnimWrapperWeightSetter();
    evt.key = key;
    evt.value = value;
    obj.QueueEvent(evt);
    let item = obj as ItemObject;
    if IsDefined(item) {
      item.QueueEventToChildItems(evt);
    }
  }

  public final static func SetAnimWrapperWeightOnOwnerAndItems(owner: GameObject, key: CName, value: Float) {
    AnimationControllerComponent.SetAnimWrapperWeight(owner, key, value);
    let item = GameInstance
      .GetTransactionSystem(owner.GetGame())
      .GetItemInSlot(owner, t"AttachmentSlots.WeaponRight");
    if IsDefined(item) {
      AnimationControllerComponent.SetAnimWrapperWeight(item, key, value);
    }
    item = GameInstance
      .GetTransactionSystem(owner.GetGame())
      .GetItemInSlot(owner, t"AttachmentSlots.WeaponLeft");
    if IsDefined(item) {
      AnimationControllerComponent.SetAnimWrapperWeight(item, key, value);
    }
  }
}

