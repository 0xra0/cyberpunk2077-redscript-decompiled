class sampleGranade extends BaseProjectile {
  private let m_countTime: Float;
  private let m_energyLossFactor: Float;
  private let m_startVelocity: Float;
  private let m_grenadeLifetime: Float;
  private let m_gravitySimulation: Float;
  private let m_trailEffectName: CName;
  private let m_alive: Bool;

  protected cb func OnProjectileInitialize(eventData: gameprojectileSetUpEvent) -> Bool {
    this
      .m_projectileComponent
      .SetEnergyLossFactor(this.m_energyLossFactor, this.m_energyLossFactor);
  }

  private final func StartTrailEffect() {
    let spawnEffectEvent = new entSpawnEffectEvent();
    spawnEffectEvent.effectName = this.m_trailEffectName;
    this.QueueEvent(spawnEffectEvent);
  }

  private final func Reset() {
    this.m_countTime = 0.0;
    this.m_alive = true;
  }

  protected cb func OnShoot(eventData: gameprojectileShootEvent) -> Bool {
    this.Reset();
    this.StartTrailEffect();
  }

  protected cb func OnShootTarget(eventData: gameprojectileShootTargetEvent) -> Bool {
    this.Reset();
    this.m_projectileComponent.ClearTrajectories();
    let angle = 45.0;
    let accel = new Vector4(0.0, 0.0, -this.m_gravitySimulation, 0.0);
    let target = eventData.params.targetPosition;
    let parabolicParams = ParabolicTrajectoryParams.GetAccelTargetAngleParabolicParams(accel, target, angle);
    this.m_projectileComponent.AddParabolic(parabolicParams);
    this.StartTrailEffect();
  }

  protected cb func OnTick(eventData: gameprojectileTickEvent) -> Bool {
    this.m_countTime += eventData.deltaTime;
    if this.m_alive {
      if this.m_countTime > this.m_grenadeLifetime {
        let explosion = this.m_projectileComponent.GetGameEffectInstance();
        EffectData
          .SetVector(
            explosion.GetSharedData(),
            GetAllBlackboardDefs().EffectSharedData.position,
            eventData.position
          );
        EffectData
          .SetFloat(
            explosion.GetSharedData(),
            GetAllBlackboardDefs().EffectSharedData.radius,
            3.0
          );
        explosion.Run();
        this.PlayExplosionSound();
        this.m_alive = false;
        this.m_countTime = 0.0;
      }
    } else if this.m_countTime > 0.5 {
      this.Release();
    }
  }

  protected cb func OnCollision(eventData: gameprojectileHitEvent) -> Bool;

  private final func PlayExplosionSound() {
    let audioEvent = new SoundPlayEvent();
    audioEvent.soundName = n"Play_grenade";
    this.QueueEvent(audioEvent);
  }
}

