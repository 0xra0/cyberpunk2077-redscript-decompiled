public func BasicAvailabilityTest(device: ScriptableDeviceComponentPS) -> Bool {
  if device.IsDisabled() {
    return false;
  } else if device.IsUnpowered() {
    return false;
  } else if device.IsOFF() {
    return false;
  }
  return true;
}

