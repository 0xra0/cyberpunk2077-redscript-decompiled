class HubMenuInstanceData extends IScriptable {
  public let m_ID: Uint32;
}

class MenuScenario_HubMenu extends MenuScenario_BaseMenu {
  public let m_hubMenuInitData: wref<HubMenuInitData>;
  public let m_currentState: wref<inkMenusState>;
  public let m_combatRestriction: Bool;
  public let m_hubMenuInstanceID: Uint32;

  public final func GetMenuName() -> CName {
    return n"hub_menu";
  }

  protected func GotoIdleState() {
    if NotEquals(this.m_currMenuName, this.GetMenuName()) {
      this.CloseMenu();
      this.m_currentState.CloseMenu(this.GetMenuName());
      this.m_currentState.OpenMenu(this.GetMenuName(), this.m_hubMenuInitData);
      this.m_currMenuName = this.GetMenuName();
      this.m_hubMenuInstanceID += 1u;
      let hubMenuInstanceData = new HubMenuInstanceData();
      hubMenuInstanceData.m_ID = this.m_hubMenuInstanceID;
      this
        .m_currentState
        .DispatchEvent(this.m_currMenuName, n"OnHubMenuInstanceData", hubMenuInstanceData);
    } else {
      super.GotoIdleState();
    }
  }

  protected cb func OnEnterScenario(prevScenario: CName, userData: IScriptable) -> Bool {
    this.m_hubMenuInitData = userData as HubMenuInitData;
    this.m_combatRestriction = this.m_hubMenuInitData.m_combatRestriction;
    this.m_currentState = this.GetMenusState();
    this.m_currentState.OpenMenu(this.GetMenuName(), this.m_hubMenuInitData);
    this.m_currMenuName = this.GetMenuName();
    this.m_hubMenuInstanceID = 1u;
    let hubMenuInstanceData = new HubMenuInstanceData();
    hubMenuInstanceData.m_ID = this.m_hubMenuInstanceID;
    this
      .m_currentState
      .DispatchEvent(this.m_currMenuName, n"OnHubMenuInstanceData", hubMenuInstanceData);
    let hubMenu = this.m_currentState.GetMenu(this.GetMenuName());
    if IsDefined(this.m_hubMenuInitData) {
      let hubCtrl = hubMenu.GetControllerByType(n"MenuHubLogicController") as MenuHubLogicController;
      hubCtrl
        .SelectMenuExternally(
          this.m_hubMenuInitData.m_menuName,
          this.m_hubMenuInitData.m_submenuName,
          this.m_hubMenuInitData.m_userData
        );
    }
  }

  protected cb func OnNetworkBreachBegin() -> Bool {
    this.GotoIdleState();
    this.SwitchToScenario(n"MenuScenario_NetworkBreach");
  }

  protected cb func OnSwitchToTimeManager() -> Bool {
    this.OpenSubMenu(n"time_manager");
  }

  protected cb func OnSelectMenuItem(userData: IScriptable) -> Bool {
    let menuItemData = userData as MenuItemData;
    let isFullscreenDifferent = NotEquals(menuItemData.m_menuData.fullscreenName, n"None") && NotEquals(menuItemData.m_menuData.fullscreenName, this.m_currMenuName);
    let isDataDifferent = menuItemData.m_menuData.userData != this.m_currUserData;
    if isFullscreenDifferent || isDataDifferent {
      this
        .OnOpenMenu(menuItemData.m_menuData.fullscreenName, menuItemData.m_menuData.userData);
    }
  }

  protected cb func OnOpenMenu(menuName: CName, opt userData: IScriptable) -> Bool {
    let menuState = this.GetMenusState();
    if NotEquals(this.m_currMenuName, n"None") && NotEquals(this.m_currMenuName, this.GetMenuName()) {
      menuState.DispatchEvent(this.m_currMenuName, n"OnCloseMenu");
      menuState.CloseMenu(this.m_currMenuName);
    }
    this.m_currMenuName = menuName;
    menuState.OpenMenu(this.m_currMenuName, userData);
  }

  protected cb func OnCloseHubMenu() -> Bool {
    this.GotoIdleState();
  }

  protected cb func OnRequestHubMenu() -> Bool {
    this.GotoIdleState();
  }

  protected cb func OnCloseHubMenuRequest() -> Bool {
    this.GotoIdleState();
  }

  protected cb func OnHotkeySwitchToMap() -> Bool {
    this.ToggleMenu(n"world_map");
  }

  protected cb func OnHotkeySwitchToCrafting() -> Bool {
    if !this.m_combatRestriction {
      this.ToggleMenu(n"crafting_main");
    }
  }

  protected cb func OnHotkeySwitchToJournal() -> Bool {
    this.ToggleMenu(n"quest_log");
  }

  protected cb func OnHotkeySwitchToInventory() -> Bool {
    this.ToggleMenu(n"inventory_screen");
  }

  protected cb func OnHotkeySwitchToPerks() -> Bool {
    this.ToggleMenu(n"new_perks");
  }

  public final func ToggleMenu(menuName: CName) {
    if Equals(this.m_currMenuName, menuName) {
      this.OnCloseHubMenuRequest();
    } else {
      let evt = new OpenMenuRequest();
      evt.m_menuName = menuName;
      evt.m_isMainMenu = true;
      this.QueueBroadcastEvent(evt);
    }
  }
}

class RadialHubTimeSkipController extends inkLogicController {
  private let m_gameTimeText: inkTextRef;
  private let m_cantSkipTimeContainer: inkWidgetRef;
  private let m_timeSkipButton: inkWidgetRef;
  private let m_gameCtrlRef: wref<gameuiMenuGameController>;
  private let m_timeSystem: wref<TimeSystem>;
  private let m_timeSkipPopupToken: inkGameNotificationToken;
  private let m_cantSkipTimeAnim: inkAnimProxy;
  private let m_gameTimeTextParams: inkTextParams;
  private let m_canSkipTime: Bool;

  public final func Init(
    isEnabled: Bool,
    timeSystem: wref<TimeSystem>,
    gameController: wref<gameuiMenuGameController>
  ) {
    this.m_canSkipTime = isEnabled;
    this.m_timeSystem = timeSystem;
    this.m_gameCtrlRef = gameController;
    let buttonController = inkWidgetRef.GetController(this.m_timeSkipButton) as inkButtonController;
    buttonController.SetEnabled(this.m_canSkipTime);
    if this.m_canSkipTime {
      buttonController.RegisterToCallback(n"OnRelease", this, n"OnTimeSkipButtonPressed");
    }
    buttonController.RegisterToCallback(n"OnHoverOver", this, n"OnTimeSkipButtonHoverOver");
    buttonController.RegisterToCallback(n"OnHoverOut", this, n"OnTimeSkipButtonHoverOut");
  }

  private final func UpdateGameTime() {
    GameTimeUtils
      .UpdateGameTimeText(this.m_timeSystem, this.m_gameTimeText, this.m_gameTimeTextParams);
  }

  protected cb func OnTimeSkipButtonHoverOver(evt: inkPointerEvent) -> Bool {
    if !this.m_canSkipTime {
      inkWidgetRef.SetVisible(this.m_cantSkipTimeContainer, true);
      if IsDefined(this.m_cantSkipTimeAnim) {
        this.m_cantSkipTimeAnim.Stop();
      }
      this.m_cantSkipTimeAnim = this
        .PlayLibraryAnimationOnTargets(
          n"tooltip_in",
          SelectWidgets(inkWidgetRef.Get(this.m_cantSkipTimeContainer))
        );
    }
    this.QueueEvent(new TimeSkipHoverOverEvent());
  }

  protected cb func OnTimeSkipButtonHoverOut(evt: inkPointerEvent) -> Bool {
    if !this.m_canSkipTime {
      inkWidgetRef.SetVisible(this.m_cantSkipTimeContainer, false);
    }
    this.QueueEvent(new TimeSkipHoverOutEvent());
  }

  protected cb func OnTimeSkipButtonPressed(e: inkPointerEvent) -> Bool {
    if !e.IsAction(n"click") {
      return true;
    }
    this.SetCursorVisibility(false);
    let data = new TimeSkipPopupData();
    data.notificationName = n"base\\gameplay\\gui\\widgets\\time_skip\\time_skip.inkwidget";
    data.isBlocking = true;
    data.useCursor = true;
    data.queueName = n"modal_popup";
    this.m_timeSkipPopupToken = this.m_gameCtrlRef.ShowGameNotification(data);
    this.m_timeSkipPopupToken.RegisterListener(this, n"OnTimeSkipPopupClosed");
    this.PlaySound(n"Button", n"OnPress");
    this.QueueEvent(new TimeSkipOpenedEvent());
  }

  protected cb func OnTimeSkipPopupClosed(data: inkGameNotificationData) -> Bool {
    let timeSkipData = data as TimeSkipPopupCloseData;
    this.m_timeSkipPopupToken = null;
    this.SetCursorVisibility(true);
    if timeSkipData.timeChanged {
      this.UpdateGameTime();
      this.PlayLibraryAnimation(n"time_changed");
    }
    this.QueueEvent(new TimeSkipClosedEvent());
  }

  private final func SetCursorVisibility(visible: Bool) {
    let evt = new inkMenuLayer_SetCursorVisibility();
    evt.Init(visible);
    this.QueueEvent(evt);
  }
}

