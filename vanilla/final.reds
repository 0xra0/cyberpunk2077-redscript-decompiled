class PreventionAgents extends IScriptable {
  private let m_groupName: CName;
  private let m_requsteredAgents: [SPreventionAgentData];

  public final func CreateGroup(groupName: CName, ps: wref<PersistentState>) {
    this.m_groupName = groupName;
    this.AddAgent(ps);
  }

  public const final func GetGroupName() -> CName {
    return this.m_groupName;
  }

  public const final func GetAgentsNumber() -> Int32 {
    return ArraySize(this.m_requsteredAgents);
  }

  public const final func GetAgetntByIndex(index: Int32) -> wref<PersistentState> {
    return this.m_requsteredAgents[index].ps;
  }

  public const final func IsAgentalreadyAdded(ps: wref<PersistentState>) -> Bool {
    let i = 0;
    while i < ArraySize(this.m_requsteredAgents) {
      if Equals(this.m_requsteredAgents[i].ps.GetID(), ps.GetID()) {
        return true;
      }
      i += 1;
    }
    return false;
  }

  public const final func HasAgents() -> Bool {
    return ArraySize(this.m_requsteredAgents) > 0;
  }

  public final func AddAgent(ps: wref<PersistentState>) {
    let newData = new SPreventionAgentData();
    newData.ps = ps;
    ArrayPush(this.m_requsteredAgents, newData);
  }

  public final func RemoveAgent(ps: wref<PersistentState>) {
    let i = 0;
    if i < ArraySize(this.m_requsteredAgents) {
      if Equals(this.m_requsteredAgents[i].ps.GetID(), ps.GetID()) {
        ArrayErase(this.m_requsteredAgents, i);
      } else {
        i += 1;
      }
    }
  }
}

class SPreventionAgentData extends IScriptable {
  public let ps: wref<PersistentState>;
}

public func CanChangeAttitudeRelationFor(groupName: CName) -> Bool {
  if Equals(groupName, n"friendly") {
    return false;
  }
  if Equals(groupName, n"neutral") {
    return false;
  }
  if Equals(groupName, n"hostile") {
    return false;
  }
  return true;
}

class IntervalCaller extends DelayCallback {
  public let m_preventionSystem: wref<PreventionSystem>;
  public let m_request: ScriptableSystemRequest;
  private let m_intervalSeconds: Float;
  private let m_selfDelayID: DelayID;

  public final static func Create(preventionSystem: wref<PreventionSystem>) -> IntervalCaller {
    let created = new IntervalCaller();
    created.m_preventionSystem = preventionSystem;
    created.m_selfDelayID = GetInvalidDelayID();
    return created;
  }

  public final func IsRunning() -> Bool {
    return this.m_selfDelayID != GetInvalidDelayID();
  }

  public final func Start(intervalSeconds: Float, request: ScriptableSystemRequest) {
    this.m_intervalSeconds = intervalSeconds;
    this.m_request = request;
    this.Cancel();
    this.StartInternal();
  }

  private final func StartInternal() {
    this.m_selfDelayID = GameInstance
      .GetDelaySystem(this.m_preventionSystem.GetGame())
      .DelayCallback(this, this.m_intervalSeconds);
  }

  public final func Cancel() {
    if !this.IsRunning() {
      return;
    }
    GameInstance
      .GetDelaySystem(this.m_preventionSystem.GetGame())
      .CancelCallback(this.m_selfDelayID);
    this.m_selfDelayID = GetInvalidDelayID();
  }

  protected func Call() {
    this.m_preventionSystem.QueueRequest(this.m_request);
    this.StartInternal();
  }
}

