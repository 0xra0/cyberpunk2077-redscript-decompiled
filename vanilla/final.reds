class TrafficIntersectionManagerControllerPS extends MasterControllerPS {
  private persistent let m_trafficLightStatus: worldTrafficLightColor;

  private final func ActionInitiateTrafficLightChange() -> InitiateTrafficLightChange {
    let action = new InitiateTrafficLightChange();
    action.clearanceLevel = 5;
    action.SetUp(this);
    action.SetProperties();
    action.AddDeviceName(this.m_deviceName);
    action.CreateActionWidgetPackage();
    return action;
  }

  public func GetQuestActions(out outActions: [DeviceAction], const context: script_ref<GetActionsContext>) {
    super.GetQuestActions(outActions, context);
    ArrayPush(outActions, this.ActionInitiateTrafficLightChange());
  }

  public final func OnInitiateTrafficLightChange(evt: InitiateTrafficLightChange) -> EntityNotificationType {
    this.HandleLightChangeRequest();
    return EntityNotificationType.SendPSChangedEventToEntity;
  }

  public final func HandleLightChangeRequest() {
    this.InitiateChangeLightsSequenceForEntireIntersection();
  }

  public final func SetLightChangeRequest(newColor: worldTrafficLightColor) {
    this.SetLightsSequenceForEntireIntersection(newColor);
  }

  private final func InitiateChangeLightsSequenceForEntireIntersection() {
    let devices: [DeviceComponentPS];
    if !this.IsON() {
      return;
    }
    this.ToggleLights();
    GameInstance
      .GetDeviceSystem(this.GetGameInstance())
      .GetChildren(PersistentID.ExtractEntityID(this.GetID()), devices);
    let i = 0;
    while i < ArraySize(devices) {
      let toggleLightAction = (devices[i] as ScriptableDeviceComponentPS).GetActionByName(n"ToggleLight") as ToggleLight;
      if IsDefined(toggleLightAction) {
        this.GetPersistencySystem().QueuePSDeviceEvent(toggleLightAction);
      }
      i += 1;
    }
  }

  private final func SetLightsSequenceForEntireIntersection(newColor: worldTrafficLightColor) {
    if !this.IsON() {
      return;
    }
    this.m_trafficLightStatus = newColor;
    let devices = this.GetImmediateSlaves();
    let i = 0;
    while i < ArraySize(devices) {
      if Equals(newColor, worldTrafficLightColor.RED) {
        let action = (devices[i] as ScriptableDeviceComponentPS).GetActionByName(n"TrafficLightRed");
      } else {
        action = (devices[i] as ScriptableDeviceComponentPS).GetActionByName(n"TrafficLightGreen");
      }
      if IsDefined(action) {
        this.GetPersistencySystem().QueuePSDeviceEvent(action);
      }
      i += 1;
    }
  }

  public const final func GetDesiredTrafficLightState() -> worldTrafficLightColor {
    return this.m_trafficLightStatus;
  }

  private final func ToggleLights() {
    this.m_trafficLightStatus = Equals(this.m_trafficLightStatus, worldTrafficLightColor.RED) ? worldTrafficLightColor.GREEN : worldTrafficLightColor.RED;
  }
}

class ToggleLight extends ActionBool {
  public final func SetProperties(status: worldTrafficLightColor) {
    let isGreen: Bool;
    this.actionName = n"ToggleLight";
    if Equals(status, worldTrafficLightColor.GREEN) {
