struct SavedVehicleVisualCustomizationTemplate {
  public persistent let hasUniqueTemplate: Bool;
  public persistent let genericData: GenericTemplatePersistentData;
  public persistent let uniqueDataID: TweakDBID;
  public persistent let twintoneModelName: CName;

  public final static func FromVehicleVisualCustomizationTemplate(template: VehicleVisualCustomizationTemplate) -> SavedVehicleVisualCustomizationTemplate {
    let savedData: SavedVehicleVisualCustomizationTemplate;
    savedData.hasUniqueTemplate = template.hasUniqueTemplate;
    savedData.twintoneModelName = template.uniqueData.twintoneModelName;
    if template.hasUniqueTemplate {
      savedData.uniqueDataID = template.uniqueData.recordId;
    } else {
      savedData.genericData = template.genericData;
    }
    return savedData;
  }

  public final static func ToVehicleVisualCustomizationTemplate(savedData: SavedVehicleVisualCustomizationTemplate) -> VehicleVisualCustomizationTemplate {
    let template: VehicleVisualCustomizationTemplate;
    if savedData.hasUniqueTemplate {
      template = VehicleVisualCustomizationTemplate
        .FromRecord(
          TweakDBInterface.GetVehicleColorTemplateRecord(savedData.uniqueDataID),
          savedData.twintoneModelName
        );
    } else {
      template.hasUniqueTemplate = false;
      template.genericData = savedData.genericData;
    }
    return template;
  }
}

abstract class SkillCheckBase extends IScriptable {
  protected persistent let m_alternativeName: TweakDBID;
  protected persistent let m_difficulty: EGameplayChallengeLevel;
  protected persistent let m_additionalRequirements: GameplayConditionContainer;
  protected persistent let m_duration: Float;
  protected persistent let m_isActive: Bool;
  protected persistent let m_wasPassed: Bool;
  protected let m_skillCheckPerformed: Bool;
  protected persistent let m_skillToCheck: EDeviceChallengeSkill;
  protected persistent let m_baseSkill: GameplaySkillCondition;
  protected persistent let m_isDynamic: Bool;

  public func Initialize() {
    this.m_baseSkill = new GameplaySkillCondition();
    if NotEquals(this.m_difficulty, EGameplayChallengeLevel.NONE) {
      this.m_isActive = true;
      this.m_baseSkill.SetProperties(this.m_skillToCheck, this.m_difficulty);
    }
  }

  public const func Evaluate(requester: GameObject) -> Bool {
    let skillCheckPassed: Bool;
    if this.IsActive() {
      if IsDefined(this.m_additionalRequirements) && this.m_additionalRequirements.GetGroupsAmount() > 0 {
        if Equals(this.m_additionalRequirements.GetOperator(), ELogicOperator.AND) {
          skillCheckPassed = this.m_baseSkill.Evaluate(requester) && this.m_additionalRequirements.Evaluate(requester);
        } else if Equals(this.m_additionalRequirements.GetOperator(), ELogicOperator.OR) {
          skillCheckPassed = this.m_baseSkill.Evaluate(requester) || this.m_additionalRequirements.Evaluate(requester);
        }
      } else {
        skillCheckPassed = this.m_baseSkill.Evaluate(requester);
      }
    }
    return skillCheckPassed;
  }

  public final func SetAlternativeName(name: TweakDBID) {
    this.m_alternativeName = name;
  }

  public final func SetDifficulty(difficulty: EGameplayChallengeLevel) {
    this.m_difficulty = difficulty;
  }

  public final func SetDynamic(isDynamic: Bool) {
    this.m_isDynamic = isDynamic;
  }

  public final func SetIsActive(value: Bool) {
    this.m_isActive = value;
  }

  public final func SetIsPassed(value: Bool) {
    this.m_wasPassed = value;
  }

  public const final func IsActive() -> Bool {
    return this.m_isActive;
  }

  public const final func IsDynamic() -> Bool {
    return this.m_isDynamic;
  }

  public const final func IsPassed() -> Bool {
    return this.m_wasPassed;
  }

  public const final func GetDifficulty() -> EGameplayChallengeLevel {
    return this.m_difficulty;
  }

  public const final func GetAdditionalRequirements() -> GameplayConditionContainer {
    return this.m_additionalRequirements;
  }

  public const final func GetSkill() -> EDeviceChallengeSkill {
    return this.m_skillToCheck;
  }

  public const final func GetBaseSkill() -> GameplaySkillCondition {
    return this.m_baseSkill;
  }

  public final func CheckPerformed() {
    this.m_skillCheckPerformed = true;
  }

  public const final func WasPerformed() -> Bool {
    return this.m_skillCheckPerformed;
  }

  public const final func GetAlternativeName() -> TweakDBID {
    return this.m_alternativeName;
  }

  public const final func GetDuration() -> Float {
    return this.m_duration;
  }

  public final func SetDuration(duration: Float) {
    this.m_duration = duration;
  }
}

abstract class GameplayConditionBase extends IScriptable {
  protected let m_entityID: EntityID;

  public func Evaluate(requester: GameObject) -> Bool {
    return false;
  }

  public func GetDescription(requester: GameObject) -> Condition {
    let empty: Condition;
    return empty;
  }

  protected final func GetPlayer(requester: GameObject) -> GameObject {
    return GameInstance.GetPlayerSystem(requester.GetGame()).GetLocalPlayerMainGameObject();
  }

  public final func SetEntityID(id: EntityID) {
    this.m_entityID = id;
  }
}

class GameplaySkillCondition extends GameplayConditionBase {
  protected persistent let m_skillToCheck: TweakDBID;
  private persistent let m_difficulty: EGameplayChallengeLevel;
  private persistent let m_skillBonus: TweakDBID;
  private persistent let m_requiredLevel: Int32;

  public func Evaluate(requester: GameObject) -> Bool {
    if this.GetPlayerSkill(requester) >= this.GetRequiredLevel(requester.GetGame()) {
      return true;
    }
    return false;
  }

  public final func GetRequiredLevel(gi: GameInstance) -> Int32 {
    if this.IsRequiredLevelSetup() {
      return this.m_requiredLevel;
    }
    return RPGManager
      .CheckDifficultyToStatValue(gi, this.GetStatType(), this.m_difficulty, this.m_entityID);
  }

  public final func TrySetRequiredLevel(requiredLevel: Int32) {
    if !this.IsRequiredLevelSetup() {
      this.m_requiredLevel = requiredLevel;
    }
  }

  private final func IsRequiredLevelSetup() -> Bool {
    return this.m_requiredLevel >= 0;
  }

  public final func GetPlayerSkill(requester: GameObject) -> Int32 {
    let statsSystem = GameInstance.GetStatsSystem(requester.GetGame());
    let playerEntity = GameInstance
      .GetPlayerSystem(requester.GetGame())
      .GetLocalPlayerControlledGameObject()
      .GetEntityID();
    let skillValue = Cast<Int32>(
      statsSystem.GetStatValue(Cast<StatsObjectID>(playerEntity), this.GetStatType())
    );
    skillValue
      += Cast<Int32>(
        statsSystem.GetStatValue(Cast<StatsObjectID>(playerEntity), this.GetStatBonusType())
      );
    return skillValue;
  }

  private final func GetStatType() -> gamedataStatType {
    return TweakDBInterface.GetStatRecord(this.m_skillToCheck).StatType();
  }

  private final func GetStatBonusType() -> gamedataStatType {
    return TweakDBInterface.GetStatRecord(this.m_skillBonus).StatType();
  }

  public final func SetProperties(sel_skill: EDeviceChallengeSkill, sel_difficulty: EGameplayChallengeLevel) {
    let skillString: String;
    this.m_difficulty = sel_difficulty;
    if Equals(sel_skill, EDeviceChallengeSkill.Hacking) {
      skillString = "Intelligence";
    } else if Equals(sel_skill, EDeviceChallengeSkill.Engineering) {
      skillString = "TechnicalAbility";
    } else if Equals(sel_skill, EDeviceChallengeSkill.Athletics) {
      skillString = "Strength";
    }
    this.m_skillToCheck = TDBID.Create("BaseStats." + skillString);
    this.m_skillBonus = TDBID.Create("BaseStats." + skillString + "SkillcheckBonus");
    this.m_requiredLevel = -1;
  }

  public func GetDescription(requester: GameObject) -> Condition {
    let description: Condition;
    description.description = this.GetConditionDescription(requester.GetGame());
    description.passed = this.Evaluate(requester);
    return description;
  }

  private final func GetConditionDescription(gi: GameInstance) -> String {
    let skill = TweakDBInterface.GetStatRecord(this.m_skillToCheck).EnumName();
    let text = "Attribute: " + skill + " " + ToString(this.GetRequiredLevel(gi));
    return text;
  }
}

