native class DeviceComponentPS extends GameComponentPS {
  protected persistent let m_markAsQuest: Bool;
  protected persistent let m_autoToggleQuestMark: Bool;
  protected persistent let m_factToDisableQuestMark: CName;
  protected let m_callbackToDisableQuestMarkID: Uint32;
  protected persistent let m_backdoorObjectiveData: BackDoorObjectiveData;
  protected persistent let m_controlPanelObjectiveData: ControlPanelObjectiveData;
  protected let m_deviceUIStyle: gamedataComputerUIStyle;
  protected let m_blackboard: wref<IBlackboard>;
  protected persistent let m_isScanned: Bool;
  private let m_isBeingScanned: Bool;
  protected persistent let m_exposeQuickHacks: Bool;
  protected let m_isAttachedToGame: Bool;
  protected let m_isLogicReady: Bool;
  protected let m_maxDevicesToExtractInOneFrame: Int32;

  protected final func ProcessDevicesLazy(
    const lazyDevices: script_ref<[LazyDevice]>,
    opt eventToSendOnCompleted: ProcessDevicesEvent
  ) {
    let evt = new ExtractDevicesEvent();
    evt.lazyDevices = lazyDevices;
    evt.eventToSendOnCompleted = eventToSendOnCompleted;
    this.ResolveExtractDevicesEvent(evt);
  }

  protected func OnExtractDevicesEvent(evt: ExtractDevicesEvent) -> EntityNotificationType {
    this.ResolveExtractDevicesEvent(evt);
    return EntityNotificationType.DoNotNotifyEntity;
  }

  private final func ResolveExtractDevicesEvent(evt: ExtractDevicesEvent) {
    let extractedDevicesCount: Int32;
    let currentIdex: Int32;
    if evt == null {
      return;
    } else if evt.lastExtractedIndex > 0 {
      currentIdex = evt.lastExtractedIndex + 1;
    }
    currentIdex = 0;
    let i = currentIdex;
    if i < ArraySize(evt.lazyDevices) {
      extractedDevicesCount += 1;
      let devicePS = evt.lazyDevices[i].ExtractDevice(this.GetGameInstance());
      if IsDefined(devicePS) {
        ArrayPush(evt.devices, devicePS);
      } else if i == ArraySize(evt.lazyDevices) - 1 {
        if IsDefined(evt.eventToSendOnCompleted) {
          evt.eventToSendOnCompleted.devices = evt.devices;
          this
            .GetPersistencySystem()
            .QueuePSEvent(this.GetID(), this.GetClassName(), evt.eventToSendOnCompleted);
        }
      } else if extractedDevicesCount >= this.m_maxDevicesToExtractInOneFrame {
        evt.lastExtractedIndex = i;
        GameInstance
          .GetDelaySystem(this.GetGameInstance())
          .DelayPSEventNextFrame(this.GetID(), this.GetClassName(), evt);
      }
      i += 1;
    }
  }

  public const final func GetPS(deviceLink: DeviceLink) -> DeviceComponentPS {
    return this
      .GetPersistencySystem()
