  private final func SendScopeData() {
    let weaponRecID: TweakDBID;
    let weaponRecord = this.GetWeaponRecord();
    if IsDefined(weaponRecord) {
      weaponRecID = weaponRecord.GetID();
    }
    let animFeature = new AnimFeature_WeaponScopeData();
    animFeature.hasScope = this.HasScope();
    animFeature.ironsightAngleWithScope = TDB.GetFloat(weaponRecID + t".ironsightAngleWithScope");
    AnimationControllerComponent.ApplyFeature(this, n"ScopeData", animFeature);
  }

  private final func SendWeaponStatsAnimFeature() {
    let statSystem = GameInstance.GetStatsSystem(this.GetGame());
    let weaponStatsID = this.GetEntityID();
    let animFeature = new AnimFeature_WeaponStats();
    animFeature.cycleTime = statSystem
      .GetStatValue(Cast<StatsObjectID>(weaponStatsID), gamedataStatType.CycleTime);
    animFeature.magazineCapacity = Cast<Int32>(
      statSystem
        .GetStatValue(Cast<StatsObjectID>(weaponStatsID), gamedataStatType.MagazineCapacity)
    );
    AnimationControllerComponent.ApplyFeature(this, n"WeaponStats", animFeature);
  }

  private final func OnUpdateWeaponStatsEvent(evt: UpdateWeaponStatsEvent) {
