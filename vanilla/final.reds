class AIActionHelper extends IScriptable {
  public final static func ActionDebugHelper(entity: wref<Entity>, const actionName: script_ref<String>) -> Bool {
    let actionNameCheck = (entity as GameObject).GetTracedActionName();
    if IsDefined(entity) || IsStringValid(actionNameCheck) && IsStringValid(actionName) {
      if IsStringValid(actionNameCheck) {
        if StrContains(actionName, actionNameCheck) {
          if IsDefined(entity as GameObject) {
            if (entity as GameObject).IsSelectedForDebugging() {
              return true;
            }
            return false;
          }
          return true;
        }
        return false;
      } else if IsDefined(entity as GameObject) {
        if (entity as GameObject).IsSelectedForDebugging() {
          return true;
        }
        return false;
      }
    }
    return false;
  }

  public final static func ActionDebugHelper(
    const actionNameCheck: script_ref<String>,
    entity: wref<Entity>,
    const actionName: script_ref<String>
  ) -> Bool {
    if IsDefined(entity) || IsStringValid(actionNameCheck) && IsStringValid(actionName) {
      if IsStringValid(actionNameCheck) {
        if StrContains(actionName, actionNameCheck) {
          if IsDefined(entity as GameObject) {
            if (entity as GameObject).IsSelectedForDebugging() {
              return true;
            }
            return false;
          }
          return true;
        }
        return false;
      } else if IsDefined(entity as GameObject) {
        if (entity as GameObject).IsSelectedForDebugging() {
          return true;
        }
        return false;
      }
    }
    return false;
  }

  public final static func ActionDebugHelper(const actionNameCheck: script_ref<String>, const actionName: script_ref<String>) -> Bool {
    if IsStringValid(actionNameCheck) && IsStringValid(actionName) {
      if StrContains(actionName, actionNameCheck) {
        return true;
      }
      return false;
    }
    return false;
  }

  public final static func SetActionExclusivity(owner: GameObject, active: Bool) {
    let puppet = owner as ScriptedPuppet;
    puppet
      .GetPuppetStateBlackboard()
      .SetBool(GetAllBlackboardDefs().PuppetState.InExclusiveAction, active);
  }

  public final static func HasLostTarget(owner: ScriptedPuppet, target: GameObject) -> Bool {
    let threat: TrackedLocation;
    if IsDefined(owner) && IsDefined(target) && target != owner {
      let targetTrackerComponent = owner.GetTargetTrackerComponent();
      if IsDefined(targetTrackerComponent) && target.IsPuppet() {
        return !targetTrackerComponent.ThreatFromEntity(target, threat);
      }
    }
    return false;
  }

  public final static func HasCombatAICommand(owner: wref<ScriptedPuppet>) -> Bool {
    let aiComponent = owner.GetAIControllerComponent();
    if !IsDefined(aiComponent) {
      return false;
    }
    return aiComponent.IsCommandActive(n"AICombatRelatedCommand");
  }

  public final static func HasWorkspotAICommand(owner: wref<ScriptedPuppet>) -> Bool {
    let aiComponent = owner.GetAIControllerComponent();
    if !IsDefined(aiComponent) {
      return false;
    }
    return aiComponent.IsCommandActive(n"AIUseWorkspotCommand");
  }

  public final static func HasFollowerCombatAICommand(owner: wref<ScriptedPuppet>) -> Bool {
    let aiComponent = owner.GetAIControllerComponent();
    if !IsDefined(aiComponent) {
      return false;
    }
    return aiComponent.IsCommandActive(n"AIFollowerCombatCommand");
  }

  public final static func GetActionBlackboard(owner: ScriptedPuppet) -> IBlackboard {
    return owner.GetAIControllerComponent().GetActionBlackboard();
  }

  public final static func GetShootingBlackboard(owner: ScriptedPuppet) -> IBlackboard {
    return owner.GetAIControllerComponent().GetShootingBlackboard();
  }

  public final static func ShouldShootDirectlyAtTarget(
    weaponOwner: wref<GameObject>,
    weapon: wref<WeaponObject>,
    targetPosition: Vector4
  ) -> Bool {
    if weapon.IsTargetLocked() {
      return true;
    } else if Vector4.IsZero(targetPosition) || !weaponOwner.GetTargetTrackerComponent().IsPositionValid(targetPosition) {
      return false;
    }
    let vecToTarget = targetPosition - weapon.GetWorldPosition();
    let coneAngle = MinF(6.0 * Vector4.Length(vecToTarget), 30.0);
    let absAngleToCombatTarget = AbsF(
      Vector4
        .GetAngleDegAroundAxis(vecToTarget, weapon.GetWorldForward(), weaponOwner.GetWorldUp())
    );
    if absAngleToCombatTarget >= 0.0 && coneAngle > 0.0 && absAngleToCombatTarget <= coneAngle * 0.5 {
      return true;
    }
    return false;
  }

  public final static func GetTargetSlotPosition(target: wref<GameObject>, slotName: CName, out slotPosition: Vector4) -> Bool {
    let slotTransform: WorldTransform;
    Vector4.Zero(slotPosition);
    if !IsNameValid(slotName) {
      slotName = n"Head";
    } else if AIActionHelper.GetTargetSlotTransform(target, slotName, slotTransform) {
      slotPosition = WorldPosition.ToVector4(WorldTransform.GetWorldPosition(slotTransform));
      return true;
    }
    return false;
  }

  public final static func GetTargetPositionFromPast(target: wref<GameObject>, delay: Float, out position: Vector4) -> Bool {
    let targetSP = target as ScriptedPuppet;
    if IsDefined(targetSP) && IsDefined(targetSP.GetTransformHistoryComponent()) {
      position = targetSP.GetTransformHistoryComponent().GetInterpolatedPositionFromHistory(delay);
      return true;
    }
    return false;
  }

  public final static func GetTargetSlotTransform(target: wref<GameObject>, slotName: CName, out slotTransform: WorldTransform) -> Bool {
    let hitRepresentationSlotComponent: SlotComponent;
    let slotComponent: SlotComponent;
    let targetPuppet = target as ScriptedPuppet;
    if IsDefined(targetPuppet) {
      hitRepresentationSlotComponent = targetPuppet.GetHitRepresantationSlotComponent();
      slotComponent = targetPuppet.GetSlotComponent();
    } else {
      let targetMuppet = target as Muppet;
      if IsDefined(targetMuppet) {
        hitRepresentationSlotComponent = targetMuppet.GetHitRepresantationSlotComponent();
        slotComponent = targetMuppet.GetSlotComponent();
      }
    }
    if IsDefined(hitRepresentationSlotComponent) && hitRepresentationSlotComponent.GetSlotTransform(slotName, slotTransform) {
      return true;
    } else if IsDefined(slotComponent) && slotComponent.GetSlotTransform(slotName, slotTransform) {
      return true;
    }
    return false;
  }

  public final static func AnimationsLoadedSignal(ownerPuppet: wref<ScriptedPuppet>) {
    let signalId = ownerPuppet.GetSignalTable().GetOrCreateSignal(n"AnimationsLoaded");
    ownerPuppet.GetSignalTable().Set(signalId, false);
    ownerPuppet.GetSignalTable().Set(signalId, true);
  }

  public final static func CombatQueriesInit(ownerPuppet: wref<ScriptedPuppet>) {
    let signalTable = ownerPuppet.GetSignalTable();
    let signalId = signalTable.GetOrCreateSignal(n"CombatQueriesRequest");
    signalTable.Set(signalId, false);
    signalTable.Set(signalId, true);
  }

  public final static func TryChangingAttitudeToHostile(owner: ScriptedPuppet, target: GameObject) -> Bool {
    let attitudeOwner = owner.GetAttitudeAgent();
    let attitudeTarget = target.GetAttitudeAgent();
    if !target.IsPuppet() && !target.IsSensor() {
      return false;
    } else if !target.IsActive() {
      return false;
    } else if IsDefined(attitudeOwner) && IsDefined(attitudeTarget) {
      let currentAttitude = attitudeOwner.GetAttitudeTowards(attitudeTarget);
      switch currentAttitude {
        case EAIAttitude.AIA_Friendly:
          return false;
        case EAIAttitude.AIA_Hostile:
          return true;
      }
      if owner.IsAggressive() {
        attitudeOwner
          .SetAttitudeTowardsAgentGroup(attitudeTarget, attitudeOwner, EAIAttitude.AIA_Hostile);
        return true;
      }
      return false;
    }
    return false;
  }

  public final static func TryStartCombatWithTarget(owner: ScriptedPuppet, target: GameObject) -> Bool {
    if AIActionHelper.TryChangingAttitudeToHostile(owner, target) {
      TargetTrackingExtension.InjectThreat(owner, target);
      return true;
    }
    return false;
  }

  public final static func SetCommandCombatTarget(
    context: ScriptExecutionContext,
    target: wref<GameObject>,
    isPersistant: Bool,
    persistenceSource: Uint32
  ) -> Bool {
    if !IsDefined(target) || ScriptExecutionContext.GetOwner(context) == target {
      return false;
    } else if target.IsPuppet() {
      if !ScriptedPuppet.IsActive(target) {
        return false;
      }
      GameObject
        .ChangeAttitudeToHostile(ScriptExecutionContext.GetOwner(context), target);
      TargetTrackingExtension
        .InjectThreat(ScriptExecutionContext.GetOwner(context) as ScriptedPuppet, target);
      if isPersistant {
        TargetTrackingExtension
          .SetThreatPersistence(
            ScriptExecutionContext.GetOwner(context) as ScriptedPuppet,
            target,
            true,
            persistenceSource
          );
      }
    }
    ScriptExecutionContext.SetArgumentObject(context, n"CommandCombatTarget", target);
    return true;
  }

  public final static func ClearCommandCombatTarget(
    context: ScriptExecutionContext,
    persistenceSource: Uint32,
    opt ignoreCombatTargetCommand: Bool
  ) {
    let puppet = ScriptExecutionContext.GetOwner(context) as ScriptedPuppet;
    let tt = puppet.GetTargetTrackerComponent();
    let target = ScriptExecutionContext.GetArgumentObject(context, n"CommandCombatTarget");
    TargetTrackingExtension.SetThreatPersistence(puppet, target, false, persistenceSource);
    if !ignoreCombatTargetCommand && IsDefined(tt) {
      let combatTargetCmdSourceRecord = TweakDBInterface
        .GetAIThreatPersistenceSourceRecord(t"AIThreatPersistenceSource.CommandInjectCombatTarget");
      if Equals(
        tt
          .GetThreatPersistenceBySource(target, Cast<Uint32>(combatTargetCmdSourceRecord.EnumValue())),
        AIThreatPersistenceStatus.Persistent
      ) {
        return;
      }
    }
    ScriptExecutionContext.SetArgumentObject(context, n"CommandCombatTarget", null);
  }

  public final static func IsCommandCombatTargetValid(context: ScriptExecutionContext, commandName: CName) -> Bool {
    let target = ScriptExecutionContext.GetArgumentObject(context, n"CommandCombatTarget");
    if !ScriptedPuppet.IsActive(ScriptExecutionContext.GetOwner(context)) {
      ScriptExecutionContext
        .DebugLog(
          context,
          commandName,
          "Canceling command, owner is Dead, Defeated or Unconscious"
        );
      return false;
    } else if !IsDefined(target) {
      ScriptExecutionContext
        .DebugLog(context, commandName, "Canceling command, Target no longer exists");
      return false;
    } else if target.IsPuppet() {
      if !ScriptedPuppet.IsActive(target) {
        ScriptExecutionContext
          .DebugLog(context, commandName, "Canceling command, Target no longer active");
        return false;
      }
    } else if Equals(
      GameObject.GetAttitudeBetween(ScriptExecutionContext.GetOwner(context), target),
      EAIAttitude.AIA_Friendly
    ) {
      ScriptExecutionContext.DebugLog(context, commandName, "Canceling command, Target is Friendly");
      return false;
    }
    break;
    if AIActionHelper
      .HasLostTarget(ScriptExecutionContext.GetOwner(context) as ScriptedPuppet, target) {
      ScriptExecutionContext
        .DebugLog(context, commandName, "Canceling command, lost track of target");
      return false;
    }
    return true;
  }

  public final static func TargetAllSquadMembers(owner: wref<GameObject>) {
    let squadMembers: [wref<Entity>];
    let attitudeOwner = owner.GetAttitudeAgent();
    attitudeOwner.SetAttitudeGroup(n"HostileToEveryone");
    let targetTrackerComponent = owner.GetTargetTrackerComponent();
    if !AISquadHelper.GetSquadmates(owner as ScriptedPuppet, squadMembers) {
      return;
    }
    let i = 0;
    while i < ArraySize(squadMembers) {
      let target = squadMembers[i] as GameObject;
      if !IsDefined(target) || target == owner || !ScriptedPuppet.IsActive(target) {
      } else {
        let attitudeTarget = target.GetAttitudeAgent();
        attitudeOwner.SetAttitudeTowards(attitudeTarget, EAIAttitude.AIA_Hostile);
        if IsDefined(targetTrackerComponent) {
          targetTrackerComponent.AddThreat(target, true, target.GetWorldPosition(), 1.0, -1.0, false);
        }
      }
      i += 1;
    }
    return;
  }

  public final static func SetFriendlyTargetAllSquadMembers(owner: wref<GameObject>) {
    let squadMembers: [wref<Entity>];
    let attitudeOwner = owner.GetAttitudeAgent();
    if !AISquadHelper.GetSquadmates(owner as ScriptedPuppet, squadMembers) {
      return;
    }
    let targetTrackerComponent = owner.GetTargetTrackerComponent();
    if IsDefined(targetTrackerComponent) {
      targetTrackerComponent.ClearThreats();
    }
    let i = 0;
    while i < ArraySize(squadMembers) {
      let target = squadMembers[i] as GameObject;
      if !IsDefined(target) || target == owner || !ScriptedPuppet.IsActive(target) {
      } else {
        let attitudeTarget = target.GetAttitudeAgent();
        attitudeOwner.SetAttitudeTowards(attitudeTarget, EAIAttitude.AIA_Hostile);
        if IsDefined(targetTrackerComponent) {
          targetTrackerComponent.AddThreat(target, true, target.GetWorldPosition(), 1.0, -1.0, false);
        }
      }
      i += 1;
    }
    return;
  }

  public final static func ChangeAttitudeToFriendlyAllSquad(owner: wref<GameObject>, const squadMembers: script_ref<[EntityID]>) {
    let attitudeOwner = owner.GetAttitudeAgent();
    let i = 0;
    while i < ArraySize(squadMembers) {
      let target = GameInstance.FindEntityByID(owner.GetGame(), squadMembers[i]) as GameObject;
      if !IsDefined(target) || target == owner {
      } else {
        let attitudeTarget = target.GetAttitudeAgent();
        attitudeOwner.SetAttitudeTowards(attitudeTarget, EAIAttitude.AIA_Friendly);
      }
      i += 1;
    }
    return;
  }

  public final static func GetActiveTopHostilePuppetThreat(puppet: ScriptedPuppet, threat: script_ref<TrackedLocation>) -> Bool {
    let currentTopThreat: TrackedLocation;
    let targetTrackerComponent = puppet.GetTargetTrackerComponent();
    if targetTrackerComponent.GetTopHostileThreat(false, currentTopThreat) {
      threat = currentTopThreat;
      let newTargetPuppet = currentTopThreat.entity as ScriptedPuppet;
      if IsDefined(newTargetPuppet) {
        if ScriptedPuppet.IsActive(newTargetPuppet) {
          return true;
        }
        let allThreats = targetTrackerComponent.GetHostileThreats(false);
        let i = ArraySize(allThreats) - 1;
        while i >= 0 {
          newTargetPuppet = allThreats[i].entity as ScriptedPuppet;
          if ScriptedPuppet.IsActive(newTargetPuppet) {
            threat = allThreats[i];
            return true;
          }
          i -= 1;
        }
      }
    }
    return false;
  }

  public final static func GetAnimWrapperNameBasedOnItemID(itemID: ItemID) -> CName {
    let animWrapperName = TDB.GetCName(ItemID.GetTDBID(itemID) + t".NPCAnimWrapperWeightOverride");
    if !IsNameValid(animWrapperName) {
      animWrapperName = TweakDBInterface
        .GetItemRecord(ItemID.GetTDBID(itemID))
        .ItemType()
        .Name();
    }
    return animWrapperName;
  }

  public final static func GetAnimWrapperNameBasedOnItemTag(itemID: ItemID) -> CName {
    let itemRecord = TweakDBInterface.GetItemRecord(ItemID.GetTDBID(itemID));
    if itemRecord.TagsContains(n"MeleeWeapon") {
      return n"MeleeWeapon";
    }
    if itemRecord.TagsContains(n"RangedWeapon") {
      return n"RangedWeapon";
    }
    return n"None";
  }

  public final static func SendItemHandling(
    owner: wref<GameObject>,
    itemRecord: wref<Item_Record>,
    animFeatureName: CName,
    equipped: Bool
  ) {
    let itemHandling = new AnimFeature_EquipUnequipItem();
    itemHandling.itemState = equipped ? 2 : 0;
    itemHandling.itemType = itemRecord.ItemType().AnimFeatureIndex();
    AnimationControllerComponent.ApplyFeatureToReplicate(owner, animFeatureName, itemHandling);
  }

