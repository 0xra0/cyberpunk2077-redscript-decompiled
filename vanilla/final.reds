    if this.GetInStateTime() >= this.GetStaticFloatParameterDefault("stateDuration", 4.5) {
      return true;
    } else if Equals(this.GetTakedownAction(stateContext), ETakedownActionType.GrappleFailed) {
      return true;
    } else if this.IsDeepEnoughToSwim(scriptInterface) && this.GetInStateTime() >= 0.6 {
      return true;
