class StrikeExecutor_Kill extends EffectExecutor_Scripted {
  public final func Process(ctx: EffectScriptContext, applierCtx: EffectExecutionScriptContext) -> Bool {
    let puppet = EffectExecutionScriptContext.GetTarget(applierCtx) as ScriptedPuppet;
    if IsDefined(puppet) {
      puppet.Kill();
      return true;
    }
    return true;
  }
}

abstract class LeftHandCyberwareHelper extends IScriptable {
  public final static func ProjectileLauncherHasCharge(const scriptInterface: StateGameScriptInterface) -> Bool {
    let charges = (scriptInterface.executionOwner as PlayerPuppet).GetProjectileLauncherCharges();
    return charges > 0;
  }

  public final static func IsProjectileLauncherEquipped(const scriptInterface: StateGameScriptInterface) -> Bool {
    let weapon = scriptInterface
      .GetTransactionSystem()
      .GetItemInSlot(scriptInterface.executionOwner, t"AttachmentSlots.WeaponLeft") as WeaponObject;
    if IsDefined(weapon) && WeaponObject.IsOfType(weapon.GetItemID(), gamedataItemType.Cyb_Launcher) {
      return true;
    }
    return false;
  }
}

class ZoomBlockedEvents extends ZoomEventsTransition {
  public let previousCameraPerspective: vehicleCameraPerspective;
  public let previousCameraPerspectiveValid: Bool;

  public func OnEnter(stateContext: StateContext, scriptInterface: StateGameScriptInterface) {
    if stateContext.IsStateMachineActive(n"Vehicle") {
      if this.previousCameraPerspectiveValid && NotEquals(this.previousCameraPerspective, vehicleCameraPerspective.FPP) {
        this
          .RequestVehicleCameraPerspective(scriptInterface, this.previousCameraPerspective);
        this.SetZoomStateAnimFeature(scriptInterface, false);
      }
    }
    this
      .SetBlendTime(stateContext, this.GetStaticFloatParameterDefault("blendTime", 0.2));
    this
      .SetBlackboardIntVariable(
        scriptInterface,
        GetAllBlackboardDefs().PlayerStateMachine.MaxZoomLevel,
        this.GetZoomLevelNumber(stateContext)
      );
    super.OnEnter(stateContext, scriptInterface);
    this.StopEffect(scriptInterface, n"zoom");
  }

  protected final func OnExit(stateContext: StateContext, scriptInterface: StateGameScriptInterface) {
    let isInDriverCombat = scriptInterface.localBlackboard.GetInt(GetAllBlackboardDefs().PlayerStateMachine.Vehicle) == 6;
    if stateContext.IsStateMachineActive(n"Vehicle") && !isInDriverCombat {
      this.previousCameraPerspective = GetMountedVehicle(scriptInterface.executionOwner).GetCameraManager().GetActivePerspective();
      this.previousCameraPerspectiveValid = true;
    } else {
      this.previousCameraPerspectiveValid = false;
    }
  }

  public func OnExitToZoomLevelBase(stateContext: StateContext, scriptInterface: StateGameScriptInterface) {
    this.OnExit(stateContext, scriptInterface);
  }
}

class SwimmingSurfaceDecisions extends LocomotionSwimming {
  protected const final func EnterCondition(const stateContext: StateContext, const scriptInterface: StateGameScriptInterface) -> Bool {
    return !this.CanEnterFastSwimming(stateContext, scriptInterface) && !this.IsDeepEnoughToDive(stateContext, scriptInterface);
  }

  protected const final func ToDiving(const stateContext: StateContext, const scriptInterface: StateGameScriptInterface) -> Bool {
    if this.CanEnterFastSwimming(stateContext, scriptInterface) {
      return false;
    }
    let depthTreshold = this.GetStaticFloatParameterDefault("skipTransitionDepthTreshold", 0.0);
    let currentDepth = this.GetCurrentDepth(stateContext, scriptInterface);
    return currentDepth <= depthTreshold;
  }
}

class LookAtTargetExecutor extends EffectExecutor_Scripted {
  public final func Process(ctx: EffectScriptContext, applierCtx: EffectExecutionScriptContext) -> Bool {
    let aimRequestData: AimRequest;
    aimRequestData.duration = 0.25;
    aimRequestData.easeIn = true;
    aimRequestData.easeOut = true;
    aimRequestData.adjustPitch = true;
    aimRequestData.adjustYaw = true;
    aimRequestData.checkRange = true;
    aimRequestData.endOnCameraInputApplied = false;
    aimRequestData.cameraInputMagToBreak = 0.2;
    aimRequestData.endOnTargetReached = false;
    aimRequestData.endOnTimeExceeded = true;
    aimRequestData.processAsInput = true;
    let target = EffectExecutionScriptContext.GetTarget(applierCtx);
    if IsDefined(target as ScriptedPuppet) {
      GameInstance
        .GetTargetingSystem(EffectScriptContext.GetGameInstance(ctx))
        .LookAt(EffectScriptContext.GetInstigator(ctx) as GameObject, aimRequestData);
    }
    return true;
  }
}

class SwimmingSurfaceEvents extends LocomotionSwimmingEvents {
  public let m_lapsedTime: Float;
  public let m_isDead: Bool;
  public let m_timeSinceLastImpulse: Float;
  public let m_minSpeedForMovementImpulses: Float;
  public let m_timeBetweenIdleImpulses: Float;
  public let m_timeBetweenMovementImpulses: Float;
  public let m_idleImpulseRadius: Float;
  public let m_idleImpulseStrength: Float;
  public let m_movementImpulseRadius: Float;
  public let m_movementImpulseStrength: Float;
  public let m_movementImpulseOffset: Float;

  protected func OnAttach(const stateContext: StateContext, const scriptInterface: StateGameScriptInterface) {
    super.OnAttach(stateContext, scriptInterface);
    this.m_minSpeedForMovementImpulses = this.GetStaticFloatParameterDefault("minSpeedForMovementImpulses", 0.3);
    this.m_timeBetweenIdleImpulses = this.GetStaticFloatParameterDefault("timeBetweenIdleImpulses", 1.6);
    this.m_timeBetweenMovementImpulses = this.GetStaticFloatParameterDefault("timeBetweenMovementImpulses", 0.1);
    this.m_idleImpulseRadius = this.GetStaticFloatParameterDefault("idleImpulseRadius", 0.1);
    this.m_idleImpulseStrength = this.GetStaticFloatParameterDefault("idleImpulseStrength", 0.0007);
    this.m_movementImpulseRadius = this.GetStaticFloatParameterDefault("movementImpulseRadius", 0.3);
    this.m_movementImpulseStrength = this.GetStaticFloatParameterDefault("movementImpulseStrength", 0.0005);
    this.m_movementImpulseOffset = this.GetStaticFloatParameterDefault("movementImpulseOffset", 0.2);
  }

  protected func OnUpdate(
    timeDelta: Float,
    stateContext: StateContext,
    scriptInterface: StateGameScriptInterface
  ) {
    if !this.m_isDead {
      super.OnUpdate(timeDelta, stateContext, scriptInterface);
      this.UpdateSwimmingStroke(timeDelta, stateContext, scriptInterface);
      this.CreateWaterImpulse(timeDelta, stateContext, scriptInterface);
    }
  }

  private final func UpdateSwimmingStroke(
    timeDelta: Float,
    stateContext: StateContext,
    scriptInterface: StateGameScriptInterface
  ) {
    this.m_lapsedTime += timeDelta;
    let timeBetweenSwimmingStroke = this.GetStaticFloatParameterDefault("timeBetweenSurfaceSwimmingStroke", 1.0);
    if this.m_lapsedTime
      >= timeBetweenSwimmingStroke
      && this.IsSwimmingForward(stateContext, scriptInterface) {
      this.m_lapsedTime = 0.0;
      this
        .AddImpulseInMovingDirection(
          stateContext,
          scriptInterface,
          this
            .GetStaticFloatParameterDefault("surfaceSwimmingStrokeImpulseForce", 1.0)
        );
      GameObjectEffectHelper
        .StartEffectEvent(scriptInterface.executionOwner, n"swimming_surface_stroke", false);
    }
  }

  private final func CreateWaterImpulse(
    timeDelta: Float,
    stateContext: StateContext,
    scriptInterface: StateGameScriptInterface
  ) {
    let impulsePosition: Vector4;
    let impulseRadius: Float;
    let impulseStrength: Float;
    let applyImpulse = false;
    this.m_timeSinceLastImpulse += timeDelta;
    if scriptInterface.GetOwnerStateVectorParameterFloat(physicsStateValue.LinearSpeed) < this.m_minSpeedForMovementImpulses {
      if this.m_timeSinceLastImpulse >= this.m_timeBetweenIdleImpulses {
        applyImpulse = true;
        impulsePosition = DefaultTransition.GetPlayerPosition(scriptInterface);
        impulseRadius = this.m_idleImpulseRadius;
        impulseStrength = this.m_idleImpulseStrength;
      }
    } else if this.m_timeSinceLastImpulse >= this.m_timeBetweenMovementImpulses {
      applyImpulse = true;
      impulsePosition = DefaultTransition.GetPlayerPosition(scriptInterface);
      impulsePosition += scriptInterface.GetOwnerMovingDirection() * this.m_movementImpulseOffset;
      impulseRadius = this.m_idleImpulseRadius;
      impulseStrength = this.m_idleImpulseStrength;
    }
    if applyImpulse {
      this.m_timeSinceLastImpulse = 0.0;
      StateGameScriptInterface.CreateWaterImpulse(impulsePosition, impulseRadius, impulseStrength, 2u);
    }
  }

  public final func OnEnterFromDiving(stateContext: StateContext, scriptInterface: StateGameScriptInterface) {
    this.PlaySound(n"surface_from_dive", scriptInterface);
    this.OnEnter(stateContext, scriptInterface);
  }

  public func OnEnter(stateContext: StateContext, scriptInterface: StateGameScriptInterface) {
    this.m_lapsedTime = 0.0;
    this.m_timeSinceLastImpulse = 0.0;
    StatusEffectHelper
      .ApplyStatusEffect(scriptInterface.executionOwner, t"BaseStatusEffect.WaterCollision");
    this.SetLocomotionParameters(stateContext, scriptInterface);
    GameObjectEffectHelper.StopEffectEvent(scriptInterface.executionOwner, n"falling");
    this
      .SetBlackboardIntVariable(scriptInterface, GetAllBlackboardDefs().PlayerStateMachine.Swimming, 1);
    if !scriptInterface
      .GetStatPoolsSystem()
      .HasStatPoolValueReachedMin(
        Cast<StatsObjectID>(scriptInterface.ownerEntityID),
        gamedataStatPoolType.Health
      ) {
      this.m_isDead = false;
      GameObjectEffectHelper
        .StartEffectEvent(scriptInterface.executionOwner, n"swimming_surface", false);
      this.TutorialSetFact(scriptInterface, n"swimming_tutorial");
      super.OnEnter(stateContext, scriptInterface);
    } else {
      this.m_isDead = true;
      GameObjectEffectHelper
        .StartEffectEvent(scriptInterface.executionOwner, n"swimming_enter_dive", false);
    }
  }

  public func OnExit(stateContext: StateContext, scriptInterface: StateGameScriptInterface) {
    GameObjectEffectHelper.StopEffectEvent(scriptInterface.executionOwner, n"swimming_surface");
    super.OnExit(stateContext, scriptInterface);
  }
}

class MeleePreAttackExecutor extends EffectExecutor_Scripted {
  public final func Process(ctx: EffectScriptContext, applierCtx: EffectExecutionScriptContext) -> Bool {
    let target = EffectExecutionScriptContext.GetTarget(applierCtx);
    if IsDefined(target) {
      let targetID = target.GetEntityID();
      let aiEvent = new StimuliEvent();
      aiEvent.name = n"MeleeDodgeOpportunity";
      target.QueueEventForEntityID(targetID, aiEvent);
      return true;
    }
    return false;
  }
}

class ZoomLevelBaseDecisions extends ZoomDecisionsTransition {
  protected const final func ToZoomLevelAim(const stateContext: StateContext, const scriptInterface: StateGameScriptInterface) -> Bool {
    if this.ToNextZoomLevel(stateContext, scriptInterface) {
      if this.IsControllingSniperNestDevice(scriptInterface) {
        return false;
      } else if this.IsControllingDevice(stateContext, scriptInterface)
        && StatusEffectSystem
          .ObjectHasStatusEffectWithTag(scriptInterface.executionOwner, n"DeviceControlZoomLock") {
        return false;
      }
      return true;
    } else if this.IsConsideredAiming(stateContext, scriptInterface) {
      return true;
    }
    return false;
  }
}

class CombatGadgetWaitForUnequipDecisions extends CombatGadgetTransitions {
  protected const final func ToCombatGadgetUnequip(const stateContext: StateContext, const scriptInterface: StateGameScriptInterface) -> Bool {
    return this.GetInStateTime() >= this.GetStaticFloatParameterDefault("UnequipDuration", 0.2);
  }
}

