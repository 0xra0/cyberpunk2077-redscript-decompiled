class PlayerHasTakedownWeaponEquippedPrereq extends IScriptablePrereq {
  public const func IsFulfilled(game: GameInstance, context: IScriptable) -> Bool {
    let playerControlledObject = GameInstance.GetPlayerSystem(game).GetLocalPlayerControlledGameObject();
    let weaponObj = GameInstance
      .GetTransactionSystem(playerControlledObject.GetGame())
      .GetItemInSlot(playerControlledObject, t"AttachmentSlots.WeaponRight") as WeaponObject;
    let itemID = weaponObj.GetItemID();
    if IsDefined(playerControlledObject) && ItemID.IsValid(itemID) {
      let record = TweakDBInterface.GetItemRecord(ItemID.GetTDBID(itemID));
      let tags = record.Tags();
      let i = 0;
      while i < ArraySize(tags) {
        if Equals(tags[i], n"TakedownWeapon") {
          return true;
        }
        i += 1;
      }
    }
    return false;
  }
}

