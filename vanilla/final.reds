class ModifyDamageWithStatPoolEffector extends ModifyDamageEffector {
  public let m_statPool: gamedataStatPoolType;
  public let m_poolStatus: String;
  public let m_maxDmg: Float;
  public let m_percentMult: Float;
  public let m_refObj: String;

  protected func Initialize(record: TweakDBID, game: GameInstance, parentRecord: TweakDBID) {
    super.Initialize(record, game, parentRecord);
    let str = TweakDBInterface.GetString(record + t".operationType", "");
    this.m_operationType = IntEnum<EMathOperator>(Cast<Int32>(EnumValueFromString("EMathOperator", str)));
    str = TweakDBInterface.GetString(record + t".statPool", "");
    this.m_statPool = IntEnum<gamedataStatPoolType>(Cast<Int32>(EnumValueFromString("gamedataStatPoolType", str)));
    this.m_poolStatus = TweakDBInterface.GetString(record + t".poolStatus", "");
    this.m_refObj = TweakDBInterface.GetString(record + t".refObj", "");
    this.m_maxDmg = TweakDBInterface.GetFloat(record + t".maxDmg", 1.0);
    this.m_percentMult = TweakDBInterface.GetFloat(record + t".percentMult", 0.0);
  }

  protected func Uninitialize(game: GameInstance);

  private final func GetRefObject(hitEvent: gameHitEvent) -> wref<GameObject> {
    switch this.m_refObj {
      case "Instigator":
        return hitEvent.attackData.GetInstigator();
      case "Target":
        return hitEvent.target;
    }
    return null;
  }

  protected func RepeatedAction(owner: GameObject) {
    let hitEvent = this.GetHitEvent();
    if !IsDefined(hitEvent) {
      return;
    }
    let obj = this.GetRefObject(hitEvent);
    if !IsDefined(obj) {
      return;
    }
    let statPoolVal = GameInstance
      .GetStatPoolsSystem(owner.GetGame())
      .GetStatPoolValue(Cast<StatsObjectID>(obj.GetEntityID()), this.m_statPool) / 100.0;
    if Equals(this.m_poolStatus, "Missing") {
      statPoolVal = 1.0 - statPoolVal;
    } else if this.m_percentMult != 0.0 {
      let statPoolMaxVal = GameInstance
        .GetStatPoolsSystem(owner.GetGame())
        .GetStatPoolMaxPointValue(Cast<StatsObjectID>(obj.GetEntityID()), this.m_statPool);
      statPoolVal *= statPoolMaxVal;
      this.m_value = statPoolVal * this.m_percentMult + 1.0;
      if this.m_maxDmg != 0.0 {
        this.m_value = MinF(this.m_value, this.m_maxDmg);
      }
      this.ModifyDamage(hitEvent, this.m_operationType, this.m_value);
    } else if this.m_maxDmg != 0.0 {
      this.m_value = (this.m_maxDmg - 1.0) * statPoolVal + 1.0;
      this.ModifyDamage(hitEvent, this.m_operationType, this.m_value);
    }
  }
}

