class MenuScenario_ClippedMenu extends inkMenuScenario {
  protected cb func OnEnterScenario(prevScenario: CName, userData: IScriptable) -> Bool {
    let menuState = this.GetMenusState();
    menuState.ShowMenus(false);
    let data = userData as inkClippedMenuScenarioData;
    if IsDefined(data) {
      let i = 0;
      while i < ArraySize(data.menus) {
        menuState.OpenMenu(data.menus[i]);
        i += 1;
      }
    }
  }

  protected cb func OnOpenPauseMenu() -> Bool {
    let menuState = this.GetMenusState();
    menuState.ShowMenus(!menuState.IsMenusVisible());
  }

  protected cb func OnOpenHubMenu() -> Bool {
    let menuState = this.GetMenusState();
    menuState.ShowMenus(!menuState.IsMenusVisible());
  }
}

class IsNPCInActivePoliceChase extends PreventionConditionAbstract {
  protected func Check(context: ScriptExecutionContext) -> AIbehaviorConditionOutcomes {
    let prevSpawnSys = GameInstance.GetPreventionSpawnSystem(ScriptExecutionContext.GetOwner(context).GetGame());
    return Cast<AIbehaviorConditionOutcomes>(
      NPCManager
        .HasTag(
          AIBehaviorScriptBase.GetPuppet(context).GetRecordID(),
          n"InActivePoliceChase"
        )
        && !NPCManager
          .HasTag(
            AIBehaviorScriptBase.GetPuppet(context).GetRecordID(),
            n"Scripted_Patrol"
          )
        && (prevSpawnSys
          .IsEntityRegistered(ScriptExecutionContext.GetOwner(context).GetEntityID()) || AIBehaviorScriptBase.GetPuppet(context).IsCrowd())
    );
  }
}

class HasMeleeWeaponEquippedCondition extends WorkspotCondition {
  protected const func CheckCondition(ent: Entity) -> Bool {
    let items: [wref<ItemObject>];
    let obj = ent as GameObject;
    if !IsDefined(obj) {
      return true;
    } else if !obj.IsNPC() {
      return false;
    } else if !AIActionHelper.GetItemsFromWeaponSlots(obj, items) {
      return false;
    }
    let transactionSystem = GameInstance.GetTransactionSystem(obj.GetGame());
    let i = 0;
    while i < ArraySize(items) {
      if transactionSystem.HasTag(obj, n"MeleeWeapon", items[i].GetItemID()) {
        return true;
      }
      i += 1;
    }
    return false;
  }
}

