  protected cb func OnGameAttached() -> Bool {
    super.OnGameAttached();
    this.CreateLightSettings();
    this.UpdateDeviceState();
  }

  protected func ResolveGameplayState() {
    this.m_animFeatureDoor = new AnimFeatureDoor();
    this.m_animFeatureDoor.m_openingType = EnumInt(this.m_doorOpeningType);
    super.ResolveGameplayState();
  }

  protected func ResolveIllegalAction(executor: GameObject, duration: Float) {
    super.ResolveIllegalAction(executor, duration);
    if this.IsConnectedToSecuritySystem() {
      this
        .GetDevicePS()
        .TriggerSecuritySystemNotification(
          executor,
          this.GetWorldPosition(),
          ESecurityNotificationType.ILLEGAL_ACTION
        );
    }
  }

  protected cb func OnDetach() -> Bool {
    super.OnDetach();
  }

  public const func GetDevicePS() -> DoorControllerPS {
    return this.GetController().GetPS();
  }

  private const func GetController() -> DoorController {
    return this.m_controller as DoorController;
  }

  protected cb func OnPersitentStateInitialized(evt: GameAttachedEvent) -> Bool {
    super.OnPersitentStateInitialized(evt);
    this.SetAppearance();
  }

  private final func UpdateLight() {
    let ps = this.GetDevicePS();
    if ps.IsSealed() || ps.IsDisabled() {
      this.TurnLightsOff();
    } else if this.RedLightCondition() {
      this.SetColor(this.m_colors.red);
    } else {
      this.SetColor(this.m_colors.green);
    }
    if NotEquals(ps.GetDoorAuthorizationSide(), EDoorSkillcheckSide.BOTH)
      && (Equals(this.GetDoorTriggerSide(this.GetPlayerEntity()), EDoorTriggerSide.OUTSIDE) || !ps.IsUserAuthorized(ps.GetPlayerEntityID())) {
      this.ChangeHalfLights();
    } else if ps.IsSkillCheckActive() && NotEquals(ps.GetDoorSkillcheckSide(), EDoorSkillcheckSide.BOTH) {
      this.ChangeHalfLights();
    }
  }

  private final func RedLightCondition() -> Bool {
    let ps = this.GetDevicePS();
    if ps.IsLocked() {
      return true;
    }
    if !ps.IsUserAuthorized(ps.GetPlayerEntityID()) && Equals(ps.GetDoorAuthorizationSide(), EDoorSkillcheckSide.BOTH) {
      return true;
    }
    if ps.IsSkillCheckActive() && Equals(ps.GetDoorSkillcheckSide(), EDoorSkillcheckSide.BOTH) {
      return true;
    }
    if ps.IsUnpowered() || ps.IsOFF() {
      return true;
    }
    return false;
  }

  private final func TurnLightsOff() {
    gameLightComponent
      .ChangeLightSettingByRefs(this.m_allActiveLights, this.m_colors.off, 2.0, n"glitch");
  }

  private final func SetColor(lightSettings: ScriptLightSettings) {
    gameLightComponent.ChangeLightSettingByRefs(this.m_allActiveLights, lightSettings);
  }

  protected cb func OnChangeHalfLights(evt: ChangeHalfLights) -> Bool {
    gameLightComponent.ChangeLightSettingByRefs(this.m_activeSkillcheckLights, this.m_colors.red);
  }

  private final func ChangeHalfLights() {
    let evt = new ChangeHalfLights();
    this.QueueEvent(evt);
  }

  protected func UpdateDeviceState(opt isDelayed: Bool) -> Bool {
    if super.UpdateDeviceState(isDelayed) {
      if this.IsInitialized() {
        if NotEquals(this.m_isVisuallyOpened, this.GetDevicePS().IsOpen()) {
          this.MoveDoor(this.GetDevicePS().IsOpen(), false);
        }
        this.UpdateLightByTask();
        this.RefreshUI(isDelayed);
        this.EvaluateOffMeshLinks();
      }
      return true;
    }
    return false;
  }

  protected func RestoreDeviceState() {
    this.MoveDoor(this.GetDevicePS().IsOpen(), true);
    super.RestoreDeviceState();
  }

  protected func ApplyReplicatedState(const state: DeviceReplicatedState) {
    super.ApplyReplicatedState(state);
    let doorState = state as DoorReplicatedState;
    if NotEquals(doorState.m_isOpen, this.m_isVisuallyOpened) {
      this.MoveDoor(doorState.m_isOpen, doorState.m_wasImmediateChange);
    }
  }

  protected final func AccessGrantedNotification() {
    let notification = new AuthorisationNotificationEvent();
    notification.type = gameuiAuthorisationNotificationType.AccessGranted;
    let player = this.GetPlayerMainObject() as PlayerPuppet;
    player.QueueEvent(notification);
  }

  protected cb func OnPay(evt: Pay) -> Bool {
    this.AccessGrantedNotification();
  }

  protected func DeactivateDevice() {
    super.DeactivateDevice();
    this.m_animationController.Toggle(false);
  }

  protected func ActivateDevice() {
    super.ActivateDevice();
    if this.ShouldRegisterToHUD() {
      this.RegisterToHUDManagerByTask(true);
    } else if IsDefined(this.m_animationController) {
      this.m_animationController.Toggle(true);
    }
  }

  protected cb func OnAreaEnter(evt: AreaEnteredEvent) -> Bool {
    if IsClient() {
      super.OnAreaEnter(evt);
      return false;
    }
    let activator = EntityGameInterface.GetEntity(evt.activator) as GameObject;
    let npcActivator = activator as NPCPuppet;
    let ps = this.GetDevicePS();
    super.OnAreaEnter(evt);
    if !this.m_wasVisible {
      this.ResolveGameplayState();
      this.m_wasVisible = true;
    } else if activator.IsPlayer() {
      if Equals(evt.componentName, n"SideOne") {
        this.SetNewDoorType(ps.GetDoorTypeSideOne());
        ps.SetTriggerSide(EDoorTriggerSide.ONE);
      } else if Equals(evt.componentName, n"SideTwo") {
        this.SetNewDoorType(ps.GetDoorTypeSideTwo());
        ps.SetTriggerSide(EDoorTriggerSide.TWO);
      }
      this.EvaluateOffMeshLinks();
    } else if NotEquals(evt.componentName, n"trigger") || ps.IsOpen() || ps.IsSealed() {
      return false;
    } else if activator.IsPlayer() {
      let authorizedActivator = this.ClosestAuthorizedActiveEntityNearby();
      if Equals(ps.GetDoorType(), EDoorType.REMOTELY_CONTROLLED) && !ps.IsLiftDoor() {
        return false;
      } else if ps.IsDeviceSecured() && ps.IsTriggerValid(ps.GetDoorAuthorizationSide()) {
        if authorizedActivator != null && authorizedActivator.IsPlayer() {
          if !ps.WasPlayerAuthorized() {
            this.AccessGrantedNotification();
            ps.UpdatePlayerAuthorization();
          } else if ps.IsLocked() {
            this
              .ToggleDoorLockState(authorizedActivator, Equals(ps.GetDoorType(), EDoorType.AUTOMATIC));
          } else if Equals(ps.GetDoorType(), EDoorType.AUTOMATIC) && ps.IsLogicallyClosed() {
            this.ToggleDoorOpeningState(authorizedActivator);
          }
        }
      } else if !ps.IsLiftDoor()
        && Equals(ps.GetDoorType(), EDoorType.AUTOMATIC)
        || ps.IsLiftDoorAndAtThisFloor() {
        if ps.IsLogicallyClosed() || authorizedActivator != null {
          if ps.HasAnySkillCheckActive() {
            if !ps.IsTriggerValid(ps.GetDoorSkillcheckSide()) {
              this.ToggleDoorOpeningState(activator);
            }
          }
          this.ToggleDoorOpeningState(activator);
        }
      }
    } else if IsDefined(npcActivator) {
      if !ScriptedPuppet.IsActive(activator) {
        return false;
      }
      switch this.GetDoorTriggerSide(npcActivator) {
        case EDoorTriggerSide.ONE:
          let oppositeArea = this.m_triggerSideTwo;
        case EDoorTriggerSide.TWO:
          oppositeArea = this.m_triggerSideOne;
      }
      oppositeArea = null;
      if IsDefined(oppositeArea) && ps.IsLogicallyClosed() {
        if !this.m_wasVisible {
          this.m_wasVisible = true;
          this.ResolveGameplayState();
        }
        let approachingEvent = new AIApproachingAreaEvent();
        approachingEvent.areaComponent = oppositeArea;
        approachingEvent.responseTarget = this;
        npcActivator.QueueEvent(approachingEvent);
        return true;
      } else if this
        .HasValidOpeningToken(EntityGameInterface.GetEntity(evt.activator).GetEntityID()) {
        this.ToggleDoorOpeningState(activator);
      }
    }
  }

  protected cb func OnAreaExit(evt: AreaExitedEvent) -> Bool {
    let doorPS = this.GetDevicePS();
    if doorPS.IsLiftDoor() {
      if this.IsPlayerInsideLift() {
        return false;
      }
    }
    doorPS.SetTriggerSide(this.GetDoorTriggerSide(this.GetPlayerEntity()));
    if Equals(evt.componentName, n"trigger") {
      let npcActivator = EntityGameInterface.GetEntity(evt.activator) as NPCPuppet;
      if IsDefined(npcActivator) {
        let approachingEvent = new AIApproachingAreaEvent();
        approachingEvent.responseTarget = this;
        approachingEvent.isApproachCancellation = true;
        npcActivator.QueueEvent(approachingEvent);
      } else if NotEquals(evt.componentName, n"trigger") || !doorPS.IsOpen() || !doorPS.IsClosingAutomatically() || !doorPS.IsON() {
        return false;
      }
    }
    let activator = EntityGameInterface.GetEntity(evt.activator) as GameObject;
    let e = new DoorTriggerDelayedEvent();
    e.activator = activator;
    if IsDefined(EntityGameInterface.GetEntity(evt.activator) as ScriptedPuppet) && !this.IsSomeoneAuthorizedNearby() {
      GameInstance
        .GetDelaySystem(this.GetGame())
        .DelayEvent(this, e, this.m_automaticCloseDelay);
    }
  }

  protected final func IsPlayerInsideLift() -> Bool {
    let blackboardSystem = GameInstance.GetBlackboardSystem(this.GetGame());
    let blackboard = blackboardSystem
      .GetLocalInstanced(
        GameInstance
          .GetPlayerSystem(this.GetGame())
          .GetLocalPlayerControlledGameObject()
          .GetEntityID(),
        GetAllBlackboardDefs().PlayerStateMachine
      );
    return blackboard.GetBool(GetAllBlackboardDefs().PlayerStateMachine.IsPlayerInsideElevator);
  }

  protected cb func OnApproachingAreaResponseEvent(evt: AIApproachingAreaResponseEvent) -> Bool {
    if evt.isPassingThrough && this.GetDevicePS().IsLogicallyClosed() {
      let sender = evt.sender as GameObject;
      if IsDefined(sender) {
        this.ToggleDoorOpeningState(sender);
      }
    }
  }

  private final func GenerateInternalContext(opt activator: GameObject) -> GetActionsContext {
    return this
      .GetDevicePS()
      .GenerateContext(
        gamedeviceRequestType.Internal,
        Device.GetInteractionClearance(),
        activator,
        this.GetEntityID()
      );
  }

  private final func HasValidOpeningToken(id: EntityID) -> Bool {
    let tokensList = this.GetDevicePS().GetOpeningTokensList();
    let i = 0;
    while i < ArraySize(tokensList) {
      if tokensList[i] == id {
        return true;
      }
      i += 1;
    }
    return false;
  }

  protected cb func OnDoorTriggerDelayedEvent(evt: DoorTriggerDelayedEvent) -> Bool {
    if !this.IsSomeoneAuthorizedNearby() && this.GetDevicePS().IsOpen() {
      this.CloseDoor();
    }
  }

  protected final func IsSomeoneAuthorizedNearby() -> Bool {
    return this.ClosestAuthorizedActiveEntityNearby() != null;
  }

  protected final func ClosestAuthorizedActiveEntityNearby() -> GameObject {
    let usersToAuthorize = this.m_triggerComponent.GetOverlappingEntities();
    let ps = this.GetDevicePS();
    let i = 0;
    while i < ArraySize(usersToAuthorize) {
      if ScriptedPuppet.IsActive(usersToAuthorize[i] as GameObject) && ps.IsUserAuthorized(usersToAuthorize[i].GetEntityID()) {
        if IsDefined(usersToAuthorize[i] as PlayerPuppet) && ps.IsDeviceSecured() {
          this
            .RefreshInteraction(gamedeviceRequestType.Direct, GetPlayer(this.GetGame()));
          if ps.IsTriggerValid(ps.GetDoorAuthorizationSide()) {
            this.UpdateDeviceState();
            ps.ResolveSkillchecks();
          }
        }
        this.NotifyParents();
        return usersToAuthorize[i] as GameObject;
      }
      i += 1;
    }
    return null;
  }

  protected cb func OnAuthorizeUser(evt: AuthorizeUser) -> Bool {
    if this
      .GetDevicePS()
      .UserAuthorizationAttempt(evt.GetExecutor().GetEntityID(), evt.GetEnteredPassword()) {
      this.AccessGrantedNotification();
    }
    this.UpdateDeviceState();
  }

  protected final func IsSomeoneInTrigger() -> Bool {
    if this.m_triggerComponent.GetNumberOverlappingActivators() == 0 {
      return false;
    }
    return true;
  }

  protected cb func OnForceUnlockAndOpenElevator(evt: ForceUnlockAndOpenElevator) -> Bool {
    if this.IsSomeoneAuthorizedNearby() {
      this.OpenDoor();
    }
  }

  protected cb func OnToggleOpen(evt: ToggleOpen) -> Bool {
    if Equals(this.m_doorOpeningType, EDoorOpeningType.HINGED) && Equals(this.GetDevicePS().GetDoorState(), EDoorStatus.OPENED) {
      this.m_doorTriggerSide = this.GetDoorTriggerSide(this.GetPlayerEntity());
    }
    this.m_whoOpened = evt.GetExecutor();
    if evt.IsIllegal() {
      this.m_illegalOpen = true;
    }
    this.UpdateDeviceState();
  }

  protected cb func OnActionDemolition(evt: ActionDemolition) -> Bool {
    if evt.IsCompleted() {
      return false;
    }
    this.m_whoOpened = evt.GetExecutor();
    this.m_openedUsingForce = true;
    this.m_audioForceOpen = true;
    if evt.IsIllegal() {
      this.m_illegalOpen = true;
    } else if NotEquals(this.m_animationType, EAnimationType.REGULAR) {
      this.UpdateDeviceState();
      return true;
    }
    let playerPuppet = GameInstance.GetPlayerSystem(this.GetGame()).GetLocalPlayerControlledGameObject() as ScriptedPuppet;
    this.m_doorTriggerSide = this.GetDoorTriggerSide(this.GetPlayerEntity());
    this.DisableOccluder();
    if Equals(this.m_doorTriggerSide, EDoorTriggerSide.ONE) {
      this.EnterWorkspot(playerPuppet, false, n"playerWorkspot", n"deviceWorkspot");
    } else if Equals(this.m_doorTriggerSide, EDoorTriggerSide.TWO) {
      this
        .EnterWorkspot(playerPuppet, false, n"playerWorkspotFlip", n"deviceWorkspotFlip");
    }
    this.UpdateDeviceState();
  }

  protected cb func OnActionEngineering(evt: ActionEngineering) -> Bool {
    if !evt.IsCompleted() {
      return false;
    }
    this.m_whoOpened = evt.GetExecutor();
    if evt.IsIllegal() {
      this.m_illegalOpen = true;
    } else if NotEquals(this.m_animationType, EAnimationType.REGULAR) {
      this.UpdateDeviceState();
      return true;
    }
    this.m_doorTriggerSide = this.GetDoorTriggerSide(this.GetPlayerEntity());
    this.DisableOccluder();
    if Equals(this.m_doorTriggerSide, EDoorTriggerSide.ONE) {
    } else if Equals(this.m_doorTriggerSide, EDoorTriggerSide.TWO) {
    }
    this.UpdateDeviceState();
  }

  protected cb func OnToggleLock(evt: ToggleLock) -> Bool {
    this.PlayLockSound(this.GetDevicePS().IsLocked());
    if this.GetDevicePS().IsLocked() && this.GetDevicePS().IsOpen() {
      this.CloseDoor();
    } else if this.IsSomeoneAuthorizedNearby() && this.GetDevicePS().IsLogicallyClosed() && evt.ShouldOpen() {
      this.OpenDoor();
    }
    this.UpdateDeviceState();
  }

  protected cb func OnQuestForceUnlock(evt: QuestForceUnlock) -> Bool {
    if Equals(this.GetDevicePS().GetDoorType(), EDoorType.AUTOMATIC) && this.IsSomeoneAuthorizedNearby() && this.GetDevicePS().IsLogicallyClosed() {
      this.OpenDoor();
    }
    this.UpdateDeviceState();
  }

  protected cb func OnQuestForceUnseal(evt: QuestForceUnseal) -> Bool {
    if Equals(this.GetDevicePS().GetDoorType(), EDoorType.AUTOMATIC) && this.IsSomeoneAuthorizedNearby() && this.GetDevicePS().IsLogicallyClosed() {
      this.OpenDoor();
    }
    this.UpdateDeviceState();
  }

  protected cb func OnSealDoor(evt: ToggleSeal) -> Bool {
    this.UpdateDeviceState();
    if this.GetDevicePS().IsSealed() && this.GetDevicePS().IsOpen() {
      this.CloseDoor();
    } else if this.IsSomeoneAuthorizedNearby() && this.GetDevicePS().IsLogicallyClosed() {
      this.OpenDoor();
    }
  }

  protected cb func OnDoorOpeningToken(evt: DoorOpeningToken) -> Bool {
    this.UpdateDeviceState();
    if this.IsSomeoneAuthorizedNearby() && this.GetDevicePS().IsLogicallyClosed() {
      this.OpenDoor();
    }
  }

  protected cb func OnSetAuthorizationModuleOFF(evt: SetAuthorizationModuleOFF) -> Bool {
    this.UpdateDeviceState();
    if this.IsSomeoneAuthorizedNearby() && this.GetDevicePS().IsLogicallyClosed() {
      this.OpenDoor();
    }
  }

  protected cb func OnActivateDevice(evt: ActivateDevice) -> Bool {
    this.UpdateDeviceState();
  }

  protected cb func OnForceOpen(evt: ForceOpen) -> Bool {
    this.m_whoOpened = evt.GetExecutor();
    if evt.IsIllegal() {
      this.m_illegalOpen = true;
    }
    this.m_openedUsingForce = true;
    this.UpdateDeviceState();
  }

  protected cb func OnQuestForceClose(evt: QuestForceClose) -> Bool {
    this.MoveDoor(false, false, evt.GetValue());
  }

  protected cb func OnQuestForceCloseImmediate(evt: QuestForceCloseImmediate) -> Bool {
    this.EnablePlayerBlocker();
    this.MoveDoor(this.GetDevicePS().IsOpen(), false);
  }

  protected final func EnablePlayerBlocker() {
    if IsDefined(this.m_playerBlocker) && !this.m_playerBlocker.IsEnabled() {
      this.m_playerBlocker.Toggle(true);
    }
  }

  protected final func DisablePlayerBlocker() {
    if IsDefined(this.m_playerBlocker) && this.m_playerBlocker.IsEnabled() {
      this.m_playerBlocker.Toggle(false);
    }
  }

  protected cb func OnQuestForceOpenScene(evt: QuestForceOpenScene) -> Bool {
    this.MoveDoor(this.GetDevicePS().IsOpen(), true);
  }

  protected cb func OnQuestForceCloseScene(evt: QuestForceCloseScene) -> Bool {
    this.MoveDoor(this.GetDevicePS().IsOpen(), true);
  }

  protected cb func OnQuestForceEnabled(evt: QuestForceEnabled) -> Bool {
    this.ActivateDevice();
    this.UpdateDeviceState();
  }

  private final func ToggleDoorOpeningState(opt forWhom: EntityID) {
    let context = this.GenerateInternalContext();
    let action = this.GetDevicePS().GetActionByName(n"ToggleOpen", context);
    if this.GetDevicePS().IsLogicallyClosed() {
      this.GetDevicePS().DepleteToken(forWhom);
    } else if IsDefined(action) {
      this.ExecuteAction(action);
    }
  }

  private final func ToggleDoorOpeningState(activator: GameObject) {
    this.m_whoOpened = activator;
    let action = this.GetDevicePS().ActionToggleOpen();
    if this.GetDevicePS().IsLogicallyClosed() {
      this.GetDevicePS().DepleteToken(activator.GetEntityID());
    } else if IsDefined(action) {
      this.ExecuteAction(action, activator);
    }
  }

  private final func OpenDoor() {
    let action = this.GetDevicePS().ActionSetOpened();
    if IsDefined(action) {
      this.ExecuteAction(action);
    }
  }

  private final func CloseDoor() {
    let action = this.GetDevicePS().ActionSetClosed();
    if IsDefined(action) {
      this.ExecuteAction(action);
    }
  }

  private final func ToggleDoorLockState(activator: GameObject, shouldOpen: Bool) {
    let context = this.GenerateInternalContext(activator);
    this.m_whoOpened = context.processInitiatorObject;
    let action = this.GetDevicePS().GetActionByName(n"ToggleLock", context) as ToggleLock;
    action.SetShouldOpen(shouldOpen);
    if IsDefined(action) {
      this.ExecuteAction(action);
    }
  }

  protected cb func OnCollision(evt: HitCharacterControllerEvent) -> Bool {
    this.GetDevicePS().OnDoorCollision();
  }

  private final func MoveDoor(shouldBeOpened: Bool, immediate: Bool, opt movingSpeedMultiplier: Float) -> Bool {
    let reactionData: stimInvestigateData;
    let deviceBusy = new SetBusyEvent();
    let ps = this.GetDevicePS();
    ps.SetIsBusy(true);
    if movingSpeedMultiplier == 0.0 {
      movingSpeedMultiplier = 1.0;
    }
    let movingTime = this.GetOpeningTime() / movingSpeedMultiplier;
    if Equals(this.m_animationType, EAnimationType.REGULAR) {
      this.RefreshAnimOpenDoor(shouldBeOpened, immediate, movingSpeedMultiplier);
    } else {
      this
        .RefreshTransformAnimOpenDoor(shouldBeOpened, immediate, movingSpeedMultiplier);
    }
    GameInstance.GetDelaySystem(this.GetGame()).DelayEvent(this, deviceBusy, movingTime);
    if !immediate {
      this.PlayDoorMovementSound(shouldBeOpened, this.m_audioForceOpen);
    }
    this.UpdatePortalLights(shouldBeOpened);
    if shouldBeOpened {
      GameInstance.GetAudioSystem(this.GetGame()).OpenAcousticPortal(this);
      this.DisableOccluder();
      this.DisablePlayerBlocker();
    } else {
      GameInstance.GetAudioSystem(this.GetGame()).CloseAcousticPortal(this);
      if immediate {
        this.EnableOccluderInstanly();
      } else {
        this.EnableOccluderWithDelay(movingTime);
        if ps.IsLocked() {
          this.EnablePlayerBlocker();
        }
      }
    }
    if shouldBeOpened && IsDefined(this.m_whoOpened) && this.m_whoOpened.IsPlayer() {
      if this.m_illegalOpen {
        reactionData.illegalAction = true;
        this.m_illegalOpen = false;
      }
      let broadcaster = this.GetStimBroadcasterComponent();
      this.TriggerMoveDoorStimBroadcaster(broadcaster, reactionData);
    }
    this.m_openedUsingForce = false;
    this.m_audioForceOpen = false;
    this.m_isVisuallyOpened = shouldBeOpened;
    let replicatedState = this.GetServerState() as DoorReplicatedState;
    if IsDefined(replicatedState) {
      replicatedState.m_isOpen = this.m_isVisuallyOpened;
      replicatedState.m_wasImmediateChange = immediate;
    }
    this.UpdateDeviceState();
    this.RefreshInteraction(gamedeviceRequestType.Direct, GetPlayer(this.GetGame()));
    this.NotifyParents();
    return true;
  }

  protected func TriggerMoveDoorStimBroadcaster(broadcaster: StimBroadcasterComponent, reactionData: stimInvestigateData) {
    if IsDefined(broadcaster) {
      if this.m_openedUsingForce {
        broadcaster
          .TriggerSingleBroadcast(
            this,
            gamedataStimType.OpeningDoor,
            this.m_forceOpeningAudioStimRange,
            reactionData
          );
      } else {
        broadcaster
          .AddActiveStimuli(
            this,
            gamedataStimType.OpeningDoor,
            2.0,
            this.m_forceOpeningAudioStimRange,
            reactionData,
            true
          );
        broadcaster
          .TriggerSingleBroadcast(
            this,
            gamedataStimType.OpeningDoor,
            this.m_openingAudioStimRange,
            reactionData
          );
      }
    }
  }

  protected func GetOpeningTime() -> Float {
    return this.GetDevicePS().GetOpeningTime();
  }

  protected cb func OnSetBusyEvent(evt: SetBusyEvent) -> Bool {
    this.GetDevicePS().SetIsBusy(false);
    this.UpdateDeviceState();
    this.RefreshInteraction(gamedeviceRequestType.Direct, GetPlayer(this.GetGame()));
    this.NotifyParents();
  }

  protected final func DisableOccluder() {
    if IsDefined(this.m_occluder) {
      this.m_occluder.Toggle(false);
    }
  }

  protected final func EnableOccluderWithDelay(delay: Float) {
    let e = new OccluderEnableEvent();
    GameInstance.GetDelaySystem(this.GetGame()).DelayEvent(this, e, delay);
  }

  protected final func EnableOccluderInstanly() {
    if IsDefined(this.m_occluder) {
      this.m_occluder.Toggle(true);
    }
  }

  protected cb func OnOccluderEnable(evt: OccluderEnableEvent) -> Bool {
    if this.GetDevicePS().IsClosed() {
      this.EnableOccluderInstanly();
      this.DisablePlayerBlocker();
    }
  }

  protected final func UpdatePortalLights(on: Bool) {
    if IsDefined(this.m_portalLight1) && this.m_portalLight1.IsEnabled() {
      this.m_portalLight1.ToggleLight(on);
    } else if IsDefined(this.m_portalLight2) && this.m_portalLight2.IsEnabled() {
      this.m_portalLight2.ToggleLight(on);
    } else if IsDefined(this.m_portalLight3) && this.m_portalLight3.IsEnabled() {
      this.m_portalLight3.ToggleLight(on);
    } else if IsDefined(this.m_portalLight4) && this.m_portalLight4.IsEnabled() {
      this.m_portalLight4.ToggleLight(on);
    }
  }

  protected func EnterWorkspot(
    activator: GameObject,
    opt freeCamera: Bool,
    opt componentName: CName,
    opt deviceData: CName
  ) {
    let workspotSystem = GameInstance.GetWorkspotSystem(activator.GetGame());
    if IsDefined(workspotSystem) && activator.IsPlayer() {
      this.m_workspotActivator = activator;
      this.m_componentName = componentName;
      workspotSystem
        .PlayInDeviceSimple(
          this,
          activator,
          freeCamera,
          componentName,
          deviceData,
          n"None",
          0.5,
          WorkspotSlidingBehaviour.DontPlayAtResourcePosition,
          this
        );
    }
  }

  protected cb func OnPlayInDeviceCallbackEvent(evt: PlayInDeviceCallbackEvent) -> Bool {
    if evt.wasPlayInDeviceSuccessful {
      this.m_playerInWorkspot = this.m_workspotActivator as PlayerPuppet;
      let playerStateMachineBlackboard = GameInstance
        .GetBlackboardSystem(this.GetGame())
        .GetLocalInstanced(
          this.m_playerInWorkspot.GetEntityID(),
          GetAllBlackboardDefs().PlayerStateMachine
        );
      playerStateMachineBlackboard
        .SetBool(GetAllBlackboardDefs().PlayerStateMachine.IsInteractingWithDevice, true);
      this.m_interaction.Toggle(false);
      if Equals(this.m_componentName, n"playerWorkspot") || Equals(this.m_componentName, n"playerWorkspotFlip") {
        playerStateMachineBlackboard
          .SetBool(GetAllBlackboardDefs().PlayerStateMachine.IsForceOpeningDoor, true);
      }
    }
  }

  protected cb func OnWorkspotFinished(componentName: CName) -> Bool {
    super.OnWorkspotFinished(componentName);
    this.m_interaction.Toggle(true);
    if IsDefined(this.m_playerInWorkspot) {
      let playerStateMachineBlackboard = GameInstance
        .GetBlackboardSystem(this.GetGame())
        .GetLocalInstanced(
          this.m_playerInWorkspot.GetEntityID(),
          GetAllBlackboardDefs().PlayerStateMachine
        );
      playerStateMachineBlackboard
        .SetBool(GetAllBlackboardDefs().PlayerStateMachine.IsForceOpeningDoor, false);
      this.m_playerInWorkspot = null;
    }
  }

  protected func SetIsDoorInteractionActiveBB(evt: InteractionActivationEvent, isActive: Bool) {
    super.SetIsDoorInteractionActiveBB(evt, isActive);
  }

  protected final func PlayLockSound(toLock: Bool);

  protected final func PlayDoorSealSound(toSeal: Bool) {
    if toSeal {
    }
  }

  protected final func PlayDoorMovementSound(shouldBeOpened: Bool, wasOpenedUsingForce: Bool) {
    if shouldBeOpened {
      if wasOpenedUsingForce {
        GameObject.PlayMetadataEvent(this, n"force_open");
      } else {
        this.PlayOpenDoorSound();
      }
    } else {
      GameObject.PlayMetadataEvent(this, n"close");
    }
  }

  protected func PlayOpenDoorSound() {
    GameObject.PlayMetadataEvent(this, n"open");
  }

  protected func ExecuteDeviceStateOperation() {
    super.ExecuteDeviceStateOperation();
    let ps = this.GetDevicePS();
    let state = ps.GetDoorState();
    if ps.GetDeviceOperationsContainer() != null {
      ps.GetDeviceOperationsContainer().EvaluateDoorStateTriggers(state, this);
    }
  }

  private final func RefreshAnimOpenDoor(shouldBeOpened: Bool, immediate: Bool, animSpeedMultiplier: Float) {
    if !IsDefined(this.m_animFeatureDoor) {
      this.m_animFeatureDoor = new AnimFeatureDoor();
    }
    this.m_animFeatureDoor.m_openingSpeed = this.GetOpeningSpeed() * animSpeedMultiplier;
    this.m_animFeatureDoor.m_malfunctioning = 0;
    if shouldBeOpened && this.m_animFeatureDoor.m_progress == 0.0 {
      this.SetupOpenDoorAnimationFeatures();
    } else if !shouldBeOpened && this.m_animFeatureDoor.m_progress == 1.0 {
      this.m_animFeatureDoor.m_progress = 0.0;
    }
    this.m_animFeatureDoor.m_doorSide = this.m_lastDoorSide;
    if immediate {
      this.m_animFeatureDoor.m_openingSpeed *= 1000.0;
    }
    AnimationControllerComponent.ApplyFeature(this, n"door", this.m_animFeatureDoor);
  }

  protected func SetupOpenDoorAnimationFeatures() {
    this.m_animFeatureDoor.m_progress = 1.0;
    this.m_lastDoorSide = EnumInt(this.GetDoorTriggerSide(this.GetPlayerEntity()));
  }

  protected func GetOpeningSpeed() -> Float {
    let openingSpeed = this.GetDevicePS().GetOpeningSpeed();
    return openingSpeed == 0.0 ? 1.0 : openingSpeed;
  }

  private final func RefreshTransformAnimOpenDoor(shouldBeOpened: Bool, immediate: Bool, animSpeedMultiplier: Float) {
    let openingSpeed = this.GetOpeningSpeed() * animSpeedMultiplier;
    let animName = this.GetProperTransformAnimName();
    if !immediate {
      let playEvent = new gameTransformAnimationPlayEvent();
      playEvent.animationName = animName;
      playEvent.looping = false;
      playEvent.timesPlayed = 1u;
      playEvent.timeScale = openingSpeed;
      if shouldBeOpened && !this.m_isVisuallyOpened {
        this.QueueEvent(playEvent);
      } else if !shouldBeOpened && this.m_isVisuallyOpened {
        if Equals(this.m_animationType, EAnimationType.TRANSFORM) {
          playEvent.timeScale = openingSpeed * -1.0;
        } else {
          this.QueueEvent(playEvent);
        }
      }
    } else if shouldBeOpened {
      let skipEvent = new gameTransformAnimationSkipEvent();
      skipEvent.animationName = animName;
      skipEvent.skipToEnd = true;
      skipEvent.forcePlay = true;
      this.QueueEvent(skipEvent);
    } else {
      let resetEvent = new gameTransformAnimationResetEvent();
      resetEvent.animationName = animName;
      this.QueueEvent(resetEvent);
    }
  }

  private final func GetProperTransformAnimName() -> CName {
    switch this.m_doorOpeningType {
      case EDoorOpeningType.SLIDING_HORIZONTALLY:
        return n"doorSlideHorizontally";
      case EDoorOpeningType.SLIDING_VERTICALLY:
        return n"doorSlideVertically";
      case EDoorOpeningType.HINGED:
        if Equals(this.m_animationType, EAnimationType.TRANSFORM_TWO_SIDES) && Equals(this.m_doorTriggerSide, EDoorTriggerSide.ONE) {
          return n"doorOpenHingedBack";
        }
        return n"doorOpenHinged";
    }
    return n"None";
  }

  protected final func SetNewDoorType(type: EDoorType) {
    this.GetDevicePS().SetNewDoorType(type);
  }

  protected cb func OnSetDoorType(evt: SetDoorType) -> Bool {
    this.GetDevicePS().SetNewDoorType(evt);
  }

  protected cb func OnSetCloseItself(evt: SetCloseItself) -> Bool {
    this.GetDevicePS().SetCloseItself(evt.automaticallyClosesItself);
  }

  protected cb func OnResetDoorState(evt: ResetDoorState) -> Bool {
    this.GetDevicePS().ResetToDefault();
  }

  protected final func GetDoorTriggerSide(forEntity: Entity) -> EDoorTriggerSide {
    if !IsDefined(forEntity) {
      return EDoorTriggerSide.OUTSIDE;
    } else if this.m_triggerSideOne.IsEntityOverlapping(forEntity) {
      return EDoorTriggerSide.ONE;
    } else if this.m_triggerSideTwo.IsEntityOverlapping(forEntity) {
      return EDoorTriggerSide.TWO;
    }
    return EDoorTriggerSide.OUTSIDE;
  }

  protected final func GetPlayerEntity() -> Entity {
    return EntityGameInterface.GetEntity(this.GetPlayerMainObject().GetEntity());
  }

  protected final func CreateLightSettings() {
    this.m_colors.off.strength = 0.0;
    this.m_colors.off.color = new Color(0u, 0u, 0u, 0u);
    this.m_colors.red.strength = 1.0;
    this.m_colors.red.color = new Color(130u, 0u, 0u, 0u);
    this.m_colors.green.strength = 1.0;
    this.m_colors.green.color = new Color(25u, 135u, 0u, 255u);
  }

  protected func SetSoloAppearance() {
    if IsDefined(this.m_strongSoloFrame) {
      if this.GetDevicePS().WasDemolitionSkillCheckActive() {
        if this.m_strongSoloFrame.IsEnabled() {
          this.m_strongSoloFrame.Toggle(false);
        }
      } else if !this.m_strongSoloFrame.IsEnabled() {
        this.m_strongSoloFrame.Toggle(true);
      }
    }
  }

  private final func SetTechieAppearance() {
    if IsDefined(this.m_terminalTechie1) {
      if this.GetDevicePS().WasEngineeringSkillCheckActive() && this.GetDevicePS().IsSideOneActive() {
        if !this.m_terminalTechie1.IsEnabled() {
          this.m_terminalTechie1.Toggle(true);
        }
      } else if this.m_terminalTechie1.IsEnabled() {
        this.m_terminalTechie1.Toggle(false);
      } else if IsDefined(this.m_ledTechie1) {
        this.m_ledTechie1.Toggle(false);
      }
    } else if IsDefined(this.m_terminalTechie2) {
      if this.GetDevicePS().WasEngineeringSkillCheckActive() && this.GetDevicePS().IsSideTwoActive() {
        if !this.m_terminalTechie2.IsEnabled() {
          this.m_terminalTechie2.Toggle(true);
        }
      } else if this.m_terminalTechie2.IsEnabled() {
        this.m_terminalTechie2.Toggle(false);
      } else if IsDefined(this.m_ledTechie2) {
        this.m_ledTechie2.Toggle(false);
      }
    }
  }

  private final func SetNetrunnerAppearance() {
    if IsDefined(this.m_terminalNetrunner1) {
      if this.IsConnectedToBackdoorDevice() || this.GetDevicePS().ExposeQuickHakcsIfNotConnnectedToAP() {
        if !this.m_terminalNetrunner1.IsEnabled() {
          this.m_terminalNetrunner1.Toggle(true);
        }
      } else if this.m_terminalNetrunner1.IsEnabled() {
        this.m_terminalNetrunner1.Toggle(false);
      } else if IsDefined(this.m_ledNetrunner1) {
        this.m_ledNetrunner1.Toggle(false);
      }
    } else if IsDefined(this.m_terminalNetrunner2) {
      if this.IsConnectedToBackdoorDevice() || this.GetDevicePS().ExposeQuickHakcsIfNotConnnectedToAP() {
        if !this.m_terminalNetrunner2.IsEnabled() {
          this.m_terminalNetrunner2.Toggle(true);
        }
      } else if this.m_terminalNetrunner2.IsEnabled() {
        this.m_terminalNetrunner2.Toggle(false);
      } else if IsDefined(this.m_ledNetrunner2) {
        this.m_ledNetrunner2.Toggle(false);
      }
    }
  }

  protected final func InitializeLight() {
    if Equals(this.GetDevicePS().GetDoorSkillcheckSide(), EDoorSkillcheckSide.ONE)
      || Equals(this.GetDevicePS().GetDoorAuthorizationSide(), EDoorSkillcheckSide.ONE) {
      if IsDefined(this.m_terminalTechie1) && this.m_terminalTechie1.IsEnabled() {
        ArrayPush(this.m_activeSkillcheckLights, this.m_ledTechie1);
      } else if IsDefined(this.m_terminalNetrunner1) && this.m_terminalNetrunner1.IsEnabled() {
        ArrayPush(this.m_activeSkillcheckLights, this.m_ledNetrunner1);
      } else if IsDefined(this.m_led1) {
        ArrayPush(this.m_activeSkillcheckLights, this.m_led1);
      } else if IsDefined(this.m_ledHandle1) {
        ArrayPush(this.m_activeSkillcheckLights, this.m_ledHandle1);
      } else if IsDefined(this.m_ledHandle1a) {
        ArrayPush(this.m_activeSkillcheckLights, this.m_ledHandle1a);
      }
    } else if Equals(this.GetDevicePS().GetDoorSkillcheckSide(), EDoorSkillcheckSide.TWO)
      || Equals(this.GetDevicePS().GetDoorAuthorizationSide(), EDoorSkillcheckSide.TWO) {
      if IsDefined(this.m_terminalTechie2) && this.m_terminalTechie2.IsEnabled() {
        ArrayPush(this.m_activeSkillcheckLights, this.m_ledTechie2);
      } else if IsDefined(this.m_terminalNetrunner2) && this.m_terminalNetrunner2.IsEnabled() {
        ArrayPush(this.m_activeSkillcheckLights, this.m_ledNetrunner2);
      } else if IsDefined(this.m_led2) {
        ArrayPush(this.m_activeSkillcheckLights, this.m_led2);
      } else if IsDefined(this.m_ledHandle2) {
        ArrayPush(this.m_activeSkillcheckLights, this.m_ledHandle2);
      } else if IsDefined(this.m_ledHandle2a) {
        ArrayPush(this.m_activeSkillcheckLights, this.m_ledHandle2a);
      }
    }
    this.GetAllActiveLights();
  }

  protected final func GetAllActiveLights() {
    ArrayPush(this.m_allActiveLights, this.m_led1);
    ArrayPush(this.m_allActiveLights, this.m_led2);
    ArrayPush(this.m_allActiveLights, this.m_ledHandle1);
    ArrayPush(this.m_allActiveLights, this.m_ledHandle2);
    if IsDefined(this.m_ledHandle1a) {
      ArrayPush(this.m_allActiveLights, this.m_ledHandle1a);
    } else if IsDefined(this.m_ledHandle2a) {
      ArrayPush(this.m_allActiveLights, this.m_ledHandle2a);
    } else if IsDefined(this.m_terminalTechie1) && this.m_terminalTechie1.IsEnabled() {
      ArrayPush(this.m_allActiveLights, this.m_ledTechie1);
    } else if IsDefined(this.m_terminalNetrunner1) && this.m_terminalNetrunner1.IsEnabled() {
      ArrayPush(this.m_allActiveLights, this.m_ledNetrunner1);
    } else if IsDefined(this.m_terminalTechie2) && this.m_terminalTechie2.IsEnabled() {
      ArrayPush(this.m_allActiveLights, this.m_ledTechie2);
    } else if IsDefined(this.m_terminalNetrunner2) && this.m_terminalNetrunner2.IsEnabled() {
      ArrayPush(this.m_allActiveLights, this.m_ledNetrunner2);
    }
  }

  public const func DeterminGameplayRole() -> EGameplayRole {
    return EGameplayRole.OpenPath;
  }

  public const func DeterminGameplayRoleMappinVisuaState(const data: script_ref<SDeviceMappinData>) -> EMappinVisualState {
    if !this.GetDevicePS().IsDisabled()
      && this.GetNetworkSystem().QuickHacksExposedByDefault()
      && this.HasAnyActiveQuickHackVulnerabilities() {
      return EMappinVisualState.Available;
    }
    if !this.HasAnySkillCheckActive() {
      if this.GetDevicePS().IsDeviceSecured()
        && !this.GetDevicePS().IsPlayerAuthorized()
        || this.GetDevicePS().IsLocked() && !this.GetDevicePS().canPlayerToggleLockState() {
        if this.CanPassAnySkillCheckOnParentTerminal() {
          return EMappinVisualState.Available;
        }
        return EMappinVisualState.Unavailable;
      }
      return EMappinVisualState.Available;
    }
    if !this.GetDevicePS().IsDisabled() && this.CanPassAnySkillCheckOnParentTerminal() {
      return EMappinVisualState.Available;
    }
    return super.DeterminGameplayRoleMappinVisuaState(data);
  }

  public const func IsActive() -> Bool {
    if this.GetDevicePS().IsSealed() {
      return false;
    }
    return super.IsActive();
  }

  protected func EnableOffMeshConnections(player: Bool, npc: Bool) {
    if this.m_offMeshConnectionComponent != null {
      if player {
        this.m_offMeshConnectionComponent.EnableForPlayer();
      } else if npc {
        this.m_offMeshConnectionComponent.EnableOffMeshConnection();
      }
    }
  }

  protected func DisableOffMeshConnections(player: Bool, npc: Bool) {
    if this.m_offMeshConnectionComponent != null {
      if player {
        this.m_offMeshConnectionComponent.DisableForPlayer();
      } else if npc {
        this.m_offMeshConnectionComponent.DisableOffMeshConnection();
      }
    }
  }

  protected const final func CanPassAnySkillCheckOnParentTerminal() -> Bool {
    let requester = EntityGameInterface.GetEntity(this.GetEntity()) as GameObject;
    return this.GetDevicePS().CanPassAnySkillCheckOnParentTerminal(requester);
  }

  public const final func GetClosingAnimationLength() -> Float {
    return this.m_closingAnimationLength;
  }

  public const final func GetAnimFeature() -> AnimFeatureDoor {
    return this.m_animFeatureDoor;
  }

  public const func IsNetrunner() -> Bool {
    if !this.IsCyberdeckEquippedOnPlayer() {
      return false;
    }
    return this.GetDevicePS().IsHackingSkillCheckActive()
      || (this.IsQuickHacksExposed()
        && this.GetDevicePS().ExposeQuickHakcsIfNotConnnectedToAP()
        || this.IsConnectedToBackdoorDevice()) && this.GetDevicePS().HasPlaystyle(EPlaystyle.NETRUNNER)
      || this.IsActiveBackdoor();
  }

  protected const func HasAnyDirectInteractionActive() -> Bool {
    if this.GetDevicePS().IsDisabled() || this.GetDevicePS().IsSealed() {
      return false;
    }
    return true;
  }
}

class DoorControllerPS extends ScriptableDeviceComponentPS {
  protected persistent let m_doorProperties: DoorSetup;
  protected let m_doorSkillChecks: EngDemoContainer;
  private persistent let m_isOpened: Bool;
  private persistent let m_isLocked: Bool;
  private persistent let m_isSealed: Bool;
  protected let m_alarmRaised: Bool;
  protected let m_isBusy: Bool;
  protected let m_isLiftDoor: Bool;
  protected persistent let m_isPlayerAuthorised: Bool;
  protected persistent let m_openingTokens: [EntityID];

  protected cb func OnInstantiated() -> Bool {
    super.OnInstantiated();
    if !IsStringValid(this.m_deviceName) {
      this.m_deviceName = "Gameplay-Devices-DisplayNames-Door";
    }
  }

  protected func Initialize() {
    super.Initialize();
    this.SetDefaultDoorState();
    this.InitializeDoorTypes();
    this
      .GetPersistencySystem()
      .EntityProxy_DisablePhysics(PersistentID.ExtractEntityID(this.GetID()), this.IsOpen());
  }

  protected func GameAttached() {
    this.m_isLiftDoor = this.CheckIfLiftDoors();
  }

  protected func GetSkillCheckContainerForSetup() -> BaseSkillCheckContainer {
    return this.m_doorSkillChecks;
  }

  public const func IsStatic() -> Bool {
    if this.IsSealed() && !this.canPlayerToggleSealState() {
      return true;
    }
    if this.IsLocked()
      && !this.IsAuthorizationValid()
      && !this.canPlayerToggleLockState()
      && !this.HasAnySkillCheckActive()
      && !this.CanCreateAnyQuickHackActions() {
      return true;
    }
    return false;
  }

  public const final func IsClosingAutomatically() -> Bool {
    return this.m_doorProperties.m_automaticallyClosesItself;
  }

  public const final func GetOpeningTokensList() -> [EntityID] {
    return this.m_openingTokens;
  }

  public const final func IsOpen() -> Bool {
    return this.m_isOpened;
  }

  public const final func IsLogicallyClosed() -> Bool {
    return !this.IsOpen() && !this.IsLocked() && !this.IsSealed();
  }

  public const final func IsClosed() -> Bool {
    return !this.IsOpen();
  }

  public const final func IsLocked() -> Bool {
    return this.m_isLocked;
  }

  public const final func IsUnlocked() -> Bool {
    return !this.IsLocked();
  }

  public const final func IsSealed() -> Bool {
    return this.m_isSealed;
  }

  public const final func canPlayerToggleLockState() -> Bool {
    return this.m_doorProperties.m_canPlayerToggleLockState;
  }

  public const final func canPlayerToggleSealState() -> Bool {
    return this.m_doorProperties.m_canPlayerToggleSealState;
  }

  public const final func canPlayerRemotelyAuthorize() -> Bool {
    return this.m_doorProperties.m_canPlayerRemotelyAuthorize;
  }

  public const final func GetDoorType() -> EDoorType {
    return this.m_doorProperties.m_doorType;
  }

  public const final func GetDoorTypeSideTwo() -> EDoorType {
    return this.m_doorProperties.m_doorTypeSideTwo;
  }

  public const final func GetDoorTypeSideOne() -> EDoorType {
    return this.m_doorProperties.m_doorTypeSideOne;
  }

  public const final func GetDoorSkillcheckSide() -> EDoorSkillcheckSide {
    return this.m_doorProperties.m_skillCheckSide;
  }

  public const final func GetDoorAuthorizationSide() -> EDoorSkillcheckSide {
    return this.m_doorProperties.m_authorizationSide;
  }

  public const final func GetDoorTriggerSide() -> EDoorTriggerSide {
    return this.m_doorProperties.m_doorTriggerSide;
  }

  public const final func GetOpeningSpeed() -> Float {
    return this.m_doorProperties.m_openingSpeed;
  }

  public const final func GetOpeningTime() -> Float {
    return this.m_doorProperties.m_doorOpeningTime;
  }

  public const final func GetStimRange() -> Float {
    return this.m_doorProperties.m_doorOpeningStimRange;
  }

  public const final func IsShutter() -> Bool {
    return this.m_doorProperties.m_isShutter;
  }

  public const final func IsLiftDoor() -> Bool {
    return this.m_isLiftDoor;
  }

  public const final func IsBusy() -> Bool {
    return this.m_isBusy;
  }

  public const final func GetPaymentRecordID() -> TweakDBID {
    return this.m_doorProperties.m_paymentRecordID;
  }

  public const final func GetPaymentRecord() -> ActionPayment_Record {
    return TweakDBInterface.GetActionPaymentRecord(this.GetPaymentRecordID());
  }

  public const final func CanPayToUnlock() -> Bool {
    return this.m_doorProperties.m_canPayToUnlock;
  }

  public const final func ExposeQuickHakcsIfNotConnnectedToAP() -> Bool {
    return this.m_doorProperties.m_exposeQuickHacksIfNotConnectedToAP;
  }

  public const final func GetDoorState() -> EDoorStatus {
    if this.IsOpen() {
      return EDoorStatus.OPENED;
    } else if this.IsLocked() {
      return EDoorStatus.LOCKED;
    } else if this.IsSealed() {
      return EDoorStatus.SEALED;
    }
    return EDoorStatus.CLOSED;
  }

  public const final func IsSideOneActive() -> Bool {
    if NotEquals(this.GetDoorSkillcheckSide(), EDoorSkillcheckSide.TWO) {
      return true;
    }
    return false;
  }

  public const final func IsSideTwoActive() -> Bool {
    if NotEquals(this.GetDoorSkillcheckSide(), EDoorSkillcheckSide.ONE) {
      return true;
    }
    return false;
  }

  public const func GetDeviceStatusAction() -> DoorStatus {
    return this.ActionDoorStatus();
  }

  public final func SetNewDoorType(type: EDoorType) {
    this.m_doorProperties.m_doorType = type;
  }

  public final func SetTriggerSide(side: EDoorTriggerSide) {
    this.m_doorProperties.m_doorTriggerSide = side;
  }

  public final func SetIsOpened(isOpened: Bool) {
    this.m_isOpened = isOpened;
    this.OnSetIsOpened();
  }

  public final func SetIsLocked(isLocked: Bool) {
    this.m_isLocked = isLocked;
  }

  public final func SetIsSealed(isSealed: Bool) {
    this.m_isSealed = isSealed;
  }

  public final func SetIsBusy(isBusy: Bool) {
    this.m_isBusy = isBusy;
  }

  private final func InitializeDoorTypes() {
    this.m_doorProperties.m_doorTypeSideOne = this.m_doorProperties.m_doorType;
    if Equals(this.m_doorProperties.m_doorTypeSideTwo, EDoorType.NONE) {
      this.m_doorProperties.m_doorTypeSideTwo = this.m_doorProperties.m_doorTypeSideOne;
    }
  }

  protected final func SetDefaultDoorState() {
    switch this.m_doorProperties.m_initialDoorState {
      case EDoorStatus.OPENED:
        this.SetIsOpened(true);
        break;
      case EDoorStatus.CLOSED:
        this.SetIsOpened(false);
        break;
      case EDoorStatus.LOCKED:
        this.SetIsOpened(false);
        this.SetIsLocked(true);
        break;
      case EDoorStatus.SEALED:
        this.SetIsOpened(false);
        this.SetIsSealed(true);
        break;
    }
  }

  protected final func CheckIfLiftDoors() -> Bool {
    let parents: [DeviceComponentPS];
    this.GetParents(parents);
    let i = 0;
    while i < ArraySize(parents) {
      if IsDefined(parents[i] as ElevatorFloorTerminalControllerPS) {
        if this.IsLocked() && this.IsOpen() {
          this.SetIsOpened(false);
        }
        return true;
      }
      i += 1;
    }
    return false;
  }

  public final func IsLiftDoorAndAtThisFloor() -> Bool {
    let parents: [DeviceComponentPS];
    this.GetParents(parents);
    let i = 0;
    while i < ArraySize(parents) {
      if IsDefined(parents[i] as ElevatorFloorTerminalControllerPS) {
        let floorTerminal = parents[i] as ElevatorFloorTerminalControllerPS;
        floorTerminal.EvaluateThisFloor();
        return floorTerminal.IsElevatorAtThisFloor();
      }
      i += 1;
    }
    return false;
  }

  protected final func IsLiftFloorAuthorized() -> Bool {
    let parents: [DeviceComponentPS];
    this.GetParents(parents);
    let i = 0;
    while i < ArraySize(parents) {
      if IsDefined(parents[i] as ElevatorFloorTerminalControllerPS) {
        return (parents[i] as ElevatorFloorTerminalControllerPS).IsPlayerAuthorized();
      }
      i += 1;
    }
    return false;
  }

  protected final func IsLiftAvailable() -> Bool {
    let parents: [DeviceComponentPS];
    this.GetAncestors(parents);
    let i = 0;
    while i < ArraySize(parents) {
      if IsDefined(parents[i] as LiftControllerPS) {
        return (parents[i] as LiftControllerPS).IsPlayerAuthorized() && (parents[i] as LiftControllerPS).IsON();
      }
      i += 1;
    }
    return false;
  }

  protected final func IsLiftUnauthorized() -> Bool {
    let parents: [DeviceComponentPS];
    this.GetAncestors(parents);
    let i = 0;
    while i < ArraySize(parents) {
      if IsDefined(parents[i] as LiftControllerPS) && (parents[i] as LiftControllerPS).IsON() {
        let result = (parents[i] as LiftControllerPS).IsPlayerAuthorized();
        return !result;
      }
      i += 1;
    }
    return false;
  }

  protected const final func IsLiftMoving() -> Bool {
    let parents: [DeviceComponentPS];
    this.GetParents(parents);
    let i = 0;
    while i < ArraySize(parents) {
      if IsDefined(parents[i] as ElevatorFloorTerminalControllerPS) {
        return (parents[i] as ElevatorFloorTerminalControllerPS).IsLiftMoving();
      }
      i += 1;
    }
    return false;
  }

  public final func PushResaveData(data: DoorResaveData);

  protected func DetermineGameplayViability(const context: script_ref<GetActionsContext>, hasActiveActions: Bool) -> Bool {
    return DoorViabilityInterpreter.Evaluate(this, hasActiveActions);
  }

  protected func GetInkWidgetTweakDBID(const context: script_ref<GetActionsContext>) -> TweakDBID {
    if !this.IsUserAuthorized(context.processInitiatorObject.GetEntityID()) && !context.ignoresAuthorization && !this.CanPayToUnlock() {
      if this.canPlayerRemotelyAuthorize() || context.allowsRemoteAuthorization {
        return t"DevicesUIDefinitions.DoorDeviceWidget";
      }
      return t"DevicesUIDefinitions.DoorKeypadWidget";
    }
    return t"DevicesUIDefinitions.DoorDeviceWidget";
  }

  public func GetWidgetTypeName() -> CName {
    return n"GenericDeviceWidget";
  }

  public func GetDeviceIconPath() -> String {
    return "base/gameplay/gui/brushes/devices/icon_door.widgetbrush";
  }

  protected func GetDeviceIconTweakDBID() -> TweakDBID {
    return t"DeviceIcons.DoorDeviceIcon";
  }

  protected func GetBackgroundTextureTweakDBID() -> TweakDBID {
    return t"DeviceIcons.DoorDeviceBackground";
  }

  protected func GetWidgetVisualState() -> EWidgetState {
    let widgetState: EWidgetState;
    if Equals(this.GetDoorState(), EDoorStatus.OPENED) {
      widgetState = EWidgetState.ALLOWED;
    } else if Equals(this.GetDoorState(), EDoorStatus.LOCKED) {
      widgetState = EWidgetState.LOCKED;
    } else if Equals(this.GetDoorState(), EDoorStatus.SEALED) {
      widgetState = EWidgetState.SEALED;
    } else if Equals(this.GetDoorState(), EDoorStatus.OPENED) {
      widgetState = EWidgetState.ALLOWED;
    } else if Equals(this.GetDoorState(), EDoorStatus.CLOSED) && !this.IsPlayerAuthorized() {
      widgetState = EWidgetState.LOCKED;
    } else {
      widgetState = EWidgetState.ALLOWED;
    }
    return widgetState;
  }

  public func GetActions(out actions: [DeviceAction], context: GetActionsContext) -> Bool {
    let basedTestsPassed = super.GetActions(actions, context);
    if this.m_isLiftDoor {
      if this.IsON() {
        if this.IsOpen() {
          return false;
        } else if this.IsLocked()
          && !this.IsLiftMoving()
          && this.IsLiftFloorAuthorized()
          && this.IsLiftAvailable() {
          let actionCallElevator = this.ActionCallElevator();
          ArrayPush(actions, actionCallElevator);
        } else if this.IsLiftUnauthorized() {
          ArrayPush(actions, this.ActionUnauthorized());
        }
        actionCallElevator = this.ActionCallElevator();
        actionCallElevator.SetInactiveWithReason(false, "LocKey#17796");
        ArrayPush(actions, actionCallElevator);
      }
      return false;
    } else if !basedTestsPassed {
      return false;
    } else if this.IsBusy() {
      return false;
    } else if Equals(context.requestType, gamedeviceRequestType.Remote) {
      return false;
    } else if Equals(this.m_doorProperties.m_doorType, EDoorType.PHYSICAL) {
      return false;
    } else if Equals(this.m_doorProperties.m_doorType, EDoorType.REMOTELY_CONTROLLED) && Equals(context.requestType, gamedeviceRequestType.Direct) {
      return false;
    } else if Equals(this.m_doorProperties.m_doorType, EDoorType.AUTOMATIC) && NotEquals(context.requestType, gamedeviceRequestType.Internal) {
      return false;
    } else if this.IsOFF() || this.IsUnpowered() || this.IsDisabled() {
      return false;
    } else if DoorStatus.IsDefaultConditionMet(this, context) {
      ArrayPush(actions, this.ActionDoorStatus());
    } else if TogglePower.IsDefaultConditionMet(this, context) {
      ArrayPush(actions, this.ActionTogglePower());
    } else if Equals(this.GetDoorType(), EDoorType.AUTOMATIC) && Equals(context.requestType, gamedeviceRequestType.Internal) {
      if this.CanAddToggleOpenAction(context) {
        ArrayPush(actions, this.GetPlayerToggleOpenAction());
      } else if NotEquals(this.GetDoorType(), EDoorType.AUTOMATIC) {
        if this.CanAddToggleOpenAction(context) {
          ArrayPush(actions, this.GetPlayerToggleOpenAction());
        } else if ToggleLock.IsDefaultConditionMet(this, context) {
          ArrayPush(actions, this.ActionToggleLock());
        } else if ToggleSeal.IsDefaultConditionMet(this, context) {
          ArrayPush(actions, this.ActionToggleSeal());
        } else if ForceOpen.IsDefaultConditionMet(this, context) {
          ArrayPush(actions, this.ActionForceOpen());
        } else if SetOpened.IsDefaultConditionMet(this, context) {
          ArrayPush(actions, this.ActionSetOpened());
        }
      }
    }
    this.SetActionIllegality(actions, this.m_illegalActions.regularActions);
    return true;
  }

  protected func GetPlayerToggleOpenAction() -> ToggleOpen {
    return this.ActionToggleOpen();
  }

  protected func CanAddToggleOpenAction(context: GetActionsContext) -> Bool {
    return ToggleOpen.IsDefaultConditionMet(this, context);
  }

  protected func SetInactiveActionsWithExceptions(out outActions: [DeviceAction]) {
    let inactiveReason: String;
    let actionAllowedClassNames: [String];
    let actionDisallowedClassNames: [String];
    super.SetInactiveActionsWithExceptions(outActions);
    if this
      .GetActionsRestrictionData(actionAllowedClassNames, actionDisallowedClassNames, inactiveReason) {
      if ArrayContains(actionAllowedClassNames, "ToggleOpen") {
        let i = 0;
        while i < ArraySize(outActions) {
          let sAction = outActions[i] as ActionSkillCheck;
          if IsDefined(sAction) {
            sAction.SetActive();
          }
          i += 1;
        }
      }
    }
  }

  protected func PushReturnActions(out outActions: [DeviceAction], const context: script_ref<GetActionsContext>) -> Bool {
    let shouldReturn = super.PushReturnActions(outActions, context);
    if shouldReturn
      && !this.m_isLiftDoor
      && this.IsDeviceSecured()
      && !this.IsUserAuthorized(context.processInitiatorObject.GetEntityID())
      && PlayerUnauthorized.IsDefaultConditionMet(this, context) {
      ArrayPush(outActions, this.ActionUnauthorized());
    } else if !shouldReturn && this.CanPayToAuthorize() && Pay.IsDefaultConditionMet(this, context) {
      shouldReturn = true;
      ArrayPush(outActions, this.ActionPay(context));
    }
    return shouldReturn;
  }

  protected const func CanCreateAnyQuickHackActions() -> Bool {
    return this.ExposeQuickHakcsIfNotConnnectedToAP() || this.IsConnectedToBackdoorDevice();
  }

  protected func GetQuickHackActions(out actions: [DeviceAction], const context: script_ref<GetActionsContext>) {
    if this.ExposeQuickHakcsIfNotConnnectedToAP() || this.IsConnectedToBackdoorDevice() {
      let currentAction = this.ActionQuickHackToggleOpen();
      currentAction.SetObjectActionID(t"DeviceAction.ToggleStateClassHack");
      if this.IsBusy() {
        currentAction.SetInactiveWithReason(!this.IsBusy(), "LocKey#42758");
      } else {
        currentAction
          .SetInactiveWithReason(
            QuickHackToggleOpen.IsDefaultConditionMet(this, context),
            "LocKey#7003"
          );
      }
      ArrayPush(actions, currentAction);
      this.FinalizeGetQuickHackActions(actions, context);
    }
  }

  protected func GetMinigameActions(actions: script_ref<[DeviceAction]>, const context: script_ref<GetActionsContext>) {
    let action = this.ActionSetAuthorizationModuleOFF();
    action.clearanceLevel = 2;
    action.SetUp(this);
    action.AddDeviceName(this.m_deviceName);
    ArrayPush(actions, action);
  }

  public func GetQuestActionByName(actionName: CName) -> DeviceAction {
    let action = super.GetQuestActionByName(actionName);
    if action == null {
      switch actionName {
        case n"ForceOpen":
          action = this.ActionQuestForceOpen();
          break;
        case n"ForceClose":
          action = this.ActionQuestForceClose();
          break;
        case n"ForceCloseImmediate":
          action = this.ActionQuestForceCloseImmediate();
          break;
        case n"ForceOpenScene":
          action = this.ActionQuestForceOpenScene();
          break;
        case n"ForceCloseScene":
          action = this.ActionQuestForceCloseScene();
          break;
        case n"ForceLock":
          action = this.ActionQuestForceLock();
          break;
        case n"ForceUnlock":
          action = this.ActionQuestForceUnlock();
          break;
        case n"ForceSeal":
          action = this.ActionQuestForceSeal();
          break;
        case n"ForceUnseal":
          action = this.ActionQuestForceUnseal();
          return action;
      }
    }
  }

  public func GetQuestActions(out actions: [DeviceAction], const context: script_ref<GetActionsContext>) {
    super.GetQuestActions(actions, context);
    ArrayPush(actions, this.ActionQuestForceOpen());
    ArrayPush(actions, this.ActionQuestForceClose());
    ArrayPush(actions, this.ActionQuestForceCloseImmediate());
    ArrayPush(actions, this.ActionQuestForceOpenScene());
    ArrayPush(actions, this.ActionQuestForceCloseScene());
    ArrayPush(actions, this.ActionQuestForceLock());
    ArrayPush(actions, this.ActionQuestForceUnlock());
    ArrayPush(actions, this.ActionQuestForceSeal());
    ArrayPush(actions, this.ActionQuestForceUnseal());
  }

  protected func PushSkillCheckActions(out outActions: [DeviceAction], const context: script_ref<GetActionsContext>) -> Bool {
    let skillCheckAdded: Bool;
    if this.IsClosed() && !this.IsSealed() && this.IsTriggerValid(this.GetDoorSkillcheckSide()) {
      if this.m_skillCheckContainer.GetDemolitionSlot().IsActive() && ActionSkillCheck.IsDefaultConditionMet(this, context, false) {
        ArrayPush(outActions, this.ActionDemolition(context));
        skillCheckAdded = true;
      } else if this.m_skillCheckContainer.GetEngineeringSlot().IsActive() && ActionSkillCheck.IsDefaultConditionMet(this, context, false) {
        ArrayPush(outActions, this.ActionEngineering(context));
        skillCheckAdded = true;
      }
    }
    return skillCheckAdded;
  }

  public const final func IsTriggerValid(side: EDoorSkillcheckSide) -> Bool {
    if Equals(side, EDoorSkillcheckSide.BOTH) {
      return true;
    }
    if Equals(side, EDoorSkillcheckSide.ONE) && Equals(this.GetDoorTriggerSide(), EDoorTriggerSide.ONE) {
      return true;
    }
    if Equals(side, EDoorSkillcheckSide.TWO) && Equals(this.GetDoorTriggerSide(), EDoorTriggerSide.TWO) {
      return true;
    }
    return false;
  }

  protected const final func ActionDoorStatus() -> DoorStatus {
    let action = new DoorStatus();
    action.clearanceLevel = 1;
    action.SetUp(this);
    action.SetProperties(this);
    action.AddDeviceName(this.m_deviceName);
    return action;
  }

  protected func ActionDoorOpeningToken() -> DoorOpeningToken {
    let action: DoorOpeningToken;
    action.clearanceLevel = 2;
    action.SetUp(this);
    action.SetProperties();
    action.AddDeviceName(this.m_deviceName);
    action.CreateActionWidgetPackage();
    return action;
  }

  public final func OnDoorOpeningToken(evt: DoorOpeningToken) -> EntityNotificationType {
    this.AddToken(evt.GetExecutor().GetEntityID());
    return EntityNotificationType.DoNotNotifyEntity;
  }

  public func ActionToggleOpen() -> ToggleOpen {
    let action = new ToggleOpen();
    action.clearanceLevel = 2;
    action.SetUp(this);
    action.SetProperties(this.IsOpen());
    action.AddDeviceName(this.GetDeviceName());
    action.CreateInteraction();
    action.CreateActionWidgetPackage();
    return action;
  }

  public func OnSecuritySystemOutput(evt: SecuritySystemOutput) -> EntityNotificationType {
    super.OnSecuritySystemOutput(evt);
    if this.IsOpen() && Equals(evt.GetCachedSecurityState(), ESecuritySystemState.COMBAT) {
      this.m_alarmRaised = true;
      if this.IsClosingAutomatically() {
        this.ExecutePSAction(this.ActionQuestForceLock(), this);
        this.ExecutePSAction(this.ActionToggleOpen(), this);
      }
    } else if Equals(evt.GetCachedSecurityState(), ESecuritySystemState.SAFE) && this.m_alarmRaised {
      this.m_alarmRaised = false;
      this.ExecutePSAction(this.ActionQuestForceUnlock(), this);
    }
    return EntityNotificationType.DoNotNotifyEntity;
  }

  public final func OnToggleOpen(evt: ToggleOpen) -> EntityNotificationType {
    if this.IsUnpowered() || this.IsDisabled() {
      return this.SendActionFailedEvent(evt, evt.GetRequesterID(), "Unpowered or Disabled");
    } else if this.m_isKeyloggerInstalled && this.IsAuthorizationModuleOn() {
      this.TurnAuthorizationModuleOFF();
    } else if this.IsOpen() {
      this.SetIsOpened(false);
      if !IsFinal() {
      }
      this.UseNotifier(evt);
      return EntityNotificationType.SendThisEventToEntity;
    } else if this.IsLocked() && this.IsPlayerAuthorized() {
      this.SetIsLocked(false);
      this.AccessGrantedNotification();
      this.UpdatePlayerAuthorization();
    } else if !this.ToggleOpenOnDoor() {
      return this.SendActionFailedEvent(evt, evt.GetRequesterID(), "Failed Toggle");
    } else if this.HasAnySkillCheckActive() && evt.GetExecutor().IsPlayer() {
      this.ResolveOtherSkillchecks();
    }
    this.DepleteToken(evt.GetExecutor().GetEntityID());
    if !IsFinal() {
    }
    this.UseNotifier(evt);
    return EntityNotificationType.SendThisEventToEntity;
  }

  protected func OnSetIsOpened() {
    this
      .GetPersistencySystem()
      .EntityProxy_DisablePhysics(PersistentID.ExtractEntityID(this.GetID()), this.IsOpen());
  }

  public final func OnDoorCollision() {
    if !this.IsOpen() {
      this.ExecutePSAction(this.ActionToggleOpen(), this);
    }
  }

  public final func ActionSetOpened() -> SetOpened {
    let action = new SetOpened();
    action.clearanceLevel = 2;
    action.SetUp(this);
    action.SetProperties();
    action.AddDeviceName(this.m_deviceName);
    return action;
  }

  public final func OnSetOpened(evt: SetOpened) -> EntityNotificationType {
    let notifier = new ActionNotifier();
    notifier.SetAll();
    if this.IsDisabled() || this.IsSealed() {
      return this.SendActionFailedEvent(evt, evt.GetRequesterID(), "Sealed or Disabled");
    }
    this.SetIsOpened(true);
    this.Notify(notifier, evt);
    return EntityNotificationType.SendPSChangedEventToEntity;
  }

  public final func ActionSetClosed() -> SetClosed {
    let action = new SetClosed();
    action.clearanceLevel = 2;
    action.SetUp(this);
    action.SetProperties();
    action.AddDeviceName(this.m_deviceName);
    return action;
  }

  public final func OnSetClosed(evt: SetClosed) -> EntityNotificationType {
    let notifier = new ActionNotifier();
    notifier.SetAll();
    if this.IsDisabled() || this.IsSealed() {
      return this.SendActionFailedEvent(evt, evt.GetRequesterID(), "Sealed or Disabled");
    }
    this.SetIsOpened(false);
    this.Notify(notifier, evt);
    return EntityNotificationType.SendPSChangedEventToEntity;
  }

  protected func ActionPay(const context: script_ref<GetActionsContext>) -> Pay {
    let action = new Pay();
    action.clearanceLevel = 5;
    action.SetUp(this);
    if TDBID.IsValid(this.GetPaymentRecordID()) {
      action.SetObjectActionID(this.GetPaymentRecordID());
    }
    action.SetExecutor(GetPlayer(this.GetGameInstance()));
    action.SetProperties();
    action.AddDeviceName(this.m_deviceName);
    action.CreateActionWidgetPackage();
    action.SetDurationValue(1.5);
    return action;
  }

  public final func OnPay(evt: Pay) -> EntityNotificationType {
    if this.IsDisabled() || this.IsSealed() {
      return this.SendActionFailedEvent(evt, evt.GetRequesterID(), "Sealed or Disabled");
    } else if evt.IsStarted() && evt.CanPayCost() {
      this.ExecutePSActionWithDelay(evt, this, evt.GetDurationValue());
    }
    let notifier = new ActionNotifier();
    notifier.SetAll();
    this.SetIsOpened(true);
    this.SetIsLocked(false);
    this.Notify(notifier, evt);
    return EntityNotificationType.DoNotNotifyEntity;
  }

  protected func ActionQuickHackToggleOpen() -> QuickHackToggleOpen {
    let action = new QuickHackToggleOpen();
    action.clearanceLevel = 2;
    action.SetUp(this);
    action.SetProperties(this.IsOpen());
    action.AddDeviceName(this.m_deviceName);
    if this.IsOpen() {
      action.CreateInteraction(t"Interactions.Close");
    } else {
      action.CreateInteraction(t"Interactions.Open");
    }
    return action;
  }

  public final func ActionToggleLock() -> ToggleLock {
    let action = new ToggleLock();
    action.clearanceLevel = 5;
