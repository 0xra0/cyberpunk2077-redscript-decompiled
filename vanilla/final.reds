class ChaosWeaponCustomEffector extends Effector {
  public let m_effectorOwnerID: EntityID;
  public let m_target: StatsObjectID;
  public let m_record: TweakDBID;
  public let m_applicationTarget: CName;
  public let m_modGroupID: Uint64;

  protected func Initialize(record: TweakDBID, game: GameInstance, parentRecord: TweakDBID) {
    this.m_record = TweakDBInterface
      .GetApplyStatGroupEffectorRecord(record)
      .StatGroup()
      .GetID();
    this.m_applicationTarget = TweakDBInterface.GetCName(record + t".applicationTarget", n"None");
  }

  protected func ProcessEffector(owner: GameObject) {
    this.m_effectorOwnerID = owner.GetEntityID();
    let ss = GameInstance.GetStatsSystem(owner.GetGame());
    if !this
      .GetApplicationTargetAsStatsObjectID(owner, this.m_applicationTarget, this.m_target) {
      return;
    }
    ss.RemoveModifierGroup(this.m_target, this.m_modGroupID);
    ss.UndefineModifierGroup(this.m_modGroupID);
    this.m_modGroupID = TDBID.ToNumber(this.m_record);
    ss.DefineModifierGroupFromRecord(this.m_modGroupID, this.m_record);
    ss.ApplyModifierGroup(this.m_target, this.m_modGroupID);
  }

  protected func Uninitialize(game: GameInstance) {
    this.RemoveModifierGroup(game);
  }

  protected func ActionOn(owner: GameObject) {
    this.ProcessEffector(owner);
  }

  private final func RemoveModifierGroup(gameInstance: GameInstance) {
    if !StatsObjectID.IsDefined(this.m_target) || !EntityID.IsDefined(this.m_effectorOwnerID) {
      return;
    }
    let ss = GameInstance.GetStatsSystem(gameInstance);
    ss.RemoveModifierGroup(this.m_target, this.m_modGroupID);
    ss.UndefineModifierGroup(this.m_modGroupID);
  }
}

class ConvertDamageToDoTEffector extends ModifyAttackEffector {
  public let m_DamageToDoTConversion: Float;
  public let m_DotDistributionTime: Float;
  public let m_statMod: gameConstantStatModifierData;
  public let m_ownerID: EntityID;

  protected func Initialize(record: TweakDBID, game: GameInstance, parentRecord: TweakDBID) {
    this.m_DamageToDoTConversion = TweakDBInterface.GetFloat(record + t".damageConversion", 0.0);
    this.m_DotDistributionTime = TweakDBInterface.GetFloat(record + t".dotDistributionTime", 5.0);
    this.m_statMod = RPGManager
      .CreateStatModifier(gamedataStatType.AccumulatedDoTDecayRate, gameStatModifierType.Additive, 0.0) as gameConstantStatModifierData;
  }

  protected func Uninitialize(game: GameInstance) {
    if IsDefined(this.m_statMod) {
      let statSystem = GameInstance.GetStatsSystem(game);
      statSystem.RemoveModifier(Cast<StatsObjectID>(this.m_ownerID), this.m_statMod);
    }
  }

  protected func ActionOn(owner: GameObject) {
    this.ProcessAction(owner);
  }

  protected func RepeatedAction(owner: GameObject) {
    this.ProcessAction(owner);
  }

  private final func ProcessAction(owner: GameObject) {
    let hitEvent = this.GetHitEvent();
    if !IsDefined(hitEvent) {
      return;
    } else if AttackData.IsDoT(hitEvent.attackData) {
      return;
    }
    let tmpValue = hitEvent.attackComputed.GetTotalAttackValue(gamedataStatPoolType.Health);
    let dotDmgToApply = tmpValue / (1.0 - this.m_DamageToDoTConversion) - tmpValue;
    if dotDmgToApply > 0.0 {
      this.m_ownerID = owner.GetEntityID();
      let poolSys = GameInstance.GetStatPoolsSystem(owner.GetGame());
      tmpValue = poolSys
        .GetStatPoolValue(
          Cast<StatsObjectID>(this.m_ownerID),
          gamedataStatPoolType.AccumulatedDoT,
          false
        );
      poolSys
        .RequestChangingStatPoolValue(
          Cast<StatsObjectID>(this.m_ownerID),
          gamedataStatPoolType.AccumulatedDoT,
          dotDmgToApply,
          owner,
          false,
          false
        );
      let statSystem = GameInstance.GetStatsSystem(owner.GetGame());
      statSystem.RemoveModifier(Cast<StatsObjectID>(this.m_ownerID), this.m_statMod);
      this.m_statMod.value = (tmpValue + dotDmgToApply) / this.m_DotDistributionTime;
      statSystem.AddModifier(Cast<StatsObjectID>(this.m_ownerID), this.m_statMod);
    }
  }
}

class GameplayPerkCondition extends GameplayConditionBase {
  public let m_perkToCheck: TweakDBID;
  public let m_difficulty: EGameplayChallengeLevel;

  public func Evaluate(requester: GameObject) -> Bool {
    if this.GetPlayerPerk(requester) >= this.GetRequiredLevel() {
      return true;
    }
    return false;
  }

  private final func GetPlayerPerk(requester: GameObject) -> Int32 {
    let player = this.GetPlayer(requester);
    let playerDevSystem = GameInstance
      .GetScriptableSystemsContainer(player.GetGame())
      .Get(n"PlayerDevelopmentSystem") as PlayerDevelopmentSystem;
    return playerDevSystem.GetPerkLevel(player, this.GetPerkType());
  }

  private final func GetRequiredLevel() -> Int32 {
    return RPGManager
      .CheckDifficultyToPerkLevel(this.GetPerkType(), this.m_difficulty, this.m_entityID);
  }

  private final func GetPerkType() -> gamedataPerkType {
    return TweakDBInterface.GetPerkRecord(this.m_perkToCheck).Type();
  }

  public func GetDescription(requester: GameObject) -> Condition {
    let description: Condition;
    description.description = this.GetConditionDescription();
    description.passed = this.Evaluate(requester);
    return description;
  }

  private final func GetConditionDescription() -> String {
    let perkLevels: [wref<PerkLevelData_Record>];
    let perk = TweakDBInterface.GetPerkRecord(this.m_perkToCheck).Loc_name_key();
    TweakDBInterface.GetPerkRecord(this.m_perkToCheck).Levels(perkLevels);
    let max = ToString(ArraySize(perkLevels));
    let text = "Has perk: "
      + perk
      + " "
      + ToString(this.GetRequiredLevel())
      + "/"
      + max;
    return text;
  }
}

class ApplyStatusEffectEffector extends Effector {
  public let m_targetEntityID: EntityID;
  public let m_applicationTarget: CName;
  public let m_record: TweakDBID;
  public let m_removeWithEffector: Bool;
  public let m_inverted: Bool;
  public let m_useCountWhenRemoving: Bool;
  public let m_count: Float;
  public let m_instigator: String;

  protected func Initialize(record: TweakDBID, game: GameInstance, parentRecord: TweakDBID) {
    this.m_record = TweakDBInterface
      .GetApplyStatusEffectEffectorRecord(record)
      .StatusEffect()
      .GetID();
    this.m_applicationTarget = TweakDBInterface.GetCName(record + t".applicationTarget", n"None");
    this.m_removeWithEffector = TweakDBInterface.GetBool(record + t".removeWithEffector", true);
    this.m_inverted = TweakDBInterface.GetBool(record + t".inverted", false);
    this.m_count = TweakDBInterface.GetFloat(record + t".count", 1.0);
    this.m_instigator = TweakDBInterface.GetString(record + t".instigator", "");
    this.m_useCountWhenRemoving = TDB.GetBool(record + t".useCountWhenRemoving");
    if Equals(this.m_applicationTarget, n"Weapon") {
    }
  }

  protected func Uninitialize(game: GameInstance) {
    if this.m_inverted {
      this.ApplyStatusEffect(game);
    } else if this.m_removeWithEffector {
      this.RemoveStatusEffect(game);
    }
  }

  private final func ProcessAction(owner: GameObject) {
    if !this
      .GetApplicationTarget(owner, this.m_applicationTarget, this.m_targetEntityID) {
      return;
    } else if this.m_inverted {
      this.RemoveStatusEffect(owner.GetGame());
    }
    this.ApplyStatusEffect(owner.GetGame());
  }

  protected func ActionOn(owner: GameObject) {
    this.ProcessAction(owner);
  }

  protected func RepeatedAction(owner: GameObject) {
    this.ProcessAction(owner);
  }

  protected func ActionOff(owner: GameObject) {
    if this.m_removeWithEffector {
      if this.m_inverted {
        this.ApplyStatusEffect(owner.GetGame());
      } else {
        this.RemoveStatusEffect(owner.GetGame());
      }
    }
  }

  private final func ApplyStatusEffect(gameInstance: GameInstance) {
    if !EntityID.IsDefined(this.m_targetEntityID) || !TDBID.IsValid(this.m_record) {
      return;
    }
    let instigator = this.GetInstigator(gameInstance);
    let ses = GameInstance.GetStatusEffectSystem(gameInstance);
    if IsDefined(instigator) {
      ses
        .ApplyStatusEffect(
          this.m_targetEntityID,
          this.m_record,
          instigator.GetEntityID(),
          Cast<Uint32>(this.m_count)
        );
    } else {
      ses
        .ApplyStatusEffect(this.m_targetEntityID, this.m_record, Cast<Uint32>(this.m_count));
    }
  }

  private final func RemoveStatusEffect(gameInstance: GameInstance) {
    if !EntityID.IsDefined(this.m_targetEntityID) || !TDBID.IsValid(this.m_record) {
      return;
    }
    let ses = GameInstance.GetStatusEffectSystem(gameInstance);
    if this.m_useCountWhenRemoving {
      ses
        .RemoveStatusEffect(this.m_targetEntityID, this.m_record, Cast<Uint32>(this.m_count));
    } else {
      ses.RemoveStatusEffect(this.m_targetEntityID, this.m_record);
    }
  }

  protected final func GetInstigator(gameInstance: GameInstance) -> wref<GameObject> {
    switch this.m_instigator {
      case "Player":
        return GetPlayer(gameInstance);
    }
    return null;
  }
}

class ConvertDamageToStatPoolEffector extends HitEventEffector {
  private let m_statPoolType: gamedataStatPoolType;
  private let m_operationType: EMathOperator;
  private let m_value: Float;

  protected func Initialize(recordID: TweakDBID, game: GameInstance, parentRecord: TweakDBID) {
    let record = TweakDBInterface.GetConvertDamageToStatPoolEffectorRecord(recordID);
    this.m_statPoolType = record.StatPoolType().StatPoolType();
    this.m_operationType = IntEnum<EMathOperator>(Cast<Int32>(EnumValueFromName(n"EMathOperator", record.OpSymbol())));
    this.m_value = record.Value();
  }

  protected func ActionOn(owner: GameObject) {
    this.ProcessAction(owner);
  }

  protected func RepeatedAction(owner: GameObject) {
    this.ProcessAction(owner);
  }

  private final func ProcessAction(owner: GameObject) {
    let statPoolsSystem = GameInstance.GetStatPoolsSystem(owner.GetGame());
    let hitEvent = this.GetHitEvent();
    let damageScaled = hitEvent.attackComputed.GetTotalAttackValue(gamedataStatPoolType.Health) * this.m_value;
    let calculatedValue = 0.0;
    switch this.m_operationType {
      case EMathOperator.Add:
        calculatedValue = statPoolsSystem
          .GetStatPoolValue(Cast<StatsObjectID>(owner.GetEntityID()), this.m_statPoolType, false) + damageScaled;
        break;
      case EMathOperator.Subtract:
        calculatedValue = statPoolsSystem
          .GetStatPoolValue(Cast<StatsObjectID>(owner.GetEntityID()), this.m_statPoolType, false) - damageScaled;
        break;
      case EMathOperator.Multiply:
        calculatedValue = statPoolsSystem
          .GetStatPoolValue(Cast<StatsObjectID>(owner.GetEntityID()), this.m_statPoolType, false) * damageScaled;
        break;
      case EMathOperator.Divide:
        calculatedValue = statPoolsSystem
          .GetStatPoolValue(Cast<StatsObjectID>(owner.GetEntityID()), this.m_statPoolType, false) / damageScaled;
        break;
      default:
        return;
    }
    statPoolsSystem
      .RequestSettingStatPoolValue(
        Cast<StatsObjectID>(owner.GetEntityID()),
        this.m_statPoolType,
        calculatedValue,
        owner,
        false
      );
  }
}

importonly native class ConvertDamageToStatPoolEffector_Record extends Effector_Record {
  public final native func StatPoolType() -> wref<StatPool_Record>;

  public final native func StatPoolTypeHandle() -> StatPool_Record;

  public final native func OpSymbol() -> CName;

  public final native func Value() -> Float;
}

class HardToKillDamageModificationEffector extends ModifyAttackEffector {
  public let m_criticalHealthThreshold: Float;

  protected func Initialize(record: TweakDBID, game: GameInstance, parentRecord: TweakDBID) {
    this.m_criticalHealthThreshold = TweakDBInterface.GetFloat(record + t".criticalHealthThreshold", 0.0);
  }

  protected func ActionOn(owner: GameObject) {
    this.ProcessAction(owner);
  }

  protected func RepeatedAction(owner: GameObject) {
    this.ProcessAction(owner);
  }

  private final func ProcessAction(owner: GameObject) {
    let hitEvent = this.GetHitEvent();
    let poolSys = GameInstance.GetStatPoolsSystem(owner.GetGame());
    if !IsDefined(hitEvent) {
      return;
    } else if AttackData.IsDoT(hitEvent.attackData) {
      return;
    }
    let attackdamage = hitEvent.attackComputed.GetTotalAttackValue(gamedataStatPoolType.Health);
    let healthPercentage = poolSys
      .GetStatPoolValue(Cast<StatsObjectID>(owner.GetEntityID()), gamedataStatPoolType.Health);
    if attackdamage > 0.0 && healthPercentage <= this.m_criticalHealthThreshold {
      hitEvent.attackComputed.MultAttackValue(0.0);
      poolSys
        .RequestChangingStatPoolValue(
          Cast<StatsObjectID>(owner.GetEntityID()),
          gamedataStatPoolType.AccumulatedDoT,
          attackdamage,
          owner,
          false,
          false
        );
    }
  }
}

class ICECounterHackEffector extends Effector {
  public let m_quickhackObjectActionID: TweakDBID;
  public let m_quickhackObjectActionRecord: wref<ObjectAction_Record>;

  protected func Initialize(record: TweakDBID, game: GameInstance, parentRecord: TweakDBID) {
    this.m_quickhackObjectActionID = TDB.GetForeignKey(record + t".objectAction");
    this.m_quickhackObjectActionRecord = TweakDBInterface.GetObjectActionRecord(this.m_quickhackObjectActionID);
  }

  protected func ActionOn(owner: GameObject) {
    let evt = new HackTargetEvent();
    let player = GameInstance.GetPlayerSystem(owner.GetGame()).GetLocalPlayerMainGameObject();
    evt.targetID = player.GetEntityID();
    evt.netrunnerID = owner.GetEntityID();
    evt.objectRecord = this.m_quickhackObjectActionRecord;
    evt.settings.HUDData.type = SimpleMessageType.Boss;
    evt.settings.showDirectionalIndicator = false;
    if !GameInstance
      .GetStatusEffectSystem(owner.GetGame())
      .HasStatusEffect(evt.targetID, t"AIQuickHackStatusEffect.BeingHacked") {
      player.QueueEvent(evt);
    }
  }
}

class DetectionMeterEffector extends Effector {
  private let m_statusEffectID: TweakDBID;
  private let m_detectionStep: Float;
  private let m_maxStacks: Int32;
  private let m_onlyHostileDetection: Bool;
  private let m_dontRemoveStacks: Bool;
  private let m_detectionListener: CallbackHandle;
  private let m_currentStacks: Int32;
  private let m_gameInstance: GameInstance;
  private let m_ownerID: EntityID;

  protected func Initialize(record: TweakDBID, game: GameInstance, parentRecord: TweakDBID) {
    this.m_gameInstance = game;
    this.m_statusEffectID = TDB.GetForeignKey(record + t".statusEffect");
    this.m_detectionStep = TDB.GetFloat(record + t".detectionStep");
    this.m_maxStacks = TDB.GetInt(record + t".maxStacks");
    this.m_onlyHostileDetection = TDB.GetBool(record + t".onlyHostileDetection");
    this.m_dontRemoveStacks = TDB.GetBool(record + t".dontRemoveStacks");
  }

  protected func ActionOn(owner: GameObject) {
    this.m_ownerID = owner.GetEntityID();
    let blackboard = GameInstance.GetBlackboardSystem(owner.GetGame()).Get(GetAllBlackboardDefs().UI_Stealth);
    if IsDefined(blackboard) {
      if this.m_onlyHostileDetection {
        this.m_detectionListener = blackboard
          .RegisterListenerFloat(
            GetAllBlackboardDefs().UI_Stealth.highestHostileDetectionOnPlayer,
            this,
            n"OnDetectionChanged"
          );
        this
          .UpdateWithDetection(
            blackboard
              .GetFloat(GetAllBlackboardDefs().UI_Stealth.highestHostileDetectionOnPlayer)
          );
      } else {
        this.m_detectionListener = blackboard
          .RegisterListenerFloat(
            GetAllBlackboardDefs().UI_Stealth.highestDetectionOnPlayer,
            this,
            n"OnDetectionChanged"
          );
        this
          .UpdateWithDetection(
            blackboard.GetFloat(GetAllBlackboardDefs().UI_Stealth.highestDetectionOnPlayer)
          );
      }
    }
  }

  protected cb func OnDetectionChanged(newDetection: Float) -> Bool {
    this.UpdateWithDetection(newDetection);
  }

  protected func ActionOff(owner: GameObject) {
    if IsDefined(this.m_detectionListener) {
      let blackboard = GameInstance.GetBlackboardSystem(owner.GetGame()).Get(GetAllBlackboardDefs().UI_Stealth);
      if IsDefined(blackboard) {
        if this.m_onlyHostileDetection {
          blackboard
            .UnregisterListenerFloat(
              GetAllBlackboardDefs().UI_Stealth.highestHostileDetectionOnPlayer,
              this.m_detectionListener
            );
        } else {
          blackboard
            .UnregisterListenerFloat(
              GetAllBlackboardDefs().UI_Stealth.highestDetectionOnPlayer,
              this.m_detectionListener
            );
        }
      }
    }
    this.ProcessStacksChange(-this.m_currentStacks);
    this.m_currentStacks = 0;
  }

  private final func UpdateWithDetection(newDetection: Float) {
    if this.m_detectionStep <= 0.0 || !TDBID.IsValid(this.m_statusEffectID) {
      return;
    }
    let newStacks = FloorF(newDetection / this.m_detectionStep);
    if this.m_maxStacks > 0 {
      newStacks = Min(newStacks, this.m_maxStacks);
    }
    let stacksChange = newStacks - this.m_currentStacks;
    if stacksChange == 0 {
      return;
    }
    this.m_currentStacks = newStacks;
    this.ProcessStacksChange(stacksChange);
  }

  private final func ProcessStacksChange(stacksChange: Int32) {
    if stacksChange > 0 {
      GameInstance
        .GetStatusEffectSystem(this.m_gameInstance)
        .ApplyStatusEffect(
          this.m_ownerID,
          this.m_statusEffectID,
          TDBID.None(),
          this.m_ownerID,
          Cast<Uint32>(stacksChange)
        );
    } else if !this.m_dontRemoveStacks {
      GameInstance
        .GetStatusEffectSystem(this.m_gameInstance)
        .RemoveStatusEffect(this.m_ownerID, this.m_statusEffectID, Cast<Uint32>(Abs(stacksChange)));
    }
  }
}

class JuggernautEffector extends ContinuousEffector {
  public let m_modifiersAdded: Bool;
  public let m_poolSystem: StatPoolsSystem;
  public let m_statusEffectSystem: StatusEffectSystem;

  protected func Initialize(record: TweakDBID, game: GameInstance, parentRecord: TweakDBID) {
    this.m_modifiersAdded = false;
    this.m_poolSystem = GameInstance.GetStatPoolsSystem(game);
    this.m_statusEffectSystem = GameInstance.GetStatusEffectSystem(game);
  }

  protected func ContinuousAction(owner: GameObject, instigator: GameObject) {
    this.ProcessAction(owner);
  }

  protected func ProcessAction(owner: GameObject) {
    if this
      .m_poolSystem
      .GetStatPoolValue(
        Cast<StatsObjectID>(owner.GetEntityID()),
        gamedataStatPoolType.Overshield,
        false
      ) > 0.0 {
      if !this.m_modifiersAdded {
        this
          .m_statusEffectSystem
          .ApplyStatusEffect(owner.GetEntityID(), t"BaseStatusEffect.JuggernautBuff");
        this.m_modifiersAdded = true;
      }
    } else if this.m_modifiersAdded {
      this
        .m_statusEffectSystem
        .RemoveStatusEffect(owner.GetEntityID(), t"BaseStatusEffect.JuggernautBuff");
      this.m_modifiersAdded = false;
    }
  }
}

class ChaosWeaponDamageTypeEffector extends ChaosWeaponCustomEffector {
  public let m_damageTypeModGroups: [TweakDBID];

  protected func Initialize(record: TweakDBID, game: GameInstance, parentRecord: TweakDBID) {
    this.m_applicationTarget = TweakDBInterface.GetCName(record + t".applicationTarget", n"None");
    ArrayPush(this.m_damageTypeModGroups, t"Items.ChaosPhysical");
    ArrayPush(this.m_damageTypeModGroups, t"Items.ChaosThermal");
    ArrayPush(this.m_damageTypeModGroups, t"Items.ChaosElectric");
    ArrayPush(this.m_damageTypeModGroups, t"Items.ChaosChemical");
  }

  protected func ProcessEffector(owner: GameObject) {
    this.m_effectorOwnerID = owner.GetEntityID();
    let ss = GameInstance.GetStatsSystem(owner.GetGame());
    if !this
      .GetApplicationTargetAsStatsObjectID(owner, this.m_applicationTarget, this.m_target) {
      return;
    }
    ss.RemoveModifierGroup(this.m_target, this.m_modGroupID);
    ss.UndefineModifierGroup(this.m_modGroupID);
    let randIndex = RandRange(0, ArraySize(this.m_damageTypeModGroups));
    this.m_modGroupID = TDBID.ToNumber(this.m_damageTypeModGroups[randIndex]);
    ss
      .DefineModifierGroupFromRecord(this.m_modGroupID, this.m_damageTypeModGroups[randIndex]);
    ss.ApplyModifierGroup(this.m_target, this.m_modGroupID);
  }
}

class GameplayItemCondition extends GameplayConditionBase {
  public let m_itemToCheck: TweakDBID;

  public func Evaluate(requester: GameObject) -> Bool {
    let transactionSystem = GameInstance.GetTransactionSystem(requester.GetGame());
    let itemID = ItemID.FromTDBID(this.m_itemToCheck);
    return transactionSystem.HasItem(this.GetPlayer(requester), itemID);
  }

  public func GetDescription(requester: GameObject) -> Condition {
    let description: Condition;
    description.description = this.GetConditionDescription();
    description.passed = this.Evaluate(requester);
    return description;
  }

  private final func GetConditionDescription() -> String {
    let item = ToString(TweakDBInterface.GetItemRecord(this.m_itemToCheck).DisplayName());
    let text = "Has item: " + item;
    return text;
  }
}

class gameContainerObjectBasePS extends gameLootContainerBasePS {
}

abstract class TweakAIActionAbstract extends AIbehaviortaskScript {
  private let m_actionRecord: wref<AIAction_Record>;
  private let m_actionDebugName: String;
  private let m_actionActivationTimeStamp: Float;
  private let m_startActionTimeStamp: Float;
  protected let m_hasGracefulInterruptionConditions: Bool;
  protected let m_gracefulInterruptionCheckRandomizedInterval: Float;
  protected let m_gracefullyInterrupted: Bool;
  private let m_actionPhase: EAIActionPhase;
  private let m_phaseRecord: wref<AIActionPhase_Record>;
  private let m_nextPhaseConditionCount: Int32;
  private let m_repeatPhaseConditionCount: Int32;
  private let m_phaseActivationTimeStamp: Float;
  private let m_phaseConditionSuccessfulCheckTimeStamp: Float;
  private let m_phaseConditionCheckTimeStamp: Float;
  private let m_phaseConditionCheckRandomizedInterval: Float;
  private let m_phaseIteration: Uint32;
  private let m_phaseDuration: Float;
  private let m_phaseAnimationDuration: Float;
  private let m_lookatEvents: [LookAtAddEvent];
  private let m_movePolicy: MovePolicies;
  private let m_generalSubActionsResults: [AIbehaviorUpdateOutcome; 8];
  private let m_phaseSubActionsResults: [AIbehaviorUpdateOutcome; 8];
  private let m_phaseSubActionsCount: Int32;
  private let m_phaseForceZeroUpdateInterval: Bool;
  private let m_generalSubActionsCount: Int32;
  private let m_repeatPhaseConditionsCount: Int32;
  private let m_tickForActionDurationOnly: Bool;
  private let m_tickForActionDurationActivePhase: EAIActionPhase;
  private let m_hasTicketDeactivationConditions: Bool;
  private let m_isActionImmediate: Bool;
  private let m_lookatActivated: Bool;
  private let m_ticketsCommited: Bool;
  private let m_ticketsAcknowledged: Bool;
  private let m_failureStatus: Bool;
  private let m_animationLoaded: Bool;
  private let m_initializedAfterActivation: Bool;
  protected let m_shouldCallGetActionRecordAgain: Bool;

  private final func Initialize(const context: ScriptExecutionContext) {
    this.m_actionPhase = EAIActionPhase.Inactive;
    this.m_shouldCallGetActionRecordAgain = false;
    AIbehaviortaskScript.SetUpdateInterval(context, 0.0);
    if !this
      .GetActionRecord(
        context,
        this.m_actionDebugName,
        this.m_actionRecord,
        this.m_shouldCallGetActionRecordAgain
      ) {
      if !this.m_shouldCallGetActionRecordAgain {
        this.m_actionRecord = null;
      }
    } else {
      this.ActionUpdateIntervalCheck(context);
    }
  }

  private final func ActionUpdateIntervalCheck(const context: ScriptExecutionContext) {
    let endConditions: Bool;
    this.m_generalSubActionsCount = 0;
    this.m_repeatPhaseConditionsCount = 0;
    this.m_tickForActionDurationOnly = false;
    this.m_hasTicketDeactivationConditions = false;
    this.m_isActionImmediate = false;
    this.m_tickForActionDurationActivePhase = EAIActionPhase.Inactive;
    if this.IsActionImmediate() {
      this.m_isActionImmediate = true;
      return;
    } else if this.HasTicketDeactivationCondition(context) {
      this.m_hasTicketDeactivationConditions = true;
    }
    this.m_generalSubActionsCount = this.m_actionRecord.GetSubActionsCount();
    if this.m_generalSubActionsCount > 0 {
      return;
    } else if this.m_actionRecord.GetStartupSubActionsCount() > 0 {
      return;
    } else if this.m_actionRecord.GetLoopSubActionsCount() > 0 {
      return;
    } else if this.m_actionRecord.GetRecoverySubActionsCount() > 0 {
      return;
    }
    let phase = this.m_actionRecord.Startup();
    if IsDefined(phase) {
      if phase.GetToNextPhaseConditionCount() > 0 {
        endConditions = true;
      } else if phase.GetNotRepeatPhaseConditionCount() > 0 {
        this.m_repeatPhaseConditionsCount += 1;
      }
    }
    phase = this.m_actionRecord.Loop();
    if IsDefined(phase) {
      if phase.GetToNextPhaseConditionCount() > 0 {
        endConditions = true;
      } else if phase.GetNotRepeatPhaseConditionCount() > 0 {
        this.m_repeatPhaseConditionsCount += 1;
      }
    }
    phase = this.m_actionRecord.Recovery();
    if IsDefined(phase) {
      if phase.GetToNextPhaseConditionCount() > 0 {
        endConditions = true;
      } else if phase.GetNotRepeatPhaseConditionCount() > 0 {
        this.m_repeatPhaseConditionsCount += 1;
      } else if endConditions {
        return;
      } else if this.m_hasTicketDeactivationConditions {
        return;
      } else if this.m_hasGracefulInterruptionConditions {
        return;
      } else if this.GetTotalActionDuration() > 0.0 {
        this.m_tickForActionDurationOnly = true;
        return;
      }
    }
    let animData = this.m_actionRecord.AnimData();
    if IsDefined(animData) && IsNameValid(animData.AnimFeature()) {
      this.m_tickForActionDurationOnly = true;
    }
  }

  protected final func VerifyActionRecord() -> Bool {
    if this.m_actionRecord != null || this.m_shouldCallGetActionRecordAgain {
      return true;
    }
    return false;
  }

  protected func Activate(context: ScriptExecutionContext) {
    this.Initialize(context);
    this.m_initializedAfterActivation = false;
    this.m_ticketsAcknowledged = false;
    this.m_animationLoaded = false;
    this.m_ticketsCommited = false;
    this.m_failureStatus = false;
    this.m_lookatActivated = false;
    if IsDefined(this.m_actionRecord) {
      this.ActivateAnimationWrapperOverrides(context);
    }
  }

  protected final func RetryGetActionRecord(context: ScriptExecutionContext) -> Bool {
    if this.m_shouldCallGetActionRecordAgain {
      this.m_shouldCallGetActionRecordAgain = false;
      if this
        .GetActionRecord(
          context,
          this.m_actionDebugName,
          this.m_actionRecord,
          this.m_shouldCallGetActionRecordAgain
        ) {
        this.ActionUpdateIntervalCheck(context);
        if this.m_shouldCallGetActionRecordAgain {
          this.m_shouldCallGetActionRecordAgain = false;
          return true;
        }
        return true;
      }
      if this.m_shouldCallGetActionRecordAgain {
        AIBehaviorScriptBase.GetAIComponent(context).ForceTickNextFrame();
        return false;
      }
      this.m_actionRecord = null;
      return false;
    }
    return true;
  }

  private final func WaitForAnimToLoad(const context: ScriptExecutionContext) -> Bool {
    let animVariation: Int32;
    let animData = this.m_actionRecord.AnimData();
    if !IsDefined(animData) {
      return false;
    } else if !IsDefined(animData.AnimSlot()) {
      return false;
    }
    let animFeatureName = animData.AnimFeature();
    if !IsNameValid(animFeatureName) {
      return false;
    }
    let phaseToCheck = 0;
    if IsDefined(this.m_actionRecord.Startup()) {
      phaseToCheck = 1;
    } else if IsDefined(this.m_actionRecord.Loop()) {
      phaseToCheck = 2;
    } else if IsDefined(this.m_actionRecord.Recovery()) {
      phaseToCheck = 3;
    }
    if animData.AnimSlot().UsePoseMatching() {
      animVariation = -1;
    } else {
      let variationSubAction = animData.AnimVariationSubAction();
      if IsDefined(variationSubAction) {
        animVariation = AIScriptUtils.CallGetAnimVariation(context, variationSubAction);
      } else {
        animVariation = animData.AnimVariation();
      }
    }
    if AIScriptUtils
      .CheckAnimation(context, animFeatureName, animVariation, phaseToCheck, true) {
      this.m_animationLoaded = true;
      return false;
    }
    return true;
  }

  protected func Update(context: ScriptExecutionContext) -> AIbehaviorUpdateOutcome {
    let subActionsOutcome: AIbehaviorUpdateOutcome;
    let squadInterface: PuppetSquadInterface;
    let phaseChanged: Bool;
    if !this.RetryGetActionRecord(context) {
      return AIbehaviorUpdateOutcome.IN_PROGRESS;
    } else if !IsDefined(this.m_actionRecord) {
      this.m_actionDebugName = "No Action Record Selected";
      this.m_actionRecord = null;
      return AIbehaviorUpdateOutcome.FAILURE;
    } else if !this.m_lookatActivated {
      this.DeactivateLookat(context);
      if this.m_actionRecord.GetLookatsCount() > 0 {
        this.ActivateLookat(context);
      }
      this.m_lookatActivated = true;
    } else if !this.m_animationLoaded
      && this.m_actionRecord.WaitForAnimationToLoad()
      && this.WaitForAnimToLoad(context) {
      return AIbehaviorUpdateOutcome.IN_PROGRESS;
    } else if AISquadHelper
      .GetSquadBaseInterface(ScriptExecutionContext.GetOwner(context), squadInterface) {
      if !this.m_ticketsCommited {
        this.m_actionActivationTimeStamp = EngineTime.ToFloat(ScriptExecutionContext.GetAITime(context));
        this.m_startActionTimeStamp = 0.0;
        AIScriptSquad.CommitToTickets(context, this.m_actionRecord);
        this.m_ticketsCommited = true;
      } else if !this.m_ticketsAcknowledged {
        if AIScriptSquad.WaitForTicketsAcknowledgement(context, this.m_actionRecord) {
          if this.m_actionRecord.TicketAcknowledgeTimeout()
            > 0.0
            && this.GetActionDuration(context) > this.m_actionRecord.TicketAcknowledgeTimeout() {
            this.m_failureStatus = true;
            return AIbehaviorUpdateOutcome.FAILURE;
          }
          return AIbehaviorUpdateOutcome.IN_PROGRESS;
        }
        this.m_ticketsAcknowledged = true;
      } else if !this.m_initializedAfterActivation {
        this.m_actionActivationTimeStamp = EngineTime.ToFloat(ScriptExecutionContext.GetAITime(context));
        this.m_startActionTimeStamp = 0.0;
        this.ActivateGeneralSubActions(context);
        this.ChangeToNextPhase(context);
        this.TrackCommands(context, false);
        if IsDefined(this.m_actionRecord.AnimData()) {
          this.ActivateAnimData(context);
        }
        this.m_initializedAfterActivation = true;
      }
    }
    this.StartActionTimeStamp(context);
    if this.UpdateActivePhase(context, subActionsOutcome, phaseChanged) {
      switch subActionsOutcome {
        case AIbehaviorUpdateOutcome.FAILURE:
          this.m_failureStatus = true;
          return AIbehaviorUpdateOutcome.FAILURE;
        case AIbehaviorUpdateOutcome.SUCCESS:
          if !phaseChanged {
            this.ReactOnAllPhaseSubActionsCompleted(context);
          }
          return AIbehaviorUpdateOutcome.IN_PROGRESS;
      }
      return AIbehaviorUpdateOutcome.IN_PROGRESS;
    } else if this.m_failureStatus {
      return AIbehaviorUpdateOutcome.FAILURE;
    } else if this.m_actionRecord.CompleteWithFailure() {
      return AIbehaviorUpdateOutcome.FAILURE;
    }
    return AIbehaviorUpdateOutcome.SUCCESS;
  }

  protected func Deactivate(context: ScriptExecutionContext) {
    if !this.ChangePhaseTo(context, EAIActionPhase.Inactive) {
      AIbehaviortaskScript.SetUpdateInterval(context, 0.0);
    }
    this.DeactivateGeneralSubActions(context, this.GetActionDuration(context));
    this.DeactivateLookat(context);
    this.TrackCommands(context, true);
    if IsDefined(this.m_actionRecord) {
      this.DeactivateAnimationWrapperOverrides(context);
      if IsDefined(this.m_actionRecord.AnimData()) {
        this.DeactivateAnimData(context);
      }
      this.StartCooldowns(context);
      if IsDefined(this.m_actionRecord.AnimData()) && IsDefined(this.m_actionRecord.AnimData().AnimVariationSubAction()) {
        TweakAISubAction
          .Deactivate(
            context,
            this.m_actionRecord.AnimData().AnimVariationSubAction(),
            this.GetActionDuration(context),
            false
          );
      }
      AIScriptSquad.CompleteTickets(context, this.m_actionRecord, !this.m_failureStatus);
      AIScriptSquad.CloseTickets(context, this.m_actionRecord);
      if !IsFinal() {
        ScriptExecutionContext
          .GetTweakActionSystem(context)
          .Debug_OnActionEnded(context, this.m_actionRecord.GetID());
      }
    }
    this.m_initializedAfterActivation = false;
  }

  protected func ChildCompleted(context: ScriptExecutionContext, status: AIbehaviorCompletionStatus) {
    if Equals(status, AIbehaviorCompletionStatus.FAILURE) {
      this.m_failureStatus = true;
    }
  }

  private final func GetActionDuration(const context: ScriptExecutionContext) -> Float {
    if this.m_startActionTimeStamp == 0.0 {
      return EngineTime.ToFloat(ScriptExecutionContext.GetAITime(context)) - this.m_actionActivationTimeStamp;
    }
    return EngineTime.ToFloat(ScriptExecutionContext.GetAITime(context)) - this.m_startActionTimeStamp;
  }

  private final func GetTotalActionDuration() -> Float {
    let startup = this.m_actionRecord.Startup().Duration();
    let loop = this.m_actionRecord.Loop().Duration();
    let recovery = this.m_actionRecord.Recovery().Duration();
    if startup < 0.0 {
      startup = 0.0;
    } else if loop < 0.0 {
      loop = 0.0;
    } else if recovery < 0.0 {
      recovery = 0.0;
    }
    return startup + loop + recovery;
  }

  private final func IsActionImmediate() -> Bool {
    let startup = this.m_actionRecord.Startup().Duration();
    let loop = this.m_actionRecord.Loop().Duration();
    let recovery = this.m_actionRecord.Recovery().Duration();
    if startup < 0.0 {
      return false;
    } else if loop < 0.0 {
      return false;
    } else if recovery < 0.0 {
      return false;
    }
    return startup + loop + recovery <= 0.1;
  }

  private final func StartActionTimeStamp(const context: ScriptExecutionContext) {
    if this.m_startActionTimeStamp == 0.0 {
      this.m_startActionTimeStamp = EngineTime.ToFloat(ScriptExecutionContext.GetAITime(context));
    }
  }

  private final func HasTicketDeactivationCondition(const context: ScriptExecutionContext) -> Bool {
    let baseSquadRecord: wref<AISquadParams_Record>;
    let squadRecord: AISquadParams_Record;
    let ticket: AITicket_Record;
    let count = this.m_actionRecord.GetTicketsCount();
    if count > 0 {
      AIScriptSquad.GetBaseSquadRecord(baseSquadRecord);
      let i = 0;
      while i < count {
        let ticketType = this.m_actionRecord.GetTicketsItem(i);
        if AIScriptUtils
          .GetTicketType(
            ticketType.EnumName(),
            AIBehaviorScriptBase.GetPuppet(context),
            baseSquadRecord,
            ticket,
            squadRecord
          ) {
          if ticket.GetDeactivationConditionCount() > 0 {
            return true;
          }
        }
        i += 1;
      }
    }
    return false;
  }

  private final func SetPhaseUpdateInterval(
    const context: ScriptExecutionContext,
    subActionsOutcome: AIbehaviorUpdateOutcome,
    generalSubActionsOutcome: AIbehaviorUpdateOutcome
  ) {
    let phaseDuration: Float;
    if Equals(this.m_actionPhase, EAIActionPhase.Inactive) {
      return;
    } else if this.m_isActionImmediate {
      return;
    } else if this.m_phaseDuration < 0.0 {
      phaseDuration = 9.99999e5;
    }
    phaseDuration = this.m_phaseDuration;
    if this.m_tickForActionDurationOnly {
      AIbehaviortaskScript.SetUpdateInterval(context, phaseDuration);
      this.m_tickForActionDurationActivePhase = this.m_actionPhase;
      return;
    } else if this.m_phaseSubActionsCount > 0 && Equals(subActionsOutcome, AIbehaviorUpdateOutcome.IN_PROGRESS) {
      return;
    } else if this.m_phaseSubActionsCount
      == 0
      && this.m_generalSubActionsCount > 0
      && Equals(generalSubActionsOutcome, AIbehaviorUpdateOutcome.IN_PROGRESS) {
      return;
    } else if (this.m_nextPhaseConditionCount
      > 0
      || this.m_hasGracefulInterruptionConditions
      || this.m_hasTicketDeactivationConditions) && this.m_phaseDuration > 0.0 {
      return;
    } else if this.m_phaseForceZeroUpdateInterval {
      AIbehaviortaskScript.SetUpdateInterval(context, 0.0);
      return;
    } else if this.m_hasGracefulInterruptionConditions && this.m_nextPhaseConditionCount > 0 {
      if this.m_gracefulInterruptionCheckRandomizedInterval < this.m_phaseConditionCheckRandomizedInterval {
        AIbehaviortaskScript
          .SetUpdateInterval(context, this.m_gracefulInterruptionCheckRandomizedInterval);
        return;
      }
    }
    AIbehaviortaskScript.SetUpdateInterval(context, this.m_phaseConditionCheckRandomizedInterval);
    return;
  }

  private final func UpdateActivePhase(
    const context: ScriptExecutionContext,
    out subActionsOutcome: AIbehaviorUpdateOutcome,
    out phaseChanged: Bool
  ) -> Bool {
    let generalSubActionsOutcome: AIbehaviorUpdateOutcome;
    if Equals(this.m_actionPhase, EAIActionPhase.Inactive) {
      return false;
    } else if !IsDefined(this.m_phaseRecord) {
      phaseChanged = this.ChangeToNextPhase(context);
      return Equals(this.m_actionPhase, EAIActionPhase.Inactive) ? false : true;
    }
    subActionsOutcome = this.UpdateSubActions(context, generalSubActionsOutcome);
    if this.m_nextPhaseConditionCount > 0 {
      if this.m_phaseConditionCheckRandomizedInterval
        <= 0.0
        || this.m_phaseConditionCheckRandomizedInterval
          > 0.0
          && EngineTime.ToFloat(ScriptExecutionContext.GetAITime(context))
            >= this.m_phaseConditionCheckTimeStamp + this.m_phaseConditionCheckRandomizedInterval {
        if AICondition
          .NextPhaseCheck(context, EnumInt(this.m_actionPhase), this.m_actionRecord) {
          if this.m_phaseRecord.ConditionSuccessDuration() > 0.0 && this.m_phaseConditionSuccessfulCheckTimeStamp < 0.0 {
            this.m_phaseConditionSuccessfulCheckTimeStamp = EngineTime.ToFloat(ScriptExecutionContext.GetAITime(context));
          } else if IsDefined(this.m_phaseRecord) && this.m_phaseRecord.CompleteActionWithFailureOnCondition() {
            this.m_failureStatus = true;
          } else if this.m_phaseRecord.ConditionSuccessDuration()
            <= 0.0
            || this.m_phaseRecord.ConditionSuccessDuration()
              > 0.0
              && EngineTime.ToFloat(ScriptExecutionContext.GetAITime(context))
                >= this.m_phaseConditionSuccessfulCheckTimeStamp + this.m_phaseRecord.ConditionSuccessDuration() {
            phaseChanged = this.ChangeToNextPhase(context);
          }
        } else {
          this.m_phaseConditionSuccessfulCheckTimeStamp = -1.0;
        }
        this.m_phaseConditionCheckTimeStamp = EngineTime.ToFloat(ScriptExecutionContext.GetAITime(context));
      } else if this.m_tickForActionDurationOnly
        && Equals(this.m_tickForActionDurationActivePhase, this.m_actionPhase)
        || (this.m_phaseDuration
          == 0.0
          || this.m_phaseDuration
            > 0.0
            && this.GetPhaseDurationWithoutFrameDelta(context) >= this.m_phaseDuration) {
        if !this.RepeatPhase(context) {
          if Equals(subActionsOutcome, AIbehaviorUpdateOutcome.SUCCESS) {
            subActionsOutcome = AIbehaviorUpdateOutcome.IN_PROGRESS;
          }
          phaseChanged = this.ChangeToNextPhase(context);
        }
      }
    }
    this
      .SetPhaseUpdateInterval(context, subActionsOutcome, generalSubActionsOutcome);
    return Equals(this.m_actionPhase, EAIActionPhase.Inactive) ? false : true;
  }

  private final func UpdateSubActions(const context: ScriptExecutionContext, out generalResult: AIbehaviorUpdateOutcome) -> AIbehaviorUpdateOutcome {
    let phaseResult: AIbehaviorUpdateOutcome;
    generalResult = this.UpdateGeneralSubActions(context, this.GetActionDuration(context));
    switch this.m_actionPhase {
      case EAIActionPhase.Startup:
        phaseResult = this
          .UpdateStartupSubActions(context, this.GetPhaseDuration(context), this.m_phaseSubActionsCount);
        break;
      case EAIActionPhase.Loop:
        phaseResult = this
          .UpdateLoopSubActions(context, this.GetPhaseDuration(context), this.m_phaseSubActionsCount);
        break;
      case EAIActionPhase.Recovery:
        phaseResult = this
          .UpdateRecoverySubActions(context, this.GetPhaseDuration(context), this.m_phaseSubActionsCount);
        break;
      default:
        if Equals(generalResult, AIbehaviorUpdateOutcome.FAILURE) {
          return generalResult;
        } else if this.m_actionRecord.SubActionsCanCompleteAction()
          && this.m_phaseSubActionsCount == 0
          && Equals(generalResult, AIbehaviorUpdateOutcome.SUCCESS) {
          return generalResult;
        }
    }
    return phaseResult;
  }

  private final func UpdateGeneralSubActions(const context: ScriptExecutionContext, const duration: Float) -> AIbehaviorUpdateOutcome {
    let countSuccess: Int32;
    let countFailure: Int32;
    let subActionCount = this.m_actionRecord.GetSubActionsCount();
    if subActionCount == 0 {
      return AIbehaviorUpdateOutcome.IN_PROGRESS;
    }
    let i = 0;
    while i < subActionCount {
      if Equals(this.m_generalSubActionsResults[i], AIbehaviorUpdateOutcome.IN_PROGRESS) {
        let subAction = this.m_actionRecord.GetSubActionsItem(i);
        this.m_generalSubActionsResults[i] = TweakAISubAction.Update(context, subAction, duration);
      } else if Equals(this.m_generalSubActionsResults[i], AIbehaviorUpdateOutcome.FAILURE) {
        countFailure += 1;
      } else if Equals(this.m_generalSubActionsResults[i], AIbehaviorUpdateOutcome.SUCCESS) {
        countSuccess += 1;
      }
      i += 1;
    }
    if countFailure > 0 {
      return AIbehaviorUpdateOutcome.FAILURE;
    }
    if countSuccess >= subActionCount {
      return AIbehaviorUpdateOutcome.SUCCESS;
    }
    return AIbehaviorUpdateOutcome.IN_PROGRESS;
  }

  private final func UpdateStartupSubActions(const context: ScriptExecutionContext, const duration: Float, subActionCount: Int32) -> AIbehaviorUpdateOutcome {
    let countSuccess: Int32;
    let countFailure: Int32;
    subActionCount = this.m_actionRecord.GetStartupSubActionsCount();
    if subActionCount == 0 {
      return AIbehaviorUpdateOutcome.IN_PROGRESS;
    }
    let i = 0;
    while i < subActionCount {
      if Equals(this.m_phaseSubActionsResults[i], AIbehaviorUpdateOutcome.IN_PROGRESS) {
        let subAction = this.m_actionRecord.GetStartupSubActionsItem(i);
        this.m_phaseSubActionsResults[i] = TweakAISubAction.Update(context, subAction, duration);
      } else if Equals(this.m_phaseSubActionsResults[i], AIbehaviorUpdateOutcome.FAILURE) {
        countFailure += 1;
      } else if Equals(this.m_phaseSubActionsResults[i], AIbehaviorUpdateOutcome.SUCCESS) {
        countSuccess += 1;
      }
      i += 1;
    }
    if countFailure > 0 {
      return AIbehaviorUpdateOutcome.FAILURE;
    }
    if countSuccess >= subActionCount {
      return AIbehaviorUpdateOutcome.SUCCESS;
    }
    return AIbehaviorUpdateOutcome.IN_PROGRESS;
  }

