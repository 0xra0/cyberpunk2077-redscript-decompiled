  public func OnEnter(stateContext: StateContext, scriptInterface: StateGameScriptInterface) {
    super.OnEnter(stateContext, scriptInterface);
    if scriptInterface.GetOwnerStateVectorParameterFloat(physicsStateValue.LinearSpeed) > 2.5 {
      this
        .SetBlackboardIntVariable(scriptInterface, GetAllBlackboardDefs().PlayerStateMachine.Locomotion, 2);
      stateContext.SetConditionBoolParameter(n"CrouchToggled", false, true);
      scriptInterface.PushAnimationEvent(n"Jump");
      scriptInterface.SetAnimationParameterFloat(n"sprint", 0.1);
