class Crosshair_Melee_Nano_Wire extends CrosshairGameController_Melee {
  private let m_animEnterADS: inkAnimProxy;
  private let m_inAimDownSight: Bool;
  private let m_isHoveringOfficer: Bool;
  private let m_inChargedHold: Bool;
  private let anim_EnterHipFire: inkAnimProxy;
  private let anim_HoverEnterEnemy: inkAnimProxy;
  private let anim_EnterStrongAttack: inkAnimProxy;
  private let anim_EnterThrowAttack: inkAnimProxy;
  private let anim_EnterEveryOtherAttack: inkAnimProxy;
  private let anim_EnterChargedHold: inkAnimProxy;
  private let anim_HoverExitEnemy: inkAnimProxy;

  public func GetIntroAnimation(firstEquip: Bool) -> inkAnimProxy {
    let anim = new inkAnimDef();
    let alphaInterpolator = new inkAnimTransparency();
    alphaInterpolator.SetStartTransparency(0.0);
    alphaInterpolator.SetEndTransparency(1.0);
    alphaInterpolator.SetDuration(0.25);
    alphaInterpolator.SetType(inkanimInterpolationType.Linear);
    alphaInterpolator.SetMode(inkanimInterpolationMode.EasyIn);
    anim.AddInterpolator(alphaInterpolator);
    return this.m_rootWidget.PlayAnimation(anim);
  }

  public func GetOutroAnimation() -> inkAnimProxy {
    let anim = new inkAnimDef();
    let alphaInterpolator = new inkAnimTransparency();
    alphaInterpolator.SetStartTransparency(1.0);
    alphaInterpolator.SetEndTransparency(0.0);
    alphaInterpolator.SetDuration(0.25);
    alphaInterpolator.SetType(inkanimInterpolationType.Linear);
    alphaInterpolator.SetMode(inkanimInterpolationMode.EasyIn);
    anim.AddInterpolator(alphaInterpolator);
    return this.m_rootWidget.PlayAnimation(anim);
  }

  protected func ApplyCrosshairGUIState(state: CName, aimedAtEntity: Entity) {
    let aimedAtGameObject = aimedAtEntity as GameObject;
    let puppet = aimedAtGameObject as ScriptedPuppet;
    this.m_isHoveringOfficer = Equals(puppet.GetNPCRarity(), gamedataNPCRarity.Officer);
    if Equals(state, n"Hostile") {
      if this.m_inAimDownSight && this.m_isHoveringOfficer {
        if !this.anim_HoverEnterEnemy.IsPlaying() {
          this.anim_HoverEnterEnemy = this.PlayLibraryAnimation(n"HoverEnterEnemy");
        }
      }
    } else if !this.anim_HoverExitEnemy.IsPlaying() {
      this.anim_HoverExitEnemy = this.PlayLibraryAnimation(n"HoverExitEnemy");
    }
    super.ApplyCrosshairGUIState(state, aimedAtEntity);
  }

  protected func OnMeleeState_Update(value: gamePSMMeleeWeapon) {
    if Equals(value, gamePSMMeleeWeapon.Idle)
      || Equals(value, gamePSMMeleeWeapon.Default)
      || Equals(value, gamePSMMeleeWeapon.Equipping) {
      if this.m_animEnterADS.IsPlaying() {
        this.m_animEnterADS.Stop();
      } else if !this.anim_EnterHipFire.IsPlaying() {
        this.anim_EnterHipFire = this.PlayLibraryAnimation(n"EnterHipFire");
      }
    } else if Equals(value, gamePSMMeleeWeapon.Targeting) {
      if !this.m_animEnterADS.IsPlaying() {
        this.m_animEnterADS = this.PlayLibraryAnimation(n"EnterAimDownSight");
      } else if this.m_isHoveringOfficer {
        if !this.anim_HoverEnterEnemy.IsPlaying() {
          this.anim_HoverEnterEnemy = this.PlayLibraryAnimation(n"HoverEnterEnemy");
        }
      } else if Equals(value, gamePSMMeleeWeapon.StrongAttack) {
        if !this.anim_EnterStrongAttack.IsPlaying() {
          this.anim_EnterStrongAttack = this.PlayLibraryAnimation(n"EnterStrongAttack");
        }
      } else if Equals(value, gamePSMMeleeWeapon.ThrowAttack) {
        if !this.anim_EnterThrowAttack.IsPlaying() {
          this.anim_EnterThrowAttack = this.PlayLibraryAnimation(n"EnterThrowAttack");
        }
      } else if Equals(value, gamePSMMeleeWeapon.ComboAttack)
        || Equals(value, gamePSMMeleeWeapon.FinalAttack)
        || Equals(value, gamePSMMeleeWeapon.SafeAttack)
        || Equals(value, gamePSMMeleeWeapon.BlockAttack)
        || Equals(value, gamePSMMeleeWeapon.SprintAttack)
        || Equals(value, gamePSMMeleeWeapon.CrouchAttack)
        || Equals(value, gamePSMMeleeWeapon.JumpAttack) {
        if !this.anim_EnterEveryOtherAttack.IsPlaying() {
          this.anim_EnterEveryOtherAttack = this.PlayLibraryAnimation(n"EnterEveryOtherAttack");
        }
      } else if Equals(value, gamePSMMeleeWeapon.ChargedHold) {
        this.m_inChargedHold = true;
        if !this.anim_EnterChargedHold.IsPlaying() {
          this.anim_EnterChargedHold = this.PlayLibraryAnimation(n"EnterChargedHold");
        }
      } else if this.m_inChargedHold && NotEquals(value, gamePSMMeleeWeapon.ChargedHold) {
        this.m_inChargedHold = false;
        if !this.anim_EnterHipFire.IsPlaying() {
          this.anim_EnterHipFire = this.PlayLibraryAnimation(n"EnterHipFire");
        }
      }
    }
    this.m_inAimDownSight = Equals(value, gamePSMMeleeWeapon.Targeting);
    super.OnMeleeState_Update(value);
  }
}

