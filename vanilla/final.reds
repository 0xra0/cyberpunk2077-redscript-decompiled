  public const func ShouldShowScanner() -> Bool {
    if this.m_scanningComponent.IsBraindanceBlocked() || this.m_scanningComponent.IsPhotoModeBlocked() {
      return false;
    } else if NotEquals(this.GetCurrentGameplayRole(), EGameplayRole.None) {
      return true;
    }
    break;
    return super.ShouldShowScanner();
  }

  protected func FillObjectDescription(out arr: [ScanningTooltipElementDef]) {
    if !this.GetDevicePS().IsDisabled() {
      super.FillObjectDescription(arr);
    }
  }

  public const func CompileScannerChunks() -> Bool {
    let vulnerability: Vulnerability;
    let devicePS = this.GetDevicePS();
    let scannerBlackboard = GameInstance
      .GetBlackboardSystem(this.GetGame())
      .Get(GetAllBlackboardDefs().UI_ScannerModules);
    if !IsDefined(devicePS) || !IsDefined(scannerBlackboard) {
      return false;
    } else if devicePS.IsDisabled() {
      return false;
    }
    scannerBlackboard.SetInt(GetAllBlackboardDefs().UI_ScannerModules.ObjectType, 3, true);
    let aps = devicePS.GetAccessPoints();
    let nameChunk = new ScannerName();
    nameChunk.Set(this.GetScannerName());
    scannerBlackboard
      .SetVariant(GetAllBlackboardDefs().UI_ScannerModules.ScannerName, ToVariant(nameChunk));
    let keycards = devicePS.GetKeycards();
    let passwords = devicePS.GetPasswords();
    if ArraySize(keycards) > 0 || ArraySize(passwords) > 0 {
      let authorizationChunk = new ScannerAuthorization();
      authorizationChunk.Set(ArraySize(keycards) > 0, ArraySize(passwords) > 0);
      scannerBlackboard
        .SetVariant(
          GetAllBlackboardDefs().UI_ScannerModules.ScannerAuthorization,
          ToVariant(authorizationChunk)
        );
    } else if devicePS.ShouldScannerShowNetwork() {
      let networkStatusChunk = new ScannerNetworkStatus();
      if ArraySize(aps) > 0 {
        let networkLevelChunk = new ScannerNetworkLevel();
        networkLevelChunk
          .Set(
            aps[0]
              .GetSkillCheckContainer()
              .GetHackingSlot()
              .GetBaseSkill()
              .GetRequiredLevel(this.GetGame())
          );
        scannerBlackboard
          .SetVariant(
            GetAllBlackboardDefs().UI_ScannerModules.ScannerNetworkLevel,
            ToVariant(networkLevelChunk)
          );
        if aps[0].IsBreached() {
          networkStatusChunk.Set(ScannerNetworkState.BREACHED);
        }
        networkStatusChunk.Set(ScannerNetworkState.NOT_BREACHED);
      }
      networkStatusChunk.Set(ScannerNetworkState.NOT_CONNECTED);
      scannerBlackboard
        .SetVariant(
          GetAllBlackboardDefs().UI_ScannerModules.ScannerNetworkStatus,
          ToVariant(networkStatusChunk)
        );
    } else if devicePS.ShouldScannerShowAttitude() {
      let attitudeChunk = new ScannerAttitude();
      attitudeChunk
        .Set(
          this
            .GetAttitudeTowards(
              GameInstance
                .GetPlayerSystem(this.GetGame())
                .GetLocalPlayerControlledGameObject()
            )
        );
      scannerBlackboard
        .SetVariant(
          GetAllBlackboardDefs().UI_ScannerModules.ScannerAttitude,
          ToVariant(attitudeChunk)
        );
    } else if devicePS.ShouldScannerShowStatus() {
      let deviceStatusChunk = new ScannerDeviceStatus();
      deviceStatusChunk
        .Set(
          LocKeyToString(
            TweakDBInterface
              .GetScannableDataRecord(devicePS.GetScannerStatusRecord())
              .LocalizedDescription()
          )
        );
      deviceStatusChunk
        .SetFriendlyName(
          TweakDBInterface
            .GetScannableDataRecord(devicePS.GetScannerStatusRecord())
            .FriendlyName()
        );
      scannerBlackboard
        .SetVariant(
          GetAllBlackboardDefs().UI_ScannerModules.ScannerDeviceStatus,
          ToVariant(deviceStatusChunk)
        );
    } else if devicePS.ShouldScannerShowHealth() {
      let healthChunk = new ScannerHealth();
      healthChunk
        .Set(Cast<Int32>(this.GetCurrentHealth()), Cast<Int32>(this.GetTotalHealth()));
      scannerBlackboard
        .SetVariant(
          GetAllBlackboardDefs().UI_ScannerModules.ScannerHealth,
          ToVariant(healthChunk)
        );
    }
    let vulnerabilities = devicePS.GetAllQuickHackVulnerabilities();
    if ArraySize(vulnerabilities) > 0 {
      let vulnerabilitiesChunk = new ScannerVulnerabilities();
      let i = 0;
      while i < ArraySize(vulnerabilities) {
        let record = TweakDBInterface.GetScannableDataRecord(vulnerabilities[i]);
        if IsDefined(record) {
          vulnerability.vulnerabilityName = record.LocalizedDescription();
          vulnerability.icon = record.IconRecord().GetID();
          vulnerability.isActive = this.CanPlayerUseQuickHackVulnerability(vulnerabilities[i]);
          vulnerabilitiesChunk.PushBack(vulnerability);
        }
        i += 1;
      }
      if vulnerabilitiesChunk.IsValid() {
        scannerBlackboard
          .SetVariant(
            GetAllBlackboardDefs().UI_ScannerModules.ScannerVulnerabilities,
            ToVariant(vulnerabilitiesChunk)
          );
      }
    }
    let connectionsChunk = new ScannerConnections();
    connectionsChunk.Set(devicePS.GetUniqueConnectionTypes());
    if connectionsChunk.IsValid() {
      scannerBlackboard
        .SetVariant(
          GetAllBlackboardDefs().UI_ScannerModules.ScannerConnections,
          ToVariant(connectionsChunk)
        );
    }
    let skillchecks = devicePS
      .CreateSkillcheckInfo(
        devicePS
          .GenerateContext(
            gamedeviceRequestType.Direct,
            Device.GetInteractionClearance(),
            this.GetPlayerMainObject(),
            this.GetEntityID()
          )
      );
    if ArraySize(skillchecks) > 0 && this.IsActive() {
      let skillchecksChunk = new ScannerSkillchecks();
      skillchecksChunk.Set(skillchecks);
      skillchecksChunk.SetAuthorization(devicePS.IsDeviceSecured());
      skillchecksChunk
        .SetPlayerAuthorization(devicePS.IsUserAuthorized(GetPlayerObject(this.GetGame()).GetEntityID()));
      scannerBlackboard
        .SetVariant(
          GetAllBlackboardDefs().UI_ScannerModules.ScannerSkillChecks,
          ToVariant(skillchecksChunk)
        );
    }
    return true;
  }

  protected const func GetScannerName() -> String {
