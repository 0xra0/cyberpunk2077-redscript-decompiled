class InvestedPerksPrereq extends IScriptablePrereq {
  public let m_amount: Int32;
  public let m_proficiency: gamedataProficiencyType;

  protected func Initialize(recordID: TweakDBID) {
    let str = TweakDBInterface.GetString(recordID + t".proficiency", "");
    this.m_proficiency = IntEnum<gamedataProficiencyType>(Cast<Int32>(EnumValueFromString("gamedataProficiencyType", str)));
    this.m_amount = TweakDBInterface.GetInt(recordID + t".amount", 0);
  }

  public const func IsFulfilled(game: GameInstance, context: IScriptable) -> Bool {
    let owner = context as GameObject;
    return PlayerDevelopmentSystem.GetData(owner).GetInvestedPerkPoints(this.m_proficiency) >= this.m_amount;
  }

  public const final func GetRequiredAmount() -> Int32 {
    return this.m_amount;
  }

  public const final func GetProficiencyType() -> gamedataProficiencyType {
    return this.m_proficiency;
  }
}

class SkillCheckPrereqState extends PrereqState {
  public const final func GetSkillToCheck() -> gamedataProficiencyType {
    return (this.GetPrereq() as SkillCheckPrereq).GetSkillToCheck();
  }

  public final func UpdateSkillCheckPrereqData(obj: GameObject, newLevel: Int32) {
    let checkPassed = (this.GetPrereq() as SkillCheckPrereq).IsFulfilled(obj.GetGame(), this.GetContext());
    this.OnChanged(checkPassed);
  }
}

class DevelopmentCheckPrereq extends IScriptablePrereq {
  protected let requiredLevel: Float;

  protected func Initialize(recordID: TweakDBID) {
    let tweakID = recordID;
    TDBID.Append(tweakID, t".requiredLevel");
    this.requiredLevel = TDB.GetFloat(tweakID);
  }
}

class SkillCheckPrereq extends DevelopmentCheckPrereq {
  protected let skillToCheck: gamedataProficiencyType;

  public const final func GetSkillToCheck() -> gamedataProficiencyType {
    return this.skillToCheck;
  }

  protected const func OnRegister(state: PrereqState, game: GameInstance, context: IScriptable) -> Bool {
    let castedState = state as SkillCheckPrereqState;
    let player = context as PlayerPuppet;
    if IsDefined(player) {
      let request = new ModifySkillCheckPrereq();
      request.Set(player, true, castedState);
      GameInstance
        .GetScriptableSystemsContainer(game)
        .Get(n"PlayerDevelopmentSystem")
        .QueueRequest(request);
      return this.IsFulfilled(game, context);
    }
    return false;
  }

  protected const func OnUnregister(state: PrereqState, game: GameInstance, context: IScriptable) {
    let castedState = state as SkillCheckPrereqState;
    let player = context as PlayerPuppet;
    if IsDefined(player) {
      let request = new ModifySkillCheckPrereq();
      request.Set(player, false, castedState);
      GameInstance
        .GetScriptableSystemsContainer(game)
        .Get(n"PlayerDevelopmentSystem")
        .QueueRequest(request);
    }
  }

  public const func IsFulfilled(game: GameInstance, context: IScriptable) -> Bool {
    let player = GetPlayer(game);
    let skillLevel = (GameInstance.GetScriptableSystemsContainer(game).Get(n"PlayerDevelopmentSystem") as PlayerDevelopmentSystem).GetProficiencyLevel(player, this.skillToCheck);
    return Cast<Float>(skillLevel) >= this.requiredLevel;
  }

  protected func Initialize(recordID: TweakDBID) {
    super.Initialize(recordID);
    let tweakID = recordID;
    TDBID.Append(tweakID, t".skillToCheck");
    let type = TDB.GetCName(tweakID);
    this.skillToCheck = IntEnum<gamedataProficiencyType>(Cast<Int32>(EnumValueFromName(n"gamedataProficiencyType", type)));
  }
}

