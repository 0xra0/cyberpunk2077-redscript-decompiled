abstract class AISubActionEquipOnSlot_Record_Implementation extends IScriptable {
  public final static func Activate(context: ScriptExecutionContext, record: wref<AISubActionEquipOnSlot_Record>) {
    let cleanupDone: Bool;
    let BBoard = (ScriptExecutionContext.GetOwner(context) as ScriptedPuppet).GetAIControllerComponent().GetActionBlackboard();
    if IsDefined(BBoard) {
      let itemsToEquip = FromVariant<[NPCItemToEquip]>(BBoard.GetVariant(GetAllBlackboardDefs().AIAction.ownerItemsToEquip));
      if ArraySize(itemsToEquip) != 0 {
        let transactionSystem = GameInstance.GetTransactionSystem(ScriptExecutionContext.GetOwner(context).GetGame());
        if IsDefined(transactionSystem) {
          let i = 0;
          if i < ArraySize(itemsToEquip) {
            if !(ScriptExecutionContext.GetOwner(context) as ScriptedPuppet).IsMechanical() {
              if cleanupDone {
              } else if !transactionSystem
                .IsSlotEmpty(
                  ScriptExecutionContext.GetOwner(context),
                  t"AttachmentSlots.WeaponLeft"
                )
                && !transactionSystem
                  .IsSlotEmptySpawningItem(
                    ScriptExecutionContext.GetOwner(context),
                    t"AttachmentSlots.WeaponLeft"
                  ) {
                let itemToRemove = transactionSystem
                  .GetItemInSlot(
                    ScriptExecutionContext.GetOwner(context),
                    t"AttachmentSlots.WeaponLeft"
                  );
                if !transactionSystem
                  .HasItemInSlot(
                    ScriptExecutionContext.GetOwner(context),
                    t"AttachmentSlots.WeaponLeft",
                    itemsToEquip[i].itemID
                  )
                  && transactionSystem
                    .RemoveItemFromSlot(
                      ScriptExecutionContext.GetOwner(context),
                      t"AttachmentSlots.WeaponLeft",
                      true
                    ) {
                  NPCPuppet
                    .SetAnimWrapperBasedOnEquippedItem(
                      ScriptExecutionContext.GetOwner(context) as NPCPuppet,
                      t"AttachmentSlots.WeaponLeft",
                      itemToRemove.GetItemID(),
                      0.0
                    );
                } else if !transactionSystem
                  .IsSlotEmpty(
                    ScriptExecutionContext.GetOwner(context),
                    t"AttachmentSlots.WeaponRight"
                  )
                  && !transactionSystem
                    .IsSlotEmptySpawningItem(
                      ScriptExecutionContext.GetOwner(context),
                      t"AttachmentSlots.WeaponRight"
                    ) {
                  itemToRemove = transactionSystem
                    .GetItemInSlot(
                      ScriptExecutionContext.GetOwner(context),
                      t"AttachmentSlots.WeaponRight"
                    );
                  if !transactionSystem
                    .HasItemInSlot(
                      ScriptExecutionContext.GetOwner(context),
                      t"AttachmentSlots.WeaponLeft",
                      itemsToEquip[i].itemID
                    )
                    && transactionSystem
                      .RemoveItemFromSlot(
                        ScriptExecutionContext.GetOwner(context),
                        t"AttachmentSlots.WeaponRight",
                        true
                      ) {
                    NPCPuppet
                      .SetAnimWrapperBasedOnEquippedItem(
                        ScriptExecutionContext.GetOwner(context) as NPCPuppet,
                        t"AttachmentSlots.WeaponRight",
                        itemToRemove.GetItemID(),
                        0.0
                      );
                  } else {
                    cleanupDone = true;
                  }
                } else if !transactionSystem
                  .IsSlotEmpty(
                    ScriptExecutionContext.GetOwner(context),
                    itemsToEquip[i].slotID
                  )
                  && !transactionSystem
                    .IsSlotEmptySpawningItem(
                      ScriptExecutionContext.GetOwner(context),
                      itemsToEquip[i].slotID
                    ) {
                  itemToRemove = transactionSystem
                    .GetItemInSlot(
                      ScriptExecutionContext.GetOwner(context),
                      itemsToEquip[i].slotID
                    );
                  if !transactionSystem
                    .HasItemInSlot(
                      ScriptExecutionContext.GetOwner(context),
                      itemsToEquip[i].slotID,
                      itemsToEquip[i].itemID
                    )
                    && transactionSystem
                      .RemoveItemFromSlot(
                        ScriptExecutionContext.GetOwner(context),
                        itemsToEquip[i].slotID,
                        true
                      ) {
                    NPCPuppet
                      .SetAnimWrapperBasedOnEquippedItem(
                        ScriptExecutionContext.GetOwner(context) as NPCPuppet,
                        itemsToEquip[i].slotID,
                        itemToRemove.GetItemID(),
                        0.0
                      );
                  }
                }
              }
            }
            i += 1;
          } else if BBoard.GetFloat(GetAllBlackboardDefs().AIAction.ownerEquipDuration) > 0.0 {
            AISubActionEquipOnSlot_Record_Implementation
              .ApplyAnimFeature(context, itemsToEquip, record.UseItemSpawnDelayFromWeapon());
          } else if !record.UseItemSpawnDelayFromWeapon()
            || BBoard.GetFloat(GetAllBlackboardDefs().AIAction.ownerEquipItemTime) == 0.0 {
            AISubActionEquipOnSlot_Record_Implementation.Equip(context, itemsToEquip, record.CacheEquippedItem());
          }
        }
      }
    }
  }

  public final static func Update(
    context: ScriptExecutionContext,
    record: wref<AISubActionEquipOnSlot_Record>,
    const duration: Float
  ) -> AIbehaviorUpdateOutcome {
    let BBoard = (ScriptExecutionContext.GetOwner(context) as ScriptedPuppet).GetAIControllerComponent().GetActionBlackboard();
    if IsDefined(BBoard) {
      if duration < BBoard.GetFloat(GetAllBlackboardDefs().AIAction.ownerEquipDuration) {
        if record.UseItemSpawnDelayFromWeapon() {
          let itemsToEquip = FromVariant<[NPCItemToEquip]>(BBoard.GetVariant(GetAllBlackboardDefs().AIAction.ownerItemsToEquip));
          if ArraySize(itemsToEquip) != 0 {
            let equipTime = BBoard.GetFloat(GetAllBlackboardDefs().AIAction.ownerEquipItemTime);
            if equipTime > 0.0 && duration > equipTime {
              AISubActionEquipOnSlot_Record_Implementation.Equip(context, itemsToEquip, record.CacheEquippedItem());
            }
          }
        }
        return AIbehaviorUpdateOutcome.IN_PROGRESS;
      }
      return AIbehaviorUpdateOutcome.SUCCESS;
    }
    return AIbehaviorUpdateOutcome.FAILURE;
  }

  public final static func Deactivate(
    context: ScriptExecutionContext,
    record: wref<AISubActionEquipOnSlot_Record>,
    const duration: Float,
    interrupted: Bool
  ) {
    let BBoard = (ScriptExecutionContext.GetOwner(context) as ScriptedPuppet).GetAIControllerComponent().GetActionBlackboard();
    if IsDefined(BBoard) {
      let itemsToEquip = FromVariant<[NPCItemToEquip]>(BBoard.GetVariant(GetAllBlackboardDefs().AIAction.ownerItemsToEquip));
      if ArraySize(itemsToEquip) != 0 {
        AISubActionEquipOnSlot_Record_Implementation.Equip(context, itemsToEquip, record.CacheEquippedItem());
      } else if BBoard.GetFloat(GetAllBlackboardDefs().AIAction.ownerEquipDuration) > 0.0 {
        AnimationControllerComponent
          .ApplyFeatureToReplicate(
            ScriptExecutionContext.GetOwner(context),
            n"Equip",
            new AnimFeature_AIAction()
          );
      }
      BBoard.SetFloat(GetAllBlackboardDefs().AIAction.ownerEquipDuration, 0.0);
    }
  }

  public final static func ApplyAnimFeature(
    context: ScriptExecutionContext,
    const itemsToEquip: script_ref<[NPCItemToEquip]>,
    sendAnimFeature: Bool
  ) {
    let animFeature = new AnimFeature_AIAction();
    animFeature.state = 1;
    animFeature.stateDuration = -1.0;
    if ArraySize(itemsToEquip) > 1 {
      animFeature.animVariation = 2;
    } else if GameInstance
      .GetTransactionSystem(ScriptExecutionContext.GetOwner(context).GetGame())
      .HasTag(
        ScriptExecutionContext.GetOwner(context),
        n"MeleeWeapon",
        itemsToEquip[0].itemID
      ) {
      animFeature.animVariation = 1;
    } else {
      animFeature.animVariation = 0;
    }
    if sendAnimFeature {
      let i = 0;
      while i < ArraySize(itemsToEquip) {
        NPCPuppet
          .SetAnimWrapperBasedOnEquippedItem(
            ScriptExecutionContext.GetOwner(context) as NPCPuppet,
            itemsToEquip[i].slotID,
            itemsToEquip[i].itemID,
            1.0
          );
        i += 1;
      }
    }
    AnimationControllerComponent
      .ApplyFeatureToReplicate(ScriptExecutionContext.GetOwner(context), n"Equip", animFeature);
  }

  public final static func Equip(
    context: ScriptExecutionContext,
    const itemsToEquip: script_ref<[NPCItemToEquip]>,
    cacheEquipped: Bool
  ) -> Bool {
    let result: Bool;
    let reservedEquipSlotIDs: [TweakDBID];
    let equipOnBody = TweakDBInterface.GetBool(t"AIGeneralSettings.displayWeaponsOnBody", equipOnBody);
    let highPriority = false;
    let owner = ScriptExecutionContext.GetOwner(context);
    if Equals(ScriptedPuppet.IsActive(owner), false) {
      return false;
    }
    let transactionSystem = GameInstance.GetTransactionSystem(owner.GetGame());
    if !IsDefined(transactionSystem) {
      return false;
    }
    let i = 0;
    while i < ArraySize(itemsToEquip) {
      if ArrayContains(reservedEquipSlotIDs, itemsToEquip[i].slotID) {
      } else if equipOnBody
        && transactionSystem
          .HasItemInSlot(owner, itemsToEquip[i].bodySlotID, itemsToEquip[i].itemID) {
        result = transactionSystem
          .ChangeItemToSlot(owner, itemsToEquip[i].slotID, itemsToEquip[i].itemID);
        if result {
          ArrayPush(reservedEquipSlotIDs, itemsToEquip[i].slotID);
        }
      } else {
        highPriority = NotEquals(
          WeaponObject.GetWeaponType(itemsToEquip[i].itemID),
          gamedataItemType.Invalid
        );
        result = transactionSystem
          .AddItemToSlot(
            owner,
            itemsToEquip[i].slotID,
            itemsToEquip[i].itemID,
            highPriority,
            !cacheEquipped
          );
        if result {
          ArrayPush(reservedEquipSlotIDs, itemsToEquip[i].slotID);
        }
      }
      i += 1;
    }
    if result {
      AIActionHelper.ClearItemsToEquip(owner as ScriptedPuppet);
    }
    return result;
  }
}

