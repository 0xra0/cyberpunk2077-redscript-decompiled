  public final static func SetDesiredCoverStance(puppet: ScriptedPuppet, value: gameCoverHeight) {
    return puppet
      .GetAIControllerComponent()
      .GetCoverBlackboard()
      .SetName(
        GetAllBlackboardDefs().AICover.desiredCoverStance,
