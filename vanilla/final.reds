class ScavengeComponent extends ScriptableComponent {
  public let m_scavengeTargets: [wref<GameObject>];

  public final func OnGameAttach();

  protected cb func OnSenseVisibilityEvent(evt: SenseVisibilityEvent) -> Bool {
    if Equals(evt.description, n"Disassemblable") && !ArrayContains(this.m_scavengeTargets, evt.target) {
      let disassembleTargetRequest = new DisassembleTargetRequest();
      disassembleTargetRequest.requester = this.GetOwner();
      evt.target.QueueEvent(disassembleTargetRequest);
    }
  }

  protected cb func OnScavengeTargetReceived(evt: ScavengeTargetConfirmEvent) -> Bool {
    ArrayPush(this.m_scavengeTargets, evt.target);
  }

  protected cb func OnTargetScavenged(evt: TargetScavengedEvent) -> Bool {
    if ArrayContains(this.m_scavengeTargets, evt.target) {
      ArrayRemove(this.m_scavengeTargets, evt.target);
    }
  }

  public const final func GetScavengeTargets() -> [wref<GameObject>] {
    return this.m_scavengeTargets;
  }
}

