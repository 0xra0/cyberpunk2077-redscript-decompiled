abstract class CoverActionTransition extends LocomotionTransition {
  protected let m_gameInstance: GameInstance;
  protected let m_locomotionStateCallbackID: CallbackHandle;
  protected let m_lastSlidingTime: Float;
  protected let m_isSliding: Bool;

  protected func OnAttach(const stateContext: StateContext, const scriptInterface: StateGameScriptInterface) {
    let allBlackboardDef = GetAllBlackboardDefs();
    super.OnAttach(stateContext, scriptInterface);
    this.m_gameInstance = scriptInterface.GetGame();
    this.m_locomotionStateCallbackID = scriptInterface
      .localBlackboard
      .RegisterListenerInt(
        allBlackboardDef.PlayerStateMachine.Locomotion,
        this,
        n"OnLocomotionChanged",
        true
      );
  }

  protected func OnDetach(const stateContext: StateContext, const scriptInterface: StateGameScriptInterface) {
    this.m_locomotionStateCallbackID = null;
  }

  protected cb func OnLocomotionChanged(value: Int32) -> Bool {
    let isSliding = value == 10 || value == 11;
    if NotEquals(isSliding, this.m_isSliding) {
      this.m_isSliding = isSliding;
      if !this.m_isSliding {
        this.m_lastSlidingTime = EngineTime.ToFloat(GameInstance.GetTimeSystem(this.m_gameInstance).GetSimTime());
      }
    }
  }

  protected const final func IsMeleeLeaningInputCorrect(const scriptInterface: StateGameScriptInterface) -> Bool {
    let meleeWeaponState = scriptInterface
      .localBlackboard
      .GetInt(GetAllBlackboardDefs().PlayerStateMachine.MeleeWeapon);
    return meleeWeaponState == 8 || meleeWeaponState == 9;
  }

  protected const final func IsPlayerInCorrectStateToPeek(scriptInterface: StateGameScriptInterface, stateContext: StateContext) -> Bool {
    if this.IsInSafeSceneTier(scriptInterface) {
      return false;
    } else if scriptInterface
      .localBlackboard
      .GetBool(GetAllBlackboardDefs().PlayerStateMachine.MountedToVehicle) {
      return false;
    } else if this.m_isSliding
      || EngineTime.ToFloat(GameInstance.GetTimeSystem(this.m_gameInstance).GetSimTime()) - this.m_lastSlidingTime < 0.4 {
      return false;
    } else if scriptInterface.localBlackboard.GetInt(GetAllBlackboardDefs().PlayerStateMachine.Vision) == 1 {
      return true;
    }
    let leftHandCyberwareState = scriptInterface
      .localBlackboard
      .GetInt(GetAllBlackboardDefs().PlayerStateMachine.LeftHandCyberware);
    if leftHandCyberwareState == 5 || leftHandCyberwareState == 9 || leftHandCyberwareState == 8 {
      return true;
    } else if scriptInterface
      .localBlackboard
      .GetInt(GetAllBlackboardDefs().PlayerStateMachine.CombatGadget) == 3 {
      return true;
    } else if scriptInterface.localBlackboard.GetInt(GetAllBlackboardDefs().PlayerStateMachine.UpperBody) == 6 {
      stateContext.RemovePermanentBoolParameter(n"QuickthrowHoldPeek");
      return true;
    } else if scriptInterface.GetActionValue(n"CameraAim") == 0.0 {
      stateContext.RemovePermanentBoolParameter(n"QuickthrowHoldPeek");
    } else if stateContext.GetBoolParameter(n"QuickthrowHoldPeek", true) {
      return true;
    } else if stateContext.IsStateActive(n"UpperBody", n"aimingState") {
      stateContext.RemovePermanentBoolParameter(n"QuickthrowHoldPeek");
      return true;
    }
    return false;
  }

  protected const final func GetManualLeanIdleTime(const scriptInterface: StateGameScriptInterface, const stateContext: StateContext) -> Float {
    let parameter = stateContext.GetPermanentFloatParameter(n"ManualLeanIdleStartTime");
    if !parameter.valid {
      return 0.0;
    }
    return EngineTime.ToFloat(scriptInterface.GetTimeSystem().GetSimTime()) - parameter.value;
  }

  protected const final func IsManualLeanInputPressed(
    const stateContext: StateContext,
    const scriptInterface: StateGameScriptInterface,
    const actionName: CName
  ) -> Bool {
    return scriptInterface.IsActionJustPressed(actionName)
      || scriptInterface.GetActionValue(actionName) > 0.0 && this.GetManualLeanIdleTime(scriptInterface, stateContext) > 0.2;
  }

  protected const final func IsManualLeanLeftInputPressed(const stateContext: StateContext, const scriptInterface: StateGameScriptInterface) -> Bool {
    return false;
  }

  protected const final func IsManualLeanRightInputPressed(const stateContext: StateContext, const scriptInterface: StateGameScriptInterface) -> Bool {
    return false;
  }
}

class KurtTakedownKnifeLanded extends AIbehaviorconditionScript {
  protected func Activate(context: ScriptExecutionContext) {
    AIbehaviorconditionScript
      .SetUpdateInterval(context, AIBehaviorScriptBase.RandomizeOffsetForUpdateInterval(0.2));
  }

