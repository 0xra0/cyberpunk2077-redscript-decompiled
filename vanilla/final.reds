class OdaComponent extends ScriptableComponent {
  private let m_owner: wref<NPCPuppet>;
  private let m_owner_id: EntityID;
  private let m_odaAIComponent: AIHumanComponent;
  private let m_actionBlackBoard: wref<IBlackboard>;
  private let m_statPoolSystem: StatPoolsSystem;
  private let m_statPoolType: gamedataStatPoolType;
  private let m_healthListener: OdaEmergencyListener;
  private let m_statusEffect_emergency: TweakDBID;
  private let m_targetTrackerComponent: TargetTrackerComponent;
  private let m_weakspotDestroyed: Bool;

  private final func OnGameAttach() {
    this.m_owner = this.GetOwner() as NPCPuppet;
    this.m_owner_id = this.m_owner.GetEntityID();
    this.m_odaAIComponent = this.m_owner.GetAIControllerComponent();
    this.m_actionBlackBoard = this.m_odaAIComponent.GetActionBlackboard();
    this.m_statPoolSystem = GameInstance.GetStatPoolsSystem(this.m_owner.GetGame());
    this.m_healthListener = new OdaEmergencyListener();
    this.m_healthListener.SetValue(70.0);
    this.m_healthListener.m_owner = this.m_owner;
    this
      .m_statPoolSystem
      .RequestRegisteringListener(
        Cast<StatsObjectID>(this.m_owner_id),
        gamedataStatPoolType.Health,
        this.m_healthListener
      );
    StatusEffectHelper.ApplyStatusEffect(this.m_owner, t"Oda.Masked", this.m_owner_id);
    this.m_targetTrackerComponent = this.m_owner.GetTargetTrackerComponent();
    this.m_statPoolSystem = GameInstance.GetStatPoolsSystem(this.m_owner.GetGame());
    this.m_weakspotDestroyed = false;
  }

  public final func OnGameDetach() {
    this
      .m_statPoolSystem
      .RequestUnregisteringListener(
        Cast<StatsObjectID>(this.m_owner_id),
        gamedataStatPoolType.Health,
        this.m_healthListener
      );
    this.m_healthListener = null;
  }

  protected cb func OnDefeated(evt: DefeatedEvent) -> Bool {
    StatusEffectHelper
      .ApplyStatusEffect(this.m_owner, t"AdamSmasher.InvulnerableDefeated", this.m_owner_id);
  }

  public final func GetCombatTarget() -> wref<NPCPuppet> {
    return FromVariant<wref<NPCPuppet>>(this.m_odaAIComponent.GetBehaviorArgument(n"CombatTarget"));
  }

  protected cb func OnAIEvent(aiEvent: AIEvent) -> Bool {
    if Equals(aiEvent.name, n"BladesOn") {
      GameObject.StartReplicatedEffectEvent(this.m_owner, n"blade_light_on");
      GameObject.BreakReplicatedEffectLoopEvent(this.m_owner, n"screen_swipe");
    } else if Equals(aiEvent.name, n"BladesOff") {
      GameObject.BreakReplicatedEffectLoopEvent(this.m_owner, n"blade_light_on");
      GameObject.StartReplicatedEffectEvent(this.m_owner, n"screen_swipe");
    } else if Equals(aiEvent.name, n"StealthMode") {
      GameObject.BreakReplicatedEffectLoopEvent(this.m_owner, n"screen_swipe");
    }
  }

  protected cb func OnStatusEffectApplied(evt: ApplyStatusEffectEvent) -> Bool {
    let tags = evt.staticData.GameplayTags();
    if StatusEffectSystem.ObjectHasStatusEffect(this.m_owner, t"BaseStatusEffect.Defeated") {
      GameObject.BreakReplicatedEffectLoopEvent(this.m_owner, n"blade_light_on");
    } else if ArrayContains(tags, n"BossSuicide") {
      StatusEffectHelper
        .ApplyStatusEffect(
          this.m_owner,
          t"BaseStatusEffect.SuicideWithWeapon",
          this.m_owner.GetEntityID()
        );
      StatusEffectHelper
        .ApplyStatusEffect(this.m_owner, t"Sasquatch.ForceStaggerSuicide", this.m_owner_id);
    } else if ArrayContains(tags, n"BossGrenadeHackEffect") {
      StatusEffectHelper
        .ApplyStatusEffect(this.m_owner, t"BaseStatusEffect.OdaSuicideWithGrenade", this.m_owner_id);
    } else if ArrayContains(tags, n"WeakspotDestruction") {
      StatusEffectHelper.RemoveStatusEffect(this.m_owner, t"Oda.CloakedOda");
      StatusEffectHelper.RemoveStatusEffect(this.m_owner, t"Oda.Cloaked");
    } else if ArrayContains(tags, n"OdaStatusEffect") {
      this.EvaluateAppearance();
    } else if ArrayContains(tags, n"Cloak") {
      this.ApplyBlockStaggerStatusEffect();
    } else if ArrayContains(tags, n"Heal") {
      this.RemoveBlockStaggerStatusEffect();
      this.ApplyForceStaggerStatusEffect();
    } else if ArrayContains(tags, n"OdaStealthWrappers") {
      AnimationControllerComponent.SetAnimWrapperWeight(this.m_owner, n"OdaSearchingCustom", 1.0);
    } else if StatusEffectSystem.ObjectHasStatusEffect(this.m_owner, t"Oda.Main_boss_oda_allow_knockdown") {
      StatusEffectHelper
        .ApplyStatusEffect(this.m_owner, t"BaseStatusEffect.Knockdown", this.m_owner.GetEntityID());
    }
  }

  private final func DestroyAllWeakspots() {
    let weakspots: [wref<WeakspotObject>];
    this.m_owner.GetWeakspotComponent().GetWeakspots(weakspots);
    if ArraySize(weakspots) > 0 {
      let i = 0;
      while i < ArraySize(weakspots) {
        let scriptWeakspot = weakspots[i] as ScriptedWeakspotObject;
        scriptWeakspot.DestroyWeakspot(this.m_owner);
        ScriptedWeakspotObject.Kill(weakspots[i]);
        i += 1;
      }
    }
  }

  protected cb func OnStatusEffectRemoved(evt: RemoveStatusEffect) -> Bool {
    let tags = evt.staticData.GameplayTags();
    if ArrayContains(tags, n"OdaStatusEffect") {
      this.EvaluateAppearance();
    } else if ArrayContains(tags, n"Cloak") {
      this.RemoveForceStaggerStatusEffect();
      if StatusEffectSystem.ObjectHasStatusEffect(this.m_owner, t"BaseStatusEffect.Cloaked_Exit") {
        this.PlayMalfunctionFX();
      }
      GameObject.StartReplicatedEffectEvent(this.m_owner, n"exit_cloak");
    } else if evt.staticData.GetID() == t"Oda.Masked" {
      SetFactValue(this.m_owner.GetGame(), n"q112_oda_mask_destroyed", 1);
    } else if ArrayContains(tags, n"OdaStealthWrappers") {
      AnimationControllerComponent.SetAnimWrapperWeight(this.m_owner, n"OdaSearchingCustom", 0.0);
    } else if ArrayContains(tags, n"Madness") {
      StatusEffectHelper
        .ApplyStatusEffect(
          this.m_owner,
          t"BaseStatusEffect.SuicideWithWeapon",
          this.m_owner.GetEntityID()
        );
      StatusEffectHelper
        .ApplyStatusEffect(this.m_owner, t"Sasquatch.ForceStaggerSuicide", this.m_owner_id);
    }
  }

  protected cb func OnNonStealthQuickHackVictimEvent(evt: NonStealthQuickHackVictimEvent) -> Bool {
    NPCStatesComponent.AlertPuppet(this.m_owner);
  }

  public final func ApplyForceStaggerStatusEffect() {
    StatusEffectHelper
      .ApplyStatusEffect(this.m_owner, t"Oda.ForceStaggerOda", this.m_owner.GetEntityID());
  }

  public final func ApplyBlockStaggerStatusEffect() {
    StatusEffectHelper
      .ApplyStatusEffect(this.m_owner, t"Oda.BlockStaggerOda", this.m_owner.GetEntityID());
  }

  public final func RemoveForceStaggerStatusEffect() {
    StatusEffectHelper.RemoveStatusEffect(this.m_owner, t"Oda.ForceStaggerOda");
  }

  public final func RemoveBlockStaggerStatusEffect() {
    StatusEffectHelper.RemoveStatusEffect(this.m_owner, t"Oda.BlockStaggerOda");
  }

  public final func PlayMalfunctionFX() {
    GameObject.StartReplicatedEffectEvent(this.m_owner, n"hacks_cyberware_malfunction");
  }

  public final func EvaluateAppearance() {
    if !StatusEffectSystem.ObjectHasStatusEffect(this.m_owner, t"Oda.Masked") {
      this.m_owner.ScheduleAppearanceChange(n"oda_oda_mask_damage");
    } else {
      this.m_owner.ScheduleAppearanceChange(n"oda_oda");
    }
  }

  protected cb func OnSmartBulletDeflectedEvent(evt: SmartBulletDeflectedEvent) -> Bool {
    SetFactValue(this.m_owner.GetGame(), n"q112_oda_mask_deflected_bullet", 1);
  }

  protected cb func OnHit(evt: gameHitEvent) -> Bool {
    if StatusEffectSystem.ObjectHasStatusEffect(this.m_owner, t"Oda.Healing") {
      StatusEffectHelper.RemoveStatusEffect(this.m_owner, t"Oda.CloakedOda");
      StatusEffectHelper.RemoveStatusEffect(this.m_owner, t"Oda.Cloaked");
    }
  }

  protected cb func OnLookedAtEvent(evt: LookedAtEvent) -> Bool;

  protected final func OnDeactivate();

