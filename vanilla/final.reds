class Fan extends BasicDistractionDevice {
  public let m_animationType: EAnimationType;
  public let m_rotateClockwise: Bool;
  public let m_randomizeBladesSpeed: Bool;
  public let m_maxRotationSpeed: Float;
  public let m_timeToMaxRotation: Float;
  private let m_animFeature: AnimFeature_RotatingObject;
  private let m_updateComp: UpdateComponent;

  protected cb func OnRequestComponents(ri: EntityRequestComponentsInterface) -> Bool {
    EntityRequestComponentsInterface.RequestComponent(ri, n"update", n"UpdateComponent", false);
    EntityRequestComponentsInterface.RequestComponent(ri, n"anim", n"AnimatedComponent", false);
    super.OnRequestComponents(ri);
  }

  protected cb func OnTakeControl(ri: EntityResolveComponentsInterface) -> Bool {
    this.m_updateComp = EntityResolveComponentsInterface.GetComponent(ri, n"update") as UpdateComponent;
    super.OnTakeControl(ri);
    this.m_animFeature = new AnimFeature_RotatingObject();
    this.m_controller = EntityResolveComponentsInterface.GetComponent(ri, n"controller") as FanController;
  }

  protected cb func OnDeviceVisible(evt: gameDeviceVisibilityChangedEvent) -> Bool {
    super.OnDeviceVisible(evt);
  }

  protected func ResolveGameplayState() {
    super.ResolveGameplayState();
    this.m_animFeature.rotateClockwise = this.m_rotateClockwise;
    this.m_animFeature.maxRotationSpeed = this.m_maxRotationSpeed;
    this.m_animFeature.timeToMaxRotation = this.m_timeToMaxRotation;
    this.m_animFeature.randomizeBladesRotation = this.m_randomizeBladesSpeed;
    AnimationControllerComponent.ApplyFeature(this, n"rotation", this.m_animFeature);
  }

  public func ResavePersistentData(ps: PersistentState) -> Bool {
    let fanData: FanResaveData;
    super.ResavePersistentData(ps);
    let psDevice = ps as FanControllerPS;
    fanData.m_animationType = this.m_animationType;
    fanData.m_rotateClockwise = this.m_rotateClockwise;
    fanData.m_randomizeBladesSpeed = this.m_randomizeBladesSpeed;
    fanData.m_maxRotationSpeed = this.m_maxRotationSpeed;
    fanData.m_timeToMaxRotation = this.m_timeToMaxRotation;
    psDevice.PushResaveData(fanData);
    return true;
  }

  private const func GetController() -> FanController {
    return this.m_controller as FanController;
  }

  public const func GetDevicePS() -> FanControllerPS {
    return this.GetController().GetPS();
  }

  protected func CutPower() {
    this.StopFan();
  }

  protected func TurnOnDevice() {
    this.StartFan();
  }

  protected func TurnOffDevice() {
    this.StopFan();
  }

  private final func StartFan() {
    if Equals(this.GetDevicePS().GetAnimationType(), EAnimationType.REGULAR) {
      this.PlayRegularAnimation();
    } else if Equals(this.GetDevicePS().GetAnimationType(), EAnimationType.TRANSFORM) {
      this.PLayTransformAnimation();
    }
  }

  private final func StopFan() {
    if Equals(this.GetDevicePS().GetAnimationType(), EAnimationType.REGULAR) {
      this.StopRegularAnimation();
    } else if Equals(this.GetDevicePS().GetAnimationType(), EAnimationType.TRANSFORM) {
      this.StopTransformAnimation();
    }
  }

  private final func PLayTransformAnimation() {
    let playEvent = new gameTransformAnimationPlayEvent();
    playEvent.animationName = n"SPIN";
    playEvent.looping = true;
    playEvent.timesPlayed = 1u;
    if !this.GetDevicePS().IsRotatingClockwise() {
      playEvent.timeScale = -1.0;
    } else {
      playEvent.timeScale = 1.0;
    }
    this.QueueEvent(playEvent);
  }

  private final func StopTransformAnimation() {
    let stopEvent = new gameTransformAnimationPauseEvent();
    stopEvent.animationName = n"SPIN";
    this.QueueEvent(stopEvent);
  }

  private final func PlayRegularAnimation() {
    this.m_animFeature.rotateClockwise = this.GetDevicePS().IsRotatingClockwise();
    this.m_animFeature.maxRotationSpeed = this.GetDevicePS().GetMaxRotationSpeed();
    this.m_animFeature.timeToMaxRotation = this.GetDevicePS().GetTimeToMaxRotation();
    this.m_animFeature.randomizeBladesRotation = this.GetDevicePS().IsBladesSpeedRandomized();
    AnimationControllerComponent.ApplyFeature(this, n"rotation", this.m_animFeature);
  }

  private final func StopRegularAnimation() {
    this.m_animFeature.rotateClockwise = false;
    this.m_animFeature.maxRotationSpeed = 0.0;
    this.m_animFeature.timeToMaxRotation = 0.0;
    this.m_animFeature.randomizeBladesRotation = false;
    AnimationControllerComponent.ApplyFeature(this, n"rotation", this.m_animFeature);
  }

  protected cb func OnAreaEnter(evt: AreaEnteredEvent) -> Bool {
    if this.GetDevicePS().IsON() {
      let TDBid = t"Attacks.FanBlades";
      if TDBID.IsValid(TDBid) {
        this.DoAttack(TDBid);
      }
    }
  }

  private final func DoAttack(damageType: TweakDBID) {
    let hitFlags: [SHitFlag];
    let flag: SHitFlag;
    flag.flag = hitFlag.FriendlyFire;
    flag.source = n"FanDevice";
    ArrayPush(hitFlags, flag);
    let attack = RPGManager.PrepareGameEffectAttack(this.GetGame(), this, this, damageType, hitFlags);
    if IsDefined(attack) {
      attack.StartAttack();
    }
  }
}

class AnimatedSign extends InteractiveDevice {
  private let m_animFeature: AnimFeature_AnimatedDevice;

  protected cb func OnRequestComponents(ri: EntityRequestComponentsInterface) -> Bool {
    super.OnRequestComponents(ri);
  }

  protected cb func OnTakeControl(ri: EntityResolveComponentsInterface) -> Bool {
    super.OnTakeControl(ri);
  }

  protected func TurnOnDevice() {
    this.UpdateAnimState();
    super.TurnOnDevice();
  }

  protected func TurnOffDevice() {
    this.UpdateAnimState();
    super.TurnOffDevice();
  }

  private final func UpdateAnimState() {
    if !IsDefined(this.m_animFeature) {
      this.m_animFeature = new AnimFeature_AnimatedDevice();
    } else if this.GetDevicePS().IsON() {
      this.m_animFeature.isOn = true;
      this.m_animFeature.isOff = false;
    }
    this.m_animFeature.isOn = false;
    this.m_animFeature.isOff = true;
    AnimationControllerComponent.ApplyFeature(this, n"AnimatedDevice", this.m_animFeature);
  }
}

class RelicPerkSystem extends ScriptableSystem {
  private persistent let m_registeredPerkDevices: [PerkDeviceMappinData];

  private func OnRestored(saveVersion: Int32, gameVersion: Int32) {
    this.RegisterMappins();
  }

  private final func RegisterMappins() {
    let i = 0;
    while i < ArraySize(this.m_registeredPerkDevices) {
      if !this.m_registeredPerkDevices[i].IsUsed() {
        this.RegisterMappinInMappinSystem(this.m_registeredPerkDevices[i]);
      }
      i += 1;
    }
  }

  protected final func OnRegisterPerkDeviceMappinRequest(request: RegisterPerkDeviceMappinRequest) {
    let perkDeviceMappinData: PerkDeviceMappinData;
    if !this.TryGetPerkDeviceMappinData(request.m_ownerID, perkDeviceMappinData) {
      perkDeviceMappinData = this.CreatePerkDeviceMappinData(request);
      this.RegisterMappinInMappinSystem(perkDeviceMappinData);
    } else if NotEquals(perkDeviceMappinData.GetPosition(), request.m_position) {
      perkDeviceMappinData.SetPosition(request.m_position);
      GameInstance
        .GetMappinSystem(this.GetGameInstance())
        .SetMappinPosition(perkDeviceMappinData.GetMappinID(), request.m_position);
    }
  }

  private final func CreatePerkDeviceMappinData(request: RegisterPerkDeviceMappinRequest) -> PerkDeviceMappinData {
    let perkDeviceMappinData = new PerkDeviceMappinData();
    perkDeviceMappinData.SetOwnerID(request.m_ownerID);
    perkDeviceMappinData.SetPosition(request.m_position);
    ArrayPush(this.m_registeredPerkDevices, perkDeviceMappinData);
    return perkDeviceMappinData;
  }

  private final func IsOwnerRegistered(ownerID: EntityID) -> Bool {
    let i = 0;
    while i < ArraySize(this.m_registeredPerkDevices) {
      if this.m_registeredPerkDevices[i].GetOwnerID() == ownerID {
        return true;
      }
      i += 1;
    }
    return false;
  }

  private final func IsMappinRegistered(perkDeviceMappinData: PerkDeviceMappinData) -> Bool {
    let mappinID: NewMappinID;
    return NotEquals(perkDeviceMappinData.GetMappinID(), mappinID);
  }

  private final func RegisterMappinInMappinSystem(perkDeviceMappinData: PerkDeviceMappinData) {
    let mappinID = GameInstance
      .GetMappinSystem(this.GetGameInstance())
      .RegisterMappin(this.GetMappinData(), perkDeviceMappinData.GetPosition());
    perkDeviceMappinData.SetMappinID(mappinID);
  }

  private final func GetMappinData() -> MappinData {
    let mappinData: MappinData;
    mappinData.mappinType = t"Mappins.PerkDeviceMappinDefinition";
    mappinData.variant = gamedataMappinVariant.Zzz16_RelicDeviceBasicVariant;
    mappinData.active = true;
    mappinData.visibleThroughWalls = true;
    return mappinData;
  }

  protected final func OnSetPerkDeviceAsUsedRequest(request: SetPerkDeviceAsUsedRequest) {
    let perkDeviceMappinData: PerkDeviceMappinData;
    if this.TryGetPerkDeviceMappinData(request.m_ownerID, perkDeviceMappinData)
      && !perkDeviceMappinData.IsUsed()
      && this.IsMappinRegistered(perkDeviceMappinData) {
      perkDeviceMappinData.SetAsUsed();
      GameInstance
        .GetMappinSystem(this.GetGameInstance())
        .UnregisterMappin(perkDeviceMappinData.GetMappinID());
    }
  }

  private final func TryGetPerkDeviceMappinData(ownerID: EntityID, out perkDeviceMappinData: PerkDeviceMappinData) -> Bool {
    let i = 0;
    while i < ArraySize(this.m_registeredPerkDevices) {
      if this.m_registeredPerkDevices[i].GetOwnerID() == ownerID {
        perkDeviceMappinData = this.m_registeredPerkDevices[i];
        return true;
      }
      i += 1;
    }
    return false;
  }
}

class PerkDeviceMappinData extends IScriptable {
  private persistent let m_ownerID: EntityID;
  private persistent let m_isUsed: Bool;
  private persistent let m_position: Vector4;
  private let m_mappinID: NewMappinID;

  public final func SetOwnerID(ownerID: EntityID) {
    this.m_ownerID = ownerID;
  }

  public final func GetOwnerID() -> EntityID {
    return this.m_ownerID;
  }

  public final func SetPosition(position: Vector4) {
    this.m_position = position;
  }

  public final func GetPosition() -> Vector4 {
    return this.m_position;
  }

  public final func SetMappinID(mappinID: NewMappinID) {
    this.m_mappinID = mappinID;
  }

  public final func GetMappinID() -> NewMappinID {
    return this.m_mappinID;
  }

  public final func IsUsed() -> Bool {
    return this.m_isUsed;
  }

  public final func SetAsUsed() {
    this.m_isUsed = true;
  }
}

class RegisterPerkDeviceMappinRequest extends ScriptableSystemRequest {
  public let m_ownerID: EntityID;
  public let m_position: Vector4;
}

class SetPerkDeviceAsUsedRequest extends ScriptableSystemRequest {
  public let m_ownerID: EntityID;
}

