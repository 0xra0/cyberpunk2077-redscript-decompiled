class SimpleMessengerContactsVirtualListController extends inkVirtualListController {
  private let m_dataView: SimpleMessengerContactDataView;
  protected let m_dataSource: ScriptableDataSource;
  protected let m_classifier: QuestListVirtualTemplateClassifier;

  protected cb func OnInitialize() -> Bool {
    this.m_dataView = new SimpleMessengerContactDataView();
    this.m_dataSource = new ScriptableDataSource();
    this.m_classifier = new QuestListVirtualTemplateClassifier();
    this.m_dataView.Setup();
    this.m_dataView.SetSource(this.m_dataSource);
    this.SetSource(this.m_dataView);
    this.SetClassifier(this.m_classifier);
  }

  protected cb func OnUninitialize() -> Bool {
    this.m_dataView.SetSource(null);
    this.SetSource(null);
    this.SetClassifier(null);
    this.m_dataSource = null;
  }

  public final func GetDataView() -> ScriptableDataView {
    let view = new SimpleMessengerContactDataView();
    this.m_dataView = view;
    return view;
  }

  public final func GetIndexByJournalHash(hash: Int32) -> Int32 {
    if this.m_dataView == null {
      return -1;
    }
    let dataSize = Cast<Int32>(this.m_dataView.Size());
    let i = 0;
    while i < dataSize {
      let currentContactData = this.m_dataView.GetItem(Cast<Uint32>(i)) as ContactData;
      if currentContactData.hash == hash {
        return i;
      }
      i = i + 1;
    }
    return -1;
  }

  public func EnableSorting() {
    this.m_dataView.EnableSorting();
  }

  public func DisableSorting() {
    this.m_dataView.DisableSorting();
  }

  public func SetData(const data: script_ref<[IScriptable]>, opt sortOnce: Bool) {
    this.m_dataSource.Reset(data);
    this.EnableSorting();
    if sortOnce {
      this.DisableSorting();
    }
  }

  public func GetDataSize() -> Int32 {
    return Cast<Int32>(this.m_dataView.Size());
  }
}

