    while i < limit {
      let currentItem = this.GetItemDataEquippedInArea(cyberAreas[i]);
      if !InventoryItemData.IsEmpty(currentItem) {
        ArrayPush(items, currentItem);
      }
      i += 1;
    }
    return items;
  }

  public final func GetInventoryCyberwareSize() -> Int32 {
    let result: Int32;
    let cyberAreas = InventoryDataManagerV2.GetInventoryCyberwareAreas();
    let i = 0;
    let limit = ArraySize(cyberAreas);
    while i < limit {
      let currentItem = this.GetItemDataEquippedInArea(cyberAreas[i]);
      if !InventoryItemData.IsEmpty(currentItem) {
