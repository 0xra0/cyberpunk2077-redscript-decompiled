  public const func GetDevicePS() -> NetworkAreaControllerPS {
    return this.GetController().GetPS();
  }

  protected cb func OnAreaEnter(evt: AreaEnteredEvent) -> Bool {
    let entityID = this.ExtractEntityID(evt);
    if this.IsPlayer(entityID) {
      this.GetDevicePS().AreaEntered();
    }
  }

  protected cb func OnAreaExit(evt: AreaExitedEvent) -> Bool {
    let entityID = this.ExtractEntityID(evt);
    if this.IsPlayer(entityID) {
      this.GetDevicePS().AreaExited();
    }
  }
}

