class Target extends IScriptable {
  private let target: wref<GameObject>;
  private let isInteresting: Bool;
  private let isVisible: Bool;

  public final func CreateTarget(currentTarget: wref<GameObject>, interesting: Bool, visible: Bool) {
    this.target = currentTarget;
    this.isInteresting = interesting;
    this.isVisible = visible;
  }

  public final func GetTarget() -> wref<GameObject> {
    return this.target;
  }

  public final func IsInteresting() -> Bool {
    return this.isInteresting;
  }

  public final func IsVisible() -> Bool {
    return this.isVisible;
  }

  public final func SetIsInteresting(interestingChange: Bool) {
    this.isInteresting = interestingChange;
  }

  public final func SetIsVisible(_isVisible: Bool) {
    this.isVisible = _isVisible;
  }
}

class SimpleTargetManager extends ScriptableComponent {
  public final static func AddTarget(
    targetsList: script_ref<[Target]>,
    goTarget: wref<GameObject>,
    isInteresting: Bool,
    isVisible: Bool
  ) {
    let targetIndex = SimpleTargetManager.IsTargetAlreadyAdded(targetsList, goTarget);
    if targetIndex >= 0 {
      targetsList[targetIndex].SetIsVisible(isVisible);
      targetsList[targetIndex].SetIsInteresting(isInteresting);
      if !IsFinal() {
      }
      return;
    }
    let newTarget = new Target();
    newTarget.CreateTarget(goTarget, isInteresting, isVisible);
    if goTarget.IsPlayer() {
      ArrayInsert(targetsList, 0, newTarget);
    } else {
      ArrayPush(targetsList, newTarget);
    }
  }

  public final static func RemoveTarget(targetsList: script_ref<[Target]>, targetToRemove: wref<GameObject>) -> Bool {
    let foundTarget = SimpleTargetManager.GetSpecificTarget(targetsList, targetToRemove);
    if !IsDefined(foundTarget) {
      if !IsFinal() {
      }
      return false;
    }
    ArrayRemove(targetsList, foundTarget);
    return true;
  }

  public final static func SetTargetVisible(
    const targetsList: script_ref<[Target]>,
    targetToRemove: wref<GameObject>,
    isVisible: Bool
  ) -> Bool {
    let foundTarget = SimpleTargetManager.GetSpecificTarget(targetsList, targetToRemove);
    if !IsDefined(foundTarget) {
      if !IsFinal() {
      }
      return false;
    }
    foundTarget.SetIsVisible(isVisible);
    return true;
  }

  public final static func RemoveAllTargets(targetsList: script_ref<[Target]>) {
    ArrayClear(targetsList);
  }

  public final static func GetFirstInterestingTargetObject(const targetsList: script_ref<[Target]>) -> wref<GameObject> {
    let target = SimpleTargetManager.GetFirstInterestingTarget(targetsList);
    if IsDefined(target) {
      let goTarget = target.GetTarget();
      if IsDefined(goTarget) {
        return goTarget;
      }
      if !IsFinal() {
      }
      return null;
    }
    if !IsFinal() {
    }
    return null;
  }

  public final static func GetFirstInterestingTarget(const targetsList: script_ref<[Target]>) -> Target {
    let i = 0;
    while i < ArraySize(targetsList) {
      if targetsList[i].IsInteresting() && targetsList[i].IsVisible() {
        return targetsList[i];
      }
      i += 1;
    }
    if !IsFinal() {
    }
    return null;
  }

  public final static func GetSpecificTarget(const targetsList: script_ref<[Target]>, target: wref<GameObject>) -> Target {
    let i = 0;
    while i < ArraySize(targetsList) {
      if target == targetsList[i] {
        return targetsList[i];
      }
      i += 1;
    }
    if !IsFinal() {
    }
    return null;
  }

  public final static func GetSpecificTarget(const targetsList: script_ref<[Target]>, targetID: EntityID) -> Target {
    let i = 0;
    while i < ArraySize(targetsList) {
      if targetID == targetsList[i].GetTarget().GetEntityID() {
        return targetsList[i];
      }
      i += 1;
    }
    if !IsFinal() {
    }
    return null;
  }

  public final static func GetSpecificTarget(const targetsList: script_ref<[Target]>, index: Int32) -> Target {
    if ArraySize(targetsList) == 0 {
      if !IsFinal() {
      }
      return null;
    } else if index >= 0 && index < ArraySize(targetsList) {
      return targetsList[index];
    } else if !IsFinal() {
    }
    return null;
  }

  public final static func IsTargetAlreadyAdded(const targets: script_ref<[Target]>, targetToCheck: Target) -> Int32 {
    let i = 0;
    while i < ArraySize(targets) {
      if targetToCheck == targets[i] {
        return i;
      }
      i += 1;
    }
    return -1;
  }

  public final static func IsTargetAlreadyAdded(const targetsList: script_ref<[Target]>, gameObject: wref<GameObject>) -> Int32 {
    let i = 0;
    while i < ArraySize(targetsList) {
      if gameObject == targetsList[i].GetTarget() {
        return i;
      }
      i += 1;
    }
    return -1;
  }

  public final static func IsTargetVisible(const targetsList: script_ref<[Target]>, gameObject: wref<GameObject>) -> Bool {
    let i = 0;
    while i < ArraySize(targetsList) {
      if gameObject == targetsList[i].GetTarget() {
        return targetsList[i].IsVisible();
      }
      i += 1;
    }
    return false;
  }

  public final static func HasInterestingTargets(const targetsList: script_ref<[Target]>) -> Bool {
    let i = 0;
    while i < ArraySize(targetsList) {
      if targetsList[i].IsInteresting() && targetsList[i].IsVisible() {
        return true;
      }
      i += 1;
    }
    return false;
  }
}

public func OperatorEqual(goTarget: wref<GameObject>, target: Target) -> Bool {
  if goTarget == target.GetTarget() {
    return true;
  }
  return false;
}

native class LookAtRemoveEvent extends Event {
  private native let lookAtRef: LookAtRef;

  public final static func QueueRemoveLookatEvent(owner: GameObject, addedBeforeEvent: LookAtAddEvent) {
    let removeLookatEvent = new LookAtRemoveEvent();
    removeLookatEvent.lookAtRef = addedBeforeEvent.outLookAtRef;
    addedBeforeEvent.request.invalid = true;
    owner.QueueEvent(removeLookatEvent);
  }

  public final static func QueueDelayedRemoveLookatEvent(
    context: ScriptExecutionContext,
    addedBeforeEvent: LookAtAddEvent,
    lookAtDeactivationDelay: Float
  ) {
    let removeLookatEvent = new LookAtRemoveEvent();
    removeLookatEvent.lookAtRef = addedBeforeEvent.outLookAtRef;
    addedBeforeEvent.request.invalid = true;
    GameInstance
      .GetDelaySystem(ScriptExecutionContext.GetOwner(context).GetGame())
      .DelayEvent(
        ScriptExecutionContext.GetOwner(context),
        removeLookatEvent,
        lookAtDeactivationDelay
      );
  }
}

