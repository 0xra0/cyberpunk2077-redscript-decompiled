  public native let inputHintKeyCombinationType: inkInputHintKeyCombinationType;
  public native let enableHoldAnimation: Bool;
}

public func SendInputHintData(
  context: GameInstance,
  show: Bool,
  const data: script_ref<InputHintData>,
  opt targetHintContainer: CName
) {
  let evt = new UpdateInputHintEvent();
  evt.data = data;
  evt.show = show;
  if IsNameValid(targetHintContainer) {
    evt.targetHintContainer = targetHintContainer;
  }
  evt.targetHintContainer = n"GameplayInputHelper";
  GameInstance.GetUISystem(context).QueueEvent(evt);
}

native class UpdateInputHintEvent extends Event {
  public native let data: InputHintData;
  public native let show: Bool;
  public native let targetHintContainer: CName;
}

