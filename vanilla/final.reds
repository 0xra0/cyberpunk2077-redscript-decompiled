class PerkScreenController extends inkLogicController {
  protected let m_hubSelector: inkWidgetRef;
  protected let m_connectionLinesContainer: inkCompoundRef;
  protected let m_boughtConnectionLinesContainer: inkCompoundRef;
  protected let m_maxedConnectionLinesContainer: inkCompoundRef;
  protected let m_boughtMaskContainer: inkCanvasRef;
  protected let m_maxedMaskContainer: inkCanvasRef;
  protected let m_attributeNameText: inkTextRef;
  protected let m_attributeLevelText: inkTextRef;
  protected let m_levelControllerRef: inkWidgetRef;
  protected let m_rewardsControllerRef: inkWidgetRef;
  protected let m_TooltipsManagerRef: inkWidgetRef;
  protected let m_proficiencyRootRef: inkWidgetRef;
  protected let m_proficiencyDescriptionText: inkTextRef;
  protected let m_dataManager: PlayerDevelopmentDataManager;
  protected let m_displayData: AttributeDisplayData;
  private let m_proficiencyRoot: wref<TabRadioGroup>;
  private let m_widgetMap: [wref<PerkDisplayContainerController>];
  private let m_traitController: wref<PerkDisplayContainerController>;
  private let m_currentIndex: Int32;
  private let m_connectionLines: [Int32; 45];
  private let m_levelController: wref<StatsProgressController>;
  private let m_rewardsController: wref<StatsStreetCredReward>;
  private let m_tooltipsManager: wref<gameuiTooltipsManager>;

  protected cb func OnInitialize() -> Bool {
    this
      .RegisterToGlobalInputCallback(n"OnPostOnRelease", this, n"OnButtonRelease");
    this.m_levelController = this
      .SpawnFromLocal(inkWidgetRef.Get(this.m_levelControllerRef), n"SkillLevel")
      .GetControllerByType(n"StatsProgressController") as StatsProgressController;
    this.m_rewardsController = this
      .SpawnFromLocal(inkWidgetRef.Get(this.m_rewardsControllerRef), n"SkillRewards")
      .GetControllerByType(n"StatsStreetCredReward") as StatsStreetCredReward;
    this.m_tooltipsManager = inkWidgetRef.GetControllerByType(this.m_TooltipsManagerRef, n"gameuiTooltipsManager") as gameuiTooltipsManager;
    this.m_tooltipsManager.Setup();
    this.m_proficiencyRoot = inkWidgetRef.GetController(this.m_proficiencyRootRef) as TabRadioGroup;
    this
      .m_proficiencyRoot
      .RegisterToCallback(n"OnValueChanged", this, n"OnValueChanged");
    this.m_connectionLines = PerksScreenStaticData.GetPerksConnectionLines();
  }

  protected final func RegisterProficiencyButtons(attributeDisplayData: AttributeDisplayData, startingIndex: Int32) {
    let labels: [String];
    let proficienciesSize = ArraySize(attributeDisplayData.m_proficiencies);
    let i = 0;
    while i < proficienciesSize {
      ArrayPush(labels, attributeDisplayData.m_proficiencies[i].m_localizedName);
      i += 1;
    }
    this
      .m_proficiencyRoot
      .SetData(proficienciesSize, this.m_tooltipsManager, labels);
    this.m_proficiencyRoot.Toggle(startingIndex);
  }

  protected cb func OnUninitialize() -> Bool {
    this
      .UnregisterFromGlobalInputCallback(n"OnPostOnRelease", this, n"OnButtonRelease");
  }

  protected cb func OnSetUserData(userData: IScriptable) -> Bool {
    userData;
  }

  private final func GetMenuData(data: ProficiencyDisplayData) -> MenuData {
    let menuData: MenuData;
    menuData.identifier = data.m_index;
    menuData.label = data.m_localizedName;
    menuData.userData = data;
    return menuData;
  }

  public final func Setup(
    displayData: AttributeDisplayData,
    dataManager: PlayerDevelopmentDataManager,
    startingIndex: Int32
  ) {
    this.m_dataManager = dataManager;
    this.m_displayData = displayData;
    let i = 0;
    while i < ArraySize(this.m_widgetMap) {
      this.m_widgetMap[i].SetData(null, null);
      i += 1;
    }
    this.RegisterProficiencyButtons(displayData, startingIndex);
    let attributeData = dataManager.GetAttribute(displayData.m_attributeId);
    inkTextRef.SetText(this.m_attributeNameText, attributeData.label);
    inkTextRef.SetText(this.m_attributeLevelText, IntToString(attributeData.value));
    this.RebuildPerks(startingIndex);
    this.PlayLibraryAnimation(n"start_perk_screen");
  }

  public final func RebuildPerks(index: Int32) {
    let controller: wref<PerkDisplayContainerController>;
    this.m_currentIndex = index;
    let perksCount = 0;
    inkCompoundRef.RemoveAllChildren(this.m_boughtMaskContainer);
    inkCompoundRef.RemoveAllChildren(this.m_maxedMaskContainer);
    let proficiency = this.m_displayData.m_proficiencies[index];
    let i = 0;
    while i < ArraySize(proficiency.m_areas) {
      let area = proficiency.m_areas[i];
      let j = 0;
      while j < ArraySize(area.m_perks) {
        let perk = area.m_perks[j];
        controller = this.m_widgetMap[perksCount];
        controller.SetData(perk, this.m_dataManager);
        this.SpawnConnectionGradiantMask(controller);
        perksCount += 1;
        j += 1;
      }
      i += 1;
    }
    if this.m_traitController != null {
      this.m_traitController.SetData(proficiency.m_traitData, this.m_dataManager);
    }
    this.m_levelController.SetProfiencyLevel(proficiency);
    this.m_rewardsController.SetData(proficiency, this.m_tooltipsManager, 0);
    i = 0;
    while i <= ArraySize(this.m_connectionLines) {
      let isLineVisible = this.m_connectionLines[i] <= perksCount;
      this.ShowLineWidget(this.m_connectionLinesContainer, isLineVisible, i);
      this.ShowLineWidget(this.m_boughtConnectionLinesContainer, isLineVisible, i);
      this.ShowLineWidget(this.m_maxedConnectionLinesContainer, isLineVisible, i);
      i += 1;
    }
    i = perksCount;
    while i < ArraySize(this.m_widgetMap) {
      controller = this.m_widgetMap[i];
      controller.SetData(null, null);
      i += 1;
    }
    inkTextRef
      .SetText(this.m_proficiencyDescriptionText, proficiency.m_localizedDescription);
  }

  protected cb func OnUnlimitedUnlocked(evt: UnlimitedUnlocked) -> Bool {
    if this.m_traitController != null {
      this.m_traitController.PlayLibraryAnimation(n"reveal_unlimited_perk_traces");
    }
  }

  private final func ProcessTutorialFact() {
    let questSystem = GameInstance.GetQuestsSystem(this.m_dataManager.GetPlayer().GetGame());
    if questSystem.GetFact(n"perks_tutorial") == 0 && questSystem.GetFact(n"disable_tutorials") == 0 {
      questSystem.SetFact(n"perks_tutorial", 1);
    }
  }

  private final func SpawnConnectionGradiantMask(controller: wref<PerkDisplayContainerController>) {
    let data = controller.GetPerkDisplayData();
    if data.m_locked || data.m_level <= 0 {
      return;
    }
    let container = data.m_level == data.m_maxLevel ? this.m_maxedMaskContainer : this.m_boughtMaskContainer;
    let widget = this.SpawnFromLocal(inkWidgetRef.Get(container), n"ConnectionGradiantMask");
    if widget == null {
      return;
    }
    let position = controller.GetRootWidget().GetMargin();
    position.left += 100.0;
    position.top += 120.0;
    widget.SetMargin(position);
    widget.SetAnchorPoint(new Vector2(0.5, 0.5));
  }

  private final func ShowLineWidget(lineContainer: inkCompoundRef, show: Bool, lineNumber: Int32) {
    let line = inkCompoundRef
      .GetWidgetByPath(
        lineContainer,
        inkWidgetPath.Build(StringToName("connect" + IntToString(lineNumber)))
      );
    line.SetVisible(show);
  }

  protected cb func OnValueChanged(controller: wref<inkRadioGroupController>, selectedIndex: Int32) -> Bool {
    this.RebuildPerks(selectedIndex == -1 ? this.m_currentIndex : selectedIndex);
    this.PlayLibraryAnimation(n"start_perk_screen");
  }

  protected cb func OnPerkBoughtEvent(evt: PerkBoughtEvent) -> Bool {
    let developmentData = PlayerDevelopmentSystem.GetData(this.m_dataManager.GetPlayer());
    let proficiencyType = developmentData
      .GetProficiencyFromPerkArea(developmentData.GetPerkAreaFromPerk(evt.perkType));
    this.m_displayData.m_proficiencies[this.m_currentIndex] = this.m_dataManager.GetProficiencyWithData(proficiencyType);
    this.RebuildPerks(this.m_currentIndex);
  }

  protected cb func OnTraitBoughtEvent(evt: TraitBoughtEvent) -> Bool {
    let proficiencyType = this.m_displayData.m_proficiencies[this.m_currentIndex].m_proficiency;
    this.m_displayData.m_proficiencies[this.m_currentIndex] = this.m_dataManager.GetProficiencyWithData(proficiencyType);
    this.RebuildPerks(this.m_currentIndex);
  }

  protected cb func OnPerkDisplayContainerCreated(evt: PerkDisplayContainerCreatedEvent) -> Bool {
    let controller = evt.container.GetController() as PerkDisplayContainerController;
    if evt.isTrait {
      this.m_traitController = controller;
    } else if evt.index > 0 {
      if ArraySize(this.m_widgetMap) < evt.index {
        ArrayResize(this.m_widgetMap, evt.index);
      } else {
        this.m_widgetMap[evt.index - 1] = controller;
      }
    }
  }

  public final func GetProficiencyDisplayData() -> ProficiencyDisplayData {
    return this.m_displayData.m_proficiencies[this.m_currentIndex];
  }

  public final func GetHubSelectorWidget() -> wref<inkWidget> {
    return inkWidgetRef.Get(this.m_proficiencyRootRef);
  }
}

class StatsStreetCredReward extends inkLogicController {
  private let m_prevRewardsList: inkCompoundRef;
  private let m_currentRewardsList: inkCompoundRef;
  private let m_nextRewardsList: inkCompoundRef;
  private let m_scrollSlider: inkCompoundRef;
  private let m_scrollButtonHint: inkCompoundRef;
  private let m_rewardSize: Int32;
  private let m_tooltipIndex: Int32;
  private let m_tooltipsManager: wref<gameuiTooltipsManager>;

  public final func SetData(
    proficiencyData: ProficiencyDisplayData,
    tooltipsManager: wref<gameuiTooltipsManager>,
    tooltipIndex: Int32
  ) {
    this
      .SetData(
        proficiencyData.m_passiveBonusesData,
        tooltipsManager,
        proficiencyData.m_level,
        tooltipIndex,
        proficiencyData.m_localizedName
      );
  }

  public final func SetData(
    rewardData: [LevelRewardDisplayData],
    tooltipsManager: wref<gameuiTooltipsManager>,
    currentLevel: Int32,
    tooltipIndex: Int32,
    const attributeName: script_ref<String>
  ) {
    let lastUnlocked: Int32;
    let lastUnlockedIndex: Int32;
    this.RegisterToCallback(n"OnHoverOver", this, n"OnRewardsHoverOver");
    this.RegisterToCallback(n"OnHoverOut", this, n"OnRewardsHoverOut");
    inkWidgetRef.SetVisible(this.m_scrollSlider, false);
    inkWidgetRef.SetVisible(this.m_scrollButtonHint, false);
    this.m_tooltipIndex = tooltipIndex;
    inkCompoundRef.RemoveAllChildren(this.m_prevRewardsList);
    inkCompoundRef.RemoveAllChildren(this.m_currentRewardsList);
    inkCompoundRef.RemoveAllChildren(this.m_nextRewardsList);
    this.m_tooltipsManager = tooltipsManager;
    let i = 0;
    while i < ArraySize(rewardData) {
      if rewardData[i].level < currentLevel || rewardData[i].level == currentLevel {
        lastUnlocked = rewardData[i].level;
        lastUnlockedIndex = i;
      }
      i += 1;
    }
    this.m_rewardSize = ArraySize(rewardData);
    let totalCount = 0;
    let prevTerm = 0;
    i = lastUnlockedIndex;
    let positiveIndex = true;
    while totalCount < this.m_rewardSize {
      i = positiveIndex ? i + prevTerm : i - prevTerm;
      if i < this.m_rewardSize && i >= 0 {
        let descPackage = new UILocalizationDataPackage();
        ArrayPush(descPackage.intValues, rewardData[i].level);
        ArrayPush(descPackage.nameValues, StringToName(attributeName));
        rewardData[i].descPackage = descPackage;
        if rewardData[i].level < currentLevel && rewardData[i].level != lastUnlocked {
          let parentWidget = inkWidgetRef.Get(this.m_prevRewardsList);
          rewardData[i].isLock = false;
          let state = n"Default";
        } else if rewardData[i].level == currentLevel || rewardData[i].level == lastUnlocked {
          parentWidget = inkWidgetRef.Get(this.m_currentRewardsList);
          rewardData[i].isLock = false;
          state = n"Default";
        } else {
          parentWidget = inkWidgetRef.Get(this.m_nextRewardsList);
          rewardData[i].isLock = true;
          state = n"Unavailable";
        }
        let rewardItem = this
          .SpawnFromLocal(parentWidget, n"rewardItem")
          .GetControllerByType(n"StatsStreetCredRewardItem") as StatsStreetCredRewardItem;
        rewardItem.RegisterToCallback(n"OnHoverOver", this, n"OnHoverOver");
        rewardItem.RegisterToCallback(n"OnHoverOut", this, n"OnHoverOut");
        rewardItem.SetData(rewardData[i], state);
        totalCount += 1;
      }
      positiveIndex = !positiveIndex;
      prevTerm += 1;
    }
  }

  protected cb func OnHoverOver(evt: inkPointerEvent) -> Bool {
    let widget = evt.GetCurrentTarget();
    let data = (widget.GetController() as StatsStreetCredRewardItem).GetRewardData();
    let tooltipData = new MessageTooltipData();
    tooltipData.Title = GetLocalizedText(data.description);
    tooltipData.TitleLocalizationPackage = data.locPackage;
    if data.isLock {
      tooltipData.Description = GetLocalizedText("LocKey#78909");
      tooltipData.DescriptionLocalizationPackage = data.descPackage;
    }
    this
      .m_tooltipsManager
      .ShowTooltipAtWidget(
        this.m_tooltipIndex,
        widget,
        tooltipData,
        gameuiETooltipPlacement.RightCenter,
        new inkMargin(40.0, 0.0, 0.0, 0.0)
      );
  }

  protected cb func OnHoverOut(evt: inkPointerEvent) -> Bool {
    this.m_tooltipsManager.HideTooltips();
  }

  protected cb func OnRewardsHoverOver(evt: inkPointerEvent) -> Bool {
    if this.m_rewardSize > 8 {
      inkWidgetRef.SetVisible(this.m_scrollSlider, true);
      inkWidgetRef.SetVisible(this.m_scrollButtonHint, true);
    } else {
      inkWidgetRef.SetVisible(this.m_scrollSlider, false);
      inkWidgetRef.SetVisible(this.m_scrollButtonHint, false);
    }
  }

  protected cb func OnRewardsHoverOut(evt: inkPointerEvent) -> Bool {
    inkWidgetRef.SetVisible(this.m_scrollSlider, false);
    inkWidgetRef.SetVisible(this.m_scrollButtonHint, false);
  }
}

