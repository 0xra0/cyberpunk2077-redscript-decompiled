  public final static func TagObject(obj: wref<GameObject>) {
    if !IsDefined(obj) || !obj.CanBeTagged() {
      return;
    }
    let request = new TagObjectRequest();
    request.object = obj;
    obj.GetTaggingSystem().QueueRequest(request);
  }

