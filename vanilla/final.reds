class ScannerModule extends HUDModule {
  private let m_activeScans: [ScanInstance];

  private final func InitiateFreshScan();

  protected func Process(out task: HUDJob, mode: ActiveMode) {
    let isScanningCluesBlocked: Bool;
    if IsDefined(task.actor) && task.actor.IsClue() {
      let lockedClueID = this.m_hud.GetLockedClueID();
      if EntityID.IsDefined(lockedClueID) && lockedClueID != task.actor.GetEntityID() {
        isScanningCluesBlocked = true;
      }
    }
    let instruction = task.instruction.scannerInstructions;
    if IsDefined(instruction) && IsDefined(task.actor) {
      instruction.SetState(InstanceState.ON, this.DuplicateLastInstance(task.actor));
      instruction
        .SetContext(
          this.IsActorLookedAt(task.actor),
          task.actor.IsRevealed(),
          isScanningCluesBlocked
        );
    }
  }

  protected func Process(out jobs: [HUDJob], mode: ActiveMode) {
    let i = 0;
    while i < ArraySize(jobs) {
      this.Process(jobs[i], mode);
      i += 1;
    }
  }

  public func Suppress(jobs: script_ref<[HUDJob]>) {
    let i = 0;
    while i < ArraySize(jobs) {
      let instruction = jobs[i].instruction.scannerInstructions;
      instruction
        .SetState(InstanceState.DISABLED, this.DuplicateLastInstance(jobs[i].actor));
      instruction.SetContext(false, false, false);
      i += 1;
    }
  }

  protected func DuplicateLastInstance(actor: HUDActor) -> ScanInstance {
    return super.DuplicateLastInstance(actor) as ScanInstance;
  }
}

class BraindanceModule extends HUDModule {
  protected func Process(out task: HUDJob, mode: ActiveMode) {
    let instruction = task.instruction.braindanceInstructions;
    if !IsDefined(instruction) {
      return;
    } else if this.m_hud.IsBraindanceActive() {
      instruction.SetState(InstanceState.ON, this.DuplicateLastInstance(task.actor));
    }
    instruction.SetState(InstanceState.DISABLED, this.DuplicateLastInstance(task.actor));
  }

  protected func DuplicateLastInstance(actor: HUDActor) -> BraindanceInstance {
    return super.DuplicateLastInstance(actor) as BraindanceInstance;
  }

  protected func Process(out jobs: [HUDJob], mode: ActiveMode) {
    let i = 0;
    while i < ArraySize(jobs) {
      this.Process(jobs[i], mode);
      i += 1;
    }
  }
}

class HighlightModule extends HUDModule {
  protected func Process(out task: HUDJob, mode: ActiveMode) {
    if !IsDefined(task.actor) {
      return;
    }
    let instruction = task.instruction.highlightInstructions;
    if Equals(mode, ActiveMode.FOCUS) {
      instruction.SetState(InstanceState.ON, this.DuplicateLastInstance(task.actor));
      if task.actor.IsRevealed() {
        instruction
          .SetContext(
            HighlightContext.FULL,
            this.IsActorLookedAt(task.actor),
            task.actor.IsRevealed()
          );
        return;
      }
      if this.IsActorLookedAt(task.actor) {
        instruction.SetContext(HighlightContext.FULL, true, task.actor.IsRevealed());
        return;
      }
      instruction
        .SetContext(
          HighlightContext.FILL,
          this.IsActorLookedAt(task.actor),
          task.actor.IsRevealed()
        );
      return;
    } else if task.actor.IsRevealed() {
      instruction.SetState(InstanceState.ON, this.DuplicateLastInstance(task.actor));
      if Equals(mode, ActiveMode.FOCUS) {
        instruction
          .SetContext(
            HighlightContext.FULL,
            this.IsActorLookedAt(task.actor),
            task.actor.IsRevealed()
          );
        return;
      }
    }
    instruction
      .SetContext(
        HighlightContext.FULL,
        this.IsActorLookedAt(task.actor),
        task.actor.IsRevealed()
      );
    return;
  }

  protected func Process(out jobs: [HUDJob], mode: ActiveMode) {
    let i = 0;
    while i < ArraySize(jobs) {
      this.Process(jobs[i], mode);
      i += 1;
    }
  }

  public func Suppress(jobs: script_ref<[HUDJob]>) {
    let i = 0;
    while i < ArraySize(jobs) {
      let instruction = jobs[i].instruction.highlightInstructions;
      instruction
        .SetState(InstanceState.DISABLED, this.DuplicateLastInstance(jobs[i].actor));
      instruction.SetContext(HighlightContext.DEFAULT, false, false);
      i += 1;
    }
  }

  protected func DuplicateLastInstance(actor: HUDActor) -> HighlightInstance {
    return super.DuplicateLastInstance(actor) as HighlightInstance;
  }
}

class IconsModule extends HUDModule {
  protected func Process(out task: HUDJob, mode: ActiveMode) {
    let instruction = task.instruction.iconsInstruction;
    if !task.actor.IsGrouppedClue()
      && (Equals(mode, ActiveMode.FOCUS) || this.m_hud.IsPulseActive() || task.actor.IsRevealed() || task.actor.IsTagged()) {
      instruction.SetState(InstanceState.ON, this.DuplicateLastInstance(task.actor));
      instruction
        .SetContext(
          this.IsActorLookedAt(task.actor),
          task.actor.IsRevealed(),
          task.actor.IsIconForcedVisibileThroughWalls()
        );
      return;
    }
    if this.ShouldDisplayBodyDisposal(task.actor) {
      instruction.SetState(InstanceState.ON, this.DuplicateLastInstance(task.actor));
      instruction
        .SetContext(
          this.IsActorLookedAt(task.actor),
          task.actor.IsRevealed(),
          task.actor.IsIconForcedVisibileThroughWalls()
        );
      return;
    }
    if Equals(mode, ActiveMode.SEMI) && task.actor.IsInIconForcedVisibilityRange() {
      instruction.SetState(InstanceState.ON, this.DuplicateLastInstance(task.actor));
      instruction
        .SetContext(
          this.IsActorLookedAt(task.actor),
          task.actor.IsRevealed(),
          task.actor.IsIconForcedVisibileThroughWalls()
        );
      return;
    }
    if this.IsActorLookedAt(task.actor)
      && (NotEquals(task.actor.GetType(), HUDActorType.DEVICE)
        && NotEquals(task.actor.GetType(), HUDActorType.BODY_DISPOSAL_DEVICE)
        || task.actor.IsClue()) {
      instruction.SetState(InstanceState.ON, this.DuplicateLastInstance(task.actor));
      instruction
        .SetContext(
          this.IsActorLookedAt(task.actor),
          task.actor.IsRevealed(),
          task.actor.IsIconForcedVisibileThroughWalls()
        );
      return;
    }
    instruction.SetState(InstanceState.DISABLED, this.DuplicateLastInstance(task.actor));
    instruction
      .SetContext(
        this.IsActorLookedAt(task.actor),
        task.actor.IsRevealed(),
        task.actor.IsIconForcedVisibileThroughWalls()
      );
    return;
  }

  protected final func ShouldDisplayBodyDisposal(actor: HUDActor) -> Bool {
    if Equals(actor.GetType(), HUDActorType.BODY_DISPOSAL_DEVICE) {
      if this.IsPlayerCarrying() || this.IsEnemyGrappled() {
        return true;
      }
    }
    return false;
  }

  private const final func IsPlayerCarrying() -> Bool {
    return this
      .m_hud
      .GetPlayerSMBlackboard()
      .GetBool(GetAllBlackboardDefs().PlayerStateMachine.Carrying);
  }

  private const final func IsEnemyGrappled() -> Bool {
    return this
      .m_hud
      .GetPlayerSMBlackboard()
      .GetInt(GetAllBlackboardDefs().PlayerStateMachine.Takedown) == 2;
  }

  protected func Process(out jobs: [HUDJob], mode: ActiveMode) {
    let i = 0;
    while i < ArraySize(jobs) {
      this.Process(jobs[i], mode);
      i += 1;
    }
  }

  public func Suppress(jobs: script_ref<[HUDJob]>) {
    let i = 0;
    while i < ArraySize(jobs) {
      let instruction = jobs[i].instruction.iconsInstruction;
      instruction
        .SetState(InstanceState.DISABLED, this.DuplicateLastInstance(jobs[i].actor));
      instruction.SetContext(false, false, false);
      i += 1;
    }
  }

  protected func DuplicateLastInstance(actor: HUDActor) -> IconsInstance {
    return super.DuplicateLastInstance(actor) as IconsInstance;
  }
}

