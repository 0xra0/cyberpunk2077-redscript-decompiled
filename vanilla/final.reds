class InspectableItemObject extends ItemObject {
  public const let m_inspectableClues: [SInspectableClue];

  protected final func DisplayScanButton(show: Bool);

  protected cb func OnRequestComponents(ri: EntityRequestComponentsInterface) -> Bool;

  protected cb func OnTakeControl(ri: EntityResolveComponentsInterface) -> Bool;

  protected cb func OnGameAttached() -> Bool {
    super.OnGameAttached();
  }

  public const final func IsClueScanned(clueName: CName) -> Bool {
    return Cast<Bool>(GetFact(this.GetGame(), clueName));
  }

  protected cb func OnInteractionActivated(evt: InteractionActivationEvent) -> Bool {
    let isScanned = this.IsClueScanned(evt.layerData.tag);
    let newEvt = new ScanEvent();
    if Equals(evt.eventType, gameinteractionsEInteractionEventType.EIET_activate) {
      newEvt.isAvailable = true;
      newEvt.clue = NameToString(evt.layerData.tag);
      if GetFact(this.GetGame(), evt.layerData.tag) == 0 {
        this.DisplayScanButton(true);
      } else if isScanned {
      }
    } else {
      newEvt.isAvailable = false;
      newEvt.clue = "";
      this.DisplayScanButton(false);
    }
    this.QueueEventForEntityID(evt.activator.GetEntityID(), newEvt);
  }
}

