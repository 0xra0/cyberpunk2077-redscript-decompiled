}

class PlayerDoesntHaveRecipePrereqState extends PrereqState {
}

class PlayerDoesntHaveRecipePrereq extends IScriptablePrereq {
  public let m_recipeID: TweakDBID;
  public let m_invert: Bool;

  protected func Initialize(recordID: TweakDBID) {
    this.m_recipeID = TDBID.Create(TweakDBInterface.GetString(recordID + t".recipe", ""));
    this.m_invert = TweakDBInterface.GetBool(recordID + t".invert", false);
  }

  protected const func OnApplied(state: PrereqState, game: GameInstance, context: IScriptable) {
    let craftingSystem = CraftingSystem.GetInstance(game);
    let playerCraftBook = craftingSystem.GetPlayerCraftBook();
    let result = !craftingSystem.IsRecipeKnown(this.m_recipeID, playerCraftBook);
    (state as PlayerDoesntHaveRecipePrereqState).OnChanged(result);
  }

  public const func IsFulfilled(game: GameInstance, context: IScriptable) -> Bool {
    let craftingSystem = CraftingSystem.GetInstance(game);
    let playerCraftBook = craftingSystem.GetPlayerCraftBook();
    let result = !craftingSystem.IsRecipeKnown(this.m_recipeID, playerCraftBook);
    if this.m_invert {
      return !result;
    }
    return result;
  }
}

