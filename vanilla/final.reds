class ScannerDeviceBodyGameController extends BaseChunkGameController {
  private let m_networkStatusText: inkTextRef;
  private let m_deviceAuthorizationText: inkTextRef;
  private let m_deviceAuthorizationRow: inkCompoundRef;
  private let m_networkStatusRow: inkCompoundRef;
  private let m_networkStatusCallbackID: CallbackHandle;
  private let m_deviceAuthorizationCallbackID: CallbackHandle;
  private let m_isValidnetworkStatus: Bool;
  private let m_isValidDeviceAuthorization: Bool;

  protected cb func OnInitialize() -> Bool {
    super.OnInitialize();
    this.m_networkStatusCallbackID = this
      .m_chunkBlackboard
      .RegisterDelayedListenerVariant(
        this.m_chunkBlackboardDef.ScannerNetworkStatus,
        this,
        n"OnNetworkStatusChanged"
      );
    this.m_deviceAuthorizationCallbackID = this
      .m_chunkBlackboard
      .RegisterDelayedListenerVariant(
        this.m_chunkBlackboardDef.ScannerAuthorization,
        this,
        n"OnDeviceAuthorizationChanged"
      );
    this
      .OnNetworkStatusChanged(
        this
          .m_chunkBlackboard
          .GetVariant(this.m_chunkBlackboardDef.ScannerNetworkStatus)
      );
    this
      .OnDeviceAuthorizationChanged(
        this
          .m_chunkBlackboard
          .GetVariant(this.m_chunkBlackboardDef.ScannerAuthorization)
      );
  }

  protected cb func OnUninitialize() -> Bool {
    this
      .m_chunkBlackboard
      .UnregisterDelayedListener(
        GetAllBlackboardDefs().UI_ScannerModules.ScannerNetworkStatus,
        this.m_networkStatusCallbackID
      );
    this
      .m_chunkBlackboard
      .UnregisterDelayedListener(
        GetAllBlackboardDefs().UI_ScannerModules.ScannerAuthorization,
        this.m_deviceAuthorizationCallbackID
      );
  }

  protected cb func OnNetworkStatusChanged(value: Variant) -> Bool {
    let networkStatusData = FromVariant<ScannerNetworkStatus>(value);
    if IsDefined(networkStatusData) {
      if NotEquals(networkStatusData.GetNetworkStatus(), ScannerNetworkState.NOT_BREACHED) {
        inkTextRef
          .SetText(this.m_networkStatusText, ToString(networkStatusData.GetNetworkStatus()));
        this.m_isValidnetworkStatus = true;
      } else {
        this.m_isValidnetworkStatus = false;
      }
    } else {
      this.m_isValidnetworkStatus = false;
    }
    this.UpdateGlobalVisibility();
  }

  protected cb func OnDeviceAuthorizationChanged(value: Variant) -> Bool {
    let deviceAuthorizationData = FromVariant<ScannerAuthorization>(value);
    if IsDefined(deviceAuthorizationData) {
      this.m_isValidDeviceAuthorization = true;
      if deviceAuthorizationData.ProtectedByKeycard() {
        inkTextRef
          .SetLocalizedTextScript(
            this.m_deviceAuthorizationText,
            "Gameplay-Devices-DisplayNames-Keycard"
          );
      } else if deviceAuthorizationData.ProtectedByPassword() {
        inkTextRef
          .SetLocalizedTextScript(
            this.m_deviceAuthorizationText,
            "Gameplay-Devices-DisplayNames-PasssodeRequired"
          );
      }
    } else {
      this.m_isValidDeviceAuthorization = false;
    }
    this.UpdateGlobalVisibility();
  }

  private final func UpdateGlobalVisibility() {
    this
      .GetRootWidget()
      .SetVisible(this.m_isValidnetworkStatus || this.m_isValidDeviceAuthorization);
    inkWidgetRef.SetVisible(this.m_networkStatusRow, this.m_isValidnetworkStatus);
    inkWidgetRef
      .SetVisible(this.m_deviceAuthorizationRow, this.m_isValidDeviceAuthorization);
  }
}

abstract class AISubActionDisableAimAssist_Record_Implementation extends IScriptable {
  public final static func Activate(
    context: ScriptExecutionContext,
    record: wref<AISubActionDisableAimAssist_Record>
  ) {
    if record.Delay() <= 0.0 {
      AISubActionDisableAimAssist_Record_Implementation.DisableAimAssist(context, record.Reason());
    }
  }

  public final static func Update(
    context: ScriptExecutionContext,
    record: wref<AISubActionDisableAimAssist_Record>,
    const duration: Float
  ) -> AIbehaviorUpdateOutcome {
    if duration >= record.Delay() {
      AISubActionDisableAimAssist_Record_Implementation.DisableAimAssist(context, record.Reason());
    }
    return AIbehaviorUpdateOutcome.IN_PROGRESS;
  }

  public final static func Deactivate(
    context: ScriptExecutionContext,
    record: wref<AISubActionDisableAimAssist_Record>,
    const duration: Float,
    interrupted: Bool
  ) {
    AISubActionDisableAimAssist_Record_Implementation.EnableAimAssist(context);
  }

  public final static func EnableAimAssist(context: ScriptExecutionContext) {
    let puppet = ScriptExecutionContext.GetOwner(context) as NPCPuppet;
    if puppet.IsAimAssistEnabled() {
      return;
    }
    puppet.QueueEvent(new EnableAimAssist());
  }

  public final static func DisableAimAssist(context: ScriptExecutionContext, opt reason: CName) {
    if Equals(reason, n"timeDilation") {
      let player = GameInstance
        .GetPlayerSystem(ScriptExecutionContext.GetOwner(context).GetGame())
        .GetLocalPlayerMainGameObject() as PlayerPuppet;
      if GameInstance.GetTimeSystem(player.GetGame()).IsTimeDilationActive() {
        AISubActionDisableAimAssist_Record_Implementation.EnableAimAssist(context);
        return;
      }
    }
    let puppet = ScriptExecutionContext.GetOwner(context) as NPCPuppet;
    if !puppet.IsAimAssistEnabled() {
      return;
    }
    puppet.QueueEvent(new DisableAimAssist());
  }
}

importonly native class AISubActionDisableAimAssist_Record extends AISubAction_Record {
  public final native func Reason() -> CName;

  public final native func Delay() -> Float;

  public final native func Duration() -> Float;
}

