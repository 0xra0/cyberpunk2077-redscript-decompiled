  public final static func EvaluateLootQuality(self: wref<GameObject>) {
    if self != null {
      let evt = new gameEvaluateLootQualityEvent();
      self.QueueEvent(evt);
    }
  }

  protected cb func OnEvaluateLootQuality(evt: gameEvaluateLootQualityEvent) -> Bool {
    if this.EvaluateLootQuality() {
      this.RequestHUDRefresh();
    }
  }

  private final func EvaluateLootQuality() -> Bool {
    let lastValue: Int32;
    let items: [wref<gameItemData>];
    let transactionSystem = GameInstance.GetTransactionSystem(this.GetGame());
    let currentQuality = this.m_lootQuality;
    let isCurrentlyQuest = this.IsQuest();
    let isCurrentlyIconic = this.GetIsIconic();
    this.m_isIconic = false;
    this.m_hasQuestItems = false;
    if transactionSystem.GetItemList(this, items) {
      if ArraySize(items) > 0 {
        let qualityToSet = gamedataQuality.Common;
      }
      let i = 0;
      while i < ArraySize(items) {
        let type = items[i].GetItemType();
        if Equals(type, gamedataItemType.Con_Ammo) {
        } else if !this.m_hasQuestItems && items[i].HasTag(n"Quest") {
          this.m_hasQuestItems = true;
        } else {
          let iteratedQuality = RPGManager.GetItemDataQuality(items[i]);
          let newValue = UIItemsHelper.QualityEnumToInt(iteratedQuality);
          if newValue > lastValue {
            lastValue = newValue;
            qualityToSet = iteratedQuality;
          } else {
            this.m_isIconic = this.m_isIconic || RPGManager.IsItemIconic(items[i]);
          }
        }
        i += 1;
      }
      this.m_lootQuality = qualityToSet;
    } else if NotEquals(isCurrentlyQuest, this.IsQuest()) {
      RPGManager.ToggleLootHighlight(this, this.IsQuest());
    }
    let wasChanged = NotEquals(this.m_lootQuality, currentQuality)
      || NotEquals(isCurrentlyQuest, this.IsQuest())
      || NotEquals(isCurrentlyIconic, this.m_isIconic);
    if wasChanged || !IsNameValid(this.m_activeQualityRangeInteraction) {
      this.ResolveQualityRangeInteractionLayer();
    }
    return wasChanged;
  }

  public const func GetLootQuality() -> gamedataQuality {
    return this.m_lootQuality;
  }

  public const func GetIsIconic() -> Bool {
    return this.m_isIconic;
  }

  public const func IsContainer() -> Bool {
    if NotEquals(this.m_lootQuality, gamedataQuality.Invalid) && NotEquals(this.m_lootQuality, gamedataQuality.Random) {
      return true;
    }
    return false;
  }

  protected const final func HasLoot() -> Bool {
    let itemList: [wref<gameItemData>];
    let object = EntityGameInterface.GetEntity(this.GetEntity()) as GameObject;
    GameInstance.GetTransactionSystem(this.GetGame()).GetItemList(object, itemList);
    return ArraySize(itemList) > 0;
  }

  protected const final func HasValidLootQuality() -> Bool {
    return NotEquals(this.m_lootQuality, gamedataQuality.Invalid) && NotEquals(this.m_lootQuality, gamedataQuality.Random);
  }

  protected cb func OnInventoryEmptyEvent(evt: OnInventoryEmptyEvent) -> Bool {
    if this.HasValidLootQuality() {
      this.m_lootQuality = gamedataQuality.Invalid;
      GameObject.UntagObject(this);
      if !this.ShouldRegisterToHUD() {
        this.RegisterToHUDManagerByTask(false);
      } else {
        this.RequestHUDRefresh();
      }
      this.ResolveQualityRangeInteractionLayer();
    } else if this.IsQuest() {
      RPGManager.ToggleLootHighlight(this, false);
    }
  }

  protected cb func OnItemRemovedEvent(evt: ItemBeingRemovedEvent) -> Bool {
    if this.HasValidLootQuality() {
      if this.EvaluateLootQuality() {
        this.RequestHUDRefresh();
      }
    }
  }

  protected cb func OnItemAddedEvent(evt: ItemAddedEvent) -> Bool {
    if this.HasValidLootQuality() {
      if this.EvaluateLootQuality() {
        this.RequestHUDRefresh();
      }
    }
  }

  protected cb func OnInventoryChangedEvent(evt: InventoryChangedEvent) -> Bool {
    if this.HasValidLootQuality() {
      if this.EvaluateLootQuality() {
        this.RequestHUDRefresh();
      }
    }
  }

  public const func GetDefaultHighlight() -> FocusForcedHighlightData {
    if !this.IsActive()
      && !gamePuppet
        .HasLootableItems(EntityGameInterface.GetEntity(this.GetEntity()) as ScriptedPuppet) {
      return null;
    } else if this.m_scanningComponent.IsBraindanceBlocked() || this.m_scanningComponent.IsPhotoModeBlocked() {
      return null;
    } else if this.IsChimera() {
      return this.GetChimeraHighlight();
    }
    let highlight = new FocusForcedHighlightData();
    highlight.outlineType = this.GetCurrentOutline();
    switch highlight.outlineType {
      case EFocusOutlineType.QUEST:
        highlight.highlightType = EFocusForcedHighlightType.QUEST;
        break;
      case EFocusOutlineType.ITEM:
        highlight.highlightType = EFocusForcedHighlightType.ITEM;
        break;
      case EFocusOutlineType.HOSTILE:
        highlight.highlightType = EFocusForcedHighlightType.HOSTILE;
        break;
      case EFocusOutlineType.FRIENDLY:
        highlight.highlightType = EFocusForcedHighlightType.FRIENDLY;
        break;
      case EFocusOutlineType.NEUTRAL:
        highlight.highlightType = EFocusForcedHighlightType.NEUTRAL;
        break;
      default:
        return null;
    }
    highlight.sourceID = this.GetEntityID();
    highlight.sourceName = this.GetClassName();
    if this.IsQuickHackAble() {
      highlight.patternType = VisionModePatternType.Netrunner;
    } else {
      highlight.patternType = VisionModePatternType.Default;
    }
    return highlight;
  }

  private const final func IsChimera() -> Bool {
    return Equals(this.GetNPCType(), gamedataNPCType.Chimera);
  }

  private const final func GetChimeraHighlight() -> FocusForcedHighlightData {
    let highlight = new FocusForcedHighlightData();
    highlight.sourceID = this.GetEntityID();
    highlight.sourceName = this.GetClassName();
    highlight.highlightType = EFocusForcedHighlightType.HOSTILE;
    highlight.outlineType = EFocusOutlineType.INVALID;
    if this.IsQuickHackAble() {
      highlight.patternType = VisionModePatternType.Netrunner;
    } else {
      highlight.patternType = VisionModePatternType.Default;
    }
    return highlight;
  }

  public const func GetCurrentOutline() -> EFocusOutlineType {
    let outlineType: EFocusOutlineType;
    let playerPuppet = GameInstance.GetPlayerSystem(this.GetGame()).GetLocalPlayerMainGameObject() as PlayerPuppet;
    if this.IsQuest() {
      return EFocusOutlineType.QUEST;
    } else if !this.IsActive() {
      return EFocusOutlineType.ITEM;
    }
    let attitude = GameObject.GetAttitudeTowards(this, playerPuppet);
    if this.IsAggressive() || this.IsBoss() || Equals(this.GetNPCRarity(), gamedataNPCRarity.MaxTac) {
      if Equals(attitude, EAIAttitude.AIA_Friendly) {
        outlineType = EFocusOutlineType.FRIENDLY;
      } else if this.IsPrevention() && Equals(attitude, EAIAttitude.AIA_Neutral) {
        outlineType = EFocusOutlineType.NEUTRAL;
      } else {
        outlineType = EFocusOutlineType.HOSTILE;
      }
    } else if this.IsTaggedinFocusMode() {
      outlineType = EFocusOutlineType.NEUTRAL;
    } else {
      outlineType = EFocusOutlineType.INVALID;
    }
    return outlineType;
  }

  protected cb func OnRevealStateChanged(evt: RevealStateChangedEvent) -> Bool {
    if Equals(evt.state, ERevealState.STARTED) {
      this
        .ToggleForcedVisibilityInAnimSystem(n"RevealStateChangedEvent", true, 0.0, true);
    } else if Equals(evt.state, ERevealState.STOPPED) {
      this
        .ToggleForcedVisibilityInAnimSystem(n"RevealStateChangedEvent", false, evt.transitionTime, true);
    }
  }

  protected cb func OnHUDInstruction(evt: HUDInstruction) -> Bool {
    super.OnHUDInstruction(evt);
    if evt.quickhackInstruction.ShouldProcess() {
      this.TryOpenQuickhackMenu(evt.quickhackInstruction.ShouldOpen());
    }
  }

  protected cb func OnHit(evt: gameHitEvent) -> Bool {
    super.OnHit(evt);
  }

  protected func DamagePipelineFinalized(evt: gameHitEvent) {
    super.DamagePipelineFinalized(evt);
    this.m_hitHistory.AddHit(evt);
    this.PuppetDamagePipelineFinalized(evt);
  }

  public final func PuppetDamagePipelineFinalized(evt: gameHitEvent) {
    if this.ResolveHitIstigatorCooldown(evt.attackData.GetInstigator().GetEntityID()) && ScriptedPuppet.IsAlive(this) {
      GameObject.PlayVoiceOver(this, n"vo_any_damage_hit", n"Scripts:OnHit");
      TargetTrackingExtension.OnHit(this, evt);
    }
  }

  protected func HandleStimsOnHit(evt: gameHitEvent) {
    let attackData: stimInvestigateData;
    super.HandleStimsOnHit(evt);
    if IsDefined(this.m_stimBroadcaster) {
      let instigatorID = evt.attackData.GetInstigator().GetEntityID();
      if AttackData.IsMelee(evt.attackData.GetAttackType()) {
        attackData.attackInstigator = evt.attackData.GetInstigator();
        let reactionCmp = (attackData.attackInstigator as ScriptedPuppet).GetStimReactionComponent();
        if evt.attackData.GetInstigator().IsPlayer()
          || IsDefined(reactionCmp)
            && NotEquals(
              reactionCmp.GetReactionPreset().Type(),
              gamedataReactionPresetType.NoReaction
            ) {
          if this.IsCharacterCivilian() || this.IsCrowd() {
            if this
              .m_stimBroadcaster
              .ResolveStimProcessingCooldown(instigatorID, gamedataStimType.CrimeWitness, 1.0) {
              let broadcaster = evt.attackData.GetInstigator().GetStimBroadcasterComponent();
              if IsDefined(broadcaster) {
                broadcaster
                  .TriggerSingleBroadcast(this, gamedataStimType.CrimeWitness, 20.0);
              } else if this
                .m_stimBroadcaster
                .ResolveStimProcessingCooldown(instigatorID, gamedataStimType.MeleeHit, 1.0)
                && NotEquals(
                  this.m_reactionComponent.GetReactionPreset().Type(),
                  gamedataReactionPresetType.NoReaction
                ) {
                this
                  .m_stimBroadcaster
                  .TriggerSingleBroadcast(this, gamedataStimType.MeleeHit, attackData);
              }
            }
          }
        }
      }
    }
  }

  public final func GetLastDamageTimeFrom(threat: GameObject, out isMelee: Bool) -> Float {
    if threat == null {
      return -1.0;
    }
    return this.m_hitHistory.GetLastDamageTime(threat, isMelee);
  }

  public const final func GetGender() -> CName {
    return this.GetPS().GetGender();
  }

  protected const func ShouldRegisterToHUD() -> Bool {
    if !IsDefined(this.m_scanningComponent) && !IsDefined(this.m_visionComponent) {
      return false;
    }
    if this.m_forceRegisterInHudManager {
      return true;
    }
    if this.IsAnyClueEnabled() || this.HasAnyStoredClues() || this.IsQuest() {
      return true;
    }
    if this.IsPrevention() {
      return true;
    }
    if (!this.IsCrowd() || this.GetWasAggressiveCrowd()) && (this.IsActive() || this.IsContainer()) {
      return true;
    }
    return false;
  }

  public const func CanRevealRemoteActionsWheel() -> Bool {
    if !this.ShouldRegisterToHUD() {
      return false;
    } else if !this.IsQuickHackAble() {
      return false;
    }
    return true;
  }

  public const func HasDirectActionsActive() -> Bool {
    let choices: [InteractionChoice];
    let actionRecords: [wref<ObjectAction_Record>];
    let context = this
      .GetPS()
      .GenerateContext(
        gamedeviceRequestType.Direct,
        Device.GetInteractionClearance(),
        Device.GetPlayerMainObjectStatic(this.GetGame()),
        this.GetEntityID()
      );
    this
      .GetPS()
      .GetValidChoices(actionRecords, context, this.m_objectActionsCallbackCtrl, true, choices);
    if this.GetPS().HasDirectInteractionChoicesActive() {
      return true;
    } else if this.GetPS().HasActiveContext(gamedeviceRequestType.Direct) && ArraySize(choices) > 0 {
      return true;
    }
    return false;
  }

  private const final func GetBlackboardIntVariable(id: BlackboardID_Int) -> Int32 {
    let blackboardSystem = GameInstance.GetBlackboardSystem(this.GetGame());
    let blackboard = blackboardSystem
      .GetLocalInstanced(
        GetPlayer(this.GetGame()).GetEntityID(),
        GetAllBlackboardDefs().PlayerStateMachine
      );
    return blackboard.GetInt(id);
  }

  protected func SendQuickhackCommands(shouldOpen: Bool) {
    let puppetActions: [PuppetAction];
    let commands: [QuickhackData];
    let actionRecords: [wref<ObjectAction_Record>];
    let quickSlotsManagerNotification = new RevealInteractionWheel();
    quickSlotsManagerNotification.lookAtObject = this;
    if shouldOpen {
      let context = this
        .GetPS()
        .GenerateContext(
          gamedeviceRequestType.Remote,
          Device.GetInteractionClearance(),
          GameInstance.GetPlayerSystem(this.GetGame()).GetLocalPlayerControlledGameObject(),
          this.GetEntityID()
        );
      this.GetRecord().ObjectActions(actionRecords);
      this.GetPS().GetAllChoices(actionRecords, context, puppetActions);
      this.TranslateChoicesIntoQuickSlotCommands(puppetActions, commands);
      quickSlotsManagerNotification.commands = commands;
      quickSlotsManagerNotification.shouldReveal = ArraySize(puppetActions) > 0;
    }
    GameInstance.GetUISystem(this.GetGame()).QueueEvent(quickSlotsManagerNotification);
  }

  public const final func GetPingDuration() -> Float {
    let puppetActions: [PuppetAction];
    let actionRecords: [wref<ObjectAction_Record>];
    let player = GetPlayer(this.GetGame());
    let context = this
      .GetPS()
      .GenerateContext(
        gamedeviceRequestType.Remote,
        Device.GetInteractionClearance(),
        GameInstance.GetPlayerSystem(this.GetGame()).GetLocalPlayerControlledGameObject(),
        this.GetEntityID()
      );
    this.GetPS().GetAllChoices(actionRecords, context, puppetActions);
    let playerQHacksList = RPGManager.GetPlayerQuickHackListWithQuality(player);
    let i = 0;
    while i < ArraySize(playerQHacksList) {
      let actionRecord = playerQHacksList[i].actionRecord;
      let actionName = actionRecord.ActionName();
      if Equals(actionName, n"Ping") {
        let i1 = 0;
        while i1 < ArraySize(actionRecords) {
          if Equals(actionRecord.ActionName(), actionRecords[i1].ActionName()) {
            if actionRecord.Priority() < actionRecords[i1].Priority() {
              actionRecord = actionRecords[i1];
            }
          }
          i += 1;
        }
        return this
          .GetQuickHackDuration(
            actionRecord,
            this,
            Cast<StatsObjectID>(this.GetEntityID()),
            player.GetEntityID()
          );
      }
      i += 1;
    }
    return 0.0;
  }

  private const final func GetQuickHackDuration(
    quickHackID: TweakDBID,
    rootObject: wref<GameObject>,
    targetID: StatsObjectID,
    instigatorID: EntityID
  ) -> Float {
    return this
      .GetQuickHackDuration(
        TweakDBInterface.GetObjectActionRecord(quickHackID),
        rootObject,
        targetID,
        instigatorID
      );
  }

  private const final func GetQuickHackDuration(
    quickHackRecord: wref<ObjectAction_Record>,
    rootObject: wref<GameObject>,
    targetID: StatsObjectID,
    instigatorID: EntityID
  ) -> Float {
    let durationMods: [wref<ObjectActionEffect_Record>];
    if !IsDefined(quickHackRecord) {
      return 0.0;
    }
    quickHackRecord.CompletionEffects(durationMods);
    return this
      .GetObjectActionEffectDurationValue(
        quickHackRecord.HackCategory().Type(),
        durationMods,
        rootObject,
        targetID,
        instigatorID
      );
  }

  private const final func GetObjectActionEffectDurationValue(
    category: gamedataHackCategory,
    const durationMods: script_ref<[wref<ObjectActionEffect_Record>]>,
    rootObject: wref<GameObject>,
    targetID: StatsObjectID,
    instigatorID: EntityID
  ) -> Float {
    let statModifiers: [wref<StatModifier_Record>];
    let durationValue: Float;
    let durationModifier = 0.0;
    if ArraySize(durationMods) > 0 {
      let player = GetPlayer(this.GetGame());
      let ignoredDurationStats = this.GetIgnoredDurationStats();
      let i = 0;
      while i < ArraySize(durationMods) {
        let effectToCast = durationMods[i].StatusEffect();
        if IsDefined(effectToCast) {
          if !ArrayContains(ignoredDurationStats, effectToCast) {
            let lastMatchingEffect = effectToCast;
          }
        } else if IsDefined(durationMods[i].EffectorToTrigger())
          && Equals(
            durationMods[i].EffectorToTrigger().EffectorClassName(),
            n"ApplyLegendaryWhistleEffector"
          ) {
          lastMatchingEffect = TweakDBInterface.GetStatusEffectRecord(t"BaseStatusEffect.WhistleLvl4");
        }
        i += 1;
      }
      effectToCast = lastMatchingEffect;
      let duration = effectToCast.Duration();
      duration.StatModifiers(statModifiers);
      durationValue = RPGManager
        .CalculateStatModifiers(
          statModifiers,
          this.GetGame(),
          rootObject,
          targetID,
          Cast<StatsObjectID>(instigatorID)
        );
      if Cast<Bool>(
        PlayerDevelopmentSystem
          .GetData(player)
          .IsNewPerkBought(gamedataNewPerkType.Intelligence_Central_Perk_1_3)
      )
        && Equals(category, gamedataHackCategory.ControlHack)
        && GameInstance
          .GetStatPoolsSystem(this.GetGame())
          .HasStatPoolValueReachedMax(Cast<StatsObjectID>(this.GetEntityID()), gamedataStatPoolType.Health) {
        durationModifier
          += TweakDBInterface
            .GetFloat(t"NewPerks.Intelligence_Central_Perk_1_3.durationMultiplier", 0.0);
      } else if Cast<Bool>(
        PlayerDevelopmentSystem
          .GetData(player)
          .IsNewPerkBought(gamedataNewPerkType.Intelligence_Left_Milestone_1)
      ) && IsDefined(player.TryGetControlledProxy()) {
        durationModifier
          += TweakDBInterface
            .GetFloat(t"NewPerks.Intelligence_Left_Milestone_1.durationIncease", 0.0);
      }
      durationValue = durationValue * (1.0 + durationModifier);
    }
    return durationValue;
  }

  public final func GetQuickHackDurationFromLongestEffect(
    quickHackRecord: wref<ObjectAction_Record>,
    rootObject: wref<GameObject>,
    targetID: StatsObjectID,
    instigatorID: EntityID
  ) -> Float {
    let durationMods: [wref<ObjectActionEffect_Record>];
    let tempStatModifiers: [wref<StatModifier_Record>];
    let longestDurationValue = 0.0;
    if !IsDefined(quickHackRecord) {
      return 0.0;
    }
    quickHackRecord.CompletionEffects(durationMods);
    if ArraySize(durationMods) > 0 {
      let ignoredDurationStats = this.GetIgnoredDurationStats();
      let i = 0;
      while i < ArraySize(durationMods) {
        let tempEffect = durationMods[i].StatusEffect();
        if IsDefined(durationMods[i].EffectorToTrigger())
          && Equals(
            durationMods[i].EffectorToTrigger().EffectorClassName(),
            n"ApplyLegendaryWhistleEffector"
          ) {
          tempEffect = TweakDBInterface.GetStatusEffectRecord(t"BaseStatusEffect.WhistleLvl4");
        } else if IsDefined(tempEffect) {
          if ArrayContains(ignoredDurationStats, tempEffect) {
          }
          let tempDuration = tempEffect.Duration();
          tempDuration.StatModifiers(tempStatModifiers);
          let tempDurationValue = RPGManager
            .CalculateStatModifiers(
              tempStatModifiers,
              this.GetGame(),
              rootObject,
              targetID,
              Cast<StatsObjectID>(instigatorID)
            );
          if tempDurationValue > longestDurationValue {
            longestDurationValue = tempDurationValue;
          }
          ArrayClear(tempStatModifiers);
        }
        i += 1;
      }
    }
    return longestDurationValue;
  }

  private final func TranslateChoicesIntoQuickSlotCommands(
    const puppetActions: script_ref<[PuppetAction]>,
    commands: script_ref<[QuickhackData]>
  ) {
    let newCommand: QuickhackData;
    let i: Int32;
    let actionStartEffects: [wref<ObjectActionEffect_Record>];
    let statModifiers: [wref<StatModifier_Record>];
    let targetActivePrereqs: [wref<ObjectActionPrereq_Record>];
    let prereqsToCheck: [wref<IPrereq_Record>];
    let actionCompletionEffects: [wref<ObjectActionEffect_Record>];
    let playerRef = GetPlayer(this.GetGame());
    let isOngoingUpload = GameInstance
      .GetStatPoolsSystem(this.GetGame())
      .IsStatPoolAdded(
        Cast<StatsObjectID>(this.GetEntityID()),
        gamedataStatPoolType.QuickHackUpload
      );
    let iceLVL = this.GetICELevel();
    let actionOwnerName = StringToName(this.GetTweakDBFullDisplayName(true));
    let isBreached = this.IsBreached();
    let playerQHacksList = RPGManager.GetPlayerQuickHackListWithQuality(playerRef);
    if ArraySize(playerQHacksList) == 0 {
      newCommand = new QuickhackData();
      newCommand.m_title = "LocKey#42171";
      newCommand.m_isLocked = true;
      newCommand.m_actionOwnerName = actionOwnerName;
      newCommand.m_actionState = EActionInactivityReson.Invalid;
      newCommand.m_description = "LocKey#42172";
      newCommand.m_noQuickhackData = true;
      ArrayPush(commands, newCommand);
    } else {
      let isMounted = VehicleComponent.IsMountedToVehicle(this.GetGame(), this);
      i = 0;
      if i < ArraySize(playerQHacksList) {
        newCommand = new QuickhackData();
        ArrayClear(actionStartEffects);
        let actionRecord = playerQHacksList[i].actionRecord;
        if NotEquals(
          actionRecord.ObjectActionType().Type(),
          gamedataObjectActionType.PuppetQuickHack
        ) {
        } else {
          newCommand.m_actionOwnerName = actionOwnerName;
          newCommand.m_title = LocKeyToString(actionRecord.ObjectActionUI().Caption());
          newCommand.m_description = LocKeyToString(actionRecord.ObjectActionUI().Description());
          newCommand.m_itemID = playerQHacksList[i].itemID;
          newCommand.m_icon = actionRecord
            .ObjectActionUI()
            .CaptionIcon()
            .TexturePartID()
            .GetID();
          newCommand.m_iconCategory = actionRecord.GameplayCategory().IconName();
          newCommand.m_type = actionRecord.ObjectActionType().Type();
          newCommand.m_actionOwner = this.GetEntityID();
          newCommand.m_isInstant = false;
          newCommand.m_ICELevel = iceLVL;
          newCommand.m_ICELevelVisible = true;
          newCommand.m_actionState = EActionInactivityReson.Locked;
          newCommand.m_quality = playerQHacksList[i].quality;
          newCommand.m_costRaw = BaseScriptableAction.GetBaseCostStatic(playerRef, actionRecord);
          newCommand.m_networkBreached = isBreached;
          newCommand.m_category = actionRecord.HackCategory();
          ArrayClear(actionCompletionEffects);
          actionRecord.CompletionEffects(actionCompletionEffects);
          newCommand.m_actionCompletionEffects = actionCompletionEffects;
          actionRecord.StartEffects(actionStartEffects);
          let i1 = 0;
          if i1 < ArraySize(actionStartEffects) {
            if Equals(
              actionStartEffects[i1]
                .StatusEffect()
                .StatusEffectType()
                .Type(),
              gamedataStatusEffectType.PlayerCooldown
            ) {
              actionStartEffects[i1]
                .StatusEffect()
                .Duration()
                .StatModifiers(statModifiers);
              newCommand.m_cooldown = RPGManager
                .CalculateStatModifiers(
                  statModifiers,
                  this.GetGame(),
                  playerRef,
                  Cast<StatsObjectID>(playerRef.GetEntityID()),
                  Cast<StatsObjectID>(playerRef.GetEntityID())
                );
              newCommand.m_cooldownTweak = actionStartEffects[i1].StatusEffect().GetID();
              ArrayClear(statModifiers);
            } else if newCommand.m_cooldown != 0.0 {
            } else {
              i1 += 1;
            }
          } else {
            ArrayClear(statModifiers);
            newCommand.m_duration = this
              .GetQuickHackDuration(
                playerQHacksList[i].actionRecord,
                EntityGameInterface.GetEntity(this.GetEntity()) as GameObject,
                Cast<StatsObjectID>(this.GetEntityID()),
                playerRef.GetEntityID()
              );
            let actionMatchDeck = false;
            i1 = 0;
            if i1 < ArraySize(puppetActions) {
              if Equals(
                actionRecord.ActionName(),
                puppetActions[i1].GetObjectActionRecord().ActionName()
              ) {
                actionMatchDeck = true;
                if actionRecord.Priority() >= puppetActions[i1].GetObjectActionRecord().Priority() {
                  puppetActions[i1].SetObjectActionID(actionRecord.GetID());
                } else {
                  newCommand.m_costRaw = puppetActions[i1].GetBaseCost();
                  newCommand.m_cost = puppetActions[i1].GetCost();
                  newCommand.m_awarenessCost = puppetActions[i1].GetAwarenessCost(this.GetGame());
                  newCommand.m_willReveal = QuickHackableHelper
                    .WillHackRevealPlayer(
                      playerRef,
                      this.GetRecordID(),
                      puppetActions[i1],
                      newCommand.m_itemID
                    );
                  newCommand.m_showRevealInfo = QuickHackableHelper
                    .ShouldShowRevealInfoWithTarget(playerRef, this, newCommand.m_awarenessCost);
                  if GameInstance
                    .GetStatsSystem(this.GetGame())
                    .GetStatValue(
                      Cast<StatsObjectID>(this.GetEntityID()),
                      gamedataStatType.PreventQuickhacking
                    ) > 0.0 {
                    if NPCManager.HasTag(this.GetRecordID(), n"q305_maxtac") {
                      puppetActions[i1].SetInactiveWithReason(false, "LocKey#93242");
                    }
                    puppetActions[i1].SetInactiveWithReason(false, "LocKey#27694");
                  } else if StatusEffectSystem
                    .ObjectHasStatusEffect(playerRef, t"BaseStatusEffect.SmasherICE_DisableCyberdeck") {
                    puppetActions[i1].SetInactiveWithReason(false, "LocKey#95870");
                  } else if !puppetActions[i1].IsPossible(this) || !puppetActions[i1].IsVisible(playerRef) {
                    puppetActions[i1].SetInactiveWithReason(false, "LocKey#7019");
                  }
                  if isMounted
                    && Equals(
                      newCommand.m_category.Type(),
                      gamedataHackCategory.UltimateHack
                    ) {
                    puppetActions[i1].SetInactiveWithReason(false, "LocKey#7003");
                  }
                  newCommand.m_uploadTime = puppetActions[i1].GetActivationTime();
                  let interactionChoice = puppetActions[i1].GetInteractionChoice();
                  let i2 = 0;
                  if i2 < ArraySize(interactionChoice.captionParts.parts) {
                    if IsDefined(
                      interactionChoice.captionParts.parts[i2] as InteractionChoiceCaptionStringPart
                    ) {
                      newCommand.m_title = GetLocalizedText(
                        (interactionChoice.captionParts.parts[i2] as InteractionChoiceCaptionStringPart).content
                      );
                    } else {
                      i2 += 1;
                    }
                  } else if puppetActions[i1].IsInactive() {
                  }
                  if !puppetActions[i1].CanPayCost(null, true) {
                    newCommand.m_actionState = EActionInactivityReson.OutOfMemory;
                    puppetActions[i1].SetInactiveWithReason(false, "LocKey#27398");
                  } else if actionRecord.GetTargetActivePrereqsCount() > 0 {
                    ArrayClear(targetActivePrereqs);
                    actionRecord.TargetActivePrereqs(targetActivePrereqs);
                    i2 = 0;
                    if i2 < ArraySize(targetActivePrereqs) {
                      ArrayClear(prereqsToCheck);
                      targetActivePrereqs[i2].FailureConditionPrereq(prereqsToCheck);
                      if !RPGManager.CheckPrereqs(prereqsToCheck, this) {
                        let failureExplanation = targetActivePrereqs[i2].FailureExplanation();
                        if !this.IsActionQueueEnabled() || this.IsActionQueueFull() {
                          puppetActions[i1].SetInactiveWithReason(false, failureExplanation);
                        } else if this.IsActionQueueEnabled() {
                          if QuickHackableQueueHelper
                            .SetInactivityReasonForAction(
                              puppetActions[i1],
                              actionRecord.ActionName(),
                              this.m_currentlyUploadingAction,
                              failureExplanation
                            ) {
                          } else {
                            i2 += 1;
                          }
                        } else if isOngoingUpload && !this.IsActionQueueEnabled() || this.IsActionQueueFull() {
                          puppetActions[i1].SetInactiveWithReason(false, "LocKey#7020");
                        }
                      } else {
                        i1 += 1;
                      }
                    } else if !actionMatchDeck {
                      newCommand.m_isLocked = true;
                      newCommand.m_inactiveReason = "LocKey#10943";
                    } else if puppetActions[i1].IsInactive() {
                      newCommand.m_isLocked = true;
                      newCommand.m_inactiveReason = puppetActions[i1].GetInactiveReason();
                    } else {
                      newCommand.m_actionState = EActionInactivityReson.Ready;
                      newCommand.m_action = puppetActions[i1];
                      newCommand.m_actionMatchesTarget = actionMatchDeck;
                      ArrayPush(commands, newCommand);
                      i += 1;
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
    i = 0;
  }

  private const final func GetIgnoredDurationStats() -> [wref<StatusEffect_Record>] {
    let result: [wref<StatusEffect_Record>];
    ArrayPush(
      result,
      TweakDBInterface.GetStatusEffectRecord(t"BaseStatusEffect.WasQuickHacked")
    );
    ArrayPush(
      result,
      TweakDBInterface.GetStatusEffectRecord(t"BaseStatusEffect.QuickHackUploaded")
    );
    return result;
  }

  private const final func GetICELevel() -> Float {
    let statsSystem = GameInstance.GetStatsSystem(this.GetGame());
    let playerLevel = statsSystem
      .GetStatValue(
        Cast<StatsObjectID>(GetPlayer(this.GetGame()).GetEntityID()),
        gamedataStatType.Level
      );
    let targetLevel = statsSystem
      .GetStatValue(Cast<StatsObjectID>(this.GetEntityID()), gamedataStatType.Level);
    let resistance = statsSystem
      .GetStatValue(Cast<StatsObjectID>(this.GetEntityID()), gamedataStatType.HackingResistance);
    return resistance + 0.5 * (targetLevel - playerLevel);
  }

