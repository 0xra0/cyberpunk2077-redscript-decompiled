  public final func QuestResolveSkillchecks() {
    if this.m_skillCheckContainer.GetDemolitionSlot().IsActive() {
      this.m_skillCheckContainer.GetDemolitionSlot().SetIsActive(false);
      this.m_skillCheckContainer.GetDemolitionSlot().SetIsPassed(true);
    } else if this.m_skillCheckContainer.GetEngineeringSlot().IsActive() {
      this.m_skillCheckContainer.GetEngineeringSlot().SetIsActive(false);
      this.m_skillCheckContainer.GetEngineeringSlot().SetIsPassed(true);
    } else if this.m_skillCheckContainer.GetHackingSlot().IsActive() {
      this.m_skillCheckContainer.GetHackingSlot().SetIsActive(false);
      this.m_skillCheckContainer.GetHackingSlot().SetIsPassed(true);
    }
    this.NotifyParents();
  }

  protected final func OnQuestResolveSkillchecks(evt: ResolveAllSkillchecksEvent) -> EntityNotificationType {
    this.QuestResolveSkillchecks();
    return EntityNotificationType.SendThisEventToEntity;
  }

  protected final func OnQuestSetSkillchecks(evt: SetSkillcheckEvent) -> EntityNotificationType {
    this.QuestSetSkillchecks(evt.skillcheckContainer);
    return EntityNotificationType.SendThisEventToEntity;
  }

  public final func QuestSetSkillchecks(container: BaseSkillCheckContainer) {
    this.ErasePassedSkillchecks();
    this.InitializeSkillChecks(container, true);
    this.NotifyParents();
  }

  protected final func ErasePassedSkillchecks() {
    if this.m_skillCheckContainer.GetDemolitionSlot().IsPassed() {
      this.m_skillCheckContainer.GetDemolitionSlot().SetIsPassed(false);
    } else if this.m_skillCheckContainer.GetEngineeringSlot().IsPassed() {
      this.m_skillCheckContainer.GetEngineeringSlot().SetIsPassed(false);
    } else if this.m_skillCheckContainer.GetHackingSlot().IsPassed() {
      this.m_skillCheckContainer.GetHackingSlot().SetIsPassed(false);
    }
  }

