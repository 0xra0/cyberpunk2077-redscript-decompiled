}

struct DeviceHelper {
  public final static func IDMO(gameInstance: GameInstance) -> Bool {
    return DeviceHelper.IsDebugModeON(gameInstance);
  }

  public final static func IsDebugModeON(gameInstance: GameInstance) -> Bool {
    let val = GameInstance.GetQuestsSystem(gameInstance).GetFact(n"dbgDevices");
    if val > 0 {
      return true;
    }
    return false;
  }

  public final static func DebugLog(gameInstance: GameInstance, const message: script_ref<String>) {
    if DeviceHelper.IsDebugModeON(gameInstance) {
      GameInstance.GetActivityLogSystem(gameInstance).AddLog(message);
    }
  }

  public final static func ExtractSpecificStateClass(
    const states: script_ref<[PersistentState]>,
    desiredClassName: CName,
    extractedStates: [PersistentState]
  ) -> Bool {
    let wasSuccessful: Bool;
    let i = 0;
    while i < ArraySize(states) {
      if Equals(states[i].GetClassName(), desiredClassName) {
        ArrayPush(extractedStates, states[i]);
        wasSuccessful = true;
      }
      i += 1;
    }
    return wasSuccessful;
  }

  public final static func ConvertActionsArray(const puppetActions: script_ref<[PuppetAction]>) -> [DeviceAction] {
    let deviceActions: [DeviceAction];
    let i = 0;
    while i < ArraySize(puppetActions) {
      ArrayPush(deviceActions, puppetActions[i]);
      i += 1;
    }
    return deviceActions;
  }

  public final static func ConvertActionIntoScriptableAction(
    const inActions: script_ref<[DeviceAction]>,
    outActions: script_ref<[ScriptableDeviceAction]>
  ) -> Bool {
    let i = 0;
    while i < ArraySize(inActions) {
      ArrayPush(outActions, inActions[i] as ScriptableDeviceAction);
      i += 1;
    }
    if ArraySize(inActions) == ArraySize(outActions) {
      return true;
    }
    return false;
  }

  public final static func PushActionsIntoInteractionChoice(choice: script_ref<InteractionChoice>, const actions: script_ref<[DeviceAction]>) {
    let i = 0;
    while i < ArraySize(actions) {
      ArrayPush(choice.data, ToVariant(actions[i]));
      i += 1;
    }
  }

  public final static func FindAction(
    actionName: CName,
    const actions: script_ref<[DeviceAction]>,
    out foundAction: DeviceAction
  ) -> Int32 {
    let i = 0;
    while i < ArraySize(actions) {
      if Equals(actions[i].actionName, actionName) {
        foundAction = actions[i];
        return i;
      }
      i += 1;
    }
    return -1;
  }

  public final static func RemoveActionFromArray(actionName: CName, actions: script_ref<[DeviceAction]>) {
    let dummyAction: DeviceAction;
    let index = DeviceHelper.FindAction(actionName, actions, dummyAction);
    if index < 0 {
      return;
    }
    ArrayErase(actions, index);
  }

  public final static func FindStatusAction(const actions: script_ref<[DeviceAction]>, out status: BaseDeviceStatus) -> Int32 {
    let i = 0;
    while i < ArraySize(actions) {
      if IsDefined(actions[i] as BaseDeviceStatus) {
        status = actions[i] as BaseDeviceStatus;
        return i;
      }
      i += 1;
    }
    return -1;
  }

  public final static func RemoveStatusAction(actions: script_ref<[DeviceAction]>) -> Bool {
    let i = 0;
    while i < ArraySize(actions) {
      if IsDefined(actions[i] as BaseDeviceStatus) {
        ArrayErase(actions, i);
        return true;
      }
      i += 1;
    }
    return false;
  }
}

abstract class ActionInt extends ScriptableDeviceAction {
  public func GetProperties() -> [DeviceActionProperty] {
    let arr: [DeviceActionProperty];
    ArrayPush(arr, this.prop);
    return arr;
  }

  public const func GetCurrentDisplayString() -> String {
    let str = NameToString(this.prop.name) + " " + IntToString(FromVariant<Int32>(this.prop.first));
    return str;
  }
}

abstract class ActionEnum extends ActionInt {
}

class BaseDeviceStatus extends ActionEnum {
  public let m_isRestarting: Bool;

  public func SetProperties(const deviceRef: ScriptableDeviceComponentPS) {
    this.m_isRestarting = deviceRef.IsRestarting();
    this.prop = DeviceActionPropertyFunctions.SetUpProperty_Int(n"STATUS", EnumInt(deviceRef.GetDeviceState()));
  }

  public const func GetCurrentDisplayString() -> String {
    let str: String;
    let baseStateValue = 0;
    if IsDefined(this.prop.first) {
      baseStateValue = FromVariant<Int32>(this.prop.first);
    } else if this.m_isRestarting {
      return "LocKey#17797";
    }
    switch baseStateValue {
      case -2:
        str = "LocKey#17796";
        break;
      case -1:
        str = "LocKey#17793";
        break;
      case 0:
        str = "LocKey#17794";
        break;
      case 1:
        str = "LocKey#17795";
        break;
      default:
        str = "Unknown Status - DEBUG";
        return str;
    }
  }

  public const final func GetScannerStatusRecord() -> TweakDBID {
    let ending: String;
    let recordbase = "scanning_devices.";
    let baseStateValue = FromVariant<Int32>(this.prop.first);
    if this.m_isRestarting {
      ending = "booting";
    } else {
      switch baseStateValue {
        case -2:
          ending = "disabled";
        case -1:
          ending = "unpowered";
        case 0:
          ending = "off";
        case 1:
          ending = "on";
        default:
          let recordID = TDBID.Create(recordbase + ending);
      }
    }
    return recordID;
  }

  public const func GetStatusValue() -> Int32 {
    return FromVariant<Int32>(this.prop.first);
  }

  public final static func IsDefaultConditionMet(device: ScriptableDeviceComponentPS, const context: script_ref<GetActionsContext>) -> Bool {
    if BaseDeviceStatus.IsAvailable(device) && BaseDeviceStatus.IsClearanceValid(context.clearance) {
      return true;
    }
    return false;
  }

  public final static func IsAvailable(device: ScriptableDeviceComponentPS) -> Bool {
    if device.IsDisabled() {
      return false;
    }
    return true;
  }

  public final static func IsClearanceValid(requesterClearancer: Clearance) -> Bool {
    if Clearance.IsInRange(requesterClearancer, 1) {
      return true;
    }
    return false;
  }

  public final static func IsContextValid(const context: script_ref<GetActionsContext>) -> Bool {
    if Equals(context.requestType, gamedeviceRequestType.External) {
      return true;
    }
    return false;
  }

  public func GetTweakDBChoiceRecord() -> String {
    return "wrong_action";
  }
}

