  public const final func ShouldSpawnBloodPuddle() -> Bool {
    return this.m_shouldSpawnBloodPuddle;
  }

  protected cb func OnBloodPuddleEvent(evt: BloodPuddleEvent) -> Bool {
    let slotTransform: WorldTransform;
    let downVector: Vector4;
    if !this.m_bloodPuddleSpawned {
      downVector.X = 0.0;
      downVector.Y = 0.0;
      downVector.Z = -1.0;
      let dismemberedLimbCount = this.m_dismembermentComponent.GetDismemberedLimbCount();
      if dismemberedLimbCount.cyberDismemberments != 0u || dismemberedLimbCount.fleshDismemberments != 0u {
        evt.cyberBlood = dismemberedLimbCount.cyberDismemberments > dismemberedLimbCount.fleshDismemberments;
      }
      let slotExists = this.m_slotComponent.GetSlotTransform(evt.m_slotName, slotTransform);
      if slotExists {
        let position = WorldPosition.ToVector4(WorldTransform.GetWorldPosition(slotTransform));
      } else {
        position = this.GetWorldPosition();
      }
      if evt.cyberBlood {
        let effect = GameInstance
          .GetGameEffectSystem(this.GetGame())
          .CreateEffectStatic(n"npcBloodPuddle", n"cyber", this);
      } else {
        effect = GameInstance
          .GetGameEffectSystem(this.GetGame())
          .CreateEffectStatic(n"npcBloodPuddle", n"blood", this);
      }
      if !IsDefined(effect) {
        return false;
      }
      EffectData
        .SetVector(
          effect.GetSharedData(),
          GetAllBlackboardDefs().EffectSharedData.position,
          position
        );
      EffectData
        .SetVector(
          effect.GetSharedData(),
          GetAllBlackboardDefs().EffectSharedData.forward,
          downVector
        );
      EffectData
        .SetFloat(effect.GetSharedData(), GetAllBlackboardDefs().EffectSharedData.range, 1.5);
      effect.Run();
      this.m_bloodPuddleSpawned = true;
    }
  }

