class InventoryCyberwareDisplayController extends InventoryItemDisplayController {
  protected let m_ownedFrame: inkWidgetRef;
  protected let m_selectedFrame: inkWidgetRef;
  protected let m_amountPanel: inkWidgetRef;
  protected let m_amount: inkTextRef;

  public func Unselect() {
    inkWidgetRef.SetVisible(this.m_selectedFrame, false);
  }

  public func Select() {
    inkWidgetRef.SetVisible(this.m_selectedFrame, true);
  }

  public final func SetAmountOfNewItem(amount: Int32) {
    if amount <= 0 {
      inkWidgetRef.SetVisible(this.m_amountPanel, false);
    } else {
      inkWidgetRef.SetVisible(this.m_amountPanel, true);
      inkTextRef.SetText(this.m_amount, IntToString(amount));
    }
  }
}

abstract class AISubActionQueueAIEvent_Record_Implementation extends IScriptable {
  public final static func Activate(context: ScriptExecutionContext, record: wref<AISubActionQueueAIEvent_Record>) {
    if record.Delay() == 0.0 {
      AISubActionQueueAIEvent_Record_Implementation.QueueAIEvent(context, record);
    }
  }

  public final static func Update(
    context: ScriptExecutionContext,
    record: wref<AISubActionQueueAIEvent_Record>,
    const duration: Float
  ) -> AIbehaviorUpdateOutcome {
    if record.Delay() <= 0.0 {
      return AIbehaviorUpdateOutcome.SUCCESS;
    } else if record.Delay() > 0.0 && duration >= record.Delay() {
      AISubActionQueueAIEvent_Record_Implementation.QueueAIEvent(context, record);
      return AIbehaviorUpdateOutcome.SUCCESS;
    }
    return AIbehaviorUpdateOutcome.IN_PROGRESS;
  }

  public final static func Deactivate(
    context: ScriptExecutionContext,
    record: wref<AISubActionQueueAIEvent_Record>,
    const duration: Float,
    interrupted: Bool
  ) {
    if record.Delay() < 0.0 {
      AISubActionQueueAIEvent_Record_Implementation.QueueAIEvent(context, record);
    }
  }

  public final static func QueueAIEvent(context: ScriptExecutionContext, record: wref<AISubActionQueueAIEvent_Record>) {
    if !IsNameValid(record.Name()) {
      return;
    }
    let aiEvent = new AIEvent();
    aiEvent.name = record.Name();
    ScriptExecutionContext.GetOwner(context).QueueEvent(aiEvent);
  }
}

importonly native class AISubActionQueueAIEvent_Record extends AISubAction_Record {
  public final native func Name() -> CName;

  public final native func Delay() -> Float;
}

class NetRunnerChargesGameController extends inkGameController {
  public let m_header: inkTextRef;
  public let m_list: inkCompoundRef;
  public let m_bar: inkWidgetRef;
  public let m_value: inkTextRef;
  private let m_blackboard: wref<IBlackboard>;
  private let m_bbDefinition: UI_PlayerBioMonitorDef;
  private let m_netrunnerCapacityId: Uint32;
  private let m_netrunnerCurrentId: CallbackHandle;
  private let m_currentCharges: Int32;
  private let m_maxCharges: Int32;
  private let m_chargesList: [wref<NetRunnerListItem>];
  private let m_root: wref<inkWidget>;

  protected cb func OnInitialize() -> Bool {
    this.m_root = this.GetRootWidget();
    inkCompoundRef.RemoveAllChildren(this.m_list);
    this.SetupBB();
  }

  protected cb func OnUnitialize() -> Bool {
    this.RemoveBB();
  }

  private final func SetupBB() {
    this.m_bbDefinition = GetAllBlackboardDefs().UI_PlayerBioMonitor;
    this.m_blackboard = this.GetBlackboardSystem().Get(this.m_bbDefinition);
    if IsDefined(this.m_blackboard) {
      this.m_netrunnerCurrentId = this
        .m_blackboard
        .RegisterDelayedListenerFloat(this.m_bbDefinition.MemoryPercent, this, n"OnNetrunnerChargesUpdated");
      this
        .OnNetrunnerChargesUpdated(this.m_blackboard.GetFloat(this.m_bbDefinition.MemoryPercent));
    }
  }

  private final func RemoveBB() {
    if IsDefined(this.m_blackboard) {
      this
        .m_blackboard
        .UnregisterDelayedListener(this.m_bbDefinition.MemoryPercent, this.m_netrunnerCurrentId);
    }
    this.m_blackboard = null;
  }

  protected cb func OnNetrunnerChargesUpdated(value: Float) -> Bool {
    let normalizedValue = Cast<Int32>(value);
    let scaledValue = value / 100.0;
    inkTextRef.SetText(this.m_value, ToString(normalizedValue) + "%");
    inkWidgetRef.SetScale(this.m_bar, new Vector2(scaledValue, 1.0));
    if value >= 100.0 {
      this.Hide();
    } else {
      this.Show();
    }
  }

  public final func Show() {
    this.m_root.SetVisible(true);
  }

  public final func Hide() {
    this.m_root.SetVisible(false);
  }
}

class NetRunnerListItem extends inkLogicController {
  public let m_highlight: inkWidgetRef;

  protected cb func OnInitialize() -> Bool;

  public final func ShowHighlight() {
    inkWidgetRef.SetVisible(this.m_highlight, true);
  }

  public final func HideHighlight() {
    inkWidgetRef.SetVisible(this.m_highlight, false);
  }
}

abstract class AISubActionQueueCommunicationEvent_Record_Implementation extends IScriptable {
  public final static func Activate(
    context: ScriptExecutionContext,
    record: wref<AISubActionQueueCommunicationEvent_Record>
  ) {
    if record.Delay() == 0.0 {
      AISubActionQueueCommunicationEvent_Record_Implementation.QueueCommunicationEvent(context, record);
    }
  }

  public final static func Update(
    context: ScriptExecutionContext,
    record: wref<AISubActionQueueCommunicationEvent_Record>,
    const duration: Float
  ) -> AIbehaviorUpdateOutcome {
    if record.Delay() <= 0.0 {
      return AIbehaviorUpdateOutcome.SUCCESS;
    } else if record.Delay() > 0.0 && duration >= record.Delay() {
      AISubActionQueueCommunicationEvent_Record_Implementation.QueueCommunicationEvent(context, record);
      return AIbehaviorUpdateOutcome.SUCCESS;
    }
    return AIbehaviorUpdateOutcome.IN_PROGRESS;
  }

  public final static func Deactivate(
    context: ScriptExecutionContext,
    record: wref<AISubActionQueueCommunicationEvent_Record>,
    const duration: Float,
    interrupted: Bool
  ) {
    if record.Delay() < 0.0 {
      AISubActionQueueCommunicationEvent_Record_Implementation.QueueCommunicationEvent(context, record);
    }
  }

  public final static func QueueCommunicationEvent(
    context: ScriptExecutionContext,
    record: wref<AISubActionQueueCommunicationEvent_Record>
  ) {
    let listener: wref<GameObject>;
    if !IsNameValid(record.Name()) {
      return;
    } else if !AIActionTarget.GetObject(context, record.TargetListener(), listener) {
      return;
    }
    let communicationEvent = new CommunicationEvent();
    communicationEvent.name = record.Name();
    communicationEvent.sender = ScriptExecutionContext.GetOwner(context).GetEntityID();
    listener.QueueEvent(communicationEvent);
    ScriptExecutionContext.GetOwner(context).QueueEvent(communicationEvent);
  }
}

importonly native class AISubActionQueueCommunicationEvent_Record extends AISubAction_Record {
  public final native func TargetListener() -> wref<AIActionTarget_Record>;

  public final native func TargetListenerHandle() -> AIActionTarget_Record;

  public final native func Name() -> CName;

  public final native func Delay() -> Float;
}

