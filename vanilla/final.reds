  protected cb func OnItemAddedToSlot(evt: ItemAddedToSlot) -> Bool {
    let packages: [wref<GameplayLogicPackage_Record>];
    let itemRecord = TweakDBInterface.GetItemRecord(ItemID.GetTDBID(evt.GetItemID()));
    itemRecord.OnAttach(packages);
    let i = 0;
    while i < ArraySize(packages) {
      RPGManager.ApplyGLP(this, packages[i]);
      i += 1;
    }
    if !this.IsPlayer() && evt.ShouldCache() {
      let cacheItemPSEvt = new CacheItemEquippedToHandsEvent();
      cacheItemPSEvt.m_itemID = evt.GetItemID();
      cacheItemPSEvt.m_slot = evt.GetSlotID();
      this.SendEventToDefaultPS(cacheItemPSEvt);
    }
  }

  protected cb func OnItemRemovedFromSlot(evt: ItemRemovedFromSlot) -> Bool {
    let packages: [wref<GameplayLogicPackage_Record>];
    let itemRecord = TweakDBInterface.GetItemRecord(ItemID.GetTDBID(evt.GetItemID()));
    itemRecord.OnAttach(packages);
    let i = 0;
    while i < ArraySize(packages) {
      RPGManager.RemoveGLP(this, packages[i]);
      i += 1;
    }
    if !this.IsPlayer() {
      let cacheItemPSEvt = new CacheItemEquippedToHandsEvent();
      cacheItemPSEvt.m_itemID = new ItemID();
      cacheItemPSEvt.m_slot = evt.GetSlotID();
      this.SendEventToDefaultPS(cacheItemPSEvt);
    }
  }

