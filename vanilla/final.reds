  private final func UnlockNewPerk(owner: GameObject, perkType: gamedataNewPerkType) -> Bool {
    let developmentData = this.GetDevelopmentData(owner);
    let success = developmentData.UnlockNewPerk(perkType);
    if success {
      let newPerkUnlockedEvent = new NewPerkUnlockedEvent();
      newPerkUnlockedEvent.perkType = perkType;
      GameInstance.GetUISystem(this.GetGameInstance()).QueueEvent(newPerkUnlockedEvent);
    }
    return success;
  }

