class AIMoveOnSplineCommandHandler extends AICommandHandlerBase {
  protected let m_outSpline: AIArgumentMapping;
  protected let m_outMovementType: AIArgumentMapping;
  protected let m_outRotateTowardsFacingTarget: AIArgumentMapping;
  protected let m_outFacingTarget: AIArgumentMapping;
  protected let m_outSnapToTerrain: AIArgumentMapping;
  protected let m_allowCrowdOnPath: AIArgumentMapping;

  protected func UpdateCommand(context: ScriptExecutionContext, command: AICommand) -> AIbehaviorUpdateOutcome {
    let typedCommand = command as AIMoveOnSplineCommand;
    if !IsDefined(typedCommand) {
      return AIbehaviorUpdateOutcome.FAILURE;
    } else if Equals(AIBehaviorScriptBase.GetPuppet(context).GetNPCType(), gamedataNPCType.Drone) {
      DroneComponent
        .SetLocomotionWrappers(
          AIBehaviorScriptBase.GetPuppet(context),
          EnumValueToName(n"moveMovementType", EnumInt(typedCommand.movementType.movementType))
        );
      typedCommand.movementType.movementType = moveMovementType.Walk;
    } else if Equals(typedCommand.movementType.movementType, moveMovementType.Run) {
      let currentHighLevelState = IntEnum<gamedataNPCHighLevelState>(
        (ScriptExecutionContext.GetOwner(context) as ScriptedPuppet)
          .GetPuppetStateBlackboard()
          .GetInt(GetAllBlackboardDefs().PuppetState.HighLevel)
      );
      if Equals(currentHighLevelState, gamedataNPCHighLevelState.Combat) {
        typedCommand.movementType.movementType = moveMovementType.Sprint;
      }
      typedCommand.movementType.movementType = moveMovementType.Walk;
    } else if typedCommand.alwaysUseStealth {
      NPCPuppet
        .ChangeHighLevelState(
          ScriptExecutionContext.GetOwner(context),
          gamedataNPCHighLevelState.Stealth
        );
    }
    ScriptExecutionContext.SetMappingValue(context, this.m_outSpline, ToVariant(typedCommand.spline));
    ScriptExecutionContext
      .SetMappingValue(context, this.m_outMovementType, ToVariant(typedCommand.movementType));
    ScriptExecutionContext
      .SetMappingValue(
        context,
        this.m_outRotateTowardsFacingTarget,
        ToVariant(typedCommand.rotateEntityTowardsFacingTarget)
      );
    ScriptExecutionContext.SetMappingValue(context, this.m_outFacingTarget, ToVariant(null));
    ScriptExecutionContext
      .SetMappingValue(context, this.m_outSnapToTerrain, ToVariant(typedCommand.snapToTerrain));
    ScriptExecutionContext
      .SetMappingValue(context, this.m_allowCrowdOnPath, ToVariant(typedCommand.allowCrowdOnPath));
    return AIbehaviorUpdateOutcome.SUCCESS;
  }
}

