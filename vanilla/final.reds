abstract class AISubActionStatusEffect_Record_Implementation extends IScriptable {
  private final static func IsConditionFulfilled(context: ScriptExecutionContext, record: wref<AISubActionStatusEffect_Record>) -> Bool {
    return !IsDefined(record.Condition()) || AICondition.CheckActionCondition(context, record.Condition());
  }

  public final static func Activate(context: ScriptExecutionContext, record: wref<AISubActionStatusEffect_Record>) {
    if record.Delay()
      == 0.0
      && AISubActionStatusEffect_Record_Implementation.IsConditionFulfilled(context, record) {
      AISubActionStatusEffect_Record_Implementation.ApplyRemoveStatusEffect(context, record);
    }
  }

  public final static func Update(
    context: ScriptExecutionContext,
    record: wref<AISubActionStatusEffect_Record>,
    const duration: Float
  ) -> AIbehaviorUpdateOutcome {
    if !AISubActionStatusEffect_Record_Implementation.IsConditionFulfilled(context, record) {
      return AIbehaviorUpdateOutcome.SUCCESS;
    } else if record.Delay() <= 0.0 {
      return AIbehaviorUpdateOutcome.SUCCESS;
    } else if record.Delay() > 0.0 && duration >= record.Delay() {
      AISubActionStatusEffect_Record_Implementation.ApplyRemoveStatusEffect(context, record);
      return AIbehaviorUpdateOutcome.SUCCESS;
    }
    return AIbehaviorUpdateOutcome.IN_PROGRESS;
  }

  public final static func Deactivate(
    context: ScriptExecutionContext,
    record: wref<AISubActionStatusEffect_Record>,
    const duration: Float,
    interrupted: Bool
  ) {
    if !AISubActionStatusEffect_Record_Implementation.IsConditionFulfilled(context, record) {
      return;
    } else if record.Delay() < 0.0 {
      AISubActionStatusEffect_Record_Implementation.ApplyRemoveStatusEffect(context, record);
    } else if record.Remove() {
      AISubActionStatusEffect_Record_Implementation.RemoveStatusEffect(context, record);
    }
  }

  public final static func ApplyRemoveStatusEffect(context: ScriptExecutionContext, record: wref<AISubActionStatusEffect_Record>) {
    if record.Apply() {
      AISubActionStatusEffect_Record_Implementation.ApplyStatusEffect(context, record);
    } else if record.Remove() {
      AISubActionStatusEffect_Record_Implementation.RemoveStatusEffect(context, record);
    }
  }

  public final static func ApplyStatusEffect(context: ScriptExecutionContext, record: wref<AISubActionStatusEffect_Record>) {
    let target: wref<GameObject>;
    if !AIActionTarget.GetObject(context, record.Target(), target) {
      return;
    }
    let count = record.GetStatusEffectsCount();
    let i = 0;
    while i < count {
      GameInstance
        .GetStatusEffectSystem(ScriptExecutionContext.GetOwner(context).GetGame())
        .ApplyStatusEffect(target.GetEntityID(), record.GetStatusEffectsItem(i).GetID());
      i += 1;
    }
  }

  public final static func RemoveStatusEffect(context: ScriptExecutionContext, record: wref<AISubActionStatusEffect_Record>) {
    let target: wref<GameObject>;
    if !AIActionTarget.GetObject(context, record.Target(), target) {
      return;
    }
    let count = record.GetStatusEffectsCount();
    let i = 0;
    while i < count {
      GameInstance
        .GetStatusEffectSystem(ScriptExecutionContext.GetOwner(context).GetGame())
        .RemoveStatusEffect(target.GetEntityID(), record.GetStatusEffectsItem(i).GetID());
      i += 1;
    }
  }
}

importonly native class AISubActionStatusEffect_Record extends AISubAction_Record {
  public final native func Condition() -> wref<AIActionCondition_Record>;

  public final native func ConditionHandle() -> AIActionCondition_Record;

  public final native func Target() -> wref<AIActionTarget_Record>;

  public final native func TargetHandle() -> AIActionTarget_Record;

  public final native func StatusEffects(out outList: [wref<StatusEffect_Record>]);

  public final native func GetStatusEffectsCount() -> Int32;

  public final native func GetStatusEffectsItem(index: Int32) -> wref<StatusEffect_Record>;

  public final native func GetStatusEffectsItemHandle(index: Int32) -> StatusEffect_Record;

  public final native func StatusEffectsContains(item: wref<StatusEffect_Record>) -> Bool;

  public final native func Delay() -> Float;

  public final native func Apply() -> Bool;

  public final native func Remove() -> Bool;
}

class MinimapPOIMappinController extends BaseMinimapMappinController {
  protected let m_pulseWidget: inkWidgetRef;
  protected let m_pingAnimationOnStateChange: Bool;
  private let m_poiMappin: wref<PointOfInterestMappin>;
  private let m_questMappin: wref<QuestMappin>;
  private let m_isCompletedPhase: Bool;
  private let m_mappinPhase: gamedataMappinPhase;
  private let m_pingAnim: inkAnimProxy;
  private let m_mappinVariant: gamedataMappinVariant;
  private const let c_pingAnimCount: Uint32;
  private let m_isNcpdScanner: Bool;
  private let m_vehicleMinimapMappinComponent: VehicleMinimapMappinComponent;
  private let m_keepIconOnClamping: Bool;

  protected func Initialize() {
    super.Initialize();
    inkWidgetRef.SetVisible(this.m_pulseWidget, false);
  }

  protected func Intro() {
    let vehicleMappin = this.GetMappin() as VehicleMappin;
    if IsDefined(vehicleMappin) {
      this.m_keepIconOnClamping = true;
      this.m_vehicleMinimapMappinComponent = new VehicleMinimapMappinComponent();
      this.m_vehicleMinimapMappinComponent.OnInitialize(this, vehicleMappin);
    }
    this.m_poiMappin = this.GetMappin() as PointOfInterestMappin;
    this.m_questMappin = this.GetMappin() as QuestMappin;
    super.Intro();
    this.UpdateIcon();
  }

  protected cb func OnUninitialize() -> Bool {
    if IsDefined(this.m_vehicleMinimapMappinComponent) {
      this.m_vehicleMinimapMappinComponent.OnUninitialize();
    }
  }

  protected func Update() {
    let newMappinPhase: gamedataMappinPhase;
    let phaseChanged: Bool;
    if IsDefined(this.m_mappin) {
      newMappinPhase = this.m_mappin.GetPhase();
      phaseChanged = NotEquals(this.m_mappinPhase, newMappinPhase);
    } else if phaseChanged {
      this.m_mappinPhase = newMappinPhase;
    }
    this.m_isCompletedPhase = Equals(this.m_mappinPhase, gamedataMappinPhase.CompletedPhase);
    this.UpdateIcon();
    this.UpdateVisibility();
    super.Update();
    if !this.m_isNcpdScanner
      && phaseChanged
      && Equals(this.m_mappinPhase, gamedataMappinPhase.DiscoveredPhase)
      && this.m_pingAnimationOnStateChange {
      this.PlayPingAnimation();
    }
  }

  public final func PlayPingAnimation(opt loopInfinite: Bool, opt overrideAnimName: CName) -> Bool {
    let animOptions: inkAnimOptions;
    this.StopPingAnimation();
    animOptions.loopType = inkanimLoopType.Cycle;
    animOptions.loopInfinite = loopInfinite;
    animOptions.loopCounter = this.c_pingAnimCount;
    this.m_pingAnim = this
      .PlayLibraryAnimation(IsNameValid(overrideAnimName) ? overrideAnimName : n"Pulse", animOptions);
    this
      .m_pingAnim
      .RegisterToCallback(inkanimEventType.OnFinish, this, n"OnPulseAnimLoop");
    inkWidgetRef.SetVisible(this.m_pulseWidget, true);
    return this.m_pingAnim.IsValid();
  }

  public final func StopPingAnimation(opt goToEnd: Bool) {
    if IsDefined(this.m_pingAnim) {
      this
        .m_pingAnim
        .UnregisterFromCallback(inkanimEventType.OnFinish, this, n"OnPulseAnimLoop");
      if goToEnd {
        this.m_pingAnim.GotoEndAndStop();
      } else {
        this.m_pingAnim.Stop();
      }
      this.m_pingAnim = null;
    }
  }

  public final func RequestUpdateRootState() {
    this.UpdateRootState();
  }

  protected cb func OnQuestMappinHighlight(evt: QuestMappinHighlightEvent) -> Bool {
    let poiMappin = this.m_mappin as PointOfInterestMappin;
    if IsDefined(poiMappin) && poiMappin.GetJournalQuestPathHash() == evt.m_hash {
      this.PlayPingAnimation();
    }
  }

  protected cb func OnPulseAnimLoop(anim: inkAnimProxy) -> Bool {
    inkWidgetRef.SetVisible(this.m_pulseWidget, false);
    if IsDefined(this.m_vehicleMinimapMappinComponent) {
      this.m_vehicleMinimapMappinComponent.OnAnimEnd();
    }
  }

  protected final func UpdateVisibility() {
    let isInArea: Bool;
    let shouldHide: Bool;
    if this.m_isNcpdScanner {
      shouldHide = !this.IsTracked();
      this.SetForceHide(shouldHide);
      inkWidgetRef.SetVisible(this.m_pulseWidget, false);
      return;
    } else if this.m_questMappin != null {
      isInArea = this.m_questMappin.IsInsideTrigger();
      shouldHide = !this.IsTracked() || isInArea;
      this.SetForceHide(shouldHide);
      return;
    } else if this.m_poiMappin != null {
      isInArea = this.m_poiMappin.IsInsideSecurityAreaTrigger();
      if !this.IsPlayerTracked() {
        shouldHide = isInArea || this.m_poiMappin.IsQuestPath();
      }
      shouldHide = shouldHide || this.m_isCompletedPhase;
      this.SetForceHide(shouldHide);
    }
  }

  protected final func UpdateIcon() {
    let iconID: TweakDBID;
    let roleMappinData: GameplayRoleMappinData;
    if IsDefined(this.m_mappin) {
      roleMappinData = this.m_mappin.GetScriptData() as GameplayRoleMappinData;
      this.m_mappinVariant = this.m_mappin.GetVariant();
      this.m_isNcpdScanner = this.IsNcpdScanner(this.m_mappinVariant);
    } else if IsDefined(roleMappinData) {
      iconID = roleMappinData.m_textureID;
    } else if !TDBID.IsValid(iconID) {
      let texturePart = MappinUIUtils.MappinToTexturePart(this.m_mappinVariant, this.m_mappinPhase);
      inkImageRef.SetTexturePart(this.iconWidget, texturePart);
    }
    this.SetTexture(this.iconWidget, iconID);
    inkWidgetRef
      .SetOpacity(
        this.iconWidget,
        this.m_isCompletedPhase ? MappinUtils.GetGlobalProfile().CompletedPOIOpacity() : 1.0
      );
  }

  protected func ComputeRootState() -> CName {
    let stateName: CName;
    if this.m_isCompletedPhase {
      stateName = n"QuestComplete";
    } else if this.m_mappin != null {
      let variant = this.m_mappin.GetVariant();
      if Equals(variant, gamedataMappinVariant.Zzz17_NCARTVariant) {
        stateName = n"FastTravelMetro";
      } else if Equals(variant, gamedataMappinVariant.Zzz16_RelicDeviceBasicVariant) {
        stateName = n"Relic";
      } else {
        let mappinsGroup = MappinUtils.GetMappinsGroup(this.m_mappin.GetVariant());
        if IsDefined(mappinsGroup) {
          stateName = mappinsGroup.WidgetState();
        }
      }
    }
    if Equals(stateName, n"None") {
      stateName = n"Quest";
    }
    return stateName;
  }

  protected func KeepIconOnClamping() -> Bool {
    return this.m_keepIconOnClamping;
  }

  private final func IsNcpdScanner(variant: gamedataMappinVariant) -> Bool {
    if Equals(variant, gamedataMappinVariant.MinorActivityVariant)
      || Equals(variant, gamedataMappinVariant.Zzz06_NCPDGigVariant)
      || Equals(variant, gamedataMappinVariant.GangWatchVariant)
      || Equals(variant, gamedataMappinVariant.OutpostVariant)
      || Equals(variant, gamedataMappinVariant.HiddenStashVariant) {
      return true;
    }
    return false;
  }
}

class VehicleMinimapMappinComponent extends IScriptable {
  private let m_minimapPOIMappinController: wref<MinimapPOIMappinController>;
  private let m_vehicle: wref<VehicleObject>;
  private let m_uiVehicleBB: wref<IBlackboard>;
  private let m_vehicleBBDef: VehicleDef;
  private let m_deleteAnimCallback: CallbackHandle;
  private let m_destroyMappinOnAnimEnd: Bool;
  private let m_vehicleIsLatestSummoned: Bool;
  private let m_vehicleEntityID: EntityID;
  private let m_vehicleSummonDataDef: VehicleSummonDataDef;
  private let m_vehicleSummonDataBB: wref<IBlackboard>;
  private let m_vehicleSummonStateCallback: CallbackHandle;

  public final func OnInitialize(
    minimapPOIMappinController: wref<MinimapPOIMappinController>,
    vehicleMappin: wref<VehicleMappin>
  ) {
    this.m_minimapPOIMappinController = minimapPOIMappinController;
    this.m_vehicle = vehicleMappin.GetVehicle();
    this.m_uiVehicleBB = this.m_vehicle.GetBlackboard();
    this.m_vehicleBBDef = GetAllBlackboardDefs().Vehicle;
    this.m_deleteAnimCallback = this
      .m_uiVehicleBB
      .RegisterListenerName(this.m_vehicleBBDef.MinimapMappinDeleteAnim, this, n"OnDeleteAnimSet");
    this.m_vehicleEntityID = this.m_vehicle.GetEntityID();
    this.m_vehicleSummonDataDef = GetAllBlackboardDefs().VehicleSummonData;
    this.m_vehicleSummonDataBB = GameInstance
      .GetBlackboardSystem(this.m_vehicle.GetGame())
      .Get(this.m_vehicleSummonDataDef);
    this.m_vehicleSummonStateCallback = this
      .m_vehicleSummonDataBB
      .RegisterListenerUint(
        this.m_vehicleSummonDataDef.SummonState,
        this,
        n"OnVehicleSummonStateChanged"
      );
    this.m_minimapPOIMappinController.OverrideClamp(this.VehicleIsLatestSummoned());
  }

  public final func OnUninitialize() {
    if IsDefined(this.m_deleteAnimCallback) {
      this
        .m_uiVehicleBB
        .UnregisterListenerName(this.m_vehicleBBDef.MinimapMappinDeleteAnim, this.m_deleteAnimCallback);
    } else if IsDefined(this.m_vehicleSummonStateCallback) {
      this
        .m_vehicleSummonDataBB
        .UnregisterListenerUint(
          this.m_vehicleSummonDataDef.SummonState,
          this.m_vehicleSummonStateCallback
        );
    }
  }

  public final func OnAnimEnd() {
    if this.m_destroyMappinOnAnimEnd {
      this.m_vehicle.GetVehicleComponent().DestroyMappin();
    }
  }

  private final func VehicleIsLatestSummoned() -> Bool {
    return this.m_vehicleEntityID
      == this
        .m_vehicleSummonDataBB
        .GetEntityID(this.m_vehicleSummonDataDef.SummonedVehicleEntityID);
  }

  private final func ActivatePingAnimation(activate: Bool) {
    if activate {
      this.m_minimapPOIMappinController.PlayPingAnimation(true, n"Pulse_red_weak");
    } else {
      this.m_minimapPOIMappinController.StopPingAnimation(true);
    }
  }

  protected cb func OnDeleteAnimSet(deleteAnimName: CName) -> Bool {
    let animLaunched = false;
    if IsNameValid(deleteAnimName) {
      this.m_destroyMappinOnAnimEnd = true;
      this.m_minimapPOIMappinController.StopPingAnimation(true);
      animLaunched = this.m_minimapPOIMappinController.PlayPingAnimation(false, deleteAnimName);
    } else if !animLaunched {
      this.m_vehicle.GetVehicleComponent().DestroyMappin();
    }
  }

  protected cb func OnVehicleSummonStateChanged(value: Uint32) -> Bool {
    let isLastSummoned = this.VehicleIsLatestSummoned();
    this.m_minimapPOIMappinController.OverrideClamp(isLastSummoned);
    if isLastSummoned
      && Equals(IntEnum<vehicleSummonState>(value), vehicleSummonState.AlreadySummoned) {
      this.m_minimapPOIMappinController.PlayPingAnimation();
    }
  }
}

