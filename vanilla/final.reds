        let subAction = this.m_actionRecord.GetLoopSubActionsItem(i);
        this.m_phaseSubActionsResults[i] = TweakAISubAction.Update(context, subAction, duration);
      } else if Equals(this.m_phaseSubActionsResults[i], AIbehaviorUpdateOutcome.FAILURE) {
        countFailure += 1;
      } else if Equals(this.m_phaseSubActionsResults[i], AIbehaviorUpdateOutcome.SUCCESS) {
        countSuccess += 1;
      }
      i += 1;
    }
    if countFailure > 0 {
