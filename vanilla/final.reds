    let vehicle: wref<VehicleObject>;
    let owner = ScriptExecutionContext.GetOwner(context);
    let gameInstance = owner.GetGame();
    let driveToPointUpdate = new DriveToPointAutonomousUpdate();
    VehicleComponent.GetVehicle(gameInstance, owner, vehicle);
    let autoDriveSystem = GameInstance
      .GetScriptableSystemsContainer(ScriptExecutionContext.GetOwner(context).GetGame())
      .Get(n"AutoDriveSystem") as AutoDriveSystem;
    if NotEquals(this.targetPosition, autoDriveSystem.GetAutodriveDestination()) {
      driveToPointUpdate.targetPosition = Cast<Vector4>(autoDriveSystem.GetAutodriveDestination());
      vehicle.GetAIComponent().SetDriveToPointAutonomousUpdate(driveToPointUpdate);
    }
    return true;
  }

