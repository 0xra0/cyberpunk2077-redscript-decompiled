class EquipCycleInitDecisions extends EquipmentBaseDecisions {
  public const let stateMachineInstanceData: StateMachineInstanceData;

  public const final func EnterCondition(const stateContext: StateContext, const scriptInterface: StateGameScriptInterface) -> Bool {
    let item: ItemID;
    let record = TweakDBInterface.GetItemRecord(ItemID.GetTDBID(item));
    item = this.GetSlotActiveItem(scriptInterface, this.stateMachineInstanceData);
    if !ItemID.IsValid(item) {
      return true;
    }
    record = TweakDBInterface.GetItemRecord(ItemID.GetTDBID(item));
    if !IsDefined(record) || NotEquals(record.ItemCategory().Type(), gamedataItemCategory.Weapon) {
      return true;
    }
    let equipmentSystemPlayerData = EquipmentSystem.GetData(scriptInterface.executionOwner);
    if !IsDefined(equipmentSystemPlayerData) {
      return true;
    } else if WeaponObject.IsCyberwareWeapon(item) {
      let vehicleState = stateContext.GetStateMachineCurrentState(n"Vehicle");
      if Equals(vehicleState, n"exit")
        || Equals(vehicleState, n"coolExiting")
        || Equals(vehicleState, n"slideExiting") {
        return true;
      } else if equipmentSystemPlayerData.CheckWeaponAgainstGameplayRestrictions(item) {
        return true;
      }
    }
    return false;
  }

  protected const final func ToEquipCycle(const stateContext: StateContext, const scriptInterface: StateGameScriptInterface) -> Bool {
    return this.IsVisualItemInSlot(scriptInterface, this.stateMachineInstanceData)
      || this.IsUsingFluffConsumable(scriptInterface, this.stateMachineInstanceData);
  }

  protected const final func ToUnequipped(const stateContext: StateContext, const scriptInterface: StateGameScriptInterface) -> Bool {
    let threshold = 1.0;
    if this.GetInStateTime() >= threshold {
      return true;
    }
    return false;
  }
}

