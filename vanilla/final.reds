class LeftHandCyberwareQuickActionDecisions extends LeftHandCyberwareActionAbstractDecisions {
  protected const final func EnterCondition(const stateContext: StateContext, const scriptInterface: StateGameScriptInterface) -> Bool {
    if scriptInterface.GetActionValue(n"UseCombatGadget") == 0.0 && this.LeftHandCyberwareHasTag(scriptInterface, n"QuickAction") {
      return true;
    }
    return false;
  }

  protected const final func ToLeftHandCyberwareUnequip(const stateContext: StateContext, const scriptInterface: StateGameScriptInterface) -> Bool {
    if stateContext.GetBoolParameter(n"InterruptLeftHandAction") {
      return true;
    } else if this.GetInStateTime() >= this.GetEquipDuration(scriptInterface) {
      return true;
    }
    return this.ShouldInstantlyUnequipCyberware(scriptInterface, stateContext);
  }
}

class sampleUIVideoPlayer extends inkLogicController {
  public let videoWidgetPath: CName;
  public let counterWidgetPath: CName;
  public let lastFramePath: CName;
  public let currentFramePath: CName;
  private let videoWidget: wref<inkVideo>;
  private let framesToSkipCounterWidget: wref<inkText>;
  private let lastFrameWidget: wref<inkText>;
  private let currentFrameWidget: wref<inkText>;
  private let m_numberOfFrames: Uint32;

  protected cb func OnInitialize() -> Bool {
    this.videoWidget = this.GetWidget(this.videoWidgetPath) as inkVideo;
    this.framesToSkipCounterWidget = this.GetWidget(this.counterWidgetPath) as inkText;
    this.lastFrameWidget = this.GetWidget(this.lastFramePath) as inkText;
    this.currentFrameWidget = this.GetWidget(this.currentFramePath) as inkText;
    this.UpdateCounter();
    this.UpdateTextWidgets();
  }

  public final func PlayPauseVideo(e: inkPointerEvent) {
    if this.videoWidget.IsPlayingVideo() {
      if this.videoWidget.IsPaused() {
        this.videoWidget.Resume();
      } else {
        this.videoWidget.Pause();
      }
    } else {
      this.videoWidget.Play();
    }
    this.UpdateTextWidgets();
  }

  public final func StopVideo(e: inkPointerEvent) {
    this.videoWidget.Stop();
  }

  public final func PauseVideo(e: inkPointerEvent) {
    this.videoWidget.Pause();
    this.UpdateTextWidgets();
  }

  public final func ResumeVideo(e: inkPointerEvent) {
    this.videoWidget.Resume();
    this.UpdateTextWidgets();
  }

  public final func Rewind(e: inkPointerEvent) {
    this.videoWidget.RewindTo(this.m_numberOfFrames);
    this.UpdateTextWidgets();
  }

  public final func FastForward(e: inkPointerEvent) {
    this.videoWidget.FastForwardTo(this.m_numberOfFrames);
    this.UpdateTextWidgets();
  }

  public final func JumpToFrame(e: inkPointerEvent) {
    this.videoWidget.JumpToFrame(this.m_numberOfFrames);
    this.UpdateTextWidgets();
  }

  public final func JumpToTime(e: inkPointerEvent) {
    this.videoWidget.JumpToTime(Cast<Float>(this.m_numberOfFrames));
    this.UpdateTextWidgets();
  }

  public final func RiseFramesCounter(e: inkPointerEvent) {
    this.m_numberOfFrames += 1u;
    this.UpdateCounter();
  }

  public final func LowerFramesCounter(e: inkPointerEvent) {
    this.m_numberOfFrames -= 1u;
    this.UpdateCounter();
  }

  private final func UpdateTextWidgets() {
    let videoSummary = this.videoWidget.GetVideoWidgetSummary();
    this.currentFrameWidget.SetText(ToString(videoSummary.currentFrame));
    this.lastFrameWidget.SetText(ToString(videoSummary.totalFrames));
  }

  private final func UpdateCounter() {
    this.framesToSkipCounterWidget.SetText(ToString(this.m_numberOfFrames));
  }
}

