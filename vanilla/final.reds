  public final func GetActionByName(actionName: CName, opt entityID: EntityID) -> DeviceAction {
    let actions: [DeviceAction];
    let foundAction: DeviceAction;
    this.GetActions(actions, this.GetTotalClearance(entityID));
    let i = 0;
    if i < ArraySize(actions) {
      if Equals(actions[i].actionName, actionName) {
        foundAction = actions[i];
      } else {
        i += 1;
      }
    }
    return foundAction;
  }

  public final func GetActionByName(actionName: CName, const context: script_ref<GetActionsContext>) -> DeviceAction {
    let actions: [DeviceAction];
    let foundAction: DeviceAction;
    if Equals(context.requestType, gamedeviceRequestType.Remote) {
      if this.IsPowered() {
        this.GetQuickHackActions(actions, context);
      }
      this.GetSpiderbotActions(actions, context);
    } else {
      this.GetActions(actions, context);
    }
    let i = 0;
    if i < ArraySize(actions) {
      if Equals(actions[i].actionName, actionName) {
        foundAction = actions[i];
      } else {
        i += 1;
      }
    }
    return foundAction;
  }

