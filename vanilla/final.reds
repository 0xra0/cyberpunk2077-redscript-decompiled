abstract native class BaseMappinBaseController extends inkLogicController {
  protected native let iconWidget: inkImageRef;
  protected native let playerTrackedWidget: inkWidgetRef;
  protected let m_animPlayerTrackedWidget: inkWidgetRef;
  protected let m_animPlayerAboveBelowWidget: inkWidgetRef;
  protected const let m_taggedWidgets: [inkWidgetRef];

  public final native func GetMappin() -> wref<IMappin>;

  public final native func GetProfile() -> MappinUIRuntimeProfile_Record;

  public final native func GetDistanceToPlayer() -> Float;

  public final native func GetVerticalRelationToPlayer() -> gamemappinsVerticalPositioning;

  public final native func ShouldShowDistance() -> Bool;

  public final native func ShouldShowDisplayName() -> Bool;

  public final native func SetProjectToScreenSpace(projectToScreenSpace: Bool);

  protected final native func IsClamped() -> Bool;

  public final native func ShouldClamp() -> Bool;

  public final native func OverrideClamp(shouldClamp: Bool);

  public final native func OverrideClampX(shouldClamp: Bool);

  public final native func OverrideClampY(shouldClamp: Bool);

  protected final native func OverrideScaleByDistance(shouldScale: Bool);

  protected final native func SetRootVisible(visible: Bool);

  protected final native func SetIgnorePriority(ignore: Bool);

  protected final native func RequestForcedUpdate();

  public final native func IsCustomPositionTracked() -> Bool;

  public final native func IsDelamainTaxiTracked() -> Bool;

  public final native func IsPlayerTracked() -> Bool;

  public final native func IsTracked() -> Bool;

  protected final native func IsGPSPortal() -> Bool;

  protected final func UpdateRootState() {
    let state = this.ComputeRootState();
    if Equals(state, n"None") {
      state = n"Default";
    }
    this.GetRootWidget().SetState(state);
  }

  protected func UpdateTrackedState() {
    let visible = false;
    if ArraySize(this.m_taggedWidgets) == 0 {
      return;
    } else if this.GetProfile().ShowTrackedIcon() {
      let isRootVisible = this.GetRootWidget().IsVisible();
      let isTracked = this.IsTracked();
      let isClamped = this.IsClamped();
      visible = isRootVisible && isTracked && !isClamped;
    }
    let i = 0;
    while i < ArraySize(this.m_taggedWidgets) {
      inkWidgetRef.SetVisible(this.m_taggedWidgets[i], visible);
      i += 1;
    }
    let animPlayer = this.GetAnimPlayer_Tracked();
    if animPlayer != null {
      animPlayer.PlayOrPause(visible);
    }
  }

  protected func ComputeRootState() -> CName {
    return n"Default";
  }

  public func GetWidgetForNameplateSlot() -> wref<inkWidget> {
    return this.GetRootWidget();
  }

  public const func GetVisualData() -> GameplayRoleMappinData {
    return null;
  }

  public final func GetAnimPlayer_Tracked() -> wref<animationPlayer> {
    return (inkWidgetRef.IsValid(this.m_animPlayerTrackedWidget) ? inkWidgetRef.GetController(this.m_animPlayerTrackedWidget) : null) as animationPlayer;
  }

  public final func GetAnimPlayer_AboveBelow() -> wref<animationPlayer> {
    return (inkWidgetRef.IsValid(this.m_animPlayerAboveBelowWidget) ? inkWidgetRef.GetController(this.m_animPlayerAboveBelowWidget) : null) as animationPlayer;
  }
}

class animationPlayer extends inkLogicController {
  public let animName: CName;
  public let loopType: inkanimLoopType;
  public let delay: Float;
  public let playInfinite: Bool;
  public let loopsAmount: Uint32;
  public let playReversed: Bool;
  public let animTarget: inkWidgetRef;
  public let autoPlay: Bool;
  public let dependsOnTimeDilation: Bool;
  private let m_anim: inkAnimProxy;

  protected cb func OnInitialize() -> Bool {
    if this.autoPlay {
      this.Play();
    }
  }

  public final func PlayOrPause(flag: Bool) {
    if flag {
      this.Play();
    } else {
      this.Pause();
    }
  }

  public final func PlayOrStop(flag: Bool) {
    if flag {
      this.Play();
    } else {
      this.Stop();
    }
  }

  public final func Play() {
    if this.m_anim == null {
      this.m_anim = this.CreateAndPlayAnimation();
    } else {
      this.m_anim.Resume();
    }
  }

  public final func Pause() {
    if this.m_anim != null {
      this.m_anim.Pause();
    }
  }

  public final func Stop() {
    if this.m_anim != null {
      this.m_anim.Stop();
      this.m_anim = null;
    }
  }

  private final func CreateAndPlayAnimation() -> inkAnimProxy {
    let options: inkAnimOptions;
    options.loopType = this.loopType;
    options.executionDelay = this.delay;
    options.loopInfinite = this.playInfinite;
    options.loopCounter = this.loopsAmount;
    options.playReversed = this.playReversed;
    options.dependsOnTimeDilation = this.dependsOnTimeDilation;
    let widgetSet = SelectWidgets(inkWidgetRef.Get(this.animTarget));
    if inkWidgetRef.Get(this.animTarget) != null {
      return this.PlayLibraryAnimationOnTargets(this.animName, widgetSet, options);
    }
    return this.PlayLibraryAnimation(this.animName, options);
  }
}

native class BaseMinimapMappinController extends BaseMappinBaseController {
  protected let m_mappin: wref<IMappin>;
  protected let m_root: wref<inkWidget>;
  protected let m_aboveWidget: wref<inkWidget>;
  protected let m_belowWidget: wref<inkWidget>;
  protected native let clampArrowWidget: inkWidgetRef;

  protected final native func SetForceShow(value: Bool);

  protected final native func SetForceHide(value: Bool);

  protected final native func IsForceShow() -> Bool;

  protected final native func IsForceHide() -> Bool;

  protected final native func LockIconRotation(value: Bool);

  protected cb func OnInitialize() -> Bool {
    this.Initialize();
  }

  protected cb func OnIntro() -> Bool {
    this.Intro();
  }

  protected cb func OnUpdate() -> Bool {
    this.Update();
  }

  protected func Initialize() {
    this.m_root = this.GetRootWidget();
    this.m_root.SetAnchorPoint(new Vector2(0.5, 0.5));
    this.m_root.SetAnchor(inkEAnchor.Centered);
    this.m_aboveWidget = this.GetWidget(n"Canvas/above");
    this.m_belowWidget = this.GetWidget(n"Canvas/below");
  }

  protected func Intro() {
    this.m_mappin = this.GetMappin();
    this.OnUpdate();
  }

  protected func Update() {
    this.UpdateClamping();
    this.UpdateRootState();
    this.UpdateTrackedState();
    this.UpdateAboveBelowVerticalRelation();
  }

  protected func KeepIconOnClamping() -> Bool {
    return false;
  }

  protected func UpdateClamping() {
    let isClamped = this.IsClamped();
    if inkWidgetRef.IsValid(this.clampArrowWidget) && !this.KeepIconOnClamping() {
      inkWidgetRef.SetVisible(this.iconWidget, !isClamped);
      inkWidgetRef.SetVisible(this.clampArrowWidget, isClamped);
    }
  }

  protected func UpdateAboveBelowVerticalRelation() {
    if this.m_aboveWidget == null && this.m_belowWidget == null {
      return;
    }
    let vertRelation = this.GetVerticalRelationToPlayer();
    let shouldShowVertRelation = this.GetRootWidget().IsVisible() && !this.IsClamped();
    let isAbove = shouldShowVertRelation && Equals(vertRelation, gamemappinsVerticalPositioning.Above);
    let isBelow = shouldShowVertRelation && Equals(vertRelation, gamemappinsVerticalPositioning.Below);
    this.m_aboveWidget.SetVisible(isAbove);
    this.m_belowWidget.SetVisible(isBelow);
    let animPlayer = this.GetAnimPlayer_AboveBelow();
    if animPlayer != null {
      animPlayer.PlayOrStop(isAbove || isBelow);
    }
  }
}

