class ForceMoveInCombatWhistleEffector extends ForceMoveInCombatEffector {
  public let m_targetPosition: Vector4;

  protected func Initialize(record: TweakDBID, game: GameInstance, parentRecord: TweakDBID) {
    let player = GameInstance.GetPlayerSystem(game).GetLocalPlayerControlledGameObject();
    super.Initialize(record, game, parentRecord);
    this.m_targetPosition = player.GetWorldPosition();
  }

  protected func ActionOn(owner: GameObject) {
    let proxy: GameObject;
    let end: AIPositionSpec;
    let endWorldPosition: WorldPosition;
    UpdateWhistlePosition
      .TryGetDesiredWhistlePosition(owner, this.m_targetPosition, this.m_targetPosition, proxy);
    WorldPosition.SetVector4(endWorldPosition, this.m_targetPosition);
    AIPositionSpec.SetWorldPosition(end, endWorldPosition);
    this.StartMovement(owner, end, 3.0, moveMovementType.Walk);
  }

  protected func ActionOff(owner: GameObject) {
    StatusEffectHelper.RemoveStatusEffectsWithTag(owner, n"CombatWhistle");
  }
}

class UpdateWhistlePosition extends AIbehaviortaskScript {
  protected func SetTarget(context: ScriptExecutionContext, target: wref<GameObject>);

  protected func SetPosition(context: ScriptExecutionContext, position: Vector4);

  public final static func TryGetDesiredWhistlePosition(
    owner: GameObject,
    playerPosition: Vector4,
    out position: Vector4,
    out proxy: GameObject
  ) -> Bool {
    let whistleEffects: [StatusEffect];
    let query: AINavigationSystemQuery;
    let worldPosition: WorldPosition;
    let navResult: AINavigationSystemResult;
    StatusEffectHelper.GetAppliedEffectsWithTag(owner, n"Whistle", whistleEffects);
    if ArraySize(whistleEffects) == 0 {
      return false;
    } else if EntityID.IsDefined(whistleEffects[0].GetProxyEntityID()) {
      proxy = GameInstance.FindEntityByID(owner.GetGame(), whistleEffects[0].GetProxyEntityID()) as GameObject;
    } else if IsDefined(proxy)
      && StatusEffectSystem.ObjectHasStatusEffectWithTag(owner, n"WhistleGoToCamera") {
      position = proxy.GetWorldPosition();
    }
    proxy = null;
    position = playerPosition;
    if StatusEffectSystem.ObjectHasStatusEffectWithTag(owner, n"WhistleTurnAway") {
      position = 2.0 * owner.GetWorldPosition() - position;
      return true;
    }
    let navigationSystem = GameInstance.GetAINavigationSystem(owner.GetGame());
    AIPositionSpec.SetEntity(query.source, owner);
    WorldPosition.SetVector4(worldPosition, position);
    AIPositionSpec.SetWorldPosition(query.target, worldPosition);
    let queryId = navigationSystem.StartPathfinding(query);
    navigationSystem.GetResult(queryId, navResult);
    navigationSystem.StopPathfinding(queryId);
    if navResult.hasClosestReachablePoint {
      position = WorldPosition.ToVector4(navResult.closestReachablePoint);
    }
    return true;
  }

  protected func Activate(context: ScriptExecutionContext) {
    let proxy: GameObject;
    let position: Vector4;
    let owner = AIBehaviorScriptBase.GetPuppet(context);
    let player = GameInstance.GetPlayerSystem(owner.GetGame()).GetLocalPlayerControlledGameObject();
    if !UpdateWhistlePosition
      .TryGetDesiredWhistlePosition(owner, player.GetWorldPosition(), position, proxy) {
      return;
    }
    this.SetTarget(context, IsDefined(proxy) ? proxy : player);
    this.SetPosition(context, position);
  }
}

