class DialogueChoiceHubPrereq extends IScriptablePrereq {
  private let m_isChoiceHubActive: Bool;

  protected func Initialize(recordID: TweakDBID) {
    this.m_isChoiceHubActive = TweakDBInterface.GetBool(recordID + t".isChoiceHubActive", false);
  }

  public const func IsFulfilled(game: GameInstance, context: IScriptable) -> Bool {
    let owner = context as GameObject;
    let interactonsBlackboard = GameInstance
      .GetBlackboardSystem(owner.GetGame())
      .Get(GetAllBlackboardDefs().UIInteractions);
    let interactionData = GetAllBlackboardDefs().UIInteractions;
    let data = FromVariant<DialogChoiceHubs>(interactonsBlackboard.GetVariant(interactionData.DialogChoiceHubs));
