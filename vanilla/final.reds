class Bombus_Flame_Beam extends Attack_Continuous {
  public func OnTick(weapon: WeaponObject) {
    if IsDefined(weapon) {
      let beamEffect = this.GetRunningContinuousEffect();
      if IsDefined(beamEffect) {
        EffectData
          .SetVector(
            beamEffect.GetSharedData(),
            GetAllBlackboardDefs().EffectSharedData.position,
            weapon.GetWorldPosition()
          );
        EffectData
          .SetVector(
            beamEffect.GetSharedData(),
            GetAllBlackboardDefs().EffectSharedData.forward,
            weapon.GetWorldForward()
          );
        EffectData
          .SetFloat(
            beamEffect.GetSharedData(),
            GetAllBlackboardDefs().EffectSharedData.minRayAngleDiff,
            1.0
          );
      }
    }
  }
}

