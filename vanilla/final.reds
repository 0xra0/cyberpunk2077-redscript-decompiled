  public final static func QueueEventToAllPassengers(
    gi: GameInstance,
    vehicle: wref<VehicleObject>,
    evt: Event,
    opt delay: Float,
    opt randomDelay: Bool
  ) -> Bool {
    if !IsDefined(vehicle) {
      return false;
    }
    return VehicleComponent
      .QueueEventToAllPassengers(gi, vehicle.GetEntityID(), evt, delay, randomDelay);
  }

  public final static func QueueEventToAllNonFriendlyAggressivePassengers(gi: GameInstance, vehicleID: EntityID, evt: Event, opt delay: Float) -> Bool {
    let passenger: wref<ScriptedPuppet>;
    let passengers: [wref<GameObject>];
    if !GameInstance.IsValid(gi) || !EntityID.IsDefined(vehicleID) {
      return false;
    }
    VehicleComponent.GetAllPassengers(gi, vehicleID, false, passengers);
    let i = 0;
    while i < ArraySize(passengers) {
      passenger = passengers[i] as ScriptedPuppet;
      if IsDefined(passenger) && !IsFriendlyTowardsPlayer(passenger) && passenger.IsAggressive() {
        if delay > 0.0 {
          GameInstance.GetDelaySystem(gi).DelayEvent(passenger, evt, delay);
        } else {
          passenger.QueueEvent(evt);
        }
      }
      i += 1;
    }
    if !IsDefined(passenger) {
      return false;
    }
    return true;
  }

  public final static func QueueEventToPassengers(
    gi: GameInstance,
    vehicleID: EntityID,
    evt: Event,
    const passengers: script_ref<[wref<GameObject>]>,
    opt delay: Bool,
    opt maxDelayAmount: Float
  ) -> Bool {
    if !GameInstance.IsValid(gi) || !EntityID.IsDefined(vehicleID) || ArraySize(passengers) == 0 {
      return false;
    }
    let i = 0;
    while i < ArraySize(passengers) {
      if IsDefined(passengers[i]) {
        if delay {
          let maxDelay = 2.0;
          if maxDelayAmount > 0.0 {
            maxDelay = maxDelayAmount;
          }
          let delayTime = delayTime + RandRangeF(0.1, maxDelay);
          GameInstance.GetDelaySystem(gi).DelayEvent(passengers[i], evt, delayTime);
        } else {
          passengers[i].QueueEvent(evt);
        }
      }
      i += 1;
    }
    return true;
  }

  public final static func QueueExitEventToAllNonFriendlyActivePassengers(
    gi: GameInstance,
    vehicleID: EntityID,
    executionOwner: GameObject,
    opt broadcastHijack: Bool,
    opt delay: Bool
  ) -> Bool {
    let passenger: wref<GameObject>;
    let attitude: EAIAttitude;
    if !GameInstance.IsValid(gi) || !EntityID.IsDefined(vehicleID) {
      return false;
    }
    let playerMountInfo = GameInstance
      .GetMountingFacility(gi)
      .GetMountingInfoSingleWithObjects(GameInstance.GetPlayerSystem(gi).GetLocalPlayerMainGameObject());
    let mountInfos = GameInstance.GetMountingFacility(gi).GetMountingInfoMultipleWithIds(vehicleID);
    let i = 0;
    if i < ArraySize(mountInfos) {
      if Equals(mountInfos[i].slotId.id, n"trunk_body") {
        ArrayErase(mountInfos, i);
      } else {
        i += 1;
      }
    }
    let exitEvent = new AIEvent();
    exitEvent.name = n"ExitVehicle";
    let exitInPanicEvent = new AIEvent();
    exitInPanicEvent.name = n"ExitVehicleInPanic";
    let delayTime = RandRangeF(0.2, 0.4);
    let broadcaster = GameInstance
      .GetPlayerSystem(gi)
      .GetLocalPlayerMainGameObject()
      .GetStimBroadcasterComponent();
    i = 0;
    while i < ArraySize(mountInfos) {
      passenger = GameInstance.FindEntityByID(gi, mountInfos[i].childId) as GameObject;
      let active = VehicleComponent.IsSlotOccupiedByActivePassenger(gi, vehicleID, mountInfos[i].slotId.id);
      VehicleComponent.GetAttitudeOfPassenger(gi, vehicleID, mountInfos[i].slotId, attitude);
      if NotEquals(playerMountInfo.slotId.id, mountInfos[i].slotId.id) {
        if IsDefined(passenger) && active && NotEquals(attitude, EAIAttitude.AIA_Friendly) {
          let evt = (passenger as ScriptedPuppet).IsEnemy() ? exitEvent : exitInPanicEvent;
          if delay {
            delayTime = delayTime + RandRangeF(0.2, 0.4);
            GameInstance.GetDelaySystem(gi).DelayEvent(passenger, evt, delayTime);
          } else {
            passenger.QueueEvent(evt);
          }
        } else if IsDefined(broadcaster) && broadcastHijack {
          broadcaster
            .SendDrirectStimuliToTarget(executionOwner, gamedataStimType.HijackVehicle, passenger);
        }
      }
      i += 1;
    }
    if !IsDefined(passenger) {
      return false;
    }
    return true;
  }

  public final static func QueueHijackExitEventToInactiveDriver(gi: GameInstance, vehicle: wref<VehicleObject>) -> Bool {
    if !GameInstance.IsValid(gi) || !IsDefined(vehicle) {
      return false;
    }
    let driver = VehicleComponent.GetDriverMounted(gi, vehicle.GetEntityID());
    if driver == null || ScriptedPuppet.IsActive(driver) {
      return false;
    }
    VehicleComponent.OpenDoor(vehicle, VehicleComponent.GetDriverSlotID(), 1.0);
    GameInstance
      .GetWorkspotSystem(vehicle.GetGame())
      .UnmountFromVehicle(vehicle, driver, false, n"deadstealing");
    return true;
  }

  public final static func CheckIfPassengersCanLeaveCar(
    gi: GameInstance,
    vehicleID: EntityID,
    passengersCanLeaveCar: script_ref<[wref<GameObject>]>,
    passengersCantLeaveCar: script_ref<[wref<GameObject>]>
  ) {
    let mountInfos = GameInstance.GetMountingFacility(gi).GetMountingInfoMultipleWithIds(vehicleID);
    let workspotSystem = GameInstance.GetWorkspotSystem(gi);
    let i = 0;
    while i < ArraySize(mountInfos) {
      let passenger = GameInstance.FindEntityByID(gi, mountInfos[i].childId) as GameObject;
      let active = VehicleComponent.IsSlotOccupiedByActivePassenger(gi, vehicleID, mountInfos[i].slotId.id);
      if IsDefined(passenger) && active {
        if workspotSystem.HasExitNodes(passenger, true, false, true) {
          ArrayPush(passengersCanLeaveCar, passenger);
        } else {
          ArrayPush(passengersCantLeaveCar, passenger);
        }
      }
      i += 1;
    }
  }

  public final static func IsAnyPassengerCrowd(gi: GameInstance, vehicle: wref<VehicleObject>) -> Bool {
    if !GameInstance.IsValid(gi) || !IsDefined(vehicle) {
      return false;
    }
    let mountInfos = GameInstance.GetMountingFacility(gi).GetMountingInfoMultipleWithObjects(vehicle);
    let i = 0;
    while i < ArraySize(mountInfos) {
      let passenger = GameInstance.FindEntityByID(gi, mountInfos[i].childId) as NPCPuppet;
      if passenger.IsCrowd() {
        return true;
      }
      i += 1;
    }
    return false;
  }

  public final static func IsSlotAvailable(gi: GameInstance, vehicle: wref<VehicleObject>, slotName: CName) -> Bool {
    if !IsDefined(vehicle) || !IsNameValid(slotName) {
      return false;
    } else if !VehicleComponent.HasSlot(gi, vehicle, slotName) {
      return false;
    } else if VehicleComponent.IsSlotOccupied(gi, vehicle.GetEntityID(), slotName) {
      return false;
    }
    return true;
  }

