    let gi = ScriptExecutionContext.GetOwner(context).GetGame();
    let preventionSystem = GameInstance.GetScriptableSystemsContainer(gi).Get(n"PreventionSystem") as PreventionSystem;
    let result = Equals(preventionSystem.GetHeatStage(), EPreventionHeatStage.Heat_5);
