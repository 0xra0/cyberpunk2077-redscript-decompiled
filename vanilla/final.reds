class GetTargetLastKnownPosition extends AIbehaviortaskScript {
  protected let m_inTargetObject: AIArgumentMapping;
  protected let m_outPosition: AIArgumentMapping;
  protected let predictionTime: Float;

  protected func Activate(context: ScriptExecutionContext) {
    let targetObject = FromVariant<wref<GameObject>>(ScriptExecutionContext.GetMappingValue(context, this.m_inTargetObject));
    if !IsDefined(targetObject) {
      return;
    }
    let targetLastKnownPosition = targetObject.GetWorldPosition();
    let threats = AIBehaviorScriptBase
      .GetPuppet(context)
      .GetTargetTrackerComponent()
      .GetThreats(false);
    let i = 0;
    while i < ArraySize(threats) {
      if threats[i].entity.GetEntityID() == targetObject.GetEntityID() {
        targetLastKnownPosition = threats[i].lastKnown.position;
      }
      i += 1;
    }
    if this.predictionTime > 0.0 {
      let targetVelocity = (targetObject as gamePuppet).GetVelocity();
      targetVelocity.Z = 0.0;
      targetLastKnownPosition += targetVelocity * this.predictionTime;
    }
    ScriptExecutionContext
      .SetMappingValue(context, this.m_outPosition, ToVariant(targetLastKnownPosition));
  }
}

