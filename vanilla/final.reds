abstract class AGenericTooltipControllerWithDebug extends AGenericTooltipController {
  protected let DEBUG_showDebug: Bool;
  protected let DEBUG_openInVSCode: Bool;
  protected let DEBUG_openInVSCodeBlocked: Bool;

  protected func DEBUG_UpdateDebugInfo();

  protected final func OpenTweakDBRecordInVSCodeIfRequested(tdbID: TweakDBID) {
    if this.DEBUG_openInVSCode && !this.DEBUG_openInVSCodeBlocked {
      TDBID.OpenRecordInVSCode(tdbID);
      this.DEBUG_openInVSCodeBlocked = true;
    }
  }

  protected cb func OnInitialize() -> Bool {
    super.OnInitialize();
    if !IsFinal() {
      this
        .RegisterToGlobalInputCallback(n"OnPostOnPress", this, n"OnGlobalPress_DEBUG");
      this
        .RegisterToGlobalInputCallback(n"OnPostOnRelease", this, n"OnGlobalRelease_DEBUG");
    }
  }

  protected cb func OnUninitialize() -> Bool {
    if !IsFinal() {
      this
        .UnregisterFromGlobalInputCallback(n"OnPostOnPress", this, n"OnGlobalPress_DEBUG");
      this
        .UnregisterFromGlobalInputCallback(n"OnPostOnRelease", this, n"OnGlobalRelease_DEBUG");
    }
  }

  protected cb func OnGlobalPress_DEBUG(evt: inkPointerEvent) -> Bool {
    this.DEBUG_showDebug = evt.IsShiftDown();
    this.DEBUG_openInVSCode = evt.IsControlDown();
    this.DEBUG_openInVSCodeBlocked = !this.DEBUG_showDebug;
    this.DEBUG_UpdateDebugInfo();
  }

  protected cb func OnGlobalRelease_DEBUG(evt: inkPointerEvent) -> Bool {
    this.DEBUG_showDebug = false;
    this.DEBUG_openInVSCode = false;
    this.DEBUG_openInVSCodeBlocked = false;
    this.DEBUG_UpdateDebugInfo();
  }
}

native class SettingsSelectorController extends inkLogicController {
  protected let m_LabelText: inkTextRef;
  protected let m_ModifiedFlag: inkTextRef;
  protected let m_Raycaster: inkWidgetRef;
  protected let m_optionSwitchHint: inkWidgetRef;
  protected let m_hoverGeneralHighlight: inkWidgetRef;
  protected let m_container: inkWidgetRef;
  protected let m_indentMarker: inkWidgetRef;
  protected let m_SettingsEntry: wref<ConfigVar>;
  protected let m_hoveredChildren: [wref<inkWidget>];
  protected let m_IsPreGame: Bool;
  private let m_varGroupPath: CName;
  private let m_varName: CName;
  protected let m_additionalText: CName;
  private let m_hoverInAnim: inkAnimProxy;
  private let m_hoverOutAnim: inkAnimProxy;

  public final native func BindSettings(entry: ConfigVar);

  public final native func GetDisplayName() -> CName;

  public final native func GetDescription() -> CName;

  public final native func GetWarning() -> CName;

  public final func GetVar() -> wref<ConfigVar> {
    return this.m_SettingsEntry;
  }

  public final func GetGroupPath() -> CName {
    return this.m_varGroupPath;
  }

  public final func GetVarName() -> CName {
    return this.m_varName;
  }

  public final func GetVarUpdatePolicy() -> ConfigVarUpdatePolicy {
    return this.m_SettingsEntry.GetUpdatePolicy();
  }

  public final func IsDynamic() -> Bool {
    return this.m_SettingsEntry.IsDynamic();
  }

  public final func SetAdditionalText(text: CName) {
    this.m_additionalText = text;
  }

  public final func ResetAdditionalText() {
    this.m_additionalText = n"None";
  }

  public func SetInteractive(interactive: Bool);

  public func Setup(entry: ConfigVar, isPreGame: Bool) {
    this.m_SettingsEntry = entry;
    this.m_IsPreGame = isPreGame;
    this.m_varGroupPath = this.m_SettingsEntry.GetGroupPath();
    this.m_varName = this.m_SettingsEntry.GetName();
    this.BindSettings(entry);
  }

  protected cb func OnInitialize() -> Bool {
    if inkWidgetRef.IsValid(this.m_Raycaster) {
      inkWidgetRef.SetVisible(this.m_optionSwitchHint, false);
      inkWidgetRef.SetVisible(this.m_hoverGeneralHighlight, false);
      inkWidgetRef.SetState(this.m_LabelText, n"Default");
      this.RegisterToCallback(n"OnHoverOver", this, n"OnHoverOver");
      this.RegisterToCallback(n"OnHoverOut", this, n"OnHoverOut");
    }
    inkWidgetRef.SetVisible(this.m_indentMarker, false);
  }

  protected cb func OnHoverOver(e: inkPointerEvent) -> Bool {
    if this.m_SettingsEntry.IsDisabled() {
      return false;
    } else if ArraySize(this.m_hoveredChildren) <= 0 {
      if this.m_hoverInAnim.IsPlaying() {
        this.m_hoverInAnim.Stop();
      } else if this.m_hoverOutAnim.IsPlaying() {
        this.m_hoverOutAnim.Stop();
      }
      this.m_hoverInAnim = this.PlayLibraryAnimation(n"hover_over_anim");
      inkWidgetRef.SetState(this.m_LabelText, n"Hover");
      inkWidgetRef.SetVisible(this.m_optionSwitchHint, true);
      inkWidgetRef.SetVisible(this.m_hoverGeneralHighlight, true);
    }
    ArrayPush(this.m_hoveredChildren, e.GetCurrentTarget());
  }

  protected cb func OnHoverOut(e: inkPointerEvent) -> Bool {
    if this.m_SettingsEntry.IsDisabled() {
      return false;
    }
    ArrayRemove(this.m_hoveredChildren, e.GetCurrentTarget());
    if ArraySize(this.m_hoveredChildren) <= 0 {
      if this.m_hoverInAnim.IsPlaying() {
        this.m_hoverInAnim.Stop();
      } else if this.m_hoverOutAnim.IsPlaying() {
        this.m_hoverOutAnim.Stop();
      }
      this.m_hoverOutAnim = this.PlayLibraryAnimation(n"hover_out_anim");
      inkWidgetRef.SetState(this.m_LabelText, n"Default");
      inkWidgetRef.SetVisible(this.m_optionSwitchHint, false);
      inkWidgetRef.SetVisible(this.m_hoverGeneralHighlight, false);
    }
  }

  protected cb func OnElementHovered(e: inkPointerEvent) -> Bool {
    this.CallCustomCallback(n"OnSettingHovered");
  }

  protected cb func OnUpdateValue() -> Bool {
    this.Refresh();
  }

  public func Refresh() {
    let text: String;
    let wasModified: Bool;
    let modifiedSymbol: String;
    let size = this.m_SettingsEntry.GetDisplayNameKeysSize();
    if size > 0 {
      text = NameToString(this.m_SettingsEntry.GetDisplayName());
      let i = 0;
      while i < size {
        text = StrReplace(
          text,
          "%",
          GetLocalizedTextByKey(this.m_SettingsEntry.GetDisplayNameKey(i))
        );
        i += 1;
      }
    } else {
      text = GetLocalizedTextByKey(this.m_SettingsEntry.GetDisplayName());
    }
    let updatePolicy = this.m_SettingsEntry.GetUpdatePolicy();
    if Equals(text, "") {
      text = "<NOT LOCALIZED>" + NameToString(this.m_SettingsEntry.GetDisplayName());
    } else if Equals(updatePolicy, ConfigVarUpdatePolicy.ConfirmationRequired) {
      modifiedSymbol = "*";
      wasModified = this.m_SettingsEntry.HasRequestedValue();
    } else if Equals(updatePolicy, ConfigVarUpdatePolicy.RestartRequired) || Equals(updatePolicy, ConfigVarUpdatePolicy.LoadLastCheckpointRequired) {
      modifiedSymbol = "!";
      wasModified = this.m_SettingsEntry.HasRequestedValue() || this.m_SettingsEntry.WasModifiedSinceLastSave();
    }
    modifiedSymbol = "";
    wasModified = false;
    let languageProvider = inkWidgetRef.GetUserData(this.m_LabelText, n"inkLanguageOverrideProvider") as inkLanguageOverrideProvider;
    languageProvider.SetLanguage(scnDialogLineLanguage.Origin);
    inkTextRef.UpdateLanguageResources(this.m_LabelText, false);
    inkTextRef.SetText(this.m_LabelText, text);
    inkWidgetRef.SetVisible(this.m_ModifiedFlag, wasModified);
    inkTextRef.SetText(this.m_ModifiedFlag, modifiedSymbol);
  }

  public final func AddLabelIndent(opt isRightAligned: Bool) {
    inkWidgetRef.SetVisible(this.m_indentMarker, true);
    if isRightAligned {
      inkWidgetRef.UpdateMargin(this.m_LabelText, 0.0, 0.0, 100.0, 0.0);
    } else {
      inkWidgetRef.UpdateMargin(this.m_LabelText, 100.0, 0.0, 0.0, 0.0);
    }
  }

  protected cb func OnLeft(e: inkPointerEvent) -> Bool {
    if !this.m_SettingsEntry.IsDisabled() && e.IsAction(n"click") {
      this.AcceptValue(false);
      this.PlaySound(n"ButtonValueDown", n"OnPress");
    }
  }

  protected cb func OnRight(e: inkPointerEvent) -> Bool {
    if !this.m_SettingsEntry.IsDisabled() && e.IsAction(n"click") {
      this.AcceptValue(true);
      this.PlaySound(n"ButtonValueUp", n"OnPress");
    }
  }

  protected cb func OnShortcutRepeat(e: inkPointerEvent) -> Bool {
    if !this.m_SettingsEntry.IsDisabled() && !e.IsHandled() {
      if e.IsAction(n"option_switch_prev_settings") {
        this.ChangeValue(false);
        e.Handle();
      } else if e.IsAction(n"option_switch_next_settings") {
        this.ChangeValue(true);
        e.Handle();
      }
    }
  }

  protected cb func OnShortcutPress(e: inkPointerEvent) -> Bool {
    if !this.m_SettingsEntry.IsDisabled() && !e.IsHandled() {
      if e.IsAction(n"option_switch_prev_settings") {
        this.PlaySound(n"ButtonValueDown", n"OnPress");
        this.AcceptValue(false);
        e.Handle();
      } else if e.IsAction(n"option_switch_next_settings") {
        this.PlaySound(n"ButtonValueUp", n"OnPress");
        this.AcceptValue(true);
        e.Handle();
      }
    }
  }

  private func AcceptValue(forward: Bool) {
    this.ChangeValue(forward);
  }

  private func ChangeValue(forward: Bool);
}

