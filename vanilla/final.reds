  protected cb func OnToggleJuryrigTrap(evt: ToggleJuryrigTrap) -> Bool {
    Equals(this.GetDevicePS().GetJuryrigTrapState(), EJuryrigTrapState.ARMED) ? this.DeactivateJuryrigTrap() : this.ArmJuryrigTrap();
    let broadcaster = this.GetStimBroadcasterComponent();
    if IsDefined(broadcaster) {
      broadcaster.TriggerSingleBroadcast(this, gamedataStimType.Distract);
    }
    this.UpdateDeviceState();
  }

  protected cb func OnTogglePersonalLink(evt: TogglePersonalLink) -> Bool {
    let executor = evt.GetExecutor();
    if Equals(
      this.GetDevicePS().GetPersonalLinkStatus(),
      EPersonalLinkConnectionStatus.DISCONNECTING
    ) {
      if !IsDefined(executor) {
        return false;
      }
      this.TogglePersonalLink(false, executor);
    } else if Equals(
      this.GetDevicePS().GetPersonalLinkStatus(),
      EPersonalLinkConnectionStatus.CONNECTING
    ) {
      if !IsDefined(executor) {
        executor = this.GetPlayerMainObject();
      } else {
        this.TogglePersonalLink(true, executor);
      }
    }
    this.UpdateDeviceState();
  }

  protected func TogglePersonalLink(toggle: Bool, puppet: GameObject) {
    let debug_leftSlot: WorldTransform;
    let debug_slotPosition: WorldTransform;
    if toggle {
      if puppet.IsPlayer() {
        SaveLocksManager.RequestSaveLockAdd(this.GetGame(), n"PersonalLink");
        this.m_personalLinkFailsafeID = GetInvalidDelayID();
        RPGManager.ForceEquipPersonalLink(puppet as PlayerPuppet);
        let personalLinkEvent = new ManagePersonalLinkChangeEvent();
        personalLinkEvent.shouldEquip = true;
        GameInstance.GetDelaySystem(this.GetGame()).DelayEvent(puppet, personalLinkEvent, 0.5);
      } else if TweakDBInterface.GetBool(t"Items.personal_link.isIKEnabled", false) {
        this.InitiatePersonalLinkWorkspot(puppet);
      }
      this.m_IKslotComponent.GetSlotTransform(n"leftSlot", debug_leftSlot);
      this
        .m_IKslotComponent
        .GetSlotTransform(n"personalLinkSlot", debug_slotPosition);
      this
        .EnterWorkspotWithIK(
          puppet,
          this.m_personalLinkComponent.shouldCrouch,
          n"unlockedCamera",
          n"personalLinkPlayerWorkspot",
          WorldPosition.ToVector4(WorldTransform.GetWorldPosition(debug_slotPosition)),
          WorldPosition.ToVector4(WorldTransform.GetWorldPosition(debug_leftSlot))
        );
    } else {
      SaveLocksManager.RequestSaveLockRemove(this.GetGame(), n"PersonalLink");
      this.LeaveWorkspot(puppet);
    }
  }

  protected func InitiatePersonalLinkWorkspot(puppet: GameObject) {
    let personalLinkSlot: WorldTransform;
    let ikFeature = new animAnimFeature_IK();
    let workspotFeature = new AnimFeature_WorkspotIK();
    let workspotSystem = GameInstance.GetWorkspotSystem(this.GetGame());
    if !IsDefined(workspotSystem) {
      return;
    }
    this.m_IKslotComponent.GetSlotTransform(this.GetSlotTag(), personalLinkSlot);
    if puppet.IsPlayer() {
      let playerStateMachineBlackboard = GameInstance
        .GetBlackboardSystem(this.GetGame())
        .GetLocalInstanced(puppet.GetEntityID(), GetAllBlackboardDefs().PlayerStateMachine);
      playerStateMachineBlackboard
        .SetBool(GetAllBlackboardDefs().PlayerStateMachine.IsInteractingWithDevice, true);
    }
    ikFeature.point = WorldPosition.ToVector4(WorldTransform.GetWorldPosition(personalLinkSlot));
    workspotFeature.isInteractingWithDevice = true;
    workspotFeature.rightHandRotation = WorldTransform.GetOrientation(personalLinkSlot);
    this.ApplyAnimFeatureToReplicate(puppet, n"playerIK", ikFeature);
    this.ApplyAnimFeatureToReplicate(puppet, n"WorkspotIK", workspotFeature);
    workspotSystem
      .PlayInDevice(this, puppet, n"unlockedCamera", n"personalLinkPlayerWorkspot");
    if !this.m_personalLinkHackSend {
      workspotSystem.SendJumpToTagCommandEnt(puppet, this.GetSlotTag(), true, this.GetEntityID());
      let resendAnimFeaturesHACK = new RepeatPersonalLinkAnimFeaturesHACK();
      resendAnimFeaturesHACK.activator = puppet;
      GameInstance
        .GetDelaySystem(this.GetGame())
        .DelayEvent(this, resendAnimFeaturesHACK, 0.8);
    }
  }

  protected const final func GetSlotTag() -> CName {
    let options: [CName; 3];
    let slotPos: WorldTransform;
    options[0] = n"personalLinkSlotRight";
    options[1] = n"personalLinkSlot";
    options[2] = n"personalLinkSlotBottom";
    let i = 0;
    while i < ArraySize(options) {
      if this.m_IKslotComponent.GetSlotTransform(options[i], slotPos) {
        return options[i];
      }
      i += 1;
    }
    return n"None";
  }

  protected cb func OnRepeatApplyAnimFeatureHACK(evt: RepeatPersonalLinkAnimFeaturesHACK) -> Bool {
    this.m_personalLinkHackSend = true;
    this.InitiatePersonalLinkWorkspot(evt.activator);
  }

  protected cb func OnToggleZoomInteraction(evt: ToggleZoomInteraction) -> Bool {
    this.EvaluateCameraZoomState(evt.GetExecutor());
  }

  protected cb func OnQuestForceCameraZoom(evt: QuestForceCameraZoom) -> Bool {
    this.EvaluateCameraZoomState(GetPlayer(this.GetGame()), evt.IsInstant());
  }

  protected final func EvaluateCameraZoomState(executor: GameObject, opt instant: Bool) {
    if executor == null {
      return;
    } else if !this.GetDevicePS().IsAdvancedInteractionModeOn() {
      this.RegisterPlayerInputListener(false);
      this.SetZoomBlackboardValues(false, 0.5);
      this.ToggleCameraZoom(false, instant);
    }
    this.ShowAdvanceInteractionInputHints();
    this.RegisterPlayerInputListener(true);
    this.SetZoomBlackboardValues(true);
    this.ToggleCameraZoom(true, instant);
    this.UpdateDeviceState();
  }

  protected func ShouldExitZoomOnAuthorization() -> Bool {
    return false;
  }

  private final func ShowAdvanceInteractionInputHints() {
    this.m_onInputHintManagerInitializedChangedCallback = GameInstance
      .GetBlackboardSystem(this.GetGame())
      .Get(GetAllBlackboardDefs().InputSchemes)
      .RegisterListenerVariant(
        GetAllBlackboardDefs().InputSchemes.InitializedInputHintManagerList,
        this,
        n"OnInputHintManagerInitializedChanged",
        true
      );
  }

  protected cb func OnInputHintManagerInitializedChanged(value: Variant) -> Bool {
    let inputData: InputHintData;
    let currentInitializedInputHintManagerList = FromVariant<[CName]>(value);
    let i = 0;
    while i < ArraySize(currentInitializedInputHintManagerList) {
      if Equals(currentInitializedInputHintManagerList[i], n"GameplayInputHelper") {
        let evt = new UpdateInputHintMultipleEvent();
        evt.targetHintContainer = n"GameplayInputHelper";
        inputData.source = n"AdvanceInteractionMode";
        inputData.action = n"click";
        inputData.localizedLabel = "LocKey#49383";
        evt.AddInputHint(inputData, true);
        inputData.action = n"right_stick_y";
        inputData.localizedLabel = "LocKey#49382";
        evt.AddInputHint(inputData, true);
        inputData.action = n"UI_Exit";
        inputData.localizedLabel = "LocKey#49376";
        evt.AddInputHint(inputData, true);
        GameInstance.GetUISystem(this.GetGame()).QueueEvent(evt);
        return true;
      }
      i += 1;
    }
  }

  private final func HideAdvanceInteractionInputHints() {
    if IsDefined(this.m_onInputHintManagerInitializedChangedCallback) {
      GameInstance
        .GetBlackboardSystem(this.GetGame())
        .Get(GetAllBlackboardDefs().InputSchemes)
        .UnregisterListenerVariant(
          GetAllBlackboardDefs().InputSchemes.InitializedInputHintManagerList,
          this.m_onInputHintManagerInitializedChangedCallback
        );
    }
    let evt = new DeleteInputHintBySourceEvent();
    evt.source = n"AdvanceInteractionMode";
    evt.targetHintContainer = n"GameplayInputHelper";
    GameInstance.GetUISystem(this.GetGame()).QueueEvent(evt);
  }

  protected final func ToggleCameraZoom(toggle: Bool, opt instant: Bool) {
    let blendTime: Float;
    if !IsDefined(this.m_cameraZoomComponent) {
      return;
    } else if toggle && this.m_cameraZoomActive {
      return;
    } else if !toggle && !this.m_cameraZoomActive {
      return;
    }
    let blackboard = GameInstance
      .GetBlackboardSystem(this.GetGame())
      .GetLocalInstanced(
        GameInstance
          .GetPlayerSystem(this.GetGame())
          .GetLocalPlayerControlledGameObject()
          .GetEntityID(),
        GetAllBlackboardDefs().PlayerStateMachine
      );
    if toggle {
      if instant {
        blendTime = 0.0;
      } else {
        blendTime = 1.0;
      }
      this.m_cameraZoomComponent.Activate(blendTime);
      this.m_cameraZoomActive = true;
      if IsDefined(blackboard) {
        this.m_ZoomUIListenerID = blackboard
          .RegisterListenerBool(
            GetAllBlackboardDefs().PlayerStateMachine.IsUIZoomDevice,
            this,
            n"OnIsUIZoomDeviceChange"
          );
      }
      GameInstance.GetUISystem(this.GetGame()).PushGameContext(UIGameContext.DeviceZoom);
    } else if instant {
      blendTime = 0.0;
    } else {
      blendTime = 0.5;
      this.m_cameraZoomComponent.Deactivate(blendTime);
      this.m_cameraZoomActive = false;
      GameInstance.GetUISystem(this.GetGame()).PopGameContext(UIGameContext.DeviceZoom);
    }
  }

  protected cb func OnIsUIZoomDeviceChange(value: Bool) -> Bool {
    if !value {
      let evt = new UnregisterFromZoomBlackboardEvent();
      this.QueueEvent(evt);
      this.HideAdvanceInteractionInputHints();
      this.GetDevicePS().SetAdvancedInteractionModeOn(false);
      this.RegisterPlayerInputListener(false);
      this.ToggleCameraZoom(false);
    }
  }

  protected cb func OnUnregisterFromZoomBlackboardEvent(evt: UnregisterFromZoomBlackboardEvent) -> Bool {
    let blackboard = GameInstance
      .GetBlackboardSystem(this.GetGame())
      .GetLocalInstanced(
        GameInstance
          .GetPlayerSystem(this.GetGame())
          .GetLocalPlayerControlledGameObject()
          .GetEntityID(),
        GetAllBlackboardDefs().PlayerStateMachine
      );
    if IsDefined(blackboard) && IsDefined(this.m_ZoomUIListenerID) {
      blackboard
        .UnregisterListenerBool(
          GetAllBlackboardDefs().PlayerStateMachine.IsUIZoomDevice,
          this.m_ZoomUIListenerID
        );
    }
    this.SetZoomBlackboardValues(false);
  }

  protected cb func OnOpenFullscreenUI(evt: OpenFullscreenUI) -> Bool {
    let executor = evt.GetExecutor();
    if executor == null {
      return false;
    } else if !this.GetDevicePS().IsAdvancedInteractionModeOn() {
      this.SetZoomBlackboardValues(false);
    }
    this.SetZoomBlackboardValues(true);
    this.RegisterPlayerInputListener(true);
    this.UpdateDeviceState();
  }

  protected final func RegisterPlayerInputListener(shouldRegister: Bool) {
    let player = GameInstance.GetPlayerSystem(this.GetGame()).GetLocalPlayerMainGameObject() as PlayerPuppet;
    if IsDefined(player) {
      if shouldRegister {
        player.RegisterInputListener(this);
      } else if !shouldRegister {
        player.UnregisterInputListener(this);
      }
    }
  }

