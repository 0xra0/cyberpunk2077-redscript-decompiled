native class TutorialOverlayLogicController extends inkLogicController {
  private native let hideOnInput: Bool;
  private let m_showAnimation: CName;
  private let m_hideAnimation: CName;
  private let m_animProxy: inkAnimProxy;
  private let m_tutorialManager: wref<questTutorialManager>;

  protected cb func OnUninitialize() -> Bool {
    if this.hideOnInput {
      this
        .UnregisterFromGlobalInputCallback(n"OnPostOnRelease", this, n"OnButtonRelease");
    }
  }

  protected cb func OnButtonRelease(evt: inkPointerEvent) -> Bool {
    if evt.IsAction(n"close_tutorial") {
      let overlayUserData = this.GetRootWidget().GetUserData(n"gameTutorialOverlayUserData") as TutorialOverlayUserData;
      this.m_tutorialManager.RequestToCloseOverlay(overlayUserData.overlayId);
      evt.Handle();
    }
  }

  private final func SetupTutorialOverlayLogicController(tutorialManager: questITutorialManager) {
    this.m_tutorialManager = tutorialManager as questTutorialManager;
    if this.hideOnInput {
      this
        .RegisterToGlobalInputCallback(n"OnPostOnRelease", this, n"OnButtonRelease");
    }
  }

  private final func PlayShowAnimation() -> inkAnimProxy {
    let anim = this.PlayLibraryAnimation(this.m_showAnimation);
    if anim != null {
      anim.RegisterToCallback(inkanimEventType.OnFinish, this, n"OnShowFinished");
    }
    return anim;
  }

  private final func PlayHideAnimation() -> inkAnimProxy {
    if IsDefined(this.m_animProxy) {
      this.m_animProxy.Stop();
    }
    return this.PlayLibraryAnimation(this.m_hideAnimation);
  }

  protected cb func OnShowFinished(e: inkAnimProxy) -> Bool {
    let options: inkAnimOptions;
    options.loopType = inkanimLoopType.None;
    options.loopInfinite = false;
    this.m_animProxy = this.PlayLibraryAnimation(n"BracketLoop", options);
  }
}

