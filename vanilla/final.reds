class ComputerMainLayoutWidgetController extends inkLogicController {
  protected let m_screenSaverSlot: inkWidgetRef;
  protected let m_wallpaperSlot: inkWidgetRef;
  protected let m_menuButtonList: inkWidgetRef;
  protected let m_menuContainer: inkWidgetRef;
  protected let m_internetContainer: inkWidgetRef;
  protected let m_offButton: inkWidgetRef;
  protected let m_windowCloseButton: inkWidgetRef;
  protected let m_windowContainer: inkWidgetRef;
  protected let m_windowHeader: inkTextRef;
  protected let m_menuMailsID: TweakDBID;
  protected let m_menuFilesID: TweakDBID;
  protected let m_menuNewsFeedID: TweakDBID;
  protected let m_menuMainID: TweakDBID;
  protected let m_internetBrowserID: TweakDBID;
  protected let m_screenSaverID: TweakDBID;
  protected let m_wallpaperID: TweakDBID;
  protected let m_windowCloseAanimation: CName;
  protected let m_windowOpenAanimation: CName;
  protected let m_currentScreenSaverLibraryID: CName;
  protected let m_currentWallpaperLibraryID: CName;
  private let m_computerMenuButtonWidgetsData: [SComputerMenuButtonWidgetPackage];
  protected let m_mailsMenu: wref<inkWidget>;
  protected let m_filesMenu: wref<inkWidget>;
  protected let m_devicesMenu: wref<inkWidget>;
  protected let m_newsFeedMenu: wref<inkWidget>;
  protected let m_internetData: wref<inkWidget>;
  protected let m_mainMenu: wref<inkWidget>;
  protected let m_screenSaver: wref<inkWidget>;
  protected let m_wallpaper: wref<inkWidget>;
  protected let m_isInitialized: Bool;
  private let m_devicesMenuInitialized: Bool;
  private let m_isWindowOpened: Bool;
  private let m_activeWindowID: String;
  private let m_menuToOpen: EComputerMenuType;

  public func Initialize(gameController: ComputerInkGameController) {
    this.HideWindow();
    this.SetScreenSaver(gameController, inkWidgetRef.Get(this.m_screenSaverSlot));
    this.SetWallpaper(gameController, inkWidgetRef.Get(this.m_wallpaperSlot));
    this.SetFilesMenu(gameController, this.GetFilesMenuContainer());
    this.SetMailsMenu(gameController, this.GetMailsMenuContainer());
    this.SetNewsFeedMenu(gameController, this.GetNewsfeedMenuContainer());
    this.SetMainMenu(gameController);
    this.SetInternetMenu(gameController);
    this.m_isInitialized = true;
  }

  public func InitializeMenuButtons(
    gameController: ComputerInkGameController,
    const widgetsData: script_ref<[SComputerMenuButtonWidgetPackage]>
  ) {
    this.HideMenuButtonWidgets();
    let i = 0;
    while i < ArraySize(widgetsData) {
      let widget = this.GetMenuButtonWidget(widgetsData[i], gameController);
      if widget == null {
        this
          .CreateMenuButtonWidgetAsync(
            gameController,
            inkWidgetRef.Get(this.m_menuButtonList),
            widgetsData[i]
          );
      } else {
        this.InitializeMenuButtonWidget(gameController, widget, widgetsData[i]);
      }
      i += 1;
    }
  }

  public func SetTopNavigationBarHidden(isHidden: Bool) {
    inkWidgetRef.SetVisible(this.m_menuButtonList, !isHidden);
    this.GetRootWidget().SetMargin(0.0, isHidden ? -290.0 : 0.0, 0.0, 0.0);
    this.GetWindow().SetScale(isHidden ? new Vector2(1.0, 1.0) : new Vector2(0.8, 0.8));
    inkWidgetRef.SetInteractive(this.m_windowCloseButton, !isHidden);
  }

  private final func GetWindow() -> wref<inkWidget> {
    let root = this.GetRootWidget() as inkCompoundWidget;
    return root.GetWidget(n"window");
  }

  public func SetScreenSaver(gameController: ComputerInkGameController, parentWidget: wref<inkWidget>) {
    let screenDef = gameController.GetScreenDefinition();
    if !TDBID.IsValid(this.m_screenSaverID) {
      this.m_screenSaverID = t"DevicesUIDefinitions.ComputerScreenSaverWidget";
    }
    let screenSaverRecord = TweakDBInterface.GetWidgetDefinitionRecord(this.m_screenSaverID);
    let newLibraryID = gameController
      .GetCurrentFullLibraryID(
        screenSaverRecord,
        screenDef.screenDefinition.ComputerScreenType(),
        screenDef.style
      );
    if Equals(this.m_currentScreenSaverLibraryID, newLibraryID) {
      return;
    } else if this.m_screenSaver != null {
      (inkWidgetRef.Get(this.m_screenSaverSlot) as inkCompoundWidget).RemoveChild(this.m_screenSaver);
    }
    this.m_currentScreenSaverLibraryID = newLibraryID;
    let spawnData = new AsyncSpawnData();
    spawnData.Initialize(this, n"OnScreenSaverSpawned", ToVariant(null), this);
    gameController
      .RequestWidgetFromLibrary(
        parentWidget,
        TweakDBInterface.GetWidgetDefinitionRecord(this.m_screenSaverID),
        screenDef.screenDefinition.ComputerScreenType(),
        screenDef.style,
        spawnData
      );
  }

  protected cb func OnScreenSaverSpawned(widget: inkWidget, userData: IScriptable) -> Bool {
    this.m_screenSaver = widget;
    if IsDefined(this.m_screenSaver) {
      this.m_screenSaver.SetAnchor(inkEAnchor.Centered);
      this.m_screenSaver.SetAnchorPoint(0.5, 0.5);
    }
  }

  public func SetWallpaper(gameController: ComputerInkGameController, parentWidget: wref<inkWidget>) {
    let screenDef = gameController.GetScreenDefinition();
    if !TDBID.IsValid(this.m_wallpaperID) {
      this.m_wallpaperID = t"DevicesUIDefinitions.ComputerWallpaperWidget";
    }
    let screenSaverRecord = TweakDBInterface.GetWidgetDefinitionRecord(this.m_wallpaperID);
    let newLibraryID = gameController
      .GetCurrentFullLibraryID(
        screenSaverRecord,
        screenDef.screenDefinition.ComputerScreenType(),
        screenDef.style
      );
    if Equals(this.m_currentWallpaperLibraryID, newLibraryID) {
      return;
    } else if this.m_screenSaver != null {
      (inkWidgetRef.Get(this.m_wallpaperSlot) as inkCompoundWidget).RemoveChild(this.m_wallpaper);
    }
    this.m_currentWallpaperLibraryID = newLibraryID;
    let spawnData = new AsyncSpawnData();
    spawnData.Initialize(this, n"OnWallpaperSpawned", ToVariant(null), this);
    gameController
      .RequestWidgetFromLibrary(
        parentWidget,
        TweakDBInterface.GetWidgetDefinitionRecord(this.m_wallpaperID),
        screenDef.screenDefinition.ComputerScreenType(),
        screenDef.style,
        spawnData
      );
  }

  protected cb func OnWallpaperSpawned(widget: inkWidget, userData: IScriptable) -> Bool {
    this.m_wallpaper = widget;
    if IsDefined(this.m_wallpaper) {
      this.m_wallpaper.SetAnchor(inkEAnchor.Centered);
      this.m_screenSaver.SetAnchorPoint(0.5, 0.5);
      this.m_wallpaper.SetVisible(false);
    }
  }

  public func SetMailsMenu(gameController: ComputerInkGameController, parentWidget: wref<inkWidget>) {
    let screenDef = gameController.GetScreenDefinition();
    if !TDBID.IsValid(this.m_menuMailsID) {
      this.m_menuMailsID = t"DevicesUIDefinitions.MenuMailsWidget";
    }
    let spawnData = new AsyncSpawnData();
    spawnData.Initialize(this, n"OnMailsMenuSpawned", ToVariant(null), gameController);
    gameController
      .RequestWidgetFromLibrary(
        parentWidget,
        TweakDBInterface.GetWidgetDefinitionRecord(this.m_menuMailsID),
        screenDef.screenDefinition.ComputerScreenType(),
        screenDef.style,
        spawnData
      );
  }

  protected cb func OnMailsMenuSpawned(widget: inkWidget, userData: IScriptable) -> Bool {
    let gameController: ComputerInkGameController;
    let spawnData = userData as AsyncSpawnData;
    if IsDefined(spawnData) {
      gameController = spawnData.m_controller as ComputerInkGameController;
    } else if IsDefined(gameController) {
      if widget != null {
        this.m_mailsMenu = widget;
        this.m_mailsMenu.SetAnchor(inkEAnchor.Fill);
      }
      let element = gameController.GetActiveBreadcrumbElement();
      if Equals(element.elementName, "mails") {
        gameController.ShowMails();
      }
      this.m_mailsMenu.SetVisible(false);
    }
  }

  public func SetFilesMenu(gameController: ComputerInkGameController, parentWidget: wref<inkWidget>) {
