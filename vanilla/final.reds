}

class FollowSlotsComponent extends ScriptableComponent {
  private const let m_followSlots: [FollowSlot];

  public final func OnGameAttach() {
    let i = 0;
    while i < ArraySize(this.m_followSlots) {
      this.m_followSlots[i].id = i;
      i += 1;
    }
  }

  private final func GetClosestAvailableSlot(requester: wref<GameObject>) -> FollowSlot {
    let availableSlots = this.GetAllAvailableSlots();
    let closestSlot = this.m_followSlots[availableSlots[0]];
    let requesterPosition = requester.GetWorldPosition();
    let i = 0;
    while i < ArraySize(availableSlots) {
      if Vector4
        .Distance(
          requesterPosition,
          this.GetCurrentWorldPositionOfSlot(this.m_followSlots[availableSlots[i]])
        )
        < Vector4
          .Distance(requesterPosition, this.GetCurrentWorldPositionOfSlot(closestSlot)) {
        closestSlot = this.m_followSlots[availableSlots[i]];
      }
      i += 1;
    }
    return closestSlot;
  }

  private final func GetAllAvailableSlots() -> [Int32] {
    let availableSlots: [Int32];
    let i = 0;
    while i < ArraySize(this.m_followSlots) {
      if this.m_followSlots[i].isAvailable && this.m_followSlots[i].isEnabled {
        ArrayPush(availableSlots, i);
      }
      i += 1;
    }
    return availableSlots;
  }

  private final func GetCurrentWorldPositionOfSlot(slot: FollowSlot) -> Vector4 {
    let slotWorldOffsetFromVehicle = Vector4
      .RotByAngleXY(
        Transform.GetPosition(slot.slotTransform),
        -1.0 * Vector4.Heading(this.GetOwner().GetWorldForward())
      );
    let currentWorldPosition = this.GetOwner().GetWorldPosition() + slotWorldOffsetFromVehicle;
    return currentWorldPosition;
  }

  protected cb func OnReceiveSlotRequest(evt: RequestSlotEvent) -> Bool {
    let allAvailableSlots = this.GetAllAvailableSlots();
    if ArraySize(allAvailableSlots) > 0 {
      let availableSlot = this.GetClosestAvailableSlot(evt.requester);
      availableSlot.isAvailable = false;
      evt
        .blackboard
        .SetInt(GetAllBlackboardDefs().AIFollowSlot.slotID, availableSlot.id);
      evt
        .blackboard
        .SetVariant(
          GetAllBlackboardDefs().AIFollowSlot.slotTransform,
          ToVariant(availableSlot.slotTransform)
        );
    }
  }

  protected cb func OnSlotReleased(evt: ReleaseSlotEvent) -> Bool {
    this.m_followSlots[evt.slotID].isAvailable = true;
  }
}

