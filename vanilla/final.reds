    } else {
      this.m_personalLinkForced = true;
      this.m_disablePersonalLinkAutoDisconnect = true;
    }
    this.m_personalLinkCustomInteraction = evt.reason;
    this.UseNotifier(evt);
    return EntityNotificationType.DoNotNotifyEntity;
  }

