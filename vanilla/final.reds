  public const func CompileScannerChunks() -> Bool {
    let scannerBlackboard = GameInstance
      .GetBlackboardSystem(this.GetGame())
      .Get(GetAllBlackboardDefs().UI_ScannerModules);
    if IsDefined(scannerBlackboard) {
      let displayName = this.GetDisplayName();
      let hasValidDisplayName = IsStringValid(displayName);
      if !hasValidDisplayName {
        displayName = "";
      } else if hasValidDisplayName
        || IsDefined(this.m_scanningComponent)
          && (this.m_scanningComponent.IsAnyClueEnabled() || this.m_scanningComponent.HasValidObjectDescription()) {
        let nameChunk = new ScannerName();
        nameChunk.Set(displayName);
        scannerBlackboard
          .SetVariant(
            GetAllBlackboardDefs().UI_ScannerModules.ScannerName,
            ToVariant(nameChunk),
            true
          );
      }
      scannerBlackboard.SetInt(GetAllBlackboardDefs().UI_ScannerModules.ObjectType, 4, true);
      return true;
    }
    return false;
  }

  protected func FillObjectDescription(out arr: [ScanningTooltipElementDef]) {
    let objectData: ScanningTooltipElementDef;
    let objectDescription = this.m_scanningComponent.GetObjectDescription();
    if objectDescription == null {
      return;
    }
    let customDescriptionsIDS = objectDescription.GetCustomDesriptions();
    let gameplayDescriptionID = objectDescription.GetGameplayDesription();
    if TDBID.IsValid(gameplayDescriptionID) {
      objectData.recordID = gameplayDescriptionID;
      ArrayPush(arr, objectData);
    } else if ArraySize(customDescriptionsIDS) != 0 {
      let i = 0;
      if i < ArraySize(customDescriptionsIDS) {
        objectData.recordID = customDescriptionsIDS[i];
        ArrayPush(arr, objectData);
        i += 1;
      }
    }
  }

  public func GetScannableObjects() -> [ScanningTooltipElementDef] {
    let conclusionData: ScanningTooltipElementDef;
    let arr: [ScanningTooltipElementDef];
    if this.m_scanningComponent != null {
      let clueIndex = this.m_scanningComponent.GetAvailableClueIndex();
      if clueIndex >= 0 {
        arr = this
          .m_scanningComponent
          .GetScannableDataForSingleClueByIndex(clueIndex, conclusionData);
        this.ResolveFocusClueExtendedDescription(clueIndex);
        this.ResolveFocusClueConclusion(clueIndex, conclusionData);
      } else if this.m_scanningComponent.IsObjectDescriptionEnabled() {
        this.FillObjectDescription(arr);
      } else if this.IsScannerDataDirty() {
        this.CompileScannerChunks();
        this.SetScannerDirty(false);
      }
    }
    return arr;
  }

  public const func ShouldShowScanner() -> Bool {
    if !IsDefined(this.m_scanningComponent) {
      return false;
    } else if this.GetHudManager().IsBraindanceActive() && !this.m_scanningComponent.IsBraindanceClue() {
      return false;
    } else if this.m_scanningComponent.IsBraindanceBlocked() || this.m_scanningComponent.IsPhotoModeBlocked() {
      return false;
    } else if !this.m_scanningComponent.HasValidObjectDescription() && (!this.m_scanningComponent.IsAnyClueEnabled() || this.IsScaningCluesBlocked()) {
      return false;
    }
    return true;
  }

