class VisualTagsPrereq extends IScriptablePrereq {
  public let m_allowedTags: [CName];
  public let m_invert: Bool;

  protected func Initialize(recordID: TweakDBID) {
    let prereqRecord = TweakDBInterface.GetVisualTagsPrereqRecord(recordID);
    this.m_allowedTags = prereqRecord.AllowedTags();
    this.m_invert = prereqRecord.Invert();
  }

  protected const func OnApplied(state: PrereqState, game: GameInstance, context: IScriptable) {
    state.OnChanged(this.IsFulfilled(game, context));
  }

  public const func IsFulfilled(game: GameInstance, context: IScriptable) -> Bool {
    let owner = context as ScriptedPuppet;
    if !IsDefined(owner) {
      return this.m_invert ? true : false;
    } else if !NPCManager.HasAllVisualTags(owner, this.m_allowedTags) {
      return this.m_invert ? true : false;
    }
    return this.m_invert ? false : true;
  }
}

