class FinisherLeapToTargetEvents extends FinisherTransition {
  public const let stateMachineInitData: wref<FinisherInitData>;

  public final func OnEnter(stateContext: StateContext, scriptInterface: StateGameScriptInterface) {
    let playerPuppet = scriptInterface.executionOwner as PlayerPuppet;
    StatusEffectHelper
      .ApplyStatusEffect(
        this.stateMachineInitData.target,
        t"BaseStatusEffect.DefeatedFinisherWorkspot"
      );
    FinisherAttackEvents.ApplyFinisherBuffs(playerPuppet, true);
    this.LeapToTarget(stateContext, scriptInterface);
  }

  private final func LeapToTarget(stateContext: StateContext, scriptInterface: StateGameScriptInterface) -> Bool {
    let adjustPosition: Vector4;
    let safetyDisplacement: Vector4;
    let enableVaultDuringLeaping: Bool;
    let target = this.stateMachineInitData.target;
    let playerPuppet = scriptInterface.executionOwner as PlayerPuppet;
    let weapon = GameObject.GetActiveWeapon(playerPuppet);
    let vecToTarget = target.GetWorldPosition() - scriptInterface.executionOwner.GetWorldPosition();
    let playerPuppetOrientation = scriptInterface.executionOwner.GetWorldOrientation();
    if this.GetStaticBoolParameterDefault("useSafetyDisplacement", false) {
      safetyDisplacement.Y = this.GetStaticFloatParameterDefault("safetyDisplacement", 2.0);
      if vecToTarget.Z > 0.0 {
        safetyDisplacement.Y = safetyDisplacement.Y * -1.0;
      }
      let horizontalDistanceFromTarget = Vector4.Length2D(vecToTarget);
      if horizontalDistanceFromTarget < this.GetStaticFloatParameterDefault("minLeapDistance", 2.0) {
        stateContext.SetConditionFloatParameter(n"SlideDuration", 0.0, true);
        stateContext.SetConditionFloatParameter(n"LeapExitTime", 0.0, true);
        return true;
      }
      let additionalHorizontalDistance = MaxF(safetyDisplacement.Y - horizontalDistanceFromTarget, 0.0);
      let scaledSafetyDisplacement = safetyDisplacement * additionalHorizontalDistance;
      adjustPosition = Quaternion.Transform(playerPuppetOrientation, scaledSafetyDisplacement);
    }
    let slideDuration = this.CalculateAdjustmentDuration(Vector4.Length(vecToTarget));
    let exitTime = slideDuration - this.GetStaticFloatParameterDefault("attackStartupDuration", 0.0);
    stateContext.SetConditionFloatParameter(n"LeapExitTime", exitTime, true);
    stateContext.SetConditionFloatParameter(n"SlideDuration", slideDuration, true);
    let distanceRadius = this.GetStaticFloatParameterDefault("distanceRadiusToTarget", 0.9);
    if weapon.IsThrowable() {
      distanceRadius = this.GetStaticFloatParameterDefault("distanceRadiusThrowables", 0.1);
    }
    SpatialQueriesHelper
      .IsTargetReachable(
        scriptInterface.executionOwner,
        target,
        target.GetWorldPosition(),
        false,
        enableVaultDuringLeaping
      );
    if enableVaultDuringLeaping {
      scriptInterface
        .localBlackboard
        .SetBool(GetAllBlackboardDefs().PlayerStateMachine.MeleeLeap, true);
      stateContext.SetPermanentBoolParameter(n"enableVaultFromleapAttack", true, true);
    }
    this
      .RequestPlayerPositionAdjustment(
        stateContext,
        scriptInterface,
        target,
        slideDuration,
        distanceRadius,
        this.GetStaticFloatParameterDefault("rotationDuration", -1.0),
        adjustPosition,
        true
      );
    return true;
  }

  private final func CalculateAdjustmentDuration(distance: Float) -> Float {
    let minDist = this.GetStaticFloatParameterDefault("minDistToTarget", 1.0);
    let maxDist = this.GetStaticFloatParameterDefault("maxDistToTarget", 1.0);
    let minDur = this.GetStaticFloatParameterDefault("minAdjustmentDuration", 1.0);
    let maxDur = this.GetStaticFloatParameterDefault("maxAdjustmentDuration", 1.0);
    distance -= minDist;
    maxDist -= minDist;
    let duration = LerpF(distance / maxDist, minDur, maxDur, true);
    return duration;
  }
}

class MineDispenserPlaceDecisions extends MineDispenserTransition {
  private let m_spawnPosition: Vector4;
  private let m_spawnNormal: Vector4;

  protected const final func EnterCondition(const stateContext: StateContext, const scriptInterface: StateGameScriptInterface) -> Bool {
    return false;
  }

  private const final func CanBePlaced(const stateContext: StateContext, const scriptInterface: StateGameScriptInterface) -> Bool {
    let raycastResult = this.FindPlaceForMine(scriptInterface);
    return TraceResult.IsValid(raycastResult);
  }

  protected const final func ToMineDispenserUnequip(const stateContext: StateContext, const scriptInterface: StateGameScriptInterface) -> Bool {
    if this.GetInStateTime() >= 0.5 {
      return true;
    }
    return false;
  }

  private const final func FindPlaceForMine(const scriptInterface: StateGameScriptInterface) -> TraceResult {
    let cameraTransform = scriptInterface.GetCameraWorldTransform();
    let playerPosition = Transform.GetPosition(cameraTransform);
    let playerForward = Transform.GetForward(cameraTransform);
    let endPosition = playerPosition + playerForward * 10.0;
    return scriptInterface.RaycastWithASingleGroup(playerPosition, endPosition, n"Static");
  }
}

class Stagger extends ReactionTransition {
  public let m_textLayerId: Uint32;

  protected final func AddImpulse(scriptInterface: StateGameScriptInterface) {
    let direction = scriptInterface.GetOwnerMovingDirection();
    direction.Z = 0.0;
    direction *= -1.0;
    let impulseDir = direction * this.GetStaticFloatParameterDefault("moveBackImpulse", 10.0);
    let ev = new PSMImpulse();
    ev.id = n"impulse";
    ev.impulse = impulseDir;
    scriptInterface.executionOwner.QueueEvent(ev);
  }

  public final func OnEnter(stateContext: StateContext, scriptInterface: StateGameScriptInterface) {
    this.AddImpulse(scriptInterface);
    this.StartEffect(scriptInterface, n"skif_buff");
    scriptInterface.SetAnimationParameterFloat(n"hit_strength", 1.0);
    scriptInterface.PushAnimationEvent(n"StaggerHit");
    this.DrawDebugText(scriptInterface, this.m_textLayerId, "PLAYER STAGGER");
    this
      .SetBlackboardIntVariable(scriptInterface, GetAllBlackboardDefs().PlayerStateMachine.Reaction, 1);
  }

  public final func OnExit(stateContext: StateContext, scriptInterface: StateGameScriptInterface) {
    this.ClearDebugText(scriptInterface, this.m_textLayerId);
    this
      .SetBlackboardIntVariable(scriptInterface, GetAllBlackboardDefs().PlayerStateMachine.Reaction, 0);
  }
}

