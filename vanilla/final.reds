class PatrolCommandHandler extends AIbehaviortaskScript {
  public let m_inCommand: AIArgumentMapping;

  protected func Update(context: ScriptExecutionContext) -> AIbehaviorUpdateOutcome {
    if !IsDefined(this.m_inCommand) {
      return AIbehaviorUpdateOutcome.FAILURE;
    }
    let rawCommand = ScriptExecutionContext.GetScriptableMappingValue(context, this.m_inCommand);
    let typedCommand = rawCommand as AIPatrolCommand;
    if !IsDefined(typedCommand) {
      return AIbehaviorUpdateOutcome.FAILURE;
    } else if !IsDefined(typedCommand.pathParams) {
      return AIbehaviorUpdateOutcome.FAILURE;
    }
    let pathParams = typedCommand.pathParams;
    if !ScriptExecutionContext.GetArgumentBool(context, n"PatrolInitialized")
      && Equals(AIBehaviorScriptBase.GetPuppet(context).GetNPCType(), gamedataNPCType.Drone) {
      DroneComponent
        .SetLocomotionWrappers(
          AIBehaviorScriptBase.GetPuppet(context),
          EnumValueToName(n"moveMovementType", EnumInt(pathParams.movementType))
        );
      pathParams.movementType = moveMovementType.Walk;
    }
    let bbDef = GetAllBlackboardDefs().AIPatrol;
    let bb = AIBehaviorScriptBase
      .GetPuppet(context)
      .GetAIControllerComponent()
      .GetAIPatrolBlackboard();
    bb.SetVariant(bbDef.patrolPathOverride, ToVariant(pathParams));
    bb.SetBool(bbDef.patrolWithWeapon, pathParams.patrolWithWeapon);
    bb.SetVariant(bbDef.patrolAction, ToVariant(pathParams.patrolAction));
    bb
      .SetBool(bbDef.sprint, Equals(pathParams.movementType, moveMovementType.Sprint));
    ScriptExecutionContext.SetArgumentBool(context, n"PatrolInitialized", true);
    return AIbehaviorUpdateOutcome.SUCCESS;
  }
}

class CheckStimTag extends AIbehaviorconditionScript {
  public const let m_stimTagToCompare: [CName];

  protected func Check(context: ScriptExecutionContext) -> AIbehaviorConditionOutcomes {
    let activeReactionData = AIBehaviorScriptBase
      .GetPuppet(context)
      .GetStimReactionComponent()
      .GetActiveReactionData();
    if !IsDefined(activeReactionData) {
      activeReactionData = AIBehaviorScriptBase
        .GetPuppet(context)
        .GetStimReactionComponent()
        .GetDesiredReactionData();
    }
    let tags = activeReactionData.stimRecord.Tags();
    let i = 0;
    while i < ArraySize(this.m_stimTagToCompare) {
      if ArrayContains(tags, this.m_stimTagToCompare[i]) {
        return AIbehaviorConditionOutcomes.True;
      }
      i += 1;
    }
    return AIbehaviorConditionOutcomes.False;
  }
}

